// One icon: a stroked `Path` in a square.
export component KitIcon inherits Rectangle {
    in property <string> d;
    in property <color> ink: Theme.text-secondary;
    in property <length> size: 16px;
    in property <length> stroke: 1.7px;
    width: root.size;
    height: root.size;
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.d;
        stroke: root.ink;
        stroke-width: root.stroke;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }
}
