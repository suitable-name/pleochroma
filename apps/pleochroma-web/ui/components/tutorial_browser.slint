import { Button, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

// One lesson in the browser's list.
export struct TutorialRowData {
    // The lesson's id, handed back to `start`.
    id: string,
    // The lesson's name.
    title: string,
    // One line saying what it teaches.
    summary: string,
    // The section heading, shown above the row when `first-in-category` is set.
    category: string,
    // Whether this row is the first of its section.
    first-in-category: bool,
    // Whether the lesson has been finished before.
    done: bool,
    // "Start", or "Restart" once finished.
    start-label: string,
    // Why the lesson cannot start right now ("" when it can).
    blocked-reason: string,
    // How long it is, e.g. "8 steps".
    step-text: string,
}

// The tutorial browser's state (Help > Tutorials...). The lessons themselves are data in
// `crates/pleochroma-editor/src/guide`, shown through the web's wording overlay; Rust
// (`src/editor/tutorials.rs`) owns the list: it fills `rows` when the browser opens, the
// search text changes or a lesson is finished, starts a lesson when a row's button is
// clicked, and keeps the finished marks in `localStorage`.
export global TutorialsModel {
    // Whether the tutorial browser is showing.
    in-out property <bool> browser-open: false;
    // The search text; Rust re-lists the lessons as it changes.
    in-out property <string> query: "";
    // The lessons that match `query`, grouped by section.
    in property <[TutorialRowData]> rows: [];
    // "2 of 9 tutorials finished.", shown under the list.
    in property <string> progress-text: "";

    // Opens the browser with an empty search. Rust fills `rows` (the `opened` callback).
    callback open-browser();
    open-browser => {
        root.query = "";
        root.browser-open = true;
        root.opened();
    }
    // Closes the browser.
    callback close-browser();
    close-browser => { root.browser-open = false; }
    // Fired once the browser has opened, so Rust fills `rows`.
    callback opened();
    // The search text changed; Rust re-lists the lessons.
    callback query-changed(string);
    // Re-list the lessons now.
    callback refresh();
    // Start the lesson with this id.
    callback start(string);
    // Forget which lessons have been finished.
    callback reset-progress();
}

// A section heading with a hairline under it.
component SectionHeading inherits Rectangle {
    in property <string> text;
    height: 26px;
    Text {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        text: root.text;
        font-size: 11px;
        font-weight: 700;
        color: Theme.accent-cyan;
        overflow: elide;
        accessible-role: AccessibleRole.text;
    }
    Rectangle {
        x: 0px;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.border-subtle;
    }
}

// One lesson: its name, a "Done" mark when it has been finished, one or two lines on what it
// teaches, and a Start (or Restart) button. A lesson that cannot start right now says why in
// place of a third line and its button is dim.
component TutorialRow inherits Rectangle {
    in property <TutorialRowData> data;
    // Not called `start`: inside this component that name would hide the `start` of
    // `alignment: start;` below.
    callback start-clicked();

    height: 70px;
    border-radius: Theme.radius-sm;
    background: row-touch.has-hover ? Theme.bg-card-hover : transparent;

    accessible-role: AccessibleRole.list-item;
    accessible-label: root.data.title + (root.data.done ? ", done" : "") + ". " + root.data.summary
        + (root.data.blocked-reason != "" ? " Cannot start now: " + root.data.blocked-reason : "");
    accessible-action-default => {
        if root.data.blocked-reason == "" {
            root.start-clicked();
        }
    }

    // Hover only: the row itself is not a target, the Start button is.
    row-touch := TouchArea {}

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 10px;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            alignment: center;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                height: 16px;
                Text {
                    text: root.data.title;
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.data.done: Text {
                    text: "Done \u{2713}";
                    font-size: 10px;
                    font-weight: 700;
                    color: Theme.success;
                    vertical-alignment: center;
                }
                Text {
                    text: root.data.step-text;
                    font-size: 10px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }
            Text {
                height: 28px;
                text: root.data.summary;
                font-size: 10px;
                color: Theme.text-secondary;
                wrap: word-wrap;
                overflow: elide;
            }
            if root.data.blocked-reason != "": Text {
                height: 13px;
                text: root.data.blocked-reason;
                font-size: 10px;
                color: Theme.accent-amber;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            Button {
                text: root.data.start-label;
                primary: !root.data.done;
                enabled: root.data.blocked-reason == "";
                clicked => { root.start-clicked(); }
            }
        }
    }
}

// The tutorial browser (Help > Tutorials...): every lesson the browser build offers, by
// section, with a search box, a finished mark and Start / Restart. Mounted by `app.slint`
// while `TutorialsModel.browser-open`. Escape, Close and a click outside the card close it.
export component TutorialBrowser inherits Rectangle {
    background: Theme.overlay-backdrop;

    // The search box takes the keyboard as soon as the browser opens.
    init => { search.focus(); }

    // The backdrop: a click outside the card closes the browser.
    TouchArea {
        clicked => { TutorialsModel.close-browser(); }
    }

    // Wraps the card so Escape closes the browser wherever the focus is inside it. Anything
    // else the search box does not take is left alone, so Tab still moves between controls.
    FocusScope {
        width: min(600px, root.width - 24px);
        height: min(620px, root.height - 24px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        key-pressed(event) => {
            if event.text == Key.Escape {
                TutorialsModel.close-browser();
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: Theme.bg-card;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-medium;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.toast-shadow;
            clip: true;

            // Isolates clicks inside the card from the backdrop behind, and hands the
            // keyboard back to the search box so Escape still closes the browser after a
            // click on the card.
            TouchArea {
                clicked => { search.focus(); }
            }

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                Text {
                    text: "Tutorials";
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.text-primary;
                }

                Text {
                    text: "Short guided lessons. Start one and a panel walks you through it, step by step; the controls the step does not need stay locked until you close the panel.";
                    font-size: 10px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }

                search := LineEdit {
                    placeholder-text: "Search tutorials";
                    accessible-label: "Search Tutorials";
                    text <=> TutorialsModel.query;
                    edited => { TutorialsModel.query-changed(self.text); }
                    // Enter starts the first lesson in the list, when it can start.
                    accepted => {
                        if TutorialsModel.rows.length > 0 && TutorialsModel.rows[0].blocked-reason == "" {
                            TutorialsModel.start(TutorialsModel.rows[0].id);
                        }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        spacing: 2px;

                        for row in TutorialsModel.rows: VerticalLayout {
                            spacing: 2px;
                            if row.first-in-category: SectionHeading { text: row.category; }
                            TutorialRow {
                                data: row;
                                start-clicked => { TutorialsModel.start(row.id); }
                            }
                        }

                        if TutorialsModel.rows.length == 0: Text {
                            text: "No tutorial matches your search.";
                            font-size: 11px;
                            color: Theme.text-muted;
                            horizontal-alignment: center;
                            height: 48px;
                            vertical-alignment: center;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        horizontal-stretch: 1;
                        text: TutorialsModel.progress-text;
                        font-size: 10px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Button {
                        text: "Reset Progress";
                        clicked => { TutorialsModel.reset-progress(); }
                    }
                    Button {
                        text: "Close";
                        primary: true;
                        clicked => { TutorialsModel.close-browser(); }
                    }
                }
            }
        }
    }
}
