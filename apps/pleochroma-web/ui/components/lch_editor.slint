import { Button, LineEdit, Slider } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ColorPicker } from "color_picker.slint";
import { AppModel } from "../models/app_model.slint";

// One labelled slider with a readout. `moved` fires when the slider is let go (the web solves
// on the UI thread, so it does not solve at every step of a drag).
component LchRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value-text;
    in property <float> minimum;
    in property <float> maximum;
    in property <bool> enabled: true;
    in-out property <float> value;
    callback moved();

    spacing: 6px;
    Text {
        width: 64px;
        text: root.label;
        font-size: 10px;
        color: Theme.text-muted;
        vertical-alignment: center;
    }
    Slider {
        horizontal-stretch: 1;
        enabled: root.enabled;
        minimum: root.minimum;
        maximum: root.maximum;
        value <=> root.value;
        accessible-label: root.label;
        released(v) => { root.moved(); }
    }
    Text {
        width: 34px;
        text: root.value-text;
        font-size: 10px;
        color: Theme.text-secondary;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
}

// The path-aware body-colour editor (port of the desktop's
// `apps/pleochroma-cut/ui/components/material_editor/lch_editor.slint`): Tone (L*), Saturation
// (C*) and Hue (h) sliders, the hue/saturation/brightness picker as an alternative input, a
// reachability badge and swatches of the solved colour at 3 mm, 5 mm, 10 mm and the open
// stone's own path. The caller owns the state (`DesignSettingsModel.lch-*`) and does the
// solving; this component only shows it and reports `edited` (a slider was let go),
// `picked` (the picker's colour), `applied` and `cancelled`.
//
// A stone that shows a different color in each direction (a two- or three-color material:
// Along / Across the Axis, or Alpha / Beta / Gamma) gets one chip per direction above the
// sliders (`axis-labels` longer than one); the sliders edit the chip that is active
// (`axis-selected`), and the swatches show the face-up color and each direction's. "Save as
// Variant..." (`can-save-variant`) keeps the solved colors under a name for this material.
export component LchEditor inherits Rectangle {
    in property <bool> enabled: true;
    in-out property <float> tone: 55.0;
    in-out property <float> chroma: 40.0;
    in-out property <float> hue: 260.0;
    in property <[color]> swatches: [];
    in property <[string]> swatch-labels: [];
    in property <string> badge-text: "";
    in property <bool> reachable: true;
    in property <bool> has-solution: false;
    // One entry per direction of the stone (empty or one entry: a one-color stone, no chips).
    in property <[string]> axis-labels: [];
    in property <[string]> axis-captions: [];
    in property <[string]> axis-hints: [];
    in property <[color]> axis-colors: [];
    in property <int> axis-active: 0;
    // "Save as Variant..." is offered while the colors are solved and the material is known.
    in property <bool> can-save-variant: false;
    in-out property <string> variant-name: "";
    callback edited(float, float, float);
    callback picked(color);
    callback applied();
    callback cancelled();
    callback axis-selected(int);
    callback save-variant(string);

    property <bool> picker-open: false;
    property <bool> naming: false;

    background: Theme.bg-input;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border-medium;
    height: content.preferred-height;

    content := VerticalLayout {
        padding: 8px;
        spacing: 6px;

        if root.axis-labels.length > 1: VerticalLayout {
            spacing: 4px;
            Text {
                text: "This stone shows a different color in each direction. Pick a direction, then set its color with the sliders.";
                font-size: 9px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            for caption[index] in root.axis-captions: Rectangle {
                height: 24px;
                border-radius: Theme.radius-sm;
                border-width: index == root.axis-active ? 2px : 1px;
                border-color: index == root.axis-active ? Theme.accent-cyan : Theme.border-medium;
                background: axis-touch.has-hover ? Theme.bg-elevated : Theme.bg-card-hover;
                accessible-role: button;
                accessible-label: caption + (index == root.axis-active ? ", selected" : "");
                accessible-description: root.axis-hints[index];
                accessible-action-default => { root.axis-selected(index); }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 6px;
                    Rectangle {
                        width: 14px;
                        height: 14px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 3px;
                        background: root.axis-colors[index];
                        border-width: 1px;
                        border-color: Theme.border-medium;
                        accessible-role: AccessibleRole.image;
                        accessible-label: "Color of " + root.axis-labels[index];
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: caption;
                        font-size: 10px;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                axis-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.axis-selected(index); }
                }
            }
            Text {
                text: root.axis-hints[root.axis-active];
                font-size: 9px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }

        LchRow {
            enabled: root.enabled;
            label: "Tone";
            minimum: 0.0;
            maximum: 100.0;
            value <=> root.tone;
            value-text: "" + Math.round(root.tone);
            moved => { root.edited(root.tone, root.chroma, root.hue); }
        }
        LchRow {
            enabled: root.enabled;
            label: "Saturation";
            minimum: 0.0;
            maximum: 130.0;
            value <=> root.chroma;
            value-text: "" + Math.round(root.chroma);
            moved => { root.edited(root.tone, root.chroma, root.hue); }
        }
        LchRow {
            enabled: root.enabled;
            label: "Hue";
            minimum: 0.0;
            maximum: 360.0;
            value <=> root.hue;
            value-text: "" + Math.round(root.hue) + "\u{b0}";
            moved => { root.edited(root.tone, root.chroma, root.hue); }
        }

        HorizontalLayout {
            spacing: 6px;
            for swatch[index] in root.swatches: VerticalLayout {
                spacing: 2px;
                width: 58px;
                Rectangle {
                    height: 24px;
                    border-radius: 3px;
                    background: swatch;
                    border-width: 1px;
                    border-color: Theme.border-medium;
                    accessible-role: AccessibleRole.image;
                    accessible-label: "Color at " + root.swatch-labels[index];
                }
                Text {
                    text: root.swatch-labels[index];
                    font-size: 9px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Text {
            text: root.badge-text;
            font-size: 10px;
            color: root.reachable ? Theme.text-secondary : Theme.accent-amber;
            wrap: word-wrap;
        }

        if root.picker-open: ColorPicker {
            apply-label: "Use";
            applied(c) => {
                root.picker-open = false;
                root.picked(c);
            }
            cancelled => { root.picker-open = false; }
        }

        if root.can-save-variant: HorizontalLayout {
            spacing: 6px;
            if root.naming: LineEdit {
                horizontal-stretch: 1;
                min-width: 0px;
                text <=> root.variant-name;
                placeholder-text: "Variant Name";
                accessible-label: "Variant Name";
                accepted => {
                    root.naming = false;
                    root.save-variant(root.variant-name);
                }
                changed has-focus => { AppModel.text-focus = self.has-focus; }
            }
            if root.naming: Button {
                text: "Save";
                primary: true;
                enabled: root.enabled && root.variant-name != "";
                clicked => {
                    root.naming = false;
                    root.save-variant(root.variant-name);
                }
            }
            if root.naming: Button {
                text: "Cancel";
                clicked => { root.naming = false; }
            }
            if !root.naming: Button {
                text: "Save as Variant...";
                enabled: root.enabled;
                clicked => { root.naming = true; }
            }
            if !root.naming: Rectangle { horizontal-stretch: 1; }
        }

        HorizontalLayout {
            spacing: 6px;
            Button {
                text: root.picker-open ? "Hide picker" : "Use picker...";
                clicked => { root.picker-open = !root.picker-open; }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "Cancel";
                clicked => { root.cancelled(); }
            }
            Button {
                text: "Apply Color";
                primary: true;
                enabled: root.enabled && root.has-solution;
                clicked => { root.applied(); }
            }
        }
    }
}
