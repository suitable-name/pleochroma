import { Theme } from "theme.slint";
import { MetricsModel } from "metrics_model.slint";

// One "Label: value" pair of the HUD.
component Stat inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> tint;
    spacing: 4px;
    Text {
        text: root.label;
        font-size: 11px;
        font-weight: 600;
        color: Theme.text-muted;
        vertical-alignment: center;
    }
    Text {
        text: root.value;
        font-size: 11px;
        font-weight: 700;
        color: root.tint;
        vertical-alignment: center;
    }
}

// A 60 px stacked bar of the four zone shares (Red, Green, Blue, Dark).
component ZonesBar inherits Rectangle {
    width: 60px;
    height: 8px;
    border-radius: 2px;
    clip: true;
    background: Theme.aset-dark;
    HorizontalLayout {
        Rectangle { horizontal-stretch: MetricsModel.zones-pct[0]; background: Theme.aset-red; }
        Rectangle { horizontal-stretch: MetricsModel.zones-pct[1]; background: Theme.aset-green; }
        Rectangle { horizontal-stretch: MetricsModel.zones-pct[2]; background: Theme.aset-blue; }
        Rectangle { horizontal-stretch: MetricsModel.zones-pct[3]; background: Theme.aset-dark; }
    }
}

// Real-time five-point gemological metrics HUD over the Render tab, with the desktop's labels,
// units and thresholds (`gem_viewport.slint`): Brilliance, Fire, Scintillation, Windowing
// (ruby above 10 %) and Extinction (amber above 12 %), then Contrast and, on the wide layout, a
// line with the Zones (ASET-style) shares (also on the phone, wrapping). `compact` shows the stats in rows.
export component MetricsHud inherits Rectangle {
    in property <bool> compact: false;
    // The widest the HUD may be (the view's width less its margins); a long zones line wraps.
    in property <length> room: 10000px;

    opacity: MetricsModel.pending ? 0.55 : 1.0;
    background: #0f172aee;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border-medium;
    width: root.compact ? min(330px, root.room) : hud.preferred-width;
    height: hud.preferred-height;

    hud := VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 3px;

        if MetricsModel.has-metrics: HorizontalLayout {
            spacing: 12px;
            Stat { label: "Brilliance:"; value: Math.round(MetricsModel.brilliance-pct) + "%"; tint: Theme.accent-emerald; }
            Stat { label: "Fire:"; value: "" + Math.round(MetricsModel.fire-index * 100.0) / 100.0; tint: Theme.accent-cyan; }
            if !root.compact: Stat { label: "Scintillation:"; value: Math.round(MetricsModel.scintillation-pct) + "%"; tint: Theme.accent-purple; }
            if !root.compact: Stat {
                label: "Windowing:";
                value: Math.round(MetricsModel.windowing-pct) + "%";
                tint: MetricsModel.windowing-pct > 10.0 ? Theme.accent-ruby : Theme.text-secondary;
            }
            if !root.compact: Stat {
                label: "Extinction:";
                value: Math.round(MetricsModel.extinction-pct) + "%";
                tint: MetricsModel.extinction-pct > 12.0 ? Theme.accent-amber : Theme.text-secondary;
            }
            if !root.compact && MetricsModel.has-aset: Stat {
                label: "Contrast:";
                value: "" + Math.round(MetricsModel.contrast);
                tint: Theme.text-secondary;
            }
            if !root.compact && MetricsModel.doubling-arcmin > 0.0: Stat {
                label: "Doubling:";
                value: Math.round(MetricsModel.doubling-arcmin * 10.0) / 10.0 + " arcmin";
                tint: Theme.text-secondary;
            }
        }
        // Compact: three rows (two, two, one). Five stats in two rows overflowed a 390px window.
        if MetricsModel.has-metrics && root.compact: HorizontalLayout {
            spacing: 12px;
            Stat { label: "Scintillation:"; value: Math.round(MetricsModel.scintillation-pct) + "%"; tint: Theme.accent-purple; }
            Stat {
                label: "Windowing:";
                value: Math.round(MetricsModel.windowing-pct) + "%";
                tint: MetricsModel.windowing-pct > 10.0 ? Theme.accent-ruby : Theme.text-secondary;
            }
        }
        if MetricsModel.has-metrics && root.compact: HorizontalLayout {
            spacing: 12px;
            Stat {
                label: "Extinction:";
                value: Math.round(MetricsModel.extinction-pct) + "%";
                tint: MetricsModel.extinction-pct > 12.0 ? Theme.accent-amber : Theme.text-secondary;
            }
            if MetricsModel.has-aset: Stat {
                label: "Contrast:";
                value: "" + Math.round(MetricsModel.contrast);
                tint: Theme.text-secondary;
            }
            if MetricsModel.doubling-arcmin > 0.0: Stat {
                label: "Doubling:";
                value: Math.round(MetricsModel.doubling-arcmin * 10.0) / 10.0 + " arcmin";
                tint: Theme.text-secondary;
            }
            // Keeps the last stat at its own width instead of stretching label and value apart.
            Rectangle { horizontal-stretch: 1; }
        }
                // The Zones (ASET-style) line: label, a 60 px stacked bar, the shares, and what the
        // numbers were scored under after a " · ". It is the last row on every layout (the
        // phone wraps it); the label and the bar then stay on a row of their own.
        if MetricsModel.has-metrics && MetricsModel.has-aset && !root.compact: HorizontalLayout {
            spacing: 8px;
            Text { text: "Zones (ASET-style)"; font-size: 11px; font-weight: 600; color: Theme.text-muted; vertical-alignment: center; }
            VerticalLayout { alignment: center; ZonesBar {} }
            Text {
                horizontal-stretch: 1;
                text: MetricsModel.zones-text + (MetricsModel.scored-under-text != "" ? " · " + MetricsModel.scored-under-text : "");
                font-size: 11px;
                color: Theme.text-secondary;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if MetricsModel.has-metrics && MetricsModel.has-aset && root.compact: VerticalLayout {
            spacing: 3px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Zones (ASET-style)"; font-size: 11px; font-weight: 600; color: Theme.text-muted; vertical-alignment: center; }
                VerticalLayout { alignment: center; ZonesBar {} }
                Rectangle { horizontal-stretch: 1; }
            }
            Text {
                text: MetricsModel.zones-text + (MetricsModel.scored-under-text != "" ? " · " + MetricsModel.scored-under-text : "");
                font-size: 11px;
                color: Theme.text-secondary;
                wrap: word-wrap;
                // Two lines when the scored-under note joins the shares.
                min-height: MetricsModel.scored-under-text != "" ? 30px : 15px;
            }
        }
        // No zones measured: the scored-under note keeps its own line.
        if MetricsModel.has-metrics && !MetricsModel.has-aset && MetricsModel.scored-under-text != "": Text {
            text: MetricsModel.scored-under-text;
            font-size: 11px;
            color: Theme.text-muted;
            overflow: elide;
        }
        if !MetricsModel.has-metrics: Text {
            text: MetricsModel.status-text;
            font-size: 11px;
            color: Theme.text-muted;
        }
    }
}
