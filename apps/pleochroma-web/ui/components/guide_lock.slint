import { GuideModel } from "../models/guide_model.slint";

// Transparent layer that explains a locked control: while `locked` is true it shows
// `GuideModel.locked-hint` as a tooltip over its parent's whole area. Mount it inside a
// control's non-layout wrapper (a `Rectangle`) with no size of its own, so it fills the
// wrapper. The control carries the matching `enabled: GuideModel.allows-*()`. It has no
// `TouchArea`, so it never takes a click. Its `Tooltip` sits here rather than on the
// wrapper, because Slint allows one `Tooltip` per element and the wrapper may have its own.
export component GuideLockTip inherits Rectangle {
    in property <bool> locked: false;

    if root.locked: Tooltip {
        text: @markdown("\{GuideModel.locked-hint}");
    }
}
