import { Button } from "std-widgets.slint";
import { Theme } from "../components/theme.slint";
import { AppModel } from "../models/app_model.slint";
import { GuideModel } from "../models/guide_model.slint";
import { InspectorModel } from "inspector_model.slint";
import { InfoLine, SectionTitle } from "inspector_widgets.slint";

// The Schedule tab: the design's own cut order, built from the same conversion the `.asc`
// export writes, with the cutting-sheet downloads beside it.
export component ScheduleTab inherits VerticalLayout {
    spacing: 6px;

    SectionTitle { text: "Schedule"; }
    if InspectorModel.schedule-rows.length == 0: Text {
        text: "Not solved -- the design's own cut order appears here once it solves.";
        font-size: 10px;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    if InspectorModel.schedule-rows.length > 0: VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            spacing: 6px;
            Text { horizontal-stretch: 1; text: "FACET"; font-size: 9px; font-weight: 700; color: Theme.text-muted; }
            Text { width: 48px; text: "ANGLE"; font-size: 9px; font-weight: 700; color: Theme.text-muted; }
            Text { horizontal-stretch: 2; text: "INDEX"; font-size: 9px; font-weight: 700; color: Theme.text-muted; }
        }
        for row in InspectorModel.schedule-rows: VerticalLayout {
            HorizontalLayout {
                spacing: 6px;
                Text { horizontal-stretch: 1; text: row.facet; font-size: 10px; color: Theme.text-secondary; overflow: elide; }
                Text { width: 48px; text: row.angle; font-size: 10px; color: Theme.text-secondary; }
                Text { horizontal-stretch: 2; text: row.index-val; font-size: 10px; color: Theme.text-secondary; overflow: elide; }
            }
            if row.notes != "": Text { text: row.notes; font-size: 9px; color: Theme.text-muted; wrap: word-wrap; }
        }
    }
    // The downloads, locked while a guide step leaves file actions closed (like the File menu
    // items they stand beside). The guided walkthrough outlines them through the
    // `schedule_cutting_sheet` and `schedule_diagram` highlight targets, since it cannot outline
    // the menu items. Both cutting sheets share one outline. The diagram has a row of its own
    // to keep the tab narrow.
    HorizontalLayout {
        spacing: 6px;
        Rectangle {
            border-radius: Theme.radius-sm;
            border-width: GuideModel.highlight-target == "schedule_cutting_sheet" ? 2px : 0px;
            border-color: Theme.accent-cyan;
            HorizontalLayout {
                padding: 2px;
                spacing: 6px;
                Button {
                    text: "Cutting Sheet (HTML)";
                    enabled: AppModel.has-design && GuideModel.allows-file-ops();
                    clicked => { AppModel.download-cutting-sheet(); }
                }
                Button {
                    text: "Cutting Sheet (PDF)";
                    enabled: AppModel.has-design && GuideModel.allows-file-ops();
                    clicked => { AppModel.download-cutting-sheet-pdf(); }
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    HorizontalLayout {
        spacing: 6px;
        Rectangle {
            border-radius: Theme.radius-sm;
            border-width: GuideModel.highlight-target == "schedule_diagram" ? 2px : 0px;
            border-color: Theme.accent-cyan;
            HorizontalLayout {
                padding: 2px;
                Button {
                    text: "Diagram (PNG)";
                    enabled: AppModel.has-design && GuideModel.allows-file-ops();
                    clicked => { AppModel.download-diagram(); }
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    InfoLine { text: "The .asc export is the copyable form of this table (File > Save .asc)."; }
}
