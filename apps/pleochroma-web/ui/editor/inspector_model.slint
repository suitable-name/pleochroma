// The inspector's state, pushed by `src/editor/inspector` and edited by its tabs
// (modelled on the desktop's `EditorModel` inspector fields). A global is only a Rust
// type if `app.slint`'s export block names it.

// One per-facet chip of the Tier tab (`pleochroma_editor::view_model::IndexChip`).
export struct ChipRow {
    label: string,
    position: float,
    detached: bool,
}

// One row of the Schedule tab (`pleochroma_editor::view_model::CuttingRow`).
export struct ScheduleRow {
    facet: string,
    angle: string,
    index-val: string,
    notes: string,
}

// The read-only "Solved" section of the Tier tab, from the tier's row of the last solve.
export struct SolvedInfo {
    visible: bool,
    mast: string,
    block: string,
    strategy: string,
    strategy-detail: string,
    strategy-uncertain: bool,
    margin-text: string,
    risk-level: int,
    orbit-status: string,
    orbit-incomplete: bool,
    meet-partners: string,
    imported-meet: string,
    warning: string,
}

// One proportion metric's "within / near / outside" judgement; `level` -1 = nothing to
// judge yet.
export struct Verdict {
    level: int,
    reason: string,
}

// The Preform tab's five verdict chips.
export struct VerdictSet {
    table: Verdict,
    crown-angle: Verdict,
    pavilion-angle: Verdict,
    total-depth: Verdict,
    girdle: Verdict,
}

// The Preform tab's read-only figures (proportions, ratios, yield), `""` = not available.
export struct PreformReadout {
    half-width-mm: string,
    depth-mm: string,
    table-pct: string,
    crown-height: string,
    pavilion-depth: string,
    total-depth: string,
    length-to-width: string,
    girdle-thickness: string,
    crown-to-width: string,
    pavilion-to-width: string,
    girdle-to-width: string,
    volumetric-yield: string,
    carat-weight: string,
    specific-gravity-used: string,
    preform-fit-warning: string,
}

export global InspectorModel {
    // -- Shell ---------------------------------------------------------------------
    // 0 Tier, 1 Preform, 2 Optimize, 3 Schedule, 4 History.
    in-out property <int> tab: 0;
    in-out property <bool> collapsed: false;
    // A request to put the keyboard cursor in a Tier-tab field ("angle" or "constraint"):
    // Rust sets `focus-target`, raises `focus-pending` and bumps `focus-serial`; the tab
    // focuses the field (as it appears, or at once when it is already there) and clears
    // `focus-pending`. "+ Add Tier" asks for the angle, the table's "Add Anchor" for the
    // scale value, "New Concave Tier" for the concave form's name ("concave-name").
    in-out property <string> focus-target: "";
    in-out property <bool> focus-pending: false;
    in-out property <int> focus-serial: 0;

    // -- Tier tab: the form ----------------------------------------------------------
    // The five fields are the form's scratch state AND the display of the loaded tier.
    // Nothing commits until Save / Add Tier.
    in-out property <string> tier-angle: "0.0";
    in-out property <int> tier-constraint-kind: 0;
    in-out property <string> tier-constraint-text: "";
    in-out property <string> tier-name: "";
    in-out property <string> tier-indices: "";
    // The values `loaded-*` last seeded / saved; `form-dirty` is a pure comparison
    // against them (the desktop's rule).
    in property <string> loaded-angle: "0.0";
    in property <int> loaded-constraint-kind: 0;
    in property <string> loaded-constraint-text: "";
    in property <string> loaded-name: "";
    in property <string> loaded-indices: "";
    // The tier the form represents; -1 = "Add Tier" draft.
    in property <int> loaded-tier-index: -1;
    out property <bool> form-dirty: root.tier-angle != root.loaded-angle
        || root.tier-constraint-kind != root.loaded-constraint-kind
        || root.tier-constraint-text != root.loaded-constraint-text
        || root.tier-name != root.loaded-name
        || root.tier-indices != root.loaded-indices;
    // The selection moved on while the form held an unsaved draft.
    in property <bool> show-dirty-warning: false;
    in property <int> pending-load-index: -1;
    // The last save's error, and which field it concerns ("angle", "name", "indices",
    // "constraint" or "").
    in-out property <string> form-error: "";
    in-out property <string> form-error-field: "";
    // The live critical-angle bar under the angle field.
    in property <string> angle-margin-text: "";
    in property <int> angle-margin-level: -1;
    in property <bool> angle-margin-is-estimate: false;
    // Per-facet chips of the loaded tier, and the scratch fields beside them.
    in property <[ChipRow]> chips: [];
    in-out property <string> new-facet-position: "";
    in-out property <string> rotate-by-text: "1";
    in-out property <string> cheater-text: "";
    in-out property <string> note-text: "";
    in property <SolvedInfo> solved;
    // A design that does not solve for lack of a scale anchor: the tab explains it.
    in property <bool> anchor-hint: false;

    callback save-tier();
    callback new-tier();
    callback keep-draft();
    callback discard-draft();
    // The angle field was edited (or stepped): refresh the live margin bar.
    callback angle-edited();
    callback facet-toggle-detach(float);
    callback facet-remove(float);
    callback facet-add();
    // +1 or -1 times the "rotate by" field.
    callback rotate(int);
    callback mirror();
    callback apply-cheater();
    callback apply-note();

    // -- Tier tab: the concave form --------------------------------------------------
    // A concave tier (a separate list from the flat tiers, cut by a tool) has its own form,
    // shown in the Tier tab INSTEAD of the flat one while `concave-mode` is on. Rust turns
    // the mode on when a concave row is selected (`EditorSession::selected_concave`) or
    // `new-concave()` runs, and off when a flat tier is selected; nothing else needs to set
    // it. Like the flat form the fields are a scratch draft: nothing commits until
    // `save-concave()`. Every field is text and Rust parses it
    // (`parse_concave_tier_form`), prefixing each error with its field.
    in-out property <bool> concave-mode: false;
    // Facet line.
    in-out property <string> c-name: "";
    in-out property <string> c-angle: "";
    in-out property <string> c-indices: "";
    in-out property <string> c-instructions: "";
    // Tool line. `c-tool` is the combo index: 0 CYL, 1 CON, 2 CIR, 3 DSC, 4 SPH (the
    // desktop's order); only a cone (1) and a disc (3) take `c-tool-angle`.
    in-out property <int> c-tool: 0;
    in-out property <string> c-theta: "";
    in-out property <string> c-x: "";
    in-out property <string> c-y: "";
    in-out property <string> c-z: "";
    in-out property <string> c-diameter: "";
    in-out property <string> c-tool-angle: "";
    in-out property <bool> c-reciprocating: true;
    // What the `loaded-c-*` snapshot last seeded / saved; `concave-dirty` compares with it.
    in property <string> loaded-c-name: "";
    in property <string> loaded-c-angle: "";
    in property <string> loaded-c-indices: "";
    in property <string> loaded-c-instructions: "";
    in property <int> loaded-c-tool: 0;
    in property <string> loaded-c-theta: "";
    in property <string> loaded-c-x: "";
    in property <string> loaded-c-y: "";
    in property <string> loaded-c-z: "";
    in property <string> loaded-c-diameter: "";
    in property <string> loaded-c-tool-angle: "";
    in property <bool> loaded-c-reciprocating: true;
    // The concave tier the form represents (an index into the concave list, NOT a table
    // row id); -1 = "Add Concave Tier" draft.
    in property <int> loaded-concave-index: -1;
    out property <bool> concave-dirty: root.c-name != root.loaded-c-name
        || root.c-angle != root.loaded-c-angle
        || root.c-indices != root.loaded-c-indices
        || root.c-instructions != root.loaded-c-instructions
        || root.c-tool != root.loaded-c-tool
        || root.c-theta != root.loaded-c-theta
        || root.c-x != root.loaded-c-x
        || root.c-y != root.loaded-c-y
        || root.c-z != root.loaded-c-z
        || root.c-diameter != root.loaded-c-diameter
        || root.c-tool-angle != root.loaded-c-tool-angle
        || root.c-reciprocating != root.loaded-c-reciprocating;
    // The selection moved on while the form held an unsaved draft; the label of the
    // discard button names where it would go ("Discard Draft, Load Concave #2").
    in property <bool> concave-show-dirty-warning: false;
    in property <string> concave-pending-label: "";
    // The tier changed in the design (undo, redo, another edit) after the draft started.
    in property <bool> concave-external-change: false;
    // The last save's error, and the field it concerns ("name", "angle", "indices", "tool",
    // "theta", "x", "y", "z", "diameter", "tool_angle" or "").
    in-out property <string> concave-error: "";
    in-out property <string> concave-error-field: "";
    // The read-only "Sheet Line" of a saved tier (the tool line the cutting sheet prints).
    in property <bool> concave-sheet-visible: false;
    in property <string> concave-sheet-line: "";
    in property <string> concave-orbit-status: "";
    in property <bool> concave-orbit-incomplete: false;
    in property <string> concave-warning: "";

    // Add Concave Tier / Save Concave Tier (and Enter in a field).
    callback save-concave();
    // Opens a blank concave draft (tab 0, selection cleared): the table's "+ Add Concave
    // Tier" calls this.
    callback new-concave();
    callback concave-keep-draft();
    callback concave-discard-draft();
    callback concave-reload();
    callback concave-dismiss-external();

    // -- Preform tab -----------------------------------------------------------------
    in-out property <int> preform-shape-index: 1;
    // Where the design's rough came from when it is a planned piece from the Rough Planner
    // (a plane set, not a block or cylinder); empty for a block or cylinder.
    in property <string> preform-source-note: "";
    in-out property <string> preform-half-width: "";
    in-out property <string> preform-length-over-width: "";
    in-out property <string> preform-depth: "";
    in-out property <string> preform-y-offset-mm: "";
    in-out property <string> girdle-diameter-mm: "";
    in-out property <string> specific-gravity-override: "";
    // Typed since the last Apply (the "*" on the button).
    in-out property <bool> preform-pending: false;
    in-out property <bool> yield-pending: false;
    in property <PreformReadout> readout;
    // Nothing to judge (level -1) until the first push.
    in property <VerdictSet> verdicts: {
        table: { level: -1, reason: "" },
        crown-angle: { level: -1, reason: "" },
        pavilion-angle: { level: -1, reason: "" },
        total-depth: { level: -1, reason: "" },
        girdle: { level: -1, reason: "" },
    };

    callback apply-preform();
    callback apply-yield();

    // -- Schedule tab ----------------------------------------------------------------
    in property <[ScheduleRow]> schedule-rows: [];

    // -- History tab -------------------------------------------------------------------
    // What each undo step did, newest first (`EditorSession::history_entries`, reversed).
    // Step `n` of `history-labels.length` is row `length - n`; step 0 is "Start".
    in property <[string]> history-labels: [];
    // The step the design stands at now: 0 before any step, up to the number of steps.
    in property <int> history-position: 0;
    // Go to step `n` (`EditorSession::jump_to`), ending in the shared edit path.
    callback history-jump(int);
}
