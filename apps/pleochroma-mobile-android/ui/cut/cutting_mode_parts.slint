// Pieces of the Cutting Mode screen. The screen is the quietest, highest-contrast page of the
// app, for the faceting machine: the page ground with the primary text on it, the cyan accent
// for the facet code and the step bar, and the largest type of the app. Its colors are the
// theme's, so High Contrast (a black ground, white text, a bright cyan, 3 px edges) carries
// over. No hover states: a finger has no hover.
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Icon } from "../shell/icon.slint";

export global ModeColors {
    out property <color> background: Theme.surface;
    out property <color> ink: Theme.on-surface;
    // Captions and secondary text: the desktop's text-secondary (7:1 on the ground).
    out property <color> dim: Theme.text-secondary;
    out property <color> accent: Theme.accent;
    // A done step: the success green with dark text on it.
    out property <color> done: Theme.success;
    out property <color> on-done: Theme.on-success;
    out property <color> key: Theme.surface-container;
    out property <color> key-pressed: Theme.surface-highest;
    out property <color> outline: Theme.outline-variant;
    out property <color> track: Theme.surface-highest;
    // The width of the edge of the step buttons.
    out property <length> edge: Theme.high-contrast ? 3px : 1px;
}

// A small gray label above a number.
export component ModeCaption inherits Text {
    color: ModeColors.dim;
    font-size: Theme.text-label;
    font-weight: 600;
    letter-spacing: 1.5px;
}

// A caption and one big number. The number shrinks to fit `avail-width`, `size-cap` and
// the height budget `max-height`, never below `min-size`. With `max-lines` above 1 a long
// value (the index list) wraps at the spaces, so a number is never cut in half or elided.
export component Numeral inherits VerticalLayout {
    in property <string> caption;
    in property <string> value;
    // What is drawn, when it differs from `value` only by invisible break hints (which
    // must not count toward the size); empty draws `value`.
    in property <string> display;
    in property <length> avail-width;
    in property <length> size-cap: 96px;
    in property <length> min-size: 36px;
    // Lines the value may use, 1 to 3.
    in property <int> max-lines: 1;
    // The height all lines together may use.
    in property <length> text-room: 200px;

    // A digit is about 0.6 em wide; 0.62 leaves room for the dashes and the degree sign.
    // For L lines a line holds about n / L characters, plus 4 spare for the word breaks.
    property <float> chars: max(root.value.character-count, 1) * 1.0;
    property <length> size-1: min(root.size-cap, min(root.text-room / 1.2, root.avail-width / (root.chars * 0.62)));
    property <length> size-2: min(root.size-cap, min(root.text-room / 2.4, root.avail-width / ((ceil(root.chars / 2.0) + 4.0) * 0.62)));
    property <length> size-3: min(root.size-cap, min(root.text-room / 3.6, root.avail-width / ((ceil(root.chars / 3.0) + 4.0) * 0.62)));
    // The largest size at which the value fits in at most `max-lines` lines.
    property <length> best: root.max-lines >= 3 ? max(root.size-1, max(root.size-2, root.size-3)) : (root.max-lines == 2 ? max(root.size-1, root.size-2) : root.size-1);
    property <length> size: max(root.min-size, root.best);

    spacing: 0px;

    ModeCaption {
        text: root.caption;
    }

    Text {
        text: root.display != "" ? root.display : root.value;
        color: ModeColors.ink;
        font-size: root.size;
        font-weight: 700;
        horizontal-alignment: left;
        vertical-alignment: center;
        wrap: root.max-lines > 1 ? TextWrap.word-wrap : TextWrap.no-wrap;
    }
}

// The previous and next buttons, in the thumb zone: 64 px high (56 at least), at least 72
// wide, a large chevron and the word beside it. `trailing` puts the chevron after the word
// (Next). `label` is the accessible name.
export component ModeArrow inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    // The word on the button.
    in property <string> caption: "";
    in property <bool> trailing: false;
    in property <bool> enabled: true;
    callback clicked();

    min-width: 72px;
    height: 64px;
    horizontal-stretch: 1;
    border-radius: 16px;
    border-width: ModeColors.edge;
    border-color: ModeColors.outline;
    background: root.enabled && touch.pressed ? ModeColors.key-pressed : ModeColors.key;
    opacity: root.enabled ? 1.0 : 0.3;
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 4px;
        cross-axis-alignment: center;

        if !root.trailing: Icon {
            source: root.icon;
            tint: ModeColors.ink;
            glyph: 40px;
        }

        Text {
            text: root.caption;
            color: ModeColors.ink;
            font-size: Theme.text-title-large;
            font-weight: 600;
            vertical-alignment: center;
        }

        if root.trailing: Icon {
            source: root.icon;
            tint: ModeColors.ink;
            glyph: 40px;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// The full-width "Done" toggle, 72 px high. Done is a solid green with a check mark, not
// done is a bright outline, so the state reads from across the bench.
export component DoneButton inherits Rectangle {
    in property <bool> done;
    callback clicked();

    height: 72px;
    border-radius: 20px;
    border-width: root.done ? 0px : 3px;
    border-color: ModeColors.ink;
    background: root.done ? ModeColors.done : (touch.pressed ? ModeColors.key-pressed : ModeColors.background);
    accessible-role: AccessibleRole.switch;
    accessible-label: "Done";
    accessible-checkable: true;
    accessible-checked: root.done;
    accessible-action-default => {
        root.clicked();
    }

    HorizontalLayout {
        alignment: center;
        spacing: 12px;
        cross-axis-alignment: center;

        if root.done: Icon {
            source: Icons.check;
            tint: ModeColors.on-done;
            glyph: 40px;
        }

        Text {
            text: root.done ? "Done" : "Mark as Done";
            color: root.done ? ModeColors.on-done : ModeColors.ink;
            font-size: Theme.base-font * 2.14;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The thin bar under the header: how far through the steps the cutter is.
export component StepBar inherits Rectangle {
    in property <float> fraction: 0.0;

    height: 4px;
    background: ModeColors.track;

    Rectangle {
        x: 0px;
        width: root.width * max(0.0, min(1.0, root.fraction));
        height: root.height;
        background: ModeColors.accent;
    }
}
