import { Shell } from "../models.slint";
import { Theme } from "../theme.slint";
import { TopBar } from "../shell/top_bar.slint";
import { PageScroll } from "../shell/page_scroll.slint";
import { PrimaryButton, TextButton } from "../shell/buttons.slint";
import { ListRow } from "../shell/list_row.slint";
import { ChoiceField, Stepper, ToggleRow, TextField, ProgressBar } from "../shell/inputs.slint";
import { FieldLabel, PageColumn, GroupHeader } from "../pages/fields.slint";
import { Card } from "props/props_parts.slint";

export struct OptimizeRange { tier: int, name: string, minimum: string, maximum: string, locked: bool }
export global OptimizeModel {
    in-out property <bool> open: false;
    in property <bool> release-ready: false;
    in property <[string]> presets;
    in-out property <int> preset: 0;
    in-out property <int> effort: 1;
    in-out property <bool> only-selected: false;
    in-out property <bool> vary-anchored: false;
    in-out property <bool> keep-girdle: true;
    in-out property <bool> advanced: false;
    in-out property <string> budget: "300";
    in-out property <int> starts: 4;
    in-out property <string> seed: "0";
    in-out property <bool> polish: true;
    in-out property <int> candidates: 3;
    in-out property <string> window-weight: "0.5";
    in-out property <string> extinction-weight: "0.3";
    in-out property <string> tilt-weight: "0.2";
    in-out property <string> yield-weight: "0";
    in-out property <string> tone: "0";
    in-out property <[OptimizeRange]> ranges;
    in property <bool> running: false;
    in property <string> status;
    in property <[string]> results;
    in property <string> comparison;
    in property <bool> can-apply: false;
    in-out property <string> variant-name: "Optimize candidate";
    callback show(); callback close(); callback start(); callback cancel();
    callback select(int); callback apply(); callback save-variant(); callback reset-ranges();
}

// A caption above a text field.
component Field inherits VerticalLayout {
    in property <string> label;
    in property <InputType> input-type: InputType.text;
    in-out property <string> value;
    spacing: Theme.space-xs;
    FieldLabel { text: root.label; }
    TextField { text <=> root.value; label: root.label; input-type: root.input-type; }
}

// A caption above a stepper.
component StepField inherits VerticalLayout {
    in property <string> label;
    in property <int> minimum;
    in property <int> maximum;
    in-out property <int> value;
    spacing: Theme.space-xs;
    FieldLabel { text: root.label; }
    Stepper { label: root.label; minimum: root.minimum; maximum: root.maximum; value <=> root.value; }
}

// The page's side margin for the texts and buttons that sit between the cards.
component Pad inherits VerticalLayout {
    padding-left: Theme.space-lg;
    padding-right: Theme.space-lg;
    padding-top: Theme.space-xs;
    padding-bottom: Theme.space-xs;
    spacing: Theme.space-sm;
}

export component OptimizeScreen inherits Rectangle {
    background: Theme.surface;
    TouchArea { }
    VerticalLayout {
        TopBar { title: "Optimize"; show-back: true; back-clicked => { Shell.request-back(); } }
        PageScroll {
            vertical-stretch: 1;
            PageColumn { VerticalLayout {
                padding-bottom: Theme.space-lg;
                if !OptimizeModel.release-ready: Pad {
                    Text {
                        text: "Awaiting shared preservation regression validation. Available in development builds; release enablement requires owner validation.";
                        color: Theme.text-secondary; wrap: word-wrap;
                    }
                }
                GroupHeader { text: "SEARCH"; }
                Card {
                    VerticalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            FieldLabel { text: "Preset"; }
                            ChoiceField { label: "Preset"; model: OptimizeModel.presets; current-index <=> OptimizeModel.preset; }
                        }
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            FieldLabel { text: "Search Effort"; }
                            ChoiceField {
                                label: "Search Effort";
                                model: ["Quick · 100 evaluations", "Normal · 300 evaluations", "Thorough · 800 evaluations"];
                                current-index <=> OptimizeModel.effort;
                                selected(value) => { OptimizeModel.budget = OptimizeModel.effort == 0 ? "100" : OptimizeModel.effort == 1 ? "300" : "800"; }
                            }
                        }
                        ToggleRow { text: "Only Selected Flat Tiers"; checked <=> OptimizeModel.only-selected; }
                        ToggleRow { text: "Vary Anchored Tiers About Their Girdle Hinges"; checked <=> OptimizeModel.vary-anchored; toggled => { OptimizeModel.reset-ranges(); } }
                        ToggleRow { text: "Keep Girdle Thickness"; checked <=> OptimizeModel.keep-girdle; }
                        ToggleRow { text: "Advanced"; checked <=> OptimizeModel.advanced; }
                    }
                }
                if OptimizeModel.advanced: VerticalLayout {
                    GroupHeader { text: "ADVANCED"; }
                    Card {
                        VerticalLayout {
                            spacing: Theme.space-md;
                            Field { label: "Evaluation Budget"; input-type: InputType.number; value <=> OptimizeModel.budget; }
                            Field { label: "Seed"; input-type: InputType.number; value <=> OptimizeModel.seed; }
                            HorizontalLayout {
                                spacing: Theme.space-md;
                                StepField { horizontal-stretch: 1; label: "Starts"; minimum: 1; maximum: 32; value <=> OptimizeModel.starts; }
                                StepField { horizontal-stretch: 1; label: "Candidates"; minimum: 1; maximum: 5; value <=> OptimizeModel.candidates; }
                            }
                            ToggleRow { text: "Polish Candidates"; checked <=> OptimizeModel.polish; }
                        }
                    }
                    GroupHeader { text: "WEIGHTS"; }
                    Card {
                        VerticalLayout {
                            spacing: Theme.space-md;
                            Field { label: "Custom Windowing Weight"; input-type: InputType.decimal; value <=> OptimizeModel.window-weight; }
                            Field { label: "Custom Extinction Weight"; input-type: InputType.decimal; value <=> OptimizeModel.extinction-weight; }
                            Field { label: "Custom Tilt Brilliance Weight"; input-type: InputType.decimal; value <=> OptimizeModel.tilt-weight; }
                            Field { label: "Custom Yield Weight"; input-type: InputType.decimal; value <=> OptimizeModel.yield-weight; }
                            Field { label: "Custom Tone (−3 to +3)"; value <=> OptimizeModel.tone; }
                        }
                    }
                    GroupHeader { text: "ANGLE RANGES"; }
                    Pad { Text { text: "Angle magnitudes (degrees). Relation followers stay locked."; color: Theme.text-secondary; wrap: word-wrap; } }
                    Card {
                        VerticalLayout {
                            spacing: Theme.space-md;
                            for row[index] in OptimizeModel.ranges: VerticalLayout {
                                spacing: Theme.space-xs;
                                Text { text: row.name + (row.locked ? " · relation follower" : ""); color: Theme.on-surface; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: Theme.space-sm;
                                    TextField { compact: true; label: row.name + " minimum"; input-type: InputType.decimal; text <=> row.minimum; enabled: !row.locked; }
                                    TextField { compact: true; label: row.name + " maximum"; input-type: InputType.decimal; text <=> row.maximum; enabled: !row.locked; }
                                }
                            }
                        }
                    }
                }
                Pad {
                    PrimaryButton { text: "Run Optimize"; enabled: OptimizeModel.release-ready && !OptimizeModel.running; clicked => { OptimizeModel.start(); } }
                    if OptimizeModel.running: ProgressBar { indeterminate: true; }
                    if OptimizeModel.running: TextButton { text: "Cancel Search"; clicked => { OptimizeModel.cancel(); } }
                    Text { text: OptimizeModel.status; color: Theme.on-surface; wrap: word-wrap; }
                }
                for candidate[index] in OptimizeModel.results: ListRow { title: candidate; clicked => { OptimizeModel.select(index); } }
                Pad {
                    Text { text: OptimizeModel.comparison; color: Theme.on-surface; wrap: word-wrap; }
                    PrimaryButton { text: "Apply Selected Candidate"; enabled: OptimizeModel.can-apply; clicked => { OptimizeModel.apply(); } }
                }
                Card {
                    Field { label: "Variant Name"; value <=> OptimizeModel.variant-name; }
                }
                Pad { TextButton { text: "Save Selected Candidate As Variant"; enabled: OptimizeModel.can-apply; clicked => { OptimizeModel.save-variant(); } } }
            } }
        }
    }
}
