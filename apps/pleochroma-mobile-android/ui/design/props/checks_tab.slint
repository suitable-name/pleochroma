// The Checks tab: each finding of the verdict is a card (a warning icon, a heading, the finding
// in words, "Show on the Stone", "Open <tier>" where a tier applies, and a Fix button where the
// shared code offers a one-step fix); when there are none, one positive line. Below them the
// proportions table, the preform and yield inputs, the weight estimate and the metrics.
//
// The verdict needs a solve that matches the design; until then a card says what is missing
// (`PropsModel.checks-note`) and only the preform fields work. The tab fills its parent.
import { Theme } from "../../theme.slint";
import { Icons } from "../../icons.slint";
import { Shell } from "../../models.slint";
import { Icon } from "../../shell/icon.slint";
import { PageScroll } from "../../shell/page_scroll.slint";
import { ListRow } from "../../shell/list_row.slint";
import { StateLayer } from "../../shell/state_layer.slint";
import { InfoButton } from "../../shell/info.slint";
import { PrimaryButton, TonalButton, TextButton } from "../../shell/buttons.slint";
import { TiersModel } from "../tiers/tiers_model.slint";
import { TierIcons } from "../tiers/tier_icons.slint";
import { PropsModel, WarningItem, ProportionItem } from "props_model.slint";
import { SectionHeader, SettingBlock, NumberField, MetricLine } from "props_parts.slint";
import { NumberSheet } from "number_sheet.slint";
import { TiltSheet } from "tilt_sheet.slint";

// Side padding around a card.
component Inset inherits HorizontalLayout {
    padding-left: Theme.space-lg;
    padding-right: Theme.space-lg;
    padding-top: Theme.space-xs;
    padding-bottom: Theme.space-xs;

    @children
}

// What the verdict means; behind the info button of the status card and the Warnings header.
// (`InfoButton` takes plain strings, so both places share this one text.)
global VerdictInfo {
    out property <string> body: "Good: the stone solves and closes, and nothing needs a second look. Check: it can be cut, but something deserves attention. Problem: it does not solve or close, or the optics are clearly poor. The cards below say why, and some have a Fix button that makes the change in one undoable step.";
}

// The status above the findings, for the two states without a card per finding: no solve
// that matches the design yet (what is missing, or the problem), and a clean verdict (one
// positive line).
component StatusCard inherits Rectangle {
    property <int> level: PropsModel.verdict-level;
    property <bool> ready: PropsModel.checks-ready;
    property <bool> problem: !root.ready && root.level == 2;

    background: root.ready ? Theme.success-container.with-alpha(0.35) : (root.problem ? Theme.error-container : Theme.surface-high);
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: root.ready ? Theme.success : (root.problem ? Theme.error : Theme.outline-variant);
    height: content.preferred-height;

    content := HorizontalLayout {
        padding: Theme.space-md;
        padding-left: Theme.space-lg;
        spacing: Theme.space-md;

        Rectangle {
            width: 24px;

            Icon {
                y: 0px;
                source: root.ready ? Icons.check : (root.problem ? TierIcons.warning : Icons.info);
                tint: root.ready ? Theme.success : (root.problem ? Theme.error : Theme.text-secondary);
                glyph: 24px;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: Theme.space-xs;
            horizontal-stretch: 1;

            if !root.ready: Text {
                text: root.problem ? "Problem" : "Not Checked Yet";
                color: Theme.on-surface;
                font-size: Theme.text-title;
                font-weight: 600;
                wrap: word-wrap;
            }

            Text {
                text: root.ready ? PropsModel.verdict-text : PropsModel.checks-note;
                color: root.ready ? Theme.on-surface : Theme.text-secondary;
                font-size: Theme.text-body-large;
                wrap: word-wrap;
            }
        }

        InfoButton {
            info-title: "Verdict";
            info-body: VerdictInfo.body;
        }
    }
}

// One finding as a card: a warning icon and heading, the finding in words, then "Show on the
// Stone" (selects its tier) and "Open <tier>" (the tier's sheet) where a tier applies, and the
// Fix button where there is a one-step fix. A fix that removes something asks first, right
// in the card.
component WarningCard inherits Rectangle {
    in property <WarningItem> item;
    // The heading; the finding's own words stand in until it arrives.
    in property <string> title;
    // The label of the "Open <tier>" button; empty when the finding is not about a flat tier.
    in property <string> open-label;
    callback show-tier();
    callback open-tier();
    callback run-fix();

    property <bool> armed: false;
    // 2 problem, 1 check, 0 a note.
    property <color> tint: root.item.level == 2 ? Theme.error : (root.item.level == 1 ? Theme.warning : Theme.text-secondary);

    background: root.item.level == 2 ? Theme.error-container : (root.item.level == 1 ? Theme.warning-container : Theme.surface-high);
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: root.item.level == 0 ? Theme.outline-variant : root.tint;
    height: content.preferred-height;

    changed item => {
        root.armed = false;
    }

    content := VerticalLayout {
        padding: Theme.space-lg;
        spacing: Theme.space-sm;

        HorizontalLayout {
            spacing: Theme.space-sm;

            Rectangle {
                width: 24px;

                Icon {
                    y: 0px;
                    source: root.item.level == 0 ? Icons.info : TierIcons.warning;
                    tint: root.tint;
                    glyph: 24px;
                }
            }

            Text {
                text: root.title != "" ? root.title : root.item.text;
                color: Theme.on-surface;
                font-size: Theme.text-title;
                font-weight: 600;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }

        if root.title != "": Text {
            text: root.item.text;
            // On the tinted card the primary text color reads best; a note stays secondary.
            color: root.item.level == 0 ? Theme.text-secondary : Theme.on-surface;
            font-size: Theme.text-body-large;
            wrap: word-wrap;
        }

        if root.armed: Text {
            text: root.item.confirm;
            color: Theme.on-surface;
            font-size: Theme.text-body;
            font-weight: 500;
            wrap: word-wrap;
        }

        if root.item.tier >= 0 && !root.armed: HorizontalLayout {
            alignment: start;
            spacing: Theme.space-sm;

            TonalButton {
                text: "Show on the Stone";
                clicked => {
                    root.show-tier();
                }
            }

            if root.open-label != "": PrimaryButton {
                text: root.open-label;
                clicked => {
                    root.open-tier();
                }
            }
        }

        if root.item.fix-label != "" || root.armed: HorizontalLayout {
            alignment: start;
            spacing: Theme.space-xs;

            if root.item.fix-label != "" && !root.armed: TonalButton {
                text: root.item.fix-label;
                clicked => {
                    if (root.item.confirm == "") {
                        root.run-fix();
                    } else {
                        root.armed = true;
                    }
                }
            }

            if root.item.fix-label != "" && !root.armed: InfoButton {
                info-title: root.item.fix-label;
                info-body: root.item.fix-hint;
            }

            if root.armed: TextButton {
                text: "Cancel";
                clicked => {
                    root.armed = false;
                }
            }

            if root.armed: PrimaryButton {
                text: "Confirm";
                clicked => {
                    root.armed = false;
                    root.run-fix();
                }
            }
        }
    }
}

// One line of the proportions table. Tap a judged line for the reference range's reason.
component ProportionLine inherits Rectangle {
    in property <ProportionItem> item;

    min-height: 48px;
    accessible-role: AccessibleRole.button;
    accessible-label: root.item.label + ", " + root.item.value;
    accessible-enabled: root.item.reason != "";

    StateLayer {
        pressed: touch.pressed;
        hovered: touch.has-hover;
        enabled: root.item.reason != "";
    }

    HorizontalLayout {
        padding-left: Theme.space-lg;
        padding-right: Theme.space-lg;
        spacing: Theme.space-sm;

        Text {
            text: root.item.label;
            color: Theme.on-surface;
            font-size: Theme.text-body-large;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        Text {
            text: root.item.value;
            color: Theme.on-surface;
            font-size: Theme.text-body-large;
            font-weight: 500;
            vertical-alignment: center;
        }

        Rectangle {
            width: 16px;

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: Theme.verdict-mark(root.item.level);
            }
        }
    }

    touch := TouchArea {
        enabled: root.item.reason != "";
        clicked => {
            Shell.show-info(root.item.label, root.item.reason);
        }
    }
}

component ChecksBody inherits PageScroll {
    // No solve for this design yet, or a clean verdict: one card or line. (A verdict with
    // findings has no banner; its cards are the answer.)
    if !PropsModel.checks-ready || PropsModel.warnings.length == 0: Inset {
        StatusCard { }
    }

    if PropsModel.checks-ready && PropsModel.warnings.length > 0: HorizontalLayout {
        SectionHeader {
            text: "Warnings";
            horizontal-stretch: 1;
        }

        InfoButton {
            info-title: "Verdict";
            info-body: VerdictInfo.body;
        }
    }

    for warning[index] in PropsModel.warnings: Inset {
        WarningCard {
            item: warning;
            title: index < TiersModel.check-titles.length ? TiersModel.check-titles[index] : "";
            open-label: index < TiersModel.check-open-labels.length ? TiersModel.check-open-labels[index] : "";
            show-tier => {
                PropsModel.show-warning(index);
            }
            open-tier => {
                PropsModel.show-warning(index);
                PropsModel.close-number();
                PropsModel.design-tab = 0;
                TiersModel.open-tier(TiersModel.check-open-rows[index]);
            }
            run-fix => {
                PropsModel.fix-warning(index);
            }
        }
    }

    if PropsModel.proportions.length > 0: SectionHeader {
        text: "Proportions";
    }

    for line in PropsModel.proportions: ProportionLine {
        item: line;
    }

    SectionHeader {
        text: "Preform";
    }

    if PropsModel.preform-note != "": Inset {
        Text {
            text: PropsModel.preform-note;
            color: Theme.on-surface-variant;
            font-size: Theme.text-body;
            wrap: word-wrap;
        }
    }

    SettingBlock {
        title: "Half-Width";
        value-text: PropsModel.preform-half-width-mm;
        info-body: "Half the rough's width, in the design's own units: the stone's girdle half-width is 1, so the rough has to be wider than 1, for example 1.2.";

        NumberField {
            key: "checks-half-width";
            caption: "Half-Width";
            clearable: false;
            text <=> PropsModel.preform-half-width;
            enabled: PropsModel.preform-editable;
            placeholder: "Half-width";
            committed(value) => {
                PropsModel.field-committed("half-width", value);
            }
        }
    }

    SettingBlock {
        title: "Length / Width";
        info-body: "The rough's length divided by its width. 1 is square or round; larger is longer, for example 1.5.";

        NumberField {
            key: "checks-length-width";
            caption: "Length / Width";
            clearable: false;
            text <=> PropsModel.preform-length-width;
            enabled: PropsModel.preform-editable;
            placeholder: "Length over width";
            committed(value) => {
                PropsModel.field-committed("length-width", value);
            }
        }
    }

    SettingBlock {
        title: "Depth";
        value-text: PropsModel.preform-depth-mm;
        info-body: "The rough's total height from table to culet, in the same units as the Half-Width, for example 1.5.";

        NumberField {
            key: "checks-depth";
            caption: "Depth";
            clearable: false;
            text <=> PropsModel.preform-depth;
            enabled: PropsModel.preform-editable;
            placeholder: "Depth";
            committed(value) => {
                PropsModel.field-committed("depth", value);
            }
        }
    }

    SectionHeader {
        text: "Yield";
    }

    SettingBlock {
        title: "Girdle Diameter";
        info-body: "Real girdle diameter in millimetres, used for the carat estimate and for the color depth of the picture. It is the same value as Stone Width on the Stone tab. Use Clear Value to leave it unset.";

        NumberField {
            key: "checks-girdle-mm";
            caption: "Girdle Diameter";
            text <=> PropsModel.preform-girdle-mm;
            placeholder: "not set";
            unit: "mm";
            committed(value) => {
                PropsModel.field-committed("girdle-mm", value);
            }
        }
    }

    SettingBlock {
        title: "Specific Gravity";
        info-body: "Specific gravity for the carat estimate. It does not affect the picture. Clear Value uses the material's own figure.";

        NumberField {
            key: "checks-sg";
            caption: "Specific Gravity";
            text <=> PropsModel.preform-sg;
            placeholder: "material's own";
            committed(value) => {
                PropsModel.field-committed("sg", value);
            }
        }
    }

    for line in PropsModel.yield-lines: Inset {
        Text {
            text: line;
            color: Theme.on-surface-variant;
            font-size: Theme.text-body-large;
            wrap: word-wrap;
        }
    }

    SectionHeader {
        text: "Metrics";
    }

    // The five metrics, seen near face-up. Stale numbers stay dimmed until computed again.
    for metric-name[index] in PropsModel.metric-labels: MetricLine {
        label: metric-name;
        value: PropsModel.metric-values[index];
        meaning: PropsModel.metric-meanings[index];
        dimmed: PropsModel.metrics-state == 3 || PropsModel.metrics-state == 2;
    }

    if PropsModel.metrics-note != "": Inset {
        Text {
            text: PropsModel.metrics-note;
            color: PropsModel.metrics-state == 5 ? Theme.error : Theme.on-surface-variant;
            font-size: Theme.text-body;
            wrap: word-wrap;
        }
    }

    Inset {
        HorizontalLayout {
            alignment: start;
            spacing: Theme.space-sm;

            TonalButton {
                text: PropsModel.metrics-state == 2 ? "Measuring..." : (PropsModel.metric-labels.length > 0 ? "Compute Again" : "Compute Metrics");
                enabled: PropsModel.metrics-state != 2 && PropsModel.metrics-state != 0;
                clicked => {
                    PropsModel.metrics-compute();
                }
            }

            InfoButton {
                info-title: "Metrics";
                info-body: "Brilliance, fire, scintillation, windowing and extinction of the stone seen near face-up, scored under the lighting you chose on the Light tab (an HDR map counts). They are measured on demand because each measurement traces many rays. The numbers go dim when the design or the lighting changes.";
            }
        }
    }

    ListRow {
        title: "Tilt Curves";
        supporting: "Brilliance, extinction and windowing as the stone tips, on four axes";
        enabled: PropsModel.metrics-state != 0 || PropsModel.tilt-state != 0;
        clicked => {
            PropsModel.open-tilt();
        }
    }

    Rectangle {
        height: Theme.space-xl;
    }
}

export component ChecksTab inherits Rectangle {
    ChecksBody { }

    NumberSheet { }

    TiltSheet { }
}
