// The Light tab: the lighting rig (a grid of pictures for the common rigs, and a list of all of
// them), the backdrop, the HDR map, where the light shines from, how bright the picture is
// and what the viewer does to the reflections.
//
// The rig, exposure, light direction, backdrop and head shadow persist across restarts
// (they are app settings, not part of the design). A slider applies when it is released.
// The tab fills its parent. "All Rigs" opens the full list over the tab at full sheet height
// (`PropsModel.rigs-open`); the sheet leaving full height (the Back key, a drag down) closes it.
import { Theme } from "../../theme.slint";
import { Icons } from "../../icons.slint";
import { Shell } from "../../models.slint";
import { Icon } from "../../shell/icon.slint";
import { PageScroll } from "../../shell/page_scroll.slint";
import { StateLayer } from "../../shell/state_layer.slint";
import { TopBar } from "../../shell/top_bar.slint";
import { Segmented } from "../../shell/chips.slint";
import { ListRow } from "../../shell/list_row.slint";
import { Toggle } from "../../shell/toggle.slint";
import { TonalButton, TextButton } from "../../shell/buttons.slint";
import { PropsModel } from "props_model.slint";
import { SectionHeader, SettingBlock, SliderBlock, Card, RigTile, RigRow } from "props_parts.slint";

// The rig grid: two columns of tiles, the tile height from its own content (the picture and
// one line of text at the current font size).
component RigGrid inherits Rectangle {
    property <length> cell: (self.width - 2 * Theme.space-lg - Theme.space-sm) / 2;
    // A tile's height: padding, the 56 px picture, the gap and one line of text.
    property <length> tile: 2 * Theme.space-md + 56px + Theme.space-sm + Theme.text-body * 1.4;
    property <int> rows: Math.ceil(PropsModel.grid-rigs.length / 2);

    height: rows * tile + max(0, rows - 1) * Theme.space-sm + 2 * Theme.space-xs;

    for rig[index] in PropsModel.grid-rigs: RigTile {
        x: Theme.space-lg + Math.mod(index, 2) * (root.cell + Theme.space-sm);
        y: Theme.space-xs + Math.floor(index / 2) * (root.tile + Theme.space-sm);
        width: root.cell;
        height: root.tile;
        kind: rig.kind;
        name: rig.short-name;
        title: rig.title;
        detail: rig.description;
        selected: rig.selected;
        clicked => {
            PropsModel.preset-picked(rig.name);
        }
    }
}

// The link under the grid that opens the full list.
component AllRigsLink inherits Rectangle {
    height: Theme.touch;
    accessible-role: AccessibleRole.button;
    accessible-label: "All Rigs";
    accessible-action-default => {
        PropsModel.open-rigs();
    }

    StateLayer {
        pressed: touch.pressed;
        hovered: touch.has-hover;
    }

    HorizontalLayout {
        padding-left: Theme.space-lg;
        padding-right: Theme.space-lg;
        spacing: Theme.space-xs;
        alignment: end;

        Text {
            text: "All \{PropsModel.presets.length} Rigs";
            color: Theme.accent;
            font-size: Theme.text-body-large;
            font-weight: 500;
            vertical-alignment: center;
        }

        Rectangle {
            width: 20px;

            Icon {
                source: Icons.chevron-right;
                tint: Theme.accent;
                glyph: 20px;
            }
        }
    }

    touch := TouchArea {
        clicked => {
            PropsModel.open-rigs();
        }
    }
}

// The HDR map row: its name (or None) and "Choose..." (import or replace the file); while a map
// is on file the whole card chooses it as the lighting, and "Clear" removes it.
component HdrCard inherits Card {
    inner-padding: 0px;
    selected: PropsModel.hdr-selected;

    Rectangle {
        height: row.preferred-height;

        // Taps on the card choose the map as the lighting; the buttons sit above this area.
        StateLayer {
            pressed: pick.pressed;
            hovered: pick.has-hover;
            enabled: PropsModel.hdr-available;
            border-radius: Theme.radius-lg;
        }

        pick := TouchArea {
            enabled: PropsModel.hdr-available;
            clicked => {
                PropsModel.hdr-use(true);
            }
        }

        row := VerticalLayout {
            padding: Theme.space-lg;
            padding-top: Theme.space-sm;
            padding-bottom: Theme.space-sm;
            spacing: Theme.space-xs;

            HorizontalLayout {
                spacing: Theme.space-md;

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 2px;
                    accessible-role: AccessibleRole.button;
                    accessible-label: "HDR Map, " + (PropsModel.hdr-available ? PropsModel.hdr-description : "None");
                    accessible-enabled: PropsModel.hdr-available;
                    accessible-checkable: true;
                    accessible-checked: PropsModel.hdr-selected;
                    accessible-action-default => {
                        if (PropsModel.hdr-available) {
                            PropsModel.hdr-use(true);
                        }
                    }

                    Text {
                        text: "HDR Map";
                        color: Theme.on-surface;
                        font-size: Theme.text-body-large;
                        font-weight: PropsModel.hdr-selected ? 700 : 400;
                    }

                    Text {
                        text: PropsModel.hdr-available ? PropsModel.hdr-description : "None";
                        color: Theme.on-surface-variant;
                        font-size: Theme.text-body;
                        wrap: word-wrap;
                    }
                }

                VerticalLayout {
                    alignment: center;

                    TonalButton {
                        text: PropsModel.hdr-busy ? "Reading..." : "Choose\u{2026}";
                        accessible-label: PropsModel.hdr-busy ? "Reading..." : (PropsModel.hdr-available ? "Replace Map" : "Import Map");
                        enabled: !PropsModel.hdr-busy;
                        clicked => {
                            PropsModel.hdr-import();
                        }
                    }
                }
            }

            if PropsModel.hdr-available: HorizontalLayout {
                alignment: start;

                TextButton {
                    text: "Clear";
                    enabled: !PropsModel.hdr-busy;
                    clicked => {
                        PropsModel.hdr-clear();
                    }
                }
            }
        }
    }
}

// The Light tab's settings.
component LightSettings inherits PageScroll {
    SectionHeader {
        text: "Lighting Rig";
    }

    RigGrid { }

    AllRigsLink { }

    SectionHeader {
        text: "Environment";
    }

    Card {
        inner-padding: 0px;

        SettingBlock {
            title: "Backdrop";
            info-body: "Backdrop: the surface the stone lies on, lit by the lighting and seen both around the stone and through its windows. As Lit: the lighting's own ground (for the Grading Tray, nothing below the girdle, so windows look black). Black: velvet, 2% reflectance. Grey: an 18% grey card. White: paper, 90% reflectance. Under a ring light a white tray is very bright; lower the exposure or pick Black.";

            // Shown as As Lit, Black, Grey, White. Stored backdrop values: 0 as lit, 1 grey,
            // 2 white, 3 black.
            Segmented {
                options: ["As Lit", "Black", "Grey", "White"];
                current: PropsModel.backdrop == 0 ? 0 : (PropsModel.backdrop == 3 ? 1 : (PropsModel.backdrop == 1 ? 2 : 3));
                selected(position) => {
                    PropsModel.backdrop-picked(position == 0 ? 0 : (position == 1 ? 3 : (position == 2 ? 1 : 2)));
                }
            }
        }
    }

    HdrCard { }

    SectionHeader {
        text: PropsModel.hdr-selected ? "Map Rotation" : "Light Direction";
    }

    Card {
        inner-padding: 0px;

        // While the HDR map is the lighting this slider turns the map (it has no main light).
        SliderBlock {
            title: PropsModel.hdr-selected ? "Map Rotation" : "Light Azimuth";
            value-text: Math.round(PropsModel.azimuth) + "°";
            info-body: PropsModel.hdr-selected ? "Map rotation: turns the HDR map around the stone (0 to 360 degrees). Dragging in the picture turns it too." : "Light azimuth: the direction the main light shines from, as an angle around the stone (0 to 360 degrees).";
            enabled: PropsModel.hdr-selected || PropsModel.uses-light-direction;
            value <=> PropsModel.azimuth;
            minimum: 0;
            maximum: 360;
            step: 1;
            released => {
                PropsModel.light-released();
            }
        }

        if !PropsModel.hdr-selected: SliderBlock {
            title: "Light Elevation";
            value-text: Math.round(PropsModel.elevation) + "°";
            info-body: "Light elevation: how high the main light is above the stone, from low and raking to nearly straight overhead.";
            enabled: PropsModel.uses-light-direction;
            value <=> PropsModel.elevation;
            minimum: 9;
            maximum: 88;
            step: 1;
            released => {
                PropsModel.light-released();
            }
        }

        if PropsModel.hdr-selected: ListRow {
            title: "Turns with the Camera";
            supporting: PropsModel.hdr-follows-camera ? "The map stays fixed relative to the camera" : "The map stays fixed in the room";
            clicked => {
                PropsModel.hdr-follow-changed(!PropsModel.hdr-follows-camera);
            }

            Toggle {
                checked: PropsModel.hdr-follows-camera;
                toggled(value) => {
                    PropsModel.hdr-follow-changed(value);
                }
            }
        }
    }

    SectionHeader {
        text: "Exposure";
    }

    Card {
        inner-padding: 0px;

        SliderBlock {
            title: "Overall Brightness";
            value-text: Math.round(PropsModel.exposure * 100.0) / 100.0 + "x";
            info-body: "Exposure: the overall brightness of the picture. 1x is the normal level.";
            value <=> PropsModel.exposure;
            minimum: 0.2;
            maximum: 5;
            step: 0.05;
            released => {
                PropsModel.light-released();
            }
        }
    }

    SectionHeader {
        text: "Observer";
    }

    Card {
        inner-padding: 0px;

        SliderBlock {
            title: "Surface Glare";
            value-text: Math.round(PropsModel.glare) + " %";
            info-body: "Surface glare: hides the white mirror image of the light on the table so the inner facets stay visible. 0 % keeps only light that entered the stone. Applies to the built-in lighting rigs, to the path-traced picture and to exports.";
            value <=> PropsModel.glare;
            minimum: 0;
            maximum: 100;
            step: 5;
            released => {
                PropsModel.light-released();
            }
        }

        SliderBlock {
            title: "Head Shadow";
            value-text: PropsModel.head-shadow < 0.5 ? "Off" : Math.round(PropsModel.head-shadow) + "°";
            info-body: "How much of the sky the viewer's head hides: the dark table reflections a face-up stone shows. 16 degrees is a head at arm's length; 0 turns it off. Product-photography rigs (D65 Daylight, Incandescent, Ring Lights, Dramatic Dark Spotlight) ignore it.";
            enabled: PropsModel.uses-head-shadow;
            value <=> PropsModel.head-shadow;
            minimum: 0;
            maximum: 30;
            step: 1;
            released => {
                PropsModel.light-released();
            }
        }
    }

    Rectangle {
        height: Theme.space-xl;
    }
}

// The full list of rigs. Picking one chooses it and goes back to the tab.
component RigList inherits Rectangle {
    background: Theme.surface-container;

    // Swallows taps so they do not reach the tab below.
    TouchArea { }

    VerticalLayout {
        TopBar {
            title: "Lighting Rig";
            show-back: true;
            background: transparent;
            back-clicked => {
                PropsModel.close-rigs();
            }
        }

        PageScroll {
            vertical-stretch: 1;

            for rig in PropsModel.presets: RigRow {
                kind: rig.kind;
                title: rig.title;
                detail: rig.description;
                selected: rig.selected;
                clicked => {
                    PropsModel.preset-picked(rig.name);
                    PropsModel.close-rigs();
                }
            }

            Rectangle {
                height: Theme.space-xl;
            }
        }
    }
}

export component LightTab inherits Rectangle {
    // When the page's sheet comes back down (the Back key, a drag) the list closes with it.
    property <int> detent-watch: Shell.sheet-detent;

    changed detent-watch => {
        if (Shell.sheet-detent < 2 && PropsModel.rigs-open) {
            PropsModel.dismiss-rigs();
        }
    }

    LightSettings { }

    if PropsModel.rigs-open: RigList { }
}
