// The Render mode of the design viewport, in two layers that `DesignViewport` places
// around its gesture layer:
//
//   RenderPicture    the tone-mapped frame, contain-fitted (below the gesture layer)
//   RenderControls   progress/status and primary Pause / Resume, Settings and Export actions;
//                    Settings unfolds renderer/compute/quality, Light and Denoise (above it)
//
// Everything comes from `RenderModel`. The camera gestures are the Solid view's; with the
// Light chip on, one finger moves the light instead (Rust routes the pointer events).
import { Theme } from "../../theme.slint";
import { RenderModel } from "render_model.slint";
export { RenderControls } from "render_controls.slint";

// The rendered picture, centered and scaled to fit; a message while there is none.
export component RenderPicture inherits Rectangle {
    background: Theme.surface-low;
    accessible-role: AccessibleRole.image;
    accessible-label: "Rendered picture";

    Image {
        visible: RenderModel.has-frame;
        width: parent.width;
        height: parent.height;
        source: RenderModel.frame;
        image-fit: contain;
        // The picture shows the light as it was; dimmed while the light moves.
        opacity: RenderModel.light-moving ? 0.65 : 1.0;
        animate opacity { duration: Theme.motion-short; }
    }

    // Where the light is while the Light chip is on: azimuth around the dial from the top
    // (clockwise), elevation as the distance from the centre (overhead is the middle). It
    // follows the finger live; the picture catches up after the finger lifts.
    if RenderModel.light-drag: Rectangle {
        x: (parent.width - self.width) / 2;
        y: Theme.space-sm;
        width: 200px;
        height: 128px;
        background: Theme.surface.with-alpha(0.78);
        border-radius: Theme.radius-md;
        accessible-role: AccessibleRole.text;
        accessible-label: "Light position: " + RenderModel.light-readout;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Theme.space-sm;
            width: 88px;
            height: 88px;
            border-radius: 44px;
            border-width: 1px;
            border-color: Theme.outline;
            background: Theme.surface-low.with-alpha(0.6);

            // The 45 degree elevation ring, and the cross hairs through the centre.
            Rectangle {
                x: 22px;
                y: 22px;
                width: 44px;
                height: 44px;
                border-radius: 22px;
                border-width: 1px;
                border-color: Theme.outline-variant;
            }
            Rectangle {
                x: 43px;
                y: 0px;
                width: 1px;
                height: parent.height;
                background: Theme.outline-variant;
            }
            Rectangle {
                x: 0px;
                y: 43px;
                width: parent.width;
                height: 1px;
                background: Theme.outline-variant;
            }

            // The light: the dial's radius less the dot's own.
            Rectangle {
                x: 36px + RenderModel.light-dial-x * 36px;
                y: 36px + RenderModel.light-dial-y * 36px;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: Theme.primary;
            }
        }

        Text {
            x: 0px;
            y: 100px;
            width: parent.width;
            height: 22px;
            text: RenderModel.light-readout;
            color: Theme.on-surface;
            font-size: Theme.text-label;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    if !RenderModel.has-frame: Text {
        x: Theme.space-lg;
        width: parent.width - 2 * Theme.space-lg;
        height: parent.height;
        text: RenderModel.status-text;
        color: Theme.on-surface-variant;
        font-size: Theme.text-body;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

