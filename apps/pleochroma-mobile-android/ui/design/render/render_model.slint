// The data and callbacks between Rust and the Render view (`render_view.slint`) and the
// export sheet (`export_sheet.slint`). Rust -> Slint is properties, Slint -> Rust is
// callbacks. A global is visible to Rust only if `app.slint`'s `export { ... }` names it.
export global RenderModel {
    in property <int> engine: 0;
    callback engine-selected(int);
    // ---- the picture ---------------------------------------------------------------
    // The latest tone-mapped frame, and whether one has landed yet.
    in property <image> frame;
    in property <bool> has-frame: false;

    // ---- the overlay ---------------------------------------------------------------
    // The UI owns the settings tray; native Back closes a dropdown before the tray.
    in-out property <bool> controls-open: false;
    // The line under the picture: "Rendering 24 / 64", "Done", "Paused: device is hot",
    // "Solve the design to render it".
    in property <string> status-text: "";
    // The pill's two lines in plain words, from Rust: a title ("Refining", "Done", "Paused")
    // and a detail ("41 / 64 · on this device's GPU"). `status-text` stays the one-line form.
    in property <string> pill-title: "";
    in property <string> pill-detail: "";
    // The picture's own backdrop color (its corner pixel); fills the viewport around the
    // contain-fitted frame.
    in property <color> backdrop: #0b0e15;
    // How far the trace is, 0 to 1.
    in property <float> progress: 0.0;
    // True while paused; the chip then reads Resume.
    in property <bool> paused: false;
    // A trace exists that Pause can act on.
    in property <bool> can-pause: false;
    // Sample counts for the path tracer, quality tiers for the ray tracer.
    in property <[string]> quality-choices: ["16 samples", "32 samples", "64 samples"];
    in property <int> quality: 1;
    in property <bool> denoise: true;
    // One finger moves the light instead of the camera.
    in property <bool> light-drag: false;
    // The light-position indicator, shown while the Light chip is on: the dot's place on the
    // dial (-1 to 1 each way, azimuth clockwise from the top, elevation as the distance from
    // the centre), the numbers under it, and whether the picture is stale because the light
    // is moving or a trace for its new place is still owed (the picture is dimmed then).
    in property <float> light-dial-x: 0.0;
    in property <float> light-dial-y: 0.0;
    in property <string> light-readout: "";
    in property <bool> light-moving: false;
    // A solve is current and nothing holds the render back: there is something to render and
    // export. The GPU probe turns it off, so the pill shows no Retry chip meanwhile.
    in property <bool> can-render: false;
    // The GPU probe holds renders and exports back. The export button is dimmed but a tap
    // still reaches Rust, which answers with a toast.
    in property <bool> probe-held: false;

    // ---- the long-step offer ---------------------------------------------------------
    // After 45 s in one preparing step: a sentence and a button that renders on the CPU.
    // The card sits above the pill, or is the settings tray's first row while it is open.
    in property <bool> offer-visible: false;
    in property <string> offer-sentence: "";
    in property <string> offer-button: "";
    callback use-cpu-requested();

    // The lines Render Details adds under the engineering report: the CPU sentence, the
    // shader cache and the preparation time, one per line.
    in property <string> details-lines: "";

    in property <int> backend: 0;
    in property <string> backend-report;
    callback backend-selected(int);

    callback restart-requested();
    callback pause-toggled();
    callback quality-selected(int);
    callback denoise-toggled();
    callback light-toggled();
    callback export-requested();

    // ---- the export sheet ----------------------------------------------------------
    in property <bool> export-open: false;
    // The choices ("512 px", "64"), and the chosen index of each (the sheet writes the
    // index, then reports `export-options-changed`). Color space: 0 sRGB, 1 Display P3.
    in property <[string]> export-sizes;
    in-out property <int> export-size: 0;
    in property <[string]> export-samples;
    in-out property <int> export-spp: 0;
    in-out property <int> export-color: 0;
    // The sentence under the options ("About 40 seconds.").
    in property <string> export-estimate: "";
    // A job can be built (a solve is current); otherwise `export-problem` says why not.
    in property <bool> export-ready: false;
    in property <string> export-problem: "";
    in property <bool> export-running: false;
    in property <float> export-progress: 0.0;
    // A finished picture is waiting to be shared or saved; `export-result` names it.
    in property <bool> export-done: false;
    in property <string> export-result: "";
    // A line shown whatever else is: where a server job can be followed.
    in-out property <string> export-note: "";

    callback export-options-changed();
    callback export-render();
    callback export-submit-job();
    callback export-cancel();
    callback export-share();
    callback export-save();
    callback export-closed();
}
