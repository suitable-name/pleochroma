// The design viewport: the shaded solid or the 2D diagram as a picture, a gesture layer
// over it, the manipulation handles, the Slice line, and the glass controls around it.
//
// Fills its parent. Everything it shows comes from `ViewportModel`; the raster, the pan
// and zoom and every handle position are computed in Rust (`src/design/viewport`).
//
// Gestures (recognized in Rust from the raw events forwarded here):
//   one finger     orbit (Solid) or pan (Diagram); tap picks a tier; double tap resets
//                  the camera or enlarges a diagram panel; long press opens a text card;
//                  dragging a handle's disc edits the selected tier
//   two fingers    pinch zooms (the camera distance in Solid, the picture in Diagram) and
//                  the fingers' centre pans
//   desktop preview  left drag = one finger, wheel = pinch, right drag = two-finger pan
//
// Controls, all glass over the picture (top row 48 px, edges 8 px plus the system insets):
//   top left     the Solid / Diagram / Render segment (and, on a wide view, the tool chips)
//   top right    the View button: Front, Top, Bottom, Left, Right, Fit, Reset and the
//                Handles / Slice / Snap toggles ("Reset" alone in Diagram)
//   under it     the figures card (Solid and Render), folded to one line on a phone
//   foot         in Render, the status pill (`ui/design/render`)
//
// The third view mode, Render, swaps the picture for the progressive rendered frame
// (`ui/design/render`). The camera gestures are the same; the raster, picks and handles
// belong to Solid and Diagram only.
import { ProgressBar } from "../../shell/inputs.slint";
import { PleoFigures, PleoFigure } from "@pleochroma-kit/shared/figures.slint";
import { Theme } from "../../theme.slint";
import { Icons } from "../../icons.slint";
import { Prefs, Shell } from "../../models.slint";
import { Navigation } from "../../navigation.slint";
import { Chip } from "../../shell/chips.slint";
import { IconButton } from "../../shell/icon_button.slint";
import { StateLayer } from "../../shell/state_layer.slint";
import { RenderPicture, RenderControls } from "../render/render_view.slint";
import { RenderModel } from "../render/render_model.slint";
import { PropsModel } from "../props/props_model.slint";
import { ViewportModel } from "viewport_model.slint";

// A straight bar from (x0, y0), `len` long, tilted by `deg` degrees. The handles' stems
// and the Slice line are drawn with it. (Slint ignores a transform on a component's
// root element, so the root is a zero-size anchor and the child bar rotates.)
component Stem inherits Rectangle {
    in property <length> x0;
    in property <length> y0;
    in property <length> len;
    in property <float> deg;
    in property <color> tint: white;
    in property <length> thickness: 2px;

    x: root.x0;
    y: root.y0;
    width: 0px;
    height: 0px;

    Rectangle {
        x: 0px;
        y: -root.thickness / 2;
        width: root.len;
        height: root.thickness;
        background: root.tint;
        transform-origin: { x: 0px, y: root.thickness / 2 };
        transform-rotation: root.deg * 1deg;
    }
}

// The disc on the tip of a handle, with its letter (A angle, D depth, I index).
component HandleDot inherits Rectangle {
    in property <string> letter;
    in property <color> tint;
    in property <length> cx;
    in property <length> cy;
    in property <bool> active: false;
    property <length> diameter: 32px * ViewportModel.handle-scale;

    x: root.cx - root.diameter / 2;
    y: root.cy - root.diameter / 2;
    width: root.diameter;
    height: root.diameter;
    border-radius: root.diameter / 2;
    background: root.tint.with-alpha(0.92);
    border-width: root.active ? 4px : 2px;
    border-color: white;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.letter;
        color: white;
        font-size: root.diameter * 0.45;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A row of chips on a glass pill (the tool chips and the Slice row sit on it, so they read
// on a light render backdrop too).
component GlassBar inherits Rectangle {
    background: Theme.glass-bg;
    border-radius: Theme.touch / 2;
    border-width: 1px;
    border-color: Theme.glass-edge;
    width: lay.preferred-width;
    height: Theme.touch;

    // Taps on the bar are not taps on the picture below.
    TouchArea { }

    lay := HorizontalLayout {
        padding-left: Theme.space-xs;
        padding-right: Theme.space-xs;
        spacing: Theme.space-xs;
        alignment: start;
        @children
    }
}

// The Solid / Diagram / Render segment on glass: the chosen one is a cyan-surface pill.
component GlassSegmented inherits Rectangle {
    in property <[string]> options;
    in property <int> current: 0;
    callback selected(int);

    height: Theme.touch;
    background: Theme.glass-bg;
    border-radius: Theme.touch / 2;
    border-width: 1px;
    border-color: Theme.glass-edge;

    HorizontalLayout {
        padding: 4px;
        spacing: 0px;

        for option[index] in root.options: Rectangle {
            border-radius: (Theme.touch - 8px) / 2;
            background: index == root.current ? Theme.accent-surface : transparent;
            border-width: index == root.current ? 1px : 0px;
            border-color: Theme.accent;
            accessible-role: AccessibleRole.button;
            accessible-label: option;
            accessible-checkable: true;
            accessible-checked: index == root.current;
            accessible-action-default => { root.selected(index); }

            StateLayer {
                pressed: segment-touch.pressed;
                hovered: segment-touch.has-hover;
                border-radius: parent.border-radius;
            }

            Text {
                text: option;
                color: index == root.current ? Theme.on-surface : Theme.text-secondary;
                font-size: Theme.text-label-large;
                font-weight: index == root.current ? 700 : 500;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }

            segment-touch := TouchArea {
                clicked => { root.selected(index); }
            }
        }
    }
}

// The glass View button (or "Reset" in the Diagram view).
component ViewButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked();

    width: max(Theme.touch * 1.5, label.preferred-width + 2 * Theme.space-lg);
    height: Theme.touch;
    background: Theme.glass-bg;
    border-radius: Theme.touch / 2;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.glass-edge;
    accessible-role: AccessibleRole.button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }

    StateLayer {
        pressed: touch.pressed;
        hovered: touch.has-hover;
        border-radius: root.border-radius;
    }

    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.selected ? Theme.accent : Theme.on-surface;
        font-size: Theme.text-label-large;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component DesignViewport inherits Rectangle {
    background: Theme.surface-low;
    clip: true;
    accessible-role: AccessibleRole.image;
    accessible-label: "Design viewport";

    property <bool> camera-menu <=> Navigation.camera-menu-open;
    // A press is held: only then are moves worth forwarding.
    property <bool> down: false;
    // A view wide enough carries the Handles / Slice / Snap chips beside the Solid /
    // Diagram switch; a narrower one (a phone) keeps them in the View menu.
    property <bool> tools-inline: root.width >= 560px;
    // The tool chips exist in the Solid view outside Slice mode (Slice mode has its own row).
    property <bool> tools-shown: ViewportModel.view-mode == 0 && !ViewportModel.slice-mode;
    // Whether the View menu has the tool row.
    property <bool> menu-tools: !root.tools-inline && root.tools-shown;

    // Edge to edge: a compact view spans the whole window, so the cutout and gesture insets
    // apply to its sides; a wide view sits beside the rail and the pane. The sheet and the
    // navigation bar already keep the bottom inset on a compact window.
    property <length> pad-left: Theme.space-sm + (Shell.window-class == 0 ? Shell.inset-left : 0px);
    property <length> pad-right: Theme.space-sm + (Shell.window-class == 0 ? Shell.inset-right : 0px);
    property <length> pad-bottom: Theme.space-sm + Shell.page-inset-bottom;
    // Below the top row.
    property <length> top-edge: Theme.space-sm + Theme.touch + Theme.space-sm;
    // The Slice row sits under the top row.
    // The Diagram's panel segment (a phone draws one panel at a time) sits there too.
    property <bool> panel-row: ViewportModel.view-mode == 1 && ViewportModel.diagram-single;
    property <length> below-rows: root.top-edge + ((ViewportModel.slice-mode && ViewportModel.view-mode == 0) || root.panel-row ? Theme.touch + Theme.space-sm : 0px);

    // The numbers, from the Checks tab's measurements (empty until measured).
    // The width of the figures card while it is folded (0 until it has been), which the open
    // grid takes.
    property <length> folded-figures-width: 0px;
    property <bool> has-figures: PropsModel.metric-labels.length >= 5 && PropsModel.metric-values.length >= 5;
    // Contrast follows Extinction when it was measured (the rows come from `metric_rows`).
    property <bool> has-contrast: root.has-figures && PropsModel.metric-labels.length >= 6 && PropsModel.metric-values.length >= 6 && PropsModel.metric-labels[5] == "Contrast";
    property <[PleoFigure]> figures: root.has-contrast ? [
        { name: PropsModel.metric-labels[0], short: "Bril", value: PropsModel.metric-values[0], delta: "", part: 0, ink: Theme.accent, trend: 0, flag: false },
        { name: PropsModel.metric-labels[1], short: "Fire", value: PropsModel.metric-values[1], delta: "", part: 0, ink: Theme.accent, trend: 0, flag: false },
        { name: PropsModel.metric-labels[2], short: "Scint", value: PropsModel.metric-values[2], delta: "", part: 0, ink: Theme.accent, trend: 0, flag: false },
        { name: PropsModel.metric-labels[3], short: "Wind", value: PropsModel.metric-values[3], delta: "", part: 0, ink: Theme.accent, trend: 0, flag: false },
        { name: PropsModel.metric-labels[4], short: "Ext", value: PropsModel.metric-values[4], delta: "", part: 0, ink: Theme.accent, trend: 0, flag: false },
        { name: PropsModel.metric-labels[5], short: "Contr", value: PropsModel.metric-values[5], delta: "", part: 0, ink: Theme.accent, trend: 0, flag: false },
    ] : root.has-figures ? [
        { name: PropsModel.metric-labels[0], short: "Bril", value: PropsModel.metric-values[0], delta: "", part: 0, ink: Theme.accent, trend: 0, flag: false },
        { name: PropsModel.metric-labels[1], short: "Fire", value: PropsModel.metric-values[1], delta: "", part: 0, ink: Theme.accent, trend: 0, flag: false },
        { name: PropsModel.metric-labels[2], short: "Scint", value: PropsModel.metric-values[2], delta: "", part: 0, ink: Theme.accent, trend: 0, flag: false },
        { name: PropsModel.metric-labels[3], short: "Wind", value: PropsModel.metric-values[3], delta: "", part: 0, ink: Theme.accent, trend: 0, flag: false },
        { name: PropsModel.metric-labels[4], short: "Ext", value: PropsModel.metric-values[4], delta: "", part: 0, ink: Theme.accent, trend: 0, flag: false },
    ] : [];

    function button-code(button: PointerEventButton) -> int {
        if (button == PointerEventButton.left) {
            return 0;
        }
        if (button == PointerEventButton.right) {
            return 1;
        }
        return 2;
    }

    init => {
        // The figures start folded on a phone and open on a tablet; after that the choice
        // is the user's, for the session.
        if (!ViewportModel.figures-fold-seeded) {
            ViewportModel.figures-folded = Shell.window-class == 0;
            ViewportModel.figures-fold-seeded = true;
        }
        ViewportModel.view-resized(root.width, root.height);
    }

    changed width => {
        ViewportModel.view-resized(root.width, root.height);
    }

    changed height => {
        ViewportModel.view-resized(root.width, root.height);
    }

    Image {
        visible: ViewportModel.has-frame && (ViewportModel.view-mode != 2 || ViewportModel.live-solid);
        x: ViewportModel.image-x;
        y: ViewportModel.image-y;
        width: ViewportModel.image-width;
        height: ViewportModel.image-height;
        source: ViewportModel.frame;
        image-fit: fill;
    }

    // The rendered picture of the Render mode (fills the viewport, below the gestures).
    // It stays in the tree (hidden) while the live Solid raster is on show, so the traced
    // frame is ready the moment the raster gives way to it.
    if ViewportModel.view-mode == 2: RenderPicture {
        visible: !ViewportModel.live-solid;
    }

    // The gesture layer: Slint turns two fingers into pinch events and releases the
    // first finger, so one handler plus one touch area see everything.
    ScaleRotateGestureHandler {
        started => {
            ViewportModel.pinch(0, 1.0, self.center.x, self.center.y);
        }

        updated => {
            ViewportModel.pinch(1, self.scale, self.center.x, self.center.y);
        }

        ended => {
            ViewportModel.pinch(2, 1.0, 0px, 0px);
        }

        cancelled => {
            ViewportModel.pinch(2, 1.0, 0px, 0px);
        }

        touch := TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.down = true;
                    ViewportModel.pointer(0, root.button-code(event.button), event.touch-finger-id, self.mouse-x, self.mouse-y);
                } else if (event.kind == PointerEventKind.up) {
                    root.down = false;
                    ViewportModel.pointer(1, root.button-code(event.button), event.touch-finger-id, self.mouse-x, self.mouse-y);
                } else if (event.kind == PointerEventKind.move) {
                    if (root.down) {
                        ViewportModel.pointer(2, 0, event.touch-finger-id, self.mouse-x, self.mouse-y);
                    }
                } else if (event.kind == PointerEventKind.cancel) {
                    root.down = false;
                    ViewportModel.pointer(3, 0, 0, 0px, 0px);
                }
            }

            scroll-event(event) => {
                ViewportModel.scrolled(event.delta-y, self.mouse-x, self.mouse-y);
                return accept;
            }
        }
    }

    // The handles of the selected facet (they draw only; the gesture layer grabs them).
    if ViewportModel.handles-visible: Rectangle {
        Stem {
            x0: ViewportModel.anchor-x;
            y0: ViewportModel.anchor-y;
            len: ViewportModel.angle-len;
            deg: ViewportModel.angle-deg;
        }

        Stem {
            x0: ViewportModel.anchor-x;
            y0: ViewportModel.anchor-y;
            len: ViewportModel.depth-len;
            deg: ViewportModel.depth-deg;
        }

        Stem {
            visible: ViewportModel.index-visible;
            x0: ViewportModel.anchor-x;
            y0: ViewportModel.anchor-y;
            len: ViewportModel.index-len;
            deg: ViewportModel.index-deg;
        }

        HandleDot {
            letter: "A";
            tint: #d9822b;
            cx: ViewportModel.angle-x;
            cy: ViewportModel.angle-y;
            active: ViewportModel.active-handle == 0;
        }

        HandleDot {
            letter: "D";
            tint: #2f9e63;
            cx: ViewportModel.depth-x;
            cy: ViewportModel.depth-y;
            active: ViewportModel.active-handle == 1;
        }

        HandleDot {
            visible: ViewportModel.index-visible;
            letter: "I";
            tint: #3a7bd5;
            cx: ViewportModel.index-x;
            cy: ViewportModel.index-y;
            active: ViewportModel.active-handle == 2;
        }
    }

    if ViewportModel.line-visible: Stem {
        x0: ViewportModel.line-x;
        y0: ViewportModel.line-y;
        len: ViewportModel.line-len;
        deg: ViewportModel.line-deg;
        tint: Theme.primary;
        thickness: 3px;
    }

    if ViewportModel.hint-text != "": Rectangle {
        x: root.pad-left;
        // Above the Render pill, which holds the foot of the view in that mode.
        y: root.height - self.height - root.pad-bottom - (ViewportModel.view-mode == 2 ? 3px + 56px + Theme.space-sm : 0px);
        width: root.width - root.pad-left - root.pad-right;
        height: hint.preferred-height + Theme.space-sm * 2;
        background: Theme.glass-bg;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.glass-edge;

        hint := Text {
            x: Theme.space-md;
            y: Theme.space-sm;
            width: parent.width - 2 * Theme.space-md;
            text: ViewportModel.hint-text;
            color: Theme.on-surface;
            font-size: max(12px, Theme.text-label);
            wrap: word-wrap;
        }
    }

    // The figures card: the gemological numbers (five, and Contrast) on glass, under the top row (Solid
    // and Render). Folded to one line on a phone; a tap on the card copies the numbers. Open, the
    // card is a 2 x 3 grid (full names, 12 sp) at the width of the folded card, not a tall column:
    // the sheet no longer cuts it and the Render pill clears it. The folded width is remembered
    // while the card is folded (a card that starts open has none yet and takes 330 px, or the
    // view's width).
    //
    // The header is 36 px tall and the card's own fold button is as big, so the chevron sits on
    // the row of the title. The 48 px touch rule is met by the transparent target after the card,
    // centred on that button; it is the only control in its corner, and the rest of the card
    // copies the numbers.
    if root.has-figures && ViewportModel.view-mode != 1 && !ViewportModel.slice-mode: Rectangle {
        figures-card := PleoFigures {
            x: root.pad-left;
            y: root.top-edge;
            figures: root.figures;
            title: "FACE-UP";
            show_bars: false;
            show_deltas: false;
            font-base: max(12px, Theme.base-font * 0.86);
            grid: true;
            grid-width: min(root.folded-figures-width > 0px ? root.folded-figures-width : 330px, root.width - root.pad-left - root.pad-right);
            fold-button-size: 36px;
            header-height: 36px;
            folded <=> ViewportModel.figures-folded;
            copy => { ViewportModel.figures-copy(); }
            changed width => {
                if (self.folded) {
                    root.folded-figures-width = self.width;
                }
            }
        }

        // The card pads its header by 4 px at the top and 10 px at the right, both scaled by its
        // font size over 11 px.
        TouchArea {
            width: Theme.touch;
            height: Theme.touch;
            x: figures-card.x + figures-card.width - 10px * figures-card.font-base / 11px - 18px - Theme.touch / 2;
            y: figures-card.y + 4px * figures-card.font-base / 11px + 18px - Theme.touch / 2;
            clicked => {
                ViewportModel.figures-folded = !ViewportModel.figures-folded;
            }
        }
    }

    if ViewportModel.info-visible: Rectangle {
        x: root.pad-left;
        y: root.below-rows + Theme.space-sm;
        width: min(root.width - root.pad-left - root.pad-right, 360px);
        height: max(info-text.preferred-height + Theme.space-md * 2, Theme.touch);
        background: Theme.surface-high;
        border-radius: Theme.radius-md;
        drop-shadow-color: Theme.shadow;
        drop-shadow-blur: Theme.shadow-blur-2;
        drop-shadow-offset-y: Theme.shadow-offset-2;

        TouchArea { }

        info-text := Text {
            x: Theme.space-md;
            y: Theme.space-md;
            width: parent.width - Theme.space-md - Theme.touch;
            text: ViewportModel.info-text;
            color: Theme.on-surface;
            font-size: Theme.text-body;
            wrap: word-wrap;
        }

        IconButton {
            x: parent.width - self.width;
            y: 0px;
            icon: Icons.close;
            label: "Close";
            clicked => {
                ViewportModel.info-closed();
            }
        }
    }

    // The top row: the mode segment and, on a wide view, the tool chips (else they are in
    // the View menu) on the left; the View button on the right.
    top-segment := GlassSegmented {
        x: root.pad-left;
        y: Theme.space-sm;
        width: min(252px, root.width - root.pad-left - root.pad-right - view-button.width - Theme.space-sm);
        options: ["Solid", "Diagram", "Render"];
        current: ViewportModel.view-mode;
        selected(index) => {
            ViewportModel.view-mode = index;
            root.camera-menu = false;
            ViewportModel.view-mode-chosen(index);
        }
    }

    // The Diagram's panels, one at a time on a phone (the tablet draws all three).
    if root.panel-row: GlassSegmented {
        x: root.pad-left;
        y: root.top-edge;
        width: min(300px, root.width - root.pad-left - root.pad-right);
        options: ["Crown", "Pavilion", "Profile"];
        current: ViewportModel.diagram-panel;
        selected(index) => {
            ViewportModel.diagram-panel = index;
            ViewportModel.diagram-panel-chosen(index);
        }
    }

    if root.tools-inline && root.tools-shown: GlassBar {
        x: top-segment.x + top-segment.width + Theme.space-sm;
        y: Theme.space-sm;

        Chip {
            text: "Handles";
            selected: ViewportModel.handles-on;
            clicked => {
                ViewportModel.handles-toggled();
            }
        }

        Chip {
            text: "Slice";
            clicked => {
                ViewportModel.slice-toggled();
            }
        }

        Chip {
            text: "Snap";
            selected: Prefs.snap-to-gear;
            clicked => {
                Prefs.set-snap-to-gear(!Prefs.snap-to-gear);
            }
        }
    }

    view-button := ViewButton {
        x: root.width - root.pad-right - self.width;
        y: Theme.space-sm;
        text: ViewportModel.view-mode == 1 ? "Reset" : "View";
        selected: root.camera-menu;
        clicked => {
            if (ViewportModel.view-mode != 1) {
                RenderModel.controls-open = false;
                root.camera-menu = !root.camera-menu;
            } else {
                ViewportModel.camera-chosen(6);
            }
        }
    }

    // The Slice row: the Slice tool's own chips, under the top row while it is on.
    if ViewportModel.slice-mode && ViewportModel.view-mode == 0: GlassBar {
        x: root.pad-left;
        y: root.top-edge;
        max-width: root.width - root.pad-left - root.pad-right;

        if !ViewportModel.slice-session: Chip {
            text: "Slice";
            selected: true;
            clicked => {
                ViewportModel.slice-toggled();
            }
        }

        if ViewportModel.slice-session: Chip {
            text: "Keep";
            selected: ViewportModel.slice-keep-ok;
            clicked => {
                ViewportModel.slice-keep();
            }
        }

        if ViewportModel.slice-session: Chip {
            text: "Flip";
            clicked => {
                ViewportModel.slice-flip();
            }
        }

        if ViewportModel.slice-session: Chip {
            text: "Discard";
            clicked => {
                ViewportModel.slice-discard();
            }
        }

        Chip {
            text: "Symmetric";
            selected: ViewportModel.slice-symmetric;
            clicked => {
                ViewportModel.symmetric-toggled();
            }
        }
    }

    // The View menu: a glass card under the button with the camera pills and, on a narrow
    // view, the tool chips. A tap outside closes it; Back closes it through `Navigation`.
    if root.camera-menu && ViewportModel.view-mode != 1: TouchArea {
        clicked => {
            root.camera-menu = false;
        }
    }

    if root.camera-menu && ViewportModel.view-mode != 1: Rectangle {
        width: min(root.width - root.pad-left - root.pad-right, 360px);
        x: root.width - root.pad-right - self.width;
        y: root.top-edge - Theme.space-xs;
        height: (root.menu-tools ? 3 : 2) * Theme.touch + 2 * Theme.space-sm;
        // Opaque: it opens over the figures card and the picture.
        background: Theme.surface-high;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.glass-edge;
        drop-shadow-color: Theme.shadow;
        drop-shadow-blur: Theme.shadow-blur-2;
        drop-shadow-offset-y: Theme.shadow-offset-2;

        TouchArea { }

        VerticalLayout {
            padding: Theme.space-sm;

            HorizontalLayout {
                spacing: Theme.space-xs;
                alignment: start;

                Chip {
                    text: "Front";
                    clicked => {
                        root.camera-menu = false;
                        ViewportModel.camera-chosen(0);
                    }
                }

                Chip {
                    text: "Top";
                    clicked => {
                        root.camera-menu = false;
                        ViewportModel.camera-chosen(1);
                    }
                }

                Chip {
                    text: "Bottom";
                    clicked => {
                        root.camera-menu = false;
                        ViewportModel.camera-chosen(2);
                    }
                }

                Chip {
                    text: "Left";
                    clicked => {
                        root.camera-menu = false;
                        ViewportModel.camera-chosen(3);
                    }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-xs;
                alignment: start;

                Chip {
                    text: "Right";
                    clicked => {
                        root.camera-menu = false;
                        ViewportModel.camera-chosen(4);
                    }
                }

                Chip {
                    text: "Fit";
                    clicked => {
                        root.camera-menu = false;
                        ViewportModel.camera-chosen(5);
                    }
                }

                Chip {
                    text: "Reset";
                    clicked => {
                        root.camera-menu = false;
                        ViewportModel.camera-chosen(6);
                    }
                }
            }

            if root.menu-tools: HorizontalLayout {
                spacing: Theme.space-xs;
                alignment: start;

                Chip {
                    text: "Handles";
                    selected: ViewportModel.handles-on;
                    clicked => {
                        root.camera-menu = false;
                        ViewportModel.handles-toggled();
                    }
                }

                Chip {
                    text: "Slice";
                    clicked => {
                        root.camera-menu = false;
                        ViewportModel.slice-toggled();
                    }
                }

                Chip {
                    text: "Snap";
                    selected: Prefs.snap-to-gear;
                    clicked => {
                        root.camera-menu = false;
                        Prefs.set-snap-to-gear(!Prefs.snap-to-gear);
                    }
                }
            }
        }
    }

    // The Render overlay: the status pill, the progress line and the settings tray. Settings
    // first collapses the page sheet to its peek so the preview grows, then opens its tray.
    if ViewportModel.view-mode == 2: RenderControls {
        y: root.height - self.height;
        width: root.width;
        height-budget: max(0px, root.height - root.top-edge);
        pad-left: root.pad-left;
        pad-right: root.pad-right;
        pad-bottom: root.pad-bottom;
        settings-toggled => {
            root.camera-menu = false;
            if !RenderModel.controls-open { Shell.sheet-detent = 0; }
            RenderModel.controls-open = !RenderModel.controls-open;
        }
    }

    if ViewportModel.busy && ViewportModel.view-mode != 2: Rectangle {
        y: 0px;
        width: root.width;
        height: 4px;

        ProgressBar {
            indeterminate: true;
        }
    }
}
