import { Shell } from "../models.slint";
import { Theme } from "../theme.slint";
import { TopBar } from "../shell/top_bar.slint";
import { PageScroll } from "../shell/page_scroll.slint";
import { PrimaryButton, TextButton } from "../shell/buttons.slint";
import { ListRow } from "../shell/list_row.slint";
import { TextField, ChoiceField, Stepper, ToggleRow, ProgressBar } from "../shell/inputs.slint";
import { FieldLabel, PageColumn, GroupHeader } from "../pages/fields.slint";
import { Card } from "props/props_parts.slint";

export global RetargetModel {
    in-out property <bool> open: false;
    in property <bool> release-ready: false;
    in property <[string]> materials;
    in-out property <int> material: 0;
    in-out property <string> ri;
    in-out property <int> crown: 0;
    in-out property <string> crown-fraction: "0.5";
    in-out property <bool> girdle: true;
    in-out property <bool> search: false;
    in property <[string]> presets;
    in-out property <int> preset: 0;
    in-out property <int> range: 1;
    in-out property <int> effort: 1;
    in-out property <bool> keep-look: true;
    in-out property <int> candidates: 3;
    in-out property <string> seed: "0";
    in property <bool> running: false;
    in property <string> status;
    in property <[string]> results;
    in property <string> comparison;
    in property <bool> can-apply: false;
    in-out property <string> variant-name: "Retarget candidate";
    callback show(); callback close(); callback start(); callback cancel();
    callback select(int); callback apply(); callback save-variant();
}

// The page's side margin for the texts and buttons that sit between the cards.
component Pad inherits VerticalLayout {
    padding-left: Theme.space-lg;
    padding-right: Theme.space-lg;
    padding-top: Theme.space-xs;
    padding-bottom: Theme.space-xs;
    spacing: Theme.space-sm;
}

export component RetargetScreen inherits Rectangle {
    background: Theme.surface;
    TouchArea { }
    VerticalLayout {
        TopBar { title: "Retarget For Material"; show-back: true; back-clicked => { Shell.request-back(); } }
        PageScroll {
            vertical-stretch: 1;
            PageColumn { VerticalLayout {
                padding-bottom: Theme.space-lg;
                Pad {
                    FieldLabel { text: "Retarget changes cutting geometry for a target material. Checking and preview leave the current design untouched."; }
                    if !RetargetModel.release-ready: FieldLabel { text: "Release use awaits shared Retarget preservation regression validation."; }
                }
                GroupHeader { text: "TARGET"; }
                Card {
                    VerticalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            FieldLabel { text: "Target Material"; }
                            ChoiceField { label: "Target Material"; model: RetargetModel.materials; current-index <=> RetargetModel.material; }
                        }
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            FieldLabel { text: "RI Override (Optional For a Named Material)"; }
                            TextField { label: "RI Override (Optional For a Named Material)"; input-type: InputType.decimal; text <=> RetargetModel.ri; }
                        }
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            FieldLabel { text: "Crown Handling"; }
                            ChoiceField {
                                label: "Crown Handling";
                                model: ["Crown follows pavilion stretch", "Keep crown angles", "Scale crown by critical angle ratio", "Fraction of critical angle shift"];
                                current-index <=> RetargetModel.crown;
                            }
                        }
                        if RetargetModel.crown == 3: VerticalLayout {
                            spacing: Theme.space-xs;
                            FieldLabel { text: "Critical Angle Fraction"; }
                            TextField { label: "Critical Angle Fraction"; input-type: InputType.decimal; text <=> RetargetModel.crown-fraction; }
                        }
                        ToggleRow { text: "Allow Supported Girdle Thickening (Up To 10%)"; checked <=> RetargetModel.girdle; }
                    }
                }
                Pad {
                    PrimaryButton {
                        text: "Check Shift"; enabled: RetargetModel.release-ready && !RetargetModel.running;
                        clicked => { RetargetModel.search = false; RetargetModel.start(); }
                    }
                }
                GroupHeader { text: "SEARCH ALTERNATIVES"; accessible-label: "Search Alternatives"; }
                Card {
                    VerticalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            FieldLabel { text: "Preset"; }
                            ChoiceField { label: "Preset"; model: RetargetModel.presets; current-index <=> RetargetModel.preset; }
                        }
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            FieldLabel { text: "Angle Range"; }
                            ChoiceField { label: "Angle Range"; model: ["±3°", "±6°", "±10°", "±15°"]; current-index <=> RetargetModel.range; }
                        }
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            FieldLabel { text: "Effort"; }
                            ChoiceField { label: "Effort"; model: ["Quick · 100", "Normal · 300", "Thorough · 800"]; current-index <=> RetargetModel.effort; }
                        }
                        ToggleRow { text: "Keep the Design's Look"; checked <=> RetargetModel.keep-look; }
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            FieldLabel { text: "Candidates"; }
                            HorizontalLayout {
                                alignment: start;
                                Stepper { label: "Candidates"; minimum: 1; maximum: 5; value <=> RetargetModel.candidates; }
                            }
                        }
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            FieldLabel { text: "Seed"; }
                            TextField { label: "Seed"; input-type: InputType.number; text <=> RetargetModel.seed; }
                        }
                    }
                }
                Pad {
                    PrimaryButton {
                        text: "Search Checked Alternatives"; enabled: RetargetModel.release-ready && !RetargetModel.running;
                        clicked => { RetargetModel.search = true; RetargetModel.start(); }
                    }
                    if RetargetModel.running: ProgressBar { indeterminate: true; }
                    if RetargetModel.running: TextButton { text: "Cancel Operation"; clicked => { RetargetModel.cancel(); } }
                    Text { text: RetargetModel.status; color: Theme.on-surface; wrap: word-wrap; }
                }
                GroupHeader { text: "RESULT"; }
                for candidate[index] in RetargetModel.results: ListRow { title: candidate; clicked => { RetargetModel.select(index); } }
                Pad {
                    Text { text: RetargetModel.comparison; color: Theme.on-surface; wrap: word-wrap; }
                    PrimaryButton { text: "Apply Geometry and Target Material"; enabled: RetargetModel.can-apply; clicked => { RetargetModel.apply(); } }
                }
                Card {
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        FieldLabel { text: "Variant Name"; }
                        TextField { label: "Variant Name"; text <=> RetargetModel.variant-name; }
                    }
                }
                Pad { TextButton { text: "Save Candidate As Variant"; enabled: RetargetModel.can-apply; clicked => { RetargetModel.save-variant(); } } }
            } }
        }
    }
}
