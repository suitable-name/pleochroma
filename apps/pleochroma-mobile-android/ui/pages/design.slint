// Design destination: the viewport with the tier, stone, light and check tabs around it.
//
//   compact (phone)   the viewport on top (what the sheet leaves at the half detent, which
//                     covers about 55 % of the page; the page minus the peek bar at peek,
//                     a 120 px strip at full), a bottom sheet
//                     below with the tab switcher right under the header row; the header
//                     row is the drag handle, the solve status chip, the verdict and Solve
//   medium/expanded   the viewport on the left, a collapsible side pane on the right with
//                     the same status row, switcher and tab
//
// Without a design the page offers to start one. The tab components, their globals and
// `DocumentModel` live under `ui/design/**`; this page only
// places them.
import { ProgressBar } from "../shell/inputs.slint";
import { Theme } from "../theme.slint";
import { Navigation } from "../navigation.slint";
import { Icons } from "../icons.slint";
import { Shell } from "../models.slint";
import { EmptyState } from "../shell/empty_state.slint";
import { TopBar } from "../shell/top_bar.slint";
import { Sheet } from "../shell/sheet.slint";
import { SidePane } from "../shell/side_pane.slint";
import { Icon } from "../shell/icon.slint";
import { StateLayer } from "../shell/state_layer.slint";
import { ListRow } from "../shell/list_row.slint";
import { PageScroll } from "../shell/page_scroll.slint";
import { DocumentModel } from "../design/document_model.slint";
import { RenderModel } from "../design/render/render_model.slint";
import { ExportSheet } from "../design/render/export_sheet.slint";
import { TiersModel } from "../design/tiers/tiers_model.slint";
import { PropsModel } from "../design/props/props_model.slint";
import { ViewportIcons } from "../design/viewport/viewport_icons.slint";
import { DesignViewport } from "../design/viewport/design_viewport.slint";
import { ViewportModel } from "../design/viewport/viewport_model.slint";
import { TiersTab } from "../design/tiers/tiers_tab.slint";
import { StoneTab } from "../design/props/stone_tab.slint";
import { LightTab } from "../design/props/light_tab.slint";
import { ChecksTab } from "../design/props/checks_tab.slint";
import { HistoryModel, HistoryScreen } from "../design/history.slint";
import { ConcaveModel, ConcaveScreen } from "../design/concave.slint";
import { DeepSolveModel, DeepSolveScreen } from "../design/deep_solve.slint";
import { VariantsModel, VariantsScreen } from "../design/variants.slint";
import { OptimizeModel, OptimizeScreen } from "../design/optimization.slint";
import { RetargetModel, RetargetScreen } from "../design/retarget.slint";

// The Solve button: its body solves, and its label is the state of the design. Not solved and
// Stale are the call to action (filled cyan); Solved is quiet, a problem is red. A 48 px
// touch target around a 40 px pill; a thin progress bar runs along the pill while a solve
// runs.
component SolveButton inherits Rectangle {
    // 0 nothing yet, 1 solving, 2 solved, 3 problem or failed, 4 stale.
    property <int> kind: TiersModel.solving ? 1 : TiersModel.status-kind;
    property <string> state-label: root.kind == 1 ? "Solving\u{2026}" : (root.kind == 2 ? "Solved" : (root.kind == 3 ? "Problem" : (root.kind == 4 ? "Stale" : "Not solved")));
    property <bool> call-to-action: root.kind == 0 || root.kind == 4;

    width: max(128px, label.preferred-width + 2 * Theme.space-lg + (root.kind == 2 ? 26px : 0px));
    height: Theme.touch;
    accessible-role: AccessibleRole.button;
    accessible-label: TiersModel.solving ? "Solving" : "Solve";
    accessible-description: root.state-label;
    accessible-enabled: !TiersModel.solving;
    accessible-action-default => {
        if (!TiersModel.solving) {
            TiersModel.solve();
        }
    }

    pill := Rectangle {
        y: (parent.height - self.height) / 2;
        height: 40px;
        border-radius: 20px;
        clip: true;
        background: root.call-to-action ? Theme.accent : (root.kind == 1 ? Theme.accent-surface : (root.kind == 3 ? Theme.error-container : Theme.surface));
        border-width: root.call-to-action ? 0px : 1px;
        border-color: root.kind == 1 ? Theme.accent : (root.kind == 3 ? Theme.error : Theme.outline-variant);

        StateLayer {
            pressed: touch.pressed;
            hovered: touch.has-hover;
            enabled: !TiersModel.solving;
            border-radius: parent.border-radius;
        }

        HorizontalLayout {
            alignment: center;
            spacing: Theme.space-sm;

            if root.kind == 2: Rectangle {
                width: 18px;

                Icon {
                    source: Icons.check;
                    tint: Theme.success;
                    glyph: 18px;
                }
            }

            label := Text {
                text: root.state-label;
                color: root.call-to-action ? Theme.on-primary : (root.kind == 1 ? Theme.accent : (root.kind == 3 ? Theme.on-error-container : Theme.on-surface));
                font-size: Theme.text-label-large;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        if root.kind == 1: Rectangle {
            y: parent.height - 4px;
            height: 4px;

            ProgressBar {
                indeterminate: true;
            }
        }
    }

    touch := TouchArea {
        enabled: !TiersModel.solving;
        clicked => {
            TiersModel.solve();
        }
    }
}

// The separate check chip beside Solve: the verdict as a small colored pill ("1 check",
// "No checks" when a solved design needs no look, "Not checked" before a solve). A tap opens
// the Checks tab.
component CheckChip inherits Rectangle {
    callback clicked();

    property <int> count: PropsModel.warnings.length;
    property <string> text: root.count > 0 ? root.count + (root.count == 1 ? " check" : " checks") : PropsModel.checks-ready ? "No checks" : "Not checked";
    property <color> tint: Theme.verdict-mark(PropsModel.verdict-level);

    width: min(max(Theme.touch, label.preferred-width + 2 * Theme.space-md + 22px), 168px);
    height: Theme.touch;
    accessible-role: AccessibleRole.button;
    accessible-label: root.text + ", opens the Checks tab";
    accessible-description: "Verdict: " + PropsModel.verdict-text;
    accessible-action-default => { root.clicked(); }

    pill := Rectangle {
        y: (parent.height - self.height) / 2;
        height: 40px;
        border-radius: 20px;
        background: Theme.verdict-container(PropsModel.verdict-level);
        border-width: 1px;
        border-color: root.tint;

        StateLayer {
            pressed: touch.pressed;
            hovered: touch.has-hover;
            border-radius: parent.border-radius;
        }

        label := Text {
            x: Theme.space-md;
            width: parent.width - 2 * Theme.space-md - 22px;
            height: parent.height;
            text: root.text;
            color: Theme.verdict-content(PropsModel.verdict-level);
            font-size: Theme.text-label-large;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }

        Icon {
            x: parent.width - self.width - Theme.space-md;
            y: (parent.height - self.height) / 2;
            source: Icons.chevron-right;
            tint: Theme.verdict-content(PropsModel.verdict-level);
            glyph: 18px;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// The solve row: the Solve button and the check chip.
component SolveRow inherits Rectangle {
    callback checks-clicked();
    height: Theme.touch;

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        spacing: Theme.space-sm;
        alignment: start;

        SolveButton { }

        if PropsModel.verdict-text != "": CheckChip {
            clicked => { root.checks-clicked(); }
        }
    }
}

// The solve status line ("Closed solid -- volume 0.1234 ... (solved in 0.05 s)"): two lines
// at most; a tap shows all of it.
component StatusLine inherits Rectangle {
    height: Theme.touch;
    accessible-role: AccessibleRole.button;
    accessible-label: "Solve status: " + TiersModel.status-text;
    accessible-action-default => {
        Shell.show-info("Solve Status", TiersModel.status-text);
    }

    Text {
        x: Theme.space-md;
        width: parent.width - 2 * Theme.space-md;
        height: parent.height;
        text: TiersModel.status-text;
        color: TiersModel.status-problem ? Theme.error : Theme.text-secondary;
        font-size: max(12px, Theme.text-label);
        vertical-alignment: center;
        wrap: word-wrap;
        overflow: elide;
    }

    TouchArea {
        enabled: TiersModel.status-text != "";
        clicked => {
            Shell.show-info("Solve Status", TiersModel.status-text);
        }
    }
}

// The four tab components, all kept alive so scroll positions and edits survive a switch.
component TabHost inherits Rectangle {
    in property <int> tab: 0;

    Rectangle {
        visible: root.tab == 0;
        TiersTab { }
    }

    Rectangle {
        visible: root.tab == 1;
        StoneTab { }
    }

    Rectangle {
        visible: root.tab == 2;
        LightTab { }
    }

    Rectangle {
        visible: root.tab == 3;
        ChecksTab { }
    }
}

// The Tiers / Stone / Light / Checks buttons: four equal, separate 48 px buttons that always
// fill the width they are given; the chosen one is a cyan-surface pill.
component TabSwitcher inherits Rectangle {
    in property <int> current: 0;
    callback selected(int);

    property <[string]> options: ["Tiers", "Stone", "Light", "Checks"];

    height: Theme.touch;

    HorizontalLayout {
        spacing: Theme.space-xs;

        for option[index] in root.options: Rectangle {
            border-radius: Theme.radius-md;
            background: index == root.current ? Theme.accent-surface : Theme.surface;
            border-width: index == root.current ? 1px : 0px;
            border-color: Theme.accent;
            accessible-role: AccessibleRole.button;
            accessible-label: option;
            accessible-checkable: true;
            accessible-checked: index == root.current;
            accessible-action-default => { root.selected(index); }

            StateLayer {
                pressed: segment-touch.pressed;
                hovered: segment-touch.has-hover;
                border-radius: parent.border-radius;
            }

            Text {
                text: option;
                color: index == root.current ? Theme.accent : Theme.on-surface;
                font-size: Theme.text-label-large;
                font-weight: 500;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }

            segment-touch := TouchArea {
                clicked => {
                    root.selected(index);
                }
            }
        }
    }
}

// The compact layout: the viewport above, the sheet over the lower part of the page. The
// sheet's peek (about 130 px) holds the solve row and the four tab buttons; the half and
// full detents add the status line and the tab's content below them.
component CompactBody inherits Rectangle {
    in-out property <int> tab: 0;
    // The height of the whole Design page (this body and the top bar above it).
    in property <length> page-height: 0px;

    // The peek: the drag handle, the solve row, the tab buttons and a little air.
    property <length> peek: Theme.touch * 2 + 34px;
    // The half detent: the sheet covers about 55 % of the page, so a tier list shows as
    // many rows as the page allows, while the viewport keeps about 40 % of this body (at
    // least 35 % of the page). The two limits meet at 55 % on a typical phone.
    property <length> sheet-half: min(max(root.page-height * 0.55, root.peek + 96px), max(root.height - root.page-height * 0.35, root.peek + 96px));
    // The same as the share of this body the Sheet takes.
    property <float> sheet-share: root.height > 0px ? root.sheet-half / root.height : 0.55;

    // The viewport takes what the sheet leaves at the half detent, everything above the
    // peek bar while the sheet is folded down, and a 120 px strip while the sheet is full.
    property <length> viewport-height: Shell.sheet-detent == 0 ? root.height - root.peek - Shell.page-inset-bottom : (Shell.sheet-detent == 1 ? root.height - root.sheet-half : 120px);

    // The sheet's height is remembered per view mode for the session only (Solid half,
    // Diagram and Render peek to begin with). Full is never remembered, so it is never
    // restored: overlays that raise the sheet give it back and are not stored.
    property <int> mode: ViewportModel.view-mode;
    property <int> detent <=> Shell.sheet-detent;

    function remember(mode: int, detent: int) {
        if (mode == 0) {
            ViewportModel.sheet-memory-solid = detent;
        } else if (mode == 1) {
            ViewportModel.sheet-memory-diagram = detent;
        } else {
            ViewportModel.sheet-memory-render = detent;
        }
    }

    function recall(mode: int) -> int {
        return mode == 0 ? ViewportModel.sheet-memory-solid : (mode == 1 ? ViewportModel.sheet-memory-diagram : ViewportModel.sheet-memory-render);
    }

    init => {
        if (Shell.sheet-detent != 2) {
            Shell.sheet-detent = root.recall(root.mode);
        }
    }

    changed detent => {
        if (root.detent != 2) {
            root.remember(root.mode, root.detent);
        }
    }

    changed mode => {
        if (Shell.sheet-detent != 2) {
            Shell.sheet-detent = root.recall(root.mode);
        }
    }

    function open-tab(index: int) {
        PropsModel.close-number();
        root.tab = index;
        if (Shell.sheet-detent == 0) {
            Shell.sheet-detent = 1;
        }
    }

    DesignViewport {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.viewport-height;
    }

    sheet := Sheet {
        title: "";
        peek: root.peek;
        half-fraction: root.sheet-share;
        bottom-inset: Shell.page-inset-bottom;
        detent <=> Shell.sheet-detent;

        VerticalLayout {
            spacing: Theme.space-xs;

            StatusLine { }

            VerticalLayout {
                padding-left: Theme.space-md;
                padding-right: Theme.space-md;
                vertical-stretch: 1;

                TabHost {
                    tab: root.tab;
                    vertical-stretch: 1;
                }
            }
        }
    }

    // The peek rides on the sheet's top edge, so it follows the sheet up and down; it is
    // drawn after the sheet, so its buttons take the touches and the gaps fall through to
    // the sheet's drag strip.
    VerticalLayout {
        x: 0px;
        y: root.height - sheet.content-height - root.peek - Shell.page-inset-bottom + 14px;
        width: root.width;
        height: Theme.touch * 2 + Theme.space-xs;
        spacing: Theme.space-xs;

        SolveRow {
            checks-clicked => { root.open-tab(3); }
        }

        HorizontalLayout {
            padding-left: Theme.space-md;
            padding-right: Theme.space-md;

            TabSwitcher {
                current: root.tab;
                selected(index) => { root.open-tab(index); }
            }
        }
    }
}

// The medium and expanded layout: the viewport left, the side pane right.
component WideBody inherits Rectangle {
    in-out property <int> tab: 0;
    in-out property <bool> collapsed: false;

    HorizontalLayout {
        DesignViewport {
            horizontal-stretch: 1;
        }

        SidePane {
            title: "Design";
            collapsed <=> root.collapsed;

            VerticalLayout {
                spacing: Theme.space-xs;

                SolveRow {
                    checks-clicked => {
                        PropsModel.close-number();
                        root.tab = 3;
                    }
                }

                StatusLine { }

                // Inset like the solve row above, so the buttons sit inside the pane.
                HorizontalLayout {
                    padding-left: Theme.space-md;
                    padding-right: Theme.space-md;

                    TabSwitcher {
                        current: root.tab;
                        selected(index) => {
                            PropsModel.close-number();
                            root.tab = index;
                        }
                    }
                }

                TabHost {
                    tab: root.tab;
                    vertical-stretch: 1;
                }
            }
        }
    }
}

export component DesignPage inherits Rectangle {
    property <bool> menu-open <=> Navigation.design-menu-open;
    // The selected tab lives in `PropsModel` so the preview's `--tab` flag can set it.
    property <int> tab <=> PropsModel.design-tab;
    property <bool> pane-collapsed: false;

    VerticalLayout {
        if DocumentModel.has-design: TopBar {
            title: DocumentModel.dirty ? DocumentModel.title + " \u{2022}" : DocumentModel.title;
            show-overflow: true;
            actions: [
                { icon: ViewportIcons.undo, label: "Undo", enabled: TiersModel.can-undo },
                { icon: ViewportIcons.redo, label: "Redo", enabled: TiersModel.can-redo }
            ];
            action-clicked(index) => {
                if (index == 0) {
                    TiersModel.undo();
                } else {
                    TiersModel.redo();
                }
            }
            overflow-clicked => {
                root.menu-open = true;
            }
        }

        if !DocumentModel.has-design: TopBar {
            title: "Design";
        }

        if !DocumentModel.has-design: EmptyState {
            vertical-stretch: 1;
            icon: Icons.design;
            title: "Start a Design";
            body: "Create a new faceting design, or open one from a file.";
            primary-text: "New Design";
            primary-icon: Icons.add;
            secondary-text: "Open";
            secondary-icon: Icons.open;
            primary-clicked => {
                DocumentModel.new-design();
            }
            secondary-clicked => {
                DocumentModel.open();
            }
        }

        if DocumentModel.has-design && Shell.window-class == 0: CompactBody {
            vertical-stretch: 1;
            tab <=> root.tab;
            page-height: root.height;
        }

        if DocumentModel.has-design && Shell.window-class != 0: WideBody {
            vertical-stretch: 1;
            tab <=> root.tab;
            collapsed <=> root.pane-collapsed;
        }
    }

    // The overflow menu: a scrim and a card under the top bar.
    if root.menu-open && DocumentModel.has-design: Rectangle {
        TouchArea {
            clicked => {
                root.menu-open = false;
            }
        }

        Rectangle {
            x: parent.width - self.width - Theme.space-sm;
            y: Theme.top-bar-height - Theme.space-sm;
            width: min(parent.width - 2 * Theme.space-sm, 280px);
            height: min(menu-rows.preferred-height, max(0px, parent.height - self.y - Theme.space-sm));
            background: Theme.surface-high;
            border-radius: Theme.radius-md;
            clip: true;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.shadow-blur-3;
            drop-shadow-offset-y: Theme.shadow-offset-3;

            TouchArea { }

            PageScroll {
              menu-rows := VerticalLayout {
                ListRow {
                    title: "Session History";
                    clicked => {
                        root.menu-open = false;
                        HistoryModel.show();
                    }
                }
                ListRow {
                    title: "Saved Variants";
                    clicked => {
                        root.menu-open = false;
                        VariantsModel.show();
                    }
                }
                ListRow {
                    title: "Optimize";
                    clicked => { root.menu-open = false; OptimizeModel.show(); }
                }
                ListRow {
                    title: "Retarget For Material";
                    clicked => { root.menu-open = false; RetargetModel.show(); }
                }
                ListRow {
                    title: "Deep Solve";
                    clicked => {
                        root.menu-open = false;
                        DeepSolveModel.show();
                    }
                }
                ListRow {
                    title: "Save";
                    clicked => {
                        root.menu-open = false;
                        DocumentModel.save();
                    }
                }

                ListRow {
                    title: "Save As";
                    clicked => {
                        root.menu-open = false;
                        DocumentModel.save-as();
                    }
                }

                ListRow {
                    title: "Share";
                    clicked => {
                        root.menu-open = false;
                        DocumentModel.share();
                    }
                }

                ListRow {
                    title: "New Design";
                    clicked => {
                        root.menu-open = false;
                        DocumentModel.new-design();
                    }
                }

                ListRow {
                    title: "Open";
                    clicked => {
                        root.menu-open = false;
                        DocumentModel.open();
                    }
                }

                ListRow {
                    title: "Close Design";
                    clicked => {
                        root.menu-open = false;
                        DocumentModel.close-design();
                    }
                }
              }
            }
        }
    }

    // The export sheet of the Render view covers the whole page, the menu included.
    if RenderModel.export-open && DocumentModel.has-design: ExportSheet { }
    if HistoryModel.open && DocumentModel.has-design: HistoryScreen { }
    if ConcaveModel.open && DocumentModel.has-design: ConcaveScreen { }
    if DeepSolveModel.open && DocumentModel.has-design: DeepSolveScreen { }
    if OptimizeModel.open && DocumentModel.has-design: OptimizeScreen { }
    if RetargetModel.open && DocumentModel.has-design: RetargetScreen { }
    if VariantsModel.open && DocumentModel.has-design: VariantsScreen { }
}
