// Design tokens for the mobile app: the desktop's dark palette (`crates/pleochroma-ui-kit/ui/shared/palette.slint`, also
// read by the desktop `Theme`) under the Material role names, plus the kit tokens, state-layer
// opacities, the type scale, spacing, corner radii and elevation.
//
// The app is dark in both themes. The theme preference (`Shell.theme-choice`, pushed from the
// settings) is 0 Dark or 1 High Contrast; High Contrast sets `PleoPalette.high-contrast`, which
// switches every color token below to the desktop's high-contrast value.
//
// Contrast: `on-surface-variant` maps to the desktop's `text-secondary`, not `text-muted`
// (3.4:1 on a card): body text keeps 4.5:1 or more on every surface. `text-muted` and
// `outline` are for hints and borders only.
import { PleoPalette } from "@pleochroma-kit/shared/palette.slint";
import { Shell } from "models.slint";

export global Theme {
    /// Whether the high-contrast palette is on: the theme preference's second choice.
    out property <bool> high-contrast: PleoPalette.high-contrast;

    // Shell.theme-choice -> palette. A `changed` handler does not run at start-up, but Rust
    // pushes the stored choice after the window exists, and a High Contrast choice differs
    // from the default 0.
    property <bool> high-contrast-choice: Shell.theme-choice == 1;
    changed high-contrast-choice => {
        PleoPalette.high-contrast = root.high-contrast-choice;
    }

    // Surfaces, from the page background up to the highest container.
    out property <color> surface: PleoPalette.bg-darkest;
    out property <color> surface-low: PleoPalette.bg-dark;
    out property <color> surface-container: PleoPalette.bg-card;
    out property <color> surface-high: PleoPalette.bg-card-hover;
    out property <color> surface-highest: PleoPalette.bg-elevated;
    out property <color> on-surface: PleoPalette.text-primary;
    out property <color> on-surface-variant: PleoPalette.text-secondary;

    // Kit tokens: the desktop's own names.
    /// The translucent glass panel over a picture, and its hairline edge.
    out property <color> glass-bg: PleoPalette.glass-bg;
    out property <color> glass-edge: PleoPalette.glass-edge;
    /// The cyan accent, and the dark fill under accent content.
    out property <color> accent: PleoPalette.accent-cyan;
    out property <color> accent-surface: PleoPalette.accent-cyan-surface;
    /// Secondary text (6.3:1 on a card) and hint text (3.4:1: not for facts the cutter reads).
    out property <color> text-secondary: PleoPalette.text-secondary;
    out property <color> text-muted: PleoPalette.text-muted;

    // Accent roles. Primary is the desktop's cyan; its containers use the cyan surface.
    out property <color> primary: PleoPalette.accent-cyan;
    out property <color> on-primary: PleoPalette.text-on-accent;
    out property <color> primary-container: PleoPalette.accent-cyan-surface;
    out property <color> on-primary-container: PleoPalette.accent-cyan-hover;
    out property <color> secondary-container: PleoPalette.accent-cyan-surface;
    out property <color> on-secondary-container: PleoPalette.accent-cyan-hover;

    // Lines and feedback.
    out property <color> outline: PleoPalette.text-muted;
    out property <color> outline-variant: PleoPalette.border-medium;
    out property <color> error: PleoPalette.danger;
    out property <color> on-error: PleoPalette.text-on-accent;
    out property <color> error-container: PleoPalette.danger-surface-hover;
    out property <color> on-error-container: PleoPalette.danger;
    out property <color> scrim: #000000;

    // Verdict roles: good (success) and check (warning); problems use the error roles.
    out property <color> success: PleoPalette.success;
    out property <color> on-success: PleoPalette.text-on-accent;
    out property <color> success-container: PleoPalette.badge-emerald-bg;
    out property <color> on-success-container: PleoPalette.text-primary;
    out property <color> warning: PleoPalette.accent-amber;
    out property <color> on-warning: PleoPalette.text-on-accent;
    out property <color> warning-container: PleoPalette.surface-warning;
    out property <color> on-warning-container: PleoPalette.badge-amber-text;

    // Snackbar colors (inverted against the page).
    out property <color> inverse-surface: PleoPalette.text-primary;
    out property <color> on-inverse-surface: PleoPalette.text-on-accent;

    // Verdict levels 0 (good), 1 (check) and 2 (problem); -1 is not judged. The container and
    // content roles fall back to the error roles for any other level, so callers guard -1.
    pure public function verdict-container(level: int) -> color {
        return level == 0 ? success-container : (level == 1 ? warning-container : error-container);
    }

    pure public function verdict-content(level: int) -> color {
        return level == 0 ? on-success-container : (level == 1 ? on-warning-container : on-error-container);
    }

    // The mark color of a level; transparent for any level outside 0 to 2.
    pure public function verdict-mark(level: int) -> color {
        return level == 0 ? success : (level == 1 ? warning : (level == 2 ? error : transparent));
    }

    // State-layer opacities (the overlay a pressed or hovered control gets).
    out property <float> state-hover: 0.08;
    out property <float> state-focus: 0.12;
    out property <float> state-pressed: 0.12;
    out property <float> disabled-content: 0.38;

    // Type scale. A global has no window to take `rem` from, so `AppWindow` copies its
    // `default-font-size` into `base-font` (Android scales that with the system font size)
    // and every size below is a multiple of it.
    in-out property <length> base-font: 14px;
    out property <length> text-display: base-font * 2.57;
    out property <length> text-headline: base-font * 2;
    out property <length> text-headline-small: base-font * 1.71;
    out property <length> text-title-large: base-font * 1.57;
    out property <length> text-title: base-font * 1.14;
    out property <length> text-body-large: base-font * 1.14;
    out property <length> text-body: base-font;
    out property <length> text-label-large: base-font;
    out property <length> text-label: base-font * 0.86;

    // Spacing.
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 24px;

    // Corner radii.
    out property <length> radius-xs: 4px;
    out property <length> radius-sm: 8px;
    out property <length> radius-md: 12px;
    out property <length> radius-lg: 16px;
    out property <length> radius-xl: 28px;

    // Touch metrics.
    out property <length> touch: 48px;
    out property <length> row-height: 56px;
    out property <length> nav-size: 80px;
    out property <length> top-bar-height: 64px;
    out property <length> sheet-peek: 56px;

    // Elevation: shadow color and the blur/offset of levels 1 to 3.
    out property <color> shadow: PleoPalette.modal-shadow;
    out property <length> shadow-blur-1: 3px;
    out property <length> shadow-blur-2: 8px;
    out property <length> shadow-blur-3: 16px;
    out property <length> shadow-offset-1: 1px;
    out property <length> shadow-offset-2: 3px;
    out property <length> shadow-offset-3: 6px;

    // Motion.
    out property <duration> motion-short: 120ms;
    out property <duration> motion-medium: 220ms;
}
