// The one modal dialog (`Shell.show-dialog`). A scrim covers the window; tapping it or
// pressing Back cancels. Fill the parent: place it last in the window so it is on top.
import { Theme } from "../theme.slint";
import { Shell } from "../models.slint";
import { PrimaryButton, TextButton } from "buttons.slint";

export component DialogHost inherits Rectangle {
    visible: Shell.dialog-visible;

    Rectangle {
        background: Theme.scrim.with-alpha(0.32);

        TouchArea {
            clicked => {
                Shell.close-dialog(false);
            }
        }
    }

    card := Rectangle {
        width: min(root.width - 48px, 360px);
        height: content.preferred-height;
        background: Theme.surface-container;
        border-radius: Theme.radius-xl;
        border-width: 1px;
        border-color: Theme.glass-edge;
        drop-shadow-color: Theme.shadow;
        drop-shadow-blur: Theme.shadow-blur-3;
        drop-shadow-offset-y: Theme.shadow-offset-3;
        accessible-role: AccessibleRole.groupbox;
        accessible-label: Shell.dialog-title;

        // Swallows taps on the card so they do not count as taps on the scrim.
        TouchArea { }

        // The two buttons side by side, never shown: their width decides whether they fit in
        // one row or stack (Material's stacked actions), so a long label is never cut off.
        measure := HorizontalLayout {
            x: 0;
            y: 0;
            visible: false;
            spacing: Theme.space-sm;

            // Measuring copies only: hidden from accessibility, so tests and screen readers see
            // each action once.
            if Shell.dialog-cancel != "": TextButton {
                text: Shell.dialog-cancel;
                accessible-role: none;
            }

            PrimaryButton {
                text: Shell.dialog-confirm;
                accessible-role: none;
            }
        }

        property <bool> stacked: measure.preferred-width > card.width - 2 * Theme.space-xl;

        content := VerticalLayout {
            padding: Theme.space-xl;
            spacing: Theme.space-lg;

            Text {
                text: Shell.dialog-title;
                color: Theme.on-surface;
                font-size: Theme.text-headline-small;
                wrap: word-wrap;
            }

            Text {
                text: Shell.dialog-body;
                color: Theme.text-secondary;
                font-size: Theme.text-body;
                wrap: word-wrap;
            }

            // The actions. Their area has a fixed horizontal size hint, so switching between one
            // row and the stack never changes the dialog's width constraints (no layout loop). Its
            // height is explicit: the `if` rows inside do not pass their size up to the Rectangle.
            Rectangle {
                min-width: 0px;
                preferred-width: 0px;
                horizontal-stretch: 1;
                height: card.stacked ? 2 * Theme.touch + Theme.space-xs : Theme.touch;

                if !card.stacked: HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-sm;

                    if Shell.dialog-cancel != "": TextButton {
                        text: Shell.dialog-cancel;
                        clicked => {
                            Shell.close-dialog(false);
                        }
                    }

                    PrimaryButton {
                        text: Shell.dialog-confirm;
                        clicked => {
                            Shell.close-dialog(true);
                        }
                    }
                }

                // Too long for one row: full-width buttons, the confirm action on top.
                if card.stacked: VerticalLayout {
                    spacing: Theme.space-xs;

                    PrimaryButton {
                        text: Shell.dialog-confirm;
                        clicked => {
                            Shell.close-dialog(true);
                        }
                    }

                    if Shell.dialog-cancel != "": TextButton {
                        text: Shell.dialog-cancel;
                        clicked => {
                            Shell.close-dialog(false);
                        }
                    }
                }
            }
        }
    }
}
