// The properties pane of a medium or expanded window: 360 to 480 px wide on the
// trailing edge, collapsible to a 48 px rail. Its children become the pane body and
// stay alive while it is collapsed (so scroll positions and edits survive).
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { IconButton } from "icon_button.slint";

export component SidePane inherits Rectangle {
    in property <string> title: "";
    in-out property <bool> collapsed: false;
    // Requested width when open; clamped to 360..480.
    in property <length> preferred-open-width: 400px;
    out property <length> pane-width: root.collapsed ? 48px : min(480px, max(360px, root.preferred-open-width));

    width: root.pane-width;
    background: transparent;

    animate width {
        duration: 180ms;
        easing: ease-out;
    }

    // The pane card: the desktop's glass surface with a soft edge, inset from the window
    // edges (no drag handle: the width is fixed, only the chevron collapses it).
    Rectangle {
        x: Theme.space-xs;
        y: Theme.space-xs;
        width: parent.width - Theme.space-sm;
        height: parent.height - Theme.space-sm;
        background: Theme.high-contrast ? Theme.surface : Theme.surface-container;
        border-radius: Theme.radius-lg;
        border-width: Theme.high-contrast ? 2px : 1px;
        border-color: Theme.high-contrast ? Theme.on-surface : Theme.glass-edge;
        clip: true;
        drop-shadow-color: Theme.shadow;
        drop-shadow-blur: Theme.shadow-blur-3;
        drop-shadow-offset-y: Theme.shadow-offset-2;

        VerticalLayout {
            HorizontalLayout {
                height: Theme.touch;
                padding-left: root.collapsed ? 0px : Theme.space-lg;

                if !root.collapsed: Text {
                    text: root.title;
                    color: Theme.on-surface;
                    font-size: Theme.text-title;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                IconButton {
                    icon: root.collapsed ? Icons.chevron-left : Icons.chevron-right;
                    label: root.collapsed ? "Expand Panel" : "Collapse Panel";
                    clicked => {
                        root.collapsed = !root.collapsed;
                    }
                }
            }

            Rectangle {
                visible: !root.collapsed;
                clip: true;

                @children
            }
        }
    }
}
