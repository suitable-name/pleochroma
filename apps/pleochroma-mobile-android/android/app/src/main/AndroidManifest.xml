<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Remote rendering, and its metered-network check (a normal, install-time
         permission). Files go through the system pickers, sharing through a FileProvider,
         printing through the print service. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Finding the paired computer again after it got a new address: browsing needs a
         multicast lock, held only while browsing (a normal, install-time permission). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Reaching the computer on the local network. With targetSdk 37 (Android 17) the system
         blocks every connection to a local device until the user allows this runtime
         permission; MainActivity.ensureLocalNetwork asks before the first remote use (a
         pairing, a connection test, a render, an export, the network browse), never at start.
         Older Android versions ignore it. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Scanning a pairing QR code. Asked only when the user taps Scan, never at start. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- A phone without a camera still pairs by pasting the link. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Without this line Google Play treats the CAMERA permission as needing autofocus and
         hides the app from phones that have none; the scanner works without it. -->
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- Google Play reads CHANGE_WIFI_MULTICAST_STATE as needing Wi-Fi and hides the app from
         devices without it. Wi-Fi only helps find the paired computer again (NsdDiscovery
         takes the multicast lock when the device has Wi-Fi); everything else, remote rendering
         included, works over any network. -->
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <!-- Vulkan 1.0.3 (0x400003) is preferred, never required: without it the app
         renders on the CPU. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false"
        android:version="0x400003" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules" android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pleochroma"
        tools:targetApi="33">

        <!-- Printing creates a system WebView (MainActivity.printHtml). Without this
             opt-out the WebView may upload its own usage and crash metrics to Google when
             the user has turned on device-level usage and diagnostics. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <!-- NativeActivity subclass. `singleTask` keeps exactly one instance (one Rust
             runtime per process): "Open with" while the app runs arrives in onNewIntent.
             configChanges: rotation, resizing, dark mode, font scale and the like must
             not recreate the activity, because that would tear down the native thread. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|layoutDirection|locale|colorMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <!-- Paired with the pinned Slint backend ownership switch. -->
            <meta-data android:name="dev.slint.applicationOwnsBack" android:value="true" />
            <meta-data
                android:name="android.app.lib_name"
                android:value="pleochroma_mobile_android" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Pairing link: pleochroma://pair?... from a QR scanner, a message or a web
                 page. Any app can register this scheme and any page can open it, so the app
                 never acts on a link by itself: it always shows "Pair with ...?" first. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pleochroma" android:host="pair" />
            </intent-filter>

            <!-- Open with: the design MIME type, set by Pleochroma itself and by file
                 managers that know it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.pleochroma.design+toml" />
            </intent-filter>

            <!-- Open with: by file name, for file managers that report a generic MIME
                 type. Android's path matching is not greedy, so each extension is listed
                 for names with up to three dots before it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.psdd" />
                <data android:pathPattern=".*\\..*\\.psdd" />
                <data android:pathPattern=".*\\..*\\..*\\.psdd" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.psdd" />
                <data android:pathPattern=".*\\.asc" />
                <data android:pathPattern=".*\\..*\\.asc" />
                <data android:pathPattern=".*\\..*\\..*\\.asc" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.asc" />
                <data android:pathPattern=".*\\.gem" />
                <data android:pathPattern=".*\\..*\\.gem" />
                <data android:pathPattern=".*\\..*\\..*\\.gem" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.gem" />
                <data android:pathPattern=".*\\.gcs" />
                <data android:pathPattern=".*\\..*\\.gcs" />
                <data android:pathPattern=".*\\..*\\..*\\.gcs" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.gcs" />
            </intent-filter>

            <!-- Open with: plain text and generic binary content (a GemCAD .asc file is
                 plain text; .gem and .gcs often arrive as octet-stream). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- Share to Pleochroma. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.pleochroma.design+toml" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- The QR scanner of the Remote page (opened by MainActivity.startQrScan). Not
             exported: only the app starts it. Portrait is not forced; the preview rotates. -->
        <activity
            android:name=".ScannerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode|fontScale"
            android:exported="false" />

        <!-- Share sheet: copies of exported files live in cache/share/. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.indicatrixsuite.mobile.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
