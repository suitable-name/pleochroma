import { PleoPalette } from "palette.slint";
import { PleoGlass } from "glass.slint";

// One figure of the card. `trend`: 1 better, -1 worse, 0 same. `delta` is the text of the change
// ("" for none); `part` is the bar fill 0..1 on the figure's own scale; `flag` marks a value outside
// the usual range. `short` is the name the folded line shows ("Bril"); empty uses `name`.
export struct PleoFigure {
    name: string,
    short: string,
    value: string,
    delta: string,
    part: float,
    ink: color,
    trend: int,
    flag: bool,
}

// A 24 x 24 stroked path icon.
component FigIcon inherits Rectangle {
    in property <string> d;
    in property <color> ink: PleoPalette.text-secondary;
    in property <length> size: 16px;
    in property <length> stroke: 1.7px;
    width: root.size;
    height: root.size;
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.d;
        stroke: root.ink;
        stroke-width: root.stroke;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }
}

// A small triangle: up for better, down for worse. Shape and color both carry the trend.
component TrendMark inherits Rectangle {
    in property <int> trend;
    in property <float> k: 1;
    width: 10px * root.k;
    height: 10px * root.k;
    if root.trend == 1: FigIcon { d: "M12 5 L20 19 H4 Z"; size: 10px * root.k; stroke: 2.6px; ink: PleoPalette.accent-emerald; }
    if root.trend == -1: FigIcon { d: "M12 19 L20 5 H4 Z"; size: 10px * root.k; stroke: 2.6px; ink: PleoPalette.danger; }
    if root.trend == 0: FigIcon { d: "M5 12 H19"; size: 10px * root.k; stroke: 2.6px; ink: PleoPalette.text-muted; }
}

// One row: name, a short bar, the value (an amber dot when flagged), the delta.
component FigureRow inherits Rectangle {
    in property <PleoFigure> figure;
    in property <bool> show_bars;
    in property <bool> show_deltas;
    // The ratio of `font-base` to the desktop's 11 px; every size scales with it.
    in property <float> k: 1;
    in property <length> font-base: 11px;
    height: 20px * root.k;
    accessible-role: AccessibleRole.text;
    accessible-label: root.figure.name + " " + root.figure.value + (root.figure.delta != "" && root.show_deltas ? ", change " + root.figure.delta : "");
    accessible-description: root.figure.flag ? "outside the usual range" : "";
    HorizontalLayout {
        spacing: 8px * root.k;
        Text { width: 82px * root.k; text: root.figure.name; font-size: root.font-base; color: PleoPalette.text-secondary; vertical-alignment: center; overflow: elide; }
        if root.show_bars: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 60px * root.k;
                height: 4px * root.k;
                border-radius: 2px * root.k;
                background: PleoPalette.border-subtle;
                Rectangle { x: 0px; width: parent.width * Math.min(Math.max(root.figure.part, 0), 1); height: 100%; border-radius: 2px * root.k; background: root.figure.ink; }
            }
        }
        if root.figure.flag: VerticalLayout {
            alignment: center;
            Rectangle { width: 6px * root.k; height: 6px * root.k; border-radius: 3px * root.k; background: PleoPalette.accent-amber; }
        }
        Text { min-width: 38px * root.k; text: root.figure.value; font-size: root.font-base * 12 / 11; font-weight: 700; color: root.figure.flag ? PleoPalette.accent-amber : PleoPalette.text-primary; horizontal-alignment: right; vertical-alignment: center; }
        if root.show_deltas: HorizontalLayout {
            spacing: 3px * root.k;
            VerticalLayout { alignment: center; TrendMark { trend: root.figure.trend; k: root.k; } }
            Text {
                min-width: 34px * root.k;
                text: root.figure.delta;
                font-size: root.font-base;
                color: root.figure.trend == 1 ? PleoPalette.accent-emerald : (root.figure.trend == -1 ? PleoPalette.danger : PleoPalette.text-muted);
                vertical-alignment: center;
            }
        }
    }
}

// The gemological numbers on glass. The whole card is one button that copies them. Folded, it is
// one line ("Bril 55.7 · Wind 12.1 · Ext 32.2 …") and a chevron. `font-base` is the size of the
// small text (11 px on the desktop); every other text size and the row sizes scale with it.
export component PleoFigures inherits PleoGlass {
    in property <[PleoFigure]> figures;
    in property <string> title;
    in-out property <bool> folded: false;
    in property <bool> show_deltas: false;
    in property <bool> show_bars: true;
    in property <string> action_text;
    in property <length> font-base: 11px;
    // The side of the fold button (22 px on the desktop; a phone passes a 48 px target).
    in property <length> fold-button-size: 22px;
    // The header row's height; 0 keeps the desktop's (20 px open, 28 px folded, scaled).
    in property <length> header-height: 0px;
    callback fold_toggled(bool);
    callback copy();
    callback action();

    property <float> k: root.font-base / 11px;

    width: lay.preferred-width;
    height: lay.preferred-height;
    accessible-role: AccessibleRole.button;
    accessible-enabled: true;
    accessible-label: "Copy the Five Gemological Numbers";
    accessible-description: "Copies the numbers to the clipboard";
    accessible-action-default => { root.copy(); }

    // Under the other controls: a click anywhere else on the card copies.
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.copy();
                return accept;
            }
            return reject;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.copy(); }
    }
    lay := VerticalLayout {
        padding: 10px * root.k;
        padding-top: (root.folded ? 4px : 8px) * root.k;
        padding-bottom: (root.folded ? 4px : 10px) * root.k;
        spacing: 3px * root.k;
        HorizontalLayout {
            height: root.header-height > 0px ? root.header-height : (root.folded ? 28px : 20px) * root.k;
            spacing: 8px * root.k;
            if !root.folded: Text {
                horizontal-stretch: 1;
                text: root.title;
                font-size: root.font-base * 10 / 11;
                font-weight: 700;
                letter-spacing: 0.8px * root.k;
                color: PleoPalette.text-muted;
                vertical-alignment: center;
            }
            if root.folded: HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 6px * root.k;
                for f[i] in root.figures: HorizontalLayout {
                    spacing: 4px * root.k;
                    if i < 3: Text { max-width: 38px * root.k; text: f.short != "" ? f.short : f.name; font-size: root.font-base; color: PleoPalette.text-muted; vertical-alignment: center; overflow: elide; }
                    if i < 3: Text { text: f.value; font-size: root.font-base * 12 / 11; font-weight: 700; color: f.flag ? PleoPalette.accent-amber : PleoPalette.text-primary; vertical-alignment: center; }
                    if i < 2 && i < root.figures.length - 1: Text { text: "·"; font-size: root.font-base * 12 / 11; color: PleoPalette.text-muted; vertical-alignment: center; }
                }
                if root.figures.length > 3: Text { text: "…"; font-size: root.font-base * 12 / 11; color: PleoPalette.text-muted; vertical-alignment: center; }
            }
            if !root.folded && root.action_text != "": Rectangle {
                width: act_text.preferred-width + 8px * root.k;
                border-radius: 6px * root.k;
                background: act_touch.has-hover ? PleoPalette.bg-card-hover : transparent;
                accessible-role: AccessibleRole.button;
                accessible-enabled: true;
                accessible-label: root.action_text;
                accessible-action-default => { root.action(); }
                act_text := Text { x: 4px * root.k; height: parent.height; text: root.action_text; font-size: root.font-base; color: PleoPalette.accent-cyan; vertical-alignment: center; }
                act_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.action(); }
                }
            }
            if !root.folded: VerticalLayout { alignment: center; FigIcon { d: "M8 8 H19 V19 H8 Z M5 16 V5 H16"; size: 13px * root.k; ink: PleoPalette.text-muted; } }
            Rectangle {
                width: root.fold-button-size;
                height: root.fold-button-size;
                border-radius: 8px * root.k;
                background: fold_touch.has-hover ? PleoPalette.bg-card-hover : transparent;
                border-width: fold_fs.has-focus ? 2px : 0px;
                border-color: PleoPalette.accent-cyan-hover;
                accessible-role: AccessibleRole.button;
                accessible-enabled: true;
                accessible-label: root.folded ? "Show Figures" : "Fold Figures";
                accessible-action-default => { root.toggle-fold(); }
                fold_fs := FocusScope {
                    key-pressed(event) => {
                        if event.text == Key.Space || event.text == Key.Return {
                            root.toggle-fold();
                            return accept;
                        }
                        return reject;
                    }
                }
                FigIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    d: root.folded ? "M9 6 L15 12 L9 18" : "M6 9 L12 15 L18 9";
                    size: 13px * root.k;
                    ink: PleoPalette.text-muted;
                }
                fold_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggle-fold(); }
                }
            }
        }
        if !root.folded: VerticalLayout {
            spacing: 3px * root.k;
            for f in root.figures: FigureRow {
                figure: f;
                show_bars: root.show_bars;
                show_deltas: root.show_deltas;
                k: root.k;
                font-base: root.font-base;
            }
        }
    }

    function toggle-fold() {
        root.folded = !root.folded;
        root.fold_toggled(root.folded);
    }
}
