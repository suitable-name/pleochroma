import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { BatchModel } from "../models/batch.slint";
import { HelpTopics } from "../models/help.slint";
import { HelpButton } from "help_button.slint";
import { TipButton } from "compact_controls.slint";
import { SegmentPill } from "pill_button.slint";

// Batch tilt-performance-curve computation: a confirmation state, then a running or done
// state. It is a separate component from `preview_batch_dialog.slint`, which has the same
// confirming and running split.
//
// `LiveComputeTarget::Both` runs `batch_queue::local_lane_count` local lanes plus remote
// dispatchers at once, all pulling designs off one queue (see `gui::batch::tilt`). So
// `design_index` is a completed count, not a cursor, and `local_active`/`local_lane_total`
// report a busy count. `remote_active`/`remote_in_flight`/`remote_title` describe the remote
// side: how many designs are on the remote and the design a dispatcher started last.
export component TiltBatchDialog inherits Rectangle {
    in property <bool> confirming: BatchModel.tilt_confirming;
    in property <int> offer_count: BatchModel.tilt_offer_count;
    in property <bool> running: BatchModel.tilt_batch_running;
    in property <int> design_index: BatchModel.tilt_design_index;
    in property <int> design_total: BatchModel.tilt_design_total;
    in property <string> eta: BatchModel.tilt_eta;
    in property <int> local_active: BatchModel.tilt_local_active;
    in property <int> local_lane_total: BatchModel.tilt_local_lane_total;
    in property <string> remote_title: BatchModel.tilt_remote_title;
    in property <bool> remote_active: BatchModel.tilt_remote_active;
    in property <int> remote_in_flight: BatchModel.tilt_remote_in_flight;
    in property <bool> done: BatchModel.tilt_done;
    in property <string> summary: BatchModel.tilt_summary;
    // The Edit tab's single-design sweep (see `BatchModel.tilt_single`): one bar that
    // follows the sweep's own raytrace steps instead of a completed-designs count.
    in property <bool> single: BatchModel.tilt_single;
    in property <bool> offer_regenerate: BatchModel.tilt_offer_regenerate;

    callback generate_confirmed();
    generate_confirmed => { BatchModel.tilt_generate_confirmed(); }
    callback dismiss_offer();
    dismiss_offer => { BatchModel.tilt_dismiss_offer(); }
    callback cancel();
    cancel => {
        if root.single {
            BatchModel.tilt_single_cancel();
        } else {
            BatchModel.tilt_cancel();
        }
    }
    callback close();
    close => { BatchModel.tilt_close(); }

    // Same rule as `preview_batch_dialog.slint`'s `can_start`.
    property <bool> can_start: !(root.offer_regenerate
        && (root.running
            || (BatchModel.tilt_offer_missing_only && BatchModel.tilt_offer_missing_count <= 0)));

    property <float> design_fraction: root.single
        ? BatchModel.tilt_single_fraction
        : (root.design_total > 0 ? (root.design_index * 1.0) / root.design_total : 0.0);
    // `* 1.0` forces float division rather than Slint's integer division truncating --
    // same idiom `preview_batch_dialog.slint` uses.
    property <float> local_fraction: root.local_lane_total > 0
        ? (root.local_active * 1.0) / root.local_lane_total
        : 0.0;

    background: Theme.overlay-backdrop;

    // The keyboard stays inside the card: Tab moves between its buttons, Enter takes the
    // main button, Escape declines the offer (or closes the finished summary), and every
    // other key is swallowed so a shortcut cannot fire on the design behind. A running batch
    // ignores Escape: the Cancel button stops it.
    // A full-window backdrop: clicks beside the card must not reach the design behind it.
    TouchArea {
        width: 100%;
        height: 100%;
    }

    FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Tab {
                return reject;
            }
            if event.text == Key.Escape {
                if root.confirming {
                    root.dismiss_offer();
                } else if root.done {
                    root.close();
                }
            } else if event.text == Key.Return {
                if root.confirming {
                    if root.can_start {
                        root.generate_confirmed();
                    }
                } else if root.done {
                    root.close();
                }
            }
            return accept;
        }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 380px;
                // Stated, not derived from the content: Slint measures a wrapped Text as one
                // line, so a height taken from the children would under-measure and `clip`
                // would cut off the buttons. The body is a `ScrollView` between a fixed title
                // and fixed buttons, so the buttons are never clipped. Capped against
                // `root.height` so the card never exceeds the window.
                height: root.confirming
                    ? Math.min(root.height - 96px, 430px)
                    : Math.min(root.height - 96px, root.done ? 240px : 340px);
                background: Theme.surface-dialog;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-dialog;
                drop-shadow-blur: 24px;
                drop-shadow-color: Theme.modal-shadow;
                clip: true;

                // Swallows clicks so they never reach anything behind this dialog -- same
                // idiom `preview_batch_dialog.slint`'s own inner card uses.
                TouchArea {}

                card := VerticalLayout {
                    padding: 18px;
                    spacing: 12px;

                    if root.confirming: VerticalLayout {
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                horizontal-stretch: 1;
                                text: "Compute Tilt-Performance Curves?";
                                font-size: 14px;
                                font-weight: 700;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                                accessible-role: AccessibleRole.text;
                            }
                            VerticalLayout {
                                alignment: center;
                                HelpButton {
                                    topic: HelpTopics.tilt-curves;
                                    hint: "Open the manual page on the tilt-performance graph";
                                }
                            }
                        }
                        // Body between the fixed title above and the fixed buttons
                        // below -- see the card's `height` comment for why the buttons
                        // must live OUTSIDE this scrollable region.
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: root.offer_regenerate
                                        ? "Which designs should get their full ±90° tilt sweep recomputed? Curves a chosen design already has are replaced."
                                        : (root.offer_count == 1
                                            ? "1 design has no computed tilt-performance curves yet. Compute its full ±90° sweep now?"
                                            : root.offer_count + " designs have no computed tilt-performance curves yet. Compute their full ±90° sweeps now?");
                                    font-size: 12px;
                                    color: Theme.text-secondary;
                                    wrap: word-wrap;
                                }
                                // The scope choice: only the regenerate commands show it. The
                                // filter panel's "Compute missing tilt curves" already holds
                                // exactly the missing set.
                                if root.offer_regenerate: VerticalLayout {
                                    spacing: 6px;
                                    SegmentPill {
                                        text: BatchModel.tilt_offer_missing_label;
                                        hint: "Compute only the designs with no tilt curves, or curves made with other settings.";
                                        selected: BatchModel.tilt_offer_missing_only;
                                        picked => { BatchModel.tilt_offer_missing_only = true; }
                                    }
                                    SegmentPill {
                                        text: BatchModel.tilt_offer_all_label;
                                        hint: "Compute every design again, replacing the curves it has.";
                                        selected: !BatchModel.tilt_offer_missing_only;
                                        picked => { BatchModel.tilt_offer_missing_only = false; }
                                    }
                                }
                                if root.offer_regenerate && root.running: Text {
                                    text: "A tilt-curve batch is already running -- wait for it to finish or cancel it first.";
                                    font-size: 11px;
                                    color: Theme.accent-amber;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "This is much slower than generating previews -- roughly 1.4 seconds per design on one CPU core, more over the whole catalogue -- but a configured remote worker is used automatically when available. It renders in the background, but the live 3D tracer pauses for the duration -- the viewport says so while it runs, and cancel at any time without losing what's already been computed.";
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            TipButton {
                                text: "Not Now";
                                hint: "Do not compute any curves now.";
                                clicked => { root.dismiss_offer(); }
                            }
                            TipButton {
                                text: "Compute";
                                hint: "Compute the tilt curves in the background. Enter does the same.";
                                primary: true;
                                enabled: root.can_start;
                                clicked => { root.generate_confirmed(); }
                            }
                        }
                    }

                    if !root.confirming: VerticalLayout {
                        spacing: 12px;

                        Text {
                            vertical-stretch: 0;
                            text: root.done
                                ? "Tilt-curve computation finished"
                                : (root.single ? "Computing tilt curves for this design..." : "Computing tilt-performance curves...");
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            accessible-role: AccessibleRole.text;
                        }

                        if !root.done: VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 10px;

                            // Local lanes run concurrently, so this shows a busy count rather
                            // than one title. Hidden under `RemoteOnly`, where no local lane runs.
                            if root.local_lane_total > 0: Text {
                                text: "Local: " + root.local_active + " / " + root.local_lane_total + " lane(s) busy";
                                font-size: 12px;
                                color: Theme.text-secondary;
                                overflow: elide;
                            }

                            // Remote dispatchers' in-flight count and the design one of them
                            // started last. Shown only while remote dispatchers run.
                            if root.remote_active: Text {
                                text: "Remote: " + (root.remote_in_flight > 0
                                ? root.remote_in_flight + " on remote"
                                    + (root.remote_title == "" ? "" : " -- " + root.remote_title)
                                : (root.remote_title == "" ? "Starting..." : root.remote_title));
                                font-size: 12px;
                                color: Theme.text-secondary;
                                overflow: elide;
                            }

                            // Overall progress: designs completed out of `N`. Not a cursor,
                            // since local and remote designs can be in flight together.
                            VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: root.single
                                            ? BatchModel.tilt_single_stage
                                            : "Completed " + root.design_index + " / " + root.design_total
                                                + (root.eta == "" ? "" : " · " + root.eta);
                                        font-size: 10px;
                                        color: Theme.text-muted;
                                    }
                                    Text {
                                        text: Math.round(root.design_fraction * 100) + "%";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: Theme.accent-cyan;
                                    }
                                }
                                Rectangle {
                                    height: 8px;
                                    border-radius: 4px;
                                    background: Theme.surface-sunken;
                                    border-width: 1px;
                                    border-color: Theme.border-dialog;
                                    clip: true;
                                    accessible-role: AccessibleRole.progress-indicator;
                                    accessible-label: "Tilt Curves Completed";
                                    accessible-value: Math.round(root.design_fraction * 100) + " percent";
                                    Rectangle {
                                        x: 0;
                                        y: 0;
                                        width: parent.width * root.design_fraction;
                                        height: 100%;
                                        background: Theme.accent-cyan;
                                        animate width { duration: 150ms; }
                                    }
                                }
                            }

                            // Busy count of the local lane pool. Hidden under `RemoteOnly`,
                            // like the "Local:" row above.
                            if root.local_lane_total > 0: VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Local lanes " + root.local_active + " / " + root.local_lane_total;
                                        font-size: 10px;
                                        color: Theme.text-muted;
                                    }
                                }
                                Rectangle {
                                    height: 6px;
                                    border-radius: 3px;
                                    background: Theme.surface-sunken;
                                    border-width: 1px;
                                    border-color: Theme.border-dialog;
                                    clip: true;
                                    Rectangle {
                                        x: 0;
                                        y: 0;
                                        width: parent.width * root.local_fraction;
                                        height: 100%;
                                        background: Theme.accent-amber;
                                        animate width { duration: 150ms; }
                                    }
                                }
                            }
                        }

                        if root.done: Text {
                            vertical-stretch: 0;
                            text: root.summary;
                            font-size: 12px;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }

                        // The card height is fixed; the spare height goes here, so the buttons sit
                        // at the bottom.
                        Rectangle { vertical-stretch: 1; }

                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 8px;
                            alignment: end;

                            if !root.done: TipButton {
                                text: "Cancel";
                                hint: "Stop computing. The curves already finished are kept.";
                                clicked => { root.cancel(); }
                            }
                            if root.done: TipButton {
                                text: "Close";
                                hint: "Close this summary.";
                                primary: true;
                                clicked => { root.close(); }
                            }
                        }
                    }
                }
            }
        }
    }
    }
}
