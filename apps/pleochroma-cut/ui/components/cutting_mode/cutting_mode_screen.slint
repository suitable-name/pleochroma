import { ScrollView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { CuttingModeModel } from "../../models/cutting_mode.slint";
import { SolidPreviewModel } from "../../models/solid_preview.slint";
import { HelpTopics } from "../../models/help.slint";
import { HelpButton } from "../help_button.slint";
import { CmAxisPicture } from "axis_picture.slint";
import { CmButton } from "cm_button.slint";
import { CmChips } from "index_chips.slint";
import { CmIndexWheel } from "index_wheel.slint";

// A heading over a value: one line of the step's details (the meet, the depth, the tool...).
component CmFact inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> ink: Theme.text-primary;
    spacing: 2px;

    Text {
        text: root.label;
        font-size: 12px;
        font-weight: 600;
        color: Theme.text-muted;
    }
    Text {
        text: root.value;
        font-size: 18px;
        color: root.ink;
        wrap: word-wrap;
    }
}

// A rounded panel on the page.
component CmCard inherits Rectangle {
    background: Theme.bg-card;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-subtle;
}

// A small rounded label (the step's state, its side of the stone).
component CmBadge inherits Rectangle {
    in property <string> text;
    in property <color> ink: Theme.text-primary;
    in property <color> fill: Theme.tint-neutral;

    width: badge_text.preferred-width + 28px;
    height: 32px;
    border-radius: root.height / 2;
    background: root.fill;

    badge_text := Text {
        text: root.text;
        color: root.ink;
        font-size: 15px;
        font-weight: 700;
        vertical-alignment: center;
        x: 14px;
        y: 0px;
        height: root.height;
    }
}

// The step itself: which step and which side of the stone, the code and the angle in large type,
// the indices to tick off, and the meet, depth, cheater offset, tool and note. `avail_w` is the
// width the panel is given; the angle's size follows it so it never runs out of the card.
component CmStepPanel inherits VerticalLayout {
    in property <length> avail_w;
    property <length> angle_size: Math.min(96px, Math.max(36px, (root.avail_w - 150px) / 4.0));
    spacing: 14px;

    HorizontalLayout {
        height: 32px;
        spacing: 12px;
        alignment: start;
        Text {
            text: CuttingModeModel.heading;
            font-size: 18px;
            font-weight: 600;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }
        Rectangle {
            width: side_badge.width;
            horizontal-stretch: 0;
            side_badge := CmBadge {
                y: (parent.height - self.height) / 2;
                text: CuttingModeModel.side_label;
                ink: CuttingModeModel.side_label == "Crown" ? Theme.accent-cyan
                    : CuttingModeModel.side_label == "Pavilion" ? Theme.accent-purple
                    : Theme.text-secondary;
                fill: CuttingModeModel.side_label == "Crown" ? Theme.tint-cyan
                    : CuttingModeModel.side_label == "Pavilion" ? Theme.tint-purple
                    : Theme.tint-neutral;
            }
        }
    }

    // The tier's code and its angle on one line.
    HorizontalLayout {
        spacing: 20px;
        alignment: start;
        Text {
            text: CuttingModeModel.tier_name;
            font-size: 52px;
            font-weight: 700;
            color: Theme.text-primary;
            vertical-alignment: center;
        }
        Text {
            text: CuttingModeModel.angle_text;
            font-size: root.angle_size;
            font-weight: 800;
            color: Theme.accent-cyan;
            vertical-alignment: center;
        }
    }

    if CuttingModeModel.step_state == 2: Rectangle {
        height: changed_note.preferred-height + 24px;
        border-radius: Theme.radius-md;
        background: Theme.surface-warning;
        border-width: 1px;
        border-color: Theme.accent-amber;
        changed_note := Text {
            text: "Changed since you marked it. The cutting values of this step are not the ones you ticked off. Mark it done again once you have cut it as it reads now.";
            font-size: 14px;
            color: Theme.accent-amber;
            wrap: word-wrap;
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
        }
    }

    Text {
        text: "Indices (Click One to Tick It Off)";
        font-size: 13px;
        font-weight: 600;
        color: Theme.text-muted;
    }
    CmChips {
        chips: CuttingModeModel.chips;
        toggled(index) => { CuttingModeModel.chip_clicked(index); }
    }

    // "Cut to" card, in words: the tier's own name, then what it meets (`Crown Main: Meet P1, P2`),
    // with the depth / mast, the tool, the cheater offset and the cutter's note beside or under it.
    Rectangle {
        border-radius: Theme.radius-md;
        background: Theme.surface-raised;
        // The layout sizes the card: no explicit height to go stale when a value wraps.
        cut_to_col := VerticalLayout {
            padding: 16px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 24px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    CmFact {
                        label: "Cut To";
                        value: CuttingModeModel.meet_text;
                    }
                }
                if CuttingModeModel.depth_text != "": VerticalLayout {
                    horizontal-stretch: 1;
                    CmFact {
                        label: "Depth";
                        value: CuttingModeModel.depth_text;
                    }
                }
            }
            if CuttingModeModel.tool_text != "": CmFact {
                label: "Tool";
                value: CuttingModeModel.tool_text;
            }
            if CuttingModeModel.cheater_text != "": CmFact {
                label: "Cheater";
                value: CuttingModeModel.cheater_text;
                ink: Theme.accent-amber;
            }
            if CuttingModeModel.notes_text != "": CmFact {
                label: "Your Note";
                value: CuttingModeModel.notes_text;
                ink: Theme.accent-amber;
            }
        }
    }

    // The step after this one, so the next index set is ready in the mind before the click.
    if CuttingModeModel.step_index + 1 < CuttingModeModel.schedule.length: Rectangle {
        height: 64px;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-subtle;
        accessible-role: AccessibleRole.text;
        accessible-label: "Next Step: " + CuttingModeModel.schedule[CuttingModeModel.step_index + 1].code + ", "
            + CuttingModeModel.schedule[CuttingModeModel.step_index + 1].angle;
        accessible-description: CuttingModeModel.schedule[CuttingModeModel.step_index + 1].indices;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 14px;
            Text {
                text: "Next";
                font-size: 13px;
                font-weight: 700;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
            Text {
                text: CuttingModeModel.schedule[CuttingModeModel.step_index + 1].code + "  " + CuttingModeModel.schedule[CuttingModeModel.step_index + 1].angle;
                font-size: 20px;
                font-weight: 700;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: CuttingModeModel.schedule[CuttingModeModel.step_index + 1].indices;
                font-size: 14px;
                color: Theme.text-muted;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    // The first step also draws how the rough must sit for the crystal axis.
    if CuttingModeModel.axis_shown: CmAxisPicture {
        height: Math.clamp(root.avail_w / 2 + 34px, 120px, 250px);
        description: CuttingModeModel.axis_description;
        frame: CuttingModeModel.axis_frame;
        axis: CuttingModeModel.axis_path;
    }
}

// The stone after this step, as large as the room allows. The render uses the size shown:
// `SolidPreviewModel.viewport_width/height` is the size the solid picture is rendered at. While
// this picture is up it writes its own size there (debounced by the timer, then
// `viewport_resized`). Rust restores the editor's size when the screen closes
// (`cutting_mode/viewport.rs`).
component CmStonePicture inherits Rectangle {
    background: Theme.viewport-bg;
    border-radius: Theme.radius-md;
    clip: true;

    Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        source: SolidPreviewModel.image;
        image-fit: contain;
        accessible-role: AccessibleRole.image;
        accessible-label: "The Stone After This Step";
        accessible-description: CuttingModeModel.stone_caption;
    }
    if !SolidPreviewModel.has_solid: Text {
        text: "The picture of the stone is still being drawn...";
        font-size: 15px;
        color: Theme.text-muted;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    Timer {
        interval: 60ms;
        running: root.width > 8px && root.height > 8px;
        triggered => {
            if (Math.abs(SolidPreviewModel.viewport_width - root.width) > 1px
                || Math.abs(SolidPreviewModel.viewport_height - root.height) > 1px) {
                SolidPreviewModel.viewport_width = root.width;
                SolidPreviewModel.viewport_height = root.height;
                SolidPreviewModel.viewport_resized();
            }
        }
    }
}

// The index wheel with its caption, in a card.
component CmWheelCard inherits CmCard {
    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        CmIndexWheel {
            vertical-stretch: 1;
            min-height: 0px;
            description: CuttingModeModel.wheel_caption;
            minor_ticks: CuttingModeModel.wheel_minor;
            major_ticks: CuttingModeModel.wheel_major;
            spokes: CuttingModeModel.wheel_spokes;
            marks: CuttingModeModel.wheel_marks;
            numbers: CuttingModeModel.wheel_scale;
        }
        Text {
            text: CuttingModeModel.wheel_caption;
            font-size: 13px;
            color: Theme.text-secondary;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}

// The stone and its caption, in a card.
component CmStoneCard inherits CmCard {
    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        CmStonePicture {
            vertical-stretch: 1;
            min-height: 0px;
        }
        Text {
            text: CuttingModeModel.stone_caption;
            font-size: 13px;
            color: Theme.text-secondary;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}

// Cutting mode: the cutting instructions one step per page, filling the window. See
// `CuttingModeModel` (`models/cutting_mode.slint`) for what each property is and who writes it.
//
// Blocks are placed by hand from the window's size, not through stretch factors: a Rectangle in a
// layout takes a share of the free room by default. The window's minimum size comes from the main
// window, not from this screen.
//
// From the top: the header (title, state, help, close), the step strip (one segment per step,
// done / current / to do, a click jumps there), the body, and the footer (Previous, Mark step
// done, Next; Reset progress at the right).
//
// Body, width >= 1100 px: left the step card (with the next step under it), right the stone with the
// index wheel beside it (below it when the column is narrow). Narrower than that the blocks are
// stacked in one scrolling column. The keys are handled by `CuttingModeModel.handle_key`, called
// from the main window's key handler, not from here.
export component CuttingModeScreen inherits Rectangle {
    background: Theme.bg-darkest;

    property <length> pad: 20px;
    property <length> gap: 16px;
    property <length> head_h: 52px;
    property <length> strip_h: 40px;
    property <length> foot_h: 68px;
    property <bool> wide: root.width >= 1100px;
    property <bool> ready: !CuttingModeModel.busy && CuttingModeModel.error == "";
    property <length> body_w: max(0px, root.width - 2 * root.pad);
    property <length> body_y: root.pad + root.head_h + (root.ready ? root.strip_h + 4px : 0px) + root.gap;
    property <length> body_h: max(0px, root.height - root.body_y - (root.ready ? root.foot_h + root.gap : 0px) - root.pad);

    // Takes every click and wheel turn, so none reaches the editor underneath.
    TouchArea {
        scroll-event(event) => { return accept; }
    }

    // --- Header: what this is, which design, the step's state, the way out. ---
    HorizontalLayout {
        x: root.pad;
        y: root.pad;
        width: root.body_w;
        height: root.head_h;
        spacing: 16px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: "Cutting Mode";
                font-size: 13px;
                font-weight: 600;
                color: Theme.text-muted;
            }
            Text {
                text: CuttingModeModel.design_name != "" ? CuttingModeModel.design_name : "Untitled design";
                font-size: 20px;
                font-weight: 600;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }
        if CuttingModeModel.step_state != 0 && root.ready: Rectangle {
            width: state_badge.width;
            horizontal-stretch: 0;
            // The badge, the "?" and Close below are one height (36 px).
            state_badge := CmBadge {
                height: 36px;
                y: (parent.height - self.height) / 2;
                text: CuttingModeModel.state_text;
                ink: CuttingModeModel.step_state == 1 ? Theme.success : Theme.accent-amber;
                fill: CuttingModeModel.step_state == 1 ? Theme.badge-emerald-bg : Theme.badge-amber-bg;
            }
        }
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            HelpButton {
                topic: HelpTopics.cutting-mode;
                hint: "Open the manual page on cutting mode";
                diameter: 36px;
            }
        }
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            CmButton {
                text: "Close";
                hint: "Leave cutting mode and go back to the editor. Esc does the same. Your marks are kept.";
                icon: @image-url("../../icons/close.svg");
                button_h: 36px;
                clicked => { CuttingModeModel.close(); }
            }
        }
    }

    // --- Step strip: the progress line and one named cell per step (a check when done). Above 20
    // steps it shows a window of 18 around the current step, with a "..." cell at each cut end. ---
    if root.ready: strip_row := Rectangle {
        x: root.pad;
        y: root.pad + root.head_h + 4px;
        width: root.body_w;
        height: root.strip_h;

        property <length> text_w: 230px;
        property <int> n: max(1, CuttingModeModel.schedule.length);
        property <bool> windowed: self.n > 20;
        property <int> vis: self.windowed ? 18 : self.n;
        property <int> start: self.windowed ? Math.clamp(CuttingModeModel.step_index - 9, 0, self.n - self.vis) : 0;
        property <bool> more_before: self.start > 0;
        property <bool> more_after: self.start + self.vis < self.n;
        property <length> mark_w: 34px;
        property <length> cells_x: self.text_w + 12px + (self.more_before ? self.mark_w + 4px : 0px);
        property <length> cells_w: max(0px, self.width - self.cells_x - (self.more_after ? self.mark_w + 4px : 0px));
        property <length> cell_w: Math.clamp((self.cells_w - (self.vis - 1) * 4px) / self.vis, 20px, 96px);

        Text {
            x: 0px;
            width: strip_row.text_w;
            height: parent.height;
            text: CuttingModeModel.progress_text;
            font-size: 15px;
            font-weight: 600;
            color: CuttingModeModel.done_count >= CuttingModeModel.step_count && CuttingModeModel.step_count > 0 ? Theme.success : Theme.text-primary;
            vertical-alignment: center;
            overflow: elide;
        }
        if strip_row.more_before: Rectangle {
            x: strip_row.text_w + 12px;
            width: strip_row.mark_w;
            height: parent.height;
            border-radius: 6px;
            background: Theme.bg-input;
            accessible-role: AccessibleRole.button;
            accessible-label: "Earlier Steps";
            accessible-description: "Show the steps before the ones in view.";
            accessible-action-default => { CuttingModeModel.jump_to(strip_row.start - 1); }
            Text { width: 100%; height: 100%; text: "…"; font-size: 15px; font-weight: 700; color: Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { CuttingModeModel.jump_to(strip_row.start - 1); }
            }
        }
        for row[i] in CuttingModeModel.schedule: rectangle-code-2 := Rectangle {
            x: strip_row.cells_x + (i - strip_row.start) * (strip_row.cell_w + 4px);
            width: strip_row.cell_w;
            height: parent.height;

            if i >= strip_row.start && i < strip_row.start + strip_row.vis: Rectangle {
                width: parent.width;
                height: parent.height;
                border-radius: 6px;
                background: row.state == 1 ? Theme.badge-emerald-bg : row.state == 2 ? Theme.badge-amber-bg : i == CuttingModeModel.step_index ? Theme.accent-cyan-surface : Theme.bg-input;
                border-width: i == CuttingModeModel.step_index ? 2px : 1px;
                border-color: i == CuttingModeModel.step_index ? Theme.accent-cyan : Theme.border-subtle;

                accessible-role: AccessibleRole.button;
                accessible-label: "Go to Step "+ (i + 1) + ", " + row.code;
                accessible-description: row.side == 0 ? "Pavilion" : (row.side == 1 ? "Girdle" : "Crown");
                accessible-action-default => { CuttingModeModel.jump_to(i); }

                HorizontalLayout {
                    alignment: center;
                    spacing: 4px;
                    if row.state == 1: VerticalLayout {
                        alignment: center;
                        Image { source: @image-url("../../icons/check.svg"); colorize: Theme.success; width: 14px; height: 14px; }
                    }
                    Text {
                        text: row.code;
                        font-size: 13px;
                        font-weight: 700;
                        color: row.state == 2 ? Theme.accent-amber : (i == CuttingModeModel.step_index ? Theme.text-primary : Theme.text-secondary);
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if row.state == 2: Text {
                        text: "!";
                        font-size: 14px;
                        font-weight: 800;
                        color: Theme.accent-amber;
                        vertical-alignment: center;
                    }
                }
                // The side of the stone: pavilion violet, girdle grey, crown cyan.
                Rectangle {
                    x: 5px;
                    y: parent.height - 4px;
                    width: parent.width - 10px;
                    height: 2px;
                    border-radius: 1px;
                    background: row.side == 0 ? Theme.accent-purple : (row.side == 1 ? Theme.text-muted : Theme.accent-cyan);
                }
                TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { CuttingModeModel.jump_to(i); }
                }
            }
        }
        if strip_row.more_after: Rectangle {
            x: parent.width - strip_row.mark_w;
            width: strip_row.mark_w;
            height: parent.height;
            border-radius: 6px;
            background: Theme.bg-input;
            accessible-role: AccessibleRole.button;
            accessible-label: "Later Steps";
            accessible-description: "Show the steps after the ones in view.";
            accessible-action-default => { CuttingModeModel.jump_to(strip_row.start + strip_row.vis); }
            Text { width: 100%; height: 100%; text: "…"; font-size: 15px; font-weight: 700; color: Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { CuttingModeModel.jump_to(strip_row.start + strip_row.vis); }
            }
        }
    }

    // --- Body: busy, the reason there is nothing to cut, or the step. ---
    if CuttingModeModel.busy: Text {
        x: root.pad;
        y: root.body_y;
        width: root.body_w;
        height: root.body_h;
        text: "Getting the cutting steps ready...";
        font-size: 22px;
        color: Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if !CuttingModeModel.busy && CuttingModeModel.error != "": Text {
        x: root.pad;
        y: root.body_y;
        width: root.body_w;
        height: root.body_h;
        text: CuttingModeModel.error;
        font-size: 22px;
        color: Theme.accent-amber;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Wide: the step card on the left (about 42%), the stone and the large wheel on the right.
    if root.ready && root.wide: wide_body := Rectangle {
        x: root.pad;
        y: root.body_y;
        width: root.body_w;
        height: root.body_h;

        property <length> lw: Math.max(480px, (self.width - root.gap) * 0.42);
        property <length> rw: self.width - root.gap - self.lw;
        // The wheel sits beside the stone when the right column is wide enough, else below it.
        property <bool> beside: self.rw >= 780px;
        property <length> wheel_w: Math.clamp(self.rw * 0.4, 360px, 480px);
        property <length> wheel_h: Math.min(self.wheel_w + 40px, self.height * 0.5);

        CmCard {
            x: 0px;
            y: 0px;
            width: parent.lw;
            height: parent.height;

            // The step, scrolling when the window is too short for all of it.
            ScrollView {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                content-width: self.width;
                content-height: step_panel.preferred-height + 32px;

                step_panel := CmStepPanel {
                    x: 20px;
                    y: 16px;
                    width: parent.width - 40px - 12px;
                    height: self.preferred-height;
                    avail_w: self.width;
                }
            }
        }

        CmStoneCard {
            x: parent.lw + root.gap;
            y: 0px;
            width: parent.beside ? parent.rw - parent.wheel_w - root.gap : parent.rw;
            height: parent.beside ? parent.height : parent.height - parent.wheel_h - root.gap;
        }
        CmWheelCard {
            x: parent.beside ? parent.lw + root.gap + parent.rw - parent.wheel_w : parent.lw + root.gap;
            y: parent.beside ? 0px : parent.height - parent.wheel_h;
            width: parent.beside ? parent.wheel_w : parent.rw;
            height: parent.beside ? parent.height : parent.wheel_h;
        }
    }

    // Narrow: everything stacked in one scrolling column.
    if root.ready && !root.wide: narrow_body := ScrollView {
        x: root.pad;
        y: root.body_y;
        width: root.body_w;
        height: root.body_h;
        content-width: self.width;
        content-height: narrow_step.height + root.gap + narrow_body.stone_h + root.gap + 400px;

        property <length> col_w: self.width - 12px;
        property <length> stone_h: Math.clamp(self.col_w * 0.75, 260px, 460px);

        narrow_step := CmCard {
            x: 0px;
            y: 0px;
            width: narrow_body.col_w;
            height: narrow_panel.preferred-height + 32px;

            narrow_panel := CmStepPanel {
                x: 20px;
                y: 16px;
                width: parent.width - 40px;
                height: self.preferred-height;
                avail_w: self.width;
            }
        }
        CmStoneCard {
            x: 0px;
            y: narrow_step.height + root.gap;
            width: narrow_body.col_w;
            height: narrow_body.stone_h;
        }
        CmWheelCard {
            x: 0px;
            y: narrow_step.height + root.gap + narrow_body.stone_h + root.gap;
            width: narrow_body.col_w;
            height: 400px;
        }
    }

    // --- Footer: the three buttons in the middle, reset at the right, the keys under them. ---
    if root.ready: Rectangle {
        x: root.pad;
        y: root.height - root.pad - root.foot_h;
        width: root.body_w;
        height: root.foot_h;

        HorizontalLayout {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 44px;
            spacing: 12px;

            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
            }
            if !CuttingModeModel.confirm_reset: HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 12px;
                CmButton {
                    text: "Previous";
                    hint: CuttingModeModel.has_previous
                        ? "Go back to the previous step. The Left arrow or Page Up does the same."
                        : "This is the first step.";
                    icon: @image-url("../../icons/chevron-right.svg");
                    icon_rotation: 180deg;
                    enabled: CuttingModeModel.has_previous;
                    clicked => { CuttingModeModel.previous(); }
                }
                cm-button-step-state := CmButton {
                    text: CuttingModeModel.step_state == 1 ? "Mark Not Done"
                        : CuttingModeModel.tier_name + (CuttingModeModel.has_next ? " Done · Next" : " Done");
                    access_label: CuttingModeModel.step_state == 1 ? "Mark Not Done" : "Mark Step Done";
                    hint: CuttingModeModel.step_state == 1
                        ? "Take the done mark back from this step, for example when you have to cut it again."
                        : "Mark this step as cut and remember it, then go on to the next step. Space or D does the same.";
                    icon: @image-url("../../icons/check.svg");
                    primary: CuttingModeModel.step_state != 1;
                    clicked => {
                        if CuttingModeModel.step_state == 1 {
                            CuttingModeModel.toggle_done();
                        } else {
                            CuttingModeModel.mark_done_and_next();
                        }
                    }
                }
                CmButton {
                    text: "Next";
                    hint: CuttingModeModel.has_next
                        ? "Go on to the next step without marking this one. The Right arrow or Page Down does the same."
                        : "This is the last step.";
                    icon: @image-url("../../icons/chevron-right.svg");
                    icon_after: true;
                    enabled: CuttingModeModel.has_next;
                    clicked => { CuttingModeModel.next(); }
                }
            }
            if CuttingModeModel.confirm_reset: HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Remove every mark for this design?";
                        font-size: 16px;
                        font-weight: 600;
                        color: Theme.danger;
                        vertical-alignment: center;
                    }
                }
                CmButton {
                    text: "Reset";
                    hint: "Yes, remove every done mark of this design.";
                    danger: true;
                    clicked => {
                        CuttingModeModel.confirm_reset = false;
                        CuttingModeModel.reset_confirmed();
                    }
                }
                CmButton {
                    text: "Keep My Marks";
                    hint: "Do not reset. Esc does the same.";
                    clicked => { CuttingModeModel.confirm_reset = false; }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;

                if !CuttingModeModel.confirm_reset: CmButton {
                    // Its own width (a child of a plain Rectangle would fill it), at the right
                    // end of the row.
                    width: self.preferred-width;
                    x: parent.width - self.width;
                    y: 0px;
                    text: "Reset Progress";
                    hint: "Remove every done mark of this design. You are asked to confirm first.";
                    icon: @image-url("../../icons/rotate-ccw.svg");
                    clicked => { CuttingModeModel.confirm_reset = true; }
                }
            }
        }

        Text {
            x: 0px;
            y: 50px;
            width: parent.width;
            height: 16px;
            text: "Left and Right arrows: previous and next step  ·  Space or D: mark done and go on  ·  Esc: leave";
            font-size: 12px;
            color: Theme.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
