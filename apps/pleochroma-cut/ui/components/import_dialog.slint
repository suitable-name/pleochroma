import { Theme } from "../theme.slint";
import { LibraryModel } from "../models/library.slint";
import { HelpTopics } from "../models/help.slint";
import { HelpButton } from "help_button.slint";
import { IconButton } from "icon_button.slint";
import { TipButton } from "compact_controls.slint";
import { ToggleRow } from "toggle_switch.slint";

// "Import" popup for the user's own `.psdd`/`.asc`/`.gem`/`.gcs` files. Picking a file or folder
// imports it at once: there is no path field and no confirm button. Rust (`pick_asc_file` and
// `pick_asc_folder`, via `rfd::FileDialog`) picks and imports off the UI thread. Cancelling a
// native dialog does nothing and the popup stays open. Separate file and folder buttons, since
// one native dialog cannot offer both.
//
// A pick that would replace a catalogue row of the same filename is confirmed by Rust with a
// native dialog before the import (`confirm_collisions_then` in `gui::library::local::import`).
// The buttons here do not change for that.
//
// Inherits `PopupWindow`: it renders in Slint's popup layer, above everything, so it is
// instantiated unconditionally and driven by show()/close() (see `header.slint`'s `import_popup`).
export component ImportDialog inherits PopupWindow {
    in property <string> result_text: LibraryModel.import_result_text;
    in property <bool> importing: LibraryModel.is_busy;
    // True when the import replaced an existing row or some files failed. The popup then stays
    // open after the import so `result_text` can be read (see `changed importing`).
    in property <bool> had_collision: LibraryModel.import_should_stay_open;
    // Progress of the running import, 0.0..1.0, meaningful while `importing`. `import_done` and
    // `import_total` are the raw file counts (`import_total` is 0 until the first file reports),
    // shown as "file N / M". Set only in `spawn_import` (`gui::library::local::import::wiring`).
    in property <int> import_done: LibraryModel.import_done;
    in property <int> import_total: LibraryModel.import_total;
    in property <float> import_progress: LibraryModel.import_progress;

    // Whether the NEXT folder pick also walks subfolders. Read when "Choose folder..." is clicked,
    // not polled: picking a folder starts the import at once, so this must be set before that
    // click.
    property <bool> recurse_subfolders: false;

    // Not `close-on-click`, which would close the popup on the press of "Choose file..." itself.
    // Closing is explicit: the × button and Escape.
    close-policy: PopupClosePolicy.no-auto-close;

    // A `PopupWindow` is modal and takes every click while open. Closing it as the import ends
    // hands input back to the preview confirm that the import completion opens in `app.slint`;
    // the toast already carries the summary.
    changed importing => {
        if (!self.importing) {
            // Stay open after a replacement, so the warning in `result_text` can be read.
            if (!root.had_collision) {
                root.close();
            }
        }
    }

    // Neither takes nor returns a path: each runs a native picker and, unless cancelled, the
    // import. `pick_asc_folder` also gets the current `recurse_subfolders`.
    callback pick_asc_file();
    pick_asc_file => { LibraryModel.pick_asc_file(); }
    callback pick_asc_folder(bool);
    pick_asc_folder(recurse) => { LibraryModel.pick_asc_folder(recurse); }

    Rectangle {
        width: 420px;
        height: layout.preferred-height + 24px;
        background: Theme.bg-card;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-medium;
        drop-shadow-blur: 20px;
        drop-shadow-color: Theme.shadow-medium;
        drop-shadow-offset-y: 6px;

        // Escape closes the panel; an import in progress carries on in the background. The panel
        // takes focus when built, so Escape works without a click first.
        FocusScope {
            width: 100%;
            height: 100%;
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.close();
                    return accept;
                }
                return reject;
            }

        layout := VerticalLayout {
            padding: 16px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 6px;
                Text {
                    horizontal-stretch: 1;
                    text: "Import Designs";
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    accessible-role: AccessibleRole.text;
                }
                VerticalLayout {
                    alignment: center;
                    HelpButton {
                        topic: HelpTopics.import-designs;
                        hint: "Open the manual page on bringing designs in";
                    }
                }
                IconButton {
                    icon: @image-url("../icons/close.svg");
                    hint: "Close the import panel";
                    width: 26px;
                    height: 26px;
                    hover_fill: Theme.bg-elevated;
                    tint: Theme.text-muted;
                    clicked => { root.close(); }
                }
            }

            Text {
                text: "Pick a single .psdd, .asc, .gem or .gcs file, or a folder of them -- the import runs immediately.";
                font-size: 11px;
                color: Theme.text-muted;
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }
            // `.gem` and `.gcs` files are converted to `.asc` on import
            // (`gui::library::local::import::foreign`); the original is kept as an attachment.
            Text {
                text: ".gem (GemCAD) and .gcs (Gem Cut Studio) files are converted to .asc cutting instructions; the original file stays attached to the design.";
                font-size: 10px;
                color: Theme.text-muted;
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }

            // Set BEFORE "Choose folder..." is clicked (see `recurse_subfolders`). Placed above the
            // buttons, in the order the user needs them.
            ToggleRow {
                text: "Include Subfolders (Set This First)";
                hint: "Also import the designs in the folders inside the one you pick. Turn this on BEFORE you press Choose folder, because the import starts as soon as you pick.";
                label_color: root.importing ? Theme.text-muted : Theme.text-secondary;
                checked: root.recurse_subfolders;
                enabled: !root.importing;
                toggled => { root.recurse_subfolders = !root.recurse_subfolders; }
            }

            HorizontalLayout {
                spacing: 6px;
                TipButton {
                    text: "Choose File...";
                    hint: "Pick one .psdd, .asc, .gem or .gcs file. It is imported as soon as you pick it.";
                    icon: @image-url("../icons/page.svg");
                    enabled: !root.importing;
                    clicked => { root.pick_asc_file(); }
                }
                TipButton {
                    text: "Choose Folder...";
                    hint: "Pick a folder. Every .psdd, .asc, .gem and .gcs file in it is imported as soon as you pick it.";
                    icon: @image-url("../icons/folder.svg");
                    enabled: !root.importing;
                    clicked => { root.pick_asc_folder(root.recurse_subfolders); }
                }
            }

            if root.importing: VerticalLayout {
                spacing: 6px;
                Text {
                    text: "Importing...";
                    font-size: 11px;
                    font-weight: 600;
                    color: Theme.accent-amber;
                    accessible-role: AccessibleRole.text;
                }

                // Folder imports only: a lone file always reports `1 / 1`, which gives no useful
                // count and would jump to 100% too fast to read.
                if root.import_total > 1: VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "file " + root.import_done + " / " + root.import_total;
                            font-size: 10px;
                            color: Theme.text-muted;
                            accessible-role: AccessibleRole.text;
                        }
                        Text {
                            text: Math.round(root.import_progress * 100) + "%";
                            font-size: 10px;
                            font-weight: 700;
                            color: Theme.accent-cyan;
                            accessible-role: AccessibleRole.text;
                        }
                    }
                    Rectangle {
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.surface-sunken;
                        border-width: 1px;
                        border-color: Theme.border-dialog;
                        clip: true;
                        accessible-role: AccessibleRole.progress-indicator;
                        accessible-label: "Import Progress";
                        accessible-value: Math.round(root.import_progress * 100) + " percent";

                        Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width * root.import_progress;
                            height: 100%;
                            background: Theme.accent-cyan;
                            animate width { duration: 150ms; }
                        }
                    }
                }
            }

            if !root.importing && root.result_text != "": Text {
                text: root.result_text;
                font-size: 11px;
                color: Theme.text-secondary;
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }
        }
        }
    }
}
