import { CheckBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { IconButton } from "icon_button.slint";
import { TipButton } from "compact_controls.slint";
import { TipBox } from "tip_box.slint";

// A generic modal Save/Discard/Cancel confirmation for the destructive-action guards: the
// unsaved-changes guard (`EditorModel.unsaved_dialog_*`) and window close
// (`MainWindow.close_confirm_*`). It is bound to nothing but its own properties and callbacks,
// so each call site drives it from the model that owns the decision.
//
// Full-viewport backdrop and a centered, content-sized card, as in
// `metadata_editor_dialog.slint`.
// Clicking the backdrop counts as Cancel, so a stray click never picks the destructive option.
//
// `primary_label`/`secondary_label` empty ("") hides that button entirely.
export component ConfirmActionDialog inherits Rectangle {
    in property <string> heading: "Unsaved Changes";
    in property <string> message: "";
    in property <string> primary_label: "Save";
    in property <string> secondary_label: "Discard";
    // Optional third action; "" hides it, as for the other labels. The startup-restore
    // prompt's "Delete" uses it for a leftover autosave.
    in property <string> tertiary_label: "";
    // The label of the button that closes the question without choosing ("Cancel" by default). A
    // question whose "no answer" has a name of its own says it here ("Not Now"): the button still
    // fires `cancel`, like Escape, the close button and a click on the backdrop.
    in property <string> cancel_label: "Cancel";
    // What each button does, in one plain sentence (the tooltip, read after the label by a
    // screen reader). Empty: "Choose <label>." A call site that knows better says so.
    in property <string> primary_hint: "";
    in property <string> secondary_hint: "";
    in property <string> tertiary_hint: "";
    // Shows a "Don't Ask Again" checkbox. Off for decisions that differ each time, such as
    // the unsaved-changes guards. `dont_ask` holds the checkbox state when `primary` or
    // `secondary` fires; it is not meaningful for `cancel`. The caller decides what
    // persisting it means (the `write_confirm_*` sites in `gui::editor::native_io`).
    in property <bool> show_dont_ask: false;
    // `in-out`: the checkbox sets it, and the caller reads it back through a two-way `<=>`
    // binding at its mount site (`write_confirm_open` in `app.slint`). Slint rejects that on `out`.
    in-out property <bool> dont_ask: false;

    callback primary();
    callback secondary();
    callback cancel();
    callback tertiary();

    background: Theme.overlay-backdrop;

    // Takes focus on mount, so Escape and Return work without a click. Every unhandled key is
    // swallowed, so `app.slint`'s global shortcuts cannot fire behind the modal. `Key.Tab` is
    // passed on (`return reject`) so the window's Tab focus cycling still works.
    FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
            } else if event.text == Key.Return && root.primary_label != "" {
                root.primary();
            } else if event.text == Key.Tab {
                return reject;
            }
            return accept;
        }

        TouchArea {
            clicked => { root.cancel(); }
        }

        Rectangle {
            width: 420px;
            height: content.preferred-height;
            background: Theme.surface-dialog;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-dialog;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.modal-shadow;
            clip: true;

            // Swallows clicks so they never fall through to the backdrop's TouchArea
            // above (same idiom `metadata_editor_dialog.slint` uses for its own card).
            TouchArea {}

            content := VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: root.heading;
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        accessible-role: AccessibleRole.text;
                    }
                    IconButton {
                        icon: @image-url("../icons/close.svg");
                        hint: "Close this question and change nothing";
                        width: 26px;
                        height: 26px;
                        clicked => { root.cancel(); }
                    }
                }

                Text {
                    text: root.message;
                    font-size: 12px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                    accessible-role: AccessibleRole.text;
                }

                if root.show_dont_ask: TipBox {
                    hint: "Tick to stop asking this question. Your answer is remembered.";
                    CheckBox {
                        text: "Don't Ask Again";
                        checked <=> root.dont_ask;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    if root.tertiary_label != "": tip-button-tertiary-label := TipButton {
                        text: root.tertiary_label;
                        hint: root.tertiary_hint != "" ? root.tertiary_hint : "Choose \"" + root.tertiary_label + "\".";
                        clicked => { root.tertiary(); }
                    }
                    TipButton {
                        text: root.cancel_label;
                        hint: "Close this question and change nothing.";
                        clicked => { root.cancel(); }
                    }
                    if root.secondary_label != "": tip-button-secondary-label := TipButton {
                        text: root.secondary_label;
                        hint: root.secondary_hint != "" ? root.secondary_hint : "Choose \"" + root.secondary_label + "\".";
                        clicked => { root.secondary(); }
                    }
                    if root.primary_label != "": tip-button-primary-label := TipButton {
                        text: root.primary_label;
                        hint: root.primary_hint != "" ? root.primary_hint : "Choose \"" + root.primary_label + "\". Enter does the same.";
                        primary: true;
                        clicked => { root.primary(); }
                    }
                }
            }
        }
    }
}
