import { LineEdit, ComboBox, ScrollView } from "std-widgets.slint";
import { GearRemapRow } from "../types.slint";
import { Theme } from "../theme.slint";
import { EditorModel } from "../models/editor.slint";
import { GuideModel } from "../models/guide.slint";
import { HelpTopics } from "../models/help.slint";
import { DesignSettingsModel } from "../models/design_settings.slint";
import { RiFieldModel } from "../models/ri_field.slint";
import { ParametersModel } from "../models/parameters.slint";
import { MaterialChip, PreviewBadge } from "material_chip.slint";
// The material is shown here as a read-only chip (`MaterialChip`, with the amber "Previewing"
// badge while a preview is on); the Stone tab of the Parameters dock edits it.
import { ViewportModel } from "../models/viewport.slint";
import { GuideLockTip } from "guide_lock.slint";
import { HelpButton } from "help_button.slint";
import { TipButton } from "compact_controls.slint";
import { ActionButton } from "chip_toggle.slint";
import { AdvancedNote } from "advanced_note.slint";
import { SettingLabel } from "settings_dialog/setting_label.slint";
import { KitIcon, KitIcons } from "kit/icons.slint";
import { KitSwitchRow } from "kit/panel.slint";
import { ChoiceSeg } from "editor_inspector/choice_seg.slint";

// A section caption of the Design sheet, in small capitals.
component SheetCaption inherits Text {
    font-size: 10px;
    font-weight: 700;
    color: Theme.text-muted;
    accessible-role: AccessibleRole.text;
}

// One labelled row of the sheet: the name, then the control.
component SheetRow inherits HorizontalLayout {
    in property <string> label;
    in property <length> label_width: 96px;
    spacing: 10px;
    Text {
        width: root.label_width;
        text: root.label;
        font-size: 12px;
        color: Theme.text-secondary;
        vertical-alignment: center;
        overflow: elide;
    }
    @children
}

// A text field of the sheet. It applies through `commit` on Enter and when it is left (never per
// key); `escaped` fires on Esc, and the sheet drops the open edit.
component SheetField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    // What a screen reader says for the field.
    in property <string> reader_label;
    in property <string> hint;
    in property <bool> enabled: true;
    callback commit();
    callback escaped();

    height: 32px;
    if root.hint != "": Tooltip { text: @markdown("\{root.hint}"); }
    LineEdit {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        text <=> root.text;
        placeholder-text: root.placeholder;
        accessible-label: root.reader_label;
        accessible-description: root.hint;
        accepted => { root.commit(); }
        changed has-focus => {
            EditorModel.text_focus = self.has-focus;
            if !self.has-focus {
                root.commit();
            }
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.escaped();
                return accept;
            }
            reject
        }
    }
}

// The four sources of the RI range, as one segmented row like `ChoiceSeg`, but with a segment that
// can be greyed out on its own (From File, when the file states no range) and a hover that says why.
component RiSourceSeg inherits Rectangle {
    in property <[string]> labels;
    in property <[string]> reader_labels;
    // One flag and one hover text per segment (same length as `labels`).
    in property <[bool]> segment_enabled;
    in property <[string]> segment_hints;
    in property <int> picked;
    in property <bool> enabled: true;
    in property <string> group_label;
    callback selected(int);

    height: 32px;
    border-radius: 8px;
    background: Theme.bg-input;
    border-width: 1px;
    border-color: Theme.border-subtle;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: root.group_label;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for name[i] in root.labels: Rectangle {
            property <bool> live: root.enabled && (i < root.segment_enabled.length ? root.segment_enabled[i] : true);
            horizontal-stretch: 1;
            min-width: 0px;
            border-radius: 7px;
            background: i == root.picked ? Theme.bg-elevated : ((touch.has-hover && self.live) ? Theme.bg-card-hover : transparent);
            border-width: fs.has-focus ? 2px : 0px;
            border-color: Theme.accent-cyan-hover;
            accessible-role: AccessibleRole.radio-button;
            accessible-label: i < root.reader_labels.length ? root.reader_labels[i] : name;
            accessible-description: i < root.segment_hints.length ? root.segment_hints[i] : "";
            accessible-checkable: true;
            accessible-checked: i == root.picked;
            accessible-enabled: self.live;
            accessible-action-default => {
                if self.live {
                    root.selected(i);
                }
            }
            if i < root.segment_hints.length && root.segment_hints[i] != "": Tooltip {
                text: @markdown("\{root.segment_hints[i]}");
            }
            fs := FocusScope {
                enabled: root.enabled && (i < root.segment_enabled.length ? root.segment_enabled[i] : true);
                key-pressed(event) => {
                    if event.text == Key.Space || event.text == Key.Return {
                        root.selected(i);
                        return accept;
                    }
                    return reject;
                }
            }
            Text {
                text: name;
                font-size: 12px;
                font-weight: i == root.picked ? 700 : 500;
                color: !parent.live ? Theme.text-disabled : (i == root.picked ? Theme.text-primary : Theme.text-secondary);
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            touch := TouchArea {
                enabled: root.enabled && (i < root.segment_enabled.length ? root.segment_enabled[i] : true);
                mouse-cursor: pointer;
                clicked => { root.selected(i); }
            }
        }
    }
}

// A printed proportion as a toggle chip. Off, it is a chip with its name; on (a value is typed, or
// the chip was pressed), a field for the value follows. Blanking a value and leaving the field turns
// the chip off again; blank means not typed.
component PrintedChip inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> text;
    in property <string> reader_label;
    in property <bool> enabled: true;
    callback commit();
    callback escaped();

    property <bool> opened: false;
    property <bool> on: root.text != "" || root.opened;
    spacing: 4px;
    Rectangle {
        width: chip_txt.preferred-width + 20px;
        height: 28px;
        border-radius: 14px;
        background: root.on ? Theme.accent-cyan-surface : Theme.bg-input;
        border-width: chip_focus.has-focus ? 2px : 1px;
        border-color: chip_focus.has-focus ? Theme.accent-cyan-hover : (root.on ? Theme.accent-cyan : Theme.border-subtle);
        accessible-role: AccessibleRole.checkbox;
        accessible-label: "Printed " + root.label;
        accessible-description: "Press to type this printed proportion; it is on while it has a value.";
        accessible-checkable: true;
        accessible-checked: root.on;
        accessible-enabled: root.enabled;
        accessible-action-default => { root.opened = !root.opened; }
        chip_focus := FocusScope {
            enabled: root.enabled;
            key-pressed(event) => {
                if event.text == Key.Space || event.text == Key.Return {
                    root.opened = !root.opened;
                    return accept;
                }
                return reject;
            }
        }
        chip_txt := Text {
            x: 10px;
            height: parent.height;
            text: root.label;
            font-size: 11px;
            font-weight: 600;
            color: root.on ? Theme.accent-cyan : Theme.text-secondary;
            vertical-alignment: center;
        }
        TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                if root.on && root.text != "" {
                    // Already holding a value: the chip stays on; the field is the way to change it.
                    root.opened = true;
                } else {
                    root.opened = !root.opened;
                }
            }
        }
    }
    if root.on: SheetField {
        width: 70px;
        enabled: root.enabled;
        text <=> root.text;
        placeholder: root.label;
        reader_label: root.reader_label;
        commit => {
            root.commit();
            if root.text == "" {
                root.opened = false;
            }
        }
        escaped => { root.escaped(); }
    }
}

// The Edit sub-tab's design settings. The panel itself is one line: the design's gear, symmetry,
// reference angle and material, and an "Edit..." button that opens the Design sheet (a popup with
// the gear, symmetry, material, title, header, footnote and printed proportions). The sheet has no
// Apply buttons (Fable E1/E2):
//
// - the gear and the symmetry are segments. A change keeps a confirm step that states what it does:
//   a gear change opens `GearRemapDialog` (the remap of every index, in red where it loses precision)
//   and the sheet steps aside; a symmetry change shows the effect in the sheet (how many tiers would
//   become incomplete orbits) with Apply Symmetry and Cancel;
// - every other field applies on Enter or when it is left, as one undo step. The X button keeps what
//   the open field holds and closes the sheet; Esc drops the open edit and closes it;
// - the printed proportions are toggle chips.
//
// The Simple interface (`GuideModel.shows_advanced()` false) keeps the gear, the material and the
// title. It hides the symmetry order and Mirror, the extra header lines, the footnotes, the gear
// reference angle and the printed proportions. A hidden field keeps its value and still applies. The
// note at the bottom says so when one is off its default (`DesignSettingsModel.advanced_in_use`).
export component EditorDesignSettings inherits Rectangle {
    background: Theme.bg-darkest;
    border-radius: Theme.radius-sm;
    // The worked-example guide's outline while a step targets this panel
    // (`GuideModel.highlight_target == "design_settings"`).
    property <bool> guide_highlighted: GuideModel.highlight_target == "design_settings";
    border-width: root.guide_highlighted ? 2px : 1px;
    border-color: root.guide_highlighted ? Theme.accent-cyan : Theme.border-subtle;
    clip: false;
    // Zero stretch, so spare dock height goes to the tier table instead of inflating the panel.
    vertical-stretch: 0;
    min-height: 48px;
    preferred-height: 48px;
    max-height: 48px;

    // `false` while the worked-example guide locks this panel (`GuideAllow.design_settings`): every
    // field and segment below ANDs it into its own `enabled:`, and the `GuideLockTip` at the end of
    // this component explains why on hover.
    property <bool> unlocked: GuideModel.allows_design_settings();

    // Whether the Advanced controls show: the Advanced interface, or a guide step that needs them.
    property <bool> advanced: GuideModel.shows_advanced();
    // The Simple interface hides some fields that are off their default: say so.
    property <bool> advanced_note_visible: !root.advanced && DesignSettingsModel.advanced_in_use(
        "",
        EditorModel.design_extra_headers,
        EditorModel.design_footnotes,
        EditorModel.design_gear_reference_angle,
        EditorModel.printed_vol_w3_text + EditorModel.printed_lw_text + EditorModel.printed_cw_text
            + EditorModel.printed_pw_text + EditorModel.printed_hw_text,
        EditorModel.mirror);

    // The gear's tooth count, for the summary: the combo's gears, or the typed one.
    property <string> gear_text: EditorModel.gear_index == 0 ? "96"
        : (EditorModel.gear_index == 1 ? "80"
        : (EditorModel.gear_index == 2 ? "77"
        : (EditorModel.gear_index == 3 ? "72"
        : (EditorModel.gear_index == 4 ? "64"
        : (EditorModel.gear_index == 5 ? "120" : EditorModel.gear_custom_text)))));
    property <string> material_label: (EditorModel.material_combo_index >= 0 && EditorModel.material_combo_index < EditorModel.material_combo_options.length)
        ? EditorModel.material_combo_options[EditorModel.material_combo_index]
        : "";
    property <string> summary: root.gear_text + " gear"
        + (root.advanced ? " \u{b7} " + EditorModel.symmetry_order_text + "-fold" + (EditorModel.mirror ? " mirror" : "") : "")
        + (root.advanced ? " \u{b7} ref " + EditorModel.design_gear_reference_angle + "\u{b0}" : "")
        + (root.material_label != "" ? " \u{b7} " + root.material_label + (EditorModel.effective_ri_text != "" ? " RI " + EditorModel.effective_ri_text : "") : "");

    // --- What the sheet last applied, for Esc and for X ----------------------------------------
    // Snapshots taken when the sheet opens and after every apply. Esc puts them back; apply compares
    // with them, so an unchanged field applies nothing and spends no undo step.
    property <string> a_title;
    property <string> a_extra;
    property <string> a_foot;
    property <string> a_ref;
    property <string> a_vol;
    property <string> a_lw;
    property <string> a_cw;
    property <string> a_pw;
    property <string> a_hw;
    // A symmetry change waiting for its confirm: the values the design has, to restore on Cancel.
    property <bool> symmetry_pending: false;
    property <string> saved_order;
    property <bool> saved_mirror;
    // The "Other" gear and symmetry entries open their own field.
    property <bool> gear_other: EditorModel.gear_index == 6;
    property <bool> order_other: false;

    function take_snapshots() {
        root.a_title = EditorModel.design_title;
        root.a_extra = EditorModel.design_extra_headers;
        root.a_foot = EditorModel.design_footnotes;
        root.a_ref = EditorModel.design_gear_reference_angle;
        root.a_vol = EditorModel.printed_vol_w3_text;
        root.a_lw = EditorModel.printed_lw_text;
        root.a_cw = EditorModel.printed_cw_text;
        root.a_pw = EditorModel.printed_pw_text;
        root.a_hw = EditorModel.printed_hw_text;
    }
    function apply_meta() {
        if root.unlocked && (EditorModel.design_title != root.a_title || EditorModel.design_extra_headers != root.a_extra
            || EditorModel.design_footnotes != root.a_foot || EditorModel.design_gear_reference_angle != root.a_ref) {
            root.a_title = EditorModel.design_title;
            root.a_extra = EditorModel.design_extra_headers;
            root.a_foot = EditorModel.design_footnotes;
            root.a_ref = EditorModel.design_gear_reference_angle;
            EditorModel.apply_design_meta(EditorModel.design_title, EditorModel.design_extra_headers, EditorModel.design_footnotes, EditorModel.design_gear_reference_angle);
        }
    }
    function apply_printed() {
        if root.unlocked && (EditorModel.printed_vol_w3_text != root.a_vol || EditorModel.printed_lw_text != root.a_lw
            || EditorModel.printed_cw_text != root.a_cw || EditorModel.printed_pw_text != root.a_pw
            || EditorModel.printed_hw_text != root.a_hw) {
            root.a_vol = EditorModel.printed_vol_w3_text;
            root.a_lw = EditorModel.printed_lw_text;
            root.a_cw = EditorModel.printed_cw_text;
            root.a_pw = EditorModel.printed_pw_text;
            root.a_hw = EditorModel.printed_hw_text;
            EditorModel.apply_printed_proportions(
                EditorModel.printed_vol_w3_text,
                EditorModel.printed_lw_text,
                EditorModel.printed_cw_text,
                EditorModel.printed_pw_text,
                EditorModel.printed_hw_text
            );
        }
    }
    // Esc: the open edit goes back to what was applied. Nothing else differs, since every other
    // field applied when it was left.
    function discard_edits() {
        EditorModel.design_title = root.a_title;
        EditorModel.design_extra_headers = root.a_extra;
        EditorModel.design_footnotes = root.a_foot;
        EditorModel.design_gear_reference_angle = root.a_ref;
        EditorModel.printed_vol_w3_text = root.a_vol;
        EditorModel.printed_lw_text = root.a_lw;
        EditorModel.printed_cw_text = root.a_cw;
        EditorModel.printed_pw_text = root.a_pw;
        EditorModel.printed_hw_text = root.a_hw;
        // The RI range boxes go back to what the design stores.
        RiFieldModel.refresh_requested();
        root.cancel_symmetry();
    }
    // X: keeps what the open field holds.
    function commit_all() {
        root.apply_meta();
        root.apply_printed();
    }
    public function open_sheet() {
        root.take_snapshots();
        root.symmetry_pending = false;
        root.order_other = false;
        RiFieldModel.refresh_requested();
        sheet.show();
    }
    function close_sheet() {
        sheet.close();
    }

    // --- Symmetry: a change waits for its confirm ----------------------------------------------
    function start_symmetry(order_text: string, mirror: bool) {
        if !root.symmetry_pending {
            root.saved_order = EditorModel.symmetry_order_text;
            root.saved_mirror = EditorModel.mirror;
        }
        root.symmetry_pending = true;
        EditorModel.symmetry_order_text = order_text;
        EditorModel.mirror = mirror;
        EditorModel.request_symmetry_preview(order_text, mirror);
    }
    function confirm_symmetry() {
        EditorModel.apply_symmetry(EditorModel.symmetry_order_text, EditorModel.mirror);
        root.symmetry_pending = false;
    }
    function cancel_symmetry() {
        if root.symmetry_pending {
            EditorModel.symmetry_order_text = root.saved_order;
            EditorModel.mirror = root.saved_mirror;
            EditorModel.request_symmetry_preview(root.saved_order, root.saved_mirror);
            root.symmetry_pending = false;
        }
    }
    // The segment of the symmetry order shown as picked: 0..5 for 1, 2, 3, 4, 6, 8; 6 for any other.
    property <float> order_value: EditorModel.symmetry_order_text.to-float();
    property <int> order_picked: root.order_other ? 6
        : (root.order_value == 1 ? 0 : (root.order_value == 2 ? 1 : (root.order_value == 3 ? 2
        : (root.order_value == 4 ? 3 : (root.order_value == 6 ? 4 : (root.order_value == 8 ? 5 : 6))))));

    // `form_reset_pulse` (`ui/models/editor.slint`) bumps on New/Load Selected/Open -- a different
    // design underneath these fields, where a leftover pending change would mislead.
    property <int> tracked_form_reset_pulse: EditorModel.form_reset_pulse;
    changed tracked_form_reset_pulse => {
        root.symmetry_pending = false;
        root.take_snapshots();
        RiFieldModel.refresh_requested();
    }

    // The panel: one line.
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 10px;
        Text {
            text: "Design";
            font-size: 13px;
            font-weight: 700;
            color: Theme.text-primary;
            vertical-alignment: center;
            accessible-role: AccessibleRole.text;
        }
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.summary;
            font-size: 11px;
            color: Theme.text-muted;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: AccessibleRole.text;
            accessible-label: "Design settings: " + root.summary;
        }
        VerticalLayout {
            alignment: center;
            TipButton {
                text: "Edit...";
                reader_label: "Edit Design Settings";
                hint: "Open the Design sheet: index gear, symmetry, material, title, header lines\nand the printed proportions. Each field applies when you press Enter or leave it.";
                clicked => { root.open_sheet(); }
            }
        }
        VerticalLayout {
            alignment: center;
            HelpButton {
                topic: HelpTopics.design-settings;
                hint: "Open the manual page on the design settings";
            }
        }
    }

    sheet := PopupWindow {
        x: min(0px, root.width - 500px);
        y: root.height + 4px;
        width: 500px;
        height: min(sheet_body.preferred-height + 24px, 640px);
        close-policy: no-auto-close;
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: Theme.surface-dialog;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border-dialog;
            accessible-role: AccessibleRole.groupbox;
            accessible-label: "Design";
            accessible-description: "Index gear, symmetry, material, title, header and the printed proportions. Fields apply on Enter or when left. Escape drops the open edit.";
            sheet_keys := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.discard_edits();
                        root.close_sheet();
                        return accept;
                    }
                    reject
                }
                ScrollView {
                    width: parent.width;
                    height: parent.height;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    sheet_body := VerticalLayout {
                        padding: 16px;
                        padding-right: 22px;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                horizontal-stretch: 1;
                                text: "Design";
                                font-size: 16px;
                                font-weight: 700;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                                accessible-role: AccessibleRole.text;
                            }
                            // X keeps what the open field holds (it applies as the field is left).
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 8px;
                                background: x_touch.has-hover ? Theme.bg-card-hover : transparent;
                                border-width: x_focus.has-focus ? 2px : 0px;
                                border-color: Theme.accent-cyan-hover;
                                accessible-role: AccessibleRole.button;
                                accessible-label: "Close Design Settings";
                                accessible-description: "Keeps what the open field holds and closes the sheet. Escape drops the open edit instead.";
                                accessible-action-default => { root.commit_all(); root.close_sheet(); }
                                Tooltip { text: @markdown("Close the sheet and keep what you typed. Esc drops the open edit."); }
                                x_focus := FocusScope {
                                    key-pressed(event) => {
                                        if event.text == Key.Space || event.text == Key.Return {
                                            root.commit_all();
                                            root.close_sheet();
                                            return accept;
                                        }
                                        return reject;
                                    }
                                }
                                KitIcon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    d: KitIcons.close;
                                    ink: Theme.text-secondary;
                                }
                                x_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.commit_all(); root.close_sheet(); }
                                }
                            }
                        }

                        SheetCaption { text: "SYMMETRY"; }
                        // The index gear. A pick asks for confirmation in `GearRemapDialog`, which
                        // shows how every index is renumbered, so the sheet steps aside for it.
                        SheetRow {
                            label: "Index gear";
                            ChoiceSeg {
                                horizontal-stretch: 1;
                                enabled: root.unlocked;
                                group_label: "Index Gear";
                                hint: "The number of teeth on the faceting machine's index wheel (96 is the usual).\nChanging it asks you to confirm first, because every index position is renumbered;\na gear that is not a multiple of the old one loses some precision, shown in red\nbefore you confirm. See the glossary.";
                                labels: ["64", "72", "77", "80", "96", "120", "Other"];
                                picked: [4, 3, 2, 1, 0, 5, 6][EditorModel.gear_index];
                                selected(i) => {
                                    EditorModel.gear_index = [4, 3, 2, 1, 0, 5, 6][i];
                                    if i < 6 {
                                        root.close_sheet();
                                        EditorModel.gear_apply(EditorModel.gear_index, EditorModel.gear_custom_text);
                                    }
                                }
                            }
                        }
                        if root.gear_other: SheetRow {
                            label: "Teeth";
                            SheetField {
                                horizontal-stretch: 1;
                                enabled: root.unlocked;
                                text <=> EditorModel.gear_custom_text;
                                placeholder: "teeth of your gear";
                                reader_label: "Custom Gear Teeth";
                                hint: "The tooth count of a gear that is not in the list. Press Enter to change the gear;\na window then asks you to confirm.";
                                commit => {
                                    root.close_sheet();
                                    EditorModel.gear_apply(6, EditorModel.gear_custom_text);
                                }
                                escaped => { root.discard_edits(); root.close_sheet(); }
                            }
                        }
                        // Symmetry and Mirror are advanced; the Simple interface leaves them out.
                        if root.advanced: SheetRow {
                            label: "Symmetry";
                            ChoiceSeg {
                                horizontal-stretch: 1;
                                enabled: root.unlocked;
                                group_label: "Symmetry Order";
                                hint: "How many times the facet pattern repeats around the stone (8 for a standard\nround brilliant). A change shows what it would do before you apply it.";
                                labels: ["1", "2", "3", "4", "6", "8", "Other"];
                                picked: root.order_picked;
                                selected(i) => {
                                    if i == 6 {
                                        root.order_other = true;
                                    } else {
                                        root.order_other = false;
                                        root.start_symmetry(["1", "2", "3", "4", "6", "8"][i], EditorModel.mirror);
                                    }
                                }
                            }
                            Text {
                                text: "-fold";
                                font-size: 11px;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }
                        }
                        if root.advanced && root.order_picked == 6: SheetRow {
                            label: "Order";
                            SheetField {
                                horizontal-stretch: 1;
                                enabled: root.unlocked;
                                text <=> EditorModel.symmetry_order_text;
                                placeholder: "whole number";
                                reader_label: "Symmetry Order";
                                hint: "How many times the pattern repeats around the stone. Press Enter to review the change.";
                                commit => { root.start_symmetry(EditorModel.symmetry_order_text, EditorModel.mirror); }
                                escaped => { root.discard_edits(); root.close_sheet(); }
                            }
                        }
                        if root.advanced: KitSwitchRow {
                            label: "Mirror";
                            on: EditorModel.mirror;
                            enabled: root.unlocked;
                            toggled => { root.start_symmetry(EditorModel.symmetry_order_text, !EditorModel.mirror); }
                        }
                        // The confirm step of a symmetry change: what it does, then Apply or Cancel.
                        if root.advanced && root.symmetry_pending: Rectangle {
                            background: Theme.surface-warning;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.accent-amber;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;
                                Text {
                                    text: EditorModel.symmetry_order_text + "-fold" + (EditorModel.mirror ? " with a mirror" : "")
                                        + ": " + (EditorModel.symmetry_preview_text != "" ? EditorModel.symmetry_preview_text : "this changes the pattern the schedule repeats.");
                                    font-size: 12px;
                                    color: Theme.text-primary;
                                    wrap: word-wrap;
                                    accessible-role: AccessibleRole.text;
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    TipButton {
                                        enabled: root.unlocked;
                                        text: "Apply Symmetry";
                                        reader_label: "Apply Symmetry";
                                        primary: true;
                                        hint: "Use the symmetry order and Mirror setting shown. It is one step you can undo.\nTiers whose pattern would be left incomplete are counted above.";
                                        clicked => { root.confirm_symmetry(); }
                                    }
                                    TipButton {
                                        text: "Cancel";
                                        reader_label: "Cancel Symmetry Change";
                                        hint: "Keep the design's symmetry and change nothing.";
                                        clicked => { root.cancel_symmetry(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }
                        if root.advanced: SheetRow {
                            label: "Ref. angle";
                            SheetField {
                                width: 90px;
                                enabled: root.unlocked;
                                text <=> EditorModel.design_gear_reference_angle;
                                placeholder: "0";
                                reader_label: "Gear Reference Angle in Degrees";
                                hint: "Where the index wheel's zero tooth points, in degrees around the stone. Leave it\nat 0 unless your machine's wheel is set differently. The 3D handles and the\ndiagram follow it.";
                                commit => { root.apply_meta(); }
                                escaped => { root.discard_edits(); root.close_sheet(); }
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: "where index 0 points";
                                font-size: 11px;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle { height: 1px; background: Theme.border-subtle; }
                        SheetCaption { text: "MATERIAL"; }
                        HorizontalLayout {
                            spacing: 10px;
                            material-chip-l136 := MaterialChip {
                                show_ri: true;
                                row_height: 28px;
                                hint: "The design's material. Press to edit it in the Stone tab.";
                            }
                            if ViewportModel.previewing: PreviewBadge {
                                compact: true;
                                row_height: 28px;
                            }
                            VerticalLayout {
                                alignment: center;
                                TipButton {
                                    text: "Edit in Stone Tab";
                                    hint: "Open the Stone tab to change the material, refractive\nindex, body color, size and render effects.";
                                    clicked => {
                                        root.close_sheet();
                                        ParametersModel.show_tab(0);
                                    }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        // The RI range the cutting sheet prints: off, the one the file states, the
                        // Pleochroma estimate (traced when the sheet is written), or your own.
                        VerticalLayout {
                            spacing: 6px;
                            SheetRow {
                                label: "RI range";
                                RiSourceSeg {
                                    horizontal-stretch: 1;
                                    enabled: root.unlocked;
                                    labels: ["Off", "From File", "Estimate", "Type"];
                                    reader_labels: ["RI Range Off", "RI Range From File", "RI Range Pleochroma Estimate", "RI Range Typed by Hand"];
                                    segment_enabled: [true, RiFieldModel.file_states_range, true, true];
                                    segment_hints: [
                                        "The cutting sheet prints the design's own index, with no range.",
                                        RiFieldModel.file_states_range ? "The range the designer stated in the file." : "This design's file states no RI range.",
                                        "Pleochroma traces the range at this design's angles when the sheet is written.",
                                        "Type the range yourself."
                                    ];
                                    picked: RiFieldModel.source_index;
                                    group_label: "RI Range Source";
                                    selected(index) => { RiFieldModel.source_chosen(index); }
                                }
                            }
                            if RiFieldModel.source_index == 3: SheetRow {
                                label: "";
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: "Lowest RI";
                                        font-size: 10px;
                                        color: Theme.text-muted;
                                        accessible-role: AccessibleRole.text;
                                    }
                                    SheetField {
                                        enabled: root.unlocked;
                                        text <=> RiFieldModel.typed_low;
                                        placeholder: "1.63";
                                        reader_label: "Lowest RI";
                                        hint: "The lowest refractive index the design works in, as you state it. It is printed plain on the cutting sheet.";
                                        commit => { RiFieldModel.typed_edited(); }
                                        escaped => { root.discard_edits(); root.close_sheet(); }
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: "Highest RI (optional)";
                                        font-size: 10px;
                                        color: Theme.text-muted;
                                        accessible-role: AccessibleRole.text;
                                    }
                                    SheetField {
                                        enabled: root.unlocked;
                                        text <=> RiFieldModel.typed_high;
                                        placeholder: "and up";
                                        reader_label: "Highest RI, optional";
                                        hint: "The highest refractive index the design works in. Leave it empty for a range that reads \"and up\".";
                                        commit => { RiFieldModel.typed_edited(); }
                                        escaped => { root.discard_edits(); root.close_sheet(); }
                                    }
                                }
                            }
                            Text {
                                text: RiFieldModel.source_index == 0 ? "Off: the cutting sheet prints the design's own index, with no range."
                                    : (RiFieldModel.source_index == 1 ? "The range the designer stated in the file (.gcs ri_min / ri_max, or the design file). Printed as stated."
                                    : (RiFieldModel.source_index == 2 ? "Pleochroma estimate: traced at this design's angles, table up and tilted by 10\u{b0}. Not test-cut. The sheet says so on the row."
                                    : "Your own statement: printed plain, without a label."));
                                font-size: 10px;
                                color: Theme.text-muted;
                                wrap: word-wrap;
                                accessible-role: AccessibleRole.text;
                            }
                            if RiFieldModel.error != "": Text {
                                text: RiFieldModel.error;
                                font-size: 11px;
                                color: Theme.danger;
                                wrap: word-wrap;
                                accessible-role: AccessibleRole.text;
                            }
                            // What the cutting sheet's "RI range" row prints now.
                            Rectangle {
                                border-radius: 6px;
                                background: Theme.bg-input;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                accessible-role: AccessibleRole.text;
                                accessible-label: "RI range on the cutting sheet: " + RiFieldModel.preview;
                                HorizontalLayout {
                                    padding: 8px;
                                    spacing: 10px;
                                    Text {
                                        text: "RI range";
                                        font-size: 11px;
                                        color: Theme.text-muted;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        text: RiFieldModel.preview;
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Text {
                                text: "Saved in the design. The next cutting sheet prints this choice.";
                                font-size: 10px;
                                color: Theme.text-muted;
                                wrap: word-wrap;
                                accessible-role: AccessibleRole.text;
                            }
                        }

                        Rectangle { height: 1px; background: Theme.border-subtle; }
                        SheetCaption { text: "PRINTED ON THE DIAGRAM"; }
                        SheetRow {
                            label: "Title";
                            SheetField {
                                horizontal-stretch: 1;
                                enabled: root.unlocked;
                                text <=> EditorModel.design_title;
                                reader_label: "Design Title";
                                hint: "The design's name: the first header line of the .asc file. It is the window\ntitle and the default name of a saved or exported file.";
                                commit => { root.apply_meta(); }
                                escaped => { root.discard_edits(); root.close_sheet(); }
                            }
                        }
                        if root.advanced: SheetRow {
                            label: "Header";
                            SheetField {
                                horizontal-stretch: 1;
                                enabled: root.unlocked;
                                text <=> EditorModel.design_extra_headers;
                                reader_label: "Extra Header Lines";
                                hint: "More header lines for the .asc file after the title, such as the designer or a\ndate. Separate several with \"; \".";
                                commit => { root.apply_meta(); }
                                escaped => { root.discard_edits(); root.close_sheet(); }
                            }
                        }
                        if root.advanced: SheetRow {
                            label: "Footnote";
                            SheetField {
                                horizontal-stretch: 1;
                                enabled: root.unlocked;
                                text <=> EditorModel.design_footnotes;
                                reader_label: "Footnotes";
                                hint: "Note lines written at the end of the .asc file. Separate several with \"; \".";
                                commit => { root.apply_meta(); }
                                escaped => { root.discard_edits(); root.close_sheet(); }
                            }
                        }
                        // Printed proportions (Vol/W^3, L/W, C/W, P/W, H/W, as on a GemCad sheet): Deep
                        // Solve checks against them for designs with no measured values. Advanced only.
                        if root.advanced: VerticalLayout {
                            spacing: 6px;
                            SheetRow {
                                label: "Proportions";
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 6px;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        PrintedChip {
                                            label: "Vol/W\u{b3}";
                                            reader_label: "Printed Volume over Width Cubed";
                                            enabled: root.unlocked;
                                            text <=> EditorModel.printed_vol_w3_text;
                                            commit => { root.apply_printed(); }
                                            escaped => { root.discard_edits(); root.close_sheet(); }
                                        }
                                        PrintedChip {
                                            label: "L/W";
                                            reader_label: "Printed Length over Width";
                                            enabled: root.unlocked;
                                            text <=> EditorModel.printed_lw_text;
                                            commit => { root.apply_printed(); }
                                            escaped => { root.discard_edits(); root.close_sheet(); }
                                        }
                                        PrintedChip {
                                            label: "C/W";
                                            reader_label: "Printed Crown Height over Width";
                                            enabled: root.unlocked;
                                            text <=> EditorModel.printed_cw_text;
                                            commit => { root.apply_printed(); }
                                            escaped => { root.discard_edits(); root.close_sheet(); }
                                        }
                                        PrintedChip {
                                            label: "P/W";
                                            reader_label: "Printed Pavilion Height over Width";
                                            enabled: root.unlocked;
                                            text <=> EditorModel.printed_pw_text;
                                            commit => { root.apply_printed(); }
                                            escaped => { root.discard_edits(); root.close_sheet(); }
                                        }
                                        PrintedChip {
                                            label: "H/W";
                                            reader_label: "Printed Total Height over Width";
                                            enabled: root.unlocked;
                                            text <=> EditorModel.printed_hw_text;
                                            commit => { root.apply_printed(); }
                                            escaped => { root.discard_edits(); root.close_sheet(); }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                            }
                        }
                        if root.advanced_note_visible: AdvancedNote { }
                        Text {
                            text: "Each field applies when you press Enter or leave it, as one step you can undo. X keeps the open field; Esc drops it.";
                            font-size: 10px;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                            accessible-role: AccessibleRole.text;
                        }
                    }
                }
            }
        }
    }

    GuideLockTip { locked: !root.unlocked; }
}

// The gear-remap confirmation, a real modal mounted by `app.slint` so it blocks
// like every other confirmation in this app (`RetargetDialog`/`NewDesignDialog`)
// and cannot be missed behind a collapsed "DESIGN" section or left open behind
// other work. The Rust side refuses a stale Confirm (it compares
// `EditorState::generation` against the value captured when the dialog opened).
// The Rounding selector lets a cutter keep indices deliberately placed on a
// half-tooth from being silently moved by Nearest; the Rust side recomputes the
// preview rows (and the count of rounded ones) on change, so the preview stays honest. The Simple interface
// leaves the Rounding selector out and keeps Nearest.
export component GearRemapDialog inherits Rectangle {
    visible: EditorModel.gear_remap_open;
    background: Theme.overlay-backdrop;
    // The Rounding selector's pick (0 Nearest, 1 Floor, 2 Ceil). The dialog is mounted afresh on
    // every opening and Rust starts each remap at Nearest, so it starts at 0 too.
    property <int> rounding_index: 0;
    // Whether the Rounding selector shows: latched true once the open dialog has had a rounded
    // row, so changing the rounding (which can bring the count to 0) never removes the selector
    // under the pointer. Reset when the dialog closes.
    property <bool> rounding_selector_latched: false;

    TouchArea {
        // Backdrop click cancels, matching `NewDesignDialog`'s own convention.
        clicked => { EditorModel.gear_remap_cancel(); }
    }

    // Same re-focus-on-every-open idiom `RetargetDialog`'s own `key_scope` uses
    // (`retarget_dialog.slint`) -- this component stays instantiated the whole
    // time (`visible`, not `if`), so a plain `init => { self.focus(); }` would
    // only ever fire once.
    key_scope := FocusScope {
        property <bool> open_mirror: EditorModel.gear_remap_open;
        property <int> rounded_mirror: EditorModel.gear_remap_rounded_count;
        changed open_mirror => {
            if self.open_mirror {
                self.focus();
                root.rounding_selector_latched = self.rounded_mirror > 0;
            } else {
                root.rounding_selector_latched = false;
            }
        }
        changed rounded_mirror => {
            if self.open_mirror && self.rounded_mirror > 0 {
                root.rounding_selector_latched = true;
            }
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                EditorModel.gear_remap_cancel();
                return accept;
            } else if event.text == Key.Return {
                EditorModel.gear_remap_confirm();
                return accept;
            } else if event.text == Key.Tab || event.text == Key.Backtab {
                // Tab walks the dialog's own buttons; every other key is swallowed so the
                // window's shortcuts do not act behind the modal.
                return reject;
            }
            accept
        }
    }

    Rectangle {
        width: min(560px, root.width - 40px);
        height: min(card.preferred-height, root.height - 40px);
        background: Theme.surface-dialog;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-dialog;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.modal-shadow;
        clip: true;
        accessible-role: AccessibleRole.groupbox;
        accessible-label: "Confirm Index Remap";
        accessible-description: "Every tier's indices are recomputed for the new gear. Confirm Remap applies it, Cancel keeps the old gear.";

        TouchArea {} // Isolate clicks inside the modal.

        card := VerticalLayout {
            padding: 16px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 6px;
                Text { text: "Confirm Index Remap"; font-size: 14px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    HelpButton {
                        topic: HelpTopics.design-settings;
                        hint: "Open the manual page on the design settings";
                    }
                }
            }
            Text {
                text: "Index gear " + EditorModel.gear_remap_from_gear + " → " + EditorModel.gear_remap_to_gear + " teeth";
                font-size: 11px;
                color: Theme.text-muted;
                accessible-role: AccessibleRole.text;
            }
            Text {
                text: "Every tier's indices are renumbered for the new gear. It is one step you can undo.";
                font-size: 11px;
                color: Theme.text-secondary;
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }

            // The table header and the rows share one geometry: a 64px Tier column, then the Now and
            // After columns split what is left. Children are placed by hand (not by a layout) so
            // every row's columns sit on the same x and a wrapped list's height is exact.
            HorizontalLayout {
                padding-right: 12px;
                Rectangle {
                    height: 14px;
                    Text { x: 0px; width: 64px; text: "Tier"; font-size: 10px; font-weight: 700; color: Theme.text-muted; accessible-role: AccessibleRole.text; }
                    Text { x: 74px; width: (parent.width - 94px) / 2; text: "Now (" + EditorModel.gear_remap_from_gear + ")"; font-size: 10px; font-weight: 700; color: Theme.text-muted; accessible-role: AccessibleRole.text; }
                    Text { x: 84px + (parent.width - 94px) / 2; width: (parent.width - 94px) / 2; text: "After (" + EditorModel.gear_remap_to_gear + ")"; font-size: 10px; font-weight: 700; color: Theme.text-muted; accessible-role: AccessibleRole.text; }
                }
            }
            Rectangle { height: 1px; background: Theme.border-subtle; }

            ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                min-height: 60px;
                preferred-height: min(rows.preferred-height, 260px);
                rows := VerticalLayout {
                    padding-right: 12px;
                    spacing: 0px;
                    for row in EditorModel.gear_remap_rows: VerticalLayout {
                        spacing: 0px;
                        accessible-role: AccessibleRole.text;
                        accessible-label: "Tier " + row.name + ": " + row.old_indices + " becomes " + row.new_indices + (row.non_integral ? ", rounded to a whole tooth" : "");
                        Rectangle {
                            height: max(tier_col.preferred-height, max(old_text.preferred-height, new_text.preferred-height)) + 10px;
                            tier_col := VerticalLayout {
                                x: 0px;
                                y: 5px;
                                width: 64px;
                                spacing: 3px;
                                alignment: start;
                                Text { text: row.name; font-size: 11px; font-weight: 700; color: Theme.text-primary; overflow: elide; }
                                if row.non_integral: Rectangle {
                                    height: badge_text.preferred-height + 2px;
                                    width: badge_text.preferred-width + 10px;
                                    background: Theme.accent-amber.with-alpha(0.16);
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: Theme.accent-amber;
                                    badge_text := Text { text: "Rounded"; font-size: 9px; font-weight: 600; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            old_text := Text { x: 74px; y: 5px; width: (parent.width - 94px) / 2; text: row.old_indices; font-size: 10px; color: Theme.text-secondary; wrap: word-wrap; }
                            new_text := Text { x: 84px + (parent.width - 94px) / 2; y: 5px; width: (parent.width - 94px) / 2; text: row.new_indices; font-size: 10px; color: Theme.text-primary; wrap: word-wrap; }
                        }
                        Rectangle { height: 1px; background: Theme.border-subtle; }
                    }
                }
            }

            // The legend and the Rounding selector: rounding only matters when a row is rounded.
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                if EditorModel.gear_remap_rounded_count > 0: Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    text: (EditorModel.gear_remap_rounded_count == 1 ? "1 tier falls" : EditorModel.gear_remap_rounded_count + " tiers fall")
                        + " between two teeth of the new gear; "
                        + (EditorModel.gear_remap_rounded_count == 1 ? "its indices are" : "their indices are")
                        + " rounded to the "
                        + (root.rounding_index == 1 ? "tooth below." : (root.rounding_index == 2 ? "tooth above." : "nearest tooth."));
                    font-size: 10px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                    accessible-role: AccessibleRole.text;
                }
                if GuideModel.shows_advanced() && (root.rounding_selector_latched || EditorModel.gear_remap_rounded_count > 0): HorizontalLayout {
                    spacing: 6px;
                    SettingLabel {
                        horizontal-stretch: 0;
                        width: 56px;
                        text: "Rounding";
                        hint: "How an index that does not land on a whole tooth of the\nnew gear is rounded: to the nearest tooth (the usual),\ndown, or up. Pick Floor or Ceil to keep a position you\nplaced on a half tooth from moving the other way.";
                    }
                    ComboBox {
                        width: 110px;
                        model: ["Nearest", "Floor", "Ceil"];
                        current-index: root.rounding_index;
                        accessible-label: "Rounding";
                        accessible-description: "How an index between two teeth is rounded in the new gear.";
                        selected(val) => {
                            root.rounding_index = val == "Nearest" ? 0 : (val == "Floor" ? 1 : 2);
                            EditorModel.gear_remap_set_rounding(root.rounding_index);
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                ActionButton {
                    width: 84px;
                    text: "Cancel";
                    hint: "Keep the old gear and change nothing.";
                    fill: Theme.surface-raised;
                    hover_fill: Theme.border-dialog;
                    ink: Theme.text-secondary;
                    edge: Theme.surface-raised;
                    clicked => { EditorModel.gear_remap_cancel(); }
                }
                ActionButton {
                    width: 120px;
                    text: "Confirm Remap";
                    hint: "Renumber every tier's indices for the new gear. It is one step you can undo.";
                    weight: 700;
                    fill: Theme.accent-cyan;
                    hover_fill: Theme.accent-cyan-hover;
                    ink: Theme.text-on-accent;
                    edge: Theme.accent-cyan;
                    clicked => { EditorModel.gear_remap_confirm(); }
                }
            }
        }
    }
}
