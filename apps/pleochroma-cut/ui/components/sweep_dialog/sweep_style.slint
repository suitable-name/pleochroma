// The colours of the Angle Sweep dialog's figures, shared by the pills, the chart lines and
// the table header so a figure looks the same everywhere.
import { Theme } from "../../theme.slint";

export global SweepStyle {
    // The colour of figure `series` (numbered like `pleochroma_editor::sweep::SweepMetric`:
    // 0 brilliance, 1 windowing, 2 extinction, 3 fire, 4 scintillation, 5 yield, 6..8 the
    // tilt averages, 9 Contrast, last so the older numbers keep their meaning). Brilliance, windowing and extinction
    // match the tilt graph.
    public pure function series_color(series: int) -> color {
        return series == 0 ? Theme.accent-cyan
            : series == 1 ? Theme.accent-amber
            : series == 2 ? Theme.chart-extinction
            : series == 3 ? Theme.accent-purple
            : series == 4 ? Theme.accent-emerald
            : series == 5 ? Theme.text-primary
            : series == 6 ? Theme.accent-cyan-hover
            : series == 7 ? Theme.notice-accent
            : series == 8 ? Theme.accent-ruby
            : Theme.text-secondary;
    }

    // Whether figure `series` is drawn dashed (Contrast, 9). It is the neutral light color,
    // not the old blue, because the blue sat too close to Fire's purple among ten thin lines;
    // the dash also keeps it apart from Yield's solid light line, and it survives
    // color-blindness. `present.rs` cuts the line into dashes; the legend chip shows one.
    public pure function series_dashed(series: int) -> bool {
        return series == 9;
    }
}
