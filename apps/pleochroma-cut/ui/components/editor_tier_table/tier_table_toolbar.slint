import { CheckBox, LineEdit } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { EditorModel } from "../../models/editor.slint";
import { GuideModel } from "../../models/guide.slint";
import { RelationModel } from "../../models/relation.slint";
import { TierTableModel } from "../../models/tier_table.slint";
import { HelpTopics } from "../../models/help.slint";
import { HelpButton } from "../help_button.slint";
import { CompactButton } from "../compact_controls.slint";
import { AdvancedNote } from "../advanced_note.slint";
import { KitIcon, KitIcons } from "../kit/icons.slint";
import { TierMenuSurface, TierMenuItem, TierMenuCaption, TierMenuSeparator } from "tier_menu_parts.slint";

// A small text field of the toolbar with a tooltip and a screen-reader label. Read its text
// through the id (`step_name.text`).
component TipField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    // One plain sentence: what to type here. Shown as the tooltip.
    in property <string> hint;
    // What a screen reader says for the field.
    in property <string> reader_label;
    callback accepted();

    height: 24px;
    Tooltip { text: @markdown("\{root.hint}"); }
    LineEdit {
        width: parent.width;
        height: parent.height;
        font-size: 10px;
        text <=> root.text;
        // The placeholder is drawn below at the typed text's 10 px size. A screen reader gets it
        // through `accessible-placeholder-text`.
        accessible-placeholder-text: root.placeholder;
        accessible-label: root.reader_label;
        accessible-description: root.hint;
        accepted => { root.accepted(); }
        changed has-focus => { EditorModel.text_focus = self.has-focus; }
    }
    // The hint in an empty field, at the typed text's size. It takes no clicks, so they reach the
    // field beneath. The 12 px is the field's own left padding.
    if root.text == "": Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder;
        font-size: 10px;
        color: Theme.text-muted;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
}

// "Add Tier" with a menu: the body adds a tier (opens the Tier form in Add mode); the chevron opens
// the menu of the other ways to add one. A split button, in the accent color.
component AddTierSplit inherits Rectangle {
    // The body's click: Add mode.
    callback add();
    // Menu picks.
    callback add_concave();
    callback add_table();
    callback add_girdle();
    callback add_culet();
    callback add_girdle_preset();

    property <bool> body_enabled: GuideModel.allows_tier_form();
    property <bool> quick_enabled: GuideModel.allows_tier_table();

    height: 28px;
    width: 126px;
    border-radius: 8px;
    background: Theme.accent-cyan;
    opacity: root.body_enabled ? 1.0 : 0.4;

    // The body: plus and text. Named "+ Add Tier" for a screen reader and the lesson routes.
    body := Rectangle {
        x: 0px;
        width: parent.width - 30px;
        height: parent.height;
        border-radius: 8px;
        background: (body_touch.has-hover && root.body_enabled) ? Theme.accent-cyan-hover : transparent;
        border-width: body_focus.has-focus ? 2px : 0px;
        border-color: Theme.text-on-accent;
        accessible-role: AccessibleRole.button;
        accessible-label: "+ Add Tier";
        accessible-description: root.body_enabled ? "Open the Tier tab in Add mode to author a new tier." : GuideModel.locked_hint;
        accessible-enabled: root.body_enabled;
        accessible-action-default => {
            if root.body_enabled {
                root.add();
            }
        }
        Tooltip { text: root.body_enabled ? @markdown("Open the Tier tab in Add mode to author a new tier.") : @markdown("\{GuideModel.locked_hint}"); }
        body_focus := FocusScope {
            enabled: root.body_enabled;
            key-pressed(event) => {
                if event.text == Key.Space || event.text == Key.Return {
                    root.add();
                    return accept;
                }
                return reject;
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                KitIcon { d: KitIcons.plus; size: 14px; ink: Theme.text-on-accent; stroke: 2.2px; }
            }
            Text {
                text: "Add Tier";
                font-size: 12px;
                font-weight: 700;
                color: Theme.text-on-accent;
                vertical-alignment: center;
            }
        }
        body_touch := TouchArea {
            enabled: root.body_enabled;
            mouse-cursor: pointer;
            clicked => { root.add(); }
        }
    }
    Rectangle {
        x: body.width;
        y: 6px;
        width: 1px;
        height: parent.height - 12px;
        background: Theme.text-on-accent;
        opacity: 0.35;
    }
    // The chevron: opens the menu.
    chevron := Rectangle {
        x: parent.width - 30px;
        width: 30px;
        height: parent.height;
        border-radius: 8px;
        background: chevron_touch.has-hover ? Theme.accent-cyan-hover : transparent;
        border-width: chevron_focus.has-focus ? 2px : 0px;
        border-color: Theme.text-on-accent;
        accessible-role: AccessibleRole.button;
        accessible-label: "More Ways to Add a Tier";
        accessible-description: "Tier, Concave Tier, Table, Girdle, Culet and the Girdle Facet Preset.";
        accessible-action-default => { add_menu.show(); }
        chevron_focus := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Space || event.text == Key.Return || event.text == Key.DownArrow {
                    add_menu.show();
                    return accept;
                }
                return reject;
            }
        }
        KitIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            d: KitIcons.chevron-down;
            size: 14px;
            ink: Theme.text-on-accent;
            stroke: 2.2px;
        }
        chevron_touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { add_menu.show(); }
        }
    }

    add_menu := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: 220px;
        height: 8px + 28px + 28px + 9px + 22px + 3 * 28px + 9px + 28px;
        close-policy: close-on-click-outside;
        TierMenuSurface {
            width: parent.width;
            height: parent.height;
            accessible-role: AccessibleRole.groupbox;
            accessible-label: "Add Tier Menu";
            VerticalLayout {
                padding: 4px;
                TierMenuItem {
                    text: "Tier";
                    label: "Add Tier";
                    hint: "Open the Tier tab in Add mode to author a new tier.";
                    enabled: root.body_enabled;
                    activated => { root.add(); add_menu.close(); }
                }
                TierMenuItem {
                    text: "Concave Tier";
                    label: "+ Add Concave Tier";
                    hint: GuideModel.allows_concave_tier() ? "Open the Tier tab in Add mode for a concave tier -- a facet cut with a\ntool (cylinder, cone, circle, disc or sphere) instead of a flat lap." : GuideModel.locked_hint;
                    enabled: GuideModel.allows_concave_tier();
                    activated => { root.add_concave(); add_menu.close(); }
                }
                TierMenuSeparator { }
                TierMenuCaption { text: "QUICK ADD"; }
                TierMenuItem {
                    text: "Table";
                    label: "Table";
                    hint: root.quick_enabled ? "Add a Table tier (0\u{b0}, pinned to an exact scale value) --\na starting anchor for the crown. See the glossary." : GuideModel.locked_hint;
                    enabled: root.quick_enabled && !EditorModel.tier_name_taken(EditorModel.tiers, "Table");
                    activated => { root.add_table(); add_menu.close(); }
                }
                TierMenuItem {
                    text: "Girdle";
                    label: "Girdle";
                    hint: root.quick_enabled ? "Add a Girdle tier (90\u{b0}, pinned to an exact scale value = half-width) --\n90\u{b0} is required for a real girdle band. See the glossary." : GuideModel.locked_hint;
                    enabled: root.quick_enabled && !EditorModel.tier_name_taken(EditorModel.tiers, "Girdle");
                    activated => { root.add_girdle(); add_menu.close(); }
                }
                TierMenuItem {
                    text: "Culet";
                    label: "Culet";
                    hint: root.quick_enabled ? "Add a Culet tier (a flat pavilion facet, pinned to an exact scale\nvalue) -- a starting anchor for the pavilion. See the glossary." : GuideModel.locked_hint;
                    enabled: root.quick_enabled && !EditorModel.tier_name_taken(EditorModel.tiers, "Culet");
                    activated => { root.add_culet(); add_menu.close(); }
                }
                TierMenuSeparator { }
                TierMenuItem {
                    text: "Girdle Facet Preset";
                    label: "Girdle Facet Preset (90\u{b0}, Scale = 1)";
                    hint: root.body_enabled ? "Open Add mode with a real girdle facet filled in: angle 90\u{b0} and\nMeets set to the exact scale value 1. Name and Indices stay as they are." : GuideModel.locked_hint;
                    enabled: root.body_enabled;
                    activated => { root.add_girdle_preset(); add_menu.close(); }
                }
            }
        }
    }
}

// `EditorTierTable`'s toolbar: the filter box with the list menu ("..."), the "Add Tier" split
// button, "Steps / Mirror" and its inline form, and the multi-select batch-action bar (shown only
// while more than one row is selected). The list menu holds Adopt All and Select. Quick Add (Table,
// Girdle, Culet) and the concave entry live in the Add Tier menu. Root is a plain `VerticalLayout`
// so it slots into `EditorTierTable`'s own `VerticalLayout`.
//
// While the worked-example guide runs, "Add Tier" follows `GuideModel.allows_tier_form()` and every
// other action here follows `allows_tier_table()`: a locked button is dimmed, ignores clicks and
// shows the guide's lock tooltip instead of its own (see `GuideAllow`, `models/guide.slint`).
//
// The Simple interface (`GuideModel.shows_advanced()`) leaves out the filter box, "Adopt All",
// "Steps / Mirror" and its form, and "Adopt Sel." in the multi-select bar; Select, Clear, Delete and
// Offset stay. A line says so when a tier is detached, since the Detach actions are hidden too.
export component TierTableToolbar inherits VerticalLayout {
    // Mirrored two-way with `EditorTierTable.select_mode`: the "Select" menu item toggles it, and
    // the tier list's rows read it (the tick-box column, and per-row multi-select toggling).
    in-out property <bool> select_mode: false;
    // Read-only here: "Mirror" applies to the tier the tier list's own keyboard cursor is on. The
    // multi-select "Offset" acts on the ticked group and only uses the cursor to pick its anchor.
    in property <int> keyboard_focus_index: -1;

    // Whether the "Generate steps..." inline form is open.
    property <bool> generate_steps_open: false;
    // The Steps form's "Keep linked" box: Generate then makes every tier after the first follow the
    // first (`RelationModel.generate_step_series_linked`).
    property <bool> keep_linked: false;
    property <bool> advanced: GuideModel.shows_advanced();

    // Lets `EditorTierTable.focus_filter()` (Ctrl+F) reach `filter_edit`. The field stays mounted
    // while the Simple interface hides it, and Ctrl+F then does nothing.
    public function focus_filter() {
        if root.advanced {
            filter_edit.focus();
        }
    }

    spacing: 6px;

    // Row one: the filter box and the list menu. Non-matching rows are DIMMED rather than removed,
    // so Up/Down/Home/End keep their arithmetic (keyed on `EditorModel.tiers.length`).
    HorizontalLayout {
        spacing: 6px;
        Rectangle {
            horizontal-stretch: 1;
            height: 30px;
            visible: root.advanced;
            background: Theme.bg-input;
            border-radius: 8px;
            border-width: 1px;
            border-color: filter_edit.has-focus ? Theme.accent-cyan : Theme.border-subtle;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 6px;
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../icons/search.svg");
                        colorize: Theme.text-muted;
                        width: 13px;
                        height: 13px;
                        image-fit: contain;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    filter_edit := LineEdit {
                        height: 24px;
                        min-width: 0px;
                        enabled: root.advanced;
                        text <=> EditorModel.tier_filter_text;
                        placeholder-text: "Filter tiers by name, index, block or strategy...";
                        font-size: 11px;
                        accessible-label: "Filter Tiers";
                        accessible-description: "Type part of a name, an index, a block or a strategy. Tiers that do not match are dimmed.";
                        changed has-focus => { EditorModel.text_focus = self.has-focus; }
                    }
                }
                if EditorModel.tier_filter_text != "": VerticalLayout {
                    alignment: center;
                    CompactButton {
                        height: 24px;
                        font_size: 11px;
                        width: 22px;
                        text: "x";
                        ink: Theme.text-muted;
                        hint: "Clear the filter.";
                        clicked => { EditorModel.tier_filter_text = ""; }
                    }
                }
            }
        }
        if !root.advanced: Rectangle { horizontal-stretch: 1; }
        // The list menu: actions on the whole list.
        list_menu_button := Rectangle {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            background: list_touch.has-hover ? Theme.bg-card-hover : Theme.bg-input;
            border-width: list_focus.has-focus ? 2px : 1px;
            border-color: list_focus.has-focus ? Theme.accent-cyan-hover : Theme.border-subtle;
            accessible-role: AccessibleRole.button;
            accessible-label: "Tier List Menu";
            accessible-description: "Adopt All and Select, which act on the whole list.";
            accessible-action-default => { list_menu.show(); }
            Tooltip { text: @markdown("Adopt All and Select: actions on the whole list."); }
            list_focus := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Space || event.text == Key.Return {
                        list_menu.show();
                        return accept;
                    }
                    return reject;
                }
            }
            KitIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                d: KitIcons.more;
                size: 16px;
                stroke: 2.4px;
                ink: Theme.text-secondary;
            }
            list_touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { list_menu.show(); }
            }
            list_menu := PopupWindow {
                x: parent.width - 200px;
                y: parent.height + 4px;
                width: 200px;
                height: 8px + (root.advanced ? 28px : 0px) + 28px;
                close-policy: close-on-click-outside;
                TierMenuSurface {
                    width: parent.width;
                    height: parent.height;
                    accessible-role: AccessibleRole.groupbox;
                    accessible-label: "Tier List Actions";
                    VerticalLayout {
                        padding: 4px;
                        // Bulk-adopts every tier that still has an unadopted imported meet, as one
                        // undoable step. A click with nothing to adopt is a harmless no-op in Rust.
                        if root.advanced: TierMenuItem {
                            text: "Adopt All";
                            label: "Adopt All";
                            hint: GuideModel.allows_tier_table() ? "Adopt every tier's imported meet at once, as one Undo step. See the glossary." : GuideModel.locked_hint;
                            enabled: GuideModel.allows_tier_table();
                            activated => { EditorModel.adopt_all(); list_menu.close(); }
                        }
                        // Shows the tick-box column, where a plain click adds or removes a row: the
                        // same group Ctrl+click and Shift+click build.
                        TierMenuItem {
                            text: "Select";
                            label: "Select";
                            hint: GuideModel.allows_tier_table() ? "Show a tick box column for choosing several tiers at once -- the\nsame group Ctrl+click and Shift+click build, without needing\nthe modifier key. From the keyboard, press Space on a row." : GuideModel.locked_hint;
                            enabled: GuideModel.allows_tier_table();
                            checked: root.select_mode;
                            activated => { root.select_mode = !root.select_mode; list_menu.close(); }
                        }
                    }
                }
            }
        }
    }

    // Row two: Add Tier, Steps / Mirror and the manual.
    HorizontalLayout {
        spacing: 6px;
        AddTierSplit {
            add => {
                EditorModel.selected_tier_index = -1;
                EditorModel.show_tier_form();
            }
            add_concave => { EditorModel.add_concave_tier(); }
            add_table => { EditorModel.save_tier(-1, "0", 2, "0.32", "Table", ""); }
            add_girdle => { EditorModel.save_tier(-1, "90", 2, "1", "Girdle", ""); }
            add_culet => { EditorModel.save_tier(-1, "-0", 2, "0.88", "Culet", ""); }
            add_girdle_preset => {
                EditorModel.girdle_preset_pending = true;
                EditorModel.selected_tier_index = -1;
                EditorModel.show_tier_form();
            }
        }
        // Toggles the "Generate steps..."/"Mirror to other block" panel below.
        if root.advanced: VerticalLayout {
            alignment: center;
            CompactButton {
                height: 28px;
                font_size: 11px;
                width: 100px;
                text: "Steps / Mirror";
                lit: root.generate_steps_open;
                checkable: true;
                hint: GuideModel.allows_tier_table() ? "Generate a step-cut ladder, or mirror the current tier to the opposite block." : GuideModel.locked_hint;
                enabled: GuideModel.allows_tier_table();
                clicked => { root.generate_steps_open = !root.generate_steps_open; }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            HelpButton {
                topic: HelpTopics.tier-table;
                hint: "Open the manual page on reading the tier table";
            }
        }
    }

    // The Simple interface hides the Detach action: say so while a tier is detached.
    if !root.advanced && TierTableModel.any_detached(EditorModel.tiers): HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        AdvancedNote { }
    }

    // The "Generate steps" ladder form and "Mirror to other block" buttons. Both call
    // `EditorModel`, which uses `ConstraintTier::step_series` and `mirrored_to_other_block`.
    if root.advanced && root.generate_steps_open: VerticalLayout {
        padding-left: 4px;
        padding-right: 4px;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 4px;
        Rectangle { height: 1px; background: Theme.border-subtle; }
        HorizontalLayout {
            spacing: 4px;
            step_name_edit := TipField {
                horizontal-stretch: 1;
                min-width: 64px;
                placeholder: "Step";
                hint: "The name for the ladder: the tiers are called\nStep1, Step2 and so on if you type Step.";
                reader_label: "Ladder Name";
            }
            step_start_edit := TipField {
                horizontal-stretch: 1;
                min-width: 64px;
                placeholder: "start\u{b0}";
                hint: "The angle of the first tier, in degrees. Blank is 0.";
                reader_label: "Start Angle in Degrees";
            }
            step_delta_edit := TipField {
                horizontal-stretch: 1;
                min-width: 64px;
                placeholder: "step\u{b0}";
                hint: "How much each tier's angle changes from the\none before it, in degrees. Blank is 0.";
                reader_label: "Step in Degrees";
            }
            step_count_edit := TipField {
                width: 44px;
                placeholder: "N";
                hint: "How many tiers to generate.";
                reader_label: "Number of Tiers";
            }
        }
        HorizontalLayout {
            spacing: 4px;
            step_indices_edit := TipField {
                horizontal-stretch: 1;
                min-width: 72px;
                placeholder: "indices";
                hint: "The index positions every generated tier uses, for example 96, 16, 32.";
                reader_label: "Index Positions";
            }
            step_anchor_edit := TipField {
                horizontal-stretch: 1;
                min-width: 64px;
                placeholder: "anchor";
                hint: "An exact scale value to pin the first tier to. Leave it blank to let\nthe first tier meet an existing anchor elsewhere in the design.";
                reader_label: "Anchor Scale Value";
            }
            CompactButton {
                height: 24px;
                font_size: 10px;
                width: 66px;
                text: "Generate";
                hint: GuideModel.allows_tier_table() ? "Generate N tiers named \"Step1\", \"Step2\", ... stepping by the given\nangle from the given start angle, all sharing the given indices. If\nAnchor is set, the first tier is pinned to that exact scale value;\notherwise it meets an existing anchor elsewhere in the design." : GuideModel.locked_hint;
                enabled: GuideModel.allows_tier_table();
                clicked => {
                    if step_name_edit.text != "" && step_count_edit.text != "" {
                        if root.keep_linked {
                            RelationModel.generate_step_series_linked(
                                step_name_edit.text,
                                step_start_edit.text == "" ? "0" : step_start_edit.text,
                                step_delta_edit.text == "" ? "0" : step_delta_edit.text,
                                Math.round(step_count_edit.text.to-float()),
                                step_indices_edit.text,
                                step_anchor_edit.text
                            );
                        } else {
                            EditorModel.generate_step_series(
                                step_name_edit.text,
                                step_start_edit.text == "" ? "0" : step_start_edit.text,
                                step_delta_edit.text == "" ? "0" : step_delta_edit.text,
                                Math.round(step_count_edit.text.to-float()),
                                step_indices_edit.text,
                                step_anchor_edit.text
                            );
                        }
                    }
                }
            }
        }
        // Makes the ladder follow its first tier: every later tier gets a relation, so editing the
        // first tier moves them all.
        HorizontalLayout {
            spacing: 4px;
            Rectangle {
                width: 110px;
                height: 24px;
                opacity: GuideModel.allows_tier_table() ? 1.0 : 0.4;
                Tooltip { text: GuideModel.allows_tier_table() ? @markdown("Later changes to the first tier move the\nothers by the same steps. See the glossary.") : @markdown("\{GuideModel.locked_hint}"); }
                CheckBox {
                    text: "Keep Linked";
                    enabled: GuideModel.allows_tier_table();
                    checked <=> root.keep_linked;
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 4px;
            Text { text: "Mirror Current Tier ("; font-size: 10px; color: Theme.text-muted; vertical-alignment: center; accessible-role: AccessibleRole.text; }
            mirror_suffix_edit := TipField {
                width: 44px;
                text: "'";
                hint: "The text added to the mirrored tier's name,\nso it does not clash with the original.";
                reader_label: "Name Suffix for the Mirrored Tier";
            }
            Text { text: ") to Other Block:"; font-size: 10px; color: Theme.text-muted; vertical-alignment: center; accessible-role: AccessibleRole.text; }
            CompactButton {
                height: 24px;
                font_size: 10px;
                width: 60px;
                text: "Mirror";
                hint: GuideModel.allows_tier_table() ? "Duplicates the currently selected/cursor tier to the\nopposite block (angle negated), suffixing its name." : GuideModel.locked_hint;
                enabled: root.keyboard_focus_index >= 0 && GuideModel.allows_tier_table();
                clicked => {
                    EditorModel.mirror_tier_to_other_block(root.keyboard_focus_index, mirror_suffix_edit.text);
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    // The "N selected" indicator and the batch actions, shown only while more than one row is
    // selected.
    if EditorModel.multi_selected_count > 1: HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 6px;
        Rectangle {
            width: 84px;
            height: 24px;
            background: Theme.bg-card-hover;
            border-radius: 3px;
            Text {
                text: EditorModel.multi_selected_count + " selected";
                font-size: 10px;
                font-weight: 600;
                color: Theme.accent-cyan;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: AccessibleRole.text;
            }
        }
        CompactButton {
            height: 24px;
            font_size: 10px;
            width: 40px;
            text: "Clear";
            ink: Theme.text-secondary;
            hint: GuideModel.allows_tier_table() ? "Clear the selection. No tier is changed." : GuideModel.locked_hint;
            enabled: GuideModel.allows_tier_table();
            clicked => { EditorModel.clear_multi_select(); }
        }
        CompactButton {
            height: 24px;
            font_size: 10px;
            width: 52px;
            text: "Delete";
            ink: Theme.accent-ruby;
            hint: GuideModel.allows_tier_table() ? "Delete every selected tier (one Undo step per tier)." : GuideModel.locked_hint;
            enabled: GuideModel.allows_tier_table();
            clicked => { EditorModel.remove_multi_selected(); }
        }
        // "Adopt all" restricted to the current multi-selection.
        if root.advanced: CompactButton {
            height: 24px;
            font_size: 10px;
            width: 72px;
            text: "Adopt Sel.";
            hint: GuideModel.allows_tier_table() ? "Adopt the imported meet of every selected\ntier, as one Undo step. See the glossary." : GuideModel.locked_hint;
            enabled: GuideModel.allows_tier_table();
            clicked => { EditorModel.adopt_selected(); }
        }
        // A batch "offset angle by X" mini-form. `root.keyboard_focus_index` is only a hint for the
        // anchor: Rust (`TierTableModel.offset_selected`) uses it when it is a ticked row and
        // otherwise the first ticked row.
        offset_edit := TipField {
            width: 64px;
            placeholder: "deg";
            hint: "How many degrees to move every selected tier's angle by. You can type\narithmetic, for example 0.5+0.25. Press Enter, or Offset, to apply.";
            reader_label: "Offset in Degrees";
            accepted => {
                if offset_edit.text != "" && TierTableModel.offset_selected(root.keyboard_focus_index, offset_edit.text) {
                    offset_edit.text = "";
                }
            }
        }
        CompactButton {
            height: 24px;
            font_size: 10px;
            width: 52px;
            text: "Offset";
            hint: GuideModel.allows_tier_table() ? "Offset every selected tier's angle by the degrees you typed, as\none Undo step. You can type arithmetic, for example 0.5+0.25." : GuideModel.locked_hint;
            enabled: GuideModel.allows_tier_table();
            clicked => {
                if offset_edit.text != "" && TierTableModel.offset_selected(root.keyboard_focus_index, offset_edit.text) {
                    offset_edit.text = "";
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}
