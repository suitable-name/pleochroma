import { EditorTierItem } from "../../types.slint";
import { Theme } from "../../theme.slint";
import { EditorModel } from "../../models/editor.slint";
import { GuideModel } from "../../models/guide.slint";
import { SurfaceModel } from "../../models/surface.slint";
import { KitIcons } from "../kit/icons.slint";
import { TierMenuSurface, TierMenuItem, TierMenuCaption, TierMenuSeparator } from "tier_menu_parts.slint";

// The "..." menu of one tier row (it also opens on a right-click of the row): everything a row
// used to carry as buttons -- Adopt, Pin, Add Anchor, Complete orbit, Detach and Reattach, move,
// Duplicate, Delete -- plus Add to Selection and the Surface Finish grades. A menu item keeps the
// accessible name the button had. The component is an invisible overlay of the whole row (it takes
// no clicks); `TierTableRow` calls `open(x, y)` with a point inside the row.
//
// The menu acts on `EditorModel.row_menu_item`, which `open()` copies from this row's `item`. The
// popup reads nothing of the row itself: a `PopupWindow` inside a `for` row could resolve the row
// to another instance, and Delete on Tier 3 removed Tier 1. Its page and sizes live on the popup.
//
// While the worked-example guide locks the tier table (`GuideModel.allows_tier_table()`) every item
// is disabled and its tooltip explains the lock. The Simple interface leaves out Adopt, Pin,
// Detach and Complete orbit (their state is untouched).
export component TierRowActions inherits Rectangle {
    in property <EditorTierItem> item;
    // Fired by "Add Anchor" and by Surface Finish > Custom: reports which tier to select.
    callback tier_selected(int);

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;

    // Opens the menu with its corner at (`px`, `py`) in the row's coordinates, kept inside the
    // row's width so it never leaves the window at the right edge. Runs in this row, so the tier
    // it copies is this row's.
    public function open(px: length, py: length) {
        EditorModel.row_menu_item = root.item;
        root.pop_x = max(0px, min(px, root.width - 210px));
        root.pop_y = py;
        menu.show();
    }
    property <length> pop_x: 0px;
    property <length> pop_y: 0px;

    menu := PopupWindow {
        // The tier the menu acts on, and its derived flags.
        property <EditorTierItem> tier: EditorModel.row_menu_item;
        property <bool> unlocked: GuideModel.allows_tier_table();
        property <bool> advanced: GuideModel.shows_advanced();
        property <bool> flat: self.tier.kind == 0;
        property <bool> adopt_shown: self.advanced && self.tier.imported_meet_text != "";
        property <bool> pin_shown: self.advanced && self.flat && self.tier.constraint_kind != 2 && self.tier.constraint_kind < 3 && !self.tier.strategy_is_uncertain;
        property <bool> anchor_shown: self.tier.needs_anchor;
        property <bool> orbit_shown: self.advanced && self.flat && self.tier.orbit_incomplete && !self.tier.is_detached;
        property <bool> detach_shown: self.advanced && self.flat && self.tier.orbit_status != "";
        // 0 the actions, 1 the Surface Finish grades. A fresh popup starts at 0.
        property <int> page: 0;
        property <int> n_actions: (self.adopt_shown ? 1 : 0) + (self.pin_shown ? 1 : 0) + (self.anchor_shown ? 1 : 0)
            + (self.orbit_shown ? 1 : 0) + (self.detach_shown ? 1 : 0);
        property <length> main_height: 8px + self.n_actions * 28px + (self.n_actions > 0 ? 9px : 0px)
            + 3 * 28px + (self.flat ? 2 * 28px : 0px) + 9px + 28px;
        property <length> surface_height: 8px + 28px + 9px + 8 * 28px + 9px + 3 * 28px;

        x: root.pop_x;
        y: root.pop_y;
        width: 210px;
        height: self.page == 0 ? self.main_height : self.surface_height;
        close-policy: close-on-click-outside;
        TierMenuSurface {
            width: parent.width;
            height: parent.height;
            accessible-role: AccessibleRole.groupbox;
            accessible-label: "Tier Actions";
            if menu.page == 0: VerticalLayout {
                padding: 4px;
                if menu.adopt_shown: TierMenuItem {
                    text: "Adopt";
                    label: "Adopt";
                    hint: menu.unlocked ? "File says this tier " + menu.tier.imported_meet_text + ".\nClick Adopt to switch to it so the solver and Optimize can move this facet." : GuideModel.locked_hint;
                    enabled: menu.unlocked;
                    activated => { EditorModel.adopt_meet(menu.tier.index); menu.close(); }
                }
                if menu.pin_shown: TierMenuItem {
                    text: "Pin";
                    label: "Pin";
                    hint: menu.unlocked ? "Pin this tier's current solved mast (" + menu.tier.mast_full + ") as an exact scale-reference anchor. See the glossary." : GuideModel.locked_hint;
                    enabled: menu.unlocked;
                    activated => { EditorModel.pin_to_mast(menu.tier.index); menu.close(); }
                }
                if menu.anchor_shown: TierMenuItem {
                    text: "Add Anchor";
                    label: "Add Anchor";
                    ink: Theme.accent-amber;
                    hint: menu.unlocked
                        ? (menu.tier.strategy_detail != ""
                            ? menu.tier.strategy_detail
                            : "Add Anchor: open the Tier tab on this row set to an exact scale value,\nwhich gives its block the anchor it needs. See the glossary.")
                        : GuideModel.locked_hint;
                    enabled: menu.unlocked;
                    activated => {
                        EditorModel.suggested_constraint_kind = 2;
                        root.tier_selected(menu.tier.index);
                        // The Tier form, unfolded; not while a guide step locks it.
                        if GuideModel.allows_tier_form() {
                            EditorModel.show_tier_form();
                        }
                        menu.close();
                    }
                }
                if menu.orbit_shown: TierMenuItem {
                    text: "Complete Orbit";
                    label: "Complete orbit";
                    ink: Theme.accent-amber;
                    hint: menu.unlocked ? "Complete this tier's orbit: add the missing symmetric facets. See the glossary." : GuideModel.locked_hint;
                    enabled: menu.unlocked;
                    activated => { EditorModel.complete_orbit(menu.tier.index); menu.close(); }
                }
                if menu.detach_shown: TierMenuItem {
                    text: menu.tier.is_detached ? "Reattach" : "Detach";
                    label: menu.tier.is_detached ? "Reattach" : "Detach";
                    hint: menu.unlocked
                        ? (menu.tier.is_detached
                            ? "Reattach this tier's facets to their symmetric\nfamily, so they follow it again. See the glossary."
                            : "Detach this tier's facets: mark them as hand-managed -- they stay\nindependent and are not swept along when an orbit\nmember elsewhere is removed. See the glossary.")
                        : GuideModel.locked_hint;
                    enabled: menu.unlocked;
                    activated => { EditorModel.toggle_detach(menu.tier.index); menu.close(); }
                }
                if menu.n_actions > 0: TierMenuSeparator { }
                TierMenuItem {
                    text: "Move Up";
                    label: "Move this tier up in cutting order (Alt+Up).";
                    hint: menu.unlocked ? "Move this tier up in cutting order (Alt+Up)." : GuideModel.locked_hint;
                    enabled: menu.unlocked;
                    activated => { EditorModel.move_tier(menu.tier.index, -1); menu.close(); }
                }
                TierMenuItem {
                    text: "Move Down";
                    label: "Move this tier down in cutting order (Alt+Down).";
                    hint: menu.unlocked ? "Move this tier down in cutting order (Alt+Down)." : GuideModel.locked_hint;
                    enabled: menu.unlocked;
                    activated => { EditorModel.move_tier(menu.tier.index, 1); menu.close(); }
                }
                TierMenuItem {
                    text: "Duplicate";
                    label: "Duplicate this tier, inserted right after it (Ctrl+D).";
                    hint: menu.unlocked ? "Duplicate this tier, inserted right after it (Ctrl+D)." : GuideModel.locked_hint;
                    icon: KitIcons.copy;
                    enabled: menu.unlocked;
                    activated => { EditorModel.duplicate_tier(menu.tier.index); menu.close(); }
                }
                if menu.flat: TierMenuItem {
                    text: menu.tier.multi_selected ? "Remove from Selection" : "Add to Selection";
                    label: "Add Tier " + (menu.tier.index + 1) + " to the selection";
                    hint: "Tick this tier for a batch change, as Ctrl+click or Space does.";
                    icon: KitIcons.check;
                    activated => { EditorModel.toggle_multi_select(menu.tier.index); menu.close(); }
                }
                if menu.flat: TierMenuItem {
                    text: "Surface Finish";
                    label: "Surface Finish";
                    hint: menu.unlocked ? "How well this tier is polished, or how coarsely it is ground." : GuideModel.locked_hint;
                    enabled: menu.unlocked;
                    submenu: true;
                    activated => { menu.page = 1; }
                }
                TierMenuSeparator { }
                TierMenuItem {
                    text: "Delete";
                    label: "Remove this tier (Delete).";
                    hint: menu.unlocked ? "Remove this tier (Delete). Undo brings it back." : GuideModel.locked_hint;
                    icon: KitIcons.close;
                    ink: Theme.danger;
                    enabled: menu.unlocked;
                    activated => { EditorModel.remove_tier(menu.tier.index); menu.close(); }
                }
            }
            if menu.page == 1: VerticalLayout {
                padding: 4px;
                TierMenuItem {
                    text: "Back";
                    label: "Back to Tier Actions";
                    activated => { menu.page = 0; }
                }
                TierMenuSeparator { }
                for grade[i] in ["Ideal", "Mirror", "Fine", "Commercial", "Prepolish", "Ground (Fine)", "Ground (Coarse)", "Custom..."]: TierMenuItem {
                    text: grade;
                    label: grade;
                    activated => {
                        SurfaceModel.grade_chosen(menu.tier.index, i);
                        if i == 7 {
                            root.tier_selected(menu.tier.index);
                        }
                        menu.close();
                    }
                }
                TierMenuSeparator { }
                TierMenuItem {
                    text: "No Sweep";
                    label: "No Sweep";
                    activated => { SurfaceModel.no_sweep_set(menu.tier.index, true); menu.close(); }
                }
                TierMenuItem {
                    text: "Follow the Sweep";
                    label: "Follow the Sweep";
                    activated => { SurfaceModel.no_sweep_set(menu.tier.index, false); menu.close(); }
                }
                TierMenuItem {
                    text: SurfaceModel.show_overlay ? "Hide Surface Finish" : "Show Surface Finish";
                    label: SurfaceModel.show_overlay ? "Hide Surface Finish" : "Show Surface Finish";
                    activated => {
                        SurfaceModel.show_overlay = !SurfaceModel.show_overlay;
                        SurfaceModel.overlay_changed();
                        menu.close();
                    }
                }
            }
        }
    }
}
