import { EditorTierItem } from "../../types.slint";
import { Theme } from "../../theme.slint";
import { EditorModel } from "../../models/editor.slint";
import { GuideModel } from "../../models/guide.slint";
import { SurfaceModel } from "../../models/surface.slint";
import { KitIcons } from "../kit/icons.slint";
import { TierMenuSurface, TierMenuItem, TierMenuCaption, TierMenuSeparator } from "tier_menu_parts.slint";

// The "..." menu of one tier row (it also opens on a right-click of the row): everything a row
// used to carry as buttons -- Adopt, Pin, Add Anchor, Complete orbit, Detach and Reattach, move,
// Duplicate, Delete -- plus Add to Selection and the Surface Finish grades. A menu item keeps the
// accessible name the button had. The component is an invisible overlay of the whole row (it takes
// no clicks); `TierTableRow` calls `open(x, y)` with a point inside the row.
//
// While the worked-example guide locks the tier table (`GuideModel.allows_tier_table()`) every item
// is disabled and its tooltip explains the lock. The Simple interface leaves out Adopt, Pin,
// Detach and Complete orbit (their state is untouched).
export component TierRowActions inherits Rectangle {
    in property <EditorTierItem> item;
    // Fired by "Add Anchor" and by Surface Finish > Custom: reports which tier to select.
    callback tier_selected(int);

    property <bool> unlocked: GuideModel.allows_tier_table();
    property <bool> advanced: GuideModel.shows_advanced();
    property <bool> flat: root.item.kind == 0;
    property <bool> adopt_shown: root.advanced && root.item.imported_meet_text != "";
    property <bool> pin_shown: root.advanced && root.flat && root.item.constraint_kind != 2 && root.item.constraint_kind < 3 && !root.item.strategy_is_uncertain;
    property <bool> anchor_shown: root.item.needs_anchor;
    property <bool> orbit_shown: root.advanced && root.flat && root.item.orbit_incomplete && !root.item.is_detached;
    property <bool> detach_shown: root.advanced && root.flat && root.item.orbit_status != "";
    // 0 the actions, 1 the Surface Finish grades.
    property <int> page: 0;
    property <int> n_actions: (root.adopt_shown ? 1 : 0) + (root.pin_shown ? 1 : 0) + (root.anchor_shown ? 1 : 0)
        + (root.orbit_shown ? 1 : 0) + (root.detach_shown ? 1 : 0);
    property <length> main_height: 8px + root.n_actions * 28px + (root.n_actions > 0 ? 9px : 0px)
        + 3 * 28px + (root.flat ? 2 * 28px : 0px) + 9px + 28px;
    property <length> surface_height: 8px + 28px + 9px + 8 * 28px + 9px + 3 * 28px;

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;

    // Opens the menu with its corner at (`px`, `py`) in the row's coordinates, kept inside the
    // row's width so it never leaves the window at the right edge.
    public function open(px: length, py: length) {
        root.page = 0;
        root.pop_x = max(0px, min(px, root.width - 210px));
        root.pop_y = py;
        menu.show();
    }
    property <length> pop_x: 0px;
    property <length> pop_y: 0px;

    menu := PopupWindow {
        x: root.pop_x;
        y: root.pop_y;
        width: 210px;
        height: root.page == 0 ? root.main_height : root.surface_height;
        close-policy: close-on-click-outside;
        TierMenuSurface {
            width: parent.width;
            height: parent.height;
            accessible-role: AccessibleRole.groupbox;
            accessible-label: "Tier Actions";
            if root.page == 0: VerticalLayout {
                padding: 4px;
                if root.adopt_shown: TierMenuItem {
                    text: "Adopt";
                    label: "Adopt";
                    hint: root.unlocked ? "File says this tier " + root.item.imported_meet_text + ".\nClick Adopt to switch to it so the solver and Optimize can move this facet." : GuideModel.locked_hint;
                    enabled: root.unlocked;
                    activated => { menu.close(); EditorModel.adopt_meet(root.item.index); }
                }
                if root.pin_shown: TierMenuItem {
                    text: "Pin";
                    label: "Pin";
                    hint: root.unlocked ? "Pin this tier's current solved mast (" + root.item.mast_full + ") as an exact scale-reference anchor. See the glossary." : GuideModel.locked_hint;
                    enabled: root.unlocked;
                    activated => { menu.close(); EditorModel.pin_to_mast(root.item.index); }
                }
                if root.anchor_shown: TierMenuItem {
                    text: "Add Anchor";
                    label: "Add Anchor";
                    ink: Theme.accent-amber;
                    hint: root.unlocked
                        ? (root.item.strategy_detail != ""
                            ? root.item.strategy_detail
                            : "Add Anchor: open the Tier tab on this row set to an exact scale value,\nwhich gives its block the anchor it needs. See the glossary.")
                        : GuideModel.locked_hint;
                    enabled: root.unlocked;
                    activated => {
                        menu.close();
                        EditorModel.suggested_constraint_kind = 2;
                        root.tier_selected(root.item.index);
                        EditorModel.inspector_tab = 0;
                        EditorModel.inspector_collapsed = false;
                    }
                }
                if root.orbit_shown: TierMenuItem {
                    text: "Complete Orbit";
                    label: "Complete orbit";
                    ink: Theme.accent-amber;
                    hint: root.unlocked ? "Complete this tier's orbit: add the missing symmetric facets. See the glossary." : GuideModel.locked_hint;
                    enabled: root.unlocked;
                    activated => { menu.close(); EditorModel.complete_orbit(root.item.index); }
                }
                if root.detach_shown: TierMenuItem {
                    text: root.item.is_detached ? "Reattach" : "Detach";
                    label: root.item.is_detached ? "Reattach" : "Detach";
                    hint: root.unlocked
                        ? (root.item.is_detached
                            ? "Reattach this tier's facets to their symmetric\nfamily, so they follow it again. See the glossary."
                            : "Detach this tier's facets: mark them as hand-managed -- they stay\nindependent and are not swept along when an orbit\nmember elsewhere is removed. See the glossary.")
                        : GuideModel.locked_hint;
                    enabled: root.unlocked;
                    activated => { menu.close(); EditorModel.toggle_detach(root.item.index); }
                }
                if root.n_actions > 0: TierMenuSeparator { }
                TierMenuItem {
                    text: "Move Up";
                    label: "Move this tier up in cutting order (Alt+Up).";
                    hint: root.unlocked ? "Move this tier up in cutting order (Alt+Up)." : GuideModel.locked_hint;
                    enabled: root.unlocked;
                    activated => { menu.close(); EditorModel.move_tier(root.item.index, -1); }
                }
                TierMenuItem {
                    text: "Move Down";
                    label: "Move this tier down in cutting order (Alt+Down).";
                    hint: root.unlocked ? "Move this tier down in cutting order (Alt+Down)." : GuideModel.locked_hint;
                    enabled: root.unlocked;
                    activated => { menu.close(); EditorModel.move_tier(root.item.index, 1); }
                }
                TierMenuItem {
                    text: "Duplicate";
                    label: "Duplicate this tier, inserted right after it (Ctrl+D).";
                    hint: root.unlocked ? "Duplicate this tier, inserted right after it (Ctrl+D)." : GuideModel.locked_hint;
                    icon: KitIcons.copy;
                    enabled: root.unlocked;
                    activated => { menu.close(); EditorModel.duplicate_tier(root.item.index); }
                }
                if root.flat: TierMenuItem {
                    text: root.item.multi_selected ? "Remove from Selection" : "Add to Selection";
                    label: "Add Tier " + (root.item.index + 1) + " to the selection";
                    hint: "Tick this tier for a batch change, as Ctrl+click or Space does.";
                    icon: KitIcons.check;
                    activated => { menu.close(); EditorModel.toggle_multi_select(root.item.index); }
                }
                if root.flat: TierMenuItem {
                    text: "Surface Finish";
                    label: "Surface Finish";
                    hint: root.unlocked ? "How well this tier is polished, or how coarsely it is ground." : GuideModel.locked_hint;
                    enabled: root.unlocked;
                    submenu: true;
                    activated => { root.page = 1; }
                }
                TierMenuSeparator { }
                TierMenuItem {
                    text: "Delete";
                    label: "Remove this tier (Delete).";
                    hint: root.unlocked ? "Remove this tier (Delete). Undo brings it back." : GuideModel.locked_hint;
                    icon: KitIcons.close;
                    ink: Theme.danger;
                    enabled: root.unlocked;
                    activated => { menu.close(); EditorModel.remove_tier(root.item.index); }
                }
            }
            if root.page == 1: VerticalLayout {
                padding: 4px;
                TierMenuItem {
                    text: "Back";
                    label: "Back to Tier Actions";
                    activated => { root.page = 0; }
                }
                TierMenuSeparator { }
                for grade[i] in ["Ideal", "Mirror", "Fine", "Commercial", "Prepolish", "Ground (Fine)", "Ground (Coarse)", "Custom..."]: TierMenuItem {
                    text: grade;
                    label: grade;
                    activated => {
                        menu.close();
                        SurfaceModel.grade_chosen(root.item.index, i);
                        if i == 7 {
                            root.tier_selected(root.item.index);
                        }
                    }
                }
                TierMenuSeparator { }
                TierMenuItem {
                    text: "No Sweep";
                    label: "No Sweep";
                    activated => { menu.close(); SurfaceModel.no_sweep_set(root.item.index, true); }
                }
                TierMenuItem {
                    text: "Follow the Sweep";
                    label: "Follow the Sweep";
                    activated => { menu.close(); SurfaceModel.no_sweep_set(root.item.index, false); }
                }
                TierMenuItem {
                    text: SurfaceModel.show_overlay ? "Hide Surface Finish" : "Show Surface Finish";
                    label: SurfaceModel.show_overlay ? "Hide Surface Finish" : "Show Surface Finish";
                    activated => {
                        menu.close();
                        SurfaceModel.show_overlay = !SurfaceModel.show_overlay;
                        SurfaceModel.overlay_changed();
                    }
                }
            }
        }
    }
}
