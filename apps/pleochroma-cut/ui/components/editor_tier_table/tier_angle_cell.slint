import { LineEdit } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { EditorModel } from "../../models/editor.slint";
import { GuideModel } from "../../models/guide.slint";

// One tier-list row's angle cell, click-to-edit. A plain `Text` shows the angle, so the row's
// click, Ctrl+click and hover behavior is unchanged. A double click (or F2) opens a `LineEdit`.
// The scroll wheel nudges by 0.1 deg while editing or with Ctrl held; otherwise it scrolls the
// list. A single click calls `select()`. The cell only reports intent through `select`, `nudge`,
// `commit` and `closed`; it never writes `Design` itself.
//
// Commit: Enter (`accepted`) or focus loss (`changed has-focus`, since `LineEdit` has no blur
// callback) calls `commit` with the field text, then closes. Escape closes without `commit`, so
// the display reverts to `value`. `cancelling` stops the focus-loss handler from committing
// again after Escape or Enter. Every close path fires `closed()` so the caller can return
// keyboard focus to the list.
//
// Up/Down step 0.1 deg (Shift 1 deg, Ctrl 0.01 deg) in the `LineEdit`'s `key-pressed`. The wheel
// handler lives on `area` because a `FocusScope` has no `scroll-event`; only `TouchArea` and
// `Flickable` do.
//
// `focus_target`/`focus_pulse` let the tier list's F2 open this row's editor. `focus_pulse` is a
// counter, not a flag, so F2 on the same row twice in a row still fires `changed`.
export component TierAngleCell inherits Rectangle {
    in property <string> value;
    // The unrounded angle (`EditorTierItem.angle_full`) that seeds the `LineEdit`. Seeding
    // from the 2-decimal `value` would make a no-op commit a real change and spend an undo step.
    in property <string> full_value: root.value;
    // What a pending Optimize outcome would set this tier's angle to
    // (`EditorTierItem::proposed_angle`), or "" when no change is proposed. Shown
    // as a small ghost beside the real angle so a cutter can see the proposal
    // before pressing Apply, matching the Optimize "Preview" toggle.
    in property <string> proposed: "";
    in property <int> index;
    in property <int> focus_target: -1;
    in property <int> focus_pulse: 0;
    // `false` while the worked-example guide locks the tier table: the
    // double-click/F2 edit and the wheel nudge are refused, while a plain click still
    // selects the row (selection changes no design data).
    in property <bool> editable: true;
    // The tooltip shown while `editable` is false -- the guide's lock hint by default,
    // or a row-specific reason (a concave tier's angle is authored in the inspector).
    in property <string> locked_text: GuideModel.locked_hint;
    // The relation this tier's angle follows, as a cutter reads it ("C1 - 4"), or ""
    // for a free angle (`EditorTierItem.relation_text`). A driven cell shows a link icon
    // and its tooltip names the relation; double-click and F2 do not open the editor
    // (the angle is set by the tiers it follows) but fire `explain_driven()`.
    in property <string> relation: "";
    // Fired on a plain click, BEFORE edit mode -- lets the row select itself the
    // same way clicking any other cell does.
    callback select();
    // Double-click or F2 on a cell whose angle follows a relation: nothing is edited;
    // the caller says why (`RelationModel.explain_driven_angle`).
    callback explain_driven();
    callback commit(string);
    // (index, delta_deg)
    callback nudge(int, float);
    // Fired whenever edit mode closes (Enter, focus loss or Escape).
    callback closed();

    // This cell's own `area` covers the whole column. A `TouchArea` steals
    // hover from elements under it, so this property is exposed so the row can OR
    // it into its own background condition to keep the highlight from flickering
    // while the pointer crosses the ANGLE column.
    out property <bool> hovered: area.has-hover;

    width: 60px;
    height: 100%;
    property <bool> editing: false;
    property <int> seen_pulse: 0;
    // Set right before `editing` drops to `false` on a path that must NOT commit
    // (Escape) or that already committed once (`accepted`).
    property <bool> cancelling: false;

    changed focus_pulse => {
        if root.editable && root.focus_target == root.index && root.focus_pulse != root.seen_pulse {
            root.seen_pulse = root.focus_pulse;
            if root.relation != "" {
                root.explain_driven();
            } else {
                root.cancelling = false;
                root.editing = true;
            }
        }
    }

    function step(shift: bool, ctrl: bool, sign: float) {
        if shift {
            root.nudge(root.index, sign * 1.0);
        } else if ctrl {
            root.nudge(root.index, sign * 0.01);
        } else {
            root.nudge(root.index, sign * 0.1);
        }
    }

    // What the tooltip says for an editable cell (a property, so the degree sign needs no
    // escape inside `@markdown`).
    property <string> edit_hint: "Angle from the girdle plane, in degrees. Click to select this\nrow; double-click it or press F2 to edit. While editing,\nUp and Down change it by 0.1\u{b0} (Shift 1\u{b0}, Ctrl 0.01\u{b0}) and\nscrolling nudges it; Ctrl+Scroll nudges it any time.";

    Tooltip { text: root.relation != "" ? @markdown("Angle follows: \{root.relation}. See the glossary.") : (root.editable ? @markdown("\{root.edit_hint}") : @markdown("\{root.locked_text}")); }

    area := TouchArea {
        clicked => { root.select(); }
        double-clicked => {
            if root.editable {
                if root.relation != "" {
                    root.explain_driven();
                } else {
                    root.cancelling = false;
                    root.editing = true;
                }
            }
        }
        scroll-event(event) => {
            if root.editable && event.delta-y != 0 && (root.editing || event.modifiers.control) {
                root.nudge(root.index, event.delta-y > 0 ? 0.1 : -0.1);
                return accept;
            }
            reject
        }
    }

    if !root.editing: HorizontalLayout {
        // A 4 px indent: the value clears the centred CODE before it, under the ANGLE heading.
        padding-left: 4px;
        spacing: 2px;
        // A link: this angle follows a relation (the tooltip names it).
        if root.relation != "": VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../../icons/link.svg");
                colorize: Theme.accent-cyan;
                width: 9px;
                height: 9px;
                image-fit: contain;
            }
        }
        Text {
            text: root.value;
            font-size: 11px;
            font-weight: 600;
            color: Theme.accent-amber;
            overflow: elide;
            vertical-alignment: center;
        }
        // Proposed-angle ghost: only shown when Optimize proposes a change.
        // The arrow is an icon: the UI font has no arrow symbol.
        if root.proposed != "": VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../../icons/arrow-right.svg");
                colorize: Theme.accent-emerald;
                width: 8px;
                height: 8px;
                image-fit: contain;
            }
        }
        if root.proposed != "": Text {
            text: root.proposed;
            font-size: 9px;
            font-weight: 600;
            color: Theme.accent-emerald;
            overflow: elide;
            vertical-alignment: center;
        }
        // A pencil on hover hints at double-click and F2 (the Tooltip appears only after a
        // delay). Visual only, with no click target of its own.
        if root.hovered && root.relation == "": VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../../icons/pencil.svg");
                colorize: Theme.text-muted;
                width: 9px;
                height: 9px;
                image-fit: contain;
            }
        }
    }

    // For a screen reader the cell is a button that reads the angle and opens the editor (the
    // keyboard route is F2 on the list).
    if !root.editing: Rectangle {
        accessible-role: AccessibleRole.button;
        accessible-label: root.relation != ""
            ? "Angle " + root.value + " degrees, follows " + root.relation
            : "Angle " + root.value + " degrees";
        accessible-description: root.editable ? "Opens the angle editor." : root.locked_text;
        accessible-enabled: root.editable;
        accessible-action-default => {
            if root.editable {
                if root.relation != "" {
                    root.explain_driven();
                } else {
                    root.cancelling = false;
                    root.editing = true;
                }
            }
        }
    }

    if root.editing: edit := LineEdit {
        width: 100%;
        height: 100%;
        text: root.full_value;
        font-size: 11px;
        accessible-label: "Angle in Degrees";
        init => {
            self.select-all();
            self.focus();
        }
        accepted => {
            root.commit(self.text);
            // Already committed above -- the focus-loss teardown Enter also
            // triggers must not commit `self.text` a second time.
            root.cancelling = true;
            root.editing = false;
            // Enter does not blur first, and the `changed has-focus` handler goes away with this
            // element, so clear `text_focus` here. Otherwise it stays true and blocks app.slint's
            // Ctrl+Z/Ctrl+Y guard.
            EditorModel.text_focus = false;
            root.closed();
        }
        // Shared "a text field has focus" flag that app.slint's Ctrl+Z/Ctrl+Y guard reads.
        changed has-focus => {
            EditorModel.text_focus = self.has-focus;
            if !self.has-focus {
                if !root.cancelling {
                    root.commit(self.text);
                }
                root.cancelling = false;
                root.editing = false;
                root.closed();
            }
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelling = true;
                root.editing = false;
                // Escape does not blur first either (see `accepted`).
                EditorModel.text_focus = false;
                root.closed();
                return accept;
            } else if event.text == Key.UpArrow && root.editable {
                root.step(event.modifiers.shift, event.modifiers.control, 1.0);
                return accept;
            } else if event.text == Key.DownArrow && root.editable {
                root.step(event.modifiers.shift, event.modifiers.control, -1.0);
                return accept;
            }
            reject
        }
    }
}
