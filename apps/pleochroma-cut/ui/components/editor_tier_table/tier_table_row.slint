import { EditorTierItem } from "../../types.slint";
import { Theme } from "../../theme.slint";
import { EditorModel } from "../../models/editor.slint";
import { GuideModel } from "../../models/guide.slint";
import { RelationModel } from "../../models/relation.slint";
import { KitIcon, KitIcons } from "../kit/icons.slint";
import { TierAngleCell } from "tier_angle_cell.slint";
import { TierRowActions } from "tier_row_actions.slint";

// The tier's code at exactly 0 degrees, where clicking it flips the facet to the other block. It is
// drawn like the plain code of the other rows and shows a hover look, a tooltip and a focus ring;
// for a screen reader it is a button labelled with the code.
component CodeFlip inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <bool> enabled: true;
    in property <bool> reachable: false;
    callback clicked();

    border-radius: 3px;
    background: (code_touch.has-hover && root.enabled) ? Theme.overlay-hover : transparent;
    border-width: code_focus.has-focus ? 2px : 0px;
    border-color: Theme.accent-cyan-hover;

    accessible-role: AccessibleRole.button;
    accessible-label: root.text;
    accessible-description: root.hint;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    Tooltip { text: @markdown("\{root.hint}"); }

    code_focus := FocusScope {
        enabled: root.enabled && root.reachable;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    Text {
        text: root.text;
        font-size: 13px;
        font-weight: 700;
        color: Theme.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    code_touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

// One row of `EditorTierTable`'s flat tier list, in true cutting order. From the left: a stripe in
// the color of the tier's block, its step number, its code, its angle (click to select, double
// click or F2 to edit), the index positions in full, what the tier meets, and at the right a state
// mark (a tick when solved, a triangle when something needs a look: a shape, not only a color) and
// the "..." menu (`TierRowActions`, also opened by a right-click). The first row of a block carries
// a small heading above it (`group_start`).
//
// While the worked-example guide locks the tier table (`GuideModel.allows_tier_table()`), every
// action that changes the design is disabled and dimmed, and its tooltip explains the lock. Row
// selection (click, Ctrl/Shift+click, the Select-mode tick box) stays usable.
export component TierTableRow inherits Rectangle {
    // Named `item`, not `row`: `row` is a reserved `GridLayout` property every element inherits.
    in property <EditorTierItem> item;
    // Mirrors `EditorTierTable.keyboard_focus_index` two-way.
    in-out property <int> keyboard_focus_index: -1;
    in property <bool> table_focused: false;
    in property <bool> select_mode: false;
    in property <int> inline_edit_target: -1;
    in property <int> inline_edit_pulse: 0;
    // The first row of a block: draws the block's heading.
    in property <bool> group_start: false;
    // How many tiers the block holds, for the heading ("5 tiers").
    in property <string> group_note;

    // Fired on a plain click and by the angle cell's own select().
    callback tier_selected(int);
    // Fired once the inline angle editor closes, so the caller can reclaim keyboard focus on the
    // tier list's `FocusScope`.
    callback request_focus_return();
    // Fired when the keyboard cursor lands on this row: the list scrolls (y, height) into view.
    callback reveal(length, length);

    // Whether the row matches the filter box. The case-insensitive test runs in Rust.
    function row_matches(candidate: EditorTierItem) -> bool {
        return !GuideModel.shows_advanced() || EditorModel.tier_filter_text == ""
            || EditorModel.tier_matches_filter(candidate.name + " " + candidate.indices + " " + candidate.block + " " + candidate.strategy + " " + candidate.constraint_text + " " + candidate.tool_line, EditorModel.tier_filter_text);
    }

    property <bool> unlocked: GuideModel.allows_tier_table();
    property <bool> advanced: GuideModel.shows_advanced();
    // Only the row that holds the keyboard cursor offers its buttons to Tab.
    property <bool> reachable: root.item.index == root.keyboard_focus_index;
    property <bool> selected: root.item.index == EditorModel.selected_tier_index;
    property <length> head_h: root.group_start ? 24px : 0px;
    property <color> stripe: root.item.block == "Pavilion" ? Theme.accent-purple : (root.item.block == "Crown" ? Theme.accent-cyan : Theme.text-muted);
    // Solved and clear, or something to look at.
    property <bool> needs_look: root.item.strategy_is_uncertain || root.item.needs_anchor || root.item.warning_text != "";
    property <string> state_text: root.item.needs_anchor ? "Needs an anchor"
        : (root.item.warning_text != "" ? root.item.warning_text
        : (root.item.strategy_is_uncertain ? "Not solved yet" : "Solved"));
    property <string> block_heading: root.item.block == "Pavilion" ? "PAVILION" : (root.item.block == "Crown" ? "CROWN" : "GIRDLE");
    // The scale value for display: `constraint_text` is the exact round-trip string the form
    // reads (0.6058300029776786), so the row shows it to four decimals (0.7 stays 0.7).
    property <float> scale_value: root.item.constraint_text.to-float();
    property <string> rounded_scale: root.item.constraint_text.character-count > 6
        ? "\{Math.round(root.scale_value * 10000) / 10000}"
        : root.item.constraint_text;
    property <string> meets_text: root.item.kind == 1 ? "Concave tool"
        : (root.item.constraint_kind == 2 ? "scale " + root.rounded_scale
        : (root.item.constraint_kind == 1 ? "meets " + root.item.constraint_text
        : (root.item.constraint_kind == 3 ? root.item.constraint_text + " mm depth"
        : (root.item.constraint_kind == 4 ? "girdle " + root.item.constraint_text + " mm"
        : (root.item.constraint_kind == 5 ? "table " + root.item.constraint_text + " mm"
        : "meet point")))));
    property <string> detail_text: (root.item.name != "" && root.item.name != root.item.code ? root.item.name + " \u{b7} " : "")
        + root.meets_text
        + (root.item.orbit_incomplete && !root.item.is_detached ? " \u{b7} " + root.item.orbit_status : "")
        + (root.item.is_detached ? " \u{b7} detached" : "");

    height: root.head_h + 48px;
    accessible-role: AccessibleRole.list-item;
    accessible-label: "Tier " + (root.item.index + 1) + ", " + (root.item.name == "" ? "unnamed" : root.item.name)
        + ", angle " + root.item.angle_deg + ", " + root.item.block
        + (root.item.kind == 1 ? ", concave" : "") + (root.item.frosting_text != "" ? ", " + root.item.frosting_text : "")
        + (root.item.multi_selected ? ", in the selection" : "");
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.keyboard_focus_index = root.item.index;
        root.tier_selected(root.item.index);
    }

    property <bool> cursor_here: root.item.index == root.keyboard_focus_index;
    changed cursor_here => {
        if root.cursor_here {
            root.reveal(self.y, self.height);
        }
    }

    if root.group_start: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: root.head_h;
        Text {
            x: 10px;
            y: 4px;
            height: parent.height - 4px;
            text: root.block_heading;
            font-size: 10px;
            font-weight: 700;
            color: Theme.text-muted;
            vertical-alignment: center;
            accessible-role: AccessibleRole.text;
            accessible-label: root.block_heading.to-lowercase() + " tiers" + (root.group_note != "" ? ", " + root.group_note : "");
        }
        if root.group_note != "": Text {
            x: 78px;
            y: 4px;
            height: parent.height - 4px;
            text: root.group_note;
            font-size: 10px;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
    }

    body := Rectangle {
        x: 0px;
        y: root.head_h;
        width: parent.width;
        height: 48px;
        // A filtered-out row is dimmed, not removed, so the arrow keys keep their arithmetic.
        opacity: root.row_matches(root.item) ? 1.0 : 0.35;
        property <color> row_bg: root.selected
            ? Theme.primary-glow
            : ((row_touch.has-hover || angle_cell.hovered) ? Theme.bg-card-hover : Theme.bg-input);
        background: body.row_bg;
        border-radius: 6px;
        // The keyboard cursor ring is cyan only while the list has focus; a multi-selected row gets
        // its own amber.
        border-width: root.cursor_here ? 1.5px : (root.item.multi_selected ? 1px : 0px);
        border-color: root.cursor_here
            ? (root.table_focused ? Theme.accent-cyan : Theme.border-subtle)
            : (root.item.multi_selected ? Theme.accent-amber : transparent);

        // The last press's modifier state, since `clicked` carries none.
        property <bool> ctrl_down: false;
        property <bool> shift_down: false;
        row_touch := TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    body.ctrl_down = event.modifiers.control || event.modifiers.meta;
                    body.shift_down = event.modifiers.shift;
                    if event.button == PointerEventButton.right {
                        root.keyboard_focus_index = root.item.index;
                        root.tier_selected(root.item.index);
                        actions.open(self.mouse-x, root.head_h + self.mouse-y);
                    }
                }
            }
            clicked => {
                root.keyboard_focus_index = root.item.index;
                // Shift+click selects a range, Ctrl+click toggles; a concave row only selects.
                if root.item.kind == 0 && body.shift_down {
                    EditorModel.select_tier_range(root.item.index);
                } else if root.item.kind == 0 && body.ctrl_down {
                    EditorModel.toggle_multi_select(root.item.index);
                } else {
                    root.tier_selected(root.item.index);
                }
                // A TouchArea takes no focus: hand it to the list, so the row's keys work at once.
                root.request_focus_return();
            }
        }

        HorizontalLayout {
            padding-right: 6px;
            spacing: 6px;
            // The group stripe.
            Rectangle {
                width: 4px;
                VerticalLayout {
                    padding-top: 6px;
                    padding-bottom: 6px;
                    Rectangle { background: root.stripe; border-radius: 2px; }
                }
            }
            // The step number; a tick (multi-selected) or an empty box (Select mode) replaces it.
            Rectangle {
                width: 24px;
                background: root.item.multi_selected ? Theme.accent-amber-glow : transparent;
                border-radius: 4px;
                if !root.item.multi_selected && !root.select_mode: Text {
                    width: parent.width;
                    height: parent.height;
                    text: "" + (root.item.index + 1);
                    font-size: 11px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: AccessibleRole.text;
                    accessible-label: "Step " + (root.item.index + 1);
                }
                if root.item.multi_selected: Image {
                    source: @image-url("../../icons/check.svg");
                    colorize: Theme.accent-amber;
                    width: 12px;
                    height: 12px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    image-fit: contain;
                }
                if root.select_mode && !root.item.multi_selected: Rectangle {
                    width: 12px;
                    height: 12px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-width: 1px;
                    border-color: Theme.text-muted;
                    border-radius: 2px;
                }
                // In Select mode a click ticks the row, as Ctrl+click does.
                hash_touch := TouchArea {
                    enabled: root.select_mode && root.item.kind == 0;
                    clicked => { EditorModel.toggle_multi_select(root.item.index); }
                }
                if root.select_mode && root.item.kind == 0: Rectangle {
                    accessible-role: AccessibleRole.checkbox;
                    accessible-checkable: true;
                    accessible-checked: root.item.multi_selected;
                    accessible-label: "Add Tier " + (root.item.index + 1) + " to the selection";
                    accessible-action-default => { EditorModel.toggle_multi_select(root.item.index); }
                }
            }
            // The code (`P1`, `G1`, `C1`, `T`), or the block's letter when the tier has none. At
            // exactly 0 degrees it is a button that flips the facet to the other block.
            block_cell := Rectangle {
                property <bool> zero_angle: root.item.angle_deg == "0.00" || root.item.angle_deg == "-0.00";
                property <string> code_text: root.item.code != ""
                    ? root.item.code
                    : (root.item.block == "Crown" ? "C" : (root.item.block == "Pavilion" ? "P" : "G"));
                property <string> flip_hint: !self.zero_angle
                    ? root.item.block + " facet, " + self.code_text + "."
                    : (root.item.block == "Pavilion"
                        ? "Pavilion facet at 0\u{b0} -- click to flip to Crown."
                        : "Crown facet at 0\u{b0} -- click to flip to Pavilion.");
                width: 40px;
                if !block_cell.zero_angle: Text {
                    width: parent.width;
                    height: parent.height;
                    text: block_cell.code_text;
                    font-size: 13px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: AccessibleRole.text;
                    // Never the bare block name: "Pavilion" and "Crown" are labels of the diagram toolbar.
                    accessible-label: "Code " + block_cell.code_text + ", " + root.item.block + " tier";
                }
                if !block_cell.zero_angle: Tooltip { text: @markdown("\{block_cell.flip_hint} The code is the tier's label on the cutting\nsheet: P is pavilion, G is girdle, C is crown and T is the\ntable, each numbered in cutting order. See the glossary."); }
                if block_cell.zero_angle: compact-button-code-text := CodeFlip {
                    x: 1px;
                    width: parent.width - 2px;
                    height: parent.height;
                    text: block_cell.code_text;
                    hint: root.unlocked ? block_cell.flip_hint : GuideModel.locked_hint;
                    enabled: root.unlocked && root.item.kind == 0;
                    reachable: root.reachable;
                    clicked => {
                        EditorModel.inline_set_angle(root.item.index, root.item.block == "Pavilion" ? "0" : "-0");
                    }
                }
            }
            angle_cell := TierAngleCell {
                width: 72px;
                value: root.item.angle_deg;
                full_value: root.item.angle_full;
                proposed: root.item.proposed_angle;
                index: root.item.index;
                focus_target: root.inline_edit_target;
                focus_pulse: root.inline_edit_pulse;
                // A concave tier's angle is authored in the inspector's concave form.
                editable: root.unlocked && root.item.kind == 0;
                locked_text: root.item.kind == 1
                    ? "Concave tier -- edit its angle in the inspector (click to select this row)."
                    : GuideModel.locked_hint;
                relation: root.item.relation_text;
                explain_driven() => { RelationModel.explain_driven_angle(); }
                select() => {
                    root.keyboard_focus_index = root.item.index;
                    root.tier_selected(root.item.index);
                }
                commit(text) => { EditorModel.inline_set_angle(root.item.index, text); }
                nudge(idx, delta) => { EditorModel.nudge_angle(idx, delta); }
                closed() => { root.request_focus_return(); }
            }
            // The index positions in full (they wrap to a second line), and below them what the
            // tier meets.
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.item.indices;
                    font-size: 11px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                    overflow: elide;
                    vertical-alignment: center;
                    height: min(28px, self.preferred-height);
                }
                Text {
                    text: root.detail_text;
                    font-size: 10px;
                    color: Theme.text-muted;
                    overflow: elide;
                    vertical-alignment: center;
                    accessible-role: AccessibleRole.text;
                    accessible-label: "Tier " + (root.item.index + 1) + " detail: " + root.detail_text;
                }
            }
            // The marks and the menu button.
            HorizontalLayout {
                spacing: 4px;
                alignment: end;
                if root.item.margin_text != "": VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 18px;
                        width: margin_txt.preferred-width + 10px;
                        border-radius: 9px;
                        background: root.item.risk_level == 2 ? Theme.danger-surface : (root.item.risk_level == 1 ? Theme.accent-amber-glow : Theme.bg-card);
                        Tooltip { text: @markdown("Margin over the critical angle: \{root.item.margin_text}. A small margin risks a window. See the glossary."); }
                        margin_txt := Text {
                            x: 5px;
                            height: parent.height;
                            text: (root.item.risk_level == 2 ? "window " : (root.item.risk_level == 1 ? "thin " : "")) + root.item.margin_text;
                            font-size: 10px;
                            font-weight: 600;
                            color: root.item.risk_level == 2 ? Theme.accent-ruby : (root.item.risk_level == 1 ? Theme.accent-amber : Theme.accent-emerald);
                            vertical-alignment: center;
                            accessible-role: AccessibleRole.text;
                            accessible-label: "Margin over the critical angle " + root.item.margin_text;
                        }
                    }
                }
                if root.item.frosting_text != "": VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 14px;
                        height: 14px;
                        accessible-role: AccessibleRole.text;
                        accessible-label: root.item.frosting_text;
                        Image {
                            source: @image-url("../../icons/frost.svg");
                            colorize: Theme.accent-cyan;
                            width: 13px;
                            height: 13px;
                            image-fit: contain;
                        }
                        Tooltip { text: @markdown("\{root.item.frosting_text}. Frosted facets are cut with a matte, light-scattering finish."); }
                    }
                }
                if root.item.relation_text != "": VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 14px;
                        height: 14px;
                        accessible-role: AccessibleRole.text;
                        accessible-label: "Angle follows " + root.item.relation_text;
                        Image {
                            source: @image-url("../../icons/link.svg");
                            colorize: Theme.accent-cyan;
                            width: 12px;
                            height: 12px;
                            image-fit: contain;
                        }
                    }
                }
                // The state mark: a tick when solved, a triangle when the tier needs a look.
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        accessible-role: AccessibleRole.text;
                        accessible-label: root.state_text;
                        KitIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            d: root.needs_look ? KitIcons.warn : KitIcons.check;
                            size: 14px;
                            ink: root.needs_look ? Theme.accent-amber : Theme.accent-emerald;
                        }
                        Tooltip { text: @markdown("\{root.state_text}"); }
                    }
                }
                // "..." opens the row's menu. It shows on every row, never hidden: it stays enabled
                // there, and a touch or screen-reader user could otherwise reach a button nobody can
                // see. At rest it is drawn in the muted ink (a theme color, so it keeps its contrast
                // in the high-contrast theme); the selected, cursor and hovered rows draw it in the
                // secondary ink.
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 6px;
                        background: more_touch.has-hover ? Theme.overlay-hover : transparent;
                        border-width: more_focus.has-focus ? 2px : 0px;
                        border-color: Theme.accent-cyan-hover;
                        property <bool> lit: root.selected || root.cursor_here || row_touch.has-hover || more_touch.has-hover || more_focus.has-focus;
                        accessible-role: AccessibleRole.button;
                        accessible-label: "Actions for Tier " + (root.item.index + 1);
                        accessible-description: "Adopt, pin, detach, move, duplicate, surface finish and delete this tier. Right-click the row opens the same menu.";
                        accessible-action-default => { actions.open(body.width - 214px, root.head_h + 36px); }
                        more_focus := FocusScope {
                            enabled: root.reachable;
                            key-pressed(event) => {
                                if event.text == Key.Space || event.text == Key.Return {
                                    actions.open(body.width - 214px, root.head_h + 36px);
                                    return accept;
                                }
                                return reject;
                            }
                        }
                        KitIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            d: KitIcons.more;
                            size: 16px;
                            stroke: 2.4px;
                            ink: parent.lit ? Theme.text-secondary : Theme.text-muted;
                        }
                        more_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { actions.open(body.width - 214px, root.head_h + 36px); }
                        }
                    }
                }
            }
        }
    }

    actions := TierRowActions {
        item: root.item;
        tier_selected(idx) => {
            root.keyboard_focus_index = idx;
            root.tier_selected(idx);
        }
    }
}
