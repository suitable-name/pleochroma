import { Theme } from "../../theme.slint";
import { KitButton, KitIcon } from "../kit/kit.slint";
import { MaterialReferenceModel } from "../../models/material_reference.slint";
import { WrapText, RefCard } from "common.slint";

// One design of the list: its title over its traced range. A click opens the design. It has the
// form of the Color Variants card's row (`VariantItem`), without the swatch.
component DesignItem inherits Rectangle {
    in property <string> title;
    in property <string> range;
    callback clicked();

    height: 46px;
    border-radius: Theme.radius-md;
    background: touch.has-hover ? Theme.bg-card-hover : Theme.surface-sunken;
    border-width: 1px;
    border-color: Theme.border-dialog;
    accessible-role: AccessibleRole.button;
    accessible-label: root.title;
    accessible-description: root.range;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: center;
            spacing: 1px;
            Text { text: root.title; font-size: 12px; font-weight: 600; color: Theme.text-primary; overflow: elide; }
            Text { text: root.range; font-size: 10px; color: Theme.text-muted; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            // A right chevron: the row opens the design.
            KitIcon {
                d: "M9 6 L15 12 L9 18";
                size: 14px;
                ink: Theme.text-muted;
            }
        }
    }
}

// Your designs that work here: the "Mine" designs whose traced RI range holds this material's
// index, each labelled as an estimate. Rust (`gui::material_reference::designs`) fills the rows.
// Before any range is computed the card says so and offers the batch.
export component DesignsCard inherits RefCard {
    title: "YOUR DESIGNS THAT WORK HERE";

    if MaterialReferenceModel.design_state == 0: VerticalLayout {
        spacing: 6px;
        for d in MaterialReferenceModel.design_rows: DesignItem {
            title: d.title;
            range: d.range;
            clicked => { MaterialReferenceModel.design_clicked(d.id); }
        }
        if MaterialReferenceModel.design_more > 0: Text {
            text: "and " + MaterialReferenceModel.design_more + " more";
            font-size: 11px;
            color: Theme.text-muted;
            accessible-role: AccessibleRole.text;
        }
    }
    if MaterialReferenceModel.design_state == 2: WrapText {
        text: "None of your designs with a computed RI range works in this material.";
        font-size: 12px;
        ink: Theme.text-secondary;
    }
    if MaterialReferenceModel.design_state == 1: VerticalLayout {
        spacing: 8px;
        WrapText {
            text: "No RI ranges computed yet";
            font-size: 12px;
            ink: Theme.text-secondary;
        }
        HorizontalLayout {
            alignment: start;
            KitButton {
                text: "Compute RI Ranges...";
                kind: 1;
                h: 28px;
                hint: "Trace the RI range of every design in Mine. This list then shows the designs that work in this material.";
                clicked => { MaterialReferenceModel.compute_ri_ranges(); }
            }
        }
    }
}
