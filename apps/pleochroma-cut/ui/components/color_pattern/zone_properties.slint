import { Theme } from "../../theme.slint";
import { ColorPatternModel } from "../../models/color_pattern.slint";
import { WrapText } from "../rough_planner/fields.slint";
import { PatternIcon, PatternIcons } from "icons.slint";
import { PatternUi } from "state.slint";
import { PatternButton, PatternCombo, PatternSlider } from "parts.slint";

// One color tile of the selected card: the color itself with a caption pill; a click opens the
// color picker for that slot. The tile being edited gets a cyan border.
component PatternColorButton inherits Rectangle {
    in property <color> fill;
    in property <string> caption;
    in property <string> hint;
    in property <bool> active: false;
    callback clicked();

    height: 64px;
    border-radius: 9px;
    background: root.fill;
    border-width: root.active || fs.has-focus ? 2px : 1px;
    border-color: root.active ? Theme.accent-cyan : (fs.has-focus ? Theme.accent-cyan-hover : (touch.has-hover ? Theme.text-secondary : (Theme.high-contrast ? Theme.border-medium : #ffffff22)));
    accessible-role: AccessibleRole.button;
    accessible-label: root.caption + " color";
    accessible-description: root.hint;
    accessible-action-default => { root.clicked(); }

    if root.hint != "": Tooltip { text: @markdown("\{root.hint}"); }
    fs := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    Rectangle {
        x: 6px;
        y: parent.height - 24px;
        width: cap.preferred-width + 14px;
        height: 18px;
        border-radius: 9px;
        background: Theme.high-contrast ? Theme.hud-surface : #000000a0;
        cap := Text {
            x: 7px;
            y: 0px;
            height: parent.height;
            text: root.caption;
            font-size: 11px;
            font-weight: 600;
            color: Theme.text-primary;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One shape choice of the Advanced card: an icon toggle with the shape's name in its tooltip.
component PatternShapeChoice inherits Rectangle {
    in property <string> d;
    in property <string> name;
    in property <bool> on: false;
    in property <bool> enabled: true;
    callback picked();

    property <string> tip: root.enabled ? root.name : root.name + ". The base layer has no shape: it fills the rest.";

    width: 36px;
    height: 32px;
    border-radius: 7px;
    background: root.on ? Theme.accent-cyan-surface : (touch.has-hover && root.enabled ? Theme.bg-card-hover : Theme.bg-card);
    border-width: fs.has-focus ? 2px : 1px;
    border-color: fs.has-focus ? Theme.accent-cyan-hover : (root.on ? Theme.accent-cyan : Theme.border-subtle);
    accessible-role: AccessibleRole.radio-button;
    accessible-label: root.name;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => {
        if root.enabled {
            root.picked();
        }
    }

    Tooltip { text: @markdown("\{root.tip}"); }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.picked();
                return accept;
            }
            return reject;
        }
    }
    PatternIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        d: root.d;
        size: 18px;
        ink: !root.enabled ? Theme.text-disabled : (root.on ? Theme.accent-cyan-hover : Theme.text-secondary);
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// The body of the selected layer card: the color tiles, the variant dropdown, the size slider
// (Simple) or the shape and its parameters (Advanced), and the validation sentence.
export component PatternCardBody inherits VerticalLayout {
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    spacing: 10px;

    Rectangle {
        height: 1px;
        background: Theme.border-subtle;
    }

    // --- Color --------------------------------------------------------------------------------
    HorizontalLayout {
        spacing: 6px;
        Text {
            text: "Color";
            font-size: 12px;
            font-weight: 600;
            color: Theme.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: ColorPatternModel.rank_text;
            font-size: 11px;
            color: Theme.text-muted;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }
    HorizontalLayout {
        spacing: 8px;
        for tile in ColorPatternModel.color_tiles: PatternColorButton {
            horizontal-stretch: 1;
            fill: tile.color;
            caption: tile.caption;
            hint: tile.from_variant
                ? "Change the " + tile.caption + " color. It stops following the material variant and becomes a custom color that starts from this one."
                : "Change the " + tile.caption + " color of this layer.";
            active: ColorPatternModel.picker_open && ColorPatternModel.picker_slot == tile.slot;
            clicked => {
                PatternUi.picker_y = self.absolute-position.y;
                ColorPatternModel.open_picker(tile.slot);
            }
        }
    }
    if ColorPatternModel.variant_caption != "": Text {
        text: ColorPatternModel.variant_caption;
        font-size: 11px;
        color: Theme.text-secondary;
        accessible-role: AccessibleRole.text;
    }
    if ColorPatternModel.legacy_notice: Rectangle {
        height: 40px;
        border-radius: 8px;
        background: Theme.surface-warning;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 6px;
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: "One color only (older pattern).";
                font-size: 12px;
                color: Theme.accent-amber;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: AccessibleRole.text;
            }
            VerticalLayout {
                alignment: center;
                PatternButton {
                    text: "Convert";
                    h: 28px;
                    hint: "Give this layer one color per crystal direction, starting from its single color, so it can show pleochroism.";
                    clicked => { ColorPatternModel.convert_legacy(); }
                }
            }
        }
    }
    if ColorPatternModel.variant_labels.length > 1: HorizontalLayout {
        spacing: 8px;
        Rectangle {
            width: 82px;
            Tooltip { text: @markdown("Where the colors of this layer come from: your own, or one of the color variants of this material. The layer keeps its own copy."); }
            Text {
                x: 0px;
                width: parent.width;
                height: parent.height;
                text: "From variant";
                font-size: 12px;
                color: Theme.text-secondary;
                vertical-alignment: center;
                accessible-role: AccessibleRole.text;
            }
        }
        PatternCombo {
            horizontal-stretch: 1;
            model: ColorPatternModel.variant_labels;
            current_index <=> ColorPatternModel.variant_index;
            label: "From variant";
            hint: "Where the colors of this layer come from: your own, or one of the color variants of this material. The layer keeps its own copy.";
            selected(index) => { ColorPatternModel.variant_picked(index); }
        }
    }

    // --- Simple: one Size slider ------------------------------------------------------------------
    if !ColorPatternModel.show_advanced: PatternSlider {
        label: "Size";
        hint: ColorPatternModel.size_enabled
            ? "How large the layer is. It scales with the stone unless the pattern is fixed in millimeters."
            : "The base layer fills everything the other layers do not cover.";
        enabled: ColorPatternModel.size_enabled;
        minimum: ColorPatternModel.size_min;
        maximum: ColorPatternModel.size_max;
        step: ColorPatternModel.size_step;
        value <=> ColorPatternModel.size_value;
        value_text: ColorPatternModel.size_text;
        moved(v) => { ColorPatternModel.size_changed(v); }
    }

    // --- Advanced: the shape and its parameters -----------------------------------------------------
    if ColorPatternModel.show_advanced: VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 6px;
            Rectangle {
                width: 58px;
                Tooltip { text: @markdown("The form of the layer. The base layer has no shape: it fills the rest."); }
                Text {
                    x: 0px;
                    width: parent.width;
                    height: parent.height;
                    text: "Shape";
                    font-size: 12px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                    accessible-role: AccessibleRole.text;
                }
            }
            for shape[i] in ColorPatternModel.shape_options: PatternShapeChoice {
                d: PatternIcons.shape(i);
                name: shape;
                on: ColorPatternModel.shape_enabled && i == ColorPatternModel.shape_index;
                enabled: ColorPatternModel.shape_enabled;
                picked => {
                    ColorPatternModel.shape_index = i;
                    ColorPatternModel.shape_changed(i);
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        for row[i] in ColorPatternModel.param_rows: PatternSlider {
            label: row.label;
            hint: row.hint;
            enabled: row.enabled;
            minimum: row.min;
            maximum: row.max;
            step: row.step;
            value: row.value;
            value_text: row.text + " " + row.unit;
            moved(v) => { ColorPatternModel.param_changed(i, v); }
        }
    }

    // --- Validation sentence ------------------------------------------------------------------------
    if ColorPatternModel.message != "": Rectangle {
        border-radius: 8px;
        background: Theme.surface-warning;
        preferred-height: msg.height + 14px;
        accessible-role: AccessibleRole.text;
        accessible-label: ColorPatternModel.message;
        msg := WrapText {
            x: 10px;
            y: 7px;
            width: parent.width - 20px;
            text: ColorPatternModel.message;
            font_size: 12px;
            text_color: Theme.accent-amber;
        }
    }
}
