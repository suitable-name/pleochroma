// The transient, window-only state of the Color Pattern editor: which menu is open and where,
// which card is being renamed or dragged. Rust never sees any of it (the model keeps what Rust
// owns). A global exists once per top-level window, so this is the Color Pattern window's own.
export global PatternUi {
    // The Add menu under the "Add" button; `add_x` and `add_y` are its top-left corner in window
    // coordinates.
    in-out property <bool> add_open: false;
    in-out property <length> add_x: 0px;
    in-out property <length> add_y: 0px;
    // The view index of the card whose ⋯ menu is open, or -1.
    in-out property <int> menu_row: -1;
    in-out property <length> menu_x: 0px;
    in-out property <length> menu_y: 0px;
    // The view index of the card whose name is being edited, or -1.
    in-out property <int> rename_row: -1;
    // Drag to reorder: the card being dragged, the index it would land at, or -1 for both.
    in-out property <int> drag_from: -1;
    in-out property <int> drag_target: -1;
    // The window y of the color tile that opened the picker (the popover sits level with it).
    in-out property <length> picker_y: 0px;
}
