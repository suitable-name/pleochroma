import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { ColorPatternModel, PatternVariantChip } from "../../models/color_pattern.slint";
import { WrapText } from "../rough_planner/fields.slint";
import { PatternIcon, PatternIcons } from "icons.slint";
import { PatternButton, PatternIconButton, PatternChip, PatternGlass } from "parts.slint";

// A number field of the picker: a caption and a 28 px LineEdit. Enter, or leaving the field with
// a changed text, commits it; the shown value is written again whenever Rust changes it.
component PatternNumField inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> hint;
    in property <length> field_width: 44px;
    callback committed(string);

    spacing: 5px;
    Text {
        text: root.label;
        font-size: 12px;
        color: Theme.text-secondary;
        vertical-alignment: center;
        horizontal-stretch: 0;
    }
    Rectangle {
        width: root.field_width;
        height: 28px;
        Tooltip { text: @markdown("\{root.hint}"); }
        edit := LineEdit {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: root.value;
            font-size: 12px;
            accessible-label: root.hint;
            accepted(typed) => {
                if typed != root.value {
                    root.committed(typed);
                }
            }
            changed has-focus => {
                if !self.has-focus && self.text != root.value {
                    root.committed(self.text);
                }
            }
        }
    }
    changed value => { edit.text = root.value; }
}

// One material variant offered in the picker: a click copies its color for this direction.
component PatternVariantChipView inherits Rectangle {
    in property <string> text;
    in property <color> a;
    in property <color> b;
    callback picked();

    height: 28px;
    width: lay.preferred-width;
    border-radius: 14px;
    background: touch.has-hover ? Theme.bg-card-hover : Theme.bg-card;
    border-width: fs.has-focus ? 2px : 1px;
    border-color: fs.has-focus ? Theme.accent-cyan-hover : Theme.border-subtle;
    accessible-role: AccessibleRole.button;
    accessible-label: root.text;
    accessible-description: "Use the color of the " + root.text + " variant for this direction.";
    accessible-action-default => { root.picked(); }

    Tooltip { text: @markdown("Use the color of the \{root.text} variant for this direction."); }
    fs := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.picked();
                return accept;
            }
            return reject;
        }
    }
    lay := HorizontalLayout {
        padding-left: 5px;
        padding-right: 10px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            PatternChip {
                a: root.a;
                b: root.b;
                split: true;
                size: 18px;
            }
        }
        Text {
            text: root.text;
            font-size: 12px;
            color: Theme.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.picked(); }
    }
}

// The color picker popover: the LCh plane (chroma to the right, lightness up, out-of-sRGB dimmed)
// at the current hue, the hue strip, the L / C / H and hex fields, the material variants and what
// the stone will show for the picked color. The window anchors it left of the layers panel, level
// with the tile that opened it. Keyboard: the plane takes the arrow keys (Left and Right chroma,
// Up and Down lightness; Shift for bigger steps), the hue strip Left and Right.
export component PatternPicker inherits Rectangle {
    width: 312px;
    height: play.preferred-height;
    background: Theme.surface-dialog;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.border-dialog;
    drop-shadow-blur: 30px;
    drop-shadow-color: Theme.modal-shadow;
    drop-shadow-offset-y: 10px;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: ColorPatternModel.picker_title;

    play := VerticalLayout {
        padding: 14px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                PatternIcon { d: PatternIcons.c-axis; size: 16px; ink: Theme.accent-cyan; }
            }
            Text {
                horizontal-stretch: 1;
                text: ColorPatternModel.picker_title;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text-primary;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: AccessibleRole.text;
            }
            PatternIconButton {
                d: PatternIcons.close;
                size: 26px;
                icon_size: 14px;
                label: "Cancel";
                hint: "Close the picker without changing the color. Escape does the same.";
                clicked => { ColorPatternModel.picker_cancelled(); }
            }
        }

        // --- The LCh plane ---------------------------------------------------------------------------
        Rectangle {
            height: 150px;
            border-radius: 8px;
            accessible-role: AccessibleRole.slider;
            accessible-label: "Chroma and lightness";
            accessible-description: "Left and right change the chroma, up and down the lightness. Hold Shift for bigger steps.";
            accessible-value: "Lightness " + Math.round(ColorPatternModel.picker_l) + ", chroma " + Math.round(ColorPatternModel.picker_c);
            Tooltip { text: @markdown("Click or drag to pick the color: chroma (how colorful) to the right, lightness up. The dimmed area cannot be shown on a screen."); }
            Rectangle {
                border-radius: 8px;
                clip: true;
                Image {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    source: ColorPatternModel.picker_plane;
                    image-fit: fill;
                }
            }
            plane_keys := FocusScope {
                init => { self.focus(); }
                key-pressed(event) => {
                    if event.text == Key.LeftArrow {
                        ColorPatternModel.picker_lch_changed(ColorPatternModel.picker_l, Math.max(0, ColorPatternModel.picker_c - (event.modifiers.shift ? 10 : 2)), ColorPatternModel.picker_h);
                        return accept;
                    }
                    if event.text == Key.RightArrow {
                        ColorPatternModel.picker_lch_changed(ColorPatternModel.picker_l, Math.min(150, ColorPatternModel.picker_c + (event.modifiers.shift ? 10 : 2)), ColorPatternModel.picker_h);
                        return accept;
                    }
                    if event.text == Key.UpArrow {
                        ColorPatternModel.picker_lch_changed(Math.min(100, ColorPatternModel.picker_l + (event.modifiers.shift ? 10 : 2)), ColorPatternModel.picker_c, ColorPatternModel.picker_h);
                        return accept;
                    }
                    if event.text == Key.DownArrow {
                        ColorPatternModel.picker_lch_changed(Math.max(0, ColorPatternModel.picker_l - (event.modifiers.shift ? 10 : 2)), ColorPatternModel.picker_c, ColorPatternModel.picker_h);
                        return accept;
                    }
                    return reject;
                }
            }
            Rectangle {
                x: Math.clamp(ColorPatternModel.picker_c / 150, 0, 1) * parent.width - 8px;
                y: (1 - Math.clamp(ColorPatternModel.picker_l / 100, 0, 1)) * parent.height - 8px;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: 2px;
                border-color: plane_keys.has-focus ? Theme.accent-cyan-hover : #ffffff;
                drop-shadow-blur: 3px;
                drop-shadow-color: #000000;
            }
            PatternGlass {
                x: parent.width - self.width - 6px;
                y: parent.height - self.height - 6px;
                width: chroma_tag.preferred-width + 14px;
                height: 20px;
                border-radius: 5px;
                chroma_tag := Text {
                    x: 7px;
                    y: 0px;
                    height: parent.height;
                    text: "Chroma";
                    font-size: 11px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: MouseCursor.crosshair;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        plane_keys.focus();
                        ColorPatternModel.picker_plane_pointer(Math.clamp(self.mouse-x / max(self.width, 1px), 0, 1), Math.clamp(self.mouse-y / max(self.height, 1px), 0, 1), 0);
                    } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                        ColorPatternModel.picker_plane_pointer(Math.clamp(self.mouse-x / max(self.width, 1px), 0, 1), Math.clamp(self.mouse-y / max(self.height, 1px), 0, 1), 2);
                    }
                }
                moved => {
                    if self.pressed {
                        ColorPatternModel.picker_plane_pointer(Math.clamp(self.mouse-x / max(self.width, 1px), 0, 1), Math.clamp(self.mouse-y / max(self.height, 1px), 0, 1), 1);
                    }
                }
            }
        }

        // --- The hue strip ------------------------------------------------------------------------------
        Rectangle {
            height: 14px;
            accessible-role: AccessibleRole.slider;
            accessible-label: "Hue";
            accessible-description: "Left and right change the hue by 5 degrees.";
            accessible-value: "" + Math.round(ColorPatternModel.picker_h) + " degrees";
            Tooltip { text: @markdown("Click or drag to pick the hue, the basic color, from red through green and blue back to red."); }
            Rectangle {
                border-radius: 7px;
                clip: true;
                Image {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    source: ColorPatternModel.picker_hue_strip;
                    image-fit: fill;
                }
            }
            hue_keys := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.LeftArrow {
                        ColorPatternModel.picker_lch_changed(ColorPatternModel.picker_l, ColorPatternModel.picker_c, Math.mod(ColorPatternModel.picker_h + 355, 360));
                        return accept;
                    }
                    if event.text == Key.RightArrow {
                        ColorPatternModel.picker_lch_changed(ColorPatternModel.picker_l, ColorPatternModel.picker_c, Math.mod(ColorPatternModel.picker_h + 5, 360));
                        return accept;
                    }
                    return reject;
                }
            }
            Rectangle {
                x: Math.clamp(ColorPatternModel.picker_h / 360, 0, 1) * parent.width - 7px;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                border-width: 2px;
                border-color: hue_keys.has-focus ? Theme.accent-cyan-hover : #ffffff;
                drop-shadow-blur: 3px;
                drop-shadow-color: #000000;
            }
            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        hue_keys.focus();
                        ColorPatternModel.picker_hue_pointer(Math.clamp(self.mouse-x / max(self.width, 1px), 0, 1), 0);
                    } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                        ColorPatternModel.picker_hue_pointer(Math.clamp(self.mouse-x / max(self.width, 1px), 0, 1), 2);
                    }
                }
                moved => {
                    if self.pressed {
                        ColorPatternModel.picker_hue_pointer(Math.clamp(self.mouse-x / max(self.width, 1px), 0, 1), 1);
                    }
                }
            }
        }

        // --- L, C, H and hex ---------------------------------------------------------------------------------
        VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
            spacing: 10px;
            PatternNumField {
                label: "L";
                value: "" + Math.round(ColorPatternModel.picker_l);
                hint: "Lightness, 0 (black) to 100 (white).";
                field_width: 52px;
                committed(text) => {
                    if text.is-float() {
                        ColorPatternModel.picker_lch_changed(Math.clamp(text.to-float(), 0, 100), ColorPatternModel.picker_c, ColorPatternModel.picker_h);
                    }
                }
            }
            PatternNumField {
                label: "C";
                value: "" + Math.round(ColorPatternModel.picker_c);
                hint: "Chroma, how colorful: 0 is grey, about 100 is the most vivid a screen shows.";
                field_width: 52px;
                committed(text) => {
                    if text.is-float() {
                        ColorPatternModel.picker_lch_changed(ColorPatternModel.picker_l, Math.clamp(text.to-float(), 0, 150), ColorPatternModel.picker_h);
                    }
                }
            }
            PatternNumField {
                label: "H";
                value: "" + Math.round(ColorPatternModel.picker_h);
                hint: "Hue in degrees, 0 to 360.";
                field_width: 52px;
                committed(text) => {
                    if text.is-float() {
                        ColorPatternModel.picker_lch_changed(ColorPatternModel.picker_l, ColorPatternModel.picker_c, Math.mod(Math.mod(text.to-float(), 360) + 360, 360));
                    }
                }
            }
            }
            HorizontalLayout {
                spacing: 5px;
                Text {
                    width: 28px;
                    text: "Hex";
                    font-size: 12px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 28px;
                    Tooltip { text: @markdown("The color as a web hex code such as #d64880. Press Enter to use it."); }
                    LineEdit {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        text <=> ColorPatternModel.picker_hex;
                        font-size: 12px;
                        placeholder-text: "#RRGGBB";
                        accessible-label: "Hex color";
                        accepted(value) => { ColorPatternModel.picker_hex_committed(value); }
                        changed has-focus => {
                            if !self.has-focus {
                                ColorPatternModel.picker_hex_committed(self.text);
                            }
                        }
                    }
                }
            }
        }

        // --- Material variants ---------------------------------------------------------------------------------
        if ColorPatternModel.picker_variants.length > 0: VerticalLayout {
            spacing: 6px;
            Text {
                text: "Material variants";
                font-size: 12px;
                font-weight: 600;
                color: Theme.text-secondary;
                accessible-role: AccessibleRole.text;
            }
            ScrollView {
                height: 44px;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    for v[i] in ColorPatternModel.picker_variants: PatternVariantChipView {
                        text: v.label;
                        a: v.along;
                        b: v.across;
                        picked => { ColorPatternModel.picker_variant_picked(i); }
                    }
                }
            }
        }

        // --- What the stone shows -------------------------------------------------------------------------------------
        Rectangle {
            height: 60px;
            border-radius: 9px;
            background: Theme.bg-card;
            accessible-role: AccessibleRole.text;
            accessible-label: ColorPatternModel.picker_result_text;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    PatternChip { a: ColorPatternModel.picker_result_from; size: 30px; }
                }
                VerticalLayout {
                    alignment: center;
                    PatternIcon { d: PatternIcons.arrow-right; size: 14px; ink: Theme.text-muted; }
                }
                VerticalLayout {
                    alignment: center;
                    PatternChip { a: ColorPatternModel.picker_result_to; size: 30px; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 1px;
                    if ColorPatternModel.picker_solving: Text {
                        text: "Solving\u{2026}";
                        font-size: 11px;
                        color: Theme.accent-amber;
                    }
                    WrapText {
                        text: ColorPatternModel.picker_result_text;
                        font_size: 11px;
                        text_color: Theme.text-primary;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            PatternButton {
                text: "Cancel";
                ghost: true;
                hint: "Close the picker without changing the color. Escape does the same.";
                clicked => { ColorPatternModel.picker_cancelled(); }
            }
            PatternButton {
                text: "Use Color";
                primary: true;
                hint: "Use this color for the layer.";
                clicked => { ColorPatternModel.picker_applied(); }
            }
        }
    }
}
