import { Theme } from "../../theme.slint";

// The kit's icons (used by the Color Pattern and Rough Planner windows), drawn as 24 x 24
// `Path` strokes rather than Unicode glyphs, and the component that draws one.
export global KitIcons {
    out property <string> undo: "M9 14 L4 9 L9 4 M4 9 H15 A5 5 0 0 1 15 19 H11";
    out property <string> redo: "M15 14 L20 9 L15 4 M20 9 H9 A5 5 0 0 0 9 19 H13";
    out property <string> eye: "M2 12 C5 6 19 6 22 12 C19 18 5 18 2 12 Z M12 9.5 A2.5 2.5 0 1 0 12 14.5 A2.5 2.5 0 1 0 12 9.5 Z";
    out property <string> eye-off: "M2 12 C5 6 19 6 22 12 C19 18 5 18 2 12 Z M4 4 L20 20";
    out property <string> lock: "M6 11 H18 V20 H6 Z M8.5 11 V8 A3.5 3.5 0 0 1 15.5 8 V11";
    out property <string> plus: "M12 5 V19 M5 12 H19";
    out property <string> close: "M6 6 L18 18 M18 6 L6 18";
    out property <string> more: "M5 12 H5.5 M12 12 H12.5 M19 12 H19.5";
    out property <string> chevron-down: "M6 9 L12 15 L18 9";
    out property <string> chevron-right: "M9 6 L15 12 L9 18";
    out property <string> check: "M5 12.5 L10 17 L19 7";
    out property <string> info: "M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M12 11 V16.5 M12 7.5 V8";
    out property <string> help: "M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M9.5 9.5 A2.5 2.5 0 1 1 12 12 V13.5 M12 16.5 V17";
    out property <string> star: "M12 3 L14.6 9 L21 9.5 L16 13.6 L17.6 20 L12 16.6 L6.4 20 L8 13.6 L3 9.5 L9.4 9 Z";
    out property <string> grid: "M4 4 H10 V10 H4 Z M14 4 H20 V10 H14 Z M4 14 H10 V20 H4 Z M14 14 H20 V20 H14 Z";
    out property <string> expand: "M14 4 H20 V10 M10 20 H4 V14 M20 4 L13 11 M4 20 L11 13";
    out property <string> front: "M6 6 H18 V18 H6 Z";
    out property <string> top: "M4 9 L12 5 L20 9 L12 13 Z";
    out property <string> side: "M8 4 L16 7 V20 L8 17 Z";
    out property <string> reset: "M5 12 A7 7 0 1 0 8 6.3 M5 4 V9 H10";
    out property <string> library: "M5 4 V20 M10 4 V20 M14 5 L19 19";
    out property <string> block: "M4 8 L12 4 L20 8 V16 L12 20 L4 16 Z M4 8 L12 12 L20 8 M12 12 V20";
    out property <string> cylinder: "M5 6 A7 2.5 0 0 0 19 6 A7 2.5 0 0 0 5 6 Z M5 6 V18 A7 2.5 0 0 0 19 18 V6";
    out property <string> pebble: "M6 9 C6 4 15 3 18 7 C21 11 19 18 13 19 C7 20 4 15 6 9 Z";
    out property <string> scan: "M12 3 L20 8 L18 18 L7 20 L4 10 Z M12 3 L11 12 L18 18 M11 12 L4 10 M11 12 L7 20";
    out property <string> edge: "M4 9 L9 4 H20 V15 L15 20 H4 Z M9 4 L4 9";
    out property <string> corner: "M4 4 H14 L20 10 V20 H4 Z";
    out property <string> face: "M4 4 H20 V20 H4 Z M4 14 L20 8";
    out property <string> axis: "M12 21 V3 M8 7 L12 3 L16 7 M6 15 L18 15";
    out property <string> oval: "M12 3 A6.5 9 0 1 0 12 21 A6.5 9 0 1 0 12 3 Z M12 7 A3.2 5 0 1 0 12 17 A3.2 5 0 1 0 12 7 Z";
    out property <string> cushion: "M8 3 H16 Q20 3 20 7 V17 Q20 21 16 21 H8 Q4 21 4 17 V7 Q4 3 8 3 Z M9 8 H15 V16 H9 Z";
}

// One icon: a stroked `Path` in a square.
export component KitIcon inherits Rectangle {
    in property <string> d;
    in property <color> ink: Theme.text-secondary;
    in property <length> size: 16px;
    in property <length> stroke: 1.7px;
    width: root.size;
    height: root.size;
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.d;
        stroke: root.ink;
        stroke-width: root.stroke;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }
}
