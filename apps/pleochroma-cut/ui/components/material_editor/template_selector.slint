import { ComboBox, LineEdit } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { PhysicscolorModel } from "../../models/physics_color.slint";
import { TipBox, FieldCaption } from "../tip_box.slint";

// Base template selector (a preset combo that fills every optics field at once) and the
// Material Name input. Each field the preset writes is two-way bound to the identically named
// property of `MaterialEditorDialog`.
export component MaterialTemplateSelector inherits VerticalLayout {
    spacing: 6px;

    // "Custom" (start from the values as they are) stays first on purpose; the gems after it
    // are alphabetical. The `selected` handler below works on the picked NAME, and index 0
    // ("Custom") is the dialog's default and its unchanged baseline.
    in property <[string]> base_templates: [
        "Custom", "Cubic Zirconia", "Diamond", "Emerald", "Quartz", "Ruby", "Sapphire",
        "Spinel", "Synthetic Moissanite", "Tanzanite", "Topaz", "Zircon"
    ];

    in-out property <int> selected_template_idx: 0;
    in-out property <string> mat_name: "Custom Diamond";
    in-out property <float> ri_val: 2.417;
    // Fraunhofer F-C dispersion, n(486.1 nm) - n(656.3 nm): the convention
    // `GemMaterial::new_custom` reads, and the one every template below carries.
    // The initial value is the two-way-bound dialog property's, which owns it.
    in-out property <float> disp_val: 0.0256;
    in-out property <float> biref_val: 0.000;
    in-out property <int> selected_color_preset: 0;
    in-out property <int> selected_crystal_system_idx: 0;
    in-out property <int> selected_optical_character_idx: 0;
    in-out property <float> biaxial_delta_beta_alpha_val: 0.0;

    // Fills every optics field from the template `val`, exactly as picking it in the combo
    // does. A name that is no template changes nothing.
    public function apply_template(val: string) {
        // Crystal system indices: 0 Cubic, 1 Tetragonal, 2 Hexagonal, 3 Trigonal,
        // 4 Orthorhombic, 5 Monoclinic, 6 Triclinic. Optical character indices:
        // 0 Isotropic, 1 Uniaxial(+), 2 Uniaxial(-), 3 Biaxial(+), 4 Biaxial(-).
        // Both follow the variant order of `pleochroma::optics::materials::
        // {CrystalSystem, OpticalCharacter}` (see `gui::optics::crystal_optics`).
        // Each preset's values are its real classification from its built-in entry
        // in `crates/pleochroma/src/optics/materials/`. `disp_val` is the Fraunhofer
        // F-C interval, not the wider gemological B-G figure.
        if (val == "Diamond") {
            root.mat_name = "Custom Diamond";
            root.ri_val = 2.417;
            root.disp_val = 0.0256;
            root.biref_val = 0.000;
            root.selected_color_preset = 0;
            root.selected_crystal_system_idx = 0; // Cubic
            root.selected_optical_character_idx = 0; // Isotropic
            root.biaxial_delta_beta_alpha_val = 0.0;
        } else if (val == "Sapphire") {
            root.mat_name = "Custom Sapphire";
            root.ri_val = 1.768;
            root.disp_val = 0.0106;
            root.biref_val = -0.008;
            root.selected_color_preset = 1;
            root.selected_crystal_system_idx = 3; // Trigonal
            root.selected_optical_character_idx = 2; // Uniaxial(-)
            root.biaxial_delta_beta_alpha_val = 0.0;
        } else if (val == "Ruby") {
            root.mat_name = "Custom Ruby";
            root.ri_val = 1.768;
            root.disp_val = 0.0106;
            root.biref_val = -0.008;
            root.selected_color_preset = 2;
            root.selected_crystal_system_idx = 3; // Trigonal
            root.selected_optical_character_idx = 2; // Uniaxial(-)
            root.biaxial_delta_beta_alpha_val = 0.0;
        } else if (val == "Emerald") {
            root.mat_name = "Custom Emerald";
            root.ri_val = 1.577;
            root.disp_val = 0.0082;
            root.biref_val = -0.006;
            root.selected_color_preset = 3;
            root.selected_crystal_system_idx = 2; // Hexagonal
            root.selected_optical_character_idx = 2; // Uniaxial(-)
            root.biaxial_delta_beta_alpha_val = 0.0;
        } else if (val == "Tanzanite") {
            root.mat_name = "Custom Tanzanite";
            root.ri_val = 1.691;
            root.disp_val = 0.0174;
            root.biref_val = 0.013;
            root.selected_color_preset = 4;
            root.selected_crystal_system_idx = 4; // Orthorhombic
            root.selected_optical_character_idx = 3; // Biaxial(+)
            root.biaxial_delta_beta_alpha_val = 0.0070;
        } else if (val == "Synthetic Moissanite") {
            root.mat_name = "Custom Moissanite";
            root.ri_val = 2.650;
            root.disp_val = 0.0635;
            root.biref_val = 0.043;
            root.selected_color_preset = 0;
            root.selected_crystal_system_idx = 2; // Hexagonal
            root.selected_optical_character_idx = 1; // Uniaxial(+)
            root.biaxial_delta_beta_alpha_val = 0.0;
        } else if (val == "Zircon") {
            root.mat_name = "Custom Zircon";
            root.ri_val = 1.950;
            root.disp_val = 0.0226;
            root.biref_val = 0.059;
            root.selected_color_preset = 7;
            root.selected_crystal_system_idx = 1; // Tetragonal
            root.selected_optical_character_idx = 1; // Uniaxial(+)
            root.biaxial_delta_beta_alpha_val = 0.0;
        } else if (val == "Topaz") {
            root.mat_name = "Custom Topaz";
            root.ri_val = 1.620;
            root.disp_val = 0.0082;
            root.biref_val = 0.008;
            root.selected_color_preset = 8;
            root.selected_crystal_system_idx = 4; // Orthorhombic
            root.selected_optical_character_idx = 3; // Biaxial(+)
            root.biaxial_delta_beta_alpha_val = 0.0024;
        } else if (val == "Spinel") {
            root.mat_name = "Custom Spinel";
            root.ri_val = 1.718;
            root.disp_val = 0.0118;
            root.biref_val = 0.000;
            root.selected_color_preset = 6;
            root.selected_crystal_system_idx = 0; // Cubic
            root.selected_optical_character_idx = 0; // Isotropic
            root.biaxial_delta_beta_alpha_val = 0.0;
        } else if (val == "Quartz") {
            root.mat_name = "Custom Quartz";
            root.ri_val = 1.544;
            root.disp_val = 0.0078;
            root.biref_val = 0.009;
            root.selected_color_preset = 0;
            root.selected_crystal_system_idx = 3; // Trigonal
            root.selected_optical_character_idx = 1; // Uniaxial(+)
            root.biaxial_delta_beta_alpha_val = 0.0;
        } else if (val == "Cubic Zirconia") {
            root.mat_name = "Custom CZ";
            root.ri_val = 2.160;
            root.disp_val = 0.0346;
            root.biref_val = 0.000;
            root.selected_color_preset = 0;
            root.selected_crystal_system_idx = 0; // Cubic
            root.selected_optical_character_idx = 0; // Isotropic
            root.biaxial_delta_beta_alpha_val = 0.0;
        }
        // Every template but "Custom" brings its own color. With the physics editor
        // hidden, that color replaces a physics recipe's color (the recipe stays
        // saved); in every other case the index comes back unchanged.
        if (val != "Custom") {
            root.selected_color_preset = PhysicscolorModel.color_preset_chosen(root.selected_color_preset);
        }
        // In Physics mode a built-in template also preselects its host crystal
        // (the catalogue maps built-in materials to hosts); a no-op otherwise.
        PhysicscolorModel.template_selected(val);
    }

    // Selects the entry named `name` in the combo and loads it, as if it had been picked. A name
    // that is no entry leaves the dialog as it is.
    public function choose_template(name: string) {
        if (name == "Custom") { root.selected_template_idx = 0; }
        else if (name == "Cubic Zirconia") { root.selected_template_idx = 1; }
        else if (name == "Diamond") { root.selected_template_idx = 2; }
        else if (name == "Emerald") { root.selected_template_idx = 3; }
        else if (name == "Quartz") { root.selected_template_idx = 4; }
        else if (name == "Ruby") { root.selected_template_idx = 5; }
        else if (name == "Sapphire") { root.selected_template_idx = 6; }
        else if (name == "Spinel") { root.selected_template_idx = 7; }
        else if (name == "Synthetic Moissanite") { root.selected_template_idx = 8; }
        else if (name == "Tanzanite") { root.selected_template_idx = 9; }
        else if (name == "Topaz") { root.selected_template_idx = 10; }
        else if (name == "Zircon") { root.selected_template_idx = 11; }
        else { return; }
        root.apply_template(name);
    }

    HorizontalLayout {
    spacing: 10px;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 4px;
        FieldCaption {
            text: "Load Preset Template:";
            hint: "Fill in every optical value from a well-known gem, then change what you like. Pick Custom to start from the values as they are.";
        }

        TipBox {
            hint: "Pick a gem to start from.";

            ComboBox {
                model: root.base_templates;
                current-index <=> root.selected_template_idx;
                accessible-label: "Preset Template";
                selected(val) => {
                    root.apply_template(val);
                }
            }
        }
    }

    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 4px;
        FieldCaption {
            text: "Material Name:";
            hint: "The name this material is saved under. It cannot be empty, and it cannot be the name of a built-in material.";
        }

        TipBox {
            hint: "Type the name to save the material under.";

            LineEdit {
                text <=> root.mat_name;
                placeholder-text: "Enter gem name...";
                accessible-label: "Material Name";
            }
        }
    }
    }
    if root.selected_template_idx != 0: Text {
        text: "Templates fill the optics only. Other gem data stays as entered.";
        font-size: 10px;
        color: Theme.text-muted;
        wrap: word-wrap;
        accessible-role: AccessibleRole.text;
    }
}
