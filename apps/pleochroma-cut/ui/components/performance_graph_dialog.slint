import { ScrollView, CheckBox, Button } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { TiltModel, TiltVideoExportModel } from "../models/tilt.slint";
import { ViewportModel } from "../models/viewport.slint";
import { HelpTopics } from "../models/help.slint";
import { StaleBadge } from "stale_badge.slint";
import { HelpButton } from "help_button.slint";
import { IconButton } from "icon_button.slint";
import { ChipToggle, ActionButton } from "chip_toggle.slint";
import { TiltCurveChart } from "performance_graph/tilt_curve_chart.slint";
import { TiltVideoExportSection } from "performance_graph/tilt_video_export_section.slint";

export component PerformanceGraphDialog inherits Rectangle {
    // Azimuth-0 sweep; the other three are in `graph_*_extra_axes`. Kept flat because the
    // Parameters panel's mini tilt chart binds to this property too, so its meaning is fixed.
    in property <[float]> graph_brilliance: TiltModel.graph_brilliance;
    in property <[float]> graph_extinction: TiltModel.graph_extinction;
    in property <[float]> graph_windowing: TiltModel.graph_windowing;
    // SVG path-data strings (`M x y L x y ...`) for the same three curves, built by
    // `curve_path::tilt_curve_path` in a 0..100 x 0..100 viewbox.
    in property <string> graph_brilliance_path: TiltModel.graph_brilliance_path;
    in property <string> graph_extinction_path: TiltModel.graph_extinction_path;
    in property <string> graph_windowing_path: TiltModel.graph_windowing_path;
    // One row per camera azimuth (0/45/90/135 deg, `PROFILE_AZIMUTHS_DEG`), each over the full
    // +-90 deg tilt range at 1 deg steps (181 points, `TILT_ANGLES_DEG`). Computed off the UI
    // thread by `gui::tilt::tilt_profile` while the dialog is open. Empty until ready: check
    // `extra_axes_ready`, not the length. Axis 0 is included because the live `graph_*` values
    // only cover 0..90 deg.
    in property <[[float]]> graph_brilliance_extra_axes: TiltModel.graph_brilliance_extra_axes;
    in property <[[float]]> graph_extinction_extra_axes: TiltModel.graph_extinction_extra_axes;
    in property <[[float]]> graph_windowing_extra_axes: TiltModel.graph_windowing_extra_axes;
    in property <[string]> graph_brilliance_extra_paths: TiltModel.graph_brilliance_extra_paths;
    in property <[string]> graph_extinction_extra_paths: TiltModel.graph_extinction_extra_paths;
    in property <[string]> graph_windowing_extra_paths: TiltModel.graph_windowing_extra_paths;
    in property <bool> extra_axes_loading: TiltModel.extra_axes_loading;
    // True when the swept geometry, material or light changed since the last finished sweep
    // (`AxesCacheKey` in `gui::tilt::tilt_profile`).
    in property <bool> curves_stale: TiltModel.curves_stale;
    in property <float> cam_pitch_deg: TiltModel.cam_pitch_deg;
    in property <string> material_name: ViewportModel.material_options[ViewportModel.selected_material_index];

    // Sweeps the tilt curve again with the loaded inputs, even when they match the last sweep.
    callback rerender_curve_with_current_material();
    rerender_curve_with_current_material => { TiltModel.rerender_curve_with_current_material(); }

    // Stone preview at the hovered angle, rendered off the UI thread by
    // `gui::tilt::tilt_hover_preview`. Keeps its last image between hovers; the panel is only
    // shown while hovering.
    in property <image> tilt_hover_preview_image: TiltModel.hover_preview_image;
    // Requests a preview for `(axis_index, tilt_deg)`. The worker debounces, so calling this on
    // every hovered pixel is safe.
    callback request_tilt_hover_preview(int, float);
    request_tilt_hover_preview(a, t) => { TiltModel.request_tilt_hover_preview(a, t); }

    in-out property <bool> show_brilliance: true;
    in-out property <bool> show_windowing: true;
    in-out property <bool> show_extinction: true;

    // Which of the four camera azimuths is plotted -- directly indexes
    // `graph_*_extra_axes`/`graph_*_extra_paths`. Dialog-local UI state, not
    // forwarded from Rust: nothing outside this dialog needs to know which axis is
    // on screen.
    in-out property <int> selected_axis_index: 0;
    // "All" overlay: draws all four azimuth sweeps of every visible channel at once,
    // fading every axis except `selected_axis_index`.
    in-out property <bool> show_all_axes: false;

    // Export tilt video section, below the chart. Its expansion and large-run guard reset on
    // each open (the dialog is re-created). Other video settings live on `TiltVideoExportModel`
    // and persist across opens.
    in-out property <bool> video_export_expanded: false;
    // A run over 2000 frames first only arms this and shows a confirmation banner; a second
    // click starts it.
    in-out property <bool> confirmed_large_run: false;

    property <[string]> axis_labels: ["0° (length)", "45°", "90° (width)", "135°"];
    property <string> selected_axis_label: root.axis_labels[root.selected_axis_index];
    // Below 900px the channel/axis pill rows put their caption on its own line and
    // use short labels. `root` is pinned to the full backdrop by its parent, so
    // reading its width here cannot loop.
    property <bool> narrow: root.width < 900px;
    property <[string]> axis_short_labels: ["0°", "45°", "90°", "135°"];
    // True once all four sweeps have arrived. Guards the axis pills, the badges and the chart:
    // no axis has a fallback, since even axis 0 needs its negative half swept.
    property <bool> extra_axes_ready: root.graph_brilliance_extra_axes.length >= 4
        && root.graph_extinction_extra_axes.length >= 4
        && root.graph_windowing_extra_axes.length >= 4;

    // The currently-selected axis's data, in the flat shape the summary badges and
    // hover tooltip's interpolation both want. Only meaningful once
    // `extra_axes_ready` -- callers gate on that themselves.
    property <[float]> active_brilliance_values: root.graph_brilliance_extra_axes[root.selected_axis_index];
    property <[float]> active_extinction_values: root.graph_extinction_extra_axes[root.selected_axis_index];
    property <[float]> active_windowing_values: root.graph_windowing_extra_axes[root.selected_axis_index];
    property <string> active_brilliance_path: root.graph_brilliance_extra_paths[root.selected_axis_index];
    property <string> active_extinction_path: root.graph_extinction_extra_paths[root.selected_axis_index];
    property <string> active_windowing_path: root.graph_windowing_extra_paths[root.selected_axis_index];

    // Linear interpolation and pixel-to-angle snapping for the tilt chart's hover
    // readout (`interpolated_value`/`snap_tilt_deg`) live on `TiltCurveChart` itself
    // (`performance_graph/tilt_curve_chart.slint`) -- see that component's own doc
    // comments.

    // Shown again while a video renders (the header's export indicator): open on the section
    // that holds the progress, instead of collapsed.
    init => { root.video_export_expanded = TiltVideoExportModel.is_exporting; }

    callback close();
    close => { TiltModel.dialog_open = false; }
    // Forwarded to `TiltModel.copy_curve_data()` (`gui::library::clipboard`), like the callbacks
    // above. The footer's Copy button calls it.
    callback copy_curve_data();
    copy_curve_data => { TiltModel.copy_curve_data(); }

    // Full-window modal backdrop.
    background: Theme.overlay-backdrop;

    TouchArea {
        clicked => { root.close(); }
    }

    // Escape closes, except while `TiltVideoExportModel.is_exporting` (closing would abandon the
    // export). No Return binding: this read-only viewer has no primary action. Other keys are
    // accepted so they do not reach `global_shortcuts`.
    key_scope := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                if (!TiltVideoExportModel.is_exporting) {
                    root.close();
                }
                return accept;
            }
            accept
        }
    }

    // Card sized from the backdrop (`root`, which `GlobalDialogsOverlay` pins to the window).
    Rectangle {
        width: Math.min(960px, root.width - 80px);
        // Bounded by the backdrop, not `content.preferred-height`: an expanded video section
        // would otherwise push its Start row off a short window. The `body` ScrollView takes the
        // overflow. Capped at 720px so a tall window does not dwarf the card.
        height: Math.min(720px, root.height - 80px);
        background: Theme.surface-graph;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border-dialog;
        drop-shadow-blur: 32px;
        drop-shadow-color: Theme.shadow-heavy;
        drop-shadow-offset-y: 8px;
        clip: true;

        // Isolate clicks inside modal card
        TouchArea {}

        content := VerticalLayout {
            padding: 18px;
            spacing: 14px;

            // 1. Header Bar
            HorizontalLayout {
                spacing: 8px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    spacing: 3px;
                    HorizontalLayout {
                        spacing: 8px;
                        // Centred by a layout of its own: a fixed-size Image in the row sits at
                        // the top of its cell.
                        VerticalLayout {
                            alignment: center;
                            Image { source: @image-url("../icons/trend-up.svg"); colorize: Theme.text-primary; width: 16px; height: 16px; }
                        }
                        Text {
                            text: "Tilt Performance Curve Analysis";
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    Text {
                        text: "Analytical raytracing across -90° to +90° tilt away from table-up (1° step resolution) for " + root.material_name;
                        font-size: 11px;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        alignment: start;
                        HelpButton {
                            topic: HelpTopics.tilt-curves;
                            hint: "Open the manual page on the tilt performance graph";
                        }
                    }
                    VerticalLayout {
                        alignment: start;
                        IconButton {
                            icon: @image-url("../icons/close.svg");
                            glyph: 13px;
                            tint: Theme.text-muted;
                            hint: "Close the tilt performance graph";
                            clicked => { root.close(); }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.surface-raised; }

            // Scrollable body between the fixed header and footer: badges, toggles, chart and the
            // video section. `vertical-stretch: 1` takes the room the card leaves over.
            body := ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 14px;
                    // Top-aligned, so spare height does not spread between the captions.
                    alignment: start;

                    // Only the 181 points are measured; the curve and hover readout between
                    // them (`interpolated_value`) are linear interpolation, not more raytracing.
                    Text {
                        text: "Between the 181 measured 1°-step points, the curve and hover readout are linearly interpolated, not additional raytracing.";
                        font-size: 11px;
                        font-italic: true;
                        color: Theme.text-disabled;
                        wrap: word-wrap;
                    }
                    // `crates/pleochroma-cut-core/src/optimize/objective.rs` scores fixed poses
                    // under a canonical light, while this curve uses the viewport's light
                    // (`RenderContext::light_yaw`/`light_pitch`). The two agree only until the
                    // light moves; the caption below states it.
                    Text {
                        text: "Optimize scores brilliance under a fixed light pose; this curve uses your current light -- if you've moved it, the two figures may disagree.";
                        font-size: 11px;
                        font-italic: true;
                        color: Theme.text-disabled;
                        wrap: word-wrap;
                    }
                    // Sweep and hover preview trace the finished stone as captured by
                    // `SceneSnapshot::capture_finished` (material with overrides, tools, facet
                    // finishes, fluorescence and lighting).
                    Text {
                        text: "Finished stone with the current material, finish, lighting and head shadow: " + root.material_name + ".";
                        font-size: 11px;
                        font-italic: true;
                        color: Theme.text-disabled;
                        wrap: word-wrap;
                    }

            // 2. Key metric badges: index 90 of each curve (0 deg tilt, table up, shared by all
            // axes). Shown as a placeholder until `extra_axes_ready`.
            HorizontalLayout {
                spacing: 10px;

                // Face-Up Brilliance
                Rectangle {
                    horizontal-stretch: 1;
                    height: 52px;
                    background: Theme.surface-chip;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.surface-raised;

                    VerticalLayout {
                        padding: 8px;
                        alignment: center;
                        spacing: 2px;
                        Text { text: "Face-Up Brilliance (0°, " + root.selected_axis_label + ")"; font-size: 10px; font-weight: 600; color: Theme.text-muted; }
                        Text {
                            text: root.extra_axes_ready ? Math.round(root.active_brilliance_values[90]) + "%" : "…";
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.accent-cyan;
                        }
                    }
                }

                // Face-Up Windowing
                Rectangle {
                    horizontal-stretch: 1;
                    height: 52px;
                    background: Theme.surface-chip;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.surface-raised;

                    VerticalLayout {
                        padding: 8px;
                        alignment: center;
                        spacing: 2px;
                        Text { text: "Face-Up Windowing (0°, " + root.selected_axis_label + ")"; font-size: 10px; font-weight: 600; color: Theme.text-muted; }
                        Text {
                            text: root.extra_axes_ready ? Math.round(root.active_windowing_values[90]) + "%" : "…";
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.accent-amber;
                        }
                    }
                }

                // Tilt Extinction
                Rectangle {
                    horizontal-stretch: 1;
                    height: 52px;
                    background: Theme.surface-chip;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.surface-raised;

                    VerticalLayout {
                        padding: 8px;
                        alignment: center;
                        spacing: 2px;
                        Text { text: "Extinction Shadow (0°, " + root.selected_axis_label + ")"; font-size: 10px; font-weight: 600; color: Theme.text-muted; }
                        Text {
                            text: root.extra_axes_ready ? Math.round(root.active_extinction_values[90]) + "%" : "…";
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.chart-extinction;
                        }
                    }
                }
            }

            // Curves stale against the live design. Skipped while a sweep is in flight
            // (`extra_axes_loading`).
            if root.curves_stale && !root.extra_axes_loading: StaleBadge {
                recompute => { root.rerender_curve_with_current_material(); }
            }

            HorizontalLayout {
                CheckBox { text: "Optical Diagnostics at Hovered Pose"; checked <=> TiltModel.hover_diagnostics; toggled => { TiltModel.request_tilt_hover_preview(TiltModel.hover_axis,TiltModel.hover_tilt); } }
                Button { text: TiltModel.hover_inspect ? "Close Inspection" : "Inspect This Angle"; clicked => { TiltModel.hover_inspect=!TiltModel.hover_inspect; TiltModel.request_tilt_hover_preview(TiltModel.hover_axis,TiltModel.hover_tilt); } }
            }
            // The one place the dialog says tilt views omit the stone shadow: the hover worker
            // appends the note to this status line only when the shadow would apply.
            Text { text: TiltModel.hover_status; color:Theme.text-secondary; wrap:word-wrap; }
            if TiltModel.hover_inspect && TiltModel.hover_ready: Image { source:TiltModel.hover_preview_image; height:360px; image-fit:contain; }

            // 3. Channel Toggle Filters. Below 900px the caption moves onto its
            // own line above the pills, and the pills drop their long
            // parenthetical labels and color dots so the row fits.
            VerticalLayout {
                spacing: 6px;

            if root.narrow: Text {
                text: "Optical Channels:";
                font-size: 11px;
                font-weight: 600;
                color: Theme.text-secondary;
            }

            HorizontalLayout {
                alignment: space-between;

                if !root.narrow: Text {
                    text: "Optical Channels:";
                    font-size: 11px;
                    font-weight: 600;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    spacing: 8px;

                    // Brilliance Channel Toggle
                    chip-toggle-narrow := ChipToggle {
                        text: root.narrow ? "Brilliance" : "Brilliance % (Light Return)";
                        hint: "Show or hide the brilliance line: how much of the light that enters the stone comes back out through the top.";
                        active: root.show_brilliance;
                        accent: Theme.accent-cyan;
                        fill: Theme.tint-cyan;
                        show_dot: !root.narrow;
                        toggled => { root.show_brilliance = !root.show_brilliance; }
                    }

                    // Windowing Channel Toggle
                    chip-toggle-narrow-2 := ChipToggle {
                        text: root.narrow ? "Windowing" : "Windowing % (TIR Leakage)";
                        hint: "Show or hide the windowing line: how much light leaks straight through the stone instead of reflecting inside it.";
                        active: root.show_windowing;
                        accent: Theme.accent-amber;
                        fill: Theme.tint-amber;
                        show_dot: !root.narrow;
                        toggled => { root.show_windowing = !root.show_windowing; }
                    }

                    // Extinction Channel Toggle
                    chip-toggle-narrow-3 := ChipToggle {
                        text: root.narrow ? "Extinction" : "Extinction % (Shadows)";
                        hint: "Show or hide the extinction line: how much of the stone looks dark, where it shows the viewer's own head or the room instead of light.";
                        active: root.show_extinction;
                        accent: Theme.chart-extinction;
                        fill: Theme.tint-red;
                        show_dot: !root.narrow;
                        toggled => { root.show_extinction = !root.show_extinction; }
                    }
                }
            }
            } // end channel-row VerticalLayout

            // 3.5. Tilt Axis Switcher. Styled to match the "Optical Channels" pills
            // above, but in purple rather than per-channel color so the two rows
            // read as separate axes of control (WHICH channels vs. WHICH sweep).
            // Below 900px the caption sits on its own line above the pills and
            // the pills use the short angle labels alone.
            VerticalLayout {
                spacing: 6px;

            if root.narrow: HorizontalLayout {
                spacing: 6px;
                Text {
                    text: "Tilt Axis:";
                    font-size: 11px;
                    font-weight: 600;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
                if root.extra_axes_loading: Text {
                    text: "(sweeping ±90° across all 4 axes, ~1.5s)";
                    font-size: 10px;
                    font-italic: true;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                alignment: space-between;

                if !root.narrow: HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "Tilt Axis:";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                    if root.extra_axes_loading: Text {
                        // Named explicitly (not a bare "loading...") since ~1.5s is
                        // long enough that a silent spinner would read as hung.
                        text: "(sweeping ±90° across all 4 axes, ~1.5s)";
                        font-size: 10px;
                        font-italic: true;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;

                    for label[idx] in root.axis_labels : chip-toggle-narrow-4 := ChipToggle {
                        text: root.narrow ? root.axis_short_labels[idx] : label;
                        hint: "Plot the sweep seen from the " + root.axis_short_labels[idx] + " direction around the stone.";
                        active: root.selected_axis_index == idx;
                        accent: Theme.accent-purple;
                        fill: Theme.tint-purple;
                        // Every axis (0 included) needs `extra_axes_ready`'s
                        // background sweep to have landed: axis 0's negative half is
                        // not something the live render thread can supply.
                        enabled: root.extra_axes_ready;
                        toggled => { root.selected_axis_index = idx; }
                    }

                    // "All" overlay toggle -- draws every axis of every visible
                    // channel at once.
                    ChipToggle {
                        text: "All";
                        hint: "Draw all four directions at once. The one you picked stays bright, the others fade.";
                        active: root.show_all_axes;
                        accent: Theme.accent-purple;
                        fill: Theme.tint-purple;
                        enabled: root.extra_axes_ready;
                        toggled => { root.show_all_axes = !root.show_all_axes; }
                    }
                }
            }
            } // end axis-row VerticalLayout

            // 4. High-Resolution 181-Point (±90°, 1°-step) Performance Chart Canvas.
            // Tilt angle is continuous, so this draws each channel as a line (via
            // `Path`'s SVG `commands`, Slint has no polyline element) rather than
            // discrete bars -- bars would hide the curve shape a reader is here for.
            TiltCurveChart {
                extra_axes_ready: root.extra_axes_ready;
                extra_axes_loading: root.extra_axes_loading;
                show_all_axes: root.show_all_axes;
                selected_axis_index: root.selected_axis_index;
                show_extinction: root.show_extinction;
                show_windowing: root.show_windowing;
                show_brilliance: root.show_brilliance;
                graph_extinction_extra_paths: root.graph_extinction_extra_paths;
                graph_windowing_extra_paths: root.graph_windowing_extra_paths;
                graph_brilliance_extra_paths: root.graph_brilliance_extra_paths;
                active_extinction_path: root.active_extinction_path;
                active_windowing_path: root.active_windowing_path;
                active_brilliance_path: root.active_brilliance_path;
                active_brilliance_values: root.active_brilliance_values;
                active_extinction_values: root.active_extinction_values;
                active_windowing_values: root.active_windowing_values;
                tilt_hover_preview_image: root.tilt_hover_preview_image;
                request_tilt_hover_preview(a, t) => { root.request_tilt_hover_preview(a, t); }
            }

            // 4.5. Export tilt video, collapsed on each open (see `video_export_expanded`).
            // One frame per swept angle, posed like the curve (`gui::tilt::video_export`),
            // optionally with the values overlaid, muxed into the video file. Settings live on
            // `TiltVideoExportModel`; expansion and the large-run guard live on `root`.
            TiltVideoExportSection {
                video_export_expanded <=> root.video_export_expanded;
                confirmed_large_run <=> root.confirmed_large_run;
                selected_axis_index: root.selected_axis_index;
                selected_axis_label: root.selected_axis_label;
                axis_labels: root.axis_labels;
            }
                } // end body's inner VerticalLayout
            } // end body := ScrollView

            // 5. Footer Bar Actions
            HorizontalLayout {
                alignment: space-between;
                spacing: 10px;

                ActionButton {
                    height: 32px;
                    icon: @image-url("../icons/clipboard.svg");
                    text: "Copy 181-Point Data Table (4 Axes, ±90°)";
                    hint: "Copy the full sweep, four directions of 181 points each, to the clipboard as a table.";
                    clicked => { root.copy_curve_data(); }
                }

                ActionButton {
                    width: 90px;
                    height: 32px;
                    text: "Close";
                    hint: "Close the tilt performance graph.";
                    fill: Theme.accent-cyan;
                    hover_fill: Theme.accent-cyan-hover;
                    edge: Theme.accent-cyan;
                    ink: Theme.text-on-accent;
                    font_size: 12px;
                    weight: 700;
                    clicked => { root.close(); }
                }
            }
        }
    }
}
