import { Theme } from "../../theme.slint";
import { RoughPlanModel } from "../../models/rough_plan.slint";
import { RoughField, RoughPill, WrapText } from "fields.slint";
import { RuleEditor } from "rule_editor.slint";
import { HelpButton } from "../help_button.slint";
import { HelpTopics } from "../../models/help.slint";

// The Crystal Axis of the rough and the rule the stones are oriented by. Hidden for a material
// without a crystal axis. The axis is Unknown until you set it (a plan that never sets it is
// planned as before). Setting it, Align to Face, Align to Edge, Fit to Crystal Length and From
// Color Zones are each one undo step, like every edit of the rough. A drag on the axis line in
// the 3D view turns it too.
export component AxisPanel inherits VerticalLayout {
    property <bool> editable: !RoughPlanModel.running && !RoughPlanModel.mesh_busy;

    spacing: 6px;

    if RoughPlanModel.axis_available: VerticalLayout {
        spacing: 6px;

        HorizontalLayout {
            spacing: 6px;
            Text {
                text: "CRYSTAL AXIS";
                font-size: 11px;
                font-weight: 700;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                HelpButton {
                    topic: HelpTopics.crystal-axis-rough;
                    hint: "Open the manual page on the crystal axis of the rough and the orientation rule";
                }
            }
        }

        HorizontalLayout {
            spacing: 4px;
            alignment: start;

            RoughPill {
                text: "Unknown";
                hint: "The direction of the crystal axis in the rough is not known. Stones are not oriented to it.";
                active: !RoughPlanModel.axis_set;
                enabled: root.editable;
                clicked => { RoughPlanModel.axis_unknown(); }
            }
            RoughPill {
                text: "Set";
                hint: "Give the direction of the crystal axis in the rough. Stones are then oriented to it by the rule below.";
                active: RoughPlanModel.axis_set;
                enabled: root.editable;
                clicked => {
                    if !RoughPlanModel.axis_set {
                        RoughPlanModel.axis_make_set();
                    }
                }
            }
        }

        if RoughPlanModel.axis_set: VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                spacing: 6px;
                RoughField {
                    label: "Tilt (deg)";
                    hint: "The angle between the crystal axis and the rough's Y axis, 0 to 90 degrees.";
                    editable: root.editable;
                    value <=> RoughPlanModel.axis_tilt;
                    committed => { RoughPlanModel.axis_edit(0, RoughPlanModel.axis_tilt); }
                }
                RoughField {
                    label: "Azimuth (deg)";
                    hint: "The direction of the crystal axis around the rough's Y axis, from X toward Z, 0 to 360 degrees.";
                    editable: root.editable;
                    value <=> RoughPlanModel.axis_azimuth;
                    committed => { RoughPlanModel.axis_edit(1, RoughPlanModel.axis_azimuth); }
                }
                if RoughPlanModel.axis_biaxial: RoughField {
                    label: "Second Axis (deg)";
                    hint: "How far the second principal direction is turned about the crystal axis, 0 to 180 degrees. Leave it empty for the material's own.";
                    placeholder: "own";
                    editable: root.editable;
                    value <=> RoughPlanModel.axis_second;
                    committed => { RoughPlanModel.axis_edit(2, RoughPlanModel.axis_second); }
                }
            }

            if RoughPlanModel.axis_sentence != "": WrapText {
                text: RoughPlanModel.axis_sentence;
                font_size: 10px;
                text_color: Theme.text-secondary;
            }
        }

        // The ways to find the axis.
        VerticalLayout {
            spacing: 4px;

            HorizontalLayout {
                spacing: 4px;
                alignment: start;

                RoughPill {
                    text: RoughPlanModel.axis_pick == 1 ? "Click a Face..." : "Align to Face";
                    hint: RoughPlanModel.axis_pick == 1
                        ? "Click a face of the rough in the 3D view; the crystal axis is set along its normal. Click here again to cancel."
                        : "Click a face of the rough in the 3D view to set the crystal axis along that face's normal.";
                    active: RoughPlanModel.axis_pick == 1;
                    enabled: root.editable;
                    clicked => { RoughPlanModel.axis_pick_start(RoughPlanModel.axis_pick == 1 ? 0 : 1); }
                }
                RoughPill {
                    text: RoughPlanModel.axis_pick == 2 ? "Click the First End..."
                        : (RoughPlanModel.axis_pick == 3 ? "Click the Second End..." : "Align to Edge");
                    hint: RoughPlanModel.axis_pick >= 2
                        ? "Click the two ends of an edge or a crystal line on the rough in the 3D view. Click here again to cancel."
                        : "Click two points on the rough in the 3D view to set the crystal axis along the line between them.";
                    active: RoughPlanModel.axis_pick >= 2;
                    enabled: root.editable;
                    clicked => { RoughPlanModel.axis_pick_start(RoughPlanModel.axis_pick >= 2 ? 0 : 2); }
                }
            }
            HorizontalLayout {
                spacing: 4px;
                alignment: start;

                RoughPill {
                    text: "Fit to Crystal Length";
                    hint: "Set the crystal axis along the longest direction of the rough. A crystal is usually longest along its axis; the note says how clear that direction is.";
                    enabled: root.editable;
                    clicked => { RoughPlanModel.axis_fit_length(); }
                }
                RoughPill {
                    text: "From Color Zones";
                    hint: RoughPlanModel.axis_zones_possible
                        ? "Set the crystal axis along the axis of the color zone you accepted in Rough Color."
                        : "Needs an accepted color zone that runs along the crystal (a cylinder or prism around its axis) in Rough Color.";
                    enabled: root.editable && RoughPlanModel.axis_zones_possible;
                    clicked => { RoughPlanModel.axis_from_zones(); }
                }
            }
        }

        if RoughPlanModel.axis_note != "": WrapText {
            text: RoughPlanModel.axis_note;
            font_size: 10px;
            text_color: RoughPlanModel.axis_note_level == 3 ? Theme.danger
                : (RoughPlanModel.axis_note_level == 2 ? Theme.accent-amber
                : (RoughPlanModel.axis_note_level == 1 ? Theme.success : Theme.text-secondary));
        }

        // The rule: visible once the axis is set.
        if RoughPlanModel.axis_set: VerticalLayout {
            spacing: 4px;

            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }
            Text {
                text: "ORIENTATION RULE";
                font-size: 11px;
                font-weight: 700;
                color: Theme.text-muted;
            }
            if RoughPlanModel.rule_line != "": WrapText {
                text: RoughPlanModel.rule_line;
                font_size: 10px;
                text_color: Theme.text-primary;
            }
            RuleEditor {
                entry: -1;
                follow_text: "Material Default";
                follow_hint: "Use the rule this material starts with.";
                choice: RoughPlanModel.plan_rule_choice;
                kind <=> RoughPlanModel.plan_rule_kind;
                hold: RoughPlanModel.plan_rule_hold;
                tolerance <=> RoughPlanModel.plan_rule_tolerance;
                weight <=> RoughPlanModel.plan_rule_weight;
                tilt <=> RoughPlanModel.plan_rule_tilt;
                azimuth <=> RoughPlanModel.plan_rule_azimuth;
                reason <=> RoughPlanModel.plan_rule_reason;
                kind_names: RoughPlanModel.rule_kind_names;
                editable: root.editable;
            }
            if RoughPlanModel.axis_stale_text != "": WrapText {
                text: RoughPlanModel.axis_stale_text;
                font_size: 10px;
                text_color: Theme.accent-amber;
            }
        }
    }
}
