import { Theme } from "../../theme.slint";
import { LineEdit } from "std-widgets.slint";
import { RoughPlanModel, RoughCutRow } from "../../models/rough_plan.slint";
import { KitIcon, KitIcons, KitIconButton, KitButton } from "../kit/kit.slint";
import { RoughUi } from "state.slint";
import { WrapText } from "fields.slint";

// A compact number field of a cut row: a short prefix ("A", "Az") and a 28 px field that reports
// edits directly. The incoming `text` is pushed into the `LineEdit` again on every change: once
// the user has typed, the `LineEdit` stops following a plain binding, so without this a value
// pushed from Rust (undo, default setbacks, a shape-worker echo) would not show.
component CutNum inherits HorizontalLayout {
    in property <string> prefix;
    // The accessible name and the tooltip's subject ("Setback A (mm)").
    in property <string> label;
    // One plain sentence: what the number means. The tooltip and the accessible description.
    in property <string> hint;
    in property <string> text;
    in property <bool> editable: true;
    // The field of a cut that was just added takes the keyboard focus when it appears, so the
    // default value can be typed over at once.
    in property <bool> autofocus: false;
    callback edited(string);
    callback committed();
    // The field took keyboard focus: its owner selects the row.
    callback focused();
    // The field took the keyboard focus because its cut was just added.
    callback autofocused();

    // Set by a keystroke, cleared by the commit, so Enter followed by the focus loss it causes
    // reports one edit, not two.
    property <bool> dirty: false;

    horizontal-stretch: 1;
    // Equal widths for the fields of a row, whatever their prefixes are.
    preferred-width: 0px;
    min-width: 0px;
    spacing: 5px;

    init => {
        if root.autofocus {
            field.focus();
            field.select-all();
            root.autofocused();
            RoughPlanModel.focus_cut_row = -1;
        }
    }

    changed text => {
        field.text = root.text;
        root.dirty = false;
    }

    Text {
        text: root.prefix;
        font-size: 11px;
        color: Theme.text-muted;
        vertical-alignment: center;
        horizontal-stretch: 0;
    }
    Rectangle {
        horizontal-stretch: 1;
        height: 28px;
        if root.hint != "": Tooltip { text: @markdown("\{root.hint}"); }
        field := LineEdit {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            font-size: 12px;
            text: root.text;
            enabled: root.editable;
            accessible-label: root.label;
            accessible-description: root.hint;
            edited(t) => {
                root.dirty = true;
                root.edited(t);
            }
            accepted => {
                if root.dirty {
                    root.dirty = false;
                    root.committed();
                }
            }
            changed has-focus => {
                if self.has-focus {
                    root.focused();
                } else if root.dirty {
                    root.dirty = false;
                    root.committed();
                }
            }
        }
    }
}

// One cut row in the shape section: the kind's icon, the cut's name (a click on an edge or corner
// name opens the choice of which edge or corner it takes off), what it removes, the delete
// button, and the number fields on a second line.
component CutRowItem inherits Rectangle {
    in property <RoughCutRow> cut;
    in property <int> index;
    in property <bool> is_selected;
    callback selected();
    callback remove();
    // The row was just added and is laid out: its window position and height, so the
    // scrolling list around it can bring it into view.
    callback revealed(length, length);

    // Editing a field of a row selects the row, as a click on it does.
    function select_row() {
        if RoughPlanModel.selected_cut != root.index {
            RoughPlanModel.selected_cut = root.index;
            RoughPlanModel.cut_selected(root.index);
        }
    }

    // Set when a field of this row takes focus because the row is new; the timer
    // reports the row's position once the layout has placed it.
    property <bool> reveal_pending: false;
    // The tooltip of the name of an edge or corner cut.
    property <string> name_tip: root.cut.kind == 0
        ? "Which edge of the block this cut takes off. Click to change it."
        : "Which corner of the block this cut takes off. Click to change it.";

    background: root.is_selected ? Theme.bg-elevated : Theme.bg-input;
    border-radius: 9px;
    border-width: 1px;
    border-color: root.is_selected ? Theme.accent-cyan : Theme.border-subtle;
    min-height: row_lay.preferred-height;

    accessible-role: AccessibleRole.list-item;
    accessible-label: "Cut " + (root.index + 1) + ": " + root.cut.title;
    accessible-item-selectable: true;
    accessible-item-selected: root.is_selected;
    accessible-action-default => { root.selected(); }

    Timer {
        interval: 40ms;
        running: root.reveal_pending;
        triggered => {
            root.reveal_pending = false;
            root.revealed(root.absolute-position.y, root.height);
        }
    }

    // Declared first, so it sits under the fields and buttons and only receives
    // the clicks they do not handle.
    TouchArea {
        clicked => { root.selected(); }
    }

    row_lay := VerticalLayout {
        padding: 8px;
        padding-left: 10px;
        padding-right: 6px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                KitIcon {
                    d: root.cut.kind == 0 ? KitIcons.edge : (root.cut.kind == 1 ? KitIcons.corner : KitIcons.face);
                    size: 18px;
                    ink: Theme.accent-amber;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                alignment: center;
                spacing: 2px;
                Rectangle {
                    height: 18px;
                    name_text := Text {
                        x: 0px;
                        width: parent.width - (root.cut.kind != 2 ? 18px : 0px);
                        height: parent.height;
                        text: (root.index + 1) + ". " + root.cut.title;
                        font-size: 12px;
                        font-weight: 600;
                        color: root.is_selected ? Theme.accent-cyan-hover : Theme.text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    // Which edge or corner the cut sits on (faces have a direction instead).
                    if root.cut.kind != 2: KitIcon {
                        x: parent.width - self.width - 2px;
                        y: (parent.height - self.height) / 2;
                        d: KitIcons.chevron-down;
                        size: 14px;
                        ink: Theme.text-muted;
                    }
                    if root.cut.kind != 2: name_touch := TouchArea {
                        enabled: !RoughPlanModel.running;
                        mouse-cursor: pointer;
                        accessible-role: AccessibleRole.button;
                        accessible-label: root.cut.kind == 0 ? "Edge of the Cut" : "Corner of the Cut";
                        accessible-description: root.cut.kind == 0 ? "Which edge of the block this cut takes off." : "Which corner of the block this cut takes off.";
                        clicked => {
                            RoughPlanModel.selected_cut = root.index;
                            RoughUi.menu_kind = 5;
                            RoughUi.menu_row = root.index;
                            RoughUi.menu_group = -1;
                            RoughUi.menu_right = false;
                            RoughUi.menu_x = self.absolute-position.x;
                            RoughUi.menu_y = self.absolute-position.y + self.height + 4px;
                        }
                    }
                    if root.cut.kind != 2: Tooltip { text: @markdown("\{root.name_tip}"); }
                }
                if root.cut.removed_text != "": Rectangle {
                    height: 15px;
                    Text {
                        x: 0px;
                        width: parent.width;
                        height: parent.height;
                        text: root.cut.removed_text;
                        font-size: 11px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            // Deleting edits the model, which a running plan is using.
            VerticalLayout {
                alignment: center;
                cut-delete-index := KitIconButton {
                    d: KitIcons.close;
                    size: 26px;
                    ink: Theme.text-muted;
                    label: "Delete Cut " + (root.index + 1) + ": " + root.cut.title;
                    hint: RoughPlanModel.running ? "Not while a plan is running. Wait for it to finish, or cancel it."
                        : "Delete this cut. Undo brings it back.";
                    enabled: !RoughPlanModel.running;
                    clicked => { root.remove(); }
                }
            }
        }

        // Row fields depending on cut kind (0 edge, 1 corner, 2 face)
        if root.cut.kind == 0: HorizontalLayout {
            spacing: 8px;
            CutNum {
                prefix: "A";
                label: "Setback A (mm)";
                hint: "How far from the edge or corner the cut starts, along the first side, in millimetres.";
                autofocus: RoughPlanModel.focus_cut_row == root.index;
                autofocused => { root.reveal_pending = true; }
                text: root.cut.a;
                editable: !RoughPlanModel.running;
                edited(t) => { RoughPlanModel.cut_field_edited(root.index, 0, t); }
                committed => { RoughPlanModel.cut_field_committed(root.index); }
                focused => { root.select_row(); }
            }
            CutNum {
                prefix: "B";
                label: "Setback B (mm)";
                hint: "How far from the edge or corner the cut starts, along the second side, in millimetres.";
                text: root.cut.b;
                editable: !RoughPlanModel.running;
                edited(t) => { RoughPlanModel.cut_field_edited(root.index, 1, t); }
                committed => { RoughPlanModel.cut_field_committed(root.index); }
                focused => { root.select_row(); }
            }
            Text {
                text: "mm";
                font-size: 11px;
                color: Theme.text-muted;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
        }

        if root.cut.kind == 1: HorizontalLayout {
            spacing: 8px;
            CutNum {
                prefix: "A";
                label: "Setback A (mm)";
                hint: "How far from the edge or corner the cut starts, along the first side, in millimetres.";
                autofocus: RoughPlanModel.focus_cut_row == root.index;
                autofocused => { root.reveal_pending = true; }
                text: root.cut.a;
                editable: !RoughPlanModel.running;
                edited(t) => { RoughPlanModel.cut_field_edited(root.index, 0, t); }
                committed => { RoughPlanModel.cut_field_committed(root.index); }
                focused => { root.select_row(); }
            }
            CutNum {
                prefix: "B";
                label: "Setback B (mm)";
                hint: "How far from the edge or corner the cut starts, along the second side, in millimetres.";
                text: root.cut.b;
                editable: !RoughPlanModel.running;
                edited(t) => { RoughPlanModel.cut_field_edited(root.index, 1, t); }
                committed => { RoughPlanModel.cut_field_committed(root.index); }
                focused => { root.select_row(); }
            }
            CutNum {
                prefix: "C";
                label: "Setback C (mm)";
                hint: "How far from the corner the cut starts, along the third side, in millimetres.";
                text: root.cut.c;
                editable: !RoughPlanModel.running;
                edited(t) => { RoughPlanModel.cut_field_edited(root.index, 2, t); }
                committed => { RoughPlanModel.cut_field_committed(root.index); }
                focused => { root.select_row(); }
            }
            Text {
                text: "mm";
                font-size: 11px;
                color: Theme.text-muted;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
        }

        if root.cut.kind == 2: HorizontalLayout {
            spacing: 8px;
            CutNum {
                prefix: "Az";
                label: "Azimuth (\u{00B0})";
                hint: "The compass direction the face looks toward, in degrees around the vertical axis. A vertical face ignores it.";
                autofocus: RoughPlanModel.focus_cut_row == root.index;
                autofocused => { root.reveal_pending = true; }
                text: root.cut.azimuth;
                editable: !RoughPlanModel.running;
                edited(t) => { RoughPlanModel.cut_field_edited(root.index, 3, t); }
                committed => { RoughPlanModel.cut_field_committed(root.index); }
                focused => { root.select_row(); }
            }
            CutNum {
                prefix: "El";
                label: "Elevation (\u{00B0})";
                hint: "How steeply the face tilts, in degrees: 0 is a vertical face, 90 a flat top.";
                text: root.cut.elevation;
                editable: !RoughPlanModel.running;
                edited(t) => { RoughPlanModel.cut_field_edited(root.index, 4, t); }
                committed => { RoughPlanModel.cut_field_committed(root.index); }
                focused => { root.select_row(); }
            }
            CutNum {
                prefix: "D";
                label: "Depth (mm)";
                hint: "How deep the face cuts into the rough, in millimetres.";
                text: root.cut.depth;
                editable: !RoughPlanModel.running;
                edited(t) => { RoughPlanModel.cut_field_edited(root.index, 5, t); }
                committed => { RoughPlanModel.cut_field_committed(root.index); }
                focused => { root.select_row(); }
            }
        }

        // A note on the cut itself (a vertical face ignores its azimuth)
        if root.cut.hint != "": WrapText {
            text: root.cut.hint;
            font_size: 11px;
            text_color: Theme.text-muted;
        }

        if root.cut.error != "": WrapText {
            text: root.cut.error;
            font_size: 11px;
            text_color: Theme.danger;
        }
    }
}

// Step 3 of the left column: the shape cuts as compact rows, the buttons that add one, and Face
// from View. A scan takes face cuts only, so Edge and Corner are not shown for it.
export component CutList inherits VerticalLayout {
    // A cut row that was just added reports where it sits (window position, height)
    // once laid out; the scroll view that holds this list scrolls it into view.
    callback reveal_row(length, length);

    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    spacing: 6px;

    // Cut rows
    for cut[index] in RoughPlanModel.cuts: CutRowItem {
        cut: cut;
        index: index;
        is_selected: RoughPlanModel.selected_cut == index;
        selected => {
            RoughPlanModel.selected_cut = index;
            RoughPlanModel.cut_selected(index);
        }
        remove => { RoughPlanModel.remove_cut(index); }
        revealed(row_y, row_height) => { root.reveal_row(row_y, row_height); }
    }

    if RoughPlanModel.cuts.length == 0: WrapText {
        text: RoughPlanModel.base_kind == 3
            ? "No cuts yet. A scan takes face cuts only: add a face, or click a face in the 3D view."
            : "No cuts yet. Cut edges or corners, or click faces in the 3D view.";
        font_size: 11px;
        text_color: Theme.text-muted;
    }

    // Add buttons
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        padding-top: 4px;

        if RoughPlanModel.base_kind != 3: KitButton {
            text: "Edge";
            icon: KitIcons.plus;
            h: 28px;
            accessible-label: "+Edge";
            hint: RoughPlanModel.base_kind != 0 ? "Edge cuts need a block of rough."
                : (RoughPlanModel.running ? "Not while a plan is running." : "Add a cut that takes off one edge of the block.");
            enabled: RoughPlanModel.base_kind == 0 && !RoughPlanModel.running;
            clicked => { RoughPlanModel.add_cut(0); }
        }
        if RoughPlanModel.base_kind != 3: KitButton {
            text: "Corner";
            icon: KitIcons.plus;
            h: 28px;
            accessible-label: "+Corner";
            hint: RoughPlanModel.base_kind != 0 ? "Corner cuts need a block of rough."
                : (RoughPlanModel.running ? "Not while a plan is running." : "Add a cut that takes off one corner of the block.");
            enabled: RoughPlanModel.base_kind == 0 && !RoughPlanModel.running;
            clicked => { RoughPlanModel.add_cut(1); }
        }
        KitButton {
            text: "Face";
            icon: KitIcons.plus;
            h: 28px;
            accessible-label: "+Face";
            hint: RoughPlanModel.running ? "Not while a plan is running." : "Add a flat cut through the rough, set by a direction, a tilt and a depth.";
            enabled: !RoughPlanModel.running;
            clicked => { RoughPlanModel.add_cut(2); }
        }
    }

    HorizontalLayout {
        alignment: start;
        KitButton {
            text: "Face from View";
            icon: KitIcons.face;
            kind: 2;
            h: 28px;
            active: RoughPlanModel.face_from_view_armed;
            hint: RoughPlanModel.running ? "Not while a plan is running."
                : (RoughPlanModel.view_mode != 0 && !RoughPlanModel.face_from_view_armed
                    ? "Show the Rough view first: a face is picked on the rough, not on a result."
                    : (RoughPlanModel.face_from_view_armed
                        ? "Stop picking a face in the view. Escape does the same."
                        : "Then click a face of the rough in the 3D view to add a cut along it."));
            // It picks a face of the rough in the model view; the result view shows
            // the stones instead. An armed pick can still be switched off there.
            enabled: !RoughPlanModel.running
                && (RoughPlanModel.view_mode == 0 || RoughPlanModel.face_from_view_armed);
            clicked => {
                RoughPlanModel.face_from_view_armed = !RoughPlanModel.face_from_view_armed;
            }
        }
    }

    if RoughPlanModel.base_kind == 0: Text {
        text: "Or click an edge or a corner in the view.";
        font-size: 11px;
        color: Theme.text-muted;
    }
    if RoughPlanModel.base_kind == 1 || RoughPlanModel.base_kind == 2: Text {
        text: "Edge and corner cuts need a block";
        font-size: 11px;
        color: Theme.text-muted;
    }
}
