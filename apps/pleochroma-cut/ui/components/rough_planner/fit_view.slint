import { Theme } from "../../theme.slint";
import { RoughPlanModel } from "../../models/rough_plan.slint";
import { KitIcon, KitIcons, KitIconButton, KitGlass, KitSegment } from "../kit/kit.slint";
import { RoughIcons } from "state.slint";

// One entry of the design legend in the view's bottom bar: a dot in the design's color and the
// count with the short name. A click picks the design (Rust highlights its stones in the view).
component LegendEntry inherits Rectangle {
    in property <color> swatch;
    in property <string> text;
    in property <string> full_name;
    in property <bool> picked: false;
    callback clicked();

    height: 28px;
    width: entry_lay.preferred-width;
    border-radius: 7px;
    background: touch.has-hover ? Theme.bg-card-hover : transparent;
    border-width: fs.has-focus || root.picked ? 2px : 0px;
    border-color: fs.has-focus ? Theme.accent-cyan-hover : Theme.accent-cyan;
    accessible-role: AccessibleRole.button;
    accessible-label: "Highlight " + root.full_name;
    accessible-description: "Highlight the stones of this design in the 3D view. Click again to clear the highlight.";
    accessible-action-default => { root.clicked(); }

    Tooltip { text: @markdown("Highlight the stones of \{root.full_name} in the 3D view. Click again to clear the highlight."); }
    fs := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    entry_lay := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: root.swatch;
            }
        }
        Text {
            text: root.text;
            font-size: 12px;
            color: Theme.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One entry of the scan legend: a dot (or a line) in the layer's color and its name.
component KeyEntry inherits HorizontalLayout {
    in property <color> swatch;
    in property <string> text;
    in property <bool> line: false;

    spacing: 5px;
    VerticalLayout {
        alignment: center;
        if !root.line: Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: root.swatch;
        }
        if root.line: Rectangle {
            width: 14px;
            height: 2px;
            background: root.swatch;
        }
    }
    Text {
        text: root.text;
        font-size: 12px;
        color: Theme.text-primary;
        vertical-alignment: center;
        horizontal-stretch: 0;
    }
}

// A layer toggle of the view's bottom bar: a text segment, or an icon button when the window is
// narrow. It reads and writes nothing itself: `toggled` flips the owner's flag.
component LayerToggle inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> hint;
    in property <bool> on;
    in property <bool> narrow;
    callback toggled();

    height: 28px;
    width: root.narrow ? 28px : holder.preferred-width;

    // Only one of the two exists, so the hidden twin is not in the accessibility tree.
    holder := HorizontalLayout {
        alignment: start;
        if !root.narrow: KitSegment {
            text: root.text;
            hint: root.hint;
            on: root.on;
            accessible-role: AccessibleRole.checkbox;
            accessible-label: root.text;
            picked => { root.toggled(); }
        }
        if root.narrow: KitIconButton {
            d: root.icon;
            size: 28px;
            icon_size: 16px;
            active: root.on;
            ink: root.on ? Theme.accent-cyan : Theme.text-secondary;
            label: root.text;
            hint: root.hint;
            accessible-role: AccessibleRole.checkbox;
            accessible-label: root.text;
            accessible-checkable: true;
            accessible-checked: root.on;
            clicked => { root.toggled(); }
        }
    }
}

// The 3D view with glass overlays: the Rough | Layout switch at the top left, the camera presets
// at the top right, a banner while a pick is armed, the hover tooltip, and the bottom bar with the
// design legend and the layer toggles.
export component FitView inherits Rectangle {
    // The size of the image area, for the window to hand to Rust.
    out property <length> area_width: view_area.width;
    out property <length> area_height: view_area.height;

    // Pointer tracking for the view area. `dragging` is true between a left-button
    // press and the matching release, so `view_drag_end` fires exactly once.
    property <bool> dragging: false;
    property <length> last_x: 0px;
    property <length> last_y: 0px;
    property <length> press_x: 0px;
    property <length> press_y: 0px;
    // Set once the pointer has travelled 3 px from the press point; the click that
    // follows such a drag is not a click, and a drag that ends in a second press is not a
    // double-click.
    property <bool> moved_far: false;
    // The result the "Result" switch goes back to after "Rough" deselected it.
    property <int> remembered_result: 0;
    // The selected result is a real row (the legend reads its designs).
    property <bool> has_result: RoughPlanModel.selected_result >= 0 && RoughPlanModel.selected_result < RoughPlanModel.results.length;
    property <bool> scan_shown: RoughPlanModel.base_kind == 3 && RoughPlanModel.scan_verdict >= 0 && !RoughPlanModel.mesh_busy;
    // Armed picks: a face for a cut or for the axis, or the two ends of an edge.
    property <bool> picking: RoughPlanModel.face_from_view_armed || RoughPlanModel.axis_pick != 0;
    // The bottom bar is too short for text toggles (legend plus three labels): the toggles drop to
    // icons, whatever the window width (the center column is only about 380 px at 1180 px).
    property <bool> bar_compact: RoughPlanModel.narrow || bottom_bar.width < 560px;

    function end_drag() {
        if root.dragging {
            root.dragging = false;
            RoughPlanModel.view_drag_end();
        }
    }

    view_area := Rectangle {
        background: Theme.bg-input;
        clip: true;

        changed width => {
            RoughPlanModel.view_resized(self.width, self.height);
        }
        changed height => {
            RoughPlanModel.view_resized(self.width, self.height);
        }
        // Also pushed once on mount (a fresh element never gets `changed` for its own
        // first size). That push can run before Rust has registered `view_resized`, so the
        // window also exposes the area's size (`area_width`) for Rust to read when the
        // window is shown. A zero size is ignored on the Rust side.
        init => {
            RoughPlanModel.view_resized(self.width, self.height);
        }

        Image {
            width: parent.width;
            height: parent.height;
            source: RoughPlanModel.view_image;
        }

        // Tab brings the keyboard to the view: the arrows turn it, plus and minus zoom, Home
        // goes back to the starting view. The mouse does the same with drag and wheel.
        view_focus := FocusScope {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            accessible-role: AccessibleRole.image;
            accessible-label: RoughPlanModel.view_mode == 0 ? "The Rough with Its Cuts, in 3D" : "The Selected Layout, in 3D";
            accessible-description: "Left, right, up and down turn the view. Plus and minus zoom. Home resets the view.";
            key-pressed(event) => {
                if event.text == Key.LeftArrow {
                    RoughPlanModel.view_drag_begin();
                    RoughPlanModel.view_orbit(-20px, 0px);
                    RoughPlanModel.view_drag_end();
                    return accept;
                } else if event.text == Key.RightArrow {
                    RoughPlanModel.view_drag_begin();
                    RoughPlanModel.view_orbit(20px, 0px);
                    RoughPlanModel.view_drag_end();
                    return accept;
                } else if event.text == Key.UpArrow {
                    RoughPlanModel.view_drag_begin();
                    RoughPlanModel.view_orbit(0px, -20px);
                    RoughPlanModel.view_drag_end();
                    return accept;
                } else if event.text == Key.DownArrow {
                    RoughPlanModel.view_drag_begin();
                    RoughPlanModel.view_orbit(0px, 20px);
                    RoughPlanModel.view_drag_end();
                    return accept;
                } else if event.text == "+" || event.text == "=" {
                    RoughPlanModel.view_zoom(60);
                    return accept;
                } else if event.text == "-" {
                    RoughPlanModel.view_zoom(-60);
                    return accept;
                } else if event.text == Key.Home {
                    RoughPlanModel.view_preset(3);
                    return accept;
                }
                return reject;
            }
        }

        TouchArea {
            mouse-cursor: root.picking ? crosshair : (self.pressed ? grabbing : default);

            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.dragging = true;
                    root.moved_far = false;
                    root.last_x = self.mouse-x;
                    root.last_y = self.mouse-y;
                    root.press_x = self.mouse-x;
                    root.press_y = self.mouse-y;
                    RoughPlanModel.view_drag_begin();
                } else if ((event.kind == PointerEventKind.up && event.button == PointerEventButton.left) || event.kind == PointerEventKind.cancel) {
                    root.end_drag();
                }
            }

            // A release outside the area may not reach `pointer-event`.
            changed pressed => {
                if !self.pressed {
                    root.end_drag();
                }
            }

            // Leaving the area clears the hover readout.
            changed has-hover => {
                if !self.has-hover {
                    RoughPlanModel.view_hover(-1px, -1px);
                }
            }

            moved => {
                if root.dragging {
                    let step_x = self.mouse-x - root.last_x;
                    let step_y = self.mouse-y - root.last_y;
                    root.last_x = self.mouse-x;
                    root.last_y = self.mouse-y;
                    let from_press_x = (self.mouse-x - root.press_x) / 1px;
                    let from_press_y = (self.mouse-y - root.press_y) / 1px;
                    if from_press_x * from_press_x + from_press_y * from_press_y >= 9 {
                        root.moved_far = true;
                    }
                    RoughPlanModel.view_orbit(step_x, step_y);
                } else if !self.pressed {
                    RoughPlanModel.view_hover(self.mouse-x, self.mouse-y);
                }
            }

            scroll-event(event) => {
                RoughPlanModel.view_zoom(event.delta-y / 1px);
                return accept;
            }

            clicked => {
                view_focus.focus();
                if !root.moved_far {
                    RoughPlanModel.view_click(self.mouse-x, self.mouse-y);
                }
            }

            double-clicked => {
                if !root.moved_far {
                    RoughPlanModel.view_double_click(self.mouse-x, self.mouse-y);
                }
            }
        }

        // The ring that shows the view has the keyboard.
        if view_focus.has-focus: Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            border-width: 2px;
            border-color: Theme.accent-cyan-hover;
        }

        // Top left: what the view shows. "Rough" deselects the layout (this puts the layout rows
        // aside); the second segment shows the selected layout (the one shown last, or the first).
        KitGlass {
            x: 12px;
            y: 12px;
            width: switch_lay.preferred-width;
            height: 36px;
            TouchArea {}
            switch_lay := HorizontalLayout {
                padding: 4px;
                spacing: 2px;
                KitSegment {
                    text: "Rough";
                    hint: "Show the rough you are modelling, with its cuts. This puts the layouts aside.";
                    on: RoughPlanModel.view_mode == 0;
                    picked => {
                        if RoughPlanModel.selected_result >= 0 {
                            root.remembered_result = RoughPlanModel.selected_result;
                        }
                        RoughPlanModel.select_result(-1);
                    }
                }
                KitSegment {
                    text: RoughPlanModel.results.length > 0
                        ? "Layout #" + ((RoughPlanModel.selected_result >= 0 ? RoughPlanModel.selected_result : root.remembered_result) + 1)
                        : "Layout";
                    accessible-label: "Result";
                    hint: RoughPlanModel.results.length > 0
                        ? "Show the selected layout: the stones placed in the rough."
                        : "There is no layout yet. Press Plan first.";
                    on: RoughPlanModel.view_mode == 1;
                    enabled: RoughPlanModel.results.length > 0;
                    picked => {
                        RoughPlanModel.select_result(
                            RoughPlanModel.selected_result >= 0 ? RoughPlanModel.selected_result
                            : (root.remembered_result < RoughPlanModel.results.length ? root.remembered_result : 0));
                    }
                }
            }
        }

        // Top right: the camera presets.
        presets := KitGlass {
            x: parent.width - self.width - 12px;
            y: 12px;
            width: presets_lay.preferred-width;
            height: 36px;
            TouchArea {}
            presets_lay := HorizontalLayout {
                padding: 2px;
                spacing: 0px;
                KitIconButton {
                    d: KitIcons.front;
                    label: "Front";
                    hint: "Look at the rough from the front.";
                    clicked => { RoughPlanModel.view_preset(0); }
                }
                KitIconButton {
                    d: KitIcons.top;
                    label: "Top";
                    hint: "Look at the rough from above.";
                    clicked => { RoughPlanModel.view_preset(1); }
                }
                KitIconButton {
                    d: KitIcons.side;
                    label: "Side";
                    hint: "Look at the rough from the side.";
                    clicked => { RoughPlanModel.view_preset(2); }
                }
                KitIconButton {
                    d: KitIcons.reset;
                    label: "Reset";
                    hint: "Go back to the starting view. Home does the same while the view has the keyboard.";
                    clicked => { RoughPlanModel.view_preset(3); }
                }
            }
        }

        // The view is being redrawn.
        if RoughPlanModel.view_busy: KitGlass {
            x: presets.x - self.width - 8px;
            y: 12px;
            width: busy_text.preferred-width + 24px;
            height: 36px;
            busy_text := Text {
                x: 12px;
                height: parent.height;
                text: "Drawing the view\u{2026}";
                font-size: 11px;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }
        }

        // A pick is armed: the face of a cut, the face or the two ends of an edge for the axis.
        if root.picking: KitGlass {
            x: (parent.width - self.width) / 2;
            y: 56px;
            width: banner_lay.preferred-width;
            height: 32px;
            border-color: Theme.accent-cyan;
            accessible-role: AccessibleRole.text;
            accessible-label: RoughPlanModel.axis_pick == 2 ? "Click the first end of an edge. Escape cancels."
                : (RoughPlanModel.axis_pick == 3 ? "Click the second end of the edge. Escape cancels." : "Click a face. Escape cancels.");
            banner_lay := HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    KitIcon {
                        d: KitIcons.face;
                        size: 16px;
                        ink: Theme.accent-cyan;
                    }
                }
                Text {
                    text: RoughPlanModel.axis_pick == 2 ? "Click the first end of an edge \u{2014} Esc cancels"
                        : (RoughPlanModel.axis_pick == 3 ? "Click the second end \u{2014} Esc cancels" : "Click a face \u{2014} Esc cancels");
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
            }
        }

        // The scan is being read: the view has nothing to show yet.
        if RoughPlanModel.base_kind == 3 && RoughPlanModel.mesh_busy: KitGlass {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 260px;
            height: 64px;
            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                Text {
                    text: "Reading the scan\u{2026}";
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                }
                Text {
                    text: "The window stays usable meanwhile.";
                    font-size: 11px;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                }
            }
        }

        // The hover tooltip: a stone of a layout, or an edge or corner of the rough.
        if RoughPlanModel.hover_tip_visible: KitGlass {
            x: Math.max(8px, Math.min(RoughPlanModel.hover_tip_x + 14px, parent.width - self.width - 8px));
            y: Math.max(8px, Math.min(RoughPlanModel.hover_tip_y + 14px, parent.height - self.height - 8px));
            width: tip_lay.preferred-width;
            height: tip_lay.preferred-height;
            tip_lay := VerticalLayout {
                padding: 10px;
                spacing: 3px;
                HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: RoughPlanModel.hover_tip_color;
                        }
                    }
                    Text {
                        text: RoughPlanModel.hover_tip_title;
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                }
                for tip_line in RoughPlanModel.hover_tip_lines: Text {
                    text: tip_line;
                    font-size: 11px;
                    color: Theme.text-secondary;
                }
            }
        }

        // Bottom: the legend and the layer toggles, or the hint.
        bottom_bar := KitGlass {
            x: 12px;
            y: parent.height - self.height - 12px;
            width: parent.width - 24px;
            height: 40px;
            TouchArea {}
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 6px;
                spacing: 8px;

                // The designs of the shown layout (the selected layout's detail names them when
                // the window is narrow).
                if RoughPlanModel.view_mode == 1 && root.has_result && !RoughPlanModel.narrow: HorizontalLayout {
                    spacing: 2px;
                    for group[g] in RoughPlanModel.results[RoughPlanModel.selected_result].groups: VerticalLayout {
                        alignment: center;
                        LegendEntry {
                            swatch: group.swatch;
                            text: group.count + " " + (group.short_name != "" ? group.short_name : group.name);
                            full_name: group.count + " \u{00D7} " + group.name;
                            picked: RoughPlanModel.legend_selected == g;
                            clicked => { RoughPlanModel.legend_picked(g); }
                        }
                    }
                }

                // The three colors of a scan's layers.
                if RoughPlanModel.view_mode == 0 && root.scan_shown && !RoughPlanModel.narrow: VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 12px;
                        KeyEntry { swatch: #f59e0b; text: "Repaired"; }
                        KeyEntry { swatch: #ef4444; text: "Crossing"; }
                        KeyEntry { swatch: Theme.accent-cyan; text: "Outline used"; line: true; }
                    }
                }

                // The hint, when no legend is shown.
                if !(RoughPlanModel.view_mode == 1 && root.has_result && !RoughPlanModel.narrow) && !(RoughPlanModel.view_mode == 0 && root.scan_shown && !RoughPlanModel.narrow): Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    Text {
                        x: 0px;
                        width: parent.width;
                        height: parent.height;
                        text: RoughPlanModel.view_hint != "" ? RoughPlanModel.view_hint
                            : (RoughPlanModel.view_mode == 0
                                ? (RoughPlanModel.base_kind == 3 ? "Drag to orbit \u{00B7} scroll to zoom"
                                    : (root.bar_compact ? "Click an edge to cut it \u{00B7} drag to orbit" : "Drag to orbit \u{00B7} scroll to zoom \u{00B7} click an edge to cut it"))
                                : (root.bar_compact ? "Drag to orbit \u{00B7} hover stones for details" : "Drag to orbit \u{00B7} scroll to zoom \u{00B7} hover stones for details"));
                        font-size: 11px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                if (RoughPlanModel.view_mode == 1 && root.has_result && !RoughPlanModel.narrow) || (RoughPlanModel.view_mode == 0 && root.scan_shown && !RoughPlanModel.narrow): Rectangle {
                    horizontal-stretch: 1;
                }

                // The layers of a layout only exist in the layout view.
                if RoughPlanModel.view_mode == 1: VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 2px;
                        LayerToggle {
                            text: "Rough";
                            icon: RoughIcons.gem;
                            narrow: root.bar_compact;
                            hint: "Show the outline of the whole rough around the stones.";
                            on: RoughPlanModel.show_rough;
                            toggled => {
                                RoughPlanModel.show_rough = !RoughPlanModel.show_rough;
                                RoughPlanModel.view_toggles_changed();
                            }
                        }
                        LayerToggle {
                            text: "Saw";
                            icon: RoughIcons.saw;
                            narrow: root.bar_compact;
                            hint: "Show where the saw would cut the rough apart between stones.";
                            on: RoughPlanModel.show_saw;
                            toggled => {
                                RoughPlanModel.show_saw = !RoughPlanModel.show_saw;
                                RoughPlanModel.view_toggles_changed();
                            }
                        }
                        LayerToggle {
                            text: "Stones";
                            icon: RoughIcons.stone;
                            narrow: root.bar_compact;
                            hint: "Show the stones placed in the rough.";
                            on: RoughPlanModel.show_stones;
                            toggled => {
                                RoughPlanModel.show_stones = !RoughPlanModel.show_stones;
                                RoughPlanModel.view_toggles_changed();
                            }
                        }
                    }
                }

                // The rough's own layers: the scan's problems and outline, and the cut faces.
                if RoughPlanModel.view_mode == 0: VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 2px;
                        if root.scan_shown: LayerToggle {
                            text: "Problems";
                            icon: KitIcons.info;
                            narrow: root.bar_compact;
                            hint: "Color the places the import repaired in amber and the places where the scan crosses itself in red, with a marker at each.";
                            on: RoughPlanModel.show_problems;
                            toggled => {
                                RoughPlanModel.show_problems = !RoughPlanModel.show_problems;
                                RoughPlanModel.view_toggles_changed();
                            }
                        }
                        if root.scan_shown: LayerToggle {
                            text: "Outline";
                            icon: KitIcons.block;
                            narrow: root.bar_compact;
                            hint: "Draw the outline the planner works on as a cyan ghost over the scan, so a fallback to the convex outline can be seen.";
                            on: RoughPlanModel.show_outline;
                            toggled => {
                                RoughPlanModel.show_outline = !RoughPlanModel.show_outline;
                                RoughPlanModel.view_toggles_changed();
                            }
                        }
                        LayerToggle {
                            text: "Cut Faces";
                            icon: KitIcons.face;
                            narrow: root.bar_compact;
                            hint: "Show the flat faces your cuts make on the rough, in the 3D view.";
                            on: RoughPlanModel.show_cut_faces;
                            toggled => {
                                RoughPlanModel.show_cut_faces = !RoughPlanModel.show_cut_faces;
                                RoughPlanModel.view_toggles_changed();
                            }
                        }
                    }
                }
            }
        }
    }
}
