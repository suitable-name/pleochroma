import { Theme } from "../../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { RoughPlanModel } from "../../models/rough_plan.slint";
import { KitButton, KitSegmentBar } from "../kit/kit.slint";
import { PlanField, HalfSegment, LinkText, Stepper } from "parts.slint";
import { ElidedText, WrapText } from "fields.slint";

// Step 4 of the left column: the design and stone limits, the candidate designs, the excluded
// designs, the losses and, for a rough with a mesh, the scan time limit. The Plan button and its
// progress sit below the steps (`plan_block.slint`), not here.
export component PlanForm inherits VerticalLayout {
    property <bool> busy: RoughPlanModel.running;

    // "Whole Library (1,234 designs)": the name of a choice with the grouped count Rust
    // formatted. `count` only decides singular or plural, and the "counting..." state
    // (negative) has no unit; an empty text means no count was taken yet.
    pure function count_label(name: string, count_text: string, count: int) -> string {
        if count_text == "" {
            return name;
        }
        if count < 0 {
            return name + " (" + count_text + ")";
        }
        return name + " (" + count_text + (count == 1 ? " design)" : " designs)");
    }

    // The short name of a candidate choice with its count, for the segment.
    pure function short_label(name: string, count_text: string) -> string {
        return count_text == "" ? name : name + " \u{00B7} " + count_text;
    }

    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    spacing: 10px;

    // Design cap (1..=99): how many different designs a layout may mix.
    HorizontalLayout {
        spacing: 8px;
        Text {
            width: 100px;
            text: "Designs, up to";
            font-size: 12px;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }
        Stepper {
            label: "Most Designs per Layout";
            hint: "The most different designs one layout may mix, from 1 to 99. 1 plans every layout with a single design. Stones (up to) limits how many stones a layout holds.";
            value_text: "" + RoughPlanModel.max_designs;
            enabled: !root.busy;
            can_dec: RoughPlanModel.max_designs > 1;
            can_inc: RoughPlanModel.max_designs < 99;
            decrement => { RoughPlanModel.max_designs = Math.max(1, RoughPlanModel.max_designs - 1); }
            increment => { RoughPlanModel.max_designs = Math.min(99, RoughPlanModel.max_designs + 1); }
        }
        Text {
            text: "per layout";
            font-size: 11px;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
    }

    // Stone cap (0..=99): how many stones a layout may hold in all, whatever their designs.
    // 0 = no limit (the planner fits as many as yield best).
    HorizontalLayout {
        spacing: 8px;
        Text {
            width: 100px;
            text: "Stones, up to";
            font-size: 12px;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }
        Stepper {
            label: "Most Stones per Layout";
            hint: "The most stones one layout may hold in all, whatever their designs, from 1 to 99. No limit (0): the planner fits as many stones as yield the most weight. With a limit the planner looks for the heaviest layouts of at most that many stones, which often have larger stones.";
            value_text: RoughPlanModel.max_stones == 0 ? "No limit" : "" + RoughPlanModel.max_stones;
            enabled: !root.busy;
            can_dec: RoughPlanModel.max_stones > 0;
            can_inc: RoughPlanModel.max_stones < 99;
            decrement => { RoughPlanModel.max_stones = Math.max(0, RoughPlanModel.max_stones - 1); }
            increment => { RoughPlanModel.max_stones = Math.min(99, RoughPlanModel.max_stones + 1); }
        }
        Text {
            text: RoughPlanModel.max_stones == 0 ? "" : "per layout";
            font-size: 11px;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
    }

    // Candidate Designs choice
    VerticalLayout {
        spacing: 4px;
        Text {
            text: "Candidate designs";
            font-size: 11px;
            color: Theme.text-secondary;
        }
        KitSegmentBar {
            HorizontalLayout {
                padding: 2px;
                spacing: 2px;
                HalfSegment {
                    text: root.short_label("Filter", RoughPlanModel.filter_count_text);
                    alabel: root.count_label("Current Filter", RoughPlanModel.filter_count_text, RoughPlanModel.filter_count);
                    hint: "Plan with the designs the library list shows now, after its search and filters.";
                    on: RoughPlanModel.use_filter;
                    enabled: !root.busy;
                    picked => { RoughPlanModel.use_filter = true; }
                }
                HalfSegment {
                    text: root.short_label("Library", RoughPlanModel.library_count_text);
                    alabel: root.count_label("Whole Library", RoughPlanModel.library_count_text, RoughPlanModel.library_count);
                    hint: "Plan with every design in the library, whatever the filters say.";
                    on: !RoughPlanModel.use_filter;
                    enabled: !root.busy;
                    picked => { RoughPlanModel.use_filter = false; }
                }
            }
        }
    }

    // Excluded designs: the designs the planner leaves out of both candidate choices, each with a
    // Restore button. Like the losses fields, the list folds away while a plan runs.
    if RoughPlanModel.excluded_count > 0: VerticalLayout {
        spacing: 6px;

        HorizontalLayout {
            spacing: 6px;
            Text {
                text: RoughPlanModel.excluded_count == 1 ? "1 design excluded" : RoughPlanModel.excluded_count + " designs excluded";
                font-size: 12px;
                color: Theme.text-muted;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
            LinkText {
                text: RoughPlanModel.excluded_open && !root.busy ? "Hide" : "Show";
                accessible-label: "Excluded Designs (" + RoughPlanModel.excluded_count + "): designs the planner leaves out";
                hint: "Show or hide the designs the planner leaves out of its candidates. Restore takes one back.";
                clicked => { RoughPlanModel.excluded_open = !RoughPlanModel.excluded_open; }
            }
        }

        if RoughPlanModel.excluded_open && !root.busy: VerticalLayout {
            spacing: 6px;

            // Three rows show at once (30 px each, with their spacing); more scroll.
            ScrollView {
                height: Math.min(RoughPlanModel.excluded_count * 32px, 96px);

                VerticalLayout {
                    alignment: start;
                    spacing: 2px;
                    padding-right: 12px;

                    for excluded_name[index] in RoughPlanModel.excluded_names: HorizontalLayout {
                        spacing: 6px;
                        height: 30px;

                        ElidedText {
                            text: excluded_name;
                            font_size: 12px;
                            text_color: Theme.text-secondary;
                            tip: true;
                        }

                        VerticalLayout {
                            alignment: center;
                            KitButton {
                                text: "Restore";
                                kind: 2;
                                h: 26px;
                                accessible-label: "Restore " + excluded_name + " to Planning";
                                hint: RoughPlanModel.running ? "Not while a plan is running." : "Take this design back into the planning.";
                                enabled: !RoughPlanModel.running;
                                clicked => { RoughPlanModel.restore_excluded(RoughPlanModel.excluded_ids[index]); }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                KitButton {
                    text: "Restore All";
                    h: 28px;
                    hint: RoughPlanModel.running ? "Not while a plan is running." : "Take every excluded design back into the planning.";
                    enabled: !RoughPlanModel.running;
                    clicked => { RoughPlanModel.restore_all_excluded(); }
                }
            }
        }
    }

    // Losses: a summary and Edit, which folds the four fields open.
    VerticalLayout {
        spacing: 8px;

        HorizontalLayout {
            spacing: 6px;
            Text {
                text: "Losses (mm)";
                font-size: 12px;
                color: Theme.text-secondary;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
            ElidedText {
                text: "kerf " + RoughPlanModel.kerf_mm + " \u{00B7} allow. " + RoughPlanModel.allowance_mm
                    + " \u{00B7} min " + RoughPlanModel.min_width_mm;
                font_size: 11px;
                text_color: Theme.text-muted;
                tip: true;
            }
            LinkText {
                text: RoughPlanModel.losses_open && !root.busy ? "Done" : "Edit";
                accessible-label: "Losses: Kerf, Allowance, Skin and Minimum Stone Width";
                hint: "Show or hide the four numbers that say how much rough is lost: the saw kerf, the allowance, the rough skin and the smallest stone.";
                clicked => { RoughPlanModel.losses_open = !RoughPlanModel.losses_open; }
            }
        }

        // The fields fold away while a plan runs; the one-line summary above still shows the
        // values in use.
        if RoughPlanModel.losses_open && !root.busy: VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 6px;
                PlanField {
                    label: "Saw Kerf";
                    alabel: "Saw Kerf (mm)";
                    unit: "mm";
                    hint: "The width of the saw cut, in millimetres: rough that turns to dust at every saw cut.";
                    editable: !root.busy;
                    value <=> RoughPlanModel.kerf_mm;
                }
                PlanField {
                    label: "Allowance / Side";
                    alabel: "Allowance / Side (mm)";
                    unit: "mm";
                    hint: "Extra rough kept around each stone on every side, in millimetres, for the cutting itself.";
                    editable: !root.busy;
                    value <=> RoughPlanModel.allowance_mm;
                }
            }

            HorizontalLayout {
                spacing: 6px;
                PlanField {
                    label: "Rough Skin";
                    alabel: "Rough Skin (mm)";
                    unit: "mm";
                    hint: "The thickness of the rough's outer skin that cannot be used, in millimetres.";
                    editable: !root.busy;
                    value <=> RoughPlanModel.skin_mm;
                }
                PlanField {
                    label: "Min Stone Width";
                    alabel: "Min Stone Width (mm)";
                    unit: "mm";
                    hint: "The narrowest stone the planner may place, in millimetres.";
                    editable: !root.busy;
                    value <=> RoughPlanModel.min_width_mm;
                }
            }
        }
    }

    // Scan plan time limit: only a rough with a mesh obeys it (a scan, or a block, cylinder or
    // pebble with inclusions, whose rows are non-empty exactly then), so only then is it shown.
    if RoughPlanModel.locate_possible || RoughPlanModel.inclusion_rows.length > 0: VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            PlanField {
                horizontal-stretch: 0;
                preferred-width: 190px;
                label: "Scan Plan Time Limit";
                alabel: "Scan Plan Time Limit (s)";
                unit: "s";
                hint: "A plan of a scanned rough stops after this many seconds and shows the best layouts found so far. 0 means no limit.";
                editable: !root.busy;
                value <=> RoughPlanModel.time_limit_secs;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        WrapText {
            text: "Scans plan on a coarser grid and use every core.";
            font_size: 11px;
            text_color: Theme.text-muted;
        }
    }
}
