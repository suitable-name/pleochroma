import { Theme } from "../../theme.slint";
import { ScrollView, LineEdit } from "std-widgets.slint";
import { RoughPlanModel, SavedRoughPlanRow } from "../../models/rough_plan.slint";
import { KitIconButton, KitIcons, KitButton } from "../kit/kit.slint";
import { RoughUi } from "state.slint";
import { WrapText } from "fields.slint";

// One saved plan of the Saved Plans tab: its name, summary and date, and a "..." menu (Open,
// Rename, Export, Delete, drawn by the window). A double-click opens the plan. Rename and the
// delete question open inside the card.
component SavedPlanCard inherits Rectangle {
    in property <SavedRoughPlanRow> plan;
    in property <int> index;

    property <bool> renaming: RoughUi.rename_row == root.index;
    property <bool> confirming_delete: RoughUi.delete_row == root.index;
    property <string> new_name: root.plan.name;

    // The rename row opens with the plan's current name selected.
    changed renaming => {
        if root.renaming {
            root.new_name = root.plan.name;
        }
    }

    // The rename row closes when the list comes back with the change, not when the button is
    // pressed: a name Rust refuses leaves the row open beside the error.
    changed plan => {
        if RoughUi.rename_row == root.index {
            RoughUi.rename_row = -1;
        }
        if RoughUi.delete_row == root.index {
            RoughUi.delete_row = -1;
        }
    }

    background: Theme.bg-card;
    border-radius: 9px;
    min-height: Math.max(58px, saved_lay.preferred-height);

    accessible-role: AccessibleRole.list-item;
    accessible-label: root.plan.name;
    accessible-description: root.plan.summary;

    // Declared first: a double-click on the card's body opens the plan.
    TouchArea {
        enabled: !RoughPlanModel.running;
        double-clicked => { RoughPlanModel.saved_menu(root.index, 0); }
    }

    saved_lay := VerticalLayout {
        padding-left: 12px;
        padding-right: 4px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 6px;

        if !root.renaming && !root.confirming_delete: HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                alignment: center;
                spacing: 2px;
                Rectangle {
                    height: 18px;
                    Text {
                        x: 0px;
                        width: parent.width;
                        height: parent.height;
                        text: root.plan.name;
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                Rectangle {
                    height: 15px;
                    Tooltip { text: @markdown("\{root.plan.summary}"); }
                    Text {
                        x: 0px;
                        width: parent.width;
                        height: parent.height;
                        text: root.plan.summary;
                        font-size: 11px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            Text {
                text: root.plan.date;
                font-size: 11px;
                color: Theme.text-muted;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
            VerticalLayout {
                alignment: center;
                KitIconButton {
                    d: KitIcons.more;
                    size: 28px;
                    stroke: 2.6px;
                    label: "Menu of " + root.plan.name;
                    hint: "Open, rename, export or delete this saved plan.";
                    clicked => {
                        RoughUi.menu_kind = 3;
                        RoughUi.menu_row = root.index;
                        RoughUi.menu_group = -1;
                        RoughUi.menu_right = true;
                        RoughUi.menu_x = self.absolute-position.x + self.width;
                        RoughUi.menu_y = self.absolute-position.y + self.height + 4px;
                    }
                }
            }
        }

        // Inline renaming row
        if root.renaming: HorizontalLayout {
            spacing: 6px;
            padding-right: 8px;
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                height: 30px;
                Tooltip { text: @markdown("The new name of the plan. Enter keeps it."); }
                LineEdit {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    font-size: 13px;
                    text <=> root.new_name;
                    accessible-label: "New Name of " + root.plan.name;
                    init => {
                        self.focus();
                        self.select-all();
                    }
                    accepted => { RoughPlanModel.rename_saved(root.plan.id, root.new_name); }
                }
            }
            KitButton {
                text: "Save";
                kind: 1;
                h: 30px;
                hint: "Keep the new name. Enter does the same.";
                clicked => { RoughPlanModel.rename_saved(root.plan.id, root.new_name); }
            }
            KitButton {
                text: "Cancel";
                h: 30px;
                hint: "Keep the old name.";
                clicked => {
                    root.new_name = root.plan.name;
                    RoughUi.rename_row = -1;
                }
            }
        }

        // The delete question: Rust deletes at once when it is answered with Delete.
        if root.confirming_delete: VerticalLayout {
            spacing: 6px;
            padding-right: 8px;
            WrapText {
                text: "Delete \"" + root.plan.name + "\"? This cannot be undone.";
                font_size: 12px;
                text_color: Theme.danger;
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                KitButton {
                    text: "Cancel";
                    h: 28px;
                    hint: "Keep this plan.";
                    clicked => { RoughUi.delete_row = -1; }
                }
                KitButton {
                    text: "Yes, Delete";
                    h: 28px;
                    hint: "Delete this saved plan for good.";
                    clicked => {
                        RoughUi.delete_row = -1;
                        RoughPlanModel.saved_menu(root.index, 3);
                    }
                }
            }
        }
    }
}

// The Saved Plans tab: one card per plan and Import.
export component SavedList inherits VerticalLayout {
    spacing: 8px;

    // The latest note (a plan opened, renamed, exported) and the latest error
    if RoughPlanModel.status_text != "": WrapText {
        text: RoughPlanModel.status_text;
        font_size: 11px;
        text_color: RoughPlanModel.status_level == 1 ? Theme.accent-amber : Theme.text-secondary;
    }

    if RoughPlanModel.error_text != "": WrapText {
        text: RoughPlanModel.error_text;
        font_size: 11px;
        text_color: Theme.danger;
    }

    if RoughPlanModel.saved_plans.length == 0: Rectangle {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            Text {
                text: "No saved plans yet.";
                font-size: 14px;
                font-weight: 600;
                color: Theme.text-primary;
                horizontal-alignment: center;
            }
            WrapText {
                text: "Save layouts from the Layouts tab to see them here, or click Import to load a file.";
                font_size: 12px;
                text_color: Theme.text-secondary;
                alignment: center;
            }
        }
    }

    if RoughPlanModel.saved_plans.length > 0: ScrollView {
        vertical-stretch: 1;
        content-width: self.visible-width;

        VerticalLayout {
            alignment: start;
            spacing: 6px;
            // The scroll bar is drawn over the right edge: leave it room.
            padding-right: 12px;

            for plan[i] in RoughPlanModel.saved_plans: SavedPlanCard {
                plan: plan;
                index: i;
            }
        }
    }

    HorizontalLayout {
        alignment: start;
        KitButton {
            text: "Import\u{2026}";
            kind: 2;
            h: 30px;
            enabled: !RoughPlanModel.running;
            hint: RoughPlanModel.running ? "Not while a plan is running. Wait for it to finish, or cancel it."
                : "Load a plan from a file that Export wrote, and add it to this list.";
            clicked => { RoughPlanModel.import_saved(); }
        }
    }
}
