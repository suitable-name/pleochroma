import { Theme } from "../../theme.slint";
import { RoughPlanModel } from "../../models/rough_plan.slint";
import { Zoning } from "../../models/zoning.slint";
import { KitIcons, KitIconButton, KitButton, KitCombo, KitSegment, KitSegmentBar } from "../kit/kit.slint";
import { RoughUi } from "state.slint";
import { PlanField, ShapeTile, NoteChip } from "parts.slint";
import { ElidedText, WrapText } from "fields.slint";
import { ScanCard, ScanReport } from "scan_card.slint";

// The inclusions of the rough: closed shapes inside it where no stone may go. They still count
// as material in the weight and the yield. Adding or removing one is an undo step. Every rough
// takes them. On a block, a cylinder or a pebble the cutter chooses the kind (a mesh file or a
// typed sphere, ellipsoid or box) and types where it goes; on a scan the inclusion is always a
// mesh file in the scan's coordinates, so those controls are not shown.
component InclusionSection inherits VerticalLayout {
    property <bool> editable: !RoughPlanModel.running && !RoughPlanModel.mesh_busy;

    spacing: 8px;

    HorizontalLayout {
        spacing: 6px;
        Text {
            text: "Inclusions";
            font-size: 12px;
            color: Theme.text-secondary;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        Text {
            text: RoughPlanModel.inclusion_rows.length == 0 ? "none" : "" + RoughPlanModel.inclusion_rows.length;
            font-size: 12px;
            color: Theme.text-muted;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        Rectangle { horizontal-stretch: 1; }
        KitButton {
            text: "Add";
            icon: KitIcons.plus;
            kind: 2;
            h: 28px;
            active: RoughUi.add_open;
            enabled: root.editable;
            accessible-label: "Add an Inclusion";
            hint: root.editable
                ? "Open the form that adds an inclusion: a crack or a crystal of another mineral inside the rough that stones keep clear of."
                : (RoughPlanModel.running ? "Not while a plan is running. Wait for it to finish, or cancel it." : "Wait for the mesh to finish loading.");
            clicked => { RoughUi.add_open = !RoughUi.add_open; }
        }
    }

    if RoughUi.add_open: Rectangle {
        border-radius: 10px;
        background: Theme.bg-input;
        min-height: form_lay.preferred-height;

        form_lay := VerticalLayout {
            padding: 10px;
            spacing: 8px;

            if RoughPlanModel.inclusion_placement_possible: VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Kind";
                    font-size: 11px;
                    color: Theme.text-secondary;
                }
                KitCombo {
                    model: RoughPlanModel.inclusion_kinds;
                    current_index <=> RoughPlanModel.inclusion_kind_index;
                    enabled: root.editable;
                    label: "Kind of the New Inclusion";
                    hint: "What to add. A Mesh File is your own closed 3D model of the inclusion. A Sphere, an Ellipsoid or a Box is a shape you describe by its size.";
                }
            }

            // The unit of the numbers in the inclusion's file: the session's mesh unit, which
            // the scan card's File units box sets for a scan (whose inclusions share its unit).
            if RoughPlanModel.inclusion_placement_possible && RoughPlanModel.inclusion_kind_index == 0: VerticalLayout {
                spacing: 4px;
                Text {
                    text: "File units";
                    font-size: 11px;
                    color: Theme.text-secondary;
                }
                KitCombo {
                    model: RoughPlanModel.mesh_units;
                    current_index <=> RoughPlanModel.mesh_unit_index;
                    enabled: root.editable;
                    label: "Unit of the Numbers in the Inclusion's File";
                    hint: "The unit the numbers in the inclusion's mesh file are in. The planner scales them to millimetres. A 3D scan of the rough uses the same setting.";
                }
            }

            // Where the inclusion goes: its centre in mm from the corner of the uncut rough.
            if RoughPlanModel.inclusion_placement_possible: HorizontalLayout {
                spacing: 6px;
                PlanField {
                    label: "Position X";
                    alabel: "Position X (mm)";
                    unit: "mm";
                    hint: "Where the centre of the inclusion is along X, in millimetres from the corner of the rough. Leave it empty for the middle of the rough.";
                    placeholder: "centre";
                    editable: root.editable;
                    value <=> RoughPlanModel.inclusion_x_mm;
                }
                PlanField {
                    label: "Position Y";
                    alabel: "Position Y (mm)";
                    unit: "mm";
                    hint: "Where the centre of the inclusion is along Y, in millimetres from the corner of the rough. Leave it empty for the middle of the rough.";
                    placeholder: "centre";
                    editable: root.editable;
                    value <=> RoughPlanModel.inclusion_y_mm;
                }
                PlanField {
                    label: "Position Z";
                    alabel: "Position Z (mm)";
                    unit: "mm";
                    hint: "Where the centre of the inclusion is along Z, in millimetres from the corner of the rough. Leave it empty for the middle of the rough.";
                    placeholder: "centre";
                    editable: root.editable;
                    value <=> RoughPlanModel.inclusion_z_mm;
                }
            }
            if RoughPlanModel.inclusion_placement_possible: WrapText {
                text: "Position is the centre of the inclusion, in mm from the corner of the rough. An empty field is the middle of the rough"
                    + (RoughPlanModel.inclusion_centre_text != "" ? " (" + RoughPlanModel.inclusion_centre_text + ")." : ".")
                    + (RoughPlanModel.inclusion_kind_index == 0 ? " A mesh file is placed by the centre of its bounding box." : "");
                font_size: 11px;
                text_color: Theme.text-muted;
            }

            // The size of a typed shape: a sphere takes only its diameter.
            if RoughPlanModel.inclusion_placement_possible && RoughPlanModel.inclusion_kind_index == 1: HorizontalLayout {
                spacing: 6px;
                PlanField {
                    label: "Diameter";
                    alabel: "Diameter (mm)";
                    unit: "mm";
                    hint: "How wide the sphere is across, in millimetres. There is no default: type it.";
                    placeholder: "e.g. 3.0";
                    editable: root.editable;
                    value <=> RoughPlanModel.inclusion_size_x_mm;
                }
                Rectangle { horizontal-stretch: 2; preferred-width: 0px; }
            }
            if RoughPlanModel.inclusion_placement_possible && RoughPlanModel.inclusion_kind_index >= 2: HorizontalLayout {
                spacing: 6px;
                PlanField {
                    label: RoughPlanModel.inclusion_kind_index == 2 ? "Axis X" : "Edge X";
                    alabel: RoughPlanModel.inclusion_kind_index == 2 ? "Axis X (mm)" : "Edge X (mm)";
                    unit: "mm";
                    hint: RoughPlanModel.inclusion_kind_index == 2
                        ? "The full length of the ellipsoid along X, in millimetres (not the half length). There is no default: type it."
                        : "The length of the box along X, in millimetres. There is no default: type it.";
                    placeholder: "e.g. 3.0";
                    editable: root.editable;
                    value <=> RoughPlanModel.inclusion_size_x_mm;
                }
                PlanField {
                    label: RoughPlanModel.inclusion_kind_index == 2 ? "Axis Y" : "Edge Y";
                    alabel: RoughPlanModel.inclusion_kind_index == 2 ? "Axis Y (mm)" : "Edge Y (mm)";
                    unit: "mm";
                    hint: RoughPlanModel.inclusion_kind_index == 2
                        ? "The full length of the ellipsoid along Y, in millimetres (not the half length). There is no default: type it."
                        : "The length of the box along Y, in millimetres. There is no default: type it.";
                    placeholder: "e.g. 2.0";
                    editable: root.editable;
                    value <=> RoughPlanModel.inclusion_size_y_mm;
                }
                PlanField {
                    label: RoughPlanModel.inclusion_kind_index == 2 ? "Axis Z" : "Edge Z";
                    alabel: RoughPlanModel.inclusion_kind_index == 2 ? "Axis Z (mm)" : "Edge Z (mm)";
                    unit: "mm";
                    hint: RoughPlanModel.inclusion_kind_index == 2
                        ? "The full length of the ellipsoid along Z, in millimetres (not the half length). There is no default: type it."
                        : "The length of the box along Z, in millimetres. There is no default: type it.";
                    placeholder: "e.g. 1.5";
                    editable: root.editable;
                    value <=> RoughPlanModel.inclusion_size_z_mm;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                PlanField {
                    horizontal-stretch: 0;
                    preferred-width: 110px;
                    label: "Margin";
                    alabel: "Margin of a New Inclusion in Millimetres";
                    unit: "mm";
                    hint: "How far stones keep away from the inclusion, in millimetres, because the edge of a real inclusion is uncertain. Leave it empty for 0.3. It is applied when you add the inclusion.";
                    editable: root.editable;
                    value <=> RoughPlanModel.inclusion_margin;
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: end;
                    KitButton {
                        text: RoughPlanModel.inclusion_placement_possible && RoughPlanModel.inclusion_kind_index != 0
                            ? "Add Inclusion" : "Add Inclusion...";
                        h: 30px;
                        enabled: root.editable;
                        hint: RoughPlanModel.running ? "Not while a plan is running. Wait for it to finish, or cancel it."
                            : (RoughPlanModel.mesh_busy ? "Wait for the mesh to finish loading."
                            : (!RoughPlanModel.inclusion_placement_possible
                                ? "Pick a mesh file (OBJ, STL or PLY) of a closed shape inside the rough, such as a crack or a crystal of another mineral. Stones keep clear of it, and the weight and the yield count it as material. The file uses the same coordinates and unit as the scan's file."
                            : (RoughPlanModel.inclusion_kind_index == 0
                                ? "Pick a mesh file (OBJ, STL or PLY) of a closed shape, such as a crack or a crystal of another mineral. Its numbers are in the File units above, and its bounding box has its centre at the position above. Stones keep clear of it, and the weight and the yield count it as material."
                                : "Add the shape at the position and size above. Stones keep clear of it, and the weight and the yield count it as material.")));
                        clicked => { RoughPlanModel.add_inclusion(); }
                    }
                }
            }
        }
    }

    for row[i] in RoughPlanModel.inclusion_rows: HorizontalLayout {
        spacing: 6px;
        ElidedText {
            text: row;
            font_size: 12px;
            text_color: Theme.text-secondary;
            tip: true;
        }
        KitIconButton {
            d: KitIcons.close;
            size: 26px;
            ink: Theme.text-muted;
            label: "Remove";
            hint: "Take this inclusion out again. Stones may then be placed there, and the weight is unchanged.";
            enabled: root.editable;
            clicked => { RoughPlanModel.remove_inclusion(i); }
        }
    }

    // Photo-based entry points: they need a mesh to trace through, so scan roughs only. Small
    // ghost buttons under the inclusions.
    if RoughPlanModel.locate_possible: HorizontalLayout {
        spacing: 6px;
        alignment: start;
        KitButton {
            text: "Locate from Photos...";
            kind: 2;
            h: 28px;
            enabled: root.editable;
            accessible-label: "Locate Inclusion from Photos...";
            hint: RoughPlanModel.running ? "Not while a plan is running. Wait for it to finish, or cancel it."
                : (RoughPlanModel.mesh_busy ? "Wait for the mesh to finish loading."
                : "Find an inclusion from photos of the rough taken on a fixed camera rig. Light from the inclusion bends at the surface, so the position is worked out through the mesh.");
            clicked => { RoughPlanModel.locate_inclusion(); }
        }
        KitButton {
            text: "Rough Color...";
            kind: 2;
            h: 28px;
            enabled: root.editable;
            hint: RoughPlanModel.running || RoughPlanModel.mesh_busy ? "Not while a plan is running or a mesh is loading."
                : "Work out the color of the stone, and of color zones inside it, from photos of the rough on a backlit rig.";
            clicked => { Zoning.open_rough_colour(); }
        }
    }
}

// Step 1 of the left column: the rough's shape (a block, a cylinder, a pebble or a 3D scan), its
// sizes, material, weighed carat, the weight check and the inclusions.
export component RoughForm inherits VerticalLayout {
    property <bool> editable: !RoughPlanModel.running && !RoughPlanModel.mesh_busy;

    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    spacing: 10px;

    HorizontalLayout {
        spacing: 6px;
        ShapeTile {
            d: KitIcons.block;
            text: "Block";
            hint: "A rectangular block of rough. You give its three sizes in millimetres.";
            on: RoughPlanModel.base_kind == 0;
            enabled: root.editable;
            picked => { RoughPlanModel.set_base(0); }
        }
        ShapeTile {
            d: KitIcons.cylinder;
            text: "Cylinder";
            hint: "A round rod of rough: you give its diameter, its length and the axis it runs along.";
            on: RoughPlanModel.base_kind == 1;
            enabled: root.editable;
            picked => { RoughPlanModel.set_base(1); }
        }
        ShapeTile {
            d: KitIcons.pebble;
            text: "Pebble";
            hint: "A rounded, pebble-shaped rough. You give its three sizes in millimetres.";
            on: RoughPlanModel.base_kind == 2;
            enabled: root.editable;
            picked => { RoughPlanModel.set_base(2); }
        }
        ShapeTile {
            d: KitIcons.scan;
            text: "3D Scan";
            hint: "Use your own 3D scan of the rough from an .OBJ, .STL or .PLY file. Choosing this opens a file picker. Files up to 64 MB are read.";
            on: RoughPlanModel.base_kind == 3;
            enabled: root.editable;
            picked => { RoughPlanModel.import_obj(); }
        }
    }

    // A scan: the file card and, once it is read, the import report.
    if RoughPlanModel.base_kind == 3: ScanCard {}
    if RoughPlanModel.base_kind == 3 && RoughPlanModel.scan_verdict >= 0 && !RoughPlanModel.mesh_busy: ScanReport {}

    // Block or Pebble dimensions (X, Y, Z in mm)
    if RoughPlanModel.base_kind == 0 || RoughPlanModel.base_kind == 2: HorizontalLayout {
        spacing: 6px;
        PlanField {
            label: "Rough X";
            alabel: "Rough X (mm)";
            unit: "mm";
            hint: "The size of the rough along the X axis, in millimetres.";
            placeholder: "e.g. 18.4";
            editable: !RoughPlanModel.running;
            value <=> RoughPlanModel.rough_x;
            committed => { RoughPlanModel.base_field_committed(); }
        }
        PlanField {
            label: "Rough Y";
            alabel: "Rough Y (mm)";
            unit: "mm";
            hint: "The size of the rough along the Y axis, in millimetres.";
            placeholder: "e.g. 11.0";
            editable: !RoughPlanModel.running;
            value <=> RoughPlanModel.rough_y;
            committed => { RoughPlanModel.base_field_committed(); }
        }
        PlanField {
            label: "Rough Z";
            alabel: "Rough Z (mm)";
            unit: "mm";
            hint: "The size of the rough along the Z axis, in millimetres.";
            placeholder: "e.g. 9.6";
            editable: !RoughPlanModel.running;
            value <=> RoughPlanModel.rough_z;
            committed => { RoughPlanModel.base_field_committed(); }
        }
    }

    // Cylinder dimensions (Diameter, Length, Axis)
    if RoughPlanModel.base_kind == 1: VerticalLayout {
        spacing: 10px;
        HorizontalLayout {
            spacing: 6px;
            PlanField {
                label: "Diameter";
                alabel: "Diameter (mm)";
                unit: "mm";
                hint: "How wide the round rough is across, in millimetres.";
                placeholder: "e.g. 10.0";
                editable: !RoughPlanModel.running;
                value <=> RoughPlanModel.cyl_diameter;
                committed => { RoughPlanModel.base_field_committed(); }
            }
            PlanField {
                label: "Length";
                alabel: "Length (mm)";
                unit: "mm";
                hint: "How long the rough is along its axis, in millimetres.";
                placeholder: "e.g. 24.0";
                editable: !RoughPlanModel.running;
                value <=> RoughPlanModel.cyl_length;
                committed => { RoughPlanModel.base_field_committed(); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Axis";
                font-size: 12px;
                color: Theme.text-secondary;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
            KitSegmentBar {
                width: 3 * 52px + 8px;
                HorizontalLayout {
                    padding: 1px;
                    spacing: 2px;
                    alignment: center;
                    KitSegment {
                        text: "X";
                        hint: "The rod runs along the X axis.";
                        on: RoughPlanModel.cyl_axis == 0;
                        enabled: !RoughPlanModel.running;
                        picked => { RoughPlanModel.cyl_axis = 0; RoughPlanModel.base_field_committed(); }
                    }
                    KitSegment {
                        text: "Y";
                        hint: "The rod runs along the Y axis.";
                        on: RoughPlanModel.cyl_axis == 1;
                        enabled: !RoughPlanModel.running;
                        picked => { RoughPlanModel.cyl_axis = 1; RoughPlanModel.base_field_committed(); }
                    }
                    KitSegment {
                        text: "Z";
                        hint: "The rod runs along the Z axis.";
                        on: RoughPlanModel.cyl_axis == 2;
                        enabled: !RoughPlanModel.running;
                        picked => { RoughPlanModel.cyl_axis = 2; RoughPlanModel.base_field_committed(); }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    // Material dropdown
    VerticalLayout {
        spacing: 4px;
        Text {
            text: "Material";
            font-size: 11px;
            color: Theme.text-secondary;
        }
        KitCombo {
            model: RoughPlanModel.materials;
            current_index <=> RoughPlanModel.material_index;
            enabled: !RoughPlanModel.running && RoughPlanModel.materials.length > 0;
            label: "Material of the Rough";
            hint: "The gem material of the rough. Its specific gravity turns the volume of the model into carats.";
            selected(i) => { RoughPlanModel.base_field_committed(); }
        }
    }
    if RoughPlanModel.materials.length == 0: WrapText {
        text: "No material with a known specific gravity is available.";
        font_size: 11px;
        text_color: Theme.accent-amber;
    }

    // Weighed carat: the model's own weight until a weighed carat is typed over it, and the
    // Fit to Weight action that scales the model to the typed weight.
    HorizontalLayout {
        spacing: 6px;
        PlanField {
            label: "Carat";
            alabel: "Carat (ct)";
            unit: "ct";
            hint: "The weight of the rough in carats, if you have weighed it. Leave it alone to use the weight of the model. Fit to Weight scales the model to this weight.";
            placeholder: "e.g. 8.90";
            editable: !RoughPlanModel.running;
            value <=> RoughPlanModel.weighed_ct;
            committed => { RoughPlanModel.base_field_committed(); }
        }
        VerticalLayout {
            alignment: end;
            KitButton {
                text: "Fit to Weight";
                h: 30px;
                enabled: root.editable && RoughPlanModel.weight_check_level != 0;
                hint: RoughPlanModel.running ? "Not while a plan is running. Wait for it to finish, or cancel it."
                    : (RoughPlanModel.mesh_busy ? "Wait for the mesh to finish loading."
                    : (RoughPlanModel.weight_check_level == 0 ? "Type a weighed carat first, so there is a weight to scale the model to."
                    : "Scale the model up or down until its weight matches the carat you typed."));
                clicked => { RoughPlanModel.fit_to_weight(); }
            }
        }
    }

    // The weight check, with the model's volume and weight as its tooltip.
    if RoughPlanModel.weight_check_text != "" || RoughPlanModel.model_text != "": NoteChip {
        text: RoughPlanModel.weight_check_text != "" ? RoughPlanModel.weight_check_text : RoughPlanModel.model_text;
        hint: RoughPlanModel.weight_check_text != "" ? RoughPlanModel.model_text : "";
        level: RoughPlanModel.weight_check_level;
    }

    // Model error if invalid
    if RoughPlanModel.model_error != "": WrapText {
        text: RoughPlanModel.model_error;
        font_size: 12px;
        text_color: Theme.danger;
    }

    if RoughPlanModel.inclusions_possible: InclusionSection {}
}
