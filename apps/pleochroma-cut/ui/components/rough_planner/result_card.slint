import { Theme } from "../../theme.slint";
import { RoughPlanModel, RoughPlanResult, RoughPlanStoneGroup } from "../../models/rough_plan.slint";
import { Zoning } from "../../models/zoning.slint";
import { KitIcon, KitIcons, KitIconButton, KitButton, KitBadge, KitSegmentBar } from "../kit/kit.slint";
import { RoughUi, RoughIcons } from "state.slint";
import { Metric, HalfSegment, LinkText, FillBar } from "parts.slint";
import { WrapText } from "fields.slint";
import { StoneRows, DesignRule } from "stone_rows.slint";

// One design of the selected layout: a thumbnail (or a gem icon in the design's color), the count
// and name, the detail line, what the library check found, and a "..." menu. A click on the card
// picks the design (Rust highlights its stones in the view); the name is its own link to the
// design in the library.
component DesignCard inherits Rectangle {
    in property <RoughPlanStoneGroup> group;
    in property <int> result_index;
    in property <int> group_index;
    in property <bool> is_selected;
    callback clicked();

    property <bool> link_ok: root.group.linkable && RoughPlanModel.links_enabled;
    property <color> status_color: root.group.status_level == 3 ? Theme.danger
        : (root.group.status_level == 2 ? Theme.accent-amber : Theme.accent-cyan);

    background: root.is_selected ? Theme.bg-elevated : Theme.bg-input;
    border-radius: 9px;
    border-width: row_focus.has-focus ? 2px : (root.is_selected ? 1px : 0px);
    border-color: row_focus.has-focus ? Theme.accent-cyan-hover : Theme.accent-cyan;
    min-height: Math.max(54px, card_lay.preferred-height);

    accessible-role: AccessibleRole.list-item;
    accessible-label: root.group.count + " \u{00D7} " + root.group.name;
    accessible-description: root.group.status != "" ? root.group.status : root.group.detail;
    accessible-item-selectable: true;
    accessible-item-selected: root.is_selected;
    accessible-action-default => { root.clicked(); }

    Tooltip { text: @markdown("Highlight these stones in the 3D view. Click again to clear the highlight."); }
    row_focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    // Declared before the name link and the menu button, so they sit on top of it.
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    card_lay := HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 8px;
                background: Theme.bg-elevated;
                clip: true;
                if root.group.has_thumbnail: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.group.thumbnail;
                }
                if !root.group.has_thumbnail: KitIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    d: RoughIcons.gem;
                    size: 26px;
                    stroke: 1.5px;
                    ink: root.group.swatch;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: center;
            spacing: 2px;

            // The count and the title: the title is a link to the design in the library.
            Rectangle {
                height: 18px;
                Text {
                    x: 0px;
                    width: parent.width;
                    height: parent.height;
                    text: root.group.count + " \u{00D7} " + root.group.name;
                    font-size: 12px;
                    font-weight: 600;
                    color: name_touch.has-hover && root.link_ok ? Theme.accent-cyan-hover : Theme.text-primary;
                    vertical-alignment: center;
                    overflow: elide;
                }
                name_touch := TouchArea {
                    enabled: root.link_ok;
                    mouse-cursor: root.link_ok ? pointer : default;
                    clicked => { RoughPlanModel.select_design(root.group.entry_id); }
                }
                // The design name is a link: Tab reaches it, Space and Enter follow it.
                name_focus := FocusScope {
                    enabled: root.link_ok;
                    accessible-role: AccessibleRole.button;
                    accessible-label: "Show " + root.group.name + " in the Library";
                    accessible-description: "Select this design in the library list.";
                    accessible-action-default => { RoughPlanModel.select_design(root.group.entry_id); }
                    key-pressed(event) => {
                        if event.text == Key.Space || event.text == Key.Return {
                            RoughPlanModel.select_design(root.group.entry_id);
                            return accept;
                        }
                        return reject;
                    }
                }
                if name_focus.has-focus: Rectangle {
                    border-width: 2px;
                    border-color: Theme.accent-cyan-hover;
                    border-radius: 6px;
                }
                if root.link_ok: Tooltip { text: @markdown("Select this design in the library list."); }
            }

            if root.group.detail != "": Rectangle {
                height: 15px;
                Tooltip { text: @markdown("\{root.group.detail}"); }
                Text {
                    x: 0px;
                    width: parent.width;
                    height: parent.height;
                    text: root.group.detail;
                    font-size: 11px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // What the library check found, in full (a tooltip when it is still too long), and
            // the planner exclusion mark.
            if root.group.status != "" || root.group.excluded: Rectangle {
                height: 15px;
                Tooltip { text: @markdown("\{root.group.status}"); }
                Text {
                    x: 0px;
                    width: parent.width;
                    height: parent.height;
                    text: root.group.status != "" ? root.group.status : "Left out of future plans";
                    font-size: 11px;
                    color: root.group.status != "" ? root.status_color : Theme.accent-amber;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            KitIconButton {
                d: KitIcons.more;
                size: 28px;
                stroke: 2.6px;
                label: "Menu of " + root.group.name;
                hint: "Open in the editor, show in the library, leave out of the planner, or set the orientation rule of this design.";
                clicked => {
                    if RoughPlanModel.selected_group != root.group_index {
                        RoughPlanModel.select_group(root.result_index, root.group_index);
                    }
                    RoughUi.menu_kind = 4;
                    RoughUi.menu_row = root.result_index;
                    RoughUi.menu_group = root.group_index;
                    RoughUi.menu_right = true;
                    RoughUi.menu_x = self.absolute-position.x + self.width;
                    RoughUi.menu_y = self.absolute-position.y + self.height + 4px;
                }
            }
        }
    }
}

// The expanded part of the selected layout: its designs, the main figures, the stone orientation
// choice, the cut plan, the stones and the buttons.
component LayoutDetail inherits VerticalLayout {
    in property <RoughPlanResult> result;
    in property <int> rank_index;

    property <bool> is_expanded: RoughPlanModel.expanded_index == root.rank_index;

    function toggle_cut_plan() {
        if root.is_expanded {
            RoughPlanModel.expanded_index = -1;
            RoughPlanModel.cut_plan_toggled(-1);
        } else {
            RoughPlanModel.expanded_index = root.rank_index;
            RoughPlanModel.cut_plan_toggled(root.rank_index);
        }
    }

    padding-left: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    spacing: 8px;

    for group[g_idx] in root.result.groups: DesignCard {
        group: group;
        result_index: root.rank_index;
        group_index: g_idx;
        is_selected: RoughPlanModel.selected_group == g_idx;
        clicked => {
            RoughPlanModel.select_result(root.rank_index);
            RoughPlanModel.select_group(root.rank_index, g_idx);
        }
    }

    // The main figures, beside the layout's picture when there is one.
    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 12px;
                Metric { k: "Yield"; v: root.result.yield_pct; }
                Metric { k: "Stones"; v: root.result.stone_count == 1 ? "1 stone" : root.result.stone_count + " stones"; }
            }
            // One under the other: side by side, each got half of a column that shares its row
            // with the thumbnail, and both values elided.
            if root.result.saw_text != "" || root.result.yield_weight_text != "": VerticalLayout {
                spacing: 8px;
                if root.result.saw_text != "": Metric { k: "Saw cuts"; v: root.result.saw_text; }
                if root.result.yield_weight_text != "": Metric { k: "Of the weighed rough"; v: root.result.yield_weight_text; }
            }
        }
        if root.result.has_thumbnail && !RoughPlanModel.narrow: VerticalLayout {
            alignment: start;
            Rectangle {
                width: 88px;
                height: 66px;
                border-radius: 8px;
                background: Theme.surface-sunken;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.result.thumbnail;
                }
            }
        }
    }

    // All figures of every design, folded away.
    HorizontalLayout {
        alignment: start;
        LinkText {
            text: RoughUi.figures_open ? "Hide figures" : "All figures";
            hint: "Show or hide the full table of figures of each design in this layout.";
            clicked => { RoughUi.figures_open = !RoughUi.figures_open; }
        }
    }
    if RoughUi.figures_open: VerticalLayout {
        spacing: 8px;
        for group in root.result.groups: VerticalLayout {
            spacing: 2px;
            Text {
                text: group.count + " \u{00D7} " + group.name;
                font-size: 12px;
                font-weight: 600;
                color: Theme.text-primary;
                overflow: elide;
            }
            for metric in group.metrics: HorizontalLayout {
                spacing: 8px;
                Text {
                    width: 90px;
                    text: metric.label;
                    font-size: 11px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    height: 16px;
                    Tooltip { text: @markdown("\{metric.value}"); }
                    Text {
                        x: 0px;
                        width: parent.width;
                        height: parent.height;
                        text: metric.value;
                        font-size: 11px;
                        color: Theme.text-secondary;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }

    // Stone orientation (plan with a stored rough color): which of the stone's box-symmetric
    // poses the previews and "Use Color" take.
    if Zoning.colour_available: VerticalLayout {
        spacing: 4px;
        Text {
            text: "Stone Orientation";
            font-size: 11px;
            color: Theme.text-secondary;
        }
        KitSegmentBar {
            HorizontalLayout {
                padding: 2px;
                spacing: 2px;
                HalfSegment {
                    text: "Planner Pose";
                    alabel: "Keep Planner Pose";
                    hint: "Draw and adopt every stone in the pose the planner gave it.";
                    on: Zoning.pose_option == 0;
                    enabled: !RoughPlanModel.running;
                    picked => { Zoning.pose_option_changed(0); }
                }
                HalfSegment {
                    text: "Best Color";
                    hint: "Turn each stone to the box-symmetric pose that shows the most of the innermost color zone through the table.";
                    on: Zoning.pose_option == 1;
                    enabled: !RoughPlanModel.running;
                    picked => { Zoning.pose_option_changed(1); }
                }
            }
        }
    }

    // The cut plan and Open in Editor
    HorizontalLayout {
        spacing: 6px;
        KitButton {
            text: "Cut Plan";
            icon: root.is_expanded ? KitIcons.chevron-down : KitIcons.chevron-right;
            h: 30px;
            accessible-expandable: true;
            accessible-expanded: root.is_expanded;
            hint: "Show or hide the written cutting steps of this layout: which cuts to make, in which order.";
            clicked => { root.toggle_cut_plan(); }
        }
        Rectangle { horizontal-stretch: 1; }
        KitButton {
            text: "Open in Editor";
            h: 30px;
            enabled: root.result.groups.length > 0 && root.result.groups[0].linkable && RoughPlanModel.links_enabled && !RoughPlanModel.running;
            hint: !RoughPlanModel.links_enabled ? "Switch to the local library first: this needs the design in the library."
                : (RoughPlanModel.running ? "Not while a plan is running."
                : "Open the first design of this layout in the editor with the piece of rough its first stone comes from as its preform, at the stone's real size.");
            clicked => { RoughPlanModel.open_in_editor(root.rank_index, 0); }
        }
    }

    // The cut plan text, shown while Cut Plan is open.
    if root.is_expanded: Rectangle {
        background: Theme.surface-sunken;
        border-radius: 8px;
        min-height: plan_lay.preferred-height;
        plan_lay := VerticalLayout {
            padding: 8px;
            WrapText {
                text: root.result.cut_plan;
                font_size: 11px;
                text_color: Theme.text-secondary;
            }
        }
    }

    // The stones with what the crystal axis says about them, folded away.
    if RoughPlanModel.stone_rows.length > 0: HorizontalLayout {
        alignment: start;
        LinkText {
            text: RoughUi.stones_open ? "Hide stones" : "Stones (" + RoughPlanModel.stone_rows.length + ")";
            accessible-label: "Stones and the Crystal Axis";
            hint: "Show or hide the stones of this layout with the angle of the crystal axis to each: pose, re-fit, lock, free orientation and a reason.";
            clicked => { RoughUi.stones_open = !RoughUi.stones_open; }
        }
    }
    if RoughPlanModel.stone_rows.length > 0 && RoughUi.stones_open: StoneRows {}

    if RoughUi.design_rule_open && RoughPlanModel.design_rule_entry >= 0: DesignRule {}
}

// One ranked layout of the Layouts list: a row of 46 px (star, rank, weight with a yield bar,
// stones, yield, one dot per design, the layout's badge) that expands inline when selected. The
// `keep` flag belongs to Rust: the star asks for a flip with `toggle_keep` and the row comes back
// re-pushed, so the row never writes its own copy.
export component ResultCard inherits Rectangle {
    in property <RoughPlanResult> result;
    in property <int> rank_index;
    property <bool> is_selected: RoughPlanModel.selected_result == root.rank_index;

    background: root.is_selected ? Theme.bg-card : transparent;
    border-radius: 10px;
    border-width: root.is_selected ? 1px : 0px;
    border-color: Theme.accent-cyan;
    min-height: card_lay.preferred-height;

    card_lay := VerticalLayout {
        Rectangle {
            height: 46px;
            border-radius: 9px;
            background: head_touch.has-hover && !root.is_selected ? Theme.bg-card-hover : transparent;
            border-width: head_focus.has-focus ? 2px : 0px;
            border-color: Theme.accent-cyan-hover;

            accessible-role: AccessibleRole.list-item;
            accessible-label: "Result " + root.result.rank + ": " + root.result.total_ct + ", yield "
                + root.result.yield_pct + ", "
                + (root.result.stone_count == 1 ? "1 stone" : root.result.stone_count + " stones");
            accessible-description: "Show this layout in the 3D view.";
            accessible-item-selectable: true;
            accessible-item-selected: root.is_selected;
            accessible-action-default => { RoughPlanModel.select_result(root.rank_index); }

            Tooltip { text: @markdown("Show this layout in the 3D view. Star it to keep it for saving."); }
            head_focus := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Space || event.text == Key.Return {
                        RoughPlanModel.select_result(root.rank_index);
                        return accept;
                    }
                    return reject;
                }
            }

            // Declared before the controls: a click on the row selects the layout, and every
            // control drawn above it keeps its own clicks.
            head_touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { RoughPlanModel.select_result(root.rank_index); }
            }

            HorizontalLayout {
                padding-left: 4px;
                padding-right: 10px;
                spacing: 6px;

                VerticalLayout {
                    alignment: center;
                    KitIconButton {
                        d: KitIcons.star;
                        size: 28px;
                        icon_size: 16px;
                        stroke: 1.6px;
                        ink: root.result.keep ? Theme.accent-amber : Theme.text-disabled;
                        label: "Keep Result " + root.result.rank + " for saving";
                        hint: "Star this layout to keep it for saving. Save Starred saves every starred layout.";
                        accessible-role: AccessibleRole.checkbox;
                        accessible-label: "Keep Result " + root.result.rank + " for saving";
                        accessible-checkable: true;
                        accessible-checked: root.result.keep;
                        clicked => { RoughPlanModel.toggle_keep(root.rank_index); }
                    }
                }

                Text {
                    width: 26px;
                    text: "#" + root.result.rank;
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }

                // The total weight and the yield bar (relative to the best layout)
                VerticalLayout {
                    width: 88px;
                    alignment: center;
                    spacing: 4px;
                    Text {
                        text: root.result.total_ct;
                        font-size: 14px;
                        font-weight: 700;
                        color: root.is_selected ? Theme.accent-cyan-hover : Theme.text-primary;
                        overflow: elide;
                    }
                    FillBar {
                        fraction: root.result.yield_fraction;
                        fill: Theme.accent-emerald;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    alignment: center;
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: root.result.stone_count == 1 ? "1 stone" : root.result.stone_count + " stones";
                            font-size: 12px;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                        if root.result.badge != "": Rectangle {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            height: 20px;
                            clip: true;
                            Tooltip { text: @markdown("\{root.result.label}"); }
                            KitBadge {
                                x: 0px;
                                y: 0px;
                                text: root.result.badge;
                                fill: Theme.badge-purple-bg;
                                ink: Theme.badge-purple-text;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        Text {
                            text: root.result.yield_pct;
                            font-size: 11px;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                        Rectangle { width: 4px; }
                        for group[g] in root.result.groups: VerticalLayout {
                            alignment: center;
                            if g < 8: Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: group.swatch;
                            }
                        }
                    }
                }
            }
        }

        if root.is_selected: LayoutDetail {
            result: root.result;
            rank_index: root.rank_index;
        }
    }
}
