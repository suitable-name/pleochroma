import { Theme } from "../../theme.slint";
import { LineEdit } from "std-widgets.slint";
import { TipBox } from "../tip_box.slint";

// Caption above a form field, flush left (the shared `FieldCaption` centres its text). It
// carries the field's tooltip.
export component FieldLabel inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <length> font_size: 10px;

    height: caption.preferred-height;
    min-width: 0px;
    if root.hint != "": Tooltip { text: @markdown("\{root.hint}"); }
    caption := Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        text: root.text;
        font-size: root.font_size;
        color: Theme.text-muted;
        horizontal-alignment: left;
        overflow: elide;
        accessible-role: AccessibleRole.text;
    }
}

// A word-wrapped note sized to its own width. A wrapped `Text` in a layout reports only the
// height of its first line, so this box computes the height the text needs.
export component WrapText inherits Rectangle {
    in property <string> text;
    in property <length> font_size: 10px;
    in property <int> font_weight: 400;
    in property <color> text_color: Theme.text-secondary;
    in property <TextHorizontalAlignment> alignment: TextHorizontalAlignment.left;

    height: note.preferred-height;
    min-width: 0px;
    note := Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        text: root.text;
        font-size: root.font_size;
        font-weight: root.font_weight;
        color: root.text_color;
        horizontal-alignment: root.alignment;
        wrap: word-wrap;
    }
}

// An expander chevron drawn with Path (never unicode glyphs).
export component Chevron inherits Rectangle {
    in property <bool> open: false;
    in property <color> stroke_color: Theme.text-secondary;
    width: 8px;
    height: 8px;

    if root.open: Path {
        width: 100%;
        height: 100%;
        stroke: root.stroke_color;
        stroke-width: 1.5px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 8;
        viewbox-height: 8;
        MoveTo { x: 1; y: 2; }
        LineTo { x: 4; y: 6; }
        LineTo { x: 7; y: 2; }
    }

    if !root.open: Path {
        width: 100%;
        height: 100%;
        stroke: root.stroke_color;
        stroke-width: 1.5px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 8;
        viewbox-height: 8;
        MoveTo { x: 2; y: 1; }
        LineTo { x: 6; y: 4; }
        LineTo { x: 2; y: 7; }
    }
}

// The soft fade at the bottom edge of a scrolling area that has more below the fold: the cue
// that a block cut off at the edge goes on. It takes no clicks. Put it over the scroll view
// (the parent must be as large as the scroll view) and bind `more` to "content extends past
// the bottom"; `tint` is the colour of the surface behind.
export component ScrollFade inherits Rectangle {
    in property <bool> more;
    in property <color> tint: Theme.bg-dark;

    height: 34px;
    visible: root.more;
    background: @linear-gradient(180deg, root.tint.transparentize(1.0) 0%, root.tint 70%);

    // A down chevron on the fade: a row cut at the edge now reads as "scroll for more", not
    // as a clipped control.
    Chevron {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 4px;
        open: true;
        stroke_color: Theme.text-secondary;
    }
}

// A labelled text field. `min-width: 0px` overrides the fluent `LineEdit`'s 160px
// minimum so three of them fit side by side in a narrow card. `committed` fires on
// Enter and when the field loses focus, so a field's owner can react once per edit.
// Preferred width 0, so fields side by side share the row equally.
export component RoughField inherits VerticalLayout {
    in property <string> label;
    // One plain sentence: what the number means. The tooltip of the caption and the field.
    in property <string> hint;
    in property <string> placeholder;
    in property <bool> editable: true;
    in-out property <string> value;
    callback committed();

    // Set by a keystroke, cleared by the commit, so Enter followed by the focus
    // loss it causes reports one edit, not two.
    property <bool> dirty: false;

    horizontal-stretch: 1;
    preferred-width: 0px;
    spacing: 2px;

    FieldLabel { text: root.label; hint: root.hint; font_size: 10px; }
    TipBox {
        hint: root.hint;
        LineEdit {
            min-width: 0px;
            text <=> root.value;
            placeholder-text: root.placeholder;
            enabled: root.editable;
            accessible-label: root.label;
            accessible-description: root.hint;
            edited(t) => { root.dirty = true; }
            accepted => {
                if root.dirty {
                    root.dirty = false;
                    root.committed();
                }
            }
            changed has-focus => {
                if !self.has-focus && root.dirty {
                    root.dirty = false;
                    root.committed();
                }
            }
        }
    }
}

// A single line of text that shows an ellipsis instead of pushing its row wider.
// It is a wrapper with a fixed-size `Text` inside because that is what lets a
// stretching row shrink below the text's natural width.
export component ElidedText inherits Rectangle {
    in property <string> text;
    in property <length> font_size: 11px;
    in property <int> font_weight: 400;
    in property <color> text_color: Theme.text-primary;
    in property <TextHorizontalAlignment> alignment: TextHorizontalAlignment.left;
    // Show the whole text as a tooltip: for a value that may be cut short.
    in property <bool> tip: false;

    horizontal-stretch: 1;
    min-width: 0px;
    min-height: root.font_size + 5px;

    if root.tip && root.text != "": Tooltip { text: @markdown("\{root.text}"); }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: root.font_size;
        font-weight: root.font_weight;
        color: root.text_color;
        horizontal-alignment: root.alignment;
        vertical-alignment: center;
        overflow: elide;
    }
}

// A small text-button pill. A disabled pill is greyed out and swallows clicks. It
// takes keyboard focus (Tab) and Space or Enter presses it.
export component RoughPill inherits Rectangle {
    in property <string> text;
    // One plain sentence: what the pill does, or why it cannot be pressed right now. Shown as
    // the tooltip and read after the label.
    in property <string> hint;
    in property <bool> active;
    in property <bool> enabled: true;
    // A pill that sits beside a 32 px text field takes the field's height (and its corner).
    in property <bool> field_height: false;
    callback clicked();

    height: root.field_height ? 32px : 20px;
    border-radius: root.field_height ? Theme.radius-sm : 10px;
    border-width: pill_focus.has-focus ? 2px : 1px;
    border-color: !root.enabled ? Theme.border-subtle
        : (pill_focus.has-focus ? Theme.accent-cyan-hover
            : (root.active ? Theme.accent-cyan : Theme.border-control));
    // A disabled pill keeps muted text: the shared disabled colour is too faint on its fill.
    background: !root.enabled ? Theme.bg-input
        : (ta.has-hover ? Theme.surface-control-hover : Theme.surface-control);

    accessible-role: AccessibleRole.button;
    accessible-label: root.text;
    accessible-description: root.hint;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    if root.hint != "": Tooltip { text: @markdown("\{root.hint}"); }

    pill_focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        Text {
            text: root.text;
            font-size: 10px;
            color: !root.enabled ? Theme.text-muted
                : (root.active ? Theme.accent-cyan : Theme.text-secondary);
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// A left-pointing chevron ("back"), drawn with Path.
export component BackChevron inherits Rectangle {
    in property <color> stroke_color: Theme.text-secondary;
    width: 8px;
    height: 8px;

    Path {
        width: 100%;
        height: 100%;
        stroke: root.stroke_color;
        stroke-width: 1.5px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 8;
        viewbox-height: 8;
        MoveTo { x: 6; y: 1; }
        LineTo { x: 2; y: 4; }
        LineTo { x: 6; y: 7; }
    }
}
