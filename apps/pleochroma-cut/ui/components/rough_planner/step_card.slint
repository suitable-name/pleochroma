import { Theme } from "../../theme.slint";
import { KitIcon, KitIcons } from "../kit/kit.slint";

// One step of the left column. The header (52 px) holds a number circle that turns into a check
// when the step is done (or into a red dot when it has an error), the title with "optional", and
// a one-line summary while the step is closed; the body (the children) shows while it is open.
// Clicking the header opens the step: the window keeps one step open at a time.
export component StepCard inherits Rectangle {
    in property <int> num;
    in property <string> title;
    in property <string> summary;
    // The step's error line: it replaces the summary and marks the header with a red dot.
    in property <string> error;
    in property <bool> done;
    in property <bool> open;
    in property <bool> optional: false;
    callback toggled();

    border-radius: 12px;
    background: root.open ? Theme.bg-card : transparent;
    border-width: 1px;
    border-color: root.open ? Theme.border-medium : transparent;

    VerticalLayout {
        Rectangle {
            height: 52px;
            border-radius: 12px;
            background: touch.has-hover && !root.open ? Theme.bg-card-hover : transparent;
            border-width: fs.has-focus ? 2px : 0px;
            border-color: Theme.accent-cyan-hover;
            accessible-role: AccessibleRole.button;
            accessible-label: "Step " + root.num + ": " + root.title;
            accessible-description: root.error != "" ? root.error : root.summary;
            accessible-expandable: true;
            accessible-expanded: root.open;
            accessible-action-default => { root.toggled(); }

            Tooltip { text: @markdown("Open or close this step. One step is open at a time."); }
            fs := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Space || event.text == Key.Return {
                        root.toggled();
                        return accept;
                    }
                    return reject;
                }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: root.error != "" ? Theme.danger-surface-hover
                            : (root.done ? Theme.badge-emerald-bg : (root.open ? Theme.accent-cyan : Theme.bg-elevated));
                        if root.error != "": Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.danger;
                        }
                        if root.error == "" && root.done: KitIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            d: KitIcons.check;
                            size: 14px;
                            stroke: 2.2px;
                            ink: Theme.accent-emerald;
                        }
                        if root.error == "" && !root.done: Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.num;
                            font-size: 12px;
                            font-weight: 700;
                            color: root.open ? Theme.text-on-accent : Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    alignment: center;
                    spacing: 1px;
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Text {
                            text: root.title;
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text-primary;
                            horizontal-stretch: 0;
                        }
                        if root.optional: Text {
                            text: "optional";
                            font-size: 11px;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                    }
                    if !root.open && (root.error != "" || root.summary != ""): Rectangle {
                        height: 15px;
                        Text {
                            x: 0px;
                            width: parent.width;
                            height: parent.height;
                            text: root.error != "" ? root.error : root.summary;
                            font-size: 11px;
                            color: root.error != "" ? Theme.danger : Theme.text-secondary;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    KitIcon {
                        d: root.open ? KitIcons.chevron-down : KitIcons.chevron-right;
                        size: 14px;
                        ink: Theme.text-muted;
                    }
                }
            }
            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggled(); }
            }
        }
        @children
    }
}
