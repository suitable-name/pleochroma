import { LineEdit } from "std-widgets.slint";
import { EditorTierItem } from "../../types.slint";
import { Theme } from "../../theme.slint";
import { EditorModel } from "../../models/editor.slint";
import { GuideModel } from "../../models/guide.slint";
import { ManipulateModel } from "../../models/manipulate.slint";
import { RelationModel } from "../../models/relation.slint";
import { CriticalAngleBar } from "../critical_angle_bar.slint";
import { FormRow, FormRowMetrics } from "form_row.slint";
import { WarningLine } from "../warning_line.slint";
import { ValueSlider, PresetMenu } from "../value_slider.slint";
import { SliderModel, SliderSpec } from "../../models/sliders.slint";
import { TipButton } from "../compact_controls.slint";
import { AdvancedNote } from "../advanced_note.slint";
import { TierFacetsSection } from "tier_facets_section.slint";
import { WrapNote, WrapWarning } from "wrap_note.slint";
import { ChoiceSeg } from "choice_seg.slint";

// The Inspector's "Tier" tab: the per-tier add and edit form, the inspector of the tier selected in
// the list above it.
// The scratch state (`tier_angle` and the other fields, dirty tracking, per-field validation,
// the draft warnings) lives on `EditorInspector`, see its `form_dirty`, `loaded_tier_index`
// and `show_dirty_warning`. This component renders that state and reports edits and actions
// back through two-way properties and callbacks, as `EditorTierTable`'s components do.
//
// There is no Save Tier (Fable E1). On a saved tier a text field applies on Enter or when it is
// left (`commit_field`), a segment, a chip or a slider release applies at once, and each commit is
// one undo step. A field that was left unchanged applies nothing (Rust compares the tier with the
// design's). A new tier (Add mode) is still added with one button, since leaving a field must not
// create a tier.
//
// Simple and Advanced (`GuideModel.shows_advanced()`): the Simple interface keeps the Angle,
// Meets, Name and Indices fields, the facet chips with Add and Mirror, the note and the
// solved readout. It hides the cheater offset, the Rotate row, the per-facet Detach buttons,
// the "Exact scale value" Meets choice (unless the tier already uses it), the imported-meet
// details and the Solve strategy and Orbit lines. Nothing hidden is ever changed or deleted;
// when a hidden control holds a value that is not its default (a cheater offset, a detached
// facet, an imported meet) a one-line note says so.
//
// Keyboard: every field and button takes Tab. The facet chips are one Tab stop (a row of
// chips would otherwise be dozens of stops): Left and Right move along them, Enter detaches or
// reattaches the chosen facet (Advanced) and Delete removes it.
// The chip of the Meet Point row. `tone`: 0 plain muted text (no pick, or the row waits for a
// solve), 1 plain cyan text (pick mode is on),
// 2 green pill (a corner is picked), 3 amber pill with a warning mark (the pick is lost or cut
// away), 4 neutral pill (the pick is not in use).
component MeetChip inherits Rectangle {
    in property <string> text;
    in property <int> tone: 0;

    property <bool> pill: root.tone >= 2;
    property <color> ink: root.tone == 1 ? Theme.accent-cyan : (root.tone == 2 ? Theme.success : (root.tone == 3 ? Theme.accent-amber : Theme.text-secondary));

    horizontal-stretch: 1;
    min-width: 0px;
    height: 26px;
    border-radius: 13px;
    border-width: root.pill ? 1px : 0px;
    border-color: root.tone == 4 ? Theme.border-subtle : root.ink;
    background: root.tone == 2 ? root.ink.transparentize(0.85) : (root.tone == 3 ? Theme.surface-warning : transparent);

    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    HorizontalLayout {
        padding-left: root.pill ? 10px : 0px;
        padding-right: root.pill ? 10px : 0px;
        spacing: 6px;
        alignment: root.pill ? center : start;
        if root.tone == 3: VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../../icons/warning.svg");
                colorize: root.ink;
                width: 12px;
                height: 12px;
                image-fit: contain;
            }
        }
        if root.tone == 2: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.ink;
            }
        }
        Text {
            text: root.text;
            font-size: 11px;
            font-weight: root.pill ? 600 : 400;
            color: root.ink;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component TierFormTab inherits VerticalLayout {
    // `false` while the worked-example guide locks this tab's group (see
    // `GuideAllow`, `models/guide.slint`); every input and button below ANDs it
    // into its own `enabled:`. Bound by `EditorInspector` from the same
    // `GuideModel.allows_*()` helper as this tab's pill.
    in property <bool> unlocked: true;

    in-out property <string> tier_angle;
    in-out property <int> tier_constraint_kind;
    in-out property <string> tier_constraint_text;
    in-out property <string> tier_name;
    in-out property <string> tier_indices;
    // Per-facet scratch fields: typed position for "+ Add" and tooth count for
    // "Rotate". Not covered by `form_dirty` since they don't commit to Design.
    in-out property <string> new_facet_position;
    in-out property <string> rotate_by_text;

    in property <int> loaded_tier_index: -1;
    in property <bool> show_dirty_warning: false;
    // The design changed this tier after the draft below was started -- see
    // `EditorInspector.external_change_pending`.
    in property <bool> show_external_change: false;
    in property <int> pending_load_index: -1;
    // Angle field invalid if > 90 degrees (locally checkable) or if Rust
    // reported an angle-field error.
    in property <bool> angle_field_invalid: false;
    // Name, indices, and constraint fields: invalid if Rust-classified error
    // for that field (rules that require Rust validation).
    in property <bool> name_field_invalid: false;
    in property <bool> indices_field_invalid: false;
    in property <bool> constraint_field_invalid: false;

    // The dirty-warning banner's two answers -- see `EditorInspector.
    // show_dirty_warning`'s own doc comment for what defers to this.
    callback keep_draft();
    callback confirm_discard_and_load();
    // The external-change notice's two answers: drop the draft for the design's
    // current values, or keep the draft and hide the notice.
    callback reload_from_design();
    callback dismiss_external_change();
    // Commits whichever tier `loaded_tier_index` says the form represents.
    // Forwarded to `EditorInspector.save_form()`, which reads `loaded_tier_index`
    // rather than `EditorModel.selected_tier_index` directly -- see that
    // function's own doc comment for why the two can disagree.
    callback save_form();

    // Whether the Advanced controls show.
    property <bool> advanced: GuideModel.shows_advanced();
    // Whether the form describes a saved tier (the Facets, Cheater Offset, Note and Solved
    // sections only exist then).
    property <bool> has_loaded_tier: root.loaded_tier_index >= 0 && root.loaded_tier_index < EditorModel.tiers.length;
    property <int> tracked_suggested_kind: EditorModel.suggested_constraint_kind;
    changed tracked_suggested_kind => {
        if root.tracked_suggested_kind >= 0 {
            root.tier_constraint_kind = root.tracked_suggested_kind;
            EditorModel.suggested_constraint_kind = -1;
        }
    }

    // The typed angle as a number (0 for unparsable text), for the side hint on
    // the Angle label: exactly +-90 reads "girdle" (the same band
    // `classify_blocks` uses), otherwise the sign picks pavilion/crown.
    property <float> angle_value: root.tier_angle.to-float();
    // The per-kind explanation for the constraint value row, shown as a tooltip
    // on that row's label cell and input instead of as a paragraph above the input.
    // `@markdown(...)` needs a literal, so the tooltip interpolates this property.
    property <string> constraint_hint: root.constraint_hint_base
        + (root.tier_constraint_kind >= 2 ? " You can type arithmetic, for example 0.5+0.15." : "")
        + (root.tier_constraint_kind <= 2 ? " See the glossary." : "");
    property <string> constraint_hint_base: root.tier_constraint_kind == 1
        ? "Facet names, comma-separated: this facet meets the named facet(s)."
        : (root.tier_constraint_kind == 2
            ? "Exact scale value: a plane offset along this facet's normal, in\nmodel units (girdle half-width = 1) -- not a caliper dimension."
            : (root.tier_constraint_kind == 3
                ? "Cut to depth: this facet's plane offset, in mm, measured the same\nway the MAST column's own mm tooltip is -- converted through the\ndesign's girdle diameter (needs one set in Design Settings)."
                : (root.tier_constraint_kind == 4
                    ? "Girdle thickness: this tier's own mast is searched (bisected)\nuntil the girdle is this many mm thick at its girdle line,\nat the thinnest point there -- same girdle-diameter mm\nconversion as Depth, so it costs several solves rather than one."
                    : "Table width: this tier's own mast is searched (bisected)\nuntil the table facet's measured width matches this\nvalue in mm -- same girdle-diameter mm conversion as\nDepth, so it costs several solves rather than one.")));
    // The accessible name of the constraint value field.
    property <string> constraint_reader_label: root.tier_constraint_kind == 1
        ? "Facet Names This Facet Meets"
        : (root.tier_constraint_kind == 2 ? "Exact Scale Value" : "Value in Millimetres");

    // The relation the loaded tier's angle follows (`P1 - 2`), or "" for a free angle. The
    // Angle field then holds it after an "=" (`EditorInspector.angle_seed`).
    property <string> loaded_relation: root.has_loaded_tier
        ? EditorModel.tiers[root.loaded_tier_index].relation_text
        : "";

    // --- The slider and the "Typical" menu beside the Angle field -------------------------
    // The ranges, steps, band and presets come from Rust (`SliderModel`, `slider_ranges.rs`);
    // this tab only shows them. The slider writes the Angle field's text like typing does and
    // follows the field whatever changes it. Nothing is saved until Save Tier.
    //
    // What the form holds, for the slider: "" for a new tier, otherwise the loaded tier's
    // block ("Pavilion", "Crown", "Girdle"), "Horizontal" for a flat tier (the table, the
    // culet: `angle_full` reads 0) and "Driven" for a tier whose angle follows a relation.
    // Girdle, flat and driven tiers have no slider.
    property <string> slider_kind: root.has_loaded_tier
        ? (root.loaded_relation != ""
            ? "Driven"
            : ((EditorModel.tiers[root.loaded_tier_index].angle_full == "0"
                || EditorModel.tiers[root.loaded_tier_index].angle_full == "0.0"
                || EditorModel.tiers[root.loaded_tier_index].angle_full == "-0")
                ? "Horizontal"
                : EditorModel.tiers[root.loaded_tier_index].block))
        : "";
    // The design's material, as the Design Settings combo names it ("" for none).
    property <string> material_label: (EditorModel.material_combo_index >= 0 && EditorModel.material_combo_index < EditorModel.material_combo_options.length)
        ? EditorModel.material_combo_options[EditorModel.material_combo_index]
        : "";
    // `EditorModel.effective_ri_text` is passed along so the answer follows a material change.
    property <SliderSpec> angle_spec: SliderModel.angle_spec(root.slider_kind, root.tier_angle, root.tier_name, EditorModel.effective_ri_text);

    // The live margin bar for the Angle field's current text. A pavilion angle shows as a plain
    // number, so the bar is told its side (`SliderModel.margin_preview_text`).
    function preview_angle() {
        EditorModel.angle_live_preview(SliderModel.margin_preview_text(root.angle_spec.side, root.tier_angle));
    }

    // The slider and the Typical menu write the field the way typing does: the number goes
    // into the field, the margin bar follows, and a stale error under the field clears.
    function set_angle_from_slider(v: float) {
        root.tier_angle = SliderModel.angle_text(v, root.tier_angle);
        root.preview_angle();
        root.clear_field_error("angle");
    }

    // The side hint under the Angle label: exactly +-90 reads "girdle", otherwise a
    // loaded pavilion tier or a negative angle reads "pavilion", a positive one
    // "crown", and a zero angle nothing.
    property <string> angle_side_hint: Math.abs(root.angle_value) == 90
        ? "girdle"
        : (root.has_loaded_tier && EditorModel.tiers[root.loaded_tier_index].block == "Pavilion"
            ? "pavilion"
            : (root.angle_value < 0
                ? "pavilion"
                : (root.angle_value > 0 ? "crown" : "")));
    // Each save error is shown directly under the field it concerns (Rust
    // names the field in `EditorModel.tier_form_error_field`). The Angle row also keeps
    // its local "over 90" check, which fires before any save attempt.
    property <string> angle_error: EditorModel.tier_form_error_field == "angle"
        ? EditorModel.tier_form_error
        : (Math.abs(root.angle_value) > 90 ? "Exceeds 90\u{b0} -- angles are measured from the girdle plane." : "");
    property <string> constraint_error: EditorModel.tier_form_error_field == "constraint" ? EditorModel.tier_form_error : "";
    property <string> name_error: EditorModel.tier_form_error_field == "name" ? EditorModel.tier_form_error : "";
    property <string> indices_error: EditorModel.tier_form_error_field == "indices" ? EditorModel.tier_form_error : "";
    // True while one of the rows above is showing the current save error, so the
    // general message at the bottom of the form stays for errors no field owns.
    property <bool> error_is_inline: EditorModel.tier_form_error_field == "angle"
        || EditorModel.tier_form_error_field == "name"
        || EditorModel.tier_form_error_field == "indices"
        || (EditorModel.tier_form_error_field == "constraint" && root.tier_constraint_kind != 0);

    // Up and Down step the Angle text by 0.1 degrees (Shift 1, Ctrl 0.01), as the tier table's
    // cell does. Here it is local text only: nothing is committed until Save or Add Tier.
    // `SliderModel.stepped_angle_text` returns "" for text that is not a plain number (such as
    // 41.5+0.3 or =P1-2), and the field then stays as typed.
    function step_size(shift: bool, ctrl: bool) -> float {
        return shift ? 1.0 : (ctrl ? 0.01 : 0.1);
    }

    // Clears a stale validation-error marker when the field it points at is retyped. Called
    // from each field's own user-edit event, not from a `changed` handler: `changed` also fires
    // for the inspector's programmatic seeding, and changed handlers are queued, so they cannot
    // tell the two apart. Rust re-validates on the next save.
    function clear_field_error(field: string) {
        if EditorModel.tier_form_error_field == field {
            EditorModel.tier_form_error_field = "";
            EditorModel.tier_form_error = "";
        }
    }

    // Whether the selection-fed parts of the form (the facet chips, the cheater offset and the
    // note: Rust pushes them for `EditorModel.selected_tier_index`) describe the tier this form
    // shows. See `TierFacetsSection`.
    property <bool> selection_is_loaded: root.loaded_tier_index == EditorModel.selected_tier_index;

    // The Meet Point row shows for the selected saved tier while Meets is Vertex or Facets.
    property <bool> meet_pick_shown: root.has_loaded_tier && root.selection_is_loaded && root.tier_constraint_kind <= 1;
    // Pick mode is on for the tier this form shows.
    property <bool> picking: ManipulateModel.pick_mode && root.selection_is_loaded;
    // The pick does not hold: its corner is cut away (3) or lost (4). Not while the row waits for a
    // solve (5), which says nothing about the corner yet.
    property <bool> pick_failed: EditorModel.meet_pick_state == 3 || EditorModel.meet_pick_state == 4;
    // The loaded tier's name for the row's tooltips; "tier N" while it has none.
    property <string> pick_tier_name: root.has_loaded_tier
        ? (EditorModel.tiers[root.loaded_tier_index].name != "" ? EditorModel.tiers[root.loaded_tier_index].name : "tier \{root.loaded_tier_index + 1}")
        : "";
    property <string> pick_hint: "Show the stone as it is before \{root.pick_tier_name} is cut and click the corner \{root.pick_tier_name} should meet. Shortcut: M.";

    // --- Apply on leave -----------------------------------------------------------------------
    // A saved tier takes a field's text when the field is left; Enter does too. A new tier (Add
    // mode) is added by Enter or by the Add button, never by leaving a field.
    function commit_field() {
        if root.has_loaded_tier && root.unlocked && !root.angle_field_invalid {
            root.save_form();
        }
    }
    function enter_field() {
        if root.unlocked {
            root.save_form();
        }
    }
    // The Meets segments: the Simple interface leaves "Exact Scale Value" out unless the tier already
    // uses it, so the segment index is the meet kind less one past it.
    property <bool> meets_full: root.advanced || root.tier_constraint_kind == 2;
    property <int> meets_picked: root.meets_full || root.tier_constraint_kind < 2 ? root.tier_constraint_kind : root.tier_constraint_kind - 1;
    // What the value field holds for a meet kind: 0 nothing (vertex), 1 facet names, 2 a number.
    pure function meet_value_family(kind: int) -> int {
        return kind <= 1 ? kind : 2;
    }
    function pick_meet(i: int) {
        let kind = root.meets_full || i < 2 ? i : i + 1;
        // The text of one family means nothing in another (a scale value is no facet name, and
        // facet names are no number): the field starts empty rather than being applied as is.
        if root.meet_value_family(kind) != root.meet_value_family(root.tier_constraint_kind) {
            root.tier_constraint_text = "";
        }
        root.tier_constraint_kind = kind;
        root.clear_field_error("constraint");
        // A kind that needs a value waits for the value field; the vertex needs none.
        if root.tier_constraint_kind == 0 || root.tier_constraint_text != "" {
            root.commit_field();
        }
    }
    // "Girdle Facet Preset" from the Add Tier menu arrives as a flag, since the form may not exist
    // yet when the menu is used. Applied once the form is there and the flag is up.
    property <bool> tracked_girdle_preset: EditorModel.girdle_preset_pending;
    function apply_girdle_preset() {
        if EditorModel.girdle_preset_pending {
            EditorModel.girdle_preset_pending = false;
            root.tier_angle = "90";
            root.tier_constraint_kind = 2;
            root.tier_constraint_text = "1";
            root.clear_field_error("angle");
            root.clear_field_error("constraint");
        }
    }
    changed tracked_girdle_preset => { root.apply_girdle_preset(); }
    init => { root.apply_girdle_preset(); }

    spacing: 8px;
    // The scroll bar is drawn over the right edge: keep the fields, the Typical menu and the
    // buttons clear of it.
    padding-right: FormRowMetrics.scroll_gutter;
    // A small inset above the first row, so a control is never cut right at the top edge.
    padding-top: 2px;
    // Packed at the top, as the other inspector tabs: no row takes the spare height.
    alignment: start;
    // The tier being edited: its code and name large, then its block, place and facet count; at
    // the right, how changes apply.
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.loaded_tier_index < 0
                ? "New Tier"
                : (root.tier_name == "" ? "Tier " + (root.loaded_tier_index + 1) : root.tier_name);
            font-size: 18px;
            font-weight: 700;
            color: Theme.text-primary;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: AccessibleRole.text;
            // Kept as the form's heading name: "Edit Tier #N" or "Add Tier".
            accessible-label: root.loaded_tier_index < 0
                ? "Add Tier"
                : "Edit Tier #" + (root.loaded_tier_index + 1) + (root.tier_name == "" ? "" : " -- " + root.tier_name);
        }
        Text {
            horizontal-stretch: 1;
            text: root.has_loaded_tier
                ? EditorModel.tiers[root.loaded_tier_index].block + " \u{b7} tier " + (root.loaded_tier_index + 1) + " of " + EditorModel.tiers.length
                    + " \u{b7} " + EditorModel.selected_tier_chips.length + " facets"
                : "Fill in the fields, then press Add";
            font-size: 11px;
            color: Theme.text-muted;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    Text {
        text: root.has_loaded_tier
            ? "Changes apply when you press Enter or leave a field. Ctrl+Z undoes."
            : "A new tier is added with the Add button or Enter.";
        font-size: 10px;
        color: Theme.text-muted;
        wrap: word-wrap;
        accessible-role: AccessibleRole.text;
    }
    // Shown while the table selection has moved away from the draft.
    if root.show_dirty_warning: Rectangle {
        background: Theme.bg-input;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.accent-amber;
        VerticalLayout {
            padding: 6px;
            spacing: 4px;
            WarningLine {
                text: "You have unsaved changes to "
                    + (root.loaded_tier_index < 0 ? "the new tier draft" : "Tier #" + (root.loaded_tier_index + 1))
                    + ". The table's selection has moved on, but this form still shows your draft.";
            }
            HorizontalLayout {
                spacing: 6px;
                TipButton {
                    enabled: root.unlocked;
                    text: "Keep Draft";
                    hint: "Keep your unsaved changes in this form. The table's selection stays where it is.";
                    clicked => { root.keep_draft(); }
                }
                TipButton {
                    enabled: root.unlocked;
                    text: root.pending_load_index < 0
                        ? "Discard Draft, Start New"
                        : "Discard Draft, Load #" + (root.pending_load_index + 1);
                    hint: root.pending_load_index < 0
                        ? "Throw away your unsaved changes and start a blank new tier."
                        : "Throw away your unsaved changes and show the tier you selected in the table.";
                    clicked => { root.confirm_discard_and_load(); }
                }
            }
        }
    }
    // A drag, nudge or pin moved this tier while the draft below was being typed:
    // the draft is kept (Save Tier would write it over that edit), and the cutter
    // chooses. Hidden again once the draft matches its baseline or is reloaded.
    if root.show_external_change && !root.show_dirty_warning: Rectangle {
        background: Theme.bg-input;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.accent-amber;
        VerticalLayout {
            padding: 6px;
            spacing: 4px;
            WarningLine {
                text: "Tier #" + (root.loaded_tier_index + 1)
                    + " changed in the design after you started this draft. Saving writes your draft over that change.";
            }
            HorizontalLayout {
                spacing: 6px;
                TipButton {
                    enabled: root.unlocked;
                    text: "Reload From Design";
                    hint: "Drop your unsaved changes and show the tier as the design now has it.";
                    clicked => { root.reload_from_design(); }
                }
                TipButton {
                    enabled: root.unlocked;
                    text: "Keep Draft";
                    hint: "Keep your unsaved changes and hide this notice.\nSaving writes them over the change in the design.";
                    clicked => { root.dismiss_external_change(); }
                }
            }
        }
    }
    // Each authored field is one FormRow (fixed-width label cell, stretching input), so the
    // four authored rows fit near the top without scrolling. The label cell elides rather than
    // clipping, and the live side hint ("pavilion", "crown", "girdle") sits on a second line
    // under the label. See `FormRow`.
    // The red border on an invalid angle lives on the row's wrapper, because
    // `LineEdit` has no border-color of its own.
    FormRow {
        label: "Angle (deg)";
        label_hint: root.angle_side_hint;
        tooltip: "Angle from the girdle plane in degrees (0\u{b0} to 90\u{b0}). Pavilion tiers are\ncut on the pavilion side (P/PF), crown on crown (C/Table), exactly 90\u{b0} is\ngirdle (G). You can type arithmetic, for example 41.5+0.3. Start with =\nto make the angle follow other tiers, for example =C1-4 or =(P1+P3)/2;\nput a name with spaces in brackets, for example =[Crown Main]-2. Up and\nDown change the angle by 0.1\u{b0}, Shift by 1\u{b0}, Ctrl by 0.01\u{b0}. The slider\nunder the field follows what you type; dragging it fills the field in,\nand the angle applies when you press Enter or leave the field. See the glossary.";
        invalid: root.angle_field_invalid;
        error: root.angle_error;
        LineEdit {
            enabled: root.unlocked;
            text <=> root.tier_angle;
            accessible-label: "Angle in Degrees";
            font-size: 15px;
            accepted => { root.enter_field(); }
            changed has-focus => {
                EditorModel.text_focus = self.has-focus;
                if !self.has-focus {
                    root.commit_field();
                }
            }
            // Live critical-angle guidance fires on every keystroke
            // so the bar updates before the cutter leaves the field.
            edited => {
                root.preview_angle();
                root.clear_field_error("angle");
            }
            // Up/Down step a plain number only: text that is arithmetic or a relation
            // ("=P1-2") would be replaced by its number, so the key is swallowed instead.
            key-pressed(event) => {
                if event.text == Key.UpArrow || event.text == Key.DownArrow {
                    if SliderModel.stepped_angle_text(root.tier_angle, (event.text == Key.UpArrow ? 1.0 : -1.0) * root.step_size(event.modifiers.shift, event.modifiers.control)) != "" {
                        root.tier_angle = SliderModel.stepped_angle_text(root.tier_angle, (event.text == Key.UpArrow ? 1.0 : -1.0) * root.step_size(event.modifiers.shift, event.modifiers.control));
                        root.preview_angle();
                        root.clear_field_error("angle");
                    }
                    return accept;
                }
                reject
            }
        }
    }
    // The slider under the Angle field, with its "Typical" menu: for a pavilion or crown angle
    // only (no girdle, flat tier, relation or driven tier -- see `slider_kind`). Shown in both
    // the Simple and the Advanced interface. While the field holds text the slider cannot
    // show (a half-typed number, a calculation that does not work out) it stays but is dimmed
    // and inert. It starts where the Angle field's text starts (`FormRowMetrics.field_start`).
    if root.angle_spec.visible: VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            padding-left: FormRowMetrics.field_start;
            padding-right: FormRowMetrics.field_inset;
            spacing: 6px;
            value-slider-angle-spec := ValueSlider {
                enabled: root.unlocked;
                value_valid: root.angle_spec.usable;
                value: root.angle_spec.value;
                minimum: root.angle_spec.minimum;
                maximum: root.angle_spec.maximum;
                step: root.angle_spec.step;
                fine_step: root.angle_spec.fine_step;
                mark: root.angle_spec.mark;
                band_from: root.angle_spec.band_from;
                band_to: root.angle_spec.band_to;
                label: root.angle_spec.side + " Angle";
                value_text: root.angle_spec.value_text;
                hint: "Drag to set the angle. Click the slider, then use the arrow keys for\n0.05\u{b0}, Shift+arrow for 0.01\u{b0} and Page Up or Page Down for 0.5\u{b0}. Hold\nShift while dragging for fine steps. The Angle field above stays\neditable and the slider follows it. The angle applies when you let go.";
                moved(v) => { root.set_angle_from_slider(v); }
                released(v) => {
                    root.set_angle_from_slider(v);
                    root.commit_field();
                }
            }
            PresetMenu {
                // As tall as the slider beside it (its own default is 22 px).
                height: 26px;
                enabled: root.unlocked;
                label: "Typical";
                hint: "Common angles for this stone, each with its\nreason. Choosing one sets the angle.";
                presets: SliderModel.angle_presets(root.angle_spec.side, EditorModel.effective_ri_text, root.material_label);
                chosen(v) => {
                    root.set_angle_from_slider(v);
                    root.commit_field();
                }
            }
        }
        if root.angle_spec.note != "": HorizontalLayout {
            padding-left: FormRowMetrics.field_start;
            WrapNote {
                horizontal-stretch: 1;
                text: root.angle_spec.note;
                font_size: 9px;
            }
        }
    }
    // The loaded tier's angle follows a relation (the Angle field shows it after "="): say
    // so, with the angle it gives now, and offer to stop following it. Removing keeps the
    // angle as it is.
    if root.loaded_relation != "": Rectangle {
        background: Theme.bg-input;
        border-radius: Theme.radius-sm;
        VerticalLayout {
            padding: 6px;
            spacing: 4px;
            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../icons/link.svg");
                        colorize: Theme.accent-cyan;
                        width: 12px;
                        height: 12px;
                        image-fit: contain;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: "Follows a relation. The angle is now " + EditorModel.tiers[root.loaded_tier_index].angle_deg + "\u{b0}.";
                    font-size: 10px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    accessible-role: AccessibleRole.text;
                }
            }
            HorizontalLayout {
                TipButton {
                    enabled: root.unlocked;
                    text: "Remove Relation";
                    hint: "The tier keeps its current angle and stops\nfollowing the tiers it reads. See the glossary.";
                    clicked => { RelationModel.remove_relation(root.loaded_tier_index); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
    CriticalAngleBar {
        margin_text: EditorModel.angle_live_margin_text;
        level: EditorModel.angle_live_margin_level;
        is_estimate: EditorModel.angle_live_margin_is_estimate;
    }
    // What this facet meets, not a depth number -- the constraint
    // is the authored value; the mast (shown read-only in the
    // tier table) is only ever solved.
    FormRow {
        label: "Meets";
        tooltip: "How the depth is decided: an unnamed meet point, named facets, an\nexact scale value (an anchor), or a stated dimension in millimetres.\nThe Simple interface leaves out the exact scale value unless this\ntier already uses it; Advanced lists every choice. See the glossary.";
        ChoiceSeg {
            horizontal-stretch: 1;
            enabled: root.unlocked;
            group_label: "Meets";
            font_size: 11px;
            labels: root.meets_full
                ? ["Vertex", "Facets", "Scale", "Depth", "Girdle", "Table"]
                : ["Vertex", "Facets", "Depth", "Girdle", "Table"];
            reader_labels: root.meets_full
                ? ["Unspecified Vertex", "Named Facet(s)", "Exact Scale Value", "Cut to Depth (mm)", "Girdle Thickness (mm)", "Table Width (mm)"]
                : ["Unspecified Vertex", "Named Facet(s)", "Cut to Depth (mm)", "Girdle Thickness (mm)", "Table Width (mm)"];
            picked: root.meets_picked;
            selected(i) => { root.pick_meet(i); }
        }
    }
    // The constraint value row. Its per-kind explanation is the label cell's tooltip
    // (`constraint_hint`), so the row costs one input height.
    // Red border for a constraint error: an unresolved name, an empty value, or not a number.
    if root.tier_constraint_kind != 0: FormRow {
        label: root.tier_constraint_kind == 1 ? "Facet Names"
            : (root.tier_constraint_kind == 2 ? "Scale Value" : "Value (mm)");
        tooltip: root.constraint_hint;
        invalid: root.constraint_field_invalid;
        error: root.constraint_error;
        line-edit-constraint-reader-label := LineEdit {
            horizontal-stretch: 1;
            enabled: root.unlocked;
            text <=> root.tier_constraint_text;
            accessible-label: root.constraint_reader_label;
            accepted => { root.enter_field(); }
            changed has-focus => {
                EditorModel.text_focus = self.has-focus;
                if !self.has-focus {
                    root.commit_field();
                }
            }
            edited => { root.clear_field_error("constraint"); }
        }
        // Takes the tier's solved mast as the exact scale value, and applies it.
        if root.tier_constraint_kind == 2 && root.has_loaded_tier && EditorModel.tiers[root.loaded_tier_index].mast_full != "": TipButton {
            enabled: root.unlocked;
            text: "Use Solved";
            reader_label: "Use Solved Mast";
            hint: "Put this tier's solved mast (" + EditorModel.tiers[root.loaded_tier_index].mast_full + ") in the field as its exact scale value.";
            clicked => {
                root.tier_constraint_text = EditorModel.tiers[root.loaded_tier_index].mast_full;
                root.clear_field_error("constraint");
                root.commit_field();
            }
        }
        // Three targets are in millimetres (unlike kind 2's model-unit scale value).
        // A cell of its own, so the unit neither shrinks the field nor crowds its right edge.
        if root.tier_constraint_kind >= 3: Rectangle {
            width: 26px;
            Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                text: "mm";
                font-size: 11px;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    // The Meet Point row: which corner of the stone this tier is cut to. Saved tiers only, while Meets
    // is Vertex or Facets (a picked corner replaces the shallowest-of-the-names rule). The chip, the
    // state and the note are pushed by Rust for the selected tier (`EditorModel.meet_pick_*`);
    // the buttons arm pick mode in the Solid view or forget the pick.
    if root.meet_pick_shown: FormRow {
        label: "Meet Point";
        tooltip: "Which corner this facet is cut to. Pick it in the view when the named facets meet in more than one corner. See the glossary.";
        MeetChip {
            text: root.picking ? "Picking in the view\u{2026}" : EditorModel.meet_pick_chip;
            tone: root.picking ? 1 : (EditorModel.meet_pick_state == 1 ? 2 : (root.pick_failed ? 3 : (EditorModel.meet_pick_state == 2 ? 4 : 0)));
        }
        if root.picking: TipButton {
            enabled: root.unlocked;
            text: "Cancel Pick";
            hint: "Leave pick mode. Nothing changes. Shortcut: Escape.";
            primary: true;
            clicked => {
                ManipulateModel.pick_mode = false;
                ManipulateModel.pick_toggled();
            }
        }
        if !root.picking: TipButton {
            enabled: root.unlocked && ManipulateModel.pick_available;
            text: EditorModel.meet_pick_state == 0 ? "Pick in View" : (root.pick_failed ? "Pick Again" : "Pick\u{2026}");
            reader_label: EditorModel.meet_pick_state == 0 ? "Pick Meet Point in View" : (root.pick_failed ? "Pick Meet Point Again" : "Pick Meet Point");
            hint: ManipulateModel.pick_available ? root.pick_hint : ManipulateModel.pick_blocked_reason;
            primary: root.pick_failed;
            clicked => {
                ManipulateModel.pick_mode = true;
                ManipulateModel.pick_toggled();
            }
        }
        if !root.picking && EditorModel.meet_pick_state != 0: TipButton {
            enabled: root.unlocked;
            text: "Clear";
            reader_label: "Clear Picked Meet Point";
            hint: "Forget the picked corner. \{root.pick_tier_name} keeps its named facets and meets their shallowest point.";
            clicked => { EditorModel.meet_pick_clear(root.loaded_tier_index); }
        }
    }
    if root.meet_pick_shown && EditorModel.meet_pick_note != "": HorizontalLayout {
        padding-left: FormRowMetrics.field_start;
        WrapNote {
            text: EditorModel.meet_pick_note;
            ink: root.pick_failed ? Theme.accent-amber : Theme.text-muted;
        }
    }
    // Red border for an invalid index (off the gear, repeated, or not a number).
    // The wheel is a ring, so the gear's own tooth count (96 on a 96-tooth gear)
    // is a valid entry: it is the same position as 0.
    FormRow {
        label: "Indices";
        tooltip: "Comma- or space-separated positions on the index wheel, for\nexample 96, 16, 32 or 0:12:96. The wheel is a ring, so the gear's\nown tooth count is the same position as 0. See the glossary.";
        invalid: root.indices_field_invalid;
        error: root.indices_error;
        LineEdit {
            enabled: root.unlocked;
            text <=> root.tier_indices;
            placeholder-text: "e.g. 96, 16, 32, 48";
            accessible-label: "Index Positions";
            accepted => { root.enter_field(); }
            changed has-focus => {
                EditorModel.text_focus = self.has-focus;
                if !self.has-focus {
                    root.commit_field();
                }
            }
            edited => { root.clear_field_error("indices"); }
        }
    }
    // Girdle facet preset: `classify_blocks` reads only +-90 degrees as a girdle (0 reads as a
    // crown), so this fills in 90 degrees with the scale value 1 (the girdle half-width).
    // Name and Indices are not touched.
    if root.loaded_tier_index < 0: TipButton {
        enabled: root.unlocked;
        show_hint: root.unlocked;
        text: "Girdle Facet Preset (90\u{b0}, Scale = 1)";
        hint: "Fill in a real girdle facet: angle 90\u{b0} and Meets set to the exact\nscale value 1 (the girdle's half-width). Name and Indices stay as\nthey are, and nothing is added until you press Add. See the glossary.";
        clicked => {
            root.tier_angle = "90";
            root.tier_constraint_kind = 2;
            root.tier_constraint_text = "1";
            root.clear_field_error("angle");
            root.clear_field_error("constraint");
        }
    }

    // Per-facet editing, cheater offset and note. Only shown for saved tiers.
    if root.has_loaded_tier: TierFacetsSection {
        unlocked: root.unlocked;
        advanced: root.advanced;
        loaded_tier_index: root.loaded_tier_index;
        selection_is_loaded: root.selection_is_loaded;
        new_facet_position <=> root.new_facet_position;
        rotate_by_text <=> root.rotate_by_text;
    }


    // Facet names can use '/' to give one tier multiple names (e.g., "P1/P2").
    // Red border for name-collision rejection.
    FormRow {
        label: "Name";
        tooltip: "Facet name, referenced by other tiers' named-facet field.\nJoin several names with '/' (e.g. \"P1/P2\") to give one\ntier more than one name; avoid reusing a name another tier\nalready has. Left blank, a new tier is named from its angle\n(C crown, P pavilion, G girdle). See the glossary.";
        invalid: root.name_field_invalid;
        error: root.name_error;
        LineEdit {
            enabled: root.unlocked;
            text <=> root.tier_name;
            accessible-label: "Facet Name";
            accepted => { root.enter_field(); }
            changed has-focus => {
                EditorModel.text_focus = self.has-focus;
                if !self.has-focus {
                    root.commit_field();
                }
            }
            edited => { root.clear_field_error("name"); }
        }
    }

    // The Simple interface hides the cheater offset, the Detach buttons and the imported-meet
    // details: if this tier uses any of them, say so.
    if root.has_loaded_tier && !root.advanced
        && (EditorModel.selected_tier_cheater_offset_text != ""
            || EditorModel.tiers[root.loaded_tier_index].is_detached
            || EditorModel.tiers[root.loaded_tier_index].imported_meet_text != ""): AdvancedNote { }

    // An inline validation message under the form, beside the corner toast. A save error about
    // the Angle, Meets value, Name or Indices field shows under that field instead (see
    // `error_is_inline`); this message is for every error no single field owns.
    if EditorModel.tier_form_error != "" && !root.error_is_inline: WrapNote {
        text: EditorModel.tier_form_error;
        font_size: 10px;
        font_weight: 700;
        ink: Theme.accent-ruby;
    }

    // --- Read-only "Solved" section: what Solve produced for this tier (mast, strategy, block,
    // margin, orbit, meet partners and any warning about this tier). Only for an existing tier.
    // The Simple interface leaves out the strategy and orbit lines.
    if root.has_loaded_tier: VerticalLayout {
        // `tier_row`, not `row`: `row` is a reserved GridLayout property every element inherits.
        // Reads `loaded_tier_index`, not `EditorModel.selected_tier_index` (see that doc comment).
        property <EditorTierItem> tier_row: EditorModel.tiers[root.loaded_tier_index];
        spacing: 4px;
        Rectangle { height: 1px; background: Theme.border-subtle; }
        Text { text: "Solved"; font-size: 11px; font-weight: 700; color: Theme.text-primary; accessible-role: AccessibleRole.text; }
        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                height: mast_txt.preferred-height;
                width: mast_txt.preferred-width;
                Tooltip { text: @markdown("The depth at which this facet's plane sits, worked out by Solve, in the\ndesign's own model units (girdle half-width = 1). See the glossary."); }
                mast_txt := Text { x: 0px; text: "Mast: " + tier_row.mast; font-size: 10px; color: Theme.text-secondary; accessible-role: AccessibleRole.text; }
            }
            Rectangle {
                height: block_txt.preferred-height;
                width: block_txt.preferred-width;
                Tooltip { text: @markdown("Which block of the stone this tier belongs to: crown, pavilion\nor girdle. It follows from the angle. See the glossary."); }
                block_txt := Text { x: 0px; text: "Block: " + tier_row.block; font-size: 10px; color: Theme.text-secondary; accessible-role: AccessibleRole.text; }
            }
        }
        if root.advanced: Rectangle {
            height: strategy_txt.preferred-height;
            if tier_row.strategy_detail != "": Tooltip { text: @markdown("\{tier_row.strategy_detail}"); }
            strategy_txt := Text { x: 0px;
                text: "Strategy: " + tier_row.strategy;
                font-size: 10px;
                font-weight: tier_row.strategy_is_uncertain ? 700 : 400;
                color: tier_row.strategy_is_uncertain ? Theme.accent-amber : Theme.text-secondary;
                accessible-role: AccessibleRole.text;
            }
        }
        if tier_row.margin_text != "": Rectangle {
            height: margin_txt.preferred-height;
            Tooltip { text: @markdown("How far this pavilion angle is above the critical angle,\nthe angle below which light leaks out instead of bouncing\nback. A small margin risks a window. See the glossary."); }
            margin_txt := Text { x: 0px;
                text: "Margin over Critical Angle: " + tier_row.margin_text;
                font-size: 10px;
                font-weight: tier_row.risk_level >= 1 ? 700 : 400;
                color: tier_row.risk_level == 2 ? Theme.accent-ruby : (tier_row.risk_level == 1 ? Theme.accent-amber : Theme.accent-emerald);
                accessible-role: AccessibleRole.text;
            }
        }
        if root.advanced && tier_row.orbit_status != "": Rectangle {
            height: orbit_txt.preferred-height;
            Tooltip { text: @markdown("Whether this tier is one complete orbit of the gear's\nsymmetry, several folded together, or partial. Amber means\nsome facets of the orbit are missing. See the glossary."); }
            orbit_txt := Text { x: 0px;
                text: "Orbit: " + tier_row.orbit_status;
                font-size: 10px;
                color: tier_row.orbit_incomplete ? Theme.accent-amber : Theme.accent-emerald;
                accessible-role: AccessibleRole.text;
            }
        }
        if tier_row.meet_partners_text != "": WrapNote {
            text: tier_row.meet_partners_text;
            font_size: 10px;
            ink: Theme.text-secondary;
        }
        // The imported-meet details (and the Adopt button they point to) are Advanced; the
        // Simple interface shows the "advanced settings are in use" note instead.
        if root.advanced && tier_row.imported_meet_text != "": WrapNote {
            text: "File says this tier " + tier_row.imported_meet_text + " -- use Adopt in the table to switch to it.";
            font_size: 10px;
            ink: Theme.accent-cyan;
        }
        if tier_row.warning_text != "": WrapWarning {
            text: tier_row.warning_text;
        }
    }
    // A new tier is added with one button (leaving a field must not create a tier).
    if root.loaded_tier_index < 0: TipButton {
        enabled: root.unlocked && !root.angle_field_invalid;
        text: "Add This Tier";
        reader_label: "Add This Tier";
        primary: true;
        hint: "Add the tier in the form to the design. It is one Undo step.";
        clicked => { root.enter_field(); }
    }
    // Room under the last row.
    Rectangle { height: 40px; }
}
