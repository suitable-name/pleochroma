import { ListView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { EditorModel } from "../../models/editor.slint";
import { GuideModel } from "../../models/guide.slint";
import { HistoryModel, HistoryRowData, HistoryThumb } from "../../models/history.slint";
import { VariantsModel } from "../../models/variants.slint";
import { TrialsModel } from "../../models/trials.slint";
import { CompactIcon } from "../compact_controls.slint";
import { VariantsSection } from "variants_section.slint";
import { TrialsView } from "trials_view.slint";
import { KitSegmentBar, KitSegment, KitBadge, KitIconButton } from "../kit/kit.slint";

// A flag: "keep this as a trial".
global HistoryIcons {
    out property <string> flag: "M5 21 V4 H17 L14 8 L17 12 H5";
}

// One step of the history on a time line: a dot on the line (filled for the step the design stands
// at, hollow for one that was undone), a small picture of the design at that step, what the step
// did, and where it stands (the current step, or one that was undone). The step the design stands
// at carries the "Keep as Trial" flag (Advanced).
//
// The data property is called `step`, not `row`: `row` is a built-in layout property of
// every element and cannot be redeclared.
component HistoryRowView inherits Rectangle {
    in property <HistoryRowData> step;
    // `false` while the guide locks undo/redo or the editor is busy: the row only looks.
    in property <bool> usable;
    // The keyboard cursor is on this row.
    in property <bool> cursor;
    // Whether Tab can stop on the row's buttons. Only the row the cursor is on says yes, so a
    // long list never puts one Tab stop per row between the list and the rest of the window.
    in property <bool> reachable;
    // The Advanced interface also shows the small save button on each row and the flag.
    in property <bool> advanced;
    callback chosen();
    // The small save button on the row: keep the design as it was at this step as a variant.
    callback save_variant();

    // Asked again whenever `thumb_version` moves (a picture finished, or the list changed).
    property <HistoryThumb> thumb: HistoryModel.thumbnail(root.step.position, HistoryModel.thumb_version);
    // The tooltip: what a click on this row does. One tooltip, so its text is chosen here.
    property <string> row_hint: !root.usable
        ? "Going to a step is switched off while the editor is\nbusy or the lesson has switched off Undo and Redo."
        : (root.step.current
            ? "The design stands at this step now."
            : (root.step.undone
                ? "Go forward to this step, which you undid. It\nstays in the list until you make a new change."
                : "Go back to this step. The steps after it stay in the list, so you can come back."));

    // The card plus the 4px gap that separates it from the next row (a ListView has no
    // `spacing`).
    height: 64px;

    // The time line: it runs through every row, ending at the top row and at "Start".
    if root.step.position < HistoryModel.step_count: Rectangle { x: 8px; y: 0px; width: 2px; height: 32px; background: Theme.border-medium; }
    if !root.step.start: Rectangle { x: 8px; y: 32px; width: 2px; height: parent.height - 32px; background: Theme.border-medium; }
    Rectangle {
        x: 3px;
        y: 26px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: root.step.current ? Theme.accent-cyan : (root.step.undone ? Theme.bg-input : Theme.text-secondary);
        border-width: root.step.undone ? 1px : 0px;
        border-color: Theme.border-medium;
    }

    card := Rectangle {
        x: 24px;
        y: 0px;
        width: parent.width - 24px;
        height: 60px;
        background: root.step.current ? Theme.surface-selected : ((touch.has-hover && root.usable) ? Theme.bg-card-hover : Theme.surface-raised);
        border-radius: 10px;
        border-width: root.cursor ? 2px : 1px;
        border-color: root.cursor ? Theme.accent-cyan-hover : (root.step.current ? Theme.accent-cyan : Theme.border-subtle);
        clip: true;
        accessible-role: AccessibleRole.list-item;
        accessible-label: root.step.title + ", " + root.step.detail + (root.step.current ? ", now" : "");
        accessible-description: root.row_hint;
        accessible-enabled: root.usable;
        accessible-item-selectable: true;
        accessible-item-selected: root.step.current;
        accessible-action-default => {
            if root.usable {
                root.chosen();
            }
        }

        Tooltip { text: @markdown("\{root.row_hint}"); }

        touch := TouchArea {
            enabled: root.usable;
            clicked => { root.chosen(); }
        }

        HorizontalLayout {
            padding: 5px;
            padding-right: 8px;
            spacing: 10px;

            // The picture. A fixed box either way, so a row without a picture yet never
            // shifts the layout when it arrives.
            Rectangle {
                width: 64px;
                height: 48px;
                background: Theme.surface-sunken;
                border-radius: 8px;
                clip: true;
                opacity: root.step.undone ? 0.6 : 1.0;

                if root.thumb.state == 1: Image {
                    source: root.thumb.picture;
                    width: 100%;
                    height: 100%;
                    image-fit: contain;
                }
                if root.thumb.state == 0: Text {
                    text: "Drawing";
                    font-size: 9px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if root.thumb.state == 2: Text {
                    text: "Does Not Solve";
                    font-size: 9px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;

                Text {
                    text: root.step.title;
                    font-size: 12px;
                    font-weight: 600;
                    color: root.step.undone ? Theme.text-muted : Theme.text-primary;
                    overflow: elide;
                }
                Text {
                    // The detail already says "Step 2, undone" for an undone step.
                    text: root.step.detail;
                    font-size: 10px;
                    color: Theme.text-muted;
                    overflow: elide;
                }
            }

            if root.step.current: VerticalLayout {
                alignment: center;
                KitBadge { text: "Now"; fill: Theme.accent-cyan-surface; ink: Theme.accent-cyan; }
            }

            // Keeps the design as it stands as a trial (Advanced), with its figures. It sits over
            // the card's own touch area, so a click on it never jumps to the step.
            if root.advanced && root.step.current: VerticalLayout {
                alignment: center;
                KitIconButton {
                    d: HistoryIcons.flag;
                    size: 26px;
                    icon_size: 13px;
                    label: "Keep as Trial";
                    hint: "Keep the design as it is now as a trial, with its\nfigures. Shortcut: Ctrl+Shift+K. See the Trials view.";
                    enabled: root.usable && TrialsModel.design_open;
                    clicked => { TrialsModel.keep_trial(); }
                }
            }
            // Keeps the design as it was at this step as a variant (Advanced).
            if root.advanced: VerticalLayout {
                alignment: center;
                CompactIcon {
                    enabled: root.usable;
                    reachable: root.reachable;
                    icon: @image-url("../../icons/save.svg");
                    hint: "Save the design as it was at this step as a variant. See the glossary.";
                    clicked => { root.save_variant(); }
                }
            }
        }
    }
}

// The Inspector's "History" tab, "Steps" view: every step of the open design's undo history,
// newest at the top, ending with "Start" (the design as opened or created). A click -- or Enter on
// the row the keyboard cursor is on -- goes to that step. Steps after the current one are
// the undone ones: dimmed, still there to go forward to until a new change is made.
//
// The list is virtualised (`ListView`): only the rows in view exist, and each asks
// `HistoryModel.thumbnail` for its picture, so only the pictures you can see are drawn.
// The whole list is one Tab stop. Up/Down move the cursor between steps (Up is newer), Home
// goes to the newest, End to "Start", Enter or Space goes to the step the cursor is on.
// Everything else (Ctrl+Z and the like) falls through to the window's shortcuts.
component HistorySteps inherits Rectangle {
    // Clicking is allowed unless the worked-example guide locks undo/redo or the editor is
    // busy -- the same condition as the Undo and Redo buttons.
    property <bool> usable: EditorModel.enabled && GuideModel.allows_history();
    // The Simple interface leaves out the per-row save button and the flag.
    property <bool> advanced: GuideModel.shows_advanced();
    // The position the keyboard cursor is on; -1 follows the current step.
    property <int> cursor_position: -1;
    property <int> effective_cursor: root.cursor_position >= 0
        ? min(root.cursor_position, HistoryModel.step_count)
        : HistoryModel.current_position;
    // One row's height in the list, gap included (`HistoryRowView.height`).
    property <length> row_height: 64px;

    init => {
        HistoryModel.opened();
    }

    // Whenever the history moves, the cursor goes back to following the current step.
    property <int> tracked_current: HistoryModel.current_position;
    changed tracked_current => {
        root.cursor_position = -1;
    }

    // Scrolls the list just enough to show the row of `position` (the newest is on top).
    function show_position(position: int) {
        let top = (HistoryModel.step_count - position) * root.row_height;
        let bottom = top + root.row_height;
        if top < -steps_list.content-y {
            steps_list.content-y = -top;
        } else if bottom > -steps_list.content-y + steps_list.visible-height {
            steps_list.content-y = steps_list.visible-height - bottom;
        }
    }

    function move_cursor(position: int) {
        root.cursor_position = max(0, min(position, HistoryModel.step_count));
        root.show_position(root.cursor_position);
    }

    function go_to(position: int) {
        if root.usable {
            HistoryModel.jump(position);
        }
    }

    scope := FocusScope {
        accessible-role: AccessibleRole.list;
        accessible-label: "History Steps";
        accessible-description: "Up and Down choose a step, Enter goes to it, Home chooses the newest step and End chooses Start.";
        key-pressed(event) => {
            if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                return reject;
            }
            if event.text == Key.UpArrow {
                root.move_cursor(root.effective_cursor + 1);
                return accept;
            } else if event.text == Key.DownArrow {
                root.move_cursor(root.effective_cursor - 1);
                return accept;
            } else if event.text == Key.Home {
                root.move_cursor(HistoryModel.step_count);
                return accept;
            } else if event.text == Key.End {
                root.move_cursor(0);
                return accept;
            } else if event.text == Key.Return || event.text == Key.Space {
                root.go_to(root.effective_cursor);
                return accept;
            }
            reject
        }

        VerticalLayout {
            spacing: 6px;

            Text {
                text: HistoryModel.step_count == 0
                    ? "No changes yet. Every change you make is listed here, so you can go back to any of them."
                    : "Click a step to go back to it. Undone steps stay here until you make a new change.";
                font-size: 11px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }

            steps_list := ListView {
                vertical-stretch: 1;
                for entry in HistoryModel.rows: HistoryRowView {
                    step: entry;
                    usable: root.usable;
                    advanced: root.advanced;
                    cursor: scope.has-focus && root.effective_cursor == entry.position;
                    reachable: root.effective_cursor == entry.position;
                    chosen => {
                        scope.focus();
                        root.cursor_position = -1;
                        root.go_to(entry.position);
                    }
                    save_variant => {
                        if root.usable {
                            VariantsModel.begin_save(entry.position);
                        }
                    }
                }
            }
        }
    }
}

// The Inspector's "History" tab. Three views, chosen by the segment at its top: the steps of the
// open design's undo history (`HistorySteps`), the trials kept this session (`TrialsView`, state in
// `models/trials.slint`) and the variants saved for the design (`VariantsSection`, state in
// `models/variants.slint`). The Inspector header's "?" button opens this tab's manual page
// (`HelpTopics.history`).
//
// Simple and Advanced (`GuideModel.shows_advanced()`): the Simple interface shows the steps alone
// (no segment, no Trials, no Variants); a view left open when the interface switches to Simple
// falls back to the steps.
export component HistoryTab inherits Rectangle {
    property <bool> advanced: GuideModel.shows_advanced();
    property <int> tracked_view: VariantsModel.view;
    function leave_hidden_view() {
        if !root.advanced && VariantsModel.view != 0 {
            VariantsModel.view = 0;
        }
    }
    init => { root.leave_hidden_view(); }
    changed advanced => { root.leave_hidden_view(); }
    changed tracked_view => { root.leave_hidden_view(); }

    VerticalLayout {
        spacing: 8px;

        if root.advanced: HorizontalLayout {
            KitSegmentBar {
                width: view_row.preferred-width + 4px;
                view_row := HorizontalLayout {
                    x: 2px;
                    padding: 2px;
                    spacing: 2px;
                    KitSegment {
                        text: "Steps";
                        hint: "Every change you made to this design, newest first. Click one to go back to it.";
                        on: VariantsModel.view == 0;
                        picked => { VariantsModel.view = 0; }
                    }
                    KitSegment {
                        text: "Trials";
                        hint: "Designs you kept this session to compare and come back to,\nwith their figures. They are not saved with the design.";
                        on: VariantsModel.view == 2;
                        picked => { VariantsModel.view = 2; }
                    }
                    KitSegment {
                        text: "Variants";
                        hint: "Named copies of this design that you keep to\ncome back to or to compare. See the glossary.";
                        on: VariantsModel.view == 1;
                        picked => {
                            VariantsModel.view = 1;
                            // The guide's Variants lesson waits for the view to be opened.
                            GuideModel.event("variants_opened");
                        }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        if VariantsModel.view == 0 || !root.advanced: HistorySteps {
            vertical-stretch: 1;
        }
        if VariantsModel.view == 1 && root.advanced: VariantsSection {
            vertical-stretch: 1;
        }
        if VariantsModel.view == 2 && root.advanced: TrialsView {
            vertical-stretch: 1;
        }
    }
}
