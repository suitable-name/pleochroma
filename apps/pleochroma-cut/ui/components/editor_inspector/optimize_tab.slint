import { LineEdit, CheckBox, Slider, ComboBox, SpinBox } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { TiltWindows } from "../../shared/tilt_windows.slint";
import { EditorModel } from "../../models/editor.slint";
import { CompareModel } from "../../models/compare.slint";
import { GuideModel } from "../../models/guide.slint";
import { OptimizeModel, OptimizeCandidateRow } from "../../models/optimize.slint";
import { WarningLine } from "../warning_line.slint";
import { FormRow } from "form_row.slint";
import { TipButton } from "../compact_controls.slint";
import { AdvancedNote } from "../advanced_note.slint";
import { TuneModel } from "../../models/tune.slint";
import { TuneTab } from "tune_tab.slint";
import { FormRowMetrics } from "form_row.slint";
import { WrapNote } from "wrap_note.slint";
import { ColumnHead, CandidateRowView } from "candidate_row.slint";
import { KitSection, KitSegmentBar, KitSegment, KitIcon, KitIcons, KitCard } from "../kit/kit.slint";
import { R3Tile, R3Wide, R3Link } from "../kit/r3c.slint";

// A tick box with a label that wraps and can be clicked, for the long option texts of this tab (a
// plain `CheckBox` text does not wrap in a narrow panel). The whole row is the check box for a
// screen reader; the tooltip shows over the row.
component OptionRow inherits Rectangle {
    in property <string> label;
    in property <string> tip;
    in property <bool> active: true;
    in-out property <bool> checked: false;
    callback toggled(bool);

    height: max(28px, option_label.preferred-height + 10px);
    border-radius: 6px;
    border-width: option_focus.has-focus ? 2px : 0px;
    border-color: Theme.accent-cyan-hover;
    accessible-role: AccessibleRole.checkbox;
    accessible-label: root.label;
    accessible-description: root.tip;
    accessible-enabled: root.active;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        if root.active {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    if root.tip != "": Tooltip { text: @markdown("\{root.tip}"); }
    option_focus := FocusScope {
        enabled: root.active;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.checked = !root.checked;
                root.toggled(root.checked);
                return accept;
            }
            return reject;
        }
    }
    HorizontalLayout {
        padding-left: 2px;
        spacing: 9px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 5px;
                background: root.checked ? Theme.accent-cyan : transparent;
                border-width: 1px;
                border-color: root.checked ? Theme.accent-cyan : Theme.border-medium;
                opacity: root.active ? 1.0 : 0.5;
                if root.checked: KitIcon { x: 2px; y: 2px; d: KitIcons.check; size: 14px; ink: Theme.text-on-accent; stroke: 2.4px; }
            }
        }
        option_label := Text {
            horizontal-stretch: 1;
            text: root.label;
            font-size: 12px;
            color: root.active ? Theme.text-primary : Theme.text-muted;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
    TouchArea {
        enabled: root.active;
        mouse-cursor: pointer;
        clicked => {
            option_focus.focus();
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// The Inspector's "Optimize" tab: choose what to favour, say what may change, run, and pick
// one of the ranked candidates. Everything here reads/writes `OptimizeModel` (this tab's own
// state) or `EditorModel` (the weight boxes, budget, seed, polish, the running/status/result
// rows, Apply and the Preview toggle, which the command bar and status strip share). The
// local "preview this candidate in the shared viewport" checkbox state stays on
// `EditorInspector` itself (`EditorModel.optimize_preview_toggled` is a callback-only surface,
// not a two-way property) and is mirrored here two-way.
//
// Search view, top to bottom: the objective as tiles, What May Change, the Run line (budget,
// starts, seed, candidates and polish, folded: they are rarely changed), Optimize with its
// estimate, and the candidates as cards.
//
// Simple and Advanced (`GuideModel.shows_advanced()`): the Simple interface keeps the objective
// (the five presets, without "Custom" unless it is already chosen), the Optimize and Cancel
// buttons, the time estimate and the whole candidate list with Preview, Compare and Apply.
// It hides "What may change", the angle ranges, the Run line and Tune (the Search/Tune segment).
// They keep their values and the search uses them; a line says so when any of them
// is not at its default (`OptimizeModel.settings_in_use`).
//
// Keyboard: the candidate list is one Tab stop; Up and Down move through the starting stone and
// the candidates, and picking one previews it like a click does.
export component OptimizeTab inherits VerticalLayout {
    // `false` while the worked-example guide locks this tab's group (see
    // `GuideAllow`, `models/guide.slint`); every input and button below ANDs it
    // into its own `enabled:`. Bound by `EditorInspector` from the same
    // `GuideModel.allows_*()` helper as this tab's pill.
    in property <bool> unlocked: true;

    // Mirror of the Preview checkbox state that `EditorInspector` owns.
    in-out property <bool> optimize_preview_checked: false;

    property <bool> advanced: GuideModel.shows_advanced();
    // Whether a control the Simple interface hides holds a value that is not its default.
    property <bool> hidden_in_use: !root.advanced && OptimizeModel.settings_in_use(
        OptimizeModel.vary_anchored,
        OptimizeModel.vary_default,
        OptimizeModel.keep_girdle,
        OptimizeModel.ranges_customised,
        EditorModel.optimize_budget_text,
        EditorModel.optimize_seed_text,
        OptimizeModel.candidates,
        EditorModel.optimize_polish_enabled,
        EditorModel.optimize_only_selected,
        OptimizeModel.starts_text);

    // Latches "Cancel" the moment it is clicked, so a second click cannot re-fire the cancel
    // while the search finishes its current evaluation.
    property <bool> cancel_requested: false;
    property <bool> running_mirror: EditorModel.optimize_running;
    changed running_mirror => {
        if !self.running_mirror {
            self.cancel_requested = false;
        }
    }
    // Nothing is picked any more: the preview goes with it.
    property <int> tracked_selection: OptimizeModel.selected_candidate;
    changed tracked_selection => {
        if self.tracked_selection < 0 && self.optimize_preview_checked {
            self.optimize_preview_checked = false;
            // Put the real design back in the viewport (a new run, an Apply or a new
            // design cleared the list while the preview was on).
            EditorModel.optimize_preview_toggled(false);
        }
    }
    // The last combo box entry is "Custom".
    property <bool> custom_objective: OptimizeModel.preset_index >= OptimizeModel.preset_labels.length - 1;
    // The Run line is open (its fields show), and the run's own report is open.
    property <bool> run_open: false;
    property <bool> details_open: false;
    // The objectives that show: without "Custom" in the Simple interface.
    property <[string]> objective_labels: (root.advanced || root.custom_objective) ? OptimizeModel.preset_labels : OptimizeModel.simple_preset_labels;
    // The Run line's one-sentence summary of the values behind it.
    property <string> run_summary: (EditorModel.optimize_budget_text == "" ? "800" : EditorModel.optimize_budget_text) + " evaluations · "
        + (OptimizeModel.starts_text == "" ? "8" : OptimizeModel.starts_text) + " starts · "
        + OptimizeModel.candidates + (OptimizeModel.candidates == 1 ? " result" : " results")
        + (EditorModel.optimize_polish_enabled ? " · polish" : "")
        + " · seed " + (EditorModel.optimize_seed_text == "" ? "0" : EditorModel.optimize_seed_text);

    // Picks a row of the candidate list: -1 is the starting stone (preview off), anything else a
    // candidate (preview on). Shared by a click and the Up and Down keys.
    function pick(index: int) {
        OptimizeModel.select_candidate(index);
        root.optimize_preview_checked = index >= 0;
        EditorModel.optimize_preview_toggled(index >= 0);
    }

    spacing: 10px;
    // The scroll bar is drawn over the right edge: keep the fields, the tiles and the buttons
    // (the Tune view's too) clear of it.
    padding-right: FormRowMetrics.scroll_gutter;
    // A small inset above the first row, so a control is never cut right at the top edge.
    padding-top: 2px;
    // Packed at the top: without it the inspector's spare height is shared out between the
    // rows, which spreads the sections apart and stretches the Optimize button.
    alignment: start;

    // --- Search | Tune ---
    // Search is the tab as it always was; Tune is its own view (`tune_tab.slint`, state in
    // `models/tune.slint`). Tune is Advanced: the Simple interface shows Search alone.
    if root.advanced: HorizontalLayout {
        KitSegmentBar {
            width: mode_row.preferred-width + 4px;
            mode_row := HorizontalLayout {
                x: 2px;
                padding: 2px;
                spacing: 2px;
                KitSegment {
                    text: "Search";
                    hint: "Let Optimize search for better angles and rank the candidates.";
                    on: !TuneModel.active;
                    enabled: root.unlocked;
                    picked => {
                        TuneModel.active = false;
                        TuneModel.mode_changed();
                    }
                }
                KitSegment {
                    text: "Tune";
                    hint: "Take the tiers one at a time and set their\nangles by hand, with a small sweep of each.";
                    on: TuneModel.active;
                    enabled: root.unlocked;
                    picked => {
                        TuneModel.active = true;
                        TuneModel.mode_changed();
                    }
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    if TuneModel.active && root.advanced: TuneTab {
        unlocked: root.unlocked;
    }
    if !TuneModel.active || !root.advanced: VerticalLayout {
    spacing: 10px;
    alignment: start;

    // --- Objective ---
    // `optimize_hint` is never empty: a disabled Optimize always says why (it shows on the
    // Optimize button below).
    KitSection { label: "AIM FOR"; }
    Rectangle {
        height: Math.ceil(root.objective_labels.length / 3) * 48px - 6px;
        accessible-role: AccessibleRole.groupbox;
        accessible-label: "Optimize Objective";
        accessible-description: "What the search should favour. Every preset weighs the same measurements; they differ in which one counts most. See the glossary.";
        for label[i] in root.objective_labels: R3Tile {
            x: Math.mod(i, 3) * (parent.width / 3);
            y: Math.floor(i / 3) * 48px;
            width: parent.width / 3 - 6px;
            h: 42px;
            text: label;
            on: OptimizeModel.preset_index == i;
            enabled: root.unlocked;
            hint: OptimizeModel.preset_index == i ? OptimizeModel.preset_description : "";
            picked => {
                OptimizeModel.preset_index = i;
                OptimizeModel.preset_changed(i);
            }
        }
    }
    WrapNote {
        text: OptimizeModel.preset_description;
        font_size: 11px;
    }
    // The size rule or the missing body colour, for the face-up colour objective.
    if (OptimizeModel.tone_active || EditorModel.optimize_weight_tone > 0.05 || EditorModel.optimize_weight_tone < -0.05) && OptimizeModel.tone_note != "": WrapNote {
        text: OptimizeModel.tone_note;
        font_size: 10px;
    }
    if root.custom_objective: VerticalLayout {
        spacing: 4px;
        Rectangle {
            height: weights_lbl.preferred-height;
            Tooltip { text: @markdown("Relative importance, any positive number. 1.0 is\nneutral. A calculation such as `1 + 0.5` works."); }
            weights_lbl := Text { text: "Weights: Windowing / Extinction / Tilt Brilliance"; font-size: 10px; color: Theme.text-muted; wrap: word-wrap; accessible-role: AccessibleRole.text; }
        }
        HorizontalLayout {
            spacing: 4px;
            // The caption above names the three fields in order; placeholder text repeats
            // which is which right where the cutter is typing.
            // `min-width: 0px`: three fields of the style's 160 px minimum do not fit a narrow dock.
            LineEdit { min-width: 0px; enabled: root.unlocked; text <=> EditorModel.optimize_weight_windowing; placeholder-text: "windowing"; accessible-label: "Windowing Weight"; changed has-focus => { EditorModel.text_focus = self.has-focus; } }
            LineEdit { min-width: 0px; enabled: root.unlocked; text <=> EditorModel.optimize_weight_extinction; placeholder-text: "extinction"; accessible-label: "Extinction Weight"; changed has-focus => { EditorModel.text_focus = self.has-focus; } }
            LineEdit { min-width: 0px; enabled: root.unlocked; text <=> EditorModel.optimize_weight_tilt_brilliance; placeholder-text: "tilt brilliance"; accessible-label: "Tilt Brilliance Weight"; changed has-focus => { EditorModel.text_focus = self.has-focus; } }
        }
        // Non-numeric/negative input is rejected Rust-side (surfaced as an error toast)
        // before it reaches the search.
        Text {
            text: "Relative weight, any positive number. Higher matters more.";
            font-size: 9px;
            color: Theme.text-muted;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }
        Rectangle {
            height: yield_weight_lbl.preferred-height;
            Tooltip { text: @markdown("How much throwing away preform volume should cost, blended\nin alongside the three optical weights above. `0` ignores\nthe weight of the finished stone. See the glossary."); }
            yield_weight_lbl := Text { text: "Yield Weight: "+ Math.round(EditorModel.optimize_weight_yield * 10) / 10; font-size: 10px; color: Theme.text-muted; wrap: word-wrap; accessible-role: AccessibleRole.text; }
        }
        Rectangle {
            height: max(yield_slider.min-height, 24px);
            Tooltip { text: @markdown("Yield weight, from 0 to 3. Drag, or click it and use the arrow keys."); }
            yield_slider := Slider {
                width: parent.width;
                height: parent.height;
                enabled: root.unlocked;
                minimum: 0.0;
                maximum: 3.0;
                accessible-label: "Yield Weight";
                value <=> EditorModel.optimize_weight_yield;
            }
        }
        Rectangle {
            height: tone_weight_lbl.preferred-height;
            Tooltip { text: @markdown("Pull the face-up color lighter (left) or deeper and stronger\n(right). `0` leaves the color out of the score. Measured table-up,\nunder the grading tray lighting every optimization rates with,\nfrom the body color in Design settings; see the glossary."); }
            tone_weight_lbl := Text {
                text: EditorModel.optimize_weight_tone < -0.05 ? "Tone: Lighter (" + Math.round(-EditorModel.optimize_weight_tone * 10) / 10 + ")"
                    : (EditorModel.optimize_weight_tone > 0.05 ? "Tone: Deeper (" + Math.round(EditorModel.optimize_weight_tone * 10) / 10 + ")" : "Tone: Off");
                font-size: 10px;
                color: Theme.text-muted;
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }
        }
        Rectangle {
            height: max(tone_slider.min-height, 24px);
            Tooltip { text: @markdown("Tone weight, from -3 (lighter) to 3 (deeper and\nstronger). Drag, or click it and use the arrow keys."); }
            tone_slider := Slider {
                width: parent.width;
                height: parent.height;
                enabled: root.unlocked;
                minimum: -3.0;
                maximum: 3.0;
                accessible-label: "Tone Weight";
                value <=> EditorModel.optimize_weight_tone;
            }
        }
    }

    // --- What may change (Advanced) ---
    if root.advanced: KitSection { label: "WHAT MAY CHANGE"; }
    if root.advanced: VerticalLayout {
        spacing: 0px;
        OptionRow {
            active: root.unlocked;
            label: "Vary Anchored Tiers (Keeps Each Facet's Girdle Edge)";
            tip: "A tier pinned to a scale value normally stays put. With this on, the\nsearch turns it about the edge it keeps on the girdle, so the girdle\noutline stays the same while the angle changes. Needed for designs\nimported from the catalogue, where every tier is pinned. See the glossary.";
            checked <=> OptimizeModel.vary_anchored;
            toggled(on) => { OptimizeModel.vary_toggled(on); }
        }
        OptionRow {
            active: root.unlocked;
            label: "Keep the Girdle (at Least Half Its Thickness)";
            tip: "Reject a candidate whose girdle is thinner than half of the\nstarting girdle, or that loses the table facet. See the glossary.";
            checked <=> OptimizeModel.keep_girdle;
        }
        OptionRow {
            active: root.unlocked;
            label: "Only Selected Tiers";
            tip: "Limit the search to the tiers selected in the tier table.";
            checked <=> EditorModel.optimize_only_selected;
        }
    }

    // --- Angle ranges (Advanced): the summary and a link that opens the table ---
    if root.advanced: HorizontalLayout {
        spacing: 8px;
        height: 24px;
        Text {
            horizontal-stretch: 1;
            text: OptimizeModel.range_summary == "" ? "Each tier may change by 5 degrees either way." : OptimizeModel.range_summary;
            font-size: 11px;
            color: Theme.text-muted;
            vertical-alignment: center;
            overflow: elide;
        }
        tip-button-ranges-open := R3Link {
            enabled: root.unlocked;
            text: OptimizeModel.ranges_open ? "Hide" : "Edit...";
            reader_label: OptimizeModel.ranges_open ? "Hide Angle Ranges" : "Angle Ranges...";
            hint: "Each tier the search may move can change by 5 degrees either\nway. Open this to give a tier a narrower or wider range.";
            clicked => {
                OptimizeModel.ranges_open = !OptimizeModel.ranges_open;
                OptimizeModel.ranges_toggled(OptimizeModel.ranges_open);
            }
        }
    }
    if root.advanced && OptimizeModel.ranges_open: VerticalLayout {
        spacing: 3px;
        HorizontalLayout {
            spacing: 4px;
            ColumnHead { width: 24px; text: "#"; align_left: true; }
            ColumnHead { horizontal-stretch: 1; text: "NAME"; align_left: true; }
            ColumnHead { width: 46px; text: "ANGLE"; tip: "The tier's angle now, in degrees."; }
            ColumnHead { width: 58px; text: "MIN"; tip: "The lowest angle the search may try for this tier, in degrees."; }
            ColumnHead { width: 58px; text: "MAX"; tip: "The highest angle the search may try for this tier, in degrees."; }
        }
        for range_row in OptimizeModel.range_rows: HorizontalLayout {
            spacing: 4px;
            Text { width: 24px; text: range_row.tier_number; font-size: 10px; color: Theme.text-secondary; vertical-alignment: center; }
            Text { horizontal-stretch: 1; text: range_row.name == "" ? "(unnamed)" : range_row.name; font-size: 10px; color: Theme.text-secondary; overflow: elide; vertical-alignment: center; }
            Text { width: 46px; horizontal-alignment: right; text: range_row.angle; font-size: 10px; color: Theme.text-muted; vertical-alignment: center; }
            if range_row.driven: Text {
                width: 120px;
                horizontal-alignment: right;
                text: "follows a relation";
                font-size: 9px;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
            if !range_row.driven: HorizontalLayout {
                spacing: 4px;
                min_edit := LineEdit {
                    width: 58px;
                    enabled: root.unlocked;
                    font-size: 10px;
                    text: range_row.min_text;
                    accessible-label: "Lowest Angle for Tier " + range_row.tier_number;
                    edited(typed) => { OptimizeModel.range_edited(range_row.tier_index, typed, max_edit.text); }
                    changed has-focus => { EditorModel.text_focus = self.has-focus; }
                }
                max_edit := LineEdit {
                    width: 58px;
                    enabled: root.unlocked;
                    font-size: 10px;
                    text: range_row.max_text;
                    accessible-label: "Highest Angle for Tier " + range_row.tier_number;
                    edited(typed) => { OptimizeModel.range_edited(range_row.tier_index, min_edit.text, typed); }
                    changed has-focus => { EditorModel.text_focus = self.has-focus; }
                }
            }
        }
        HorizontalLayout {
            TipButton {
                enabled: root.unlocked;
                text: "Reset Ranges";
                hint: "Give every tier the default range again (5 degrees either way).";
                clicked => { OptimizeModel.reset_ranges(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    // --- Run (Advanced): one line, folded ---
    if root.advanced: KitCard {
        height: run_column.preferred-height;
        run_column := VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-bottom: root.run_open ? 10px : 0px;
            spacing: 6px;
            Rectangle {
                height: 40px;
                border-radius: 8px;
                border-width: run_focus.has-focus ? 2px : 0px;
                border-color: Theme.accent-cyan-hover;
                accessible-role: AccessibleRole.button;
                accessible-label: "Run Settings";
                accessible-description: root.run_summary;
                accessible-expandable: true;
                accessible-expanded: root.run_open;
                accessible-action-default => { root.run_open = !root.run_open; }
                run_focus := FocusScope {
                    key-pressed(event) => {
                        if event.text == Key.Space || event.text == Key.Return {
                            root.run_open = !root.run_open;
                            return accept;
                        }
                        return reject;
                    }
                }
                Tooltip { text: @markdown("How many designs the search tries, from how many starts, how many results it keeps, and its seed. Rarely changed."); }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Run"; font-size: 12px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; }
                    Text { horizontal-stretch: 1; text: root.run_summary; font-size: 11px; color: Theme.text-muted; vertical-alignment: center; overflow: elide; }
                    VerticalLayout {
                        alignment: center;
                        KitIcon { d: root.run_open ? KitIcons.chevron-down : KitIcons.chevron-right; size: 13px; ink: Theme.text-muted; }
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.run_open = !root.run_open; }
                }
            }
            if root.run_open: FormRow {
                label: "Budget";
                tooltip: "How many designs the search may try. More tries take longer\nand may find more. A calculation such as `100 * 4` works.";
                LineEdit {
                    enabled: root.unlocked;
                    text <=> EditorModel.optimize_budget_text;
                    placeholder-text: "800";
                    accessible-label: "Search Budget";
                    edited(typed) => { OptimizeModel.settings_edited(); }
                    changed has-focus => { EditorModel.text_focus = self.has-focus; }
                }
            }
            if root.run_open: FormRow {
                label: "Starts";
                tooltip: "How many different starting arrangements the search tries.\nMore starts explore more of the design space and take longer.";
                LineEdit {
                    enabled: root.unlocked;
                    text <=> OptimizeModel.starts_text;
                    placeholder-text: "8";
                    accessible-label: "Number of Starting Arrangements, 1 to 32";
                    edited(typed) => { OptimizeModel.settings_edited(); }
                    changed has-focus => { EditorModel.text_focus = self.has-focus; }
                }
            }
            if root.run_open: FormRow {
                label: "Seed";
                tooltip: "The same seed on the same design gives the same result.";
                LineEdit {
                    enabled: root.unlocked;
                    text <=> EditorModel.optimize_seed_text;
                    placeholder-text: "0";
                    accessible-label: "Search Seed";
                    changed has-focus => { EditorModel.text_focus = self.has-focus; }
                }
            }
            if root.run_open: FormRow {
                label: "Candidates";
                tooltip: "How many different good designs to keep, 1\nto 5. Each one costs a little more time.";
                SpinBox {
                    enabled: root.unlocked;
                    minimum: 1;
                    maximum: 5;
                    value <=> OptimizeModel.candidates;
                    accessible-label: "Number of Candidates to Keep";
                    edited(picked) => { OptimizeModel.settings_edited(); }
                }
            }
            if root.run_open: OptionRow {
                active: root.unlocked;
                label: "Polish";
                tip: "After the coordinate search, a second search refines the best result.";
                checked <=> EditorModel.optimize_polish_enabled;
                toggled(on) => { OptimizeModel.settings_edited(); }
            }
        }
    }
    if root.hidden_in_use: AdvancedNote { }

    // --- Optimize, with its estimate ---
    HorizontalLayout {
        spacing: 8px;
        R3Wide {
            horizontal-stretch: 1;
            text: "Optimize";
            icon: KitIcons.play;
            // `optimize_hint` explains why the button is off when it is.
            hint: EditorModel.optimize_hint;
            enabled: root.unlocked && EditorModel.optimize_available && EditorModel.busy_action == "";
            h: 42px;
            clicked => {
                EditorModel.optimize(EditorModel.optimize_weight_windowing, EditorModel.optimize_weight_extinction, EditorModel.optimize_weight_tilt_brilliance, EditorModel.optimize_weight_yield, EditorModel.optimize_weight_tone);
            }
        }
        if EditorModel.optimize_running: tip-button-cancel-requested := TipButton {
            text: root.cancel_requested ? "Cancelling..." : "Cancel";
            hint: "Stop the search now.";
            enabled: !root.cancel_requested;
            clicked => {
                root.cancel_requested = true;
                EditorModel.optimize_cancel();
            }
        }
    }
    if OptimizeModel.estimate_text != "": WrapNote {
        text: OptimizeModel.estimate_text;
        font_size: 10px;
    }
    if EditorModel.optimize_running: Rectangle {
        height: 4px;
        border-radius: 2px;
        background: Theme.bg-input;
        accessible-role: AccessibleRole.progress-indicator;
        accessible-label: "Optimize Progress";
        accessible-value: Math.round(Math.clamp(OptimizeModel.progress, 0.0, 1.0) * 100) + " percent";
        Rectangle {
            x: 0px;
            y: 0px;
            height: parent.height;
            width: parent.width * Math.clamp(OptimizeModel.progress, 0.0, 1.0);
            border-radius: 2px;
            background: Theme.accent-amber;
        }
    }

    // --- Status: running progress, or what the last run found (a problem always shows; the
    // report of a good run is behind "Details") ---
    if EditorModel.optimize_status != "" && (EditorModel.optimize_running || EditorModel.optimize_status_is_problem || root.details_open): Rectangle {
        background: Theme.bg-input;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: EditorModel.optimize_running ? Theme.accent-amber : (EditorModel.optimize_status_is_problem ? Theme.accent-ruby : Theme.accent-emerald);
        VerticalLayout {
            padding: 6px;
            WrapNote {
                text: EditorModel.optimize_status;
                font_size: 10px;
                ink: EditorModel.optimize_running ? Theme.accent-amber : (EditorModel.optimize_status_is_problem ? Theme.accent-ruby : Theme.accent-emerald);
            }
        }
    }

    // --- Results: the starting stone and the ranked candidates ---
    if OptimizeModel.has_results && !EditorModel.optimize_running: VerticalLayout {
        spacing: 6px;
        KitSection {
            label: "RESULTS";
            Rectangle { horizontal-stretch: 1; }
            if EditorModel.optimize_status != "" && !EditorModel.optimize_status_is_problem: VerticalLayout {
                alignment: center;
                R3Link {
                    text: root.details_open ? "Hide details" : "Details";
                    hint: "What the last run found: evaluations, starts, time and what the polish added.";
                    clicked => { root.details_open = !root.details_open; }
                }
            }
        }
        if OptimizeModel.results_stale: WarningLine {
            text: "The design changed after this run. Run Optimize again to apply a candidate.";
            font_size: 9px;
        }
        // The list is one Tab stop; Up and Down pick the row above or below, like a click.
        list_focus := FocusScope {
            enabled: root.unlocked;
            accessible-role: AccessibleRole.list;
            accessible-label: "Optimize Candidates";
            accessible-description: "Up and Down pick the starting stone or a candidate. The picked candidate is previewed.";
            key-pressed(event) => {
                if event.text == Key.DownArrow {
                    if OptimizeModel.selected_candidate < OptimizeModel.candidate_rows.length - 1 {
                        root.pick(OptimizeModel.selected_candidate + 1);
                    }
                    return accept;
                } else if event.text == Key.UpArrow {
                    if OptimizeModel.selected_candidate >= 0 {
                        root.pick(OptimizeModel.selected_candidate - 1);
                    }
                    return accept;
                }
                reject
            }
            VerticalLayout {
                spacing: 6px;
                CandidateRowView {
                    item: OptimizeModel.baseline_row;
                    selected: OptimizeModel.selected_candidate < 0;
                    ringed: list_focus.has-focus && OptimizeModel.selected_candidate < 0;
                    active: root.unlocked;
                    clicked => {
                        list_focus.focus();
                        root.pick(-1);
                    }
                }
                for candidate_row[index] in OptimizeModel.candidate_rows: CandidateRowView {
                    item: candidate_row;
                    selected: OptimizeModel.selected_candidate == index;
                    ringed: list_focus.has-focus && OptimizeModel.selected_candidate == index;
                    active: root.unlocked;
                    clicked => {
                        list_focus.focus();
                        root.pick(index);
                    }
                }
            }
        }

        // --- The picked candidate: Preview, Compare and Apply first, then its figures and the
        // tiers it changes ---
        if OptimizeModel.selected_candidate >= 0: VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 6px;
                // Shows the picked candidate's geometry in the shared viewport before
                // Apply; picking a row turns it on.
                Rectangle {
                    width: preview_check.preferred-width;
                    height: preview_check.preferred-height;
                    Tooltip { text: @markdown("Show the picked candidate on the stone in the 3D\nview, so you can look at it before you apply it."); }
                    preview_check := CheckBox {
                        width: parent.width;
                        height: parent.height;
                        enabled: root.unlocked;
                        text: "Preview";
                        checked <=> root.optimize_preview_checked;
                        toggled => {
                            if CompareModel.optimizer_inline_open { CompareModel.close(); }
                            EditorModel.optimize_preview_toggled(root.optimize_preview_checked);
                        }
                    }
                }
                // The visual before/after compare window (`gui::editor::compare`) on the
                // picked candidate -- its "Keep after" runs `EditorModel.optimize_apply()`,
                // the Apply button's own handler.
                TipButton {
                    enabled: root.unlocked && EditorModel.optimize_can_apply;
                    text: "Compare...";
                    hint: "Compare this candidate in the editor: side by side, with a split\nslider, or as an overlay, with optical figures and tilt averages.";
                    clicked => { CompareModel.open_optimize(); }
                }
            }
            // Only enabled while there is a real, current (not stale) candidate to commit.
            // Goes through `History::apply`, never a direct mutation, so it is one undoable
            // step like every other edit.
            R3Wide {
                enabled: root.unlocked && EditorModel.optimize_can_apply;
                text: "Apply This Candidate";
                hint: "Commit the picked candidate as one undoable edit.\nTiers that follow a relation move with it.";
                h: 38px;
                clicked => { EditorModel.optimize_apply(); }
            }
            // Per-component before/after: windowing, extinction, tilt brilliance and yield
            // loss each get their own row, with the blended score last, rather than one
            // number that could hide a trade-off.
            // The predicted face-up colour before and after, as the screen shows that light.
            if OptimizeModel.tone_swatches.has: Rectangle {
                height: 16px;
                Tooltip { text: @markdown("The predicted color of the light the stone returns face-up, before\nand after, under the lighting preset the run used, shown as your\nscreen shows that light (white-balanced like the Live Render)."); }
                HorizontalLayout {
                    spacing: 4px;
                    Text { text: "Face-Up Color"; font-size: 10px; color: Theme.text-secondary; vertical-alignment: center; accessible-role: AccessibleRole.text; }
                    Rectangle { width: 14px; Rectangle { width: 14px; height: 14px; y: (parent.height - self.height) / 2; border-radius: 3px; background: OptimizeModel.tone_swatches.before; } }
                    Text { text: "->"; font-size: 10px; color: Theme.text-muted; vertical-alignment: center; }
                    Rectangle { width: 14px; Rectangle { width: 14px; height: 14px; y: (parent.height - self.height) / 2; border-radius: 3px; background: OptimizeModel.tone_swatches.after; } }
                    Text { text: OptimizeModel.tone_swatches.before_text + " -> " + OptimizeModel.tone_swatches.after_text; font-size: 10px; color: Theme.text-muted; vertical-alignment: center; accessible-role: AccessibleRole.text; }
                    Text { horizontal-stretch: 1; text: OptimizeModel.tone_swatches.lighting; font-size: 9px; color: Theme.text-muted; overflow: elide; vertical-alignment: center; accessible-role: AccessibleRole.text; }
                }
            }
            if EditorModel.optimize_result_rows.length > 0: VerticalLayout {
                spacing: 2px;
                for row in EditorModel.optimize_result_rows: HorizontalLayout {
                    spacing: 4px;
                    Text { horizontal-stretch: 1; text: row.label; font-size: 11px; color: Theme.text-secondary; overflow: elide; accessible-role: AccessibleRole.text; }
                    Text { text: row.before; font-size: 11px; color: Theme.text-muted; accessible-role: AccessibleRole.text; }
                    Text { text: "->"; font-size: 11px; color: Theme.text-muted; }
                    Text {
                        text: (row.direction > 0 ? "▲ " : (row.direction < 0 ? "▼ " : "")) + row.after;
                        font-size: 11px;
                        font-weight: 600;
                        color: row.direction > 0 ? Theme.accent-emerald
                            : (row.direction < 0 ? Theme.accent-ruby : Theme.text-primary);
                        accessible-role: AccessibleRole.text;
                    }
                }
            }
            // Which tiers the picked candidate would change, and by how much.
            if EditorModel.optimize_change_rows.length > 0: VerticalLayout {
                spacing: 2px;
                Text { text: "Tiers This Would Change:"; font-size: 10px; font-weight: 700; color: Theme.text-muted; accessible-role: AccessibleRole.text; }
                HorizontalLayout {
                    spacing: 4px;
                    ColumnHead { width: 28px; text: "#"; align_left: true; }
                    ColumnHead { horizontal-stretch: 1; text: "NAME"; align_left: true; }
                    ColumnHead { width: 52px; text: "FROM"; tip: "The tier's angle now, in degrees."; }
                    ColumnHead { width: 52px; text: "TO"; tip: "The angle this candidate gives the tier, in degrees."; }
                }
                for change in EditorModel.optimize_change_rows: HorizontalLayout {
                    spacing: 4px;
                    Text { width: 28px; text: change.tier_number; font-size: 11px; color: Theme.text-secondary; }
                    Text { horizontal-stretch: 1; text: change.name == "" ? "(unnamed)" : change.name; font-size: 11px; color: Theme.text-secondary; overflow: elide; }
                    Text { width: 52px; horizontal-alignment: right; text: change.from_angle; font-size: 11px; color: Theme.text-muted; }
                    Text { width: 52px; horizontal-alignment: right; text: change.to_angle; font-size: 11px; font-weight: 600; color: Theme.text-primary; }
                }
            }
        }
        // How to read the cards above.
        WrapNote {
            text: "Windowing (Wind.), tilt brilliance (Bril., all tilts to " + TiltWindows.scored + "), extinction (Ext.) and yield loss as percentages. ▲ green beats the starting stone, ▼ red is worse. Tone is the face-up lightness L* with its predicted color. Click a card to preview it.";
            font_size: 10px;
        }
    }
    } // The Search view.
}
