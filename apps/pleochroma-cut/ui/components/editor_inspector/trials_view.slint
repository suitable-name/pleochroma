import { LineEdit, ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { EditorModel } from "../../models/editor.slint";
import { GuideModel } from "../../models/guide.slint";
import { TrialsModel, TrialRow, TrialCellItem } from "../../models/trials.slint";
import { CompactButton } from "../compact_controls.slint";
import { FormRowMetrics } from "form_row.slint";
import { WrapNote } from "wrap_note.slint";
import { ScrollFade } from "scroll_fade.slint";
import { KitSection, KitSegmentBar, KitSegment, KitButton, KitCard, KitSwitchRow, KitIcons } from "../kit/kit.slint";
import { R3Delta, R3Link } from "../kit/r3c.slint";

// One figure of a trial as a chip: its column name and the signed change since the Baseline (or
// the value itself on the Baseline's own line). Green is better than the figure's noise
// threshold, red is worse, grey is about the same (or not comparable); an arrow says up or down,
// so the meaning never rests on the color; the best value of the list has an outline. The
// tooltip has the Baseline and trial values.
component TrialFigure inherits Rectangle {
    in property <string> heading;
    in property <TrialCellItem> cell;
    // The Baseline's own line shows values, not changes.
    in property <bool> baseline: false;

    // The change is written with its sign ("+1.8", "-0.4").
    property <bool> negative: root.cell.change_text.to-float() < 0;
    height: 18px;
    width: chip.width;

    chip := R3Delta {
        text: root.heading + " " + ((root.baseline || root.cell.change_text == "") ? root.cell.text : root.cell.change_text);
        trend: root.cell.tone == 1 ? 1 : (root.cell.tone == 2 ? -1 : 0);
        arrow: (root.baseline || root.cell.change_text == "" || root.cell.tone == 0) ? 0 : (root.negative ? -1 : 1);
        best: root.cell.best;
        hint: root.cell.tooltip;
    }
}

// A trial's star: a filled amber star while it is starred (it stays when the list is full), an
// outline otherwise. It is a check box to a screen reader.
component StarToggle inherits Rectangle {
    in property <bool> starred;
    in property <bool> enabled: true;
    in property <bool> reachable: true;
    in property <string> hint;
    callback toggled();

    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: (touch.has-hover && root.enabled) ? Theme.bg-card-hover : transparent;
    border-width: star_focus.has-focus ? 2px : 0px;
    border-color: Theme.accent-cyan-hover;
    opacity: root.enabled ? 1.0 : 0.4;
    accessible-role: AccessibleRole.checkbox;
    accessible-label: "Star";
    accessible-description: root.hint;
    accessible-checkable: true;
    accessible-checked: root.starred;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.toggled();
        }
    }

    Tooltip { text: @markdown("\{root.hint}"); }
    star_focus := FocusScope {
        enabled: root.enabled && root.reachable;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.toggled();
                return accept;
            }
            return reject;
        }
    }
    Path {
        x: (parent.width - 16px) / 2;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: KitIcons.star;
        fill: root.starred ? Theme.accent-amber : transparent;
        stroke: root.starred ? Theme.accent-amber : Theme.text-muted;
        stroke-width: 1.7px;
        stroke-line-join: round;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// One line of the table, as a card: the number, the label and where the trial came from, the
// star, and the five figures as chips under them. The Baseline row (`baseline`) is the same line
// without a star and without a click.
component TrialLine inherits Rectangle {
    in property <TrialRow> entry;
    in property <bool> selected;
    in property <bool> baseline: false;
    in property <bool> usable: true;
    // Room kept free at the right edge for the list's scroll bar, which is drawn over the row.
    in property <length> gutter: 0px;
    callback chosen();
    callback star_toggled();

    // The card plus the 6px gap that separates it from the next row (a ListView has no
    // `spacing`).
    height: 64px;

    property <string> line_hint: root.baseline
        ? "The Baseline: the figures every trial is read against."
        : (root.selected
            ? "Selected. The stone shows this trial. Click it again to put the design back."
            : "Click to preview this trial on the stone.");

    card := Rectangle {
        x: 0px;
        y: 0px;
        width: root.width - root.gutter;
        height: 58px;
        background: root.selected ? Theme.surface-selected : ((touch.has-hover && !root.baseline) ? Theme.bg-card-hover : Theme.surface-raised);
        border-radius: 10px;
        border-width: 1px;
        border-color: root.selected ? Theme.accent-cyan : (root.baseline ? Theme.border-medium : Theme.border-subtle);
        clip: true;
        accessible-role: AccessibleRole.list-item;
        accessible-label: root.baseline
            ? root.entry.label
            : ("Trial " + root.entry.number + ", " + root.entry.label + ", " + root.entry.origin
                + (root.entry.starred ? ", starred" : "")
                + (root.entry.note != "" ? ", " + root.entry.note : ""));
        accessible-description: root.line_hint;
        accessible-enabled: root.usable && !root.baseline;
        accessible-item-selectable: !root.baseline;
        accessible-item-selected: root.selected;
        accessible-action-default => {
            if root.usable && !root.baseline {
                root.chosen();
            }
        }

        Tooltip { text: @markdown("\{root.line_hint}"); }

        // Declared before the layout, so the star above it takes its own clicks.
        touch := TouchArea {
            enabled: root.usable && !root.baseline;
            clicked => { root.chosen(); }
        }

        VerticalLayout {
            padding-left: 12px;
            padding-right: 6px;
            padding-top: 5px;
            padding-bottom: 5px;
            spacing: 4px;

            HorizontalLayout {
                height: 26px;
                spacing: 8px;
                Text {
                    text: root.baseline ? "B" : "\{root.entry.number}";
                    font-size: 14px;
                    font-weight: 800;
                    color: root.baseline ? Theme.text-muted : Theme.text-secondary;
                    width: 22px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.entry.label + (root.entry.note != "" ? "  \"" + root.entry.note + "\"" : "");
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text-primary;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Text {
                    text: root.entry.origin;
                    font-size: 10px;
                    color: Theme.text-muted;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if !root.baseline: StarToggle {
                    starred: root.entry.starred;
                    reachable: root.selected;
                    hint: root.entry.starred
                        ? "Starred: this trial stays when the list is full. Click to clear the star."
                        : "Star this trial so it stays when the list is full.";
                    enabled: root.usable;
                    toggled => { root.star_toggled(); }
                }
            }
            HorizontalLayout {
                height: 18px;
                spacing: 5px;
                alignment: start;
                for figure[i] in root.entry.cells: TrialFigure {
                    heading: TrialsModel.columns[i];
                    cell: figure;
                    baseline: root.baseline;
                }
            }
        }
    }
}

// The Inspector's History tab, "Trials" view: the trials the cutter kept. A trial is the design
// with its figures. The table reads them against the Baseline, its first line. A click on a row
// previews the trial on the stone; Restore brings it back as one undo step. The actions of the
// picked trial (Restore, Compare to Current, Set as Baseline, Save as Variant, Delete) sit in one
// card under the list.
export component TrialsView inherits Rectangle {
    // The same condition as the History tab's other buttons.
    property <bool> usable: EditorModel.enabled && GuideModel.allows_history();
    property <bool> has_selection: TrialsModel.selected >= 0;

    // The guide's Keep Trials lesson waits for the view to open.
    init => { GuideModel.event("trials_view_opened"); }

    // The view scrolls as a whole when the Inspector is too short for its minimum (the list
    // keeps two rows and the detail of a chosen trial stays reachable); with room to spare the
    // column is exactly as tall as the viewport and the list takes the spare height.
    trials_scroll := ScrollView {
        VerticalLayout {
        width: trials_scroll.visible-width;
        height: max(trials_scroll.visible-height, self.min-height);
        spacing: 8px;
        // The scroll bar is drawn over the right edge: keep the buttons, the stars and the
        // note field clear of it. A small inset above, so nothing is cut at the top edge.
        padding-right: FormRowMetrics.scroll_gutter;
        padding-top: 2px;

        // Keep as Trial, Re-score Trials (only while some trial needs it) and the sort order.
        HorizontalLayout {
            spacing: 8px;
            height: 32px;
            // The wrapper carries the guide's outline, so the button keeps its own size.
            Rectangle {
                width: keep_button.preferred-width;
                keep_button := KitButton {
                    text: "Keep as Trial";
                    icon: KitIcons.plus;
                    kind: 1;
                    h: 32px;
                    hint: "Keep the design as it is now as a trial,\nwith its figures. Shortcut: Ctrl+Shift+K.";
                    enabled: root.usable && TrialsModel.design_open;
                    clicked => { TrialsModel.keep_trial(); }
                }
                // The guide's Keep Trials lesson outlines this button.
                if GuideModel.highlight_target == "keep_trial_button": Rectangle {
                    border-width: 2px;
                    border-color: Theme.accent-cyan;
                    border-radius: 8px;
                }
            }
            if TrialsModel.rescore_needed || TrialsModel.rescoring: KitButton {
                text: TrialsModel.rescoring ? "Scoring..." : "Re-score Trials";
                h: 32px;
                hint: "Score the trials that were scored in another material,\nor not at all, under the design's material.";
                enabled: root.usable && TrialsModel.rescore_needed && !TrialsModel.rescoring;
                clicked => { TrialsModel.rescore(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 8px;
            height: 32px;
            Text {
                text: "Sort";
                font-size: 11px;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
            KitSegmentBar {
                width: sort_row.preferred-width + 4px;
                accessible-role: AccessibleRole.groupbox;
                accessible-label: "Sort Trials";
                sort_row := HorizontalLayout {
                    x: 2px;
                    padding: 2px;
                    spacing: 2px;
                    for option[i] in TrialsModel.sort_options: KitSegment {
                        text: option;
                        on: TrialsModel.sort_index == i;
                        picked => {
                            TrialsModel.sort_index = i;
                            TrialsModel.sort_changed(i);
                        }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        // No trial yet: what to do about it, in place of the list.
        if TrialsModel.rows.length == 0: WrapNote {
            text: TrialsModel.empty_text;
            font_size: 11px;
        }

        // The Baseline as the first line of the table.
        if TrialsModel.baseline_row.has_metrics: TrialLine {
            entry: TrialsModel.baseline_row;
            baseline: true;
            gutter: 14px;
        }

        trials_list := ListView {
            vertical-stretch: 1;
            // Two rows at least, so the detail below never squeezes the list away.
            min-height: TrialsModel.rows.length == 0 ? 0px : 132px;
            for trial in TrialsModel.rows: TrialLine {
                entry: trial;
                usable: root.usable;
                gutter: 14px;
                selected: TrialsModel.selected == trial.number;
                chosen => { TrialsModel.select(trial.number); }
                star_toggled => { TrialsModel.toggle_star(trial.number); }
            }
        }

        // The picked trial: its note and what can be done with it.
        if root.has_selection: KitCard {
            height: actions_column.preferred-height;
            actions_column := VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        horizontal-stretch: 1;
                        text: TrialsModel.selected_label;
                        font-size: 13px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Text { text: "shown on the stone"; font-size: 11px; color: Theme.accent-cyan; vertical-alignment: center; }
                }
                LineEdit {
                    text: TrialsModel.selected_note;
                    placeholder-text: "Note (optional), for example: steeper crown";
                    enabled: root.usable;
                    accessible-label: "Trial Note";
                    accepted(value) => { TrialsModel.set_note(TrialsModel.selected, value); }
                    changed has-focus => {
                        EditorModel.text_focus = self.has-focus;
                        if !self.has-focus {
                            TrialsModel.set_note(TrialsModel.selected, self.text);
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    height: 30px;
                    KitButton {
                        text: "Restore";
                        kind: 1;
                        h: 30px;
                        hint: "Bring this trial's design back as one step you can undo.";
                        enabled: root.usable;
                        clicked => { TrialsModel.restore(); }
                    }
                    KitButton {
                        text: "Compare to Current";
                        h: 30px;
                        hint: "Show this trial and the design now side by side in the Compare window.";
                        enabled: root.usable;
                        clicked => { TrialsModel.compare(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 6px;
                    height: 30px;
                    KitButton {
                        text: "Set as Baseline";
                        h: 30px;
                        hint: "Use this trial as the Baseline. The figures\nabove then show every change from it.";
                        enabled: root.usable && GuideModel.allows_advanced();
                        clicked => { TrialsModel.set_as_baseline(); }
                    }
                    KitButton {
                        text: "Save as Variant...";
                        h: 30px;
                        hint: "Keep this trial's design as a named variant in the library, not the design now.";
                        enabled: root.usable;
                        clicked => { TrialsModel.save_as_variant(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // A labelled button, not a bare cross: it removes the trial from the list.
                    CompactButton {
                        width: 64px;
                        height: 30px;
                        font_size: 11px;
                        text: "Delete";
                        ink: Theme.danger;
                        hint: "Remove this trial from the list. The design is not changed.";
                        enabled: root.usable;
                        clicked => { TrialsModel.delete(); }
                    }
                }
            }
        }

        // How to read the list, and the recording switch, sit under the list.
        if TrialsModel.rows.length > 0: WrapNote {
            text: "Click a trial to see it on the stone. Chips show the change since the Baseline: green with an up or down arrow is better or worse than the figure's noise; the best figure of each column has an outline.";
            font_size: 10px;
        }
        KitSwitchRow {
            label: "Record Every Change";
            on: TrialsModel.record_every_change;
            enabled: root.usable;
            toggled => {
                TrialsModel.record_every_change = !TrialsModel.record_every_change;
                TrialsModel.record_every_change_toggled(TrialsModel.record_every_change);
            }
        }
        WrapNote {
            text: "Keeps one trial for every change you make, at most one per second. Undo and Redo never add one.";
            font_size: 10px;
        }
        }
    }
    // More below the edge: a fade, so a cut row reads as "scroll for more".
    ScrollFade {
        x: 0px;
        y: parent.height - self.height;
        width: parent.width - FormRowMetrics.scroll_gutter;
        active: trials_scroll.content-height + trials_scroll.content-y > trials_scroll.visible-height + 2px;
    }
}
