import { Theme } from "../../theme.slint";
import { EditorModel } from "../../models/editor.slint";
import { GuideModel } from "../../models/guide.slint";
import { HelpTopics } from "../../models/help.slint";
import { GuideLockTip } from "../guide_lock.slint";
import { HelpButton } from "../help_button.slint";

// One tab of the Inspector, a segment of the tab bar. It takes Tab and answers Space and Enter,
// shows a ring while it has focus, and is a tab (picked or not) to a screen reader. `label` is
// the name a screen reader, the harness and the lessons use; `text` is what shows (they differ
// only for the Tier tab, which reads "Tiers"). `hint` says what the tab holds.
component InspectorTabPill inherits Rectangle {
    in property <string> label;
    in property <string> text;
    // One plain sentence: what the tab is for. Shown as the tooltip while the tab is usable.
    in property <string> hint;
    in property <bool> active;
    // `false` while the worked-example guide locks this tab (see `GuideAllow`).
    in property <bool> allowed: true;
    // The guide's accent outline, for a step that points at this tab.
    in property <bool> highlighted: false;
    callback clicked();

    height: 22px;
    width: pill_text.preferred-width + 22px;
    background: root.active ? Theme.bg-elevated : (touch.has-hover && root.allowed ? Theme.bg-card-hover : transparent);
    border-radius: 6px;
    border-width: (root.highlighted || pill_focus.has-focus) ? 2px : (root.active ? 1px : 0px);
    border-color: pill_focus.has-focus ? Theme.accent-cyan-hover : ((root.active || root.highlighted) ? Theme.accent-cyan : Theme.border-subtle);
    opacity: root.allowed ? 1.0 : 0.4;

    accessible-role: AccessibleRole.tab;
    accessible-label: root.label;
    accessible-description: root.hint;
    accessible-enabled: root.allowed;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-action-default => {
        if root.allowed {
            root.clicked();
        }
    }

    if root.allowed && root.hint != "": Tooltip { text: @markdown("\{root.hint}"); }
    pill_focus := FocusScope {
        enabled: root.allowed;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.allowed;
        clicked => { root.clicked(); }
    }
    GuideLockTip { locked: !root.allowed; }

    pill_text := Text {
        x: 11px;
        height: parent.height;
        text: root.text != "" ? root.text : root.label;
        font-size: 11px;
        font-weight: root.active ? 700 : 600;
        color: root.active ? Theme.text-primary : Theme.text-secondary;
        vertical-alignment: center;
    }
}

// The Inspector's tab bar (`SectionHeader`'s right-side slot), with the manual button of the open
// tab. `EditorModel.inspector_tab` (0 = Tiers, 1 = Preform, 2 = Optimize, 4 = History) is the tab
// showing; 3 was the Schedule tab and is retired (its cut order is the Cutting Instructions page).
// Each tab also expands the section, so a switch made while it is collapsed is visible.
export component InspectorTabPills inherits HorizontalLayout {
    // Whether the Advanced interface shows. Kept for the caller; the four tabs show in both.
    in property <bool> advanced;
    // Whether the Tier tab holds the concave form (its own manual page).
    in property <bool> concave_loaded;
    // The manual page for the open tab's "?" button. History keeps the topic of its own tab.
    property <string> tab_help_topic: EditorModel.inspector_tab == 0
        ? (root.concave_loaded ? HelpTopics.concave-tier : HelpTopics.tier-form)
        : EditorModel.inspector_tab == 1 ? HelpTopics.preform-tab
        : EditorModel.inspector_tab == 2 ? HelpTopics.optimize-tab
        : HelpTopics.history;

    spacing: 6px;
    Rectangle {
        width: tabs_row.preferred-width + 4px;
        height: 24px;
        border-radius: 8px;
        background: Theme.bg-input;
        border-width: 1px;
        border-color: Theme.border-subtle;
        tabs_row := HorizontalLayout {
            x: 2px;
            padding-top: 1px;
            padding-bottom: 1px;
            spacing: 2px;
            InspectorTabPill {
                label: "Tier";
                text: "Tiers";
                hint: "Add a tier, or edit the one selected in the table: its\nangle, what it meets, its name and its index positions.";
                active: EditorModel.inspector_tab == 0;
                allowed: GuideModel.allows_tier_form();
                highlighted: GuideModel.highlight_target == "inspector_tier";
                clicked => { EditorModel.inspector_tab = 0; EditorModel.inspector_collapsed = false; }
            }
            InspectorTabPill {
                label: "Preform";
                hint: "The starting rough: its shape and size, the stone's proportions\nand how much of the rough is kept. See the glossary.";
                active: EditorModel.inspector_tab == 1;
                allowed: GuideModel.allows_preform_tab();
                highlighted: GuideModel.highlight_target == "preform_tab";
                clicked => { EditorModel.inspector_tab = 1; EditorModel.inspector_collapsed = false; }
            }
            InspectorTabPill {
                label: "Optimize";
                hint: "Let the program search for angles that give a brighter stone,\nthen preview and apply one of the results. See the glossary.";
                active: EditorModel.inspector_tab == 2;
                allowed: GuideModel.allows_advanced();
                highlighted: GuideModel.highlight_target == "optimize_tab";
                clicked => { EditorModel.inspector_tab = 2; EditorModel.inspector_collapsed = false; }
            }
            InspectorTabPill {
                label: "History";
                hint: "Every edit made to this design, with a picture\nof each step, the trials you kept and saved variants of it.";
                active: EditorModel.inspector_tab == 4;
                allowed: GuideModel.allows_history();
                highlighted: GuideModel.highlight_target == "history_tab";
                clicked => { EditorModel.inspector_tab = 4; EditorModel.inspector_collapsed = false; }
            }
        }
    }
    // The manual page for the open tab. Always 20 px wide, so the bar does not shift when the
    // tab changes.
    VerticalLayout {
        width: 20px;
        alignment: center;
        help-button-inspector-tab := HelpButton {
            topic: root.tab_help_topic;
            hint: EditorModel.inspector_tab == 0
                ? (root.concave_loaded ? "Open the manual page on adding a concave tier" : "Open the manual page on the tier form")
                : EditorModel.inspector_tab == 1 ? "Open the manual page on the Preform tab"
                : EditorModel.inspector_tab == 2 ? "Open the manual page on Optimize"
                : "Open the manual page on the History tab, saved variants and trials";
        }
    }
}
