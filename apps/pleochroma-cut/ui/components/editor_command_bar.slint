import { Theme } from "../theme.slint";
import { EditorModel } from "../models/editor.slint";
import { GuideModel } from "../models/guide.slint";
import { UndoRedoGroup, SolveGroup } from "editor_command_bar/edit_groups.slint";
import { AnalysisGroup, SnapshotGroup } from "editor_command_bar/analysis_groups.slint";
import { BarDivider } from "editor_command_bar/bar_parts.slint";
import { FileMenu } from "editor_command_bar/file_menu.slint";
// The "?" at the right end of the hint line opens the manual page on this bar.
import { HelpButton } from "help_button.slint";
import { HelpTopics } from "../models/help.slint";

// `ui/app.slint`'s Edit menu imports `UndoRedoLabels` from this file; it is declared with
// the Undo/Redo group that shows the same text.
export { UndoRedoLabels } from "editor_command_bar/edit_groups.slint";

// `EditorModel.solve_state` (not `status_is_problem`) is the signal the Solve button
// (`SolveGroup`) and `EditorStatusStrip`'s persistent state segment key off:
// `status_is_problem` is set `true` by every edit's stale-marker refresh and cannot tell
// "needs a Solve" apart from "solved, but genuinely failed". `solve_state`/
// `last_solve_duration_ms` are pushed from `gui/editor/view.rs` and
// `gui/editor/auto_solve.rs`.

// The Edit sub-tab's command bar: ONE row,
//
//   [Undo][Redo] | [Solved · 47 ms v][Deep Solve] | [Retarget...][Tilt Curves][Tilt Chart][Cut Mode]
//                | [Baseline v] |                                                       [File v] ?
//
// The solve state IS the Solve button (`SolveGroup`): its body solves again and its chevron opens
// Auto-Solve and Abandon Solve. Cut Mode is a button (it opens a full-screen view), not a
// Design | Cut switch. The Baseline is a menu (`SnapshotGroup`).
//
// Everything the tier table (+ Add Tier / + Add Concave Tier, Duplicate, Delete, Move
// Up/Down per row) or the inspector (the Optimize tab's own Run and Cancel) already offers
// is deliberately NOT repeated here. Each group is its own component.
//
// The row keeps one line at every dock width by dropping words, never buttons: from
// `EditorModel.dock_width` of `all_text_dock` (990 px) every button shows its name; from
// `some_text_dock` (840 px) Deep Solve, Retarget and Cut Mode do; narrower, icons only (each keeps its
// name as the accessible label and in its tooltip), and the Solve button its shortest wording.
//
// The bar's minimum width must never depend on a transient state (a solve running, the Save
// warning), because the dock grows to it: the Solve slot has one width, the Save warning is an icon
// inside the File button (`FileMenu`), and Deep Solve and Cancel Deep Solve share one slot.
//
// No caption text lives under any one button: hovering any control sets
// `EditorModel.hover_hint`, shown in an overlay under the row that takes no room while it
// is empty -- see `hover_hint`'s own doc comment on `EditorModel`.
//
// The width choices are keyed off `EditorModel.dock_width`, a value set externally (the drag handle
// in `app.slint`), never off this bar's own width: reading `self.width` and feeding it back into a
// child's `width` is a `layoutinfo-h -> layout-cache -> width -> ... -> narrow` binding loop the
// `.slint` compiler rejects.
export component EditorCommandBar inherits Rectangle {
    // Keyed off `EditorModel.dock_width` (external), never this bar's own width.
    property <bool> all_text: EditorModel.dock_width >= 990px;
    property <bool> some_text: EditorModel.dock_width >= 840px;
    property <bool> compact: EditorModel.dock_width < 760px;

    // The bar's size is that of its row (the hint overlay below is not part of it), stated
    // outright because a `Rectangle` with two children no longer takes it from the one layout.
    min-width: bar_col.min-width;
    min-height: bar_col.min-height;
    preferred-width: bar_col.preferred-width;
    preferred-height: bar_col.preferred-height;
    max-height: bar_col.max-height;

    // Above the hover hint below, so an open menu covers it, not the other way round.
    bar_col := VerticalLayout {
        z: 1;
        spacing: 2px;

        // Every row is 32 px, the height of its buttons, so nothing sits a pixel or two off its
        // neighbours' centre line.
        HorizontalLayout {
            z: 1;
            height: 32px;
            spacing: 6px;
            UndoRedoGroup {}
            BarDivider {}
            SolveGroup { deep_text: root.some_text; compact: root.compact; }
            BarDivider {}
            AnalysisGroup { some_text: root.some_text; all_text: root.all_text; }
            if GuideModel.shows_advanced(): BarDivider {}
            SnapshotGroup { show_text: root.all_text; }
            Rectangle { horizontal-stretch: 1; }
            FileMenu {}
            // The manual page on this bar, level with the buttons.
            VerticalLayout {
                alignment: center;
                HelpButton {
                    topic: HelpTopics.command-bar;
                    hint: "Open the manual page on the command bar";
                }
            }
        }
    }

    // The hover hint: an overlay under the bar that takes no room of its own. Shown only while
    // there is a hint, on an opaque card over the content below the bar. It wraps to three lines
    // and clips anything longer. It ignores the pointer.
    if EditorModel.hover_hint != "": Rectangle {
        y: root.height + 2px;
        width: root.width;
        height: 50px;
        z: 0;
        background: Theme.bg-card;
        border-width: 1px;
        border-color: Theme.border-subtle;
        border-radius: Theme.radius-sm;
        // The hint is a tooltip for the buttons (they are plain buttons, which have none
        // of their own); a screen reader gets the same words from each button's
        // description, so this line is not read twice.
        accessible-role: AccessibleRole.none;
        Text {
            x: 6px;
            y: 4px;
            width: parent.width - 12px;
            height: parent.height - 8px;
            text: EditorModel.hover_hint;
            font-size: 11px;
            color: Theme.text-secondary;
            wrap: word-wrap;
            overflow: clip;
            accessible-role: AccessibleRole.none;
        }
    }
}
