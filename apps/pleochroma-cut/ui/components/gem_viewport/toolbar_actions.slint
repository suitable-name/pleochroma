import { ComboBox, LineEdit } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { ExportModel } from "../../models/export.slint";
import { ExportRunModel } from "../../models/export_run.slint";
import { ViewportModel } from "../../models/viewport.slint";
import { SettingsModel } from "../../models/settings.slint";
import { TiltModel } from "../../models/tilt.slint";
import { OpticalModel } from "../../models/optical.slint";
import { EditorModel } from "../../models/editor.slint";
import { GuideModel } from "../../models/guide.slint";
import { PhysicscolorModel } from "../../models/physics_color.slint";
import { StaleBadge } from "../stale_badge.slint";
import { SaveNameRow } from "../settings_dialog/lighting_presets_section.slint";
import { PreviewBadge } from "../material_chip.slint";
// A running catalogue batch (tilt sweep or preview render) suspends the live tracer like an
// explicit pause. The pause pill reads it so a frozen picture shows as paused, not "Live".
// The same property is `batch_suspends_tracer` in `solid_viewport/toolbar.slint`.
import { BatchModel } from "../../models/batch.slint";

// One button of the Live Render toolbar: 32 px tall, an icon and/or a label. With a label it
// is as wide as its content, without one (or with `show_text` off, on a narrow window) it is a
// 32 px square. Tab reaches it, Space or Enter presses it, a screen reader reads `text` (or
// `name` for an icon-only button) and `hint`. `lit` is the "on" look in `lit_fill`.
component ToolbarButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    // The accessible name of an icon-only button.
    in property <string> name;
    // One plain sentence: what the button does. Shown as the tooltip.
    in property <string> hint;
    in property <bool> lit: false;
    in property <color> lit_fill: Theme.accent-cyan;
    in property <color> lit_ink: Theme.text-on-accent;
    // A toggle: a screen reader says whether it is on.
    in property <bool> checkable: false;
    in property <bool> enabled: true;
    // Off on a narrow window: only the icon is drawn.
    in property <bool> show_text: true;
    in property <length> icon_size: 14px;
    // The open tutorial step is about this button: it gets a cyan outline.
    in property <bool> highlighted: false;
    callback clicked();

    property <bool> has_text: root.text != "" && root.show_text;
    property <bool> has_icon: root.icon.width > 0;
    property <color> ink: root.lit ? root.lit_ink : (root.has_text ? Theme.text-primary : Theme.text-secondary);

    height: 32px;
    // Sized to its content, never stretched: a Rectangle in a HorizontalLayout stretches by
    // default and would take the width the capped ComboBoxes leave.
    width: root.has_text ? tb_row.preferred-width : 32px;
    background: root.lit ? root.lit_fill : (tb_touch.has-hover && root.enabled ? Theme.bg-elevated : Theme.hint-surface);
    border-radius: Theme.radius-sm;
    border-width: tb_focus.has-focus ? 2px : 1px;
    border-color: tb_focus.has-focus ? Theme.accent-cyan-hover : (root.lit ? root.lit_fill : Theme.border-medium);
    opacity: root.enabled ? 1.0 : 0.45;

    accessible-role: AccessibleRole.button;
    accessible-label: root.text != "" ? root.text : root.name;
    accessible-description: root.hint;
    accessible-checkable: root.checkable;
    accessible-checked: root.lit;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    Tooltip { text: @markdown("\{root.hint}"); }

    tb_focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    tb_row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        alignment: center;
        // Centred by a layout of its own: a fixed-size Image in the row sits at the top of
        // its cell (`vertical-alignment` only places the picture inside the Image).
        if root.has_icon: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: root.ink;
                width: root.icon_size;
                height: root.icon_size;
            }
        }
        if root.has_text: Text {
            text: root.text;
            font-size: 11px;
            font-weight: 600;
            color: root.ink;
            vertical-alignment: center;
        }
    }

    tb_touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }

    if root.highlighted: Rectangle {
        border-width: 2px;
        border-color: Theme.accent-cyan;
        border-radius: Theme.radius-sm;
    }
}

// The right-hand end of the Live Render toolbar: the inline "name it" row of the save button,
// the stale / pause / GPU pills, the Parameters buttons and Export. A component of its own so
// `GemViewportToolbarActions` can put it at the end of the one row, or on a second row when the
// viewport is too narrow for one (`wrap`) -- a single row clipped Export and the Parameters
// buttons away.
component ToolbarTail inherits HorizontalLayout {
    spacing: 8px;
    // From `GemViewportToolbarActions`: the save button's state and the one save path.
    in property <bool> saving_view_preset: false;
    in-out property <string> new_view_preset_name: "";
    callback save_view_preset();

    property <bool> batch_suspends_tracer: BatchModel.tilt_batch_running || BatchModel.preview_batch_running;
    // The tracer is held still by something other than the user's own pause.
    property <bool> pause_displayed: ViewportModel.render_paused || ExportModel.is_exporting || root.batch_suspends_tracer;

    // Inline "name it" row for the button above: the Lighting tab's own `SaveNameRow`.
    if root.saving_view_preset && GuideModel.shows_advanced(): Rectangle {
        width: 230px;
        height: 32px;
        background: Theme.hint-surface;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.accent-cyan;

        HorizontalLayout {
            padding: 3px;
            SaveNameRow {
                name <=> root.new_view_preset_name;
                placeholder: "Name this lighting...";
                field_label: "Name for the Saved Lighting";
                confirm_hint: "Save the lighting and the camera pose under this name";
                accepted(name) => {
                    root.new_view_preset_name = name;
                    root.save_view_preset();
                }
            }
        }
    }

    // Pause / Resume button of the tracer. An export or a batch holds the tracer still too; the
    // button shows that in the same amber "suspended" look as a user pause, but is disabled then,
    // so a click cannot change the user's own pause state behind the displayed one.
    //
    // Path-traced mode only (`live_view_mode == 1`): Solid mode has no tracer to pause.
    //
    // The traced image is re-rendered only on a solve, so after a tier edit it can still show
    // the old design. The shared `StaleBadge` says so and offers a one-click "Recompute".
    if ViewportModel.live_view_mode == 1 && ViewportModel.trace_stale: StaleBadge {
        // A Solve like any other: locked with the Solve button while the
        // worked-example guide runs.
        enabled: GuideModel.allows_solve();
        recompute => { EditorModel.solve(); }
    }

    if ViewportModel.live_view_mode == 1: ToolbarButton {
        icon: ViewportModel.render_paused ? @image-url("../../icons/play.svg") : @image-url("../../icons/pause.svg");
        icon_size: 13px;
        text: ViewportModel.render_paused ? "Paused" : (ExportModel.is_exporting ? "Exporting" : (root.batch_suspends_tracer ? "Paused (Batch)" : "Live"));
        hint: root.pause_displayed && !ViewportModel.render_paused
            ? "The live render is held still while an export or a catalogue batch runs."
            : "Pause or resume the live render. While paused the picture stops improving, which frees the processor.";
        lit: root.pause_displayed;
        lit_fill: Theme.accent-amber;
        // Disabled during an export or a batch too -- a click must not flip the user's real
        // pause state out from under them while the button is showing a state that isn't
        // `render_paused`.
        enabled: !ExportModel.is_exporting && !root.batch_suspends_tracer;
        clicked => {
            ViewportModel.render_paused = !ViewportModel.render_paused;
            ViewportModel.pause_toggled(ViewportModel.render_paused);
        }
    }

    // GPU status pill: shows a lost GPU device instead of a viewport that silently stops updating.
    // Hidden while healthy, "reacquiring" during the self-heal attempt, then "CPU fallback:
    // <reason>" if that fails. Amber like the stale-trace badge: the picture is not what Live
    // means.
    if ViewportModel.live_view_mode == 1 && ViewportModel.gpu_status_text != "": Rectangle {
        height: 32px;
        border-radius: Theme.radius-sm;
        background: Theme.accent-amber;
        accessible-role: AccessibleRole.text;
        accessible-label: "Graphics Status: " + ViewportModel.gpu_status_text;
        Tooltip { text: @markdown("The graphics card renderer is not running normally; the status says what the program is doing about it."); }
        gpu_status_layout := HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            Text {
                text: ViewportModel.gpu_status_text;
                font-size: 11px;
                font-weight: 700;
                color: Theme.text-on-amber;
                vertical-alignment: center;
            }
        }
        width: gpu_status_layout.preferred-width;
    }

    // Non-blocking trace note (`ViewportModel.trace_note`): a shortcut the picture skipped, such
    // as the stone shadow or the tray reflection being off for this light, or beam tracing yielding
    // to either. Plain dim text, not the amber pill: the picture is valid and stays on screen.
    if ViewportModel.live_view_mode == 1 && ViewportModel.trace_note != "": Text {
        text: ViewportModel.trace_note;
        font-size: 10px;
        color: Theme.text-disabled;
        vertical-alignment: center;
        overflow: elide;
        max-width: 280px;
        accessible-role: AccessibleRole.text;
        accessible-label: "Note: " + ViewportModel.trace_note;
    }

    // High-Resolution Export Trigger Button
    toolbar-button-is-exporting := ToolbarButton {
        icon: @image-url("../../icons/save.svg");
        icon_size: 13px;
        text: ExportModel.is_exporting ? "Exporting..." : "Export";
        hint: ExportModel.is_exporting
            ? "An export is running. Show its progress window again."
            : (ExportRunModel.running
                ? ExportRunModel.busy_hint
                : "Render the stone at high resolution and save it as a picture. Exports always show the finished stone.");
        // Another kind of export running (a video, a queue job) blocks starting this one; this
        // export's own button stays on, to bring its popup back after "Run in Background".
        enabled: !ExportRunModel.running || ExportModel.is_exporting;
        lit: ExportModel.is_open || ExportModel.is_exporting;
        lit_fill: Theme.accent-emerald;
        highlighted: GuideModel.highlight_target == "render_export_button";
        checkable: true;
        clicked => { ExportModel.is_open = !ExportModel.is_open; }
    }
}

// The camera and lighting-save buttons of the Live Render toolbar: Reset Camera, Front, Top
// and Save Lighting. A component of its own so the toolbar can put them at the end of the one
// row or, when the viewport is narrow (`wrap`), on a row of their own.
component PoseButtons inherits HorizontalLayout {
    spacing: 8px;
    in-out property <bool> saving_view_preset: false;
    in-out property <string> new_view_preset_name: "";

    // Reset Camera Button
    ToolbarButton {
        icon: @image-url("../../icons/reset.svg");
        icon_size: 16px;
        name: "Reset Camera";
        hint: "Return the camera angle, distance and light to their defaults.";
        clicked => { ViewportModel.reset_camera(); }
    }

    // Front / Top view buttons -- canonical poses for the shared camera.
    ToolbarButton {
        text: "Front";
        width: 52px;
        hint: "Look at the stone from the front: girdle edge-on, index 0 towards you.";
        clicked => { ViewportModel.set_view(0); }
    }
    ToolbarButton {
        text: "Top";
        width: 44px;
        hint: "Look straight down onto the table.";
        clicked => { ViewportModel.set_view(1); }
    }
    ToolbarButton {
        text: "Turn 90°";
        width: 72px;
        hint: "Turn the stone a quarter turn about its vertical axis, keeping the viewing angle: an oval that runs top to bottom then lies across the picture.";
        clicked => { ViewportModel.set_view(6); }
    }

    // Saves the full current view (lighting and camera pose) as a named preset; the Parameters
    // panel's save button stores lighting only. Advanced: hidden in Simple mode.
    if GuideModel.shows_advanced(): ToolbarButton {
        icon: @image-url("../../icons/save.svg");
        icon_size: 14px;
        name: "Save Lighting";
        hint: "Save lighting...: keep the current lighting and camera pose under a name. It joins the list under Saved lighting in the Lighting tab.";
        lit: root.saving_view_preset;
        checkable: true;
        clicked => {
            root.saving_view_preset = !root.saving_view_preset;
            // Same suggested name as the Lighting tab, already selected.
            root.new_view_preset_name = root.saving_view_preset ? ViewportModel.suggest_lighting_name() : "";
        }
    }
}

// The Live Render viewport's action-button row: material and lighting selectors, the camera
// buttons, Tilt Curve, Optical Diagnostics, pause and Export. The save button's state
// (`saving_view_preset`/`new_view_preset_name`) is local to this row.
//
// One row while `wrap` is off. Wrapped, the camera buttons and the right-hand end (pause,
// Export, the preview badge) take rows of their own, so nothing is clipped.
//
// Simple mode hides the Tilt Curve button and Save View Preset (`GuideModel.shows_advanced()`).
// A hidden control keeps its state.
export component GemViewportToolbarActions inherits VerticalLayout {
    spacing: 8px;

    // Set by `gem_viewport.slint` from the viewport width: drops the "Tilt Curve" and
    // "Optical Diagnostics" labels (their icons stay) and shortens the Previewing badge, so
    // the row fits a narrower window.
    in property <bool> compact: false;
    // Set by `gem_viewport.slint` from the viewport width: the right-hand end goes on its own row.
    in property <bool> wrap: false;

    property <bool> saving_view_preset: false;
    property <string> new_view_preset_name: "";

    function save_view_preset() {
        if (root.new_view_preset_name != "") {
            ViewportModel.save_view_preset(root.new_view_preset_name);
            root.saving_view_preset = false;
            root.new_view_preset_name = "";
        }
    }

    HorizontalLayout {
        spacing: 8px;

    // Another material is tried through the sidebar Stone tab's "Preview as...";
    // the Previewing badge below ends it with "Back to design".

    // Shown while the picture uses a preview material instead of the design's own. Its name cap
    // is 280px, or 64px while the save-name row is open (see the wrapped row below).
    if ViewportModel.previewing && !root.wrap: PreviewBadge {
        compact: root.compact;
    }

    // "color data updated": the selected custom material's physics recipe was built with
    // older catalogue data than this build has. It still renders from its stored bands --
    // nothing is recolored silently; the Material Editor offers "Update to current data".
    // Only in a build with the physics color editor (`physical-color`): without it there is
    // nowhere to update the recipe, so the badge would only be a dead end.
    if PhysicscolorModel.ui_enabled && ViewportModel.selected_material_color_outdated && !root.compact: Rectangle {
        height: 32px;
        background: Theme.surface-info;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.accent-cyan;
        accessible-role: AccessibleRole.text;
        accessible-label: "Color data updated. This material's physics color recipe uses older color data.";
        Tooltip { text: @markdown("This material's physics color recipe uses older color data. It still renders from its stored color; open the Material Editor to update it."); }
        badge_layout := HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            Text {
                text: "Color Data Updated";
                font-size: 11px;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
        }
        width: badge_layout.preferred-width;
    }

    // Edit / Custom Material Button (pencil)
    toolbar-button-l341 := ToolbarButton {
        icon: @image-url("../../icons/pencil.svg");
        icon_size: 15px;
        name: "Custom Material";
        hint: "Define a custom material: refractive index (R.I.), dispersion, double refraction (birefringence) and color. See the glossary.";
        lit: ViewportModel.material_editor_open;
        lit_fill: Theme.accent-purple;
        lit_ink: Theme.text-on-primary;
        checkable: true;
        clicked => { ViewportModel.material_editor_open = !ViewportModel.material_editor_open; }
    }

    // Lighting Dropdown
    Rectangle {
        min-width: 110px;
        // 300px fits the longest built-in rig name ("Grading tray (D65 hemisphere + head
        // shadow)") when the toolbar has room; the row still shrinks it to the minimum.
        preferred-width: 300px;
        max-width: 320px;
        horizontal-stretch: 1;
        height: 32px;
        background: Theme.hint-surface;
        border-radius: Theme.radius-sm;
        // The open tutorial step may outline this drop-down (a cyan, 2px border).
        border-width: GuideModel.highlight_target == "lighting_combo" ? 2px : 1px;
        border-color: GuideModel.highlight_target == "lighting_combo" ? Theme.accent-cyan : Theme.border-medium;

        // The UV lamps are part of the `physical-color` build only (`PhysicscolorModel.ui_enabled`).
        Tooltip { text: PhysicscolorModel.ui_enabled
            ? @markdown("Lighting: the four studio rigs, or the lit models -- the grading tray (D65 hemisphere + head shadow), light tent with black cards, daylight sky with sun -- the contrast view (ASET-style: red 45-75 deg, green 0-45 deg, blue 75-90 deg overhead, black below the horizon; not scored by the metrics) -- or a 365 nm or 395 nm UV lamp (CPU only, lights fluorescent materials).")
            : @markdown("Lighting: the four studio rigs, or the lit models -- the grading tray (D65 hemisphere + head shadow), light tent with black cards, daylight sky with sun, and the ASET-style contrast view (red 45-75 deg, green 0-45 deg, blue 75-90 deg overhead; not scored by the metrics)."); }

        combo-box-l371 := ComboBox {
            width: 100%;
            height: 100%;
            accessible-label: "Lighting";
            accessible-description: PhysicscolorModel.ui_enabled
                ? "How the stone is lit: a studio rig, a lit model, the contrast view or a UV lamp."
                : "How the stone is lit: a studio rig, a lit model or the contrast view.";
            model: ViewportModel.lighting_options;
            current-index <=> ViewportModel.selected_lighting_index;
            // `selected` fires after the two-way binding has synced the index, so this
            // passes the index, not the display string `val`.
            selected(val) => { ViewportModel.lighting_changed(ViewportModel.selected_lighting_index); }
        }
    }

    // Performance Curve Graph Trigger Button (bar chart, Tilt Curve). An advanced tool:
    // hidden in Simple mode, and locked with the other advanced actions while a guide runs.
    // Icon only (32px) when compact.
    if GuideModel.shows_advanced(): ToolbarButton {
        text: "Tilt Curve";
        icon: @image-url("../../icons/bar-chart.svg");
        icon_size: 13px;
        show_text: !root.compact;
        name: "Tilt Curve";
        // The open/close and stale-cache check live on `TiltModel` (`ui/models/tilt.slint`), shared
        // with the Solid view's Tilt Curve pill.
        hint: GuideModel.allows_advanced()
            ? "Open the tilt-performance chart: brilliance, windowing and extinction as the stone tilts. See the glossary."
            : GuideModel.locked_hint;
        enabled: GuideModel.allows_advanced();
        lit: TiltModel.dialog_open;
        checkable: true;
        clicked => { TiltModel.toggle_dialog(); }
    }

    // Opens the Optical Diagnostics panel (`optical_panel.slint`, mounted below the toolbar in
    // `gem_viewport.slint`). Path-Traced only: the diagnostics overlay the traced picture.
    if ViewportModel.live_view_mode == 1: ToolbarButton {
        text: "Optical Diagnostics";
        icon: @image-url("../../icons/search.svg");
        icon_size: 13px;
        show_text: !root.compact;
        name: "Optical Diagnostics";
        hint: "Show or hide the optical diagnostics: windowing, extinction, brilliance, fire and scintillation drawn over the stone.";
        lit: OpticalModel.panel_open;
        checkable: true;
        clicked => { OpticalModel.panel_open = !OpticalModel.panel_open; }
    }

    if !root.wrap: PoseButtons {
        saving_view_preset <=> root.saving_view_preset;
        new_view_preset_name <=> root.new_view_preset_name;
    }

        if !root.wrap: ToolbarTail {
            saving_view_preset: root.saving_view_preset;
            new_view_preset_name <=> root.new_view_preset_name;
            save_view_preset => { root.save_view_preset(); }
        }
    }

    // Wrapped: the camera buttons take a row of their own (the first row keeps the material
    // chip, the lighting list and Tilt Curve), then the badge and the tail.
    if root.wrap: PoseButtons {
        saving_view_preset <=> root.saving_view_preset;
        new_view_preset_name <=> root.new_view_preset_name;
    }

    if root.wrap: HorizontalLayout {
        spacing: 8px;
        if ViewportModel.previewing: PreviewBadge {
            compact: true;
            name_max_width: root.saving_view_preset ? 64px : 280px;
        }
        ToolbarTail {
            saving_view_preset: root.saving_view_preset;
            new_view_preset_name <=> root.new_view_preset_name;
            save_view_preset => { root.save_view_preset(); }
        }
    }
}
