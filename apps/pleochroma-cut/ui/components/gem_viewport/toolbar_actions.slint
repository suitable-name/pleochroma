import { Theme } from "../../theme.slint";
import { ExportModel } from "../../models/export.slint";
import { ExportRunModel } from "../../models/export_run.slint";
import { ViewportModel } from "../../models/viewport.slint";
import { TiltModel } from "../../models/tilt.slint";
import { OpticalModel } from "../../models/optical.slint";
import { GuideModel } from "../../models/guide.slint";
import { PhysicscolorModel } from "../../models/physics_color.slint";
import { HelpTopics } from "../../models/help.slint";
import { HelpButton } from "../help_button.slint";
import { KitGlass, KitIcon, KitIconButton, KitIcons, KitRigThumb } from "../kit/kit.slint";
import { ToolDivider, ToolToggle } from "view_parts.slint";

// The lighting chip: the rig's picture, its short name and a chevron. It opens the rig menu
// (`rig_menu.slint`). Its accessible name stays "Lighting", the name of the drop-down it replaces.
component LightingChip inherits Rectangle {
    in property <bool> show_name: true;
    in property <bool> open: false;
    callback clicked();

    property <int> idx: ViewportModel.selected_lighting_index;
    property <string> short_name: ViewportModel.lighting_short_names[root.idx] != "" ? ViewportModel.lighting_short_names[root.idx] : ViewportModel.lighting_options[root.idx];

    height: 30px;
    width: chip_lay.preferred-width;
    border-radius: 8px;
    background: root.open ? Theme.bg-elevated : (chip_touch.has-hover ? Theme.bg-card-hover : (Theme.high-contrast ? Theme.bg-card : Theme.glass-edge));
    // The open tutorial step may outline this chip (a cyan, 2px border).
    border-width: chip_focus.has-focus || GuideModel.highlight_target == "lighting_combo" ? 2px : 0px;
    border-color: chip_focus.has-focus ? Theme.accent-cyan-hover : Theme.accent-cyan;
    accessible-role: AccessibleRole.button;
    accessible-enabled: true;
    accessible-label: "Lighting";
    accessible-description: "How the stone is lit: " + ViewportModel.lighting_options[root.idx] + ". Opens the list of lightings.";
    accessible-action-default => { root.clicked(); }

    // The UV lamps are part of the `physical-color` build only (`PhysicscolorModel.ui_enabled`).
    Tooltip { text: PhysicscolorModel.ui_enabled
        ? @markdown("Lighting: the four studio rigs, or the lit models -- the grading tray (D65 hemisphere + head shadow), light tent with black cards, daylight sky with sun -- the contrast view (ASET-style: red 45-75 deg, green 0-45 deg, blue 75-90 deg overhead, black below the horizon; the metrics score it as the Grading tray, and its zones are the face-up card's Zones (ASET-style)) -- or a 365 nm or 395 nm UV lamp (CPU only, lights fluorescent materials).")
        : @markdown("Lighting: the four studio rigs, or the lit models -- the grading tray (D65 hemisphere + head shadow), light tent with black cards, daylight sky with sun, and the ASET-style contrast view (red 45-75 deg, green 0-45 deg, blue 75-90 deg overhead; the metrics score it as the Grading tray, and its zones are the face-up card's Zones (ASET-style))."); }

    chip_focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    chip_lay := HorizontalLayout {
        padding-left: 7px;
        padding-right: 9px;
        spacing: 7px;
        VerticalLayout {
            alignment: center;
            KitRigThumb { kind: ViewportModel.lighting_kinds[root.idx]; size: 22px; }
        }
        if root.show_name: Text {
            text: root.short_name;
            font-size: 12px;
            font-weight: 600;
            color: Theme.text-primary;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            KitIcon { d: KitIcons.chevron-down; size: 12px; ink: Theme.text-muted; }
        }
    }
    chip_touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The one accent button of the toolbar. While an export runs it reads "Exporting..." and brings
// that export's progress window back.
component ExportButton inherits Rectangle {
    // The word beside the icon; off on a very narrow view (the accessible name stays).
    in property <bool> show_text: true;
    callback clicked();

    property <bool> enabled: !ExportRunModel.running || ExportModel.is_exporting;
    property <string> text: ExportModel.is_exporting ? "Exporting..." : "Export";
    property <string> hint: ExportModel.is_exporting
        ? "An export is running. Show its progress window again."
        : (ExportRunModel.running
            ? ExportRunModel.busy_hint
            : "Render the stone at high resolution and save it as a picture. Exports always show the finished stone.");

    height: 30px;
    width: ex_lay.preferred-width;
    border-radius: 8px;
    background: !root.enabled ? Theme.surface-disabled : (ex_touch.has-hover ? Theme.accent-cyan-hover : Theme.accent-cyan);
    border-width: ex_focus.has-focus || GuideModel.highlight_target == "render_export_button" ? 2px : 0px;
    border-color: ex_focus.has-focus ? Theme.text-primary : Theme.accent-cyan-hover;
    accessible-role: AccessibleRole.button;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-description: root.hint;
    accessible-checkable: true;
    accessible-checked: ExportModel.is_open || ExportModel.is_exporting;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    Tooltip { text: @markdown("\{root.hint}"); }
    ex_focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    ex_lay := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 7px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            KitIcon { d: KitIcons.export; size: 15px; ink: root.enabled ? Theme.text-on-accent : Theme.text-disabled; }
        }
        if root.show_text: Text {
            text: root.text;
            font-size: 13px;
            font-weight: 700;
            color: root.enabled ? Theme.text-on-accent : Theme.text-disabled;
            vertical-alignment: center;
        }
    }
    ex_touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

// The Live Render viewport's one glass toolbar, top right: the lighting chip, the camera buttons
// (folded into a "View" menu on a narrow view), Tilt Curve and Optical Diagnostics (their texts
// dropped on a narrow view), Export and Help. It never changes shape for a problem: those are in
// `ProblemBanner`. `menu` is which menu `gem_viewport.slint` has open (0 none, 1 rig, 2 view).
//
// Simple mode hides the Tilt Curve button (`GuideModel.shows_advanced()`).
//
// A view too narrow for all of it (`gem_viewport.slint` decides) sets `tight`, which drops the
// texts of View and Export, and below that mounts the toolbar twice with `part`: 1 is lighting,
// camera and analysis, 2 is Export and Help, each on a row of its own.
export component GemViewportToolbarActions inherits KitGlass {
    in property <bool> narrow: false;
    in property <bool> tight: false;
    // 0 the whole toolbar, 1 lighting, camera and analysis only, 2 Export and Help only.
    in property <int> part: 0;
    in-out property <int> menu: 0;

    width: tools.preferred-width + 12px;
    height: 36px;

    tools := HorizontalLayout {
        x: 6px;
        width: parent.width - 12px;
        spacing: 4px;
        alignment: center;

        if root.part != 2: VerticalLayout {
            alignment: center;
            LightingChip {
                show_name: !root.narrow;
                open: root.menu == 1;
                clicked => { root.menu = root.menu == 1 ? 0 : 1; }
            }
        }
        if root.part != 2: VerticalLayout { alignment: center; ToolDivider { } }

        // The camera buttons.
        if !root.narrow: VerticalLayout {
            alignment: center;
            KitIconButton {
                d: KitIcons.reset;
                size: 30px;
                icon_size: 15px;
                label: "Reset Camera";
                hint: "Return the camera angle, distance and light to their defaults and centre the stone in the picture again.";
                clicked => { ViewportModel.reset_camera(); }
            }
        }
        if !root.narrow: VerticalLayout {
            alignment: center;
            KitIconButton {
                d: KitIcons.front;
                size: 30px;
                icon_size: 15px;
                label: "Front";
                hint: "Look at the stone from the front: girdle edge-on, index 0 towards you.";
                clicked => { ViewportModel.set_view(0); }
            }
        }
        if !root.narrow: VerticalLayout {
            alignment: center;
            KitIconButton {
                d: KitIcons.top;
                size: 30px;
                icon_size: 15px;
                label: "Top";
                hint: "Look straight down onto the table.";
                clicked => { ViewportModel.set_view(1); }
            }
        }
        if !root.narrow: VerticalLayout {
            alignment: center;
            KitIconButton {
                d: KitIcons.turn;
                size: 30px;
                icon_size: 15px;
                label: "Turn 90°";
                hint: "Turn the stone a quarter turn about its vertical axis, keeping the viewing angle: an oval that runs top to bottom then lies across the picture.";
                clicked => { ViewportModel.set_view(6); }
            }
        }
        if root.narrow && root.part != 2: VerticalLayout {
            alignment: center;
            ToolToggle {
                icon: KitIcons.camera;
                text: "View";
                name: "View";
                show_text: !root.tight;
                hint: "Camera buttons: Reset Camera, Front, Top and Turn 90°.";
                on: root.menu == 2;
                clicked => { root.menu = root.menu == 2 ? 0 : 2; }
            }
        }
        if root.part != 2: VerticalLayout { alignment: center; ToolDivider { } }

        // Analysis. Tilt Curve is an advanced tool: hidden in Simple mode, and locked with the
        // other advanced actions while a guide runs.
        if GuideModel.shows_advanced() && root.part != 2: VerticalLayout {
            alignment: center;
            ToolToggle {
                icon: KitIcons.chart;
                text: "Tilt Curve";
                name: "Tilt Curve";
                show_text: !root.narrow;
                // The open/close and stale-cache check live on `TiltModel` (`ui/models/tilt.slint`),
                // shared with the Solid view's Tilt Curve pill.
                hint: GuideModel.allows_advanced()
                    ? "Open the tilt-performance chart: brilliance, windowing and extinction as the stone tilts. See the glossary."
                    : GuideModel.locked_hint;
                enabled: GuideModel.allows_advanced();
                on: TiltModel.dialog_open;
                clicked => { TiltModel.toggle_dialog(); }
            }
        }
        // Opens the Optical Diagnostics panel. Path-Traced only: the diagnostics overlay the
        // traced picture.
        if ViewportModel.live_view_mode == 1 && root.part != 2: VerticalLayout {
            alignment: center;
            ToolToggle {
                icon: KitIcons.target;
                text: "Diagnostics";
                name: "Optical Diagnostics";
                show_text: !root.narrow;
                hint: "Show or hide the optical diagnostics: windowing, extinction, brilliance, fire and scintillation drawn over the stone.";
                on: OpticalModel.panel_open;
                clicked => { OpticalModel.panel_open = !OpticalModel.panel_open; }
            }
        }
        if root.part == 0: VerticalLayout { alignment: center; ToolDivider { } }

        if root.part != 1: VerticalLayout {
            alignment: center;
            ExportButton {
                show_text: !root.tight || root.part == 2;
                clicked => { ExportModel.is_open = !ExportModel.is_open; }
            }
        }
        if root.part != 1: VerticalLayout {
            alignment: center;
            HelpButton {
                topic: HelpTopics.live-render;
                hint: "Open the manual page on the Live Render viewport";
                diameter: 24px;
            }
        }
    }
}
