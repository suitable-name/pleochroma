import { LineEdit, ComboBox } from "std-widgets.slint";
import { DiagramDetailData } from "../types.slint";
import { Theme } from "../theme.slint";
import { LibraryModel } from "../models/library.slint";
import { EditorModel } from "../models/editor.slint";
import { BuildDesignModel } from "../models/build_design.slint";
import { GuideModel } from "../models/guide.slint";
import { HelpTopics } from "../models/help.slint";
import { HelpButton } from "help_button.slint";
import { TouchButton } from "touch_button.slint";
import { PlacesSegment } from "app/tab_pill_row.slint";

// Keyboard and screen reader notes for this header: every icon is a button that Tab reaches
// (focus ring from the theme), Space or Enter presses, and a screen reader hears its name and
// what it does. Each chip is one text item ("Gear: 60-index") rather than two. Save (the original
// .asc) stays in view; the other actions are in the "..." menu, where a row keeps the name its icon
// had. The Simple interface leaves out the Gem Cut Studio export; Advanced shows it.

// A single "label: value" metric chip, 20px tall, for the one-row header. `DesignChipsRow` uses
// it for every chip except Shape, which has its own edit pencil and combo. `hint` says in plain
// words what the figure is.
component MetricChip inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> hint;
    in property <color> value_color: Theme.text-primary;
    height: 20px;
    background: Theme.bg-input;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border-subtle;
    // One text item for a screen reader, not a label and a value.
    accessible-role: AccessibleRole.text;
    accessible-label: root.label + " " + root.value;
    accessible-description: root.hint;
    if root.hint != "": Tooltip { text: @markdown("\{root.hint}"); }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 3px;
        Text { text: root.label; font-size: 11px; color: Theme.text-muted; vertical-alignment: center; accessible-role: AccessibleRole.none; }
        Text {
            max-width: 160px;
            text: root.value;
            font-size: 11px;
            font-weight: 600;
            color: root.value_color;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: AccessibleRole.none;
        }
    }
}

// The smaller chip of the one-line (compact) header. The chip is 22 px tall and centred in the row;
// the component itself fills the row's height, so it sits on the row's centre line.
component CompactChip inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> hint;
    in property <color> value_color: Theme.text-primary;
    in property <bool> italic: false;
    preferred-width: chip_layout.preferred-width;
    max-width: chip_layout.preferred-width;
    horizontal-stretch: 0;
    accessible-role: AccessibleRole.text;
    accessible-label: root.label + " " + root.value;
    accessible-description: root.hint;
    if root.hint != "": Tooltip { text: @markdown("\{root.hint}"); }
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 22px;
        background: Theme.bg-input;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-subtle;
        chip_layout := HorizontalLayout {
            padding-left: 6px; padding-right: 6px; spacing: 3px;
            Text { text: root.label; font-size: 10px; color: Theme.text-muted; vertical-alignment: center; accessible-role: AccessibleRole.none; }
            Text {
                text: root.value;
                font-size: 10px;
                font-italic: root.italic;
                font-weight: 600;
                color: root.value_color;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: AccessibleRole.none;
            }
        }
    }
}

// One icon (or short word) button of the header. Square by default; `button_width` widens it
// for a word ("Yes", "No"). `flat` drops the fill and the border (the chevron and the pencils).
// Never smaller than 20 px each way.
component HeaderAction inherits Rectangle {
    in property <image> icon;
    // A short word shown instead of the icon ("gcs", "Yes", "No").
    in property <string> word;
    // What a screen reader calls it.
    in property <string> label;
    // One plain sentence: what pressing it does. Tooltip and screen-reader description.
    in property <string> hint;
    in property <bool> enabled: true;
    in property <bool> flat: false;
    in property <length> size: 28px;
    in property <length> button_width: root.size;
    in property <length> glyph: 12px;
    in property <color> ink: Theme.text-secondary;
    in property <color> edge: Theme.border-subtle;
    // The panel this button opens or closes (the header's collapse chevron).
    in property <bool> expandable: false;
    in property <bool> expanded: false;
    callback clicked();

    width: root.button_width;
    height: root.size;
    border-radius: root.flat ? 4px : Theme.radius-sm;
    opacity: root.enabled ? 1.0 : 0.5;
    background: root.flat
        ? (act_touch.has_hover && root.enabled ? Theme.bg-elevated : transparent)
        : (act_touch.has_hover && root.enabled ? Theme.bg-elevated : Theme.bg-input);
    border-width: root.flat ? 0px : 1px;
    border-color: root.edge;

    if root.word == "": Image {
        source: root.icon;
        colorize: root.ink;
        width: root.glyph;
        height: root.glyph;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
    }
    if root.word != "": Text {
        text: root.word;
        font-size: root.word == "gcs" ? 9px : 10px;
        font-weight: root.word == "gcs" ? 700 : 600;
        color: root.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: AccessibleRole.none;
    }

    act_touch := TouchButton {
        label: root.label;
        hint: root.hint;
        enabled: root.enabled;
        expandable: root.expandable;
        expanded: root.expanded;
        ring_radius: root.flat ? 4px : Theme.radius-sm;
        clicked => { root.clicked(); }
    }
}

// One row of the header's "..." menu. Space or Enter runs it; Escape closes the menu (`dismissed`).
// `danger` colors a destructive row. The name a screen reader hears is `label` (the visible `text`
// when empty), so a row keeps the name its old icon button had.
component HeaderMenuItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <string> label;
    in property <string> hint;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <color> ink: Theme.text-secondary;
    callback activated();
    callback dismissed();

    public function take_focus() {
        item_focus.focus();
    }

    height: 32px;
    border-radius: 8px;
    opacity: root.enabled ? 1.0 : 0.45;
    background: root.enabled && (item_touch.has-hover || item_focus.has-focus) ? (root.danger ? Theme.danger-surface : Theme.bg-card-hover) : transparent;
    border-width: item_focus.has-focus ? 2px : 0px;
    border-color: Theme.accent-cyan-hover;
    accessible-role: AccessibleRole.button;
    accessible-label: root.label != "" ? root.label : root.text;
    accessible-description: root.hint;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.activated();
        }
    }

    if root.hint != "": Tooltip { text: @markdown("\{root.hint}"); }
    item_focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) && root.enabled {
                root.activated();
                return accept;
            } else if event.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            return reject;
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: root.danger ? Theme.danger : root.ink;
                width: 14px;
                height: 14px;
                image-fit: contain;
            }
        }
        Text {
            text: root.text;
            font-size: 12px;
            color: root.danger ? Theme.danger : Theme.text-primary;
            vertical-alignment: center;
            accessible-role: AccessibleRole.none;
        }
    }
    item_touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.activated(); }
    }
}

// The icon actions of the selected design, in the header's right cluster: Save (the original .asc,
// always in view) and the "..." menu that holds the rest -- Open on the Web, Copy Link, Build This
// Design, Edit Metadata, the Gem Cut Studio export and, last and apart, Delete. Instantiated TWICE by
// `DetailHeaderView` (the one-line header and the full header) so the actions are defined once.
// `with_metadata` adds the metadata editor (the full header only).
//
// Delete is never next to Save: it sits at the foot of the menu, below a divider, and asks first.
// Its row turns into "Delete this design? Yes, No" inside the menu. The menu closes on a pick, on
// Escape and on a click outside it, and any of those ends the question.
component DetailActions inherits HorizontalLayout {
    in property <DiagramDetailData> detail;
    in property <bool> with_metadata: false;
    in-out property <bool> confirming_delete: false;
    callback open_url(string);
    callback copy_url(string);
    callback export_asc();
    callback export_gcs();
    callback edit_metadata();
    callback delete_diagram();

    spacing: 4px;
    alignment: end;

    // This exports the ORIGINAL file stored in the catalogue (not the user's in-editor
    // changes) -- `editor_view.slint`'s "Export Edited .asc" is the other, unrelated ".asc"
    // export. The hint below is the disambiguator between the two.
    HeaderAction {
        icon: @image-url("../icons/save.svg");
        label: "Export .asc";
        hint: "Save the original .asc file stored in the catalogue. Your own edits are not in it.";
        clicked => { root.export_asc(); }
    }

    anchor := Rectangle {
        property <bool> menu_open: false;
        width: 28px;
        height: 28px;

        // Closes the menu, ends a Delete question and returns the focus to the button.
        function close_menu() {
            self.menu_open = false;
            root.confirming_delete = false;
            more_popup.close();
        }

        HeaderAction {
            icon: @image-url("../icons/more.svg");
            label: "More Actions";
            hint: "Open on the web, copy the link, build this design as a lesson, edit its details, other exports, and delete.";
            expandable: true;
            expanded: anchor.menu_open;
            clicked => {
                root.confirming_delete = false;
                anchor.menu_open = true;
                more_popup.show();
            }
        }

        // The menu is a popup window, so it draws over the tab row and the rows below the header
        // (a component cannot raise itself above its siblings). It closes on a click outside it, on
        // Escape and on a pick; any of those ends a Delete question.
        more_popup := PopupWindow {
            // Right-aligned under the button: the cluster sits at the header's right end.
            x: anchor.width - 252px;
            y: anchor.height + 4px;
            width: 252px;
            height: menu_col.preferred-height;
            close-policy: PopupClosePolicy.close-on-click-outside;

            Rectangle {
                width: 100%;
                height: 100%;
                background: Theme.surface-dialog;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.border-dialog;
                drop-shadow-blur: 24px;
                drop-shadow-color: Theme.shadow-heavy;
                accessible-role: AccessibleRole.list;
                accessible-label: "Design Actions Menu";
            }

            // Opening from the keyboard leaves the focus in the menu.
            init => { first_item.take_focus(); }

            menu_col := VerticalLayout {
                padding: 6px;
                spacing: 1px;
                if root.detail.url != "" && !root.detail.is_local: HeaderMenuItem {
                    icon: @image-url("../icons/globe.svg");
                    text: "Open on the Web";
                    hint: "Open this design's page on the web, in your browser.";
                    activated => { anchor.close_menu(); root.open_url(root.detail.url); }
                    dismissed => { anchor.close_menu(); }
                }
                if root.detail.url != "" && !root.detail.is_local: HeaderMenuItem {
                    icon: @image-url("../icons/clipboard.svg");
                    text: "Copy Link";
                    hint: "Copy the web address of this design to the clipboard.";
                    activated => { anchor.close_menu(); root.copy_url(root.detail.url); }
                    dismissed => { anchor.close_menu(); }
                }
                // "Build this design": turns this design into a step-by-step lesson that rebuilds it
                // from an empty design, one tier at a time, and finishes by comparing the rebuild
                // with the original (`BuildDesignModel`, Rust: `gui::editor::guide::build_design`).
                // Works for local and remote designs.
                first_item := HeaderMenuItem {
                    icon: @image-url("../icons/steps.svg");
                    text: "Build This Design";
                    hint: "A step-by-step lesson that rebuilds this design from an empty design, one tier at a time.";
                    enabled: !BuildDesignModel.busy;
                    activated => { anchor.close_menu(); BuildDesignModel.start_selected(); }
                    dismissed => { anchor.close_menu(); }
                }
                // Metadata editor: title, designer, shape, refractive index, index gear, facet count,
                // symmetry order, mirror symmetry and the proportion ratios, everything the inline
                // pencils do not cover. Local designs only (see `setup_save_metadata_callback` in
                // `gui::library::detail::metadata`).
                if root.with_metadata && root.detail.is_local: HeaderMenuItem {
                    icon: @image-url("../icons/info.svg");
                    text: "Edit Metadata";
                    hint: "Edit the title, designer, shape, refractive index, gear, facet count and proportions.";
                    activated => { anchor.close_menu(); root.edit_metadata(); }
                    dismissed => { anchor.close_menu(); }
                }
                // The catalogue's cutting instructions as a Gem Cut Studio file
                // (`gui::library::local::export`); experimental, see the hint. Advanced only.
                if GuideModel.shows_advanced(): HeaderMenuItem {
                    icon: @image-url("../icons/save.svg");
                    text: "Export Gem Cut Studio File";
                    label: "Export as Gem Cut Studio File";
                    hint: "Save the cutting instructions as a Gem Cut Studio (.gcs) file. Experimental: it follows the published Gem Cut Studio 1.1 file description, and chiral designs are untested.";
                    activated => { anchor.close_menu(); root.export_gcs(); }
                    dismissed => { anchor.close_menu(); }
                }
                Rectangle { height: 9px; Rectangle { y: 4px; height: 1px; background: Theme.border-subtle; } }
                if !root.confirming_delete: HeaderMenuItem {
                    icon: @image-url("../icons/trash.svg");
                    text: "Delete This Design...";
                    label: "Delete This Design";
                    hint: "Delete this design. You are asked to confirm first.";
                    danger: true;
                    activated => { root.confirming_delete = true; }
                    dismissed => { anchor.close_menu(); }
                }
                if root.confirming_delete: Text {
                    text: "Delete this design for good?";
                    font-size: 11px;
                    color: Theme.accent-amber;
                    height: 24px;
                    vertical-alignment: center;
                    accessible-role: AccessibleRole.text;
                }
                if root.confirming_delete: HeaderMenuItem {
                    icon: @image-url("../icons/trash.svg");
                    text: "Yes, Delete This Design";
                    hint: "Delete this design now.";
                    danger: true;
                    activated => { anchor.close_menu(); root.delete_diagram(); }
                    dismissed => { anchor.close_menu(); }
                }
                if root.confirming_delete: HeaderMenuItem {
                    icon: @image-url("../icons/close.svg");
                    text: "No, Keep This Design";
                    hint: "Do not delete. The design stays in the library.";
                    activated => { anchor.close_menu(); }
                    dismissed => { anchor.close_menu(); }
                }
            }
        }
    }
}

// All metric chips (Shape, Gear, Facets, L/W, H/W, C/W, P/W, Vol/W3, R.I., Material) in one
// row. `DetailHeaderView` instantiates it twice: inline in the main row on a wide window, and on
// a wrapped line when `narrow` is set. `part` picks which chips a row shows.
component DesignChipsRow inherits HorizontalLayout {
    in property <DiagramDetailData> detail;
    in property <bool> is_local;
    in property <bool> editing_shape;
    in property <[string]> shape_options;
    in property <int> shape_current_index;
    // 0 = every chip in one row; 1 = Shape to H/W; 2 = C/W to Material. A narrow window shows
    // parts 1 and 2 as two rows, so no chip reaches past the window's edge.
    in property <int> part: 0;
    callback edit_shape_requested();
    callback shape_selected(string);
    callback shape_edit_cancelled();

    spacing: 4px;

    if root.part != 2 && (root.detail.shape != "" || root.is_local) && !root.editing_shape: Rectangle {
        height: 20px;
        background: Theme.bg-input;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-subtle;
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 2px;
            spacing: 3px;
            Rectangle {
                accessible-role: AccessibleRole.text;
                accessible-label: "Shape " + (root.detail.shape != "" ? root.detail.shape : "not set");
                accessible-description: "The outline of the stone, for example Round or Oval.";
                Tooltip { text: @markdown("The outline of the stone, for example Round or Oval."); }
                HorizontalLayout {
                    spacing: 3px;
                    Text { text: "Shape:"; font-size: 11px; color: Theme.text-muted; vertical-alignment: center; accessible-role: AccessibleRole.none; }
                    Text {
                        text: root.detail.shape != "" ? root.detail.shape : "Unset";
                        font-size: 11px;
                        font-weight: 600;
                        color: root.detail.shape != "" ? Theme.accent-cyan : Theme.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                        accessible-role: AccessibleRole.none;
                    }
                }
            }
            // Local designs only. An import leaves a shape it is not sure of unset (see
            // `classify_shape`), so the user fills it in or corrects it here.
            if root.is_local: HeaderAction {
                flat: true;
                size: 20px;
                glyph: 10px;
                icon: @image-url("../icons/pencil.svg");
                label: "Correct the Shape";
                hint: "Correct the shape that was detected automatically, or fill it in.";
                clicked => { root.edit_shape_requested(); }
            }
        }
    }

    if root.part != 2 && root.editing_shape: Rectangle {
        height: 24px;
        background: Theme.bg-input;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.accent-cyan;
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 2px;
            spacing: 3px;
            Text { text: "Shape:"; font-size: 11px; color: Theme.text-muted; vertical-alignment: center; }
            ComboBox {
                width: 110px;
                model: root.shape_options;
                current-index: root.shape_current_index;
                accessible-label: "Shape";
                accessible-description: "Pick the shape of this design.";
                selected(val) => { root.shape_selected(val); }
            }
            HeaderAction {
                flat: true;
                size: 20px;
                glyph: 9px;
                icon: @image-url("../icons/close.svg");
                label: "Cancel the Shape Change";
                hint: "Leave the shape as it was.";
                clicked => { root.shape_edit_cancelled(); }
            }
        }
    }

    if root.part != 2 && root.detail.gear != "": MetricChip {
        label: "Gear:";
        value: root.detail.gear;
        hint: "The index gear the design is cut on. See the glossary.";
        value_color: Theme.accent-cyan;
    }
    if root.part != 2 && root.detail.facets != "": MetricChip {
        label: "Facets:";
        value: root.detail.facets;
        hint: "How many facets the finished stone has.";
        value_color: Theme.accent-amber;
    }
    if root.part != 2 && root.detail.lw_ratio != "": MetricChip {
        label: "L/W:";
        value: root.detail.lw_ratio;
        hint: "Length divided by width. 1.0 is round or square.";
    }
    // H/W, C/W, P/W: derived with L/W and Volume (`apply_measured_metadata`). Hidden when
    // unknown, like every optional chip. Shown to 3 decimals (`format_proportion`); the stored
    // value is never rounded.
    if root.part != 2 && root.detail.hw_ratio != "": MetricChip {
        label: "H/W:";
        value: root.detail.hw_ratio;
        hint: "Total height divided by width.";
    }
    if root.part != 1 && root.detail.cw_ratio != "": MetricChip {
        label: "C/W:";
        value: root.detail.cw_ratio;
        hint: "Crown height divided by width.";
    }
    if root.part != 1 && root.detail.pw_ratio != "": MetricChip {
        label: "P/W:";
        value: root.detail.pw_ratio;
        hint: "Pavilion depth divided by width.";
    }
    if root.part != 1 && root.detail.volume != "": MetricChip {
        label: "Vol/W³:";
        value: root.detail.volume;
        hint: "Volume divided by width cubed: how much stone there is for its width.";
    }
    if root.part != 1 && root.detail.ri != "": MetricChip {
        label: "R.I.:";
        value: root.detail.ri;
        hint: "Refractive index: how strongly the material bends light. See the glossary.";
        value_color: Theme.accent-emerald;
    }
    // A guess, not a fact -- see `DiagramDetailData.material_guess`'s own doc
    // comment.
    if root.part != 1 && root.detail.material_guess != "": MetricChip {
        label: "Material:";
        value: root.detail.material_guess;
        hint: "A guess made from the design's data, not a recorded fact.";
        value_color: Theme.accent-amber;
    }
}

export component DetailHeaderView inherits Rectangle {
    in property <DiagramDetailData> detail: LibraryModel.current_detail;
    // Edit mode's title/chips collapse into one row (see this component's
    // `if root.effective_compact` branch below) so the tier table gets the vertical
    // room the full-height header would otherwise take -- see `app.slint`'s Edit-mode
    // layout doc comment.
    in property <bool> compact: false;
    // The window's own current height (`MainWindow.height`, bound by `app.slint`),
    // feeding `user_collapsed`'s default below. A live binding while untouched (a
    // resize keeps the default in sync), but see that property's own doc comment for
    // why an explicit toggle click permanently overrides it.
    in property <length> window_height: 1080px;
    // Collapsed by default on a window shorter than 900 px. It is session-only and not
    // persisted, since no settings property fits this component's model surface. The chevron
    // (below) replaces the default for the rest of the session. The default layout already fits
    // one row; the collapsed form is the extra minimum-height option.
    in-out property <bool> user_collapsed: root.window_height < 900px;
    // What the two top-level `if` branches below actually gate on: either the
    // Edit-mode-forced `compact`, or the user's own collapse choice.
    property <bool> effective_compact: root.compact || root.user_collapsed;
    // The window's width (`MainWindow.width`, bound by `app.slint`), used instead of
    // `root.width`: this component's width comes from its content, so reading it back into
    // `narrow` would be a binding loop. See "Sizing notes" in `app.slint`.
    in property <length> window_width: 1600px;
    // Below this window width, the metadata chips no longer fit on the same row as
    // the title/designer/action buttons and wrap to their own second line instead
    // (see `DesignChipsRow`'s two instantiations below) -- never a
    // permanently-reserved second row, since the `if` below contributes zero height
    // while wide. The threshold is generous (a window, not this column alone) since
    // `window_width` still includes the library panel/gaps/padding this column
    // doesn't get; a bit of early wrapping is preferable to a binding loop.
    // With the places segment on the row's right end, the chips need a window wider than 2000 px.
    property <bool> narrow: root.window_width < 2000px;
    // Below this the chips split over two rows (`DesignChipsRow.part`).
    property <bool> very_narrow: root.window_width < 1100px;
    // Below 800px the one-line header also leaves out L/W (the Shape chip says nearly as much),
    // so R.I. still fits at the 720 px minimum window width.
    property <bool> tiny: root.window_width < 800px;
    // Shape picker's option list and which entry matches `detail.shape` (-1 for
    // unclassified) -- see `library::build_shape_picker_options`'s doc comment.
    // Local designs only: the pencil below is gated on `detail.is_local`.
    in property <[string]> shape_options: LibraryModel.shape_picker_options;
    in property <int> shape_current_index: LibraryModel.shape_picker_current_index;

    // The places segment (Live Render, Edit, Cutting Instructions, Files & Downloads) sits at the
    // header's right end. `active_tab` and `render_view_tab` are two-way bound to `MainWindow`'s own
    // properties of the same name (see `app.slint`); the `*_changed` callbacks are forwarded.
    in-out property <int> active_tab: 0;
    callback active_tab_changed(int);
    in-out property <int> render_view_tab: 0;
    callback render_view_tab_changed(int);

    callback open_url(string);
    open_url(url) => { LibraryModel.open_diagram_url(url); }
    callback copy_url(string);
    copy_url(url) => { LibraryModel.copy_text(url); }
    callback copy_title(string);
    copy_title(title) => { LibraryModel.copy_text(title); }
    // Organize: rename/delete the selected diagram, export a reconstructed `.asc`
    // when it has no original file attached (see `apps/pleochroma-cut`'s
    // `gui::library` module).
    callback rename_diagram(string);
    rename_diagram(name) => { LibraryModel.rename_diagram(name); }
    callback set_shape(string);
    set_shape(shape) => { LibraryModel.set_shape(shape); }
    callback delete_diagram();
    delete_diagram => { LibraryModel.delete_diagram(); }
    callback export_asc();
    export_asc => { LibraryModel.export_asc(); }
    callback export_gcs();
    export_gcs => { LibraryModel.export_gcs(); }
    // Opens the metadata editor modal (`metadata_editor_dialog.slint`). It is hosted at
    // `app.slint`'s root because a modal backdrop needs the full window, not this content-sized
    // component. Local designs only; see "Edit Metadata" in `DetailActions`.
    callback edit_metadata();
    edit_metadata => { LibraryModel.metadata_editor_open = true; }

    // Local, transient UI state for the inline rename/delete-confirm/shape-edit
    // affordances below -- reset whenever the selected diagram changes.
    property <bool> renaming: false;
    property <string> rename_draft: "";
    property <bool> confirming_delete: false;
    property <bool> editing_shape: false;
    changed detail => {
        root.renaming = false;
        root.confirming_delete = false;
        root.editing_shape = false;
    }

    background: Theme.bg-card;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;
    vertical-stretch: 0;
    // Above the rows below it, so the "..." menu opens over them.
    z: 5;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: "Design Details";

    // Layout parent for the two conditional branches. `if` children of a plain `Rectangle`
    // add no layout constraints, so the header would get no height. A `VerticalLayout` takes
    // them from whichever branch is shown.
    VerticalLayout {
        // Edit-mode-forced (or user-collapsed) one-line form: title + up to five
        // chips + the icon action cluster, 40px tall. The catalogue tab pills live
        // in `app.slint`'s own shared tab/view-pill row -- this header does not
        // drive `active_tab` at all.
        if root.effective_compact: HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            height: 40px;
            spacing: 10px;

            // Expand chevron -- only interactive/shown when this collapse was the
            // USER's own choice (`!root.compact`): while Edit mode forces `compact`,
            // there is no expanded form to go back to from here (see `app.slint`'s own
            // `compact: root.render_view_tab == 1 && EditorModel.enabled` binding).
            if !root.compact: VerticalLayout {
                alignment: center;
                HeaderAction {
                    flat: true;
                    size: 20px;
                    glyph: 10px;
                    icon: @image-url("../icons/chevron-right.svg");
                    label: "Design Header";
                    hint: "Show the full design header, with the designer and every figure.";
                    expandable: true;
                    expanded: false;
                    clicked => { root.user_collapsed = false; }
                }
            }

            if root.detail.title != "": Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: root.detail.title;
                font-size: 14px;
                font-weight: 700;
                color: Theme.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
            // Compact mode only ever runs while a design is being edited (see
            // `app.slint`'s `compact: root.render_view_tab == 1 && EditorModel.enabled`
            // binding), so an empty catalogue title here means "an unsaved or
            // not-yet-catalogued design", not "nothing selected" -- the editor's own
            // label (falling back to its own "Untitled design" default) is the
            // accurate wording, not the catalogue's browsing prompt.
            if root.detail.title == "": Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: EditorModel.enabled ? EditorModel.design_label : "Select a diagram from catalog";
                font-size: 14px;
                font-weight: 700;
                color: Theme.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }

            // Condensed metric chips: the same data as `DesignChipsRow` below, in a smaller font
            // so the row fits 40px. Only a subset, since this branch cannot wrap.
            // The chips leave as the window narrows, so the places segment stays whole and the title
            // elides first (about 1000, 1100 and 1500 px).
            if root.detail.shape != "" && root.window_width >= 1000px: CompactChip {
                label: "Shape:";
                value: root.detail.shape;
                hint: "The outline of the stone, for example Round or Oval.";
                value_color: Theme.accent-cyan;
            }
            if root.detail.gear != "" && root.window_width >= 1100px: CompactChip {
                label: "Gear:";
                value: root.detail.gear;
                hint: "The index gear the design is cut on. See the glossary.";
                value_color: Theme.accent-cyan;
            }
            if root.detail.facets != "" && root.window_width >= 1100px: CompactChip {
                label: "Facets:";
                value: root.detail.facets;
                hint: "How many facets the finished stone has.";
                value_color: Theme.accent-amber;
            }
            if root.detail.lw_ratio != "" && root.window_width >= 1500px: CompactChip {
                label: "L/W:";
                value: root.detail.lw_ratio;
                hint: "Length divided by width. 1.0 is round or square.";
            }
            if root.detail.ri != "" && root.window_width >= 1100px: CompactChip {
                label: "R.I.:";
                value: root.detail.ri;
                hint: "Refractive index: how strongly the material bends light. See the glossary.";
                value_color: Theme.accent-emerald;
            }
            // A guess, not a fact (see `DiagramDetailData.material_guess`). Left out below
            // ~1100 px (`very_narrow`): this one-line header cannot wrap, and the full header
            // shows the chip in its own row there.
            if root.detail.material_guess != "" && root.window_width >= 1500px: CompactChip {
                label: "Material:";
                value: root.detail.material_guess;
                hint: "A guess made from the design's data, not a recorded fact.";
                value_color: Theme.accent-amber;
                italic: true;
            }

            Rectangle { horizontal-stretch: 1; }

            VerticalLayout {
                alignment: center;
                PlacesSegment {
                    compact: root.window_width < 1200px;
                    tight: root.window_width < 800px;
                    active_tab <=> root.active_tab;
                    active_tab_changed(v) => { root.active_tab_changed(v); }
                    render_view_tab <=> root.render_view_tab;
                    render_view_tab_changed(v) => { root.render_view_tab_changed(v); }
                }
            }

            // The right-hand action cluster, compacted into the same row instead of
            // dropped -- see this component's own `compact` doc comment.
            if root.detail.title != "": VerticalLayout {
                alignment: center;
                DetailActions {
                    detail: root.detail;
                    confirming_delete <=> root.confirming_delete;
                    open_url(url) => { root.open_url(url); }
                    copy_url(url) => { root.copy_url(url); }
                    export_asc => { root.export_asc(); }
                    export_gcs => { root.export_gcs(); }
                    delete_diagram => { root.delete_diagram(); }
                }
            }
        }

        // DEFAULT layout: one row (title, designer, chips, action buttons), independent of
        // `user_collapsed`. Chips wrap to their own line only below `root.narrow` (1300 px
        // window width); see `DesignChipsRow` above.
        if !root.effective_compact: VerticalLayout {
            // Never shorter than the 40px one-line form above, so the tab row below does not
            // jump when Edit (compact) and Live Render (this branch) swap.
            min-height: 40px;
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 5px;
            padding-bottom: 5px;
            spacing: 4px;

            HorizontalLayout {
                spacing: 8px;
                alignment: space-between;

                // Left cluster: collapse chevron, title (+ rename), designer,
                // competition badge, and -- while not `narrow` -- the chips inline.
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    // Gives way first: the title and the designer elide before the places segment
                    // on the right loses any width.
                    horizontal-stretch: 1;
                    min-width: 0px;

                    // Collapse chevron -- the other half of the expand chevron in the
                    // `effective_compact` branch above; always shown here since this
                    // branch only renders at all when NOT already collapsed.
                    // Left out below 800 px: the row has no room for it beside the places segment.
                    if !root.tiny: VerticalLayout {
                        alignment: center;
                        HeaderAction {
                            flat: true;
                            size: 20px;
                            glyph: 10px;
                            icon: @image-url("../icons/chevron-down.svg");
                            label: "Design Header";
                            hint: "Collapse the design header to one line.";
                            expandable: true;
                            expanded: true;
                            clicked => { root.user_collapsed = true; }
                        }
                    }

                    if !root.renaming: Text {
                        // A design can be under edit (Live Render/Diagram tab, so
                        // this header still shows) with no catalogue row of its own --
                        // show the editor's own label rather than a "go pick
                        // something" prompt that doesn't apply here.
                        text: root.detail.title != "" ? root.detail.title : (EditorModel.enabled ? EditorModel.design_label : "Select a diagram from catalog");
                        min-width: 0px;
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.renaming: LineEdit {
                        width: 200px;
                        text <=> root.rename_draft;
                        accessible-label: "Design Title";
                        accessible-description: "Type the new title, then press Enter to save it.";
                        accepted => {
                            root.rename_diagram(root.rename_draft);
                            root.renaming = false;
                        }
                    }

                    if root.detail.title != "" && !root.renaming: VerticalLayout {
                        alignment: center;
                        HeaderAction {
                            flat: true;
                            size: 20px;
                            glyph: 11px;
                            icon: @image-url("../icons/pencil.svg");
                            label: "Rename This Design";
                            hint: "Change the title of this design.";
                            clicked => {
                                root.rename_draft = root.detail.title;
                                root.renaming = true;
                            }
                        }
                    }

                    if root.renaming: HorizontalLayout {
                        spacing: 4px;
                        VerticalLayout {
                            alignment: center;
                            HeaderAction {
                                flat: true;
                                size: 20px;
                                glyph: 11px;
                                icon: @image-url("../icons/check.svg");
                                ink: Theme.accent-emerald;
                                label: "Save the New Title";
                                hint: "Save the new title.";
                                clicked => {
                                    root.rename_diagram(root.rename_draft);
                                    root.renaming = false;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            HeaderAction {
                                flat: true;
                                size: 20px;
                                glyph: 11px;
                                icon: @image-url("../icons/close.svg");
                                label: "Cancel the Rename";
                                hint: "Keep the old title.";
                                clicked => { root.renaming = false; }
                            }
                        }
                    }

                    // Designer, small and muted, after the title so the row stays one line.
                    Text {
                        text: root.detail.designer != "" ? "by " + root.detail.designer : "";
                        min-width: 0px;
                        font-size: 11px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.detail.competition != "" && root.detail.competition != "0": Rectangle {
                        background: Theme.badge-orange-bg;
                        border-radius: 4px;
                        height: 18px;
                        accessible-role: AccessibleRole.text;
                        accessible-label: "Competition Design";
                        accessible-description: "The catalogue marks this design as a competition design.";
                        Tooltip { text: @markdown("The catalogue marks this design as a competition design."); }
                        HorizontalLayout {
                            padding-left: 6px; padding-right: 6px; spacing: 4px;
                            // Centred by a layout of its own: a fixed-size Image in the row sits at
                            // the top of its cell.
                            VerticalLayout {
                                alignment: center;
                                Image { source: @image-url("../icons/trophy.svg"); colorize: Theme.badge-orange-text; width: 10px; height: 10px; }
                            }
                            Text { text: "Competition Design"; font-size: 9px; font-weight: 700; color: Theme.badge-orange-text; vertical-alignment: center; accessible-role: AccessibleRole.none; }
                        }
                    }

                    if !root.narrow && root.detail.title != "": DesignChipsRow {
                        detail: root.detail;
                        is_local: root.detail.is_local;
                        editing_shape: root.editing_shape;
                        shape_options: root.shape_options;
                        shape_current_index: root.shape_current_index;
                        edit_shape_requested => { root.editing_shape = true; }
                        shape_selected(val) => { root.set_shape(val); root.editing_shape = false; }
                        shape_edit_cancelled => { root.editing_shape = false; }
                    }
                }

                // Right cluster: icon-only action buttons, 28px, sharing the row with the title
                // and chips. The "?" at the end opens the manual page on the design details.
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    VerticalLayout {
                        alignment: center;
                        PlacesSegment {
                            compact: root.window_width < 1200px;
                            tight: root.window_width < 800px;
                            active_tab <=> root.active_tab;
                            active_tab_changed(v) => { root.active_tab_changed(v); }
                            render_view_tab <=> root.render_view_tab;
                            render_view_tab_changed(v) => { root.render_view_tab_changed(v); }
                        }
                    }

                    if root.detail.title != "": DetailActions {
                        detail: root.detail;
                        with_metadata: true;
                        confirming_delete <=> root.confirming_delete;
                        open_url(url) => { root.open_url(url); }
                        copy_url(url) => { root.copy_url(url); }
                        export_asc => { root.export_asc(); }
                        export_gcs => { root.export_gcs(); }
                        edit_metadata => { root.edit_metadata(); }
                        delete_diagram => { root.delete_diagram(); }
                    }

                    VerticalLayout {
                        alignment: center;
                        HelpButton {
                            topic: HelpTopics.library-details;
                            hint: "Open the manual page on selecting and inspecting a design";
                        }
                    }
                }
            }

            // Wrapped chips -- only rendered (and only then costing any height) below
            // `root.narrow`; see `DesignChipsRow`'s own doc comment.
            if root.narrow && root.detail.title != "": DesignChipsRow {
                detail: root.detail;
                is_local: root.detail.is_local;
                editing_shape: root.editing_shape;
                shape_options: root.shape_options;
                shape_current_index: root.shape_current_index;
                part: root.very_narrow ? 1 : 0;
                edit_shape_requested => { root.editing_shape = true; }
                shape_selected(val) => { root.set_shape(val); root.editing_shape = false; }
                shape_edit_cancelled => { root.editing_shape = false; }
            }
            // Below ~1100 px the nine chips no longer fit one row: the rest go on a third line.
            if root.very_narrow && root.detail.title != "": DesignChipsRow {
                detail: root.detail;
                is_local: root.detail.is_local;
                editing_shape: root.editing_shape;
                shape_options: root.shape_options;
                shape_current_index: root.shape_current_index;
                part: 2;
            }
        }
    }
}
