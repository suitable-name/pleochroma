import { Theme } from "../../theme.slint";
import { ViewportModel } from "../../models/viewport.slint";
import { BaselineModel } from "../../models/baseline.slint";
import { LibraryModel } from "../../models/library.slint";
import { TrialsModel } from "../../models/trials.slint";
import { GuideModel } from "../../models/guide.slint";
import { EditorModel } from "../../models/editor.slint";
import { TiltModel } from "../../models/tilt.slint";
import { TiltWindows } from "../../shared/tilt_windows.slint";
import { ExportModel } from "../../models/export.slint";
import { KitFigure, KitFigures } from "../kit/kit.slint";
import { FiguresHelp } from "../gem_viewport/figures_help.slint";

// The Edit viewport's figures card: the same `KitFigures` and the same figure order as Live Render's
// (`gem_viewport/live_figures.slint`: brilliance, fire, scintillation, windowing, extinction, then
// Contrast, yield, warnings and the tilt averages), here with the change since the Baseline beside every
// figure (`BaselineModel.cells`, which Rust already orders that way). "Keep as Trial" is its action.
//
// Open by default; folded to one line when `ViewportModel.figures_folded` says so (the same saved
// choice as Live Render's card) and by itself on a narrow view (`narrow`, not remembered) and on
// a view too short for the open card (`room`: in the narrow stack the view is 140-260 px tall,
// and the open card lay over the Cut slider). The two states are two instances (`if`), as in
// `LiveFigures`.
//
// The Simple interface shows the figures without their changes and without Keep as Trial.
export component EditFigures inherits Rectangle {
    in property <bool> narrow: false;
    // The height the viewport has for the card, from the card's top to the viewport's bottom row.
    in property <length> room: 10000px;
    // Where the viewport's room for the popover ends (window coordinates): its right edge less the
    // margin, and the top of its bottom row.
    in property <length> view_right: 0px;
    in property <length> view_bottom: 0px;

    property <bool> wide_folded: ViewportModel.figures_folded;
    property <bool> narrow_open: false;
    property <int> n: BaselineModel.cells.length;
    property <bool> deltas: GuideModel.shows_advanced();
    // The open card's height, worked out from its rows and not read from the card: the card's
    // own height changes when it folds, and reading it here would be a binding loop. 41 px of
    // padding and header, 23 px a row (the last without its 3 px gap), 7 px for each of the two
    // dividers and 15 px for the tilt caption (`KitFigures`).
    property <length> open_height: 38px + 23px * max(5, min(root.n, 11))
        + (root.n >= 8 ? 14px : 0px) + (root.has_tilt ? 15px : 0px);
    // Starts folded: the view is narrow, or too short to show the open card.
    property <bool> tight: root.narrow || root.room < root.open_height;

    // A cell as a figure: `trend` 1 better, -1 worse, 0 about the same.
    pure function fig(i: int) -> KitFigure {
        return {
            name: BaselineModel.cells[i].name,
            value: BaselineModel.cells[i].value,
            delta: BaselineModel.cells[i].delta,
            part: 0.0,
            ink: Theme.text-secondary,
            trend: BaselineModel.cells[i].tone == 1 ? 1 : (BaselineModel.cells[i].tone == 2 ? -1 : 0),
            flag: BaselineModel.cells[i].flag,
        };
    }
    // The same with the short name, for the folded line.
    pure function sfig(i: int) -> KitFigure {
        return {
            name: BaselineModel.cells[i].short_label,
            value: BaselineModel.cells[i].value,
            delta: BaselineModel.cells[i].delta,
            part: 0.0,
            ink: Theme.text-secondary,
            trend: BaselineModel.cells[i].tone == 1 ? 1 : (BaselineModel.cells[i].tone == 2 ? -1 : 0),
            flag: BaselineModel.cells[i].flag,
        };
    }
    pure function blank(name: string) -> KitFigure {
        return { name: name, value: "—", delta: "", part: 0.0, ink: Theme.text-secondary, trend: 0, flag: false };
    }

    // Nothing scored yet: the five names with a dash.
    property <[KitFigure]> placeholder: [blank("Brilliance"), blank("Fire"), blank("Scintillation"), blank("Windowing"), blank("Extinction")];
    property <[KitFigure]> open_list: root.n >= 11 ? [fig(0), fig(1), fig(2), fig(3), fig(4), fig(5), fig(6), fig(7), fig(8), fig(9), fig(10)]
        : root.n == 10 ? [fig(0), fig(1), fig(2), fig(3), fig(4), fig(5), fig(6), fig(7), fig(8), fig(9)]
        : root.n == 9 ? [fig(0), fig(1), fig(2), fig(3), fig(4), fig(5), fig(6), fig(7), fig(8)]
        : root.n == 8 ? [fig(0), fig(1), fig(2), fig(3), fig(4), fig(5), fig(6), fig(7)]
        : root.n == 7 ? [fig(0), fig(1), fig(2), fig(3), fig(4), fig(5), fig(6)]
        : root.n == 6 ? [fig(0), fig(1), fig(2), fig(3), fig(4), fig(5)]
        : root.n == 5 ? [fig(0), fig(1), fig(2), fig(3), fig(4)]
        : root.placeholder;
    // Folded, the line names the first three, in Live Render's folded order: Bril, Wind, Ext.
    property <[KitFigure]> folded_list: root.n >= 5 ? [sfig(0), sfig(3), sfig(4), sfig(1), sfig(2)] : [blank("Bril"), blank("Wind"), blank("Ext"), blank("Fire"), blank("Scint")];

    // Contrast sits right after the five (cell 5) when the design's zones were measured.
    property <bool> has_contrast: root.n >= 6 && BaselineModel.cells[5].name == "Contrast";
    // The three tilt averages are the last three cells (Rust puts them there); a caption names their window,
    // since the 82 px name column cannot.
    property <bool> has_tilt: root.n >= 8 && BaselineModel.cells[root.n - 1].name == "Tilt Extinction";
    property <string> tilt_caption: "Tilt average " + TiltWindows.displayed;
    // What a click copies: the five numbers with their names, and Contrast when it is measured.
    property <string> copy_text: root.n >= 5
        ? (fig(0).name + " " + fig(0).value + "\n" + fig(1).name + " " + fig(1).value + "\n" + fig(2).name + " " + fig(2).value + "\n" + fig(3).name + " " + fig(3).value + "\n" + fig(4).name + " " + fig(4).value
            + (root.has_contrast ? "\n" + fig(5).name + " " + fig(5).value : ""))
        : "";

    width: figures_lay.preferred-width;
    height: figures_lay.preferred-height;
    opacity: BaselineModel.stale ? 0.7 : 1.0;

    Tooltip { text: @markdown("Click to copy these figures. Contrast is how finely the viewer's own shadow is broken up across the face, 0 to 100; more is better. Beside each figure is its change since the Baseline: a triangle up is better, a triangle down is worse, a dash is about the same. Within the noise threshold counts as the same. See the glossary."); }

    figures_lay := HorizontalLayout {
        alignment: start;
        if root.tight: KitFigures {
            title: BaselineModel.has_baseline ? "VS BASELINE" : "FIGURES";
            figures: !root.narrow_open ? root.folded_list : root.open_list;
            folded: !root.narrow_open;
            show_bars: false;
            show_deltas: root.deltas && BaselineModel.has_baseline;
            divider_a: root.n >= 8 ? (root.has_contrast ? 5 : 4) : -1;
            divider_b: root.has_tilt ? root.n - 4 : (root.n >= 8 ? (root.has_contrast ? 7 : 6) : -1);
            caption_after: root.has_tilt ? root.n - 4 : -1;
            caption_text: root.tilt_caption;
            show_help: true;
            help => { ViewportModel.figures_help_open = !ViewportModel.figures_help_open; }
            action_text: root.deltas && GuideModel.allows_history() && EditorModel.enabled ? "Keep as Trial" : "";
            copy => { LibraryModel.copy_text(root.copy_text); }
            action => { TrialsModel.keep_trial(); }
            fold_toggled(f) => { root.narrow_open = !f; }
        }
        if !root.tight: KitFigures {
            title: BaselineModel.has_baseline ? "VS BASELINE" : "FIGURES";
            figures: root.wide_folded ? root.folded_list : root.open_list;
            folded: root.wide_folded;
            show_bars: false;
            show_deltas: root.deltas && BaselineModel.has_baseline;
            divider_a: root.n >= 8 ? (root.has_contrast ? 5 : 4) : -1;
            divider_b: root.has_tilt ? root.n - 4 : (root.n >= 8 ? (root.has_contrast ? 7 : 6) : -1);
            caption_after: root.has_tilt ? root.n - 4 : -1;
            caption_text: root.tilt_caption;
            show_help: true;
            help => { ViewportModel.figures_help_open = !ViewportModel.figures_help_open; }
            action_text: root.deltas && GuideModel.allows_history() && EditorModel.enabled ? "Keep as Trial" : "";
            copy => { LibraryModel.copy_text(root.copy_text); }
            action => { TrialsModel.keep_trial(); }
            fold_toggled(f) => {
                root.wide_folded = f;
                ViewportModel.figures_folded_set(f);
            }
        }
    }

    // The same popover as Live Render's "?", beside the card: its right edge plus 12 px, the same top.
    if ViewportModel.figures_help_open && !TiltModel.dialog_open && !ExportModel.is_open: FiguresHelp {
        x: root.width + 12px;
        y: 0px;
        width: min(460px, max(280px, root.view_right - root.absolute-position.x - root.width - 12px));
        height: min(self.content_height, max(200px, root.view_bottom - root.absolute-position.y));
    }

    // The guide's Keep Trials lesson outlines the card.
    if GuideModel.highlight_target == "keep_trial_button": Rectangle {
        border-width: 2px;
        border-color: Theme.accent-cyan;
        border-radius: 10px;
    }
}
