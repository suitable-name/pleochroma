import { Slider } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { SolidPreviewModel } from "../models/solid_preview.slint";
import { ViewportModel } from "../models/viewport.slint";
import { EditorModel } from "../models/editor.slint";
// The Tilt Curve dialog is mounted at window size in `GlobalDialogsOverlay`
// (`components/app/global_dialogs.slint`). `TiltModel.dialog_open` disables the
// drag area below while the chart is open.
import { TiltModel } from "../models/tilt.slint";
// The toolbar: mode and cut controls, camera poses, tool pills and status strip.
import { SolidViewportToolbar } from "solid_viewport/toolbar.slint";
// The pictures (solid, traced, combined layers, Diagram), the refusal card and the placeholder.
import { SolidViewportLayers } from "solid_viewport/layers.slint";
// The angle/depth/index drag handles on the selected facet, and the hint line under
// the toolbar -- see `ManipulateModel` (`models/manipulate.slint`).
import { ManipulateModel } from "../models/manipulate.slint";
import { ManipulateOverlay, SliceLineOverlay } from "solid_viewport/manipulate_overlay.slint";
import { ManipulateHintBar } from "solid_viewport/hint_bar.slint";
// The crystal axis drawn over the stone, with its drag handle(s) -- see `CrystalAxisModel`
// (`models/crystal_axis.slint`) and `gui::editor::manipulate::crystal_axis_overlay`.
import { CrystalAxisModel } from "../models/crystal_axis.slint";
import { CrystalAxisOverlay, CrystalAxisWatcher } from "solid_viewport/crystal_axis_overlay.slint";
import { SurfaceModel } from "../models/surface.slint";
import { SurfaceFinishOverlay, SurfaceFinishWatcher } from "solid_viewport/surface_finish_overlay.slint";
// The open tutorial step may outline the picture (`highlight_target == "solid_viewport"`).
import { GuideModel } from "../models/guide.slint";

// The Edit tab's solid-inspection viewport: a flat-shaded software render of the
// current design's solid, shown as a static image after Solve.
//
// Ray-Traced (4) shares the traced image, picking, camera and gesture layers.
// `view_mode` picks the picture: `0` (Solid) shows `image`; `1` (Path-traced) shows
// `render_image` alone; `2` (Solid + Path-Traced) and `5` (Solid + Ray-Traced) show the
// selected tracer's `render_image` with `edges_image` on top (the transparent-fill,
// opaque-edge layer of `gui::solid_preview::edges_layer`). `3` (Diagram) shows
// `diagram_image`, a fixed orthographic crown/pavilion/profile diagram. In Diagram mode
// drag and scroll pan and zoom that image (`diagram_pan_*`, `diagram_zoom`), and hover
// and click use their own `diagram_facet_hover`/`diagram_facet_click` against the
// diagram's pick buffer, whose layout differs from the Solid rasterizer's.
export component SolidViewportView inherits Rectangle {
    vertical-stretch: 1;
    min-height: 0px;
    min-width: 0px;
    preferred-height: 480px;
    clip: true;

    // Diagram mode (view_mode 3) shows its own hover text; every other mode keeps the
    // Solid rasterizer's.
    property <string> hover_text: SolidPreviewModel.view_mode == 3 ? SolidPreviewModel.diagram_hover_text : SolidPreviewModel.hover_text;

    property <bool> is_dragging: false;
    property <length> last_mouse_x;
    property <length> last_mouse_y;
    // Accumulated |dx| + |dy| since the last pointer-down, in logical pixels --
    // reset on `down` and grown on every `moved` while dragging. `clicked` only
    // forwards to `facet_click`/`diagram_facet_click` below this threshold, so an
    // orbit drag that happens to release over a facet doesn't also re-select it.
    property <float> drag_distance: 0;
    // `true` from a left-press that grabbed a drag handle (`ManipulateModel.
    // drag_begin` granted it) until the button is released or Escape cancels it.
    // While set, pointer moves drive the handle drag instead of the orbit.
    property <bool> handle_dragging: false;
    // `true` from a left-press that started a Slice-mode line (`ManipulateModel.
    // slice_begin`) until the button is released or Escape drops the line. While set,
    // pointer moves stretch the line: no orbit, no hover pick, no facet click.
    property <bool> slice_dragging: false;
    // `true` from a left-press that grabbed a crystal-axis handle (`CrystalAxisModel.drag_begin`
    // granted it) until the button is released or Escape cancels it. Like `handle_dragging`,
    // pointer moves then drive the axis instead of the orbit.
    property <bool> axis_dragging: false;
    // Set by a handle press and left set until the next press elsewhere: the
    // release after a handle drag (or an Escape cancel) ends in a `clicked` that
    // must not also pick whatever facet ends up under the pointer.
    property <bool> swallow_click: false;

    // Diagram mode's own zoom and pan. The diagram has no shared orbit camera, so this
    // is a plain scale and translate of the whole three-panel image; `diagram_image`
    // itself is unchanged. `1.0` and `0px` mean no zoom and no pan. Reset by the
    // "Reset View" pill, shown only in Diagram mode.
    property <float> diagram_zoom: 1.0;
    property <length> diagram_pan_x: 0px;
    property <length> diagram_pan_y: 0px;
    // Maps a viewport-local mouse position back to the unzoomed logical-pixel space that
    // `diagram_facet_hover`/`diagram_facet_click` expect (the point at zoom 1.0 and no pan),
    // so the Rust callbacks in `gui::solid_preview::diagram_wiring` need no zoom awareness.
    function diagram_unzoomed_x(mouse_x: length) -> length {
        return (mouse_x - root.diagram_pan_x) / root.diagram_zoom;
    }
    function diagram_unzoomed_y(mouse_y: length) -> length {
        return (mouse_y - root.diagram_pan_y) / root.diagram_zoom;
    }
    // The pointer coordinates the drag handles (`ManipulateModel`) work in: the unzoomed
    // ones in the Diagram view -- where the handle positions are unzoomed too and
    // `ManipulateOverlay` maps them back when it draws -- the raw ones everywhere else.
    function manip_x(mouse_x: length) -> length {
        return SolidPreviewModel.view_mode == 3 ? root.diagram_unzoomed_x(mouse_x) : mouse_x;
    }
    function manip_y(mouse_y: length) -> length {
        return SolidPreviewModel.view_mode == 3 ? root.diagram_unzoomed_y(mouse_y) : mouse_y;
    }
    // Rust sizes the handle hit radius by the zoom (a marker keeps its size on screen).
    changed diagram_zoom => {
        ManipulateModel.view_zoom = root.diagram_zoom;
    }
    // Keeps a zoomed-in diagram from being dragged entirely off-screen -- clamps
    // to the extra width/height `diagram_zoom` adds beyond the viewport's own
    // size, on each side.
    function clamp_diagram_pan(value: length, extent: length, zoom: float) -> length {
        return max(-(extent * (zoom - 1)), min(extent * (zoom - 1), value));
    }

    background: Theme.viewport-bg;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    // Slint cannot report a widget's rendered size to Rust (see the `width`/`height` docs of
    // `bridge::render_thread::context::RenderContext`), so the layout size is pushed into the
    // global on every change. `refresh_viewport` then sizes the rasterizer to the logical size,
    // never the render resolution.
    //
    // A resize must redraw: otherwise the old image is rescaled and the pick buffer, still sized
    // to the old frame, misaligns with the cursor. `resize_pulse` bumps on every size change; the
    // 50 ms timer below calls `viewport_resized()` on each tick that saw a change, so a drag
    // redraws at most every 50 ms. The Rust side is `on_viewport_resized`, which calls
    // `render::camera_lighting::resubmit_at_current_pose`.
    property <int> resize_pulse: 0;
    property <int> resize_pulse_seen: 0;
    changed width => { SolidPreviewModel.viewport_width = self.width; root.resize_pulse += 1; }
    changed height => { SolidPreviewModel.viewport_height = self.height; root.resize_pulse += 1; }
    // Also pushed on mount: a freshly mounted instance (a view-mode switch remounts it) never
    // fires the `changed` handlers above for its own first size.
    init => {
        SolidPreviewModel.viewport_width = self.width;
        SolidPreviewModel.viewport_height = self.height;
        ManipulateModel.view_zoom = root.diagram_zoom;
        // Always re-plan at the settled size: the tab switch's own re-plan can run before a
        // fresh viewport is laid out, which would leave the raster at the previous size.
        root.resize_pulse += 1;
    }

    // A global's property cannot get a `changed` handler outside its own file, so the view
    // mode is mirrored here. A mode switch clears both hover texts: each names facets of the
    // old mode's own facet space.
    property <int> hover_view_mode: SolidPreviewModel.view_mode;
    changed hover_view_mode => {
        SolidPreviewModel.hover_text = "";
        SolidPreviewModel.diagram_hover_text = "";
    }
    // The picture on screen, mirrored like `hover_view_mode` above. A new frame under a resting
    // pointer (a replan after a handle drag, a solve, an undo) re-reads the hover text from its
    // own tables.
    property <image> hover_image: SolidPreviewModel.view_mode == 3 ? SolidPreviewModel.diagram_image : SolidPreviewModel.image;
    changed hover_image => {
        root.refresh_hover();
    }
    function refresh_hover() {
        if (!drag_area.has-hover || root.is_dragging || root.handle_dragging || root.axis_dragging || root.slice_dragging) {
            return;
        }
        if (SolidPreviewModel.view_mode == 3) {
            SolidPreviewModel.diagram_facet_hover(root.diagram_unzoomed_x(drag_area.mouse-x), root.diagram_unzoomed_y(drag_area.mouse-y));
        } else {
            SolidPreviewModel.facet_hover(drag_area.mouse-x, drag_area.mouse-y);
        }
    }
    // A different enlarged panel is a different picture, so its zoom and pan reset.
    property <int> seen_enlarged_panel: SolidPreviewModel.diagram_enlarged_panel;
    changed seen_enlarged_panel => {
        root.diagram_zoom = 1.0;
        root.diagram_pan_x = 0px;
        root.diagram_pan_y = 0px;
    }
    Timer {
        interval: 50ms;
        running: true;
        triggered => {
            if (root.resize_pulse != root.resize_pulse_seen) {
                root.resize_pulse_seen = root.resize_pulse;
                SolidPreviewModel.viewport_resized();
            }
        }
    }

    // Steps the tier selection by `delta`, clamped to the tiers (with none selected, a downward
    // step picks the first tier and an upward one the last), so a cutter can step through tiers
    // without moving focus to the tier table.
    // Writes `selected_tier_index` directly: `changed selected_tier_index` in
    // `models/editor.slint` reseeds the inspector and the 3D highlight.
    function step_selection(delta: int) {
        if EditorModel.tiers.length <= 0 {
            return;
        }
        if EditorModel.selected_tier_index < 0 {
            EditorModel.selected_tier_index = delta >= 0 ? 0 : EditorModel.tiers.length - 1;
            return;
        }
        EditorModel.selected_tier_index = Math.max(0, Math.min(EditorModel.tiers.length - 1, EditorModel.selected_tier_index + delta));
    }
    // Ends a pointer gesture still flagged as running once the pointer state says none can
    // be (an orbit, a handle drag, a slice line). Cancels as Escape does. A no-op after a
    // normal `up`, which has already cleared the flags.
    function end_lost_gestures() {
        if (root.handle_dragging) {
            root.handle_dragging = false;
            ManipulateModel.drag_cancel();
        }
        if (root.slice_dragging) {
            root.slice_dragging = false;
            ManipulateModel.slice_cancel();
        }
        if (root.axis_dragging) {
            root.axis_dragging = false;
            CrystalAxisModel.drag_cancel();
        }
        if (root.is_dragging) {
            root.is_dragging = false;
            ViewportModel.camera_drag_end();
        }
    }
    // Keyboard: Escape backs out of the innermost tool first, Enter keeps a provisional tier,
    // F flips it, S toggles Slice mode, and the arrow and page keys step the tier selection.
    viewport_focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                // A handle drag in progress is cancelled first (the design goes
                // back to how it was at the press); only a plain Escape clears
                // the selection.
                if (ManipulateModel.dragging) {
                    root.handle_dragging = false;
                    ManipulateModel.drag_cancel();
                    return accept;
                }
                // The same for a crystal-axis handle drag.
                if (CrystalAxisModel.dragging) {
                    root.axis_dragging = false;
                    CrystalAxisModel.drag_cancel();
                    return accept;
                }
                // Slice tool, innermost first: a line being drawn is dropped; then
                // a provisional tier is discarded; then Slice mode itself is left.
                if (root.slice_dragging) {
                    root.slice_dragging = false;
                    ManipulateModel.slice_cancel();
                    return accept;
                }
                if (ManipulateModel.provisional_active) {
                    ManipulateModel.slice_discard();
                    return accept;
                }
                if (ManipulateModel.slice_mode) {
                    ManipulateModel.slice_mode = false;
                    ManipulateModel.slice_toggled();
                    return accept;
                }
                // Diagram mode: an enlarged panel goes back to all three before
                // Escape clears the selection.
                if (SolidPreviewModel.view_mode == 3 && SolidPreviewModel.diagram_enlarged_panel >= 0) {
                    SolidPreviewModel.diagram_enlarged_panel = -1;
                    return accept;
                }
                EditorModel.selected_tier_index = -1;
                return accept;
            } else if event.text == Key.Return && ManipulateModel.provisional_active {
                // Enter keeps the provisional slice tier (one undo step).
                ManipulateModel.slice_keep();
                return accept;
            } else if (event.text == "f" || event.text == "F") && ManipulateModel.provisional_active && !event.modifiers.control && !event.modifiers.meta {
                ManipulateModel.slice_flip();
                return accept;
            } else if (event.text == "s" || event.text == "S") && !ManipulateModel.dragging && !root.handle_dragging && !root.slice_dragging && !event.modifiers.control && !event.modifiers.meta && SolidPreviewModel.view_mode != 3 {
                ManipulateModel.slice_mode = !ManipulateModel.slice_mode;
                ManipulateModel.slice_toggled();
                return accept;
            } else if event.text == Key.DownArrow {
                root.step_selection(1);
                return accept;
            } else if event.text == Key.UpArrow {
                root.step_selection(-1);
                return accept;
            } else if event.text == Key.PageDown {
                root.step_selection(10);
                return accept;
            } else if event.text == Key.PageUp {
                root.step_selection(-10);
                return accept;
            }
            reject
        }

    drag_area := TouchArea {
        // Matches `GemViewportView`'s own `touch_area.enabled` guard --
        // without this, an orbit-drag or scroll-to-zoom could still reach the
        // viewport underneath the (fully covering) Tilt Curve dialog.
        enabled: !TiltModel.dialog_open;
        pointer-event(event) => {
            // Only the LEFT button starts an orbit or pan: a right or middle drag does nothing
            // here, as there is no light to move in this viewport.
            //
            // A left press on a drag handle's tip grabs that handle instead of orbiting; while
            // it is held, pointer moves drive the handle (Shift for fine snapping).
            // `PointerEventKind.move`, not `moved`, carries the modifiers.
            //
            // `moved` fires only while a button is held, so the hover paths (handle highlight,
            // facet and diagram tooltip) run here on `move`, which fires for every motion.
            // `moved` drives the orbit and the diagram pan. Nothing hovers during a handle
            // drag, a slice line or an orbit.
            if (event.kind == PointerEventKind.move) {
                if (root.handle_dragging) {
                    ManipulateModel.drag_move(root.manip_x(drag_area.mouse-x), root.manip_y(drag_area.mouse-y), event.modifiers.shift);
                } else if (root.axis_dragging) {
                    CrystalAxisModel.drag_move(root.manip_x(drag_area.mouse-x), root.manip_y(drag_area.mouse-y));
                } else if (root.slice_dragging) {
                    ManipulateModel.slice_move(drag_area.mouse-x, drag_area.mouse-y);
                } else if (!root.is_dragging) {
                    // In the Diagram view this also moves the handles onto the panel the
                    // pointer entered.
                    if (ManipulateModel.handles_visible) {
                        ManipulateModel.handle_hover(root.manip_x(drag_area.mouse-x), root.manip_y(drag_area.mouse-y));
                    }
                    if (CrystalAxisModel.overlay_visible) {
                        CrystalAxisModel.hover(root.manip_x(drag_area.mouse-x), root.manip_y(drag_area.mouse-y));
                    }
                    if (SolidPreviewModel.view_mode == 3) {
                        SolidPreviewModel.diagram_facet_hover(root.diagram_unzoomed_x(drag_area.mouse-x), root.diagram_unzoomed_y(drag_area.mouse-y));
                    } else {
                        // Only picking, not dragging -- the hover tooltip.
                        SolidPreviewModel.facet_hover(drag_area.mouse-x, drag_area.mouse-y);
                    }
                }
            } else if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.swallow_click = false;
                // The crystal axis's own handles come first: they sit on the stone, over
                // the facet handles' fan.
                if (CrystalAxisModel.overlay_visible && !ManipulateModel.slice_mode) {
                    let axis_hit = CrystalAxisModel.hit_test(root.manip_x(drag_area.mouse-x), root.manip_y(drag_area.mouse-y));
                    if (axis_hit >= 0) {
                        CrystalAxisModel.drag_begin(axis_hit, root.manip_x(drag_area.mouse-x), root.manip_y(drag_area.mouse-y));
                        // Rust sets `dragging` only when it grants the drag.
                        root.axis_dragging = CrystalAxisModel.dragging;
                    }
                }
                if (ManipulateModel.handles_visible && !root.axis_dragging) {
                    let hit = ManipulateModel.handle_hit_test(root.manip_x(drag_area.mouse-x), root.manip_y(drag_area.mouse-y));
                    if (hit >= 0) {
                        ManipulateModel.drag_begin(hit, root.manip_x(drag_area.mouse-x), root.manip_y(drag_area.mouse-y));
                        // Rust sets `dragging` only when it grants the drag; a
                        // refused press falls through to the orbit below.
                        root.handle_dragging = ManipulateModel.dragging;
                    }
                }
                // Slice mode: a press that did not grab a handle (the provisional
                // tier's handles stay grabbable) draws a line instead of orbiting.
                if (!root.handle_dragging && !root.axis_dragging && SolidPreviewModel.view_mode != 3 && ManipulateModel.slice_mode) {
                    ManipulateModel.slice_begin(drag_area.mouse-x, drag_area.mouse-y);
                    root.slice_dragging = true;
                }
                if (root.handle_dragging || root.axis_dragging || root.slice_dragging) {
                    root.swallow_click = true;
                } else {
                    root.last_mouse_x = drag_area.mouse-x;
                    root.last_mouse_y = drag_area.mouse-y;
                    root.drag_distance = 0;
                    root.is_dragging = true;
                    ViewportModel.camera_drag_begin();
                }
                // Grabs keyboard focus so Escape (in the `viewport_focus` FocusScope) works
                // right after a click.
                viewport_focus.focus();
                // Clears the tooltip text: a drag hides it, and no `moved` refreshes it, so a
                // stale value could otherwise show after the press.
                SolidPreviewModel.hover_text = "";
                SolidPreviewModel.diagram_hover_text = "";
            } else if ((event.kind == PointerEventKind.up && event.button == PointerEventButton.left) || event.kind == PointerEventKind.cancel) {
                // Only the LEFT release ends a gesture: a right or middle click made
                // while a handle is held must not drop it (a cancel carries no button).
                if (root.handle_dragging) {
                    root.handle_dragging = false;
                    if (event.kind == PointerEventKind.up) {
                        ManipulateModel.drag_end();
                    } else {
                        ManipulateModel.drag_cancel();
                    }
                }
                if (root.axis_dragging) {
                    root.axis_dragging = false;
                    if (event.kind == PointerEventKind.up) {
                        CrystalAxisModel.drag_end();
                    } else {
                        CrystalAxisModel.drag_cancel();
                    }
                }
                if (root.slice_dragging) {
                    root.slice_dragging = false;
                    if (event.kind == PointerEventKind.up) {
                        ManipulateModel.slice_end(drag_area.mouse-x, drag_area.mouse-y);
                    } else {
                        ManipulateModel.slice_cancel();
                    }
                }
                if (root.is_dragging) {
                    root.is_dragging = false;
                    ViewportModel.camera_drag_end();
                }
            }
        }
        // Belt and braces for a release that never arrives as `up`/`cancel` (a lost
        // grab, focus loss) or an area disabled mid-drag (the Tilt Curve dialog):
        // whenever Slint's own pressed state drops, every gesture is over -- the
        // orbit, and a handle drag or slice line too, which would otherwise leave
        // `ManipulateModel.dragging` true and the gesture's coalescing run open. The
        // handle drag and slice line take the same path as Escape (`drag_cancel`/
        // `slice_cancel`): with no release there is no pointer value to keep.
        changed pressed => {
            if (!self.pressed) {
                root.end_lost_gestures();
            }
        }
        changed enabled => {
            if (!self.enabled) {
                root.end_lost_gestures();
            }
        }
        // Lights no handle once the pointer has left the viewport.
        changed has-hover => {
            if (!drag_area.has-hover && !root.handle_dragging) {
                ManipulateModel.handle_hover(-1px, -1px);
            }
            if (!drag_area.has-hover && !root.axis_dragging) {
                CrystalAxisModel.hover(-1px, -1px);
            }
            // The readout belongs to the pointer, so it is cleared when the pointer leaves.
            if (!drag_area.has-hover) {
                SolidPreviewModel.hover_text = "";
                SolidPreviewModel.diagram_hover_text = "";
            }
        }
        moved => {
            if (root.handle_dragging || root.axis_dragging || root.slice_dragging) {
                // The handle drag / axis drag / slice line owns the pointer: no orbit, no hover pick.
                return;
            }
            if (SolidPreviewModel.view_mode == 3) {
                if (root.is_dragging) {
                    // Pan, clamped so the zoomed diagram cannot be dragged off-screen.
                    let dx = drag_area.mouse-x - root.last_mouse_x;
                    let dy = drag_area.mouse-y - root.last_mouse_y;
                    root.last_mouse_x = drag_area.mouse-x;
                    root.last_mouse_y = drag_area.mouse-y;
                    root.drag_distance += Math.abs(dx / 1px) + Math.abs(dy / 1px);
                    root.diagram_pan_x = root.clamp_diagram_pan(root.diagram_pan_x + dx, root.width, root.diagram_zoom);
                    root.diagram_pan_y = root.clamp_diagram_pan(root.diagram_pan_y + dy, root.height, root.diagram_zoom);
                }
            } else if (root.is_dragging) {
                let dx = (drag_area.mouse-x - root.last_mouse_x) / 1px;
                let dy = (drag_area.mouse-y - root.last_mouse_y) / 1px;
                root.last_mouse_x = drag_area.mouse-x;
                root.last_mouse_y = drag_area.mouse-y;
                root.drag_distance += Math.abs(dx) + Math.abs(dy);
                ViewportModel.camera_orbit(dx, dy);
            }
        }
        clicked => {
            if (SolidPreviewModel.view_mode == 3) {
                // A pan drag also ends in `clicked`: pick only when the pointer barely moved
                // between down and up, so a pan never re-picks a facet.
                if (root.drag_distance < 3 && !root.swallow_click) {
                    SolidPreviewModel.diagram_facet_click(root.diagram_unzoomed_x(drag_area.mouse-x), root.diagram_unzoomed_y(drag_area.mouse-y));
                }
            } else if (root.drag_distance < 3 && !root.swallow_click) {
                // An orbit drag ends in a `clicked` too -- only forward it as a real
                // pick when the pointer barely moved between down and up, so
                // rotating the stone never also re-selects whatever facet ends up
                // under the cursor.
                SolidPreviewModel.facet_click(drag_area.mouse-x, drag_area.mouse-y);
            }
        }
        // Diagram mode: double-click enlarges the panel under the pointer, or returns to all
        // three (`SolidPreviewModel.diagram_double_click`). The two `clicked`s of a
        // double-click still run, the first may pick a facet; a double-click after a pan is
        // ignored.
        double-clicked => {
            if (SolidPreviewModel.view_mode == 3 && root.drag_distance < 3 && !root.swallow_click) {
                SolidPreviewModel.diagram_double_click(root.diagram_unzoomed_x(drag_area.mouse-x), root.diagram_unzoomed_y(drag_area.mouse-y));
            }
        }
        // Scroll zooms the shared orbit camera, as the Live Render viewport does
        // (`ViewportModel.camera_zoom`). Diagram mode has no shared camera, so it zooms
        // `diagram_zoom` instead, clamped to `[1.0, 6.0]`.
        scroll-event(event) => {
            if (SolidPreviewModel.view_mode != 3) {
                ViewportModel.camera_zoom(event.delta-y / 1px);
                return accept;
            }
            // A handle drag in the Diagram view keeps the picture still: zooming under it
            // would move the unzoomed point the pointer is over.
            if (root.handle_dragging || root.axis_dragging) {
                return accept;
            }
            root.diagram_zoom = max(1.0, min(6.0, root.diagram_zoom - (event.delta-y / 1px) * 0.003));
            accept
        }
    }
    } // FocusScope (viewport_focus)

    // The pictures, the refusal card and the placeholder (`solid_viewport/layers.slint`),
    // under the overlays and the toolbar below. Handles no pointer event.
    SolidViewportLayers {
        width: 100%;
        height: 100%;
        is_dragging: root.is_dragging;
        diagram_zoom: root.diagram_zoom;
        diagram_pan_x: root.diagram_pan_x;
        diagram_pan_y: root.diagram_pan_y;
    }

    // The angle/depth/index drag handles of the selected facet, above the images
    // (`ManipulateModel`, pushed by `gui::editor::manipulate`). Pointer input is
    // never handled here: `drag_area` above stays the only TouchArea.
    // In the Diagram view the overlay maps the model's unzoomed positions through this
    // component's zoom and pan.
    if ManipulateModel.handles_visible: ManipulateOverlay {
        zoom: SolidPreviewModel.view_mode == 3 ? root.diagram_zoom : 1.0;
        pan_x: SolidPreviewModel.view_mode == 3 ? root.diagram_pan_x : 0px;
        pan_y: SolidPreviewModel.view_mode == 3 ? root.diagram_pan_y : 0px;
    }

    // The crystal axis (and a biaxial stone's Second Axis) over the stone, with their drag
    // handles (`CrystalAxisModel`, pushed by `gui::editor::manipulate::crystal_axis_overlay`).
    // Pointer input is never handled here: `drag_area` above stays the only TouchArea. In the
    // Diagram view the overlay maps the model's unzoomed positions through the zoom and pan.
    if CrystalAxisModel.overlay_visible: CrystalAxisOverlay {
        zoom: SolidPreviewModel.view_mode == 3 ? root.diagram_zoom : 1.0;
        pan_x: SolidPreviewModel.view_mode == 3 ? root.diagram_pan_x : 0px;
        pan_y: SolidPreviewModel.view_mode == 3 ? root.diagram_pan_y : 0px;
    }
    // Tells Rust when something the crystal axis depends on changed.
    CrystalAxisWatcher { }

    // The Show Surface Finish marks (`SurfaceModel`, pushed by
    // `gui::editor::manipulate::surface_overlay`); never handles pointer input.
    if SurfaceModel.overlay_visible: SurfaceFinishOverlay { }
    SurfaceFinishWatcher { }

    // The Slice tool's rubber band while a line is being drawn.
    if ManipulateModel.slice_line_visible && SolidPreviewModel.view_mode != 3: SliceLineOverlay { }

    // The one-line hint under the toolbar row (with the Slice tool's buttons at its
    // right end); hidden while it has nothing to say.
    if ManipulateModel.hint_text != "" || ManipulateModel.provisional_active: ManipulateHintBar { toolbar_height: toolbar.top_height; }

    // Hover tooltip, bottom-left of the picture. Shown only while the pointer is over the
    // viewport and no orbit runs, so a stale hover never stays on screen.
    if root.hover_text != "" && drag_area.has-hover && !root.is_dragging: Rectangle {
        x: 10px;
        y: parent.height - self.height - 46px;
        width: hover_label.preferred-width + 16px;
        height: hover_label.preferred-height + 10px;
        background: Theme.bg-elevated;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-subtle;

        hover_label := Text {
            text: root.hover_text;
            font-size: 11px;
            color: Theme.text-primary;
            x: 8px;
            y: 5px;
        }
    }

    // The toolbar (`solid_viewport/toolbar.slint`). The diagram zoom and pan stay on this
    // component, whose Image and drag handling read them, and are shared two-way so the
    // "Reset View" pill can reset them. `toolbar.top_height` places the hint strip below the
    // toolbar's rows.
    toolbar := SolidViewportToolbar {
        diagram_zoom <=> root.diagram_zoom;
        diagram_pan_x <=> root.diagram_pan_x;
        diagram_pan_y <=> root.diagram_pan_y;
    }

    // The focus ring: drawn while the viewport itself has keyboard focus (Tab, or a click
    // on the picture), which is when Up/Down step through the tiers, Escape clears the
    // selection and S turns the Slice tool on. No pointer handling, so every event still
    // reaches `drag_area` underneath.
    if viewport_focus.has-focus: Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: transparent;
        border-radius: Theme.radius-md;
        border-width: 2px;
        border-color: Theme.border-accent;
    }

    // The tutorial outline: drawn while the open step is about the picture. Like the focus
    // ring it handles no pointer events.
    if GuideModel.highlight_target == "solid_viewport": Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: transparent;
        border-radius: Theme.radius-md;
        border-width: 2px;
        border-color: Theme.accent-cyan;
    }

    // The Tilt Curve dialog and the material editor are mounted at window size in
    // `GlobalDialogsOverlay` (`components/app/global_dialogs.slint`): this viewport can be
    // only 170-260px tall in the narrow stack.
}
