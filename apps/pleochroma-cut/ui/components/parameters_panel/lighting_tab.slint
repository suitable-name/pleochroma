import { Theme } from "../../theme.slint";
import { SettingsModel } from "../../models/settings.slint";
import { ViewportModel } from "../../models/viewport.slint";
import { EnvironmentMapSection } from "../settings_dialog/environment_map_section.slint";
import { LightingPresetsSection } from "../settings_dialog/lighting_presets_section.slint";
import { DesignLightingSection } from "../settings_dialog/design_lighting_section.slint";
import { PhysicscolorModel } from "../../models/physics_color.slint";
import { KitButton, KitCard, KitChip, KitFoldCard, KitIcons, KitInlineSlider, KitRigThumb, KitSection, KitSegmentBar, KitSlider, KitSwitchRow } from "../kit/kit.slint";
import { TextLink } from "parts.slint";
import { DegreeField, LightDome } from "light_dome.slint";
import { RigChangeButton } from "rig_gallery.slint";

// One backdrop choice: a dot of its color and its name. `as_lit` draws the dot half white, half
// black (the lighting's own ground).
component BackdropSeg inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <color> dot;
    in property <bool> as_lit: false;
    in property <bool> on;
    in property <bool> enabled: true;
    callback picked();

    horizontal-stretch: 1;
    height: 28px;
    border-radius: 7px;
    background: root.on ? Theme.bg-elevated : (seg_touch.has-hover && root.enabled ? Theme.bg-card-hover : transparent);
    border-width: seg_focus.has-focus ? 2px : 0px;
    border-color: Theme.accent-cyan-hover;
    opacity: root.enabled ? 1.0 : 0.5;

    accessible-role: AccessibleRole.radio-button;
    accessible-label: root.text;
    accessible-description: root.hint;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => {
        if root.enabled {
            root.picked();
        }
    }

    Tooltip { text: @markdown("\{root.hint}"); }

    seg_focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.picked();
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: root.as_lit
                    ? @linear-gradient(135deg, Theme.swatch-white 0%, Theme.swatch-white 50%, Theme.swatch-black 50%, Theme.swatch-black 100%)
                    : root.dot;
                border-width: 1px;
                border-color: Theme.border-control;
            }
        }
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: root.on ? 600 : 500;
            color: root.on ? Theme.text-primary : Theme.text-secondary;
            vertical-alignment: center;
        }
    }

    seg_touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// One angle of the Stone Pose: a name, a slider and a typed degrees box. The slider reports every
// step through `moved` (the stone follows while it is dragged) and the let-go through `released`;
// the box applies on Enter or when it is left (`entered`).
component PoseAngleRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    in-out property <float> value;
    in property <float> maximum: 360.0;
    callback moved(float);
    callback released(float);
    callback entered(float);

    height: 32px;
    spacing: 8px;
    Text {
        width: 60px;
        text: root.label;
        font-size: 12px;
        color: Theme.text-secondary;
        vertical-alignment: center;
        overflow: elide;
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        KitSlider {
            label: root.label + " of the Stone";
            hint: root.hint;
            minimum: 0.0;
            maximum: root.maximum;
            step: 1.0;
            value <=> root.value;
            moved(v) => { root.moved(v); }
            released(v) => { root.released(v); }
        }
    }
    DegreeField {
        min-width: 76px;
        max-width: 90px;
        field_label: root.label + " in Degrees";
        hint: root.hint;
        value: root.value;
        minimum: 0.0;
        maximum: root.maximum;
        wraps: root.maximum > 180.0;
        applied(v) => { root.entered(v); }
    }
}

// The Parameters dock's Lighting tab. It is where the lighting of the picture is set, in the
// order you would think about it: which lighting rig (a card; "Change" opens the rig gallery,
// which the panel draws over the tab), where the main light is (a dome, or the HDR map's rotation
// dial), how bright the picture is, what surrounds the stone (the backdrop, the Stone Shadow, the
// Tray Reflection, an HDR map), how the viewer shows up in the reflections (surface glare, head
// shadow, folded), the lightings you saved and the lighting the open design remembers. The camera
// has its buttons in the viewport.
//
// All of it is one scene description (`settings::model::LightingValues`): the live view, the
// lighting a design remembers, a saved lighting and the render jobs carry the same fields, so
// "Use this lighting for this design" and "Save" keep everything on this tab. The controls read and
// write `SettingsModel` / `ViewportModel`; Rust mirrors them into the render context and the
// settings file. The tab is mounted in both views, so the Edit view's Path-traced and Both modes
// reach it too.
export component LightingTab inherits VerticalLayout {
    // The rig gallery is open. The panel owns the popover (it must not scroll with this tab), so it
    // binds this both ways.
    in-out property <bool> gallery_open: false;

    property <int> sel: ViewportModel.selected_lighting_index;
    property <string> rig_name: ViewportModel.lighting_short_names[root.sel] != ""
        ? ViewportModel.lighting_short_names[root.sel]
        : ViewportModel.lighting_options[root.sel];
    property <int> rig_group: root.sel < ViewportModel.lighting_groups.length
        ? ViewportModel.lighting_groups[root.sel]
        : (ViewportModel.lighting_is_studio[root.sel] ? 1 : 0);
    property <string> rig_chip: root.rig_group == 0 ? "Lit model" : (root.rig_group == 1 ? "Studio" : (root.rig_group == 2 ? "Analysis" : "UV"));
    property <color> rig_chip_ink: root.rig_group == 0 ? Theme.accent-cyan : (root.rig_group == 1 ? Theme.accent-amber : (root.rig_group == 2 ? Theme.accent-emerald : Theme.accent-purple));
    property <color> rig_chip_fill: root.rig_group == 0 ? Theme.accent-cyan-surface : (root.rig_group == 1 ? Theme.surface-warning : Theme.bg-elevated);

    // Surface glare only scales the built-in lighting rigs: a loaded HDR map
    // (`SettingsModel.env_map_loaded`) ignores it, so the slider greys out with a reason
    // rather than looking like it does something.
    property <bool> surface_glare_enabled: !SettingsModel.env_map_loaded;
    property <int> surface_glare_shown: Math.round(SettingsModel.surface_glare_pct / 5.0) * 5;
    // The four studio rigs are pinpoint sources with no sky for a head to hide, so they ignore
    // the head shadow just as an HDR map does.
    property <bool> studio_rig: ViewportModel.lighting_is_studio[ViewportModel.selected_lighting_index];
    property <bool> head_shadow_enabled: !SettingsModel.env_map_loaded && !root.studio_rig;
    property <int> head_shadow_shown: Math.round(SettingsModel.head_shadow_deg);
    // The Stone Shadow and the tray reflection reach the same lights: a studio light or lit
    // model with a backdrop (not an HDR map, As Lit or the contrast and ultraviolet rigs).
    property <bool> shadow_enabled: !SettingsModel.env_map_loaded && SettingsModel.backdrop_index != 0
        && ViewportModel.lighting_supports_stone_shadow[ViewportModel.selected_lighting_index];
    property <string> shadow_reason: SettingsModel.env_map_loaded ? "not with HDR"
        : SettingsModel.backdrop_index == 0 ? "needs a backdrop"
        : !ViewportModel.lighting_supports_stone_shadow[ViewportModel.selected_lighting_index] ? "not with this light" : "";
    property <int> tray_reflection_shown: Math.round(SettingsModel.tray_reflection_pct);
    // Open from the start while a value is off its default, so a reset link is never hidden.
    property <bool> viewer_open: false;
    init => {
        root.viewer_open = SettingsModel.surface_glare_pct < 99.5 || Math.abs(SettingsModel.head_shadow_deg - 16.0) > 0.5;
    }

    spacing: 14px;
    // Rows keep their own height when the tab is shorter than the panel (see `StoneTab`).
    alignment: start;

    // --- Lighting rig ------------------------------------------------------------------
    KitCard {
        // Tall enough for a two-line blurb (it wraps instead of eliding).
        height: 102px;
        HorizontalLayout {
            padding: 10px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                KitRigThumb { kind: ViewportModel.lighting_kinds[root.sel]; size: 56px; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;
                Text {
                    min-width: 0px;
                    text: root.rig_name;
                    font-size: 15px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    overflow: elide;
                }
                Text {
                    min-width: 0px;
                    text: SettingsModel.env_map_loaded ? "An HDR map is the light." : ViewportModel.lighting_blurbs[root.sel];
                    font-size: 11px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    KitChip { text: root.rig_chip; ink: root.rig_chip_ink; fill: root.rig_chip_fill; }
                }
            }
            VerticalLayout {
                alignment: center;
                RigChangeButton {
                    hint: PhysicscolorModel.ui_enabled
                        ? "Change the lighting rig: lit models, studio rigs, the contrast view or a UV lamp (CPU only)."
                        : "Change the lighting rig: lit models, studio rigs or the contrast view.";
                    clicked => { root.gallery_open = true; }
                }
            }
        }
    }

    // --- Main light --------------------------------------------------------------------
    // While an HDR map is loaded the light direction means nothing (the map is the light), so the
    // dome turns into the map's rotation dial, and the map's "Turns with the Camera" shows. The
    // handlers are Rust's (`gui::render::camera_lighting`), which also write the values back.
    KitSection { label: SettingsModel.env_map_loaded ? "MAP ROTATION" : "MAIN LIGHT"; }

    HorizontalLayout {
        spacing: 16px;
        LightDome {
            azimuth: SettingsModel.env_map_loaded ? SettingsModel.env_map_yaw_deg : SettingsModel.light_yaw_deg;
            elevation: SettingsModel.light_pitch_deg;
            el_min: SettingsModel.light_elevation_min_deg;
            el_max: SettingsModel.light_elevation_max_deg;
            map_mode: SettingsModel.env_map_loaded;
            edited(az, el) => {
                if SettingsModel.env_map_loaded {
                    SettingsModel.env_map_yaw_deg = az;
                    ViewportModel.env_map_turn_changed(az);
                } else {
                    SettingsModel.light_yaw_deg = az;
                    SettingsModel.light_pitch_deg = el;
                    ViewportModel.light_pos_changed(az, el);
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: center;
            spacing: 8px;
            if !SettingsModel.env_map_loaded: DegreeField {
                name: "Azimuth";
                field_label: "Light Azimuth in Degrees";
                hint: "Light azimuth: the direction the main light shines from, as an angle\naround the stone (0 to 360 degrees). Dragging with the right mouse\nbutton, or Shift and the left button, in the viewport moves it too.";
                value: SettingsModel.light_yaw_deg;
                wraps: true;
                applied(v) => {
                    SettingsModel.light_yaw_deg = v;
                    ViewportModel.light_pos_changed(v, SettingsModel.light_pitch_deg);
                }
            }
            if !SettingsModel.env_map_loaded: DegreeField {
                name: "Elevation";
                field_label: "Light Elevation in Degrees";
                hint: "Light elevation: how high the main light is above the\nstone, from low and raking to nearly straight overhead.";
                value: SettingsModel.light_pitch_deg;
                minimum: SettingsModel.light_elevation_min_deg;
                maximum: SettingsModel.light_elevation_max_deg;
                applied(v) => {
                    SettingsModel.light_pitch_deg = v;
                    ViewportModel.light_pos_changed(SettingsModel.light_yaw_deg, v);
                }
            }
            if SettingsModel.env_map_loaded: DegreeField {
                name: "Map Rotation";
                field_label: "Map Rotation in Degrees";
                hint: "Turns the HDR map around the stone, from 0 to 360 degrees. Dragging with the right mouse button, or Shift and the left button, in the viewport turns it too.";
                value: SettingsModel.env_map_yaw_deg;
                wraps: true;
                applied(v) => {
                    SettingsModel.env_map_yaw_deg = v;
                    ViewportModel.env_map_turn_changed(v);
                }
            }
            Text {
                text: SettingsModel.env_map_loaded
                    ? "Drag the dot or use the arrow keys. Right-drag, or Shift and drag, in the viewport turns the map."
                    : "Drag the dot, or use the arrow keys (Shift for finer). Right-drag in the viewport moves the light too.";
                font-size: 10px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }
    }

    if SettingsModel.env_map_loaded: KitSwitchRow {
        label: "Turns with the Camera";
        on: SettingsModel.env_map_follows_camera;
        toggled => { ViewportModel.env_map_follow_changed(!SettingsModel.env_map_follows_camera); }
    }

    // Exposure: a correction on top of the light meter. 1x shows white paper the same under every
    // lighting; under an HDR map it scales the map's own light.
    KitInlineSlider {
        label: "Exposure";
        value_text: Math.round(SettingsModel.exposure_val * 100.0) / 100.0 + "x";
        minimum: SettingsModel.exposure_min;
        maximum: SettingsModel.exposure_max;
        step: (SettingsModel.exposure_max - SettingsModel.exposure_min) / 100.0;
        value <=> SettingsModel.exposure_val;
        moved(val) => { SettingsModel.exposure_changed(val); }
    }

    // --- Surroundings ------------------------------------------------------------------
    KitSection { label: "SURROUNDINGS"; }

    VerticalLayout {
        spacing: 8px;

        // Backdrop -- the tray the stone lies on, lit by the lighting rig. Every ray that leaves
        // the stone sees it, so a window shows the tray. Indices: 0 as lit, 1 grey, 2 white
        // (default), 3 black; the segments run As Lit, Black, Grey, White. An HDR map is the whole
        // world, so the row is dimmed while one is loaded.
        KitSegmentBar {
            HorizontalLayout {
                padding: 2px;
                spacing: 2px;
                BackdropSeg {
                    text: "As Lit";
                    as_lit: true;
                    hint: SettingsModel.env_map_loaded
                        ? "Not used while an HDR map is loaded: the map is the world."
                        : "The lighting's own ground. For the Grading tray that is nothing\nbelow the girdle (the ISO/GemRay convention): windows look black.";
                    enabled: !SettingsModel.env_map_loaded;
                    on: SettingsModel.backdrop_index == 0;
                    picked => {
                        SettingsModel.backdrop_index = 0;
                        SettingsModel.backdrop_changed(0);
                    }
                }
                BackdropSeg {
                    text: "Black";
                    dot: Theme.swatch-black;
                    hint: SettingsModel.env_map_loaded
                        ? "Not used while an HDR map is loaded: the map is the world."
                        : "Black velvet (2 % reflectance).";
                    enabled: !SettingsModel.env_map_loaded;
                    on: SettingsModel.backdrop_index == 3;
                    picked => {
                        SettingsModel.backdrop_index = 3;
                        SettingsModel.backdrop_changed(3);
                    }
                }
                BackdropSeg {
                    text: "Grey";
                    dot: Colors.gray;
                    hint: SettingsModel.env_map_loaded
                        ? "Not used while an HDR map is loaded: the map is the world."
                        : "An 18 % grey card.";
                    enabled: !SettingsModel.env_map_loaded;
                    on: SettingsModel.backdrop_index == 1;
                    picked => {
                        SettingsModel.backdrop_index = 1;
                        SettingsModel.backdrop_changed(1);
                    }
                }
                BackdropSeg {
                    text: "White";
                    dot: Colors.whitesmoke;
                    hint: SettingsModel.env_map_loaded
                        ? "Not used while an HDR map is loaded: the map is the world."
                        : "White paper (90 % reflectance). The light meter shows it\nas the same off-white sheet under every lighting; pick\nBlack for the dark-room look of the Studio rigs.";
                    enabled: !SettingsModel.env_map_loaded;
                    on: SettingsModel.backdrop_index == 2;
                    picked => {
                        SettingsModel.backdrop_index = 2;
                        SettingsModel.backdrop_changed(2);
                    }
                }
            }
        }

        Rectangle {
            height: 30px;
            KitSwitchRow {
                label: "Stone Shadow";
                reason: root.shadow_reason;
                enabled: root.shadow_enabled;
                on: SettingsModel.stone_shadow;
                toggled => {
                    SettingsModel.stone_shadow = !SettingsModel.stone_shadow;
                    SettingsModel.stone_shadow_changed(SettingsModel.stone_shadow);
                }
            }
            Tooltip { text: @markdown("The stone casts its shadow and colored light onto the backdrop, as a stone on paper does. Studio lights only."); }
        }

        // Tray reflection: makes the tray under the stone glossy, 0-100 % head-on reflectance in
        // steps of 1 (0 = off). Rust snaps and applies it (`gui::render::quality::
        // setup_tray_reflection_callback`).
        Rectangle {
            height: 30px;
            KitInlineSlider {
                label: "Tray Reflection";
                note: root.shadow_reason;
                value_text: root.tray_reflection_shown == 0 ? "Off" : root.tray_reflection_shown + " %";
                minimum: 0.0;
                maximum: 100.0;
                step: 1.0;
                enabled: root.shadow_enabled;
                value <=> SettingsModel.tray_reflection_pct;
                moved(val) => { SettingsModel.tray_reflection_changed(Math.round(val)); }
            }
            Tooltip { text: @markdown("How mirror-like the surface under the stone is: its reflectance straight on. About 4 % looks like black acrylic or glass, 100 % is a mirror; glancing views reflect more."); }
        }

        // Stone Pose: the stone stands on the tray at an angle other than the one it was designed
        // at, in the Live Render view and the exports. Tilt 0 is the stone as designed. Rust
        // clamps the angles and applies the pose (`gui::render::stone_pose`).
        VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: "STONE POSE";
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 0.7px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    accessible-role: AccessibleRole.text;
                }
                KitButton {
                    text: "Reset";
                    kind: 2;
                    h: 26px;
                    hint: "Stand the stone as designed: tilt, turn and spin back to 0.";
                    clicked => { SettingsModel.stone_pose_reset(); }
                }
            }
            PoseAngleRow {
                label: "Tilt";
                hint: "Tilt: how far the stone leans from lying table up, from 0 to 180 degrees.\n90 stands the table upright, 180 lays the stone on its table. Dragging in\nthe viewport with Alt, or Ctrl and Shift, held tilts it too.";
                maximum: 180.0;
                value <=> SettingsModel.stone_tilt_deg;
                moved(v) => {
                    SettingsModel.stone_pose_changed(v, SettingsModel.stone_turn_deg, SettingsModel.stone_spin_deg, true);
                }
                released(v) => {
                    SettingsModel.stone_pose_changed(v, SettingsModel.stone_turn_deg, SettingsModel.stone_spin_deg, false);
                }
                entered(v) => {
                    SettingsModel.stone_pose_changed(v, SettingsModel.stone_turn_deg, SettingsModel.stone_spin_deg, false);
                }
            }
            PoseAngleRow {
                label: "Turn";
                hint: "Turn: the direction the tilted stone leans towards, as an angle around\nthe vertical (0 to 360 degrees). Dragging sideways in the viewport with\nAlt, or Ctrl and Shift, held turns it too.";
                value <=> SettingsModel.stone_turn_deg;
                moved(v) => {
                    SettingsModel.stone_pose_changed(SettingsModel.stone_tilt_deg, v, SettingsModel.stone_spin_deg, true);
                }
                released(v) => {
                    SettingsModel.stone_pose_changed(SettingsModel.stone_tilt_deg, v, SettingsModel.stone_spin_deg, false);
                }
                entered(v) => {
                    SettingsModel.stone_pose_changed(SettingsModel.stone_tilt_deg, v, SettingsModel.stone_spin_deg, false);
                }
            }
            PoseAngleRow {
                label: "Spin";
                hint: "Spin: turns the stone about its own table normal before it is tilted (0 to\n360 degrees). It decides which side of an oval, pear or emerald cut ends up\non the tray.";
                value <=> SettingsModel.stone_spin_deg;
                moved(v) => {
                    SettingsModel.stone_pose_changed(SettingsModel.stone_tilt_deg, SettingsModel.stone_turn_deg, v, true);
                }
                released(v) => {
                    SettingsModel.stone_pose_changed(SettingsModel.stone_tilt_deg, SettingsModel.stone_turn_deg, v, false);
                }
                entered(v) => {
                    SettingsModel.stone_pose_changed(SettingsModel.stone_tilt_deg, SettingsModel.stone_turn_deg, v, false);
                }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                KitButton {
                    text: "Face the Camera";
                    h: 28px;
                    hint: "Turn the table to the camera: the stone tilts and turns to face the eye. The spin stays.";
                    clicked => { SettingsModel.stone_face_camera(); }
                }
                KitButton {
                    text: "Product Shot";
                    h: 28px;
                    hint: "One click for a product picture: the camera drops to 15 degrees, the stone faces it, and the view is framed with room for the mirror image under the stone. Lighting stays as it is; turn the Tray Reflection on for the mirror.";
                    clicked => { SettingsModel.stone_product_shot(root.shadow_enabled); }
                }
            }
            Text {
                text: "The stone rests on the tray at its lowest point; the shadow and the reflection follow. Tilt views, metrics and the Edit view show the stone as designed.";
                font-size: 10px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }

        // HDR environment map: loads a Radiance .hdr equirectangular panorama as the render's
        // environment in place of the lighting rig, superseded while a map is loaded.
        EnvironmentMapSection { }
    }

    // --- Viewer ------------------------------------------------------------------------
    KitFoldCard {
        icon: KitIcons.eye;
        label: "Viewer";
        summary: "Glare " + root.surface_glare_shown + " % · head shadow " + root.head_shadow_shown + "°";
        open <=> root.viewer_open;

        // Surface glare: scales the white mirror image of the light on the table (the
        // cross-polarised look), 0-100 % in steps of 5. Rust snaps and applies it
        // (`gui::render::quality::setup_surface_glare_callback`). It applies to the built-in
        // lighting rigs, to the path-traced view and to exports; the Solid view is unaffected.
        Rectangle {
            height: 30px;
            KitInlineSlider {
                label: "Surface Glare";
                note: !root.surface_glare_enabled ? "not with HDR" : "";
                value_text: root.surface_glare_shown + " %";
                minimum: 0.0;
                maximum: 100.0;
                step: 5.0;
                enabled: root.surface_glare_enabled;
                value <=> SettingsModel.surface_glare_pct;
                moved(val) => { SettingsModel.surface_glare_changed(Math.round(val / 5.0) * 5.0); }
            }
            Tooltip { text: @markdown("Surface glare: hides the white mirror image of the light on the table\nso the inner facets stay visible. 0 % keeps only light that entered the\nstone. Applies to the built-in lighting rigs, not to HDR maps, and to\nthe path-traced view and exports (the Solid view is unaffected)."); }
        }
        if root.surface_glare_shown < 100 && root.surface_glare_enabled: HorizontalLayout {
            alignment: end;
            TextLink {
                text: "Reset to 100 %";
                hint: "Put the surface glare back to 100 %, the unchanged look.";
                clicked => {
                    SettingsModel.surface_glare_pct = 100.0;
                    SettingsModel.surface_glare_changed(100.0);
                }
            }
        }

        // Head shadow: the angular radius of the viewer's head shadow on the lit rigs, 0-30
        // degrees (0 = off). Rust rounds and applies it
        // (`gui::render::quality::setup_head_shadow_callback`).
        Rectangle {
            height: 30px;
            KitInlineSlider {
                label: "Head Shadow";
                note: SettingsModel.env_map_loaded
                    ? "not with HDR"
                    : (root.studio_rig ? "not used by studio rigs" : "");
                value_text: root.head_shadow_shown == 0 ? "Off" : root.head_shadow_shown + "°";
                minimum: 0.0;
                maximum: 30.0;
                step: 1.0;
                enabled: root.head_shadow_enabled;
                value <=> SettingsModel.head_shadow_deg;
                moved(val) => { SettingsModel.head_shadow_changed(Math.round(val)); }
            }
            Tooltip { text: @markdown("How much of the sky the viewer's head hides: the dark table\nreflections a face-up stone shows. 16 degrees is a head at\narm's length; 0 turns it off. Product-photography rigs (D65\nDaylight, Incandescent, Ring Lights, Dark Spotlight) ignore it."); }
        }
        if root.head_shadow_shown != 16 && root.head_shadow_enabled: HorizontalLayout {
            alignment: end;
            TextLink {
                text: "Reset to 16°";
                hint: "Put the head shadow back to 16 degrees, a head at arm's length.";
                clicked => {
                    SettingsModel.head_shadow_deg = 16.0;
                    SettingsModel.head_shadow_changed(16.0);
                }
            }
        }
    }

    // --- Saved lightings and this design -----------------------------------------------
    LightingPresetsSection { }

    DesignLightingSection { }
}
