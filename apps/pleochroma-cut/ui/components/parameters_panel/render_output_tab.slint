import { Theme } from "../../theme.slint";
import { SettingsModel } from "../../models/settings.slint";
import { TiltModel } from "../../models/tilt.slint";
import { RemoteWorkerModel } from "../../models/remote_worker.slint";
import { GuideModel } from "../../models/guide.slint";
import { ResolutionPicker } from "../settings_dialog/resolution_picker.slint";
import { MotionPreviewPicker } from "../settings_dialog/motion_preview_picker.slint";
import { LiveComputePicker } from "../settings_dialog/live_compute_picker.slint";
import { LocalComputePicker } from "../settings_dialog/local_compute_picker.slint";
import { BouncesPicker } from "../settings_dialog/bounces_picker.slint";
import { ExportModel } from "../../models/export.slint";
import { SliderRow } from "parts.slint";
import { KitCard, KitFillSegments, KitFoldCard, KitIcons, KitInlineSlider, KitSection, KitSwitchRow } from "../kit/kit.slint";
import { KitQualityTile, KitRowName, KitSummaryRow } from "../kit/r2r.slint";

// The Parameters dock's Render tab: the technical render options. One quality choice up top (the
// presets Draft, Balanced, High and Custom), the details folded under it, compute as status rows,
// what the export dialogs start from and the library thumbnails. The pickers read and write
// `SettingsModel`.
//
// Nothing here keeps its own copy of a Rust-owned constant: the bounce ladder and every sample
// range come from `SettingsModel` (published by `gui::render::parameter_constants` from
// `settings::model::output_settings`), the remote choices read the one remote-availability
// value (`RemoteWorkerModel.availability`), the presets and what Custom remembers are Rust's
// (`settings::model::QualityPreset`), and "Reset This Tab" is a Rust call. The tilt curve is not
// on this tab: the viewports' Tilt Curve buttons open it.
//
// Simple mode (`GuideModel.shows_advanced()`) keeps the presets, target samples, resolution,
// denoise and the exports rows, and hides whole cards (Compute, Ray-Traced View, Library
// Thumbnails) and the motion preview and bounces rows. A hidden control keeps its value and still
// applies; the tab says so when one is off its default.
export component RenderOutputTab inherits VerticalLayout {
    // Rounded exponent driving the displayed sample count: `SliderBase` only snaps to `step` on
    // arrow-key nudges, not on pointer drag, so the rounding happens here.
    property <int> sample_exponent: Math.round(SettingsModel.target_samples_exponent);
    property <int> target_samples_count: Math.round(Math.pow(2.0, root.sample_exponent));
    property <string> preset_name: ["Draft", "Balanced", "High", "Custom"][SettingsModel.quality_preset_index];
    property <string> resolution_name: ["640 × 480", "800 × 600", "1280 × 720", "1920 × 1080"][SettingsModel.resolution_index];
    property <bool> remote_in_use: RemoteWorkerModel.availability.configured && SettingsModel.live_compute_target_index != 0;
    // Remote Only with a remote set up: this computer does not trace the live view, so the Compute
    // card leaves out its own engine settings.
    property <bool> local_in_use: !(RemoteWorkerModel.availability.configured && SettingsModel.live_compute_target_index == 1);
    property <string> engine_name: SettingsModel.gpu_build
        ? ["CPU", "CPU + GPU", "GPU"][SettingsModel.local_compute_target_index]
        : "CPU";

    // Simple mode hides some controls that are off their defaults: say so (see the callback's
    // own comment in `models/settings.slint`).
    property <bool> advanced_note_visible: (!GuideModel.shows_advanced() && SettingsModel.advanced_in_use(
        Math.round(SettingsModel.preview_size_val),
        Math.round(SettingsModel.preview_spp_val),
        SettingsModel.local_preview_scale_index,
        SettingsModel.live_compute_target_index,
        SettingsModel.contribute_to_final_picture,
        SettingsModel.local_compute_target_index,
        SettingsModel.bounce_index)) || (!GuideModel.shows_advanced() && (SettingsModel.ray_taps != 8 || !SettingsModel.ray_fire || SettingsModel.thumbnail_renderer_index != 0 || SettingsModel.thumbnail_backdrop_index != 1));

    spacing: 14px;
    // Rows keep their own height when the tab is shorter than the panel (see `StoneTab`).
    alignment: start;

    // Simple mode hides some settings; one of them is off its default.
    if root.advanced_note_visible: Rectangle {
        border-radius: Theme.radius-sm;
        background: Theme.notice-surface;
        border-width: 1px;
        border-color: Theme.notice-accent;
        height: advanced_note.preferred-height + 12px;
        accessible-role: AccessibleRole.text;
        accessible-label: "Some advanced settings are in use. Switch to Advanced to see them.";
        Tooltip { text: @markdown("Simple mode hides some render settings (preview size and\nsamples, motion preview, compute choices, ray bounces).\nOne of them is not at its default. It still applies.\nSwitch to Advanced in the header to see and change it."); }
        advanced_note := Text {
            x: 8px;
            y: 6px;
            width: parent.width - 16px;
            text: "Some advanced settings are in use. Switch to Advanced to see them.";
            font-size: 11px;
            color: Theme.notice-text;
            wrap: word-wrap;
        }
    }

    // --- Quality -----------------------------------------------------------------------------
    // Picking a tile sets the samples, the resolution and the bounces together (Rust). Touching
    // one of those controls makes the preset Custom, and Custom remembers its own values.
    KitSection { label: "LIVE VIEW QUALITY"; }
    HorizontalLayout {
        spacing: 6px;
        KitQualityTile {
            name: "Draft";
            detail: "64 · fast";
            hint: "Draft: 64 samples, 640 × 480, 12 bounces. Fast and grainy.";
            on: SettingsModel.quality_preset_index == 0;
            picked => {
                SettingsModel.quality_preset_index = 0;
                SettingsModel.quality_preset_selected(0);
            }
        }
        KitQualityTile {
            name: "Balanced";
            detail: "256 samples";
            hint: "Balanced: 256 samples, 800 × 600, 12 bounces. The default.";
            on: SettingsModel.quality_preset_index == 1;
            picked => {
                SettingsModel.quality_preset_index = 1;
                SettingsModel.quality_preset_selected(1);
            }
        }
        KitQualityTile {
            name: "High";
            detail: "1024 · slow";
            hint: "High: 1024 samples, 1280 × 720, 24 bounces. Smooth and slow.";
            on: SettingsModel.quality_preset_index == 2;
            picked => {
                SettingsModel.quality_preset_index = 2;
                SettingsModel.quality_preset_selected(2);
            }
        }
        KitQualityTile {
            name: "Custom";
            detail: "your mix";
            hint: "Custom: your own samples, resolution and bounces. Changing any of them in the details below makes the preset Custom, and Custom remembers the values.";
            on: SettingsModel.quality_preset_index == 3;
            picked => {
                SettingsModel.quality_preset_index = 3;
                SettingsModel.quality_preset_selected(3);
            }
        }
    }
    Text {
        text: root.target_samples_count + " samples · " + root.resolution_name + " · " + SettingsModel.bounce_ladder[SettingsModel.bounce_index] + " bounces" + (RemoteWorkerModel.denoise_enabled ? " · denoised" : "");
        font-size: 11px;
        color: Theme.text-secondary;
        horizontal-alignment: center;
        overflow: elide;
        accessible-role: AccessibleRole.text;
    }

    KitFoldCard {
        icon: KitIcons.image;
        label: "Live View Details";
        summary: root.preset_name;
        open: true;

        // Target Samples moves in powers of two -- noise falls as 1/sqrt(N), so a linear 8..1024
        // control would spend ~97% of its travel above 32 spp where each step barely changes
        // anything visible. The slider drags the EXPONENT (3..=10); `sample_exponent` /
        // `target_samples_count` above derive the count. The exponent range is Rust's
        // (`LIVE_SAMPLES_EXPONENT_RANGE`). It stays a continuous control, so a saved 384 shows.
        Rectangle {
            height: 30px;
            KitInlineSlider {
                label: "Target Samples";
                value_text: root.target_samples_count + "";
                minimum: SettingsModel.live_samples_min_exponent;
                maximum: SettingsModel.live_samples_max_exponent;
                step: 1;
                value <=> SettingsModel.target_samples_exponent;
                moved(val) => {
                    SettingsModel.quality_preset_index = 3;
                    SettingsModel.target_samples_changed(Math.round(val));
                }
            }
            Tooltip { text: @markdown("Target Samples: how many light paths are traced for every pixel\nbefore the picture counts as finished. More samples mean less\ngrain and a longer wait; each step doubles the number."); }
        }

        // Render Resolution: a fixed list rather than a slider -- see `resolution_index`.
        ResolutionPicker { }

        // Motion Preview Resolution, off by default. Advanced.
        if GuideModel.shows_advanced(): MotionPreviewPicker { }

        // Ray Bounces. Advanced. The ladder is Rust's (`SettingsModel.bounce_ladder`);
        // `bounces_picker.slint` has the measurements behind it.
        if GuideModel.shows_advanced(): BouncesPicker { }

        // Denoise live view: the same app-wide switch as the remote denoise row
        // (`AppSettings::denoise_enabled`), bound to `RemoteWorkerModel.denoise_enabled` and the
        // `denoise_toggled` callback, so the two rows always agree.
        Rectangle {
            height: 30px;
            KitSwitchRow {
                label: "Denoise Live View";
                on: RemoteWorkerModel.denoise_enabled;
                toggled => { RemoteWorkerModel.denoise_toggled(!RemoteWorkerModel.denoise_enabled); }
            }
            Tooltip { text: @markdown("Denoise live view: smooth the grain out of the live picture\nwhile it builds up. Turn off to see the raw samples."); }
        }
    }

    // --- Compute -----------------------------------------------------------------------------
    // Where the live image is traced: first the remote worker and the Live Compute choice, then
    // this computer's engines (Local Compute, only on a GPU-capable build), shown only while this
    // computer takes part. Advanced.
    if GuideModel.shows_advanced(): KitFoldCard {
        icon: KitIcons.cpu;
        label: "Compute";
        summary: root.local_in_use
            ? "This PC · " + root.engine_name + (root.remote_in_use ? " + remote" : "")
            : "Remote only";

        LiveComputePicker { }
        if root.local_in_use: Rectangle { height: 1px; background: Theme.border-subtle; }
        if root.local_in_use: KitSummaryRow {
            icon: KitIcons.cpu;
            label: "This PC";
            dot: Theme.accent-emerald;
            detail: "Tracing with " + root.engine_name;
        }
        if root.local_in_use && SettingsModel.gpu_build: LocalComputePicker { }
    }

    // --- Ray-Traced view ---------------------------------------------------------------------
    if GuideModel.shows_advanced(): KitFoldCard {
        icon: KitIcons.sparkle;
        label: "Ray-Traced View";
        summary: (SettingsModel.ray_taps == 1 ? "no anti-aliasing" : SettingsModel.ray_taps + "× anti-aliasing") + " · fire " + (SettingsModel.ray_fire ? "on" : "off");

        HorizontalLayout {
            height: 32px;
            spacing: 10px;
            KitRowName {
                text: "Smoothing";
                full: "Anti-Aliasing";
                hint: "How many fixed sample positions per pixel the Ray-Traced\nview averages; Off uses one ray through the pixel center.";
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 32px;
                KitFillSegments {
                    width: 100%;
                    height: 100%;
                    labels: ["Off", "4×", "8×", "16×"];
                    picked: SettingsModel.ray_taps == 1 ? 0 : (SettingsModel.ray_taps == 4 ? 1 : (SettingsModel.ray_taps == 16 ? 3 : 2));
                    selected(idx) => { SettingsModel.ray_taps_selected([1, 4, 8, 16][idx]); }
                }
                Tooltip { text: @markdown("Ray-Traced Anti-Aliasing: how many fixed taps per pixel the view averages.\nOff uses one ray through the pixel center."); }
            }
        }
        Rectangle {
            height: 30px;
            KitSwitchRow {
                label: "Fire";
                on: SettingsModel.ray_fire;
                toggled => { SettingsModel.ray_fire_selected(!SettingsModel.ray_fire); }
            }
            Tooltip { text: @markdown("Separate three color rays using the material's dispersion."); }
        }
        Rectangle {
            height: ray_note.preferred-height + 4px;
            ray_note := Text {
                x: 0px;
                y: 2px;
                width: parent.width;
                text: "Ray-Traced tints by the material's spectrum in 10 nm bands and uses approximate frost; it omits polarization, double refraction, haze, zoning, edge rounding and paths beyond the bounce cap. Metrics and diagnostics use their own tracer.";
                wrap: word-wrap;
                font-size: 11px;
                color: Theme.text-muted;
            }
        }
    }

    // --- Exports -----------------------------------------------------------------------------
    // What the Export and Tilt Video dialogs open with: the values of the last run (Rust
    // remembers them when a run starts; `AppSettings::output`). A dialog keeps its own controls as
    // per-run overrides on top of them. Shown in both modes; the controls are in the dialogs.
    KitSection { label: "EXPORTS START FROM"; }
    KitCard {
        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 4px;
            padding-bottom: 4px;
            KitSummaryRow {
                icon: KitIcons.image;
                label: "Still Picture";
                detail: SettingsModel.still_output_summary;
                action: "Export…";
                action_label: "Open Export Dialog...";
                action_hint: "Open the Export dialog to change the still-picture settings.";
                action_clicked => { ExportModel.is_open = true; }
            }
            Rectangle { height: 1px; background: Theme.border-subtle; }
            KitSummaryRow {
                icon: KitIcons.film;
                label: "Tilt Video";
                detail: SettingsModel.tilt_output_summary;
                action: "Tilt…";
                action_label: "Open Tilt Video...";
                action_hint: "Open the Tilt Performance dialog, where the tilt\nvideo is exported, to change its settings.";
                action_clicked => {
                    if !TiltModel.dialog_open {
                        TiltModel.toggle_dialog();
                    }
                }
            }
        }
    }
    Text {
        text: "Each dialog opens with your last run's settings.";
        font-size: 10px;
        color: Theme.text-muted;
        overflow: elide;
    }

    // --- Library thumbnails ------------------------------------------------------------------
    // Catalogue preview thumbnails: renderer, tray, size and quality. Plain linear sliders (not
    // the samples-exponent's drag-then-round idiom) since both ranges are narrow enough for a
    // linear drag to stay fine-grained; the ranges are Rust's (`PREVIEW_SIZE_RANGE`,
    // `PREVIEW_SAMPLES_RANGE`). Advanced.
    if GuideModel.shows_advanced(): KitFoldCard {
        icon: KitIcons.library;
        label: "Library Thumbnails";
        summary: (SettingsModel.thumbnail_renderer_index == 0 ? "Path-traced" : "Ray-traced") + " · " + (SettingsModel.thumbnail_backdrop_index == 2 ? "white" : (SettingsModel.thumbnail_backdrop_index == 3 ? "black" : "grey"));

        HorizontalLayout {
            height: 32px;
            spacing: 10px;
            KitRowName {
                text: "Renderer";
                full: "Thumbnail Renderer";
                hint: "Changing the thumbnail renderer marks existing\npictures outdated once; regenerate them to use this\nchoice. Ray-Traced uses eight fixed taps with Fire.";
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 32px;
                KitFillSegments {
                    width: 100%;
                    height: 100%;
                    labels: ["Path-Traced", "Ray-Traced"];
                    picked: SettingsModel.thumbnail_renderer_index;
                    selected(idx) => { SettingsModel.thumbnail_renderer_selected(idx); }
                }
                Tooltip { text: @markdown("Changing the thumbnail renderer marks existing\npictures outdated once; regenerate them to use this\nchoice. Ray-Traced uses eight fixed taps with Fire."); }
            }
        }
        HorizontalLayout {
            height: 32px;
            spacing: 10px;
            KitRowName {
                text: "Backdrop";
                full: "Thumbnail Backdrop";
                hint: "The tray the catalogue pictures are drawn on. Grey\nsets colorless stones apart from their background;\nchanging it marks existing pictures outdated once.";
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 32px;
                // Backdrop indices: White 2, Grey 1, Black 3.
                KitFillSegments {
                    width: 100%;
                    height: 100%;
                    labels: ["White", "Grey", "Black"];
                    picked: SettingsModel.thumbnail_backdrop_index == 2 ? 0 : (SettingsModel.thumbnail_backdrop_index == 1 ? 1 : 2);
                    selected(idx) => { SettingsModel.thumbnail_backdrop_selected([2, 1, 3][idx]); }
                }
                Tooltip { text: @markdown("The tray the catalogue pictures are drawn on. Grey\nsets colorless stones apart from their background;\nchanging it marks existing pictures outdated once."); }
            }
        }
        SliderRow {
            text: "Preview Image Size";
            hint: "Preview Image Size: the width of the small pictures\nthe catalogue draws for each design, in pixels. Larger\npictures are sharper and take longer to draw.";
            value_text: Math.round(SettingsModel.preview_size_val) + "px";
            minimum: SettingsModel.preview_size_min;
            maximum: SettingsModel.preview_size_max;
            step: 16;
            value <=> SettingsModel.preview_size_val;
            edited(val) => { SettingsModel.preview_size_changed(Math.round(val)); }
        }
        if SettingsModel.thumbnail_renderer_index == 0: SliderRow {
            text: "Preview Samples";
            hint: "Preview Samples: how many light paths are traced for each pixel of a\ncatalogue picture. More samples mean less grain and a slower batch.";
            value_text: Math.round(SettingsModel.preview_spp_val) + "";
            minimum: SettingsModel.preview_samples_min;
            maximum: SettingsModel.preview_samples_max;
            step: 32;
            value <=> SettingsModel.preview_spp_val;
            edited(val) => { SettingsModel.preview_spp_changed(Math.round(val)); }
        }
    }
}
