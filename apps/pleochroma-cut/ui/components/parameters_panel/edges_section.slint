import { RenderEffectsModel } from "../../models/render_effects.slint";
import { StoneSlider } from "../kit/stone.slint";

// The Stone tab's Abraded Edges rows (inside the Girdle & Edges card): a narrow worn band along
// every facet edge, as on a stone that has been worn or knocked about. The first slider is the
// band's width (0 is off), the second how rough the band is. Both are saved in the design as one
// undoable step.
export component EdgesSection inherits VerticalLayout {
    in property <string> saved_note;

    spacing: 6px;

    StoneSlider {
        label: "Abraded Edges";
        hint: "Abraded edges: the width of the worn band along the\nfacet edges. 0 is off: sharp, clean edges." + root.saved_note;
        value_text: RenderEffectsModel.edge_width <= 0.0 ? "Off" : Math.round(RenderEffectsModel.edge_width * 1000.0) / 1000.0 + "";
        minimum: 0.0;
        maximum: 0.1;
        step: 0.001;
        value <=> RenderEffectsModel.edge_width;
        moved(val) => { RenderEffectsModel.edges_edited(); }
    }

    if RenderEffectsModel.edge_width > 0.0: StoneSlider {
        label: "Edge Wear";
        hint: "Edge wear: how rough the worn band is. A low value is a\nlightly dulled edge, a high one a rough, frosted edge." + root.saved_note;
        value_text: Math.round(RenderEffectsModel.edge_wear * 100.0) / 100.0 + "";
        minimum: 0.0;
        maximum: 1.0;
        value <=> RenderEffectsModel.edge_wear;
        moved(val) => { RenderEffectsModel.edges_edited(); }
    }
}
