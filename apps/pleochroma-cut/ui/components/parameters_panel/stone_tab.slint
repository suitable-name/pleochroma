import { ComboBox, LineEdit } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { SettingsModel } from "../../models/settings.slint";
import { ViewportModel } from "../../models/viewport.slint";
import { EditorModel } from "../../models/editor.slint";
import { GuideModel } from "../../models/guide.slint";
import { ParametersModel } from "../../models/parameters.slint";
import { BodyColorEditorModel } from "../../models/body_color_editor.slint";
import { PhysicscolorModel } from "../../models/physics_color.slint";
import { Zoning } from "../../models/zoning.slint";
import { CrystalAxisModel } from "../../models/crystal_axis.slint";
import { RenderEffectsModel } from "../../models/render_effects.slint";
import { CrystalAxisSection } from "../settings_dialog/crystal_axis_section.slint";
import { SettingLabel } from "../settings_dialog/setting_label.slint";
import { TipButton } from "../compact_controls.slint";
import { ChipToggle } from "../chip_toggle.slint";
import { AdvancedNote } from "../advanced_note.slint";
import { MaterialGuessBadge } from "../material_guess.slint";
import { LchEditor } from "../material_editor/lch_editor.slint";
import { RenderColorControl } from "../gem_viewport/render_color_picker.slint";
import { PreviewBadge } from "../material_chip.slint";
import { SolidPreviewModel } from "../../models/solid_preview.slint";
import { KitButton, KitCard, KitFoldCard, KitIcon, KitIconButton, KitIcons, KitSection, KitSwatch } from "../kit/kit.slint";
import { StoneChip, StoneChipButton, StoneColorTile, StoneMenuItem, StoneSlider, StoneSwitchRow } from "../kit/stone.slint";
import { InclusionsSection } from "inclusions_section.slint";
import { StructureSection } from "structure_section.slint";
import { EdgesSection } from "edges_section.slint";

// A small picture of the stone's color pattern: three bands along the axis, in the stone's color.
component PatternThumb inherits Rectangle {
    in property <color> tone;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    clip: true;
    background: Theme.swatch-empty;
    Rectangle { background: root.tone; }
    Rectangle { x: 13px; width: 14px; height: parent.height; background: Theme.text-primary.with-alpha(0.35); }
    Rectangle { x: 0px; width: 6px; height: parent.height; background: Theme.surface-sunken.with-alpha(0.45); }
    Rectangle { x: 34px; width: 6px; height: parent.height; background: Theme.surface-sunken.with-alpha(0.45); }
    Rectangle { border-radius: 8px; border-width: 1px; border-color: Theme.chip-edge; }
}

// The material facts under the identity chips: SG, Mohs and Toughness as the same chips, one
// cleavage line (a warning when it is a cutting risk: perfect, good or distinct), and for a
// custom material with no data one muted line that leads to the Material Editor. A value no source
// fills is left out, never "Not recorded". Care, fracture and sources live on the details page.
component GemFacts inherits VerticalLayout {
    in property <bool> editable: true;
    spacing: 8px;
    if EditorModel.gem_sg != "" || EditorModel.gem_mohs != "" || EditorModel.gem_toughness != "": HorizontalLayout {
        spacing: 6px;
        alignment: start;
        if EditorModel.gem_sg != "": StoneChip {
            text: "SG " + EditorModel.gem_sg;
            label: "Specific gravity " + EditorModel.gem_sg;
            hint: "Specific gravity: the density of the material compared with water. It sets the carat weight.";
        }
        if EditorModel.gem_mohs != "": StoneChip {
            text: "Mohs " + EditorModel.gem_mohs;
            label: "Mohs hardness " + EditorModel.gem_mohs;
            hint: "Mohs is an order of scratch hardness, not a measure.";
        }
        if EditorModel.gem_toughness != "": StoneChip {
            text: EditorModel.gem_toughness;
            label: EditorModel.gem_toughness;
            hint: "How well the stone resists chipping and breaking.";
        }
    }
    if EditorModel.gem_cleavage != "": HorizontalLayout {
        spacing: 6px;
        alignment: start;
        accessible-role: AccessibleRole.text;
        accessible-label: "Cleavage: " + EditorModel.gem_cleavage;
        if EditorModel.gem_cleavage_warns: VerticalLayout {
            alignment: center;
            KitIcon { d: KitIcons.warn; size: 13px; ink: Theme.accent-amber; }
        }
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: "Cleavage: " + EditorModel.gem_cleavage;
            font-size: 11px;
            color: EditorModel.gem_cleavage_warns ? Theme.accent-amber : Theme.text-muted;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if EditorModel.gem_empty: HorizontalLayout {
        spacing: 4px;
        alignment: start;
        Text {
            text: "No gem data yet \u{2014}";
            font-size: 11px;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
        Rectangle {
            width: empty_link.preferred-width;
            empty_link := Text {
                text: "add it in the Material Editor";
                font-size: 11px;
                color: Theme.accent-cyan;
                vertical-alignment: center;
            }
            TouchArea {
                enabled: root.editable;
                mouse-cursor: pointer;
                accessible-role: AccessibleRole.button;
                accessible-label: "Edit Material...";
                accessible-description: "Open the Material Editor to enter this material's hardness, toughness, cleavage, fracture, care and source.";
                clicked => { ViewportModel.material_editor_open = true; }
            }
        }
    }
}

// The Parameters dock's Stone tab: everything about the stone itself, in one place. The design
// is the single source of truth. Top to bottom: the material (an identity card whose chips and
// cleavage line give its refractive index, density, hardness and toughness, with a "Material
// Details..." button for the rest), the color (swatch tiles and the color pattern), the size and the material effects (folding cards that sum up
// their values; which are open is remembered, `ParametersModel.stone_folds`).
//
//  * Material: the design's material, refractive index, body color (one control each; they are
//    undoable design edits and apply at once). "Preview as..." is the only way to look at another
//    material: it is view only, never starts by itself, shows an amber badge here, in both
//    viewport toolbars and in the export dialogs, and "Back to design" ends it. The card's "..."
//    menu holds RI Override (a click on the RI chip opens it too), New/Edit Material and, while a
//    preview runs, Preview Color.
//  * Size: one "Stone width" field, the design's girdle diameter (the Preform tab's Girdle
//    Diameter is the same value).
//  * Material effects: inclusion haze, crystal axis, frosted girdle and edge rounding are stored
//    in the design (`Edit::SetRenderEffects`); a drag is shown at once and written to the design
//    when it pauses (`gui::editor::callbacks::tier_actions::viewport_material`).
//
// A library design showing in Live Render is not editable, so there is no design material to
// change. The tab then has the same layout with a "View only" chip: a material and a color to look
// at it in (remembered as the app preference, never saved with the design) and view-only effects
// that start from the defaults and are not saved either. The "Previewing" badge does not appear,
// because there is no design material to differ from. As soon as the design is opened in the Edit
// tab, the design's own values apply.
export component StoneTab inherits VerticalLayout {
    // The open design is what the viewport shows, so its controls apply.
    property <bool> design_shown: EditorModel.enabled && EditorModel.has_design && ViewportModel.shows_editor_design;
    // A library design is what the viewport shows: view-only choices.
    property <bool> library_shown: !ViewportModel.shows_editor_design;
    // The library card shows the material facts only while they describe the material on show.
    property <bool> lib_facts_shown: EditorModel.gem_card_shown && EditorModel.gem_name == ViewportModel.traced_material_name;
    // The worked-example guide can lock the design's material controls.
    property <bool> unlocked: GuideModel.allows_design_settings();
    property <bool> advanced: GuideModel.shows_advanced();
    // The body color override does not apply to a physics or zoned material.
    property <bool> color_enabled: root.unlocked && !EditorModel.design_material_is_physics && !EditorModel.design_material_is_zoned;
    // A Ray-Traced view is showing (the Edit tab's or the Live Render tab's): it draws neither
    // Inclusions nor Play-of-Color, and the groups say so.
    property <bool> ray_traced: ViewportModel.live_view_mode == 2 || SolidPreviewModel.ray_selected;
    // The inline color editor under the swatch tiles ("Custom").
    property <bool> color_picker_open: false;
    // The identity card's "..." menu, the RI override row and the preview color row.
    in-out property <bool> menu_open: false;
    in-out property <bool> ri_open: false;
    property <bool> preview_color_open: false;
    // Which effect cards are open (mirrors `ParametersModel.stone_folds`, read when the tab mounts).
    property <bool> fold_axis: false;
    property <bool> fold_edges: false;
    property <bool> fold_clarity: false;
    property <bool> fold_structure: false;
    // The closing sentence of the effect hints: where the value lives.
    property <string> saved_note: root.library_shown
        ? "\nNot saved: view only for a library design."
        : "\nSaved in the design.";
    // The material's name on the identity card.
    property <string> material_name: EditorModel.material_combo_options[EditorModel.material_combo_index] == "(none)"
        ? "No material"
        : EditorModel.material_combo_options[EditorModel.material_combo_index];
    property <int> tile_count: EditorModel.body_color_options.length;
    // The face-up color of the chosen entry (the identity card's swatch).
    property <color> body_swatch: EditorModel.body_color_swatches[EditorModel.body_color_index];

    pure function bit_set(mask: int, bit: int) -> bool {
        return Math.mod(Math.floor(mask / bit), 2) == 1;
    }

    // The summaries of the folding effect cards.
    property <string> axis_summary: !SettingsModel.c_axis_override_available
        ? "Isotropic: no axis"
        : (SettingsModel.c_axis_override_enabled
            ? "Set for this stone · tilt " + Math.round(SettingsModel.c_axis_tilt_deg) + "°"
            : "As material");
    property <string> edges_summary: (SettingsModel.girdle_frosted ? "Frosted" : "Polished") + " · "
        + (SettingsModel.edge_rounding_radius > 0.0 ? "rounded" : (RenderEffectsModel.edge_width > 0.0 ? "worn" : "sharp"));
    property <string> clarity_summary: (SettingsModel.inclusion_sigma_s <= 0.0 ? "No haze" : "Haze " + Math.round(SettingsModel.inclusion_sigma_s * 100.0) / 100.0)
        + " · " + (RenderEffectsModel.inclusion_preset == "" ? "silk: none" : RenderEffectsModel.inclusion_preset);
    property <string> structure_summary: RenderEffectsModel.structure_available
        ? (RenderEffectsModel.structure_on ? "On" : "Off")
        : "Part of the material";

    init => {
        root.fold_axis = root.bit_set(ParametersModel.stone_folds, 1);
        root.fold_edges = root.bit_set(ParametersModel.stone_folds, 2);
        root.fold_clarity = root.bit_set(ParametersModel.stone_folds, 4);
        root.fold_structure = root.bit_set(ParametersModel.stone_folds, 8);
    }

    spacing: 14px;
    // The ScrollView stretches this layout to at least the visible height. Without `start`, a
    // short tab (a library design) spreads that extra height over every row.
    alignment: start;

    if !root.design_shown && !root.library_shown: Text {
        text: "Open or create a design to set its material, size and effects.";
        font-size: 11px;
        color: Theme.text-muted;
        wrap: word-wrap;
        accessible-role: AccessibleRole.text;
    }

    // --- A library design: the same layout, view only ------------------------------------
    if root.library_shown: VerticalLayout {
        spacing: 14px;

        KitCard {
            height: lib_card.preferred-height;
            accessible-role: AccessibleRole.text;
            accessible-label: "Library design: shown as " + ViewportModel.traced_material_name;
            lib_card := VerticalLayout {
                padding: 12px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 52px;
                        height: 52px;
                        border-radius: 10px;
                        background: Theme.bg-input;
                        KitIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            d: KitIcons.gem;
                            size: 24px;
                            ink: Theme.text-secondary;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: ViewportModel.traced_material_name;
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            alignment: start;
                            StoneChip {
                                text: "View only";
                                ink: Theme.accent-amber;
                                fill: Theme.surface-warning;
                                hint: "A library design is not editable here. Nothing on this tab is saved with it. Open it in the Edit tab to give it its own material, color and width.";
                            }
                        }
                    }
                }
                // The facts of the material on show (they wait for the data of that very material).
                if root.lib_facts_shown && EditorModel.gem_ri != "": HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    StoneChip {
                        text: "RI " + EditorModel.gem_ri;
                        label: "Refractive Index " + EditorModel.gem_ri;
                        hint: "Refractive index (RI) of the material this library design is shown in. See the glossary.";
                    }
                    StoneChip {
                        text: "Critical " + EditorModel.gem_critical;
                        label: "Critical Angle " + EditorModel.gem_critical;
                        hint: "Critical angle: below this angle light leaks out of a pavilion facet. See the glossary.";
                    }
                    if EditorModel.gem_dispersion != "": StoneChip {
                        text: "Dispersion " + EditorModel.gem_dispersion;
                        label: "Dispersion " + EditorModel.gem_dispersion;
                        hint: "Dispersion in the B-G convention: how widely the material spreads white light into colors. See the glossary.";
                    }
                }
                if root.lib_facts_shown: GemFacts { editable: false; }
                VerticalLayout {
                    spacing: 3px;
                    SettingLabel {
                        text: "Material";
                        hint: "The material to look at this library design in. It is a\nview only: the library design is not changed and nothing is\nsaved with it. Your choice is remembered for next time. To\ngive a design its own material, open it in the Edit tab.";
                    }
                    Rectangle {
                        height: 32px;
                        ComboBox {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            model: ViewportModel.material_options;
                            current-index <=> ViewportModel.selected_material_index;
                            accessible-label: "Show the Library Design As";
                            accessible-description: "View only. The library design is not changed. Your choice is remembered as the material library designs are shown in.";
                            selected(val) => { ViewportModel.library_material_chosen(val); }
                        }
                    }
                }
                if root.lib_facts_shown: HorizontalLayout {
                    alignment: end;
                    KitButton {
                        kind: 2;
                        icon: KitIcons.gem;
                        h: 28px;
                        text: "Material Details...";
                        hint: "Open the Material Reference on " + ViewportModel.traced_material_name + ": its curves, spectra, colors and gem data.";
                        clicked => { EditorModel.open_material_reference(ViewportModel.traced_material_name); }
                    }
                }
            }
        }

        KitSection { label: "COLOR"; }
        VerticalLayout {
            spacing: 3px;
            SettingLabel {
                text: "Color";
                hint: "Look at this library design in another color of the same\nmaterial. Only the picture changes; the library design is\nnot touched. Your choice is remembered for next time.";
            }
            HorizontalLayout {
                render-color-control-l113 := RenderColorControl { }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        KitSection { label: "SIZE"; }
        HorizontalLayout {
            spacing: 10px;
            Text {
                width: 104px;
                text: "Stone width";
                font-size: 12px;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                text: "7 mm, the default for a library design. Open the design in the Edit tab to set its width.";
                font-size: 10px;
                color: Theme.text-muted;
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }
        }
    }

    // --- The open design: material, color, size -----------------------------------------
    if root.design_shown: VerticalLayout {
        spacing: 14px;

        if ViewportModel.previewing: PreviewBadge { row_height: 36px; }

        // The identity card: the material at a glance. The "..." menu holds the rarer actions.
        KitCard {
            height: id_card.preferred-height;
            id_card := VerticalLayout {
                padding: 12px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 12px;
                    KitSwatch { a: root.body_swatch; b: root.body_swatch; split: false; size: 52px; }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.material_name;
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            overflow: elide;
                        }
                        if EditorModel.material_family_text != "": Text {
                            text: EditorModel.material_family_text;
                            font-size: 11px;
                            color: Theme.text-muted;
                            overflow: elide;
                        }
                    }
                    VerticalLayout {
                        alignment: start;
                        KitIconButton {
                            d: KitIcons.more;
                            size: 28px;
                            icon_size: 16px;
                            active: root.menu_open;
                            label: "Material Menu";
                            hint: "RI Override, New/Edit Material, Material Reference and, while previewing, the preview color.";
                            clicked => {
                                EditorModel.text_focus = false;
                                root.menu_open = !root.menu_open;
                            }
                        }
                    }
                }

                // Refractive index, critical angle and dispersion. The RI chip opens the override.
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    if root.advanced: StoneChipButton {
                        text: "RI " + (EditorModel.effective_ri_text == "" ? "-" : EditorModel.effective_ri_text);
                        label: "Effective Refractive Index " + (EditorModel.effective_ri_text == "" ? "not known" : EditorModel.effective_ri_text);
                        hint: "Effective refractive index (RI) in use, after any override. Click to type your own RI. See the glossary.";
                        active: root.ri_open;
                        clicked => { root.ri_open = !root.ri_open; }
                    }
                    if !root.advanced: StoneChip {
                        text: "RI " + (EditorModel.effective_ri_text == "" ? "-" : EditorModel.effective_ri_text);
                        label: "Effective Refractive Index " + (EditorModel.effective_ri_text == "" ? "not known" : EditorModel.effective_ri_text);
                        hint: "Effective refractive index (RI) in use, after any override. See the glossary.";
                    }
                    StoneChip {
                        text: "Critical " + (EditorModel.critical_angle_text == "" ? "-" : EditorModel.critical_angle_text);
                        label: "Critical Angle " + (EditorModel.critical_angle_text == "" ? "not known" : EditorModel.critical_angle_text);
                        hint: "Critical angle: below this angle light leaks out of a pavilion\nfacet instead of bouncing back (see the tier list's MARGIN\ncolumn). It follows from the refractive index. See the glossary.";
                    }
                    if EditorModel.material_dispersion_text != "": StoneChip {
                        text: "Dispersion " + EditorModel.material_dispersion_text;
                        label: "Dispersion " + EditorModel.material_dispersion_text;
                        hint: EditorModel.material_dispersion_tip;
                    }
                }

                // SG, Mohs, Toughness and the cleavage line (the former Gem Data card).
                if EditorModel.gem_card_shown: GemFacts { editable: root.unlocked; }

                // The "..." menu, an inline list under the chips.
                if root.menu_open: Rectangle {
                    height: menu_col.preferred-height + 8px;
                    background: Theme.surface-sunken;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border-dialog;
                    menu_col := VerticalLayout {
                        padding: 4px;
                        spacing: 2px;
                        if root.advanced: StoneMenuItem {
                            text: "RI Override";
                            hint: "Type your own refractive index instead of the material's.";
                            enabled: root.unlocked;
                            on: root.ri_open;
                            clicked => { root.ri_open = !root.ri_open; }
                        }
                        StoneMenuItem {
                            text: "New/Edit Material...";
                            hint: "Open the material editor to make your own material (a name, a refractive\nindex and optionally color and dispersion) or change one you made.";
                            enabled: root.unlocked;
                            clicked => {
                                root.menu_open = false;
                                ViewportModel.material_editor_open = true;
                            }
                        }
                        StoneMenuItem {
                            text: "Material Reference...";
                            hint: "Open the Material Reference window on this material: the table of every\nmaterial, with its curves, spectra, colors and gem data.";
                            clicked => {
                                root.menu_open = false;
                                EditorModel.open_material_reference(EditorModel.gem_name != "" ? EditorModel.gem_name : root.material_name);
                            }
                        }
                        if ViewportModel.previewing: StoneMenuItem {
                            text: "Preview Color";
                            hint: "Try another color on the preview material. Only this view\nchanges; the design is not touched. Back to Design clears it.";
                            on: root.preview_color_open;
                            clicked => { root.preview_color_open = !root.preview_color_open; }
                        }
                    }
                }

                // The RI override: Enter applies. Advanced mode only.
                if root.advanced && root.ri_open: VerticalLayout {
                    spacing: 3px;
                    SettingLabel {
                        text: "RI Override";
                        hint: "Refractive index (RI): how strongly the stone bends light.\nLeave this blank to use the material's own value, or type\nyour own (above 1, for example 1.76). Press Enter to apply.\nIt moves the critical angle. See the glossary.";
                    }
                    LineEdit {
                        enabled: root.unlocked;
                        text <=> EditorModel.ri_override_text;
                        placeholder-text: "auto";
                        accessible-label: "Refractive Index Override";
                        accessible-description: "Blank uses the material's own refractive index. Press Enter to apply.";
                        accepted => {
                            EditorModel.apply_design_material(EditorModel.material_combo_index, EditorModel.ri_override_text, EditorModel.body_color_index);
                        }
                        changed has-focus => { EditorModel.text_focus = self.has-focus; }
                    }
                }
                if !root.advanced && EditorModel.ri_override_text != "": AdvancedNote { }

                // The preview color: only while a preview runs.
                if root.menu_open && root.preview_color_open && ViewportModel.previewing: VerticalLayout {
                    spacing: 3px;
                    SettingLabel {
                        text: "Preview Color";
                        hint: "Try another color on the preview material. Only this view\nchanges; the design is not touched. Back to Design clears it.";
                    }
                    HorizontalLayout {
                        render-color-control-l344 := RenderColorControl { }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                // Change the material, or preview another one (view only).
                HorizontalLayout {
                    spacing: 8px;
                    // Two equal columns (preferred-width 0 and stretch 1 split the width 1:1). A
                    // ComboBox measures its widest entry, so each sits in a 32 px Rectangle that
                    // clips it to its column instead of pushing the second one past the card.
                    VerticalLayout {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        min-width: 0px;
                        spacing: 3px;
                        SettingLabel {
                            text: "Material";
                            hint: "The design's material: built-ins first, then your own custom\nmaterials, then \"Custom RI...\" for a refractive index you type.\nIt sets the critical angle, the optimizer's targets, the tilt\ncurves and the picture. Changing it is one step you can undo.";
                        }
                        Rectangle {
                            height: 32px;
                            ComboBox {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: parent.height;
                                enabled: root.unlocked;
                                model: EditorModel.material_combo_options;
                                current-index <=> EditorModel.material_combo_index;
                                accessible-label: "Material";
                                accessible-description: "The design's material. Changing it applies at once and can be undone.";
                                selected => {
                                    EditorModel.apply_design_material(EditorModel.material_combo_index, EditorModel.ri_override_text, EditorModel.body_color_index);
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        min-width: 0px;
                        spacing: 3px;
                        SettingLabel {
                            text: "Preview As...";
                            hint: "Look at this stone in another material without changing\nthe design. While you preview, the picture, exports and\ntilt videos use that material, and a banner stays on until\nyou press Back to design. It never starts by itself.";
                        }
                        Rectangle {
                            height: 32px;
                            ComboBox {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: parent.height;
                                enabled: root.unlocked;
                                model: ViewportModel.material_options;
                                current-index <=> ViewportModel.selected_material_index;
                                accessible-label: "Preview as Another Material";
                                accessible-description: "View only. The design keeps its own material. Back to design returns.";
                                selected(val) => { ViewportModel.preview_material_chosen(val); }
                            }
                        }
                    }
                }
                if ViewportModel.previewing: Text {
                    text: "Previewing: the design keeps its own material.";
                    font-size: 10px;
                    color: Theme.accent-amber;
                    wrap: word-wrap;
                    accessible-role: AccessibleRole.text;
                }

                // Care, fracture, sources and the weight live on the details page.
                if EditorModel.gem_card_shown: HorizontalLayout {
                    alignment: end;
                    KitButton {
                        kind: 2;
                        icon: KitIcons.gem;
                        h: 28px;
                        text: "Material Details...";
                        hint: "Open the Material Reference on " + EditorModel.gem_name + ": its curves, spectra, colors and gem data.";
                        clicked => { EditorModel.open_material_reference(EditorModel.gem_name); }
                    }
                }
            }
        }

        // The inferred-material guess badge (nothing while the design names its material). Mounted
        // only with a guess: a hidden badge would still take its row and leave a gap.
        if EditorModel.material_guess_text != "": MaterialGuessBadge { }

        // --- Color ----------------------------------------------------------------------
        KitSection { label: "COLOR"; }

        VerticalLayout {
            spacing: 8px;

            // The body color of the design: the material's own color, its variants, a few generic
            // colors and Custom, as tiles five to a row. Picking one is a design edit (one undo
            // step); Custom opens the color editor under the tiles.
            Rectangle {
                height: tiles.preferred-height;
                accessible-role: AccessibleRole.list;
                accessible-label: "Body Color";
                accessible-description: "The color this design is shown in: the material's own color, one of its color variants or a generic color. The last entry, Custom, opens an editor for tone, saturation and hue.";
                tiles := VerticalLayout {
                    spacing: 8px;
                    for r in Math.ceil(root.tile_count / 5): HorizontalLayout {
                        spacing: 7px;
                        for k in 5: VerticalLayout {
                            horizontal-stretch: 1;
                            preferred-width: 0px;
                            min-width: 0px;
                            if r * 5 + k < root.tile_count: StoneColorTile {
                                swatch: EditorModel.body_color_swatches[r * 5 + k];
                                swatch2: EditorModel.body_color_swatches_across[r * 5 + k];
                                split: r * 5 + k < EditorModel.body_color_swatches_across.length;
                                text: EditorModel.body_color_options[r * 5 + k] == "Material Default"
                                    ? "Default"
                                    : (r * 5 + k == root.tile_count - 1 ? "Custom" : EditorModel.body_color_options[r * 5 + k]);
                                label: EditorModel.body_color_options[r * 5 + k];
                                hint: EditorModel.body_color_tips[r * 5 + k];
                                custom: r * 5 + k == root.tile_count - 1;
                                on: EditorModel.body_color_index == r * 5 + k;
                                enabled: root.color_enabled;
                                picked => {
                                    EditorModel.body_color_index = r * 5 + k;
                                    if r * 5 + k == root.tile_count - 1 {
                                        root.color_picker_open = true;
                                        BodyColorEditorModel.target = 0;
                                        BodyColorEditorModel.open_requested();
                                    } else {
                                        root.color_picker_open = false;
                                        EditorModel.apply_design_material(EditorModel.material_combo_index, EditorModel.ri_override_text, EditorModel.body_color_index);
                                    }
                                }
                            }
                            if r * 5 + k >= root.tile_count: Rectangle { }
                        }
                    }
                }
            }

            // The chosen entry's name and what it looks like (for a stone with two or three
            // colors, the color of each direction).
            if !root.color_picker_open && EditorModel.body_color_options.length > 0: HorizontalLayout {
                spacing: 6px;
                Text {
                    text: EditorModel.body_color_options[EditorModel.body_color_index] == "Material Default"
                        ? "Default"
                        : EditorModel.body_color_options[EditorModel.body_color_index];
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    text: EditorModel.body_color_tips[EditorModel.body_color_index];
                    font-size: 11px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: AccessibleRole.text;
                }
            }

            // The design holds a snapshot of a saved variant that was edited since.
            if EditorModel.body_color_variant_stale && !root.color_picker_open: HorizontalLayout {
                spacing: 6px;
                Text {
                    text: "Variant Changed";
                    font-size: 10px;
                    color: Theme.accent-amber;
                    vertical-alignment: center;
                    accessible-role: AccessibleRole.text;
                }
                TipButton {
                    enabled: root.unlocked;
                    text: "Update";
                    hint: "The saved variant this design uses was changed after it was picked. Copy its current color into this design. It is one step you can undo.";
                    clicked => { EditorModel.update_body_color_variant(); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if EditorModel.body_color_index == EditorModel.body_color_options.length - 1 && !root.color_picker_open: tip-button-busy := TipButton {
                enabled: root.color_enabled;
                text: BodyColorEditorModel.busy ? "Matching..." : "Choose Color...";
                hint: "Open the color editor to choose the tone,\nsaturation and hue of this design's color (of each\ndirection, for a stone that shows several colors).";
                clicked => {
                    root.color_picker_open = true;
                    BodyColorEditorModel.target = 0;
                    BodyColorEditorModel.open_requested();
                }
            }
            if root.color_picker_open: VerticalLayout {
                spacing: 4px;
                Text {
                    text: BodyColorEditorModel.axis_labels.length > 1
                        ? "Tone, saturation and hue of each direction of the stone's color. It depends on the size of the stone. The closest color the material model can reach is used. It changes this design and you can undo it."
                        : "Tone, saturation and hue of the color. It depends on the size of the stone. The closest color the material model can reach is used. It changes this design and you can undo it.";
                    font-size: 10px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                    accessible-role: AccessibleRole.text;
                }
                LchEditor {
                    enabled: root.color_enabled;
                    applied => { root.color_picker_open = false; }
                    cancelled => { root.color_picker_open = false; }
                }
            }
            // The legacy-color note: an old design keeps the single color it was saved with on a
            // material whose own color depends on the direction. It renders as saved; Convert
            // opens the color editor with that color on every direction.
            if EditorModel.body_color_legacy_note && !root.color_picker_open: VerticalLayout {
                spacing: 3px;
                Text {
                    text: "Legacy Color: No Pleochroism. This design keeps the single color it was saved with, so the stone shows the same color in every direction.";
                    font-size: 10px;
                    color: Theme.accent-amber;
                    wrap: word-wrap;
                    accessible-role: AccessibleRole.text;
                }
                HorizontalLayout {
                    spacing: 6px;
                    TipButton {
                        enabled: root.color_enabled;
                        text: "Convert...";
                        hint: "Open the color editor with this color on every direction of the stone.\nSet a different color for each direction to bring back the\nstone's color shading by direction (pleochroism). Nothing changes\nuntil you apply it, and you can undo it.";
                        clicked => {
                            root.color_picker_open = true;
                            BodyColorEditorModel.target = 0;
                            BodyColorEditorModel.open_requested();
                        }
                    }
                    TipButton {
                        enabled: root.color_enabled;
                        text: "Nearest Variant";
                        hint: "Replace this color with the variant of the material whose color is closest to it\n(the material's own color counts too). The stone then shows its color\nshading by direction. It is one step you can undo.";
                        clicked => { EditorModel.convert_to_nearest_variant(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            // The zoned-material note: its color is its zones, so the override is unavailable.
            if EditorModel.design_material_is_zoned: Text {
                text: "This material's color comes from its zones. Use Color Pattern below to change this stone's zones.";
                font-size: 10px;
                color: Theme.text-muted;
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }
            // The physics-color indicator: this material brings its own color.
            if EditorModel.design_material_is_physics: Text {
                text: EditorModel.physics_override_conflict
                    ? (PhysicscolorModel.ui_enabled
                        ? "A color override is set and replaces this material's physical color. Choose \"Material Default\" to restore it."
                        : "A color override is set and replaces this material's own color. Choose \"Material Default\" to restore it.")
                    : (PhysicscolorModel.ui_enabled
                        ? "This material has a physical color. A color override would replace it, so it is unavailable."
                        : "This material defines its own color.");
                font-size: 10px;
                color: EditorModel.physics_override_conflict ? Theme.accent-amber : Theme.text-muted;
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }
        }

        // The color pattern: the zones of the stone's color, and the typical ones of its species.
        KitCard {
            height: pat_card.preferred-height;
            pat_card := VerticalLayout {
                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 10px;
                    PatternThumb { tone: root.body_swatch; }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "Color Pattern";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: Zoning.stone_pattern_hint;
                            font-size: 10px;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                            accessible-role: AccessibleRole.text;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        TipButton {
                            enabled: root.unlocked && Zoning.stone_pattern_enabled && !Zoning.pattern_editor_open;
                            text: "Edit...";
                            reader_label: "Color Pattern...";
                            hint: Zoning.stone_pattern_hint;
                            clicked => { Zoning.edit_stone_pattern(); }
                        }
                    }
                }

                // The typical zoning of the stone's species: one click each, in the stone's own color.
                if Zoning.typical_pattern_labels.length > 0: VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: Zoning.typical_pattern_busy ? "Matching..." : "Typical Zoning for " + Zoning.typical_pattern_species;
                        font-size: 10px;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                        accessible-role: AccessibleRole.text;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for entry[i] in Zoning.typical_pattern_labels: ChipToggle {
                            text: entry;
                            hint: "Zone this stone the way a " + Zoning.typical_pattern_species + " is typically zoned: " + entry + ".\nIt uses the stone's own color, replaces its zones and can be undone.\nEdit it afterward with Color Pattern.";
                            active: Zoning.typical_pattern_index == i;
                            enabled: root.unlocked && Zoning.stone_pattern_enabled && !Zoning.pattern_editor_open && !Zoning.typical_pattern_busy;
                            toggled => { Zoning.apply_typical_pattern(i); }
                        }
                    }
                }

                // Layers across the Crystal Axis lie flat while the axis runs through the table: one
                // color in the crown, another in the pavilion, blended face up. One tap lays the axis
                // in the table plane, the way such stones are cut.
                if Zoning.pattern_layers_across_axis && (SettingsModel.c_axis_override_enabled ? SettingsModel.c_axis_tilt_deg : Zoning.material_axis_tilt_deg) < 30: VerticalLayout {
                    spacing: 3px;
                    Text {
                        text: "The color layers lie parallel to the table, so face up the colors blend. Lay the Crystal Axis in the table plane to show them side by side.";
                        font-size: 10px;
                        color: Theme.accent-amber;
                        wrap: word-wrap;
                        accessible-role: AccessibleRole.text;
                    }
                    TipButton {
                        enabled: root.unlocked;
                        text: "Lay Axis in Table Plane";
                        hint: "Set this stone's Crystal Axis to In the Table Plane.\nThe color layers then stand upright and show side by side face up.";
                        clicked => { CrystalAxisModel.geometry_preset_chosen(1); }
                    }
                }
                if Zoning.stone_pattern_overridden: HorizontalLayout {
                    alignment: start;
                    TipButton {
                        enabled: root.unlocked && !Zoning.pattern_editor_open;
                        text: "Reset to Material Pattern";
                        hint: "Remove this stone's pattern override and use\nits material's original color and zones.";
                        clicked => { Zoning.reset_stone_pattern(); }
                    }
                }
            }
        }

        // --- Size -----------------------------------------------------------------------
        // One stone width: the design's girdle diameter. Typing sets it in the design (one undo
        // step); the Preform tab's Girdle Diameter is the same value.
        KitSection { label: "SIZE"; }
        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 10px;
                height: 32px;
                SettingLabel {
                    width: 104px;
                    text: "Stone width";
                    hint: "The width of the stone across the girdle in millimetres. A bigger\nstone is physically deeper in color (twice the width, twice the\noptical density); the built-in colors are tuned for about 7 mm. It\nis saved in the design, you can undo it, and it is the same value\nas the Girdle Diameter in the Preform tab. You can type arithmetic,\nfor example 6.5+0.25. Press Enter to apply; blank clears it.";
                }
                LineEdit {
                    enabled: root.unlocked;
                    width: 110px;
                    text <=> EditorModel.girdle_diameter_mm;
                    placeholder-text: "not set";
                    accessible-label: "Stone Width in Millimetres";
                    accessible-description: "The design's girdle diameter. Press Enter to apply.";
                    accepted => { EditorModel.apply_stone_width(EditorModel.girdle_diameter_mm); }
                    changed has-focus => {
                        EditorModel.text_focus = self.has-focus;
                        if !self.has-focus {
                            EditorModel.apply_stone_width(EditorModel.girdle_diameter_mm);
                        }
                    }
                }
                Text {
                    text: "mm";
                    font-size: 11px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Text {
                // Reads the design's own value (pushed from Rust), never the scratch text, which
                // the Preform tab can also hold unapplied.
                // A committed width re-seeds the scratch with the design's text; "7" against
                // "7.0000" is the same value.
                text: (EditorModel.girdle_diameter_mm != EditorModel.design_girdle_diameter_text
                        && (EditorModel.girdle_diameter_mm == "" || EditorModel.design_girdle_diameter_text == ""
                            || EditorModel.girdle_diameter_mm.to-float() != EditorModel.design_girdle_diameter_text.to-float()))
                    ? "Not applied yet: press Enter to set it in the design."
                    : (EditorModel.design_girdle_diameter_text == ""
                        ? "Not set in the design: colors are shown for 7 mm. Type a width to set it."
                        : "Saved in the design: " + EditorModel.design_girdle_diameter_text + " mm. A larger stone looks deeper in color.");
                font-size: 10px;
                color: Theme.text-muted;
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }
            Text {
                text: "The same value as Girdle Diameter in the Preform tab (Edit view).";
                font-size: 10px;
                color: Theme.text-muted;
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }
        }
    }

    // --- The effects: the open design's (saved in it), or a library design's view-only values --
    if root.design_shown || root.library_shown: VerticalLayout {
        spacing: 8px;

        KitSection {
            label: "MATERIAL EFFECTS";
            Rectangle { horizontal-stretch: 1; }
            if root.library_shown: VerticalLayout {
                alignment: center;
                StoneChip {
                    height: 18px;
                    text: "Not saved";
                    ink: Theme.accent-amber;
                    fill: Theme.surface-warning;
                    hint: "These effects are for looking only. They start from the defaults for every library design and are lost when you open another design. Open the design in the Edit tab to save effects with it.";
                }
            }
        }

        // Crystal Axis Orientation (off, "As Material", by default; isotropic: nothing to turn).
        KitFoldCard {
            icon: KitIcons.axis;
            label: "Crystal Axis";
            summary: root.axis_summary;
            open <=> root.fold_axis;
            toggled(o) => { ParametersModel.stone_fold_set(1, o); }
            CrystalAxisSection { }
        }

        // Frosted girdle, edge rounding and abraded edges.
        KitFoldCard {
            icon: KitIcons.edge;
            label: "Girdle & Edges";
            summary: root.edges_summary;
            open <=> root.fold_edges;
            toggled(o) => { ParametersModel.stone_fold_set(2, o); }
            StoneSwitchRow {
                label: "Frosted Girdle";
                hint: "Frosted Girdle: draw the girdle band ground (matt) instead of polished." + root.saved_note;
                on: SettingsModel.girdle_frosted;
                toggled => {
                    SettingsModel.girdle_frosted = !SettingsModel.girdle_frosted;
                    SettingsModel.girdle_frosted_changed(SettingsModel.girdle_frosted);
                }
            }
            StoneSlider {
                label: "Edge Rounding";
                hint: "Edge Rounding: soften the edges between facets from perfectly\nsharp toward a faint rounded glint, as on a real polished stone." + root.saved_note;
                value_text: SettingsModel.edge_rounding_radius <= 0.0 ? "Off" : Math.round(SettingsModel.edge_rounding_radius * 1000.0) / 1000.0 + "";
                minimum: 0.0;
                maximum: 0.03;
                step: 0.0003;
                value <=> SettingsModel.edge_rounding_radius;
                moved(val) => { SettingsModel.edge_rounding_changed(val); }
            }
            EdgesSection { saved_note: root.saved_note; }
        }

        // Clarity: the haze and the inclusions. The slider drags a position (0-1) and the
        // coefficient is 2 * position^2 (`render_setup::inclusion_scale`): finer at the clean end.
        KitFoldCard {
            icon: KitIcons.sparkle;
            label: "Clarity";
            summary: root.clarity_summary;
            open <=> root.fold_clarity;
            toggled(o) => { ParametersModel.stone_fold_set(4, o); }
            StoneSlider {
                label: "Inclusion Haze";
                hint: "Inclusion Haze: a milky veil inside the stone, from 0 (clean) to\n2 (milky), as tiny inclusions scatter the light. The slider is\nfiner at the clean end: a quarter of the way is a light silk." + root.saved_note;
                value_text: SettingsModel.inclusion_sigma_s <= 0.0 ? "Off" : Math.round(SettingsModel.inclusion_sigma_s * 100.0) / 100.0 + "";
                minimum: 0.0;
                maximum: 1.0;
                value <=> SettingsModel.inclusion_position;
                moved(val) => { SettingsModel.stone_inclusion_edited(val); }
            }
            InclusionsSection { saved_note: root.saved_note; ray_traced: root.ray_traced; }
        }

        // Play-of-Color (Schiller): only for a material that has it.
        if RenderEffectsModel.structure_available || RenderEffectsModel.structure_own: KitFoldCard {
            icon: KitIcons.layers;
            label: RenderEffectsModel.structure_available ? RenderEffectsModel.structure_title : "Play-of-Color";
            summary: root.structure_summary;
            open <=> root.fold_structure;
            toggled(o) => { ParametersModel.stone_fold_set(8, o); }
            StructureSection { saved_note: root.saved_note; ray_traced: root.ray_traced; }
        }
    }
}
