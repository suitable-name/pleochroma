import { NewDesignDialog } from "../new_design_dialog.slint";
import { RetargetDialog } from "../retarget_dialog.slint";
import { GearRemapDialog } from "../editor_design_settings.slint";
import { MetadataEditorDialog } from "../metadata_editor_dialog.slint";
import { PreviewBatchDialog } from "../preview_batch_dialog.slint";
import { TiltBatchDialog } from "../tilt_batch_dialog.slint";
import { ShortcutOverlay } from "../shortcut_overlay.slint";
import { PreferencesDialog } from "../preferences_dialog.slint";
import { PreferencesModel } from "../../models/preferences.slint";
import { ConfirmActionDialog } from "../confirm_action_dialog.slint";
import { AnchorExplainer } from "../anchor_explainer.slint";
import { MaterialEditorDialog } from "../material_editor_dialog.slint";
import { PerformanceGraphDialog } from "../performance_graph_dialog.slint";
import { TiltModel } from "../../models/tilt.slint";
import { ViewportModel } from "../../models/viewport.slint";
import { PhysicscolorModel } from "../../models/physics_color.slint";
import { EditorModel } from "../../models/editor.slint";
import { RetargetModel } from "../../models/retarget.slint";
import { LibraryModel } from "../../models/library.slint";
import { BatchModel } from "../../models/batch.slint";
import { ShortcutsModel } from "../../models/shortcuts.slint";
import { CommandPalette } from "../command_palette.slint";
import { CommandPaletteModel } from "../../models/command_palette.slint";
import { RenderJobsModel } from "../../models/render_jobs.slint";
import { RenderJobsPanel } from "../render_jobs/jobs_panel.slint";
import { ExportDialog } from "../export_dialog.slint";
import { ExportModel } from "../../models/export.slint";
import { JobEditModel } from "../../models/job_edit.slint";
import { JobCopyModel } from "../../models/job_copy.slint";
import { RiFieldModel } from "../../models/ri_field.slint";
import { RiChartModel } from "../../models/ri_chart.slint";
import { RiBatchModel } from "../../models/ri_batch.slint";
import { JobEditDialog } from "../render_jobs/job_edit_dialog.slint";
import { CopyMaterialsDialog } from "../render_jobs/copy_materials.slint";
import { RiChartDialog } from "../ri_chart/ri_chart_dialog.slint";
import { RiRangeBatchDialog } from "../ri_range_batch_dialog.slint";

// Every modal dialog `app.slint` mounts that is driven entirely by a global model (no
// `MainWindow`-local property or callback). `MaterialEditorDialog`, `PerformanceGraphDialog` and
// `ExportDialog` are mounted here at window size, so a short Edit viewport cannot shrink them.
// The window-close question and the `Toast` stay in `app.slint`, as they read `MainWindow`'s
// own properties and callbacks.
//
// Inherits `Rectangle` and is mounted with explicit `x`/`y`/`width`/`height` in `app.slint`:
// a component with no base is an `Empty` sized by its content, and every child here is an
// `if` branch with no layout info, so the overlay would be 0 x 0. A plain `Rectangle` with
// no `TouchArea` passes input through, so while every branch is false it blocks no clicks.
export component GlobalDialogsOverlay inherits Rectangle {
    // `NewDesignDialog`, `RetargetDialog` and `MetadataEditorDialog` have no key handling of
    // their own, so each is wrapped in a `FocusScope` that takes focus on mount, maps Escape
    // and Return to the dialog's cancel and primary actions, and swallows every other key
    // (`return accept`) so `global_shortcuts` (`app.slint`) cannot fire on the design
    // underneath (e.g. Ctrl+S over the New Design form). `Key.Tab` is let through so focus
    // still cycles through the dialog's own fields and buttons.
    if EditorModel.new_dialog_open: FocusScope {
        width: 100%;
        height: 100%;
        z: 400;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                EditorModel.new_dialog_open = false;
                // The New Design fields set `EditorModel.text_focus` like every Edit-tab text
                // field. The assignment above unmounts this whole `if` subtree before a focused
                // field reports `has-focus` going false, so reset the flag here: otherwise it
                // stays true and blocks `app.slint`'s Ctrl+Z/Ctrl+Y guard for the session.
                EditorModel.text_focus = false;
            } else if event.text == Key.Return {
                // Through the dialog's own `do_create`, so Return respects
                // `form_valid` exactly like the Create button. The dialog is NOT
                // closed here: only Rust's success path
                // (`tier_actions::do_new_design_create`) closes it, so a parse
                // error keeps the typed values on screen next to its toast.
                new_design_dialog.do_create();
            } else if event.text == Key.Tab || event.text == Key.Backtab {
                return reject;
            }
            return accept;
        }

        new_design_dialog := NewDesignDialog {
            width: 100%;
            height: 100%;
        }
    }

    // Also shown for Compare alone (it sets only `compare_open`): `RetargetDialog` then shows
    // its Compare pane.
    if RetargetModel.is_open || RetargetModel.compare_open: FocusScope {
        width: 100%;
        height: 100%;
        z: 400;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                if RetargetModel.compare_open {
                    RetargetModel.compare_close();
                } else if !RetargetModel.is_busy {
                    RetargetModel.is_open = false;
                    RetargetModel.close();
                }
            } else if event.text == Key.Return {
                // The Apply button's own condition, so Return never applies while the
                // button is dimmed (Optimize before an option is picked, a change that is
                // still being checked or not valid).
                if !RetargetModel.compare_open && retarget_dialog.can_apply {
                    RetargetModel.apply();
                }
            } else if event.text == Key.Tab || event.text == Key.Backtab {
                return reject;
            }
            return accept;
        }

        retarget_dialog := RetargetDialog {
            width: 100%;
            height: 100%;
        }
    }

    // The gear-remap confirmation is a modal dialog, so it cannot be missed behind other work.
    // `GearRemapDialog` handles Escape and Return itself; this wrapper also swallows every
    // other key (e.g. Ctrl+S) so none of them reaches the design underneath.
    if EditorModel.gear_remap_open: FocusScope {
        width: 100%;
        height: 100%;
        z: 400;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                EditorModel.gear_remap_cancel();
            } else if event.text == Key.Return {
                EditorModel.gear_remap_confirm();
            } else if event.text == Key.Tab || event.text == Key.Backtab {
                return reject;
            }
            return accept;
        }

        GearRemapDialog {
            width: 100%;
            height: 100%;
        }
    }

    if LibraryModel.metadata_editor_open: FocusScope {
        width: 100%;
        height: 100%;
        z: 400;
        init => { self.focus(); }
        key-pressed(event) => {
            // Enter-to-save is not handled here: the dialog owns the draft properties it saves,
            // so Enter is wired inside `MetadataEditorDialog`.
            if event.text == Key.Escape {
                LibraryModel.metadata_editor_open = false;
            } else if event.text == Key.Tab || event.text == Key.Backtab {
                return reject;
            }
            return accept;
        }

        MetadataEditorDialog {
            width: 100%;
            height: 100%;
        }
    }

    if BatchModel.preview_visible: PreviewBatchDialog {
        width: 100%;
        height: 100%;
        z: 400;
    }

    if BatchModel.tilt_visible: TiltBatchDialog {
        width: 100%;
        height: 100%;
        z: 400;
    }

    // The Keyboard Shortcuts overlay (Help menu, or `?` --
    // `global_shortcuts` in `app.slint`). Same wrapping-`FocusScope` Escape
    // convention as `NewDesignDialog`/`RetargetDialog` above.
    if ShortcutsModel.open: FocusScope {
        width: 100%;
        height: 100%;
        z: 400;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                ShortcutsModel.close();
            } else if event.text == Key.Tab || event.text == Key.Backtab {
                return reject;
            }
            return accept;
        }

        ShortcutOverlay {
            width: 100%;
            height: 100%;
        }
    }

    // The Preferences dialog (Edit > Preferences..., Ctrl+Comma). Same wrapping-
    // `FocusScope` convention: Escape closes it and every other key is swallowed so a
    // shortcut cannot fire on the design underneath. Tab is let through so focus moves
    // between the dialog's own controls.
    if PreferencesModel.dialog_open: FocusScope {
        width: 100%;
        height: 100%;
        z: 400;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                PreferencesModel.dialog_open = false;
            } else if event.text == Key.Tab || event.text == Key.Backtab {
                return reject;
            }
            return accept;
        }

        PreferencesDialog {
            width: 100%;
            height: 100%;
        }
    }

    // The Jobs window (File > Render Jobs..., or the header's Jobs chip). Same wrapping-
    // `FocusScope` convention: Escape closes it, every other key is swallowed so a shortcut
    // cannot fire on the design underneath, and Tab moves between its buttons.
    if RenderJobsModel.panel_open: FocusScope {
        width: 100%;
        height: 100%;
        z: 400;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                RenderJobsModel.panel_open = false;
            } else if event.text == Key.Tab || event.text == Key.Backtab {
                return reject;
            }
            return accept;
        }

        RenderJobsPanel {
            width: 100%;
            height: 100%;
        }
    }

    // The Edit Job dialog (a row's Edit... in the Jobs window). Same wrapping-`FocusScope`
    // convention as the metadata editor: Escape cancels, every other key is swallowed so a
    // shortcut cannot fire behind it, and Tab moves between its fields. Above the Jobs window.
    if JobEditModel.open: FocusScope {
        width: 100%;
        height: 100%;
        z: 420;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                JobEditModel.cancel();
            } else if event.text == Key.Tab || event.text == Key.Backtab {
                return reject;
            }
            return accept;
        }

        JobEditDialog {
            width: 100%;
            height: 100%;
        }
    }

    // The Copy to Materials dialog (a row's "..." menu in the Jobs window), the same way.
    if JobCopyModel.open: FocusScope {
        width: 100%;
        height: 100%;
        z: 420;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                JobCopyModel.cancel();
            } else if event.text == Key.Tab || event.text == Key.Backtab {
                return reject;
            }
            return accept;
        }

        CopyMaterialsDialog {
            width: 100%;
            height: 100%;
        }
    }

    // The RI chart (the material card's "..." menu, the command palette), the same way.
    if RiChartModel.open: FocusScope {
        width: 100%;
        height: 100%;
        z: 400;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                RiChartModel.open = false;
            } else if event.text == Key.Tab || event.text == Key.Backtab {
                return reject;
            }
            return accept;
        }

        RiChartDialog {
            width: 100%;
            height: 100%;
        }
    }

    // The Compute RI Ranges batch of the library (Library menu, command palette). Like the
    // other batch dialogs it brings its own handling.
    if RiBatchModel.visible: RiRangeBatchDialog {
        width: 100%;
        height: 100%;
        z: 400;
    }

    // The command palette (Edit > Command Palette..., Ctrl+K, Ctrl+Shift+P). It brings its
    // own `FocusScope` -- the search field needs the keys first, so a wrapper like the ones
    // above would be wrong -- and sits above the dialogs (z 400) but under the confirm
    // dialogs (z 500).
    if CommandPaletteModel.open: CommandPalette {
        width: 100%;
        height: 100%;
        z: 450;
    }

    // The gem material editor (Live Render's Material actions, the Edit tab's material
    // button). Mounted at window size, not inside a viewport: the Edit viewport can be only
    // 170-260px tall in the narrow stack, which would size the dialog card from that.
    if ViewportModel.material_editor_open: MaterialEditorDialog {
        width: 100%;
        height: 100%;
        z: 300;
    }

    // An opened file's custom material carries a physics recipe, but an older build changed its
    // top-level color since: ask whether the recipe or the edited color wins (the edited
    // color is already in use until the user answers). Only in a build with the physics color
    // editor (`physical-color`): without it Rust never asks, it keeps the recipe and says so
    // in the open toast.
    if PhysicscolorModel.ui_enabled && PhysicscolorModel.color_conflict_name != "": ConfirmActionDialog {
        width: 100%;
        height: 100%;
        z: 400;
        heading: "Color Changed by an Older Version";
        message: "The material \"" + PhysicscolorModel.color_conflict_name
            + "\" has a physical color recipe, but its color was edited in an older version of Pleochroma Cut after the recipe was saved. Keep the physics recipe, or use the edited color?";
        primary_label: "Keep Physics Recipe";
        primary_hint: "Keep the physics recipe: the color is worked out from it.";
        secondary_label: "Use Edited Color";
        secondary_hint: "Use the color that was edited in the older version, and leave the recipe out.";
        primary => { PhysicscolorModel.color_conflict_resolved(true); }
        secondary => { PhysicscolorModel.color_conflict_resolved(false); }
        cancel => { PhysicscolorModel.color_conflict_resolved(false); }
    }

    // The high-resolution render export dialog (Render & Output tab, the Live Render toolbar,
    // the header's export indicator). At window level, so its scrim dims the whole window.
    if ExportModel.is_open: ExportDialog {
        width: 100%;
        height: 100%;
        z: 400;
    }

    // The tilt-performance chart, opened by both viewports' "Tilt Curve" pills. Mounted at
    // window size, like the material editor.
    if TiltModel.dialog_open: PerformanceGraphDialog {
        width: 100%;
        height: 100%;
        z: 350;
    }

    // Startup question: reopen the last design, or recover an autosave. It only appears at
    // startup, when none of the other dialogs can be open.
    if EditorModel.startup_restore_path != "": ConfirmActionDialog {
        heading: EditorModel.startup_restore_is_autosave
            ? "Recover Unsaved Work?"
            : "Reopen Last Design?";
        message: EditorModel.startup_restore_is_autosave
            ? "The previous session ended without saving. A recovery file is still on disk:\n" + EditorModel.startup_restore_path
            : EditorModel.startup_restore_path;
        primary_label: EditorModel.startup_restore_is_autosave ? "Recover" : "Reopen";
        primary_hint: EditorModel.startup_restore_is_autosave
            ? "Open the recovery file, with the work of the session that ended without saving."
            : "Open the design you were working on last time.";
        // "Not Now" is the dialog's close button, as Escape and the X are: one "not now" button.
        secondary_label: "";
        cancel_label: "Not Now";
        // Only a leftover AUTOSAVE is ever safe to delete outright here -- an
        // ordinary recent file is the cutter's own real save, not a recovery
        // snapshot, so its third action is Discard: the offer goes (the file leaves
        // the recent list), the file stays.
        tertiary_label: EditorModel.startup_restore_is_autosave ? "Delete" : "Discard";
        tertiary_hint: EditorModel.startup_restore_is_autosave
            ? "Delete the recovery file for good. The unsaved work in it is lost."
            : "Do not offer this design again: remove it from File > Open Recent. The file itself is not deleted.";
        primary => { EditorModel.startup_restore_accept(); }
        tertiary => {
            if EditorModel.startup_restore_is_autosave {
                EditorModel.startup_restore_delete();
            } else {
                EditorModel.startup_restore_forget();
            }
        }
        cancel => { EditorModel.startup_restore_dismiss(); }
    }

    if EditorModel.unsaved_dialog_open: ConfirmActionDialog {
        width: 100%;
        height: 100%;
        z: 500;
        heading: "Unsaved Changes";
        message: EditorModel.unsaved_dialog_message;
        primary_label: "Save";
        primary_hint: "Save the design first, then go on.";
        secondary_label: "Discard";
        secondary_hint: "Go on without saving. The changes since the last save are lost.";
        primary => { EditorModel.unsaved_dialog_save(); }
        secondary => { EditorModel.unsaved_dialog_discard(); }
        cancel => {
            EditorModel.unsaved_dialog_open = false;
            EditorModel.unsaved_dialog_cancel();
        }
    }

    // Yes/No question from `gui::editor::native_io` (e.g. "not a closed solid, write
    // anyway?"), shown here instead of as a blocking dialog on the UI thread; see
    // `EditorModel.write_confirm_*`. Cancel alone declines.
    if EditorModel.write_confirm_open: ConfirmActionDialog {
        width: 100%;
        height: 100%;
        z: 500;
        heading: EditorModel.write_confirm_heading;
        message: EditorModel.write_confirm_message;
        primary_label: EditorModel.write_confirm_primary_label;
        primary_hint: "Go ahead, as the question above describes.";
        secondary_label: "";
        show_dont_ask: EditorModel.write_confirm_show_dont_ask;
        dont_ask <=> EditorModel.write_confirm_dont_ask;
        primary => { EditorModel.write_confirm_accept(); }
        cancel => {
            EditorModel.write_confirm_open = false;
            EditorModel.write_confirm_cancel();
        }
    }

    // "Render this job again?": a done or cancelled job whose compute or transfer changed in the
    // Edit Job dialog. Render Again is the primary answer (Return), Save Only the second, and
    // Cancel goes back to the dialog. Rust closes the question when it has acted on the answer;
    // each answer closes it here too.
    if JobEditModel.requeue_question_open: ConfirmActionDialog {
        width: 100%;
        height: 100%;
        z: 500;
        heading: "Render this job again?";
        message: "The compute or transfer of this job changed. Render Again puts the job back in the queue and renders it from the start; the old result stays on disk. Save Only keeps the job as it is, with the new choice stored.";
        primary_label: "Render Again";
        primary_hint: "Save the change, put the job back in the queue and render it again.";
        secondary_label: "Save Only";
        secondary_hint: "Save the change and leave the job in its state.";
        primary => {
            JobEditModel.requeue_question_open = false;
            JobEditModel.requeue_answer(2);
        }
        secondary => {
            JobEditModel.requeue_question_open = false;
            JobEditModel.requeue_answer(1);
        }
        cancel => {
            JobEditModel.requeue_question_open = false;
            JobEditModel.requeue_answer(0);
        }
    }

    // The cutting sheet export waits for the traced RI range of the design. Cancel writes the
    // sheet without the range; there is no other answer.
    if RiFieldModel.export_waiting: ConfirmActionDialog {
        width: 100%;
        height: 100%;
        z: 500;
        heading: "Computing the RI range…";
        message: "The cutting sheet prints the RI range of this design. Cancel writes the sheet without it.";
        primary_label: "";
        secondary_label: "";
        cancel_label: "Cancel";
        cancel => { RiFieldModel.cancel_export_wait(); }
    }

    // The one-time anchor explainer card -- see
    // `EditorModel.anchor_explainer_open`'s own doc comment.
    if EditorModel.anchor_explainer_open: AnchorExplainer {
        width: 100%;
        height: 100%;
        z: 500;
    }
}
