import { Theme } from "../../theme.slint";
import { SettingsModel } from "../../models/settings.slint";
import { ViewportModel } from "../../models/viewport.slint";
import { KitButton, KitIcons, KitIconButton, KitLabelRow } from "../kit/kit.slint";

// The HDR map row of the Lighting tab's Surroundings: the file name ("None" without a map), a
// "Choose..." button that opens the file picker and loads the pick in one step, and a clear button
// while a map is loaded. A Radiance .hdr panorama lights the stone instead of the lighting rig
// (the rig and the light direction are superseded; exposure still scales the map, and the Map
// Rotation dial turns it). `SettingsModel.env_map_status` shows the loader's remark under the row.
export component EnvironmentMapSection inherits VerticalLayout {
    spacing: 4px;

    KitLabelRow {
        label: "HDR map";
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: SettingsModel.env_map_loaded
                ? (ViewportModel.env_map_name != "" ? ViewportModel.env_map_name : "Loaded")
                : "None";
            font-size: 12px;
            color: SettingsModel.env_map_loaded ? Theme.text-primary : Theme.text-muted;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: AccessibleRole.text;
            accessible-label: "HDR Environment Map " + (SettingsModel.env_map_loaded ? ViewportModel.env_map_name : "None");
        }
        if SettingsModel.env_map_loaded: VerticalLayout {
            alignment: center;
            KitIconButton {
                d: KitIcons.close;
                size: 28px;
                icon_size: 14px;
                label: "Clear";
                hint: "Unload the environment map and go back to the studio lights.";
                clicked => { ViewportModel.env_map_clear(); }
            }
        }
        VerticalLayout {
            alignment: center;
            KitButton {
                text: "Choose…";
                h: 28px;
                hint: "Pick a Radiance .hdr panorama on this computer; it loads at once and lights the stone instead of the lighting rig. Very large maps fall back to the processor, which is slower.";
                clicked => { ViewportModel.env_map_choose(); }
            }
        }
    }

    if SettingsModel.env_map_status != "": Text {
        text: SettingsModel.env_map_status;
        font-size: 10px;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
}
