import { SettingsModel } from "../../models/settings.slint";
import { KitCombo } from "../kit/kit.slint";
import { KitRowName } from "../kit/r2r.slint";

// Render Resolution: one row of the Live View Details card, a dropdown over a fixed list (see
// `SettingsModel.resolution_index` for why it is not a slider). Picking one makes the quality
// preset Custom; Rust remembers the values (`gui::render::quality`).
export component ResolutionPicker inherits HorizontalLayout {
    // 0 = 640x480, 1 = 800x600 (the default), 2 = 1280x720, 3 = 1920x1080.
    pure function width_for(idx: int) -> int {
        return idx == 0 ? 640 : (idx == 1 ? 800 : (idx == 2 ? 1280 : 1920));
    }
    pure function height_for(idx: int) -> int {
        return idx == 0 ? 480 : (idx == 1 ? 600 : (idx == 2 ? 720 : 1080));
    }

    height: 32px;
    spacing: 10px;
    KitRowName {
        text: "Resolution";
        full: "Render Resolution";
        hint: "Render Resolution: the size in pixels of the picture the Live Render view traces.\nBigger pictures are sharper and take proportionally longer to settle.";
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        KitCombo {
            label: "Render Resolution";
            hint: "Render Resolution: the size in pixels of the picture the Live Render view traces.\nBigger pictures are sharper and take proportionally longer to settle.";
            model: ["640×480", "800×600", "1280×720", "1920×1080"];
            current_index <=> SettingsModel.resolution_index;
            selected(idx) => {
                SettingsModel.quality_preset_index = 3;
                SettingsModel.resolution_changed(root.width_for(idx), root.height_for(idx));
            }
        }
    }
}
