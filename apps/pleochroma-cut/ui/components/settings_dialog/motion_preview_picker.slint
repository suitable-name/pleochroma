import { SettingsModel } from "../../models/settings.slint";
import { KitFillSegments } from "../kit/kit.slint";
import { KitRowName } from "../kit/r2r.slint";

// Motion Preview Resolution, off by default: a row of the Live View Details card. A discrete
// choice, not a slider: only these three scales matter. Advanced: Simple mode hides it (the
// Parameters panel).
export component MotionPreviewPicker inherits HorizontalLayout {
    height: 32px;
    spacing: 10px;
    KitRowName {
        text: "While moving";
        full: "Motion Preview Resolution";
        hint: "Motion Preview Resolution: how sharp the picture is while you drag the gem. A lower\nsetting moves more smoothly; the full picture comes back when you stop.";
    }
    // 0 Off (default): always the full render resolution. 1 Half and 2 Quarter while the camera
    // moves.
    Rectangle {
        horizontal-stretch: 1;
        height: 32px;
        KitFillSegments {
            width: 100%;
            height: 100%;
            labels: ["Off", "Half", "Quarter"];
            picked: SettingsModel.local_preview_scale_index;
            selected(idx) => {
                SettingsModel.local_preview_scale_index = idx;
                SettingsModel.local_preview_scale_changed(idx);
            }
        }
        Tooltip { text: @markdown("Off traces at the full render resolution even while you drag. Half or Quarter\ntrace smaller while you drag the gem, then at full resolution once you stop."); }
    }
}
