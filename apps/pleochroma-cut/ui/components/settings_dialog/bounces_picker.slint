import { Theme } from "../../theme.slint";
import { SettingsModel } from "../../models/settings.slint";
import { SegmentPill } from "../pill_button.slint";
import { SettingLabel } from "setting_label.slint";

// Ray Bounces: segmented pill selector.
//
// The ladder is owned by Rust (`settings::model::BOUNCE_LADDER`, published as
// `SettingsModel.bounce_ladder`); this file keeps no copy. The rungs come from
// `crates/pleochroma/examples/bounce_cost.rs`: cost is nearly flat in the cap because most light
// paths are short, and nothing above 128 changes the picture. 12 is the default.
//
// Advanced: Simple mode hides it (`render_output_tab.slint`). The pill index is also in
// `gui::render::advanced_in_use`, which says when the hidden pick is off its default.
export component BouncesPicker inherits VerticalLayout {
    spacing: 6px;
    SettingLabel {
        text: "Max Ray Bounces (Dispersion Depth)";
        hint: "Max Ray Bounces: the most times one light path may bounce inside the stone before it is dropped. A higher cap follows long, faint paths and shows more color play. 12 is a good middle.";
    }

    HorizontalLayout {
        spacing: 4px;

        // 12 Bounces is the default; the last rung is the ceiling.
        for cap[idx] in SettingsModel.bounce_ladder: SegmentPill {
            text: "" + cap;
            hint: "Stop a light path after " + cap + " bounces.";
            selected: SettingsModel.bounce_index == idx;
            picked => {
                SettingsModel.bounce_index = idx;
                SettingsModel.bounces_changed(cap);
            }
        }
    }

    // Flat cost holds on CPU, but GPU threads run in lockstep, so the few
    // long paths in the tail stall the whole workgroup at this rung range.
    if SettingsModel.bounce_index >= 4: Text {
        text: "Modest cost on CPU, but noticeably steeper on GPU -- long paths stall the whole workgroup there since threads run in lockstep.";
        font-size: 11px;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
}
