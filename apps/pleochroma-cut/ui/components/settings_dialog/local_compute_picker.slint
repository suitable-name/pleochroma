import { SettingsModel } from "../../models/settings.slint";
import { KitFillSegments } from "../kit/kit.slint";
import { KitRowName } from "../kit/r2r.slint";

// Local Compute: the "Engines" row of the Compute card, which engine(s) the LOCAL (non-remote)
// render loop uses. Only shown by the caller on a GPU-capable build (`SettingsModel.gpu_build`),
// since the choice is meaningless without a `gpu` feature to route through.
// Advanced: Simple mode hides it (the Parameters panel).
export component LocalComputePicker inherits HorizontalLayout {
    height: 32px;
    spacing: 10px;
    KitRowName {
        text: "Engines";
        full: "Local Compute";
        hint: "Local Compute: which part of this computer traces the live picture. CPU uses the processor,\nGPU only uses the graphics card, and CPU + GPU uses both.";
    }
    Rectangle {
        horizontal-stretch: 1;
        height: 32px;
        KitFillSegments {
            width: 100%;
            height: 100%;
            labels: ["CPU", "CPU + GPU", "GPU Only"];
            picked: SettingsModel.local_compute_target_index;
            selected(idx) => {
                SettingsModel.local_compute_target_index = idx;
                SettingsModel.local_compute_target_changed(idx);
            }
        }
        Tooltip { text: @markdown("CPU traces the live picture on the processor, CPU + GPU on the processor and the\ngraphics card together, GPU Only on the graphics card. A scene the card cannot take\n(no adapter, or too large) falls back to the processor, so nothing fails to render."); }
    }
}
