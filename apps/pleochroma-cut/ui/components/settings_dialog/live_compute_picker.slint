import { Theme } from "../../theme.slint";
import { SettingsModel } from "../../models/settings.slint";
import { RemoteWorkerModel } from "../../models/remote_worker.slint";
import { KitIcons, KitSegment, KitSegmentBar } from "../kit/kit.slint";
import { KitRowName, KitSummaryRow } from "../kit/r2r.slint";
import { ToggleRow } from "../toggle_switch.slint";

// The remote half of the Compute card: the Remote Render status row, Live Compute (which
// engine(s) trace the settled viewport image), the live transfer read-out and the final-picture
// share switch. The same disabled-with-a-reason treatment as the "Compute" section of
// `export_dialog/compute_and_bounces.slint`. Advanced: Simple mode hides it
// (`render_output_tab.slint`).
//
// The remote choices read the `configured` half of the one remote-availability value
// (`RemoteWorkerModel.availability`): the live view does not probe, so it never blames
// reachability. Rust supplies the reason text (`RemoteWorkerModel.availability_reason`).
//
// How the remote's share comes home (progressive, full data when finished, or finished
// pictures) is one control per remote: it lives in the Remote Coordinator dialog, and this
// section shows the current choice read-only.
export component LiveComputePicker inherits VerticalLayout {
    // The merged live transfer, by its index (`RemoteWorkerModel.endpoint.transfer_mode_index`
    // carries the same number): 0 progressive full data, 1 full data when finished, 2 finished
    // pictures.
    property <string> transfer_name: SettingsModel.live_transfer_index == 2
        ? "Final picture (finished, denoised frames)"
        : (SettingsModel.live_transfer_index == 1 ? "Full data, sent when finished" : "Full data, progressive");
    property <bool> configured: RemoteWorkerModel.availability.configured;
    property <string> not_ready: "Needs a remote worker. " + RemoteWorkerModel.availability_reason;

    spacing: 6px;

    KitSummaryRow {
        icon: KitIcons.cloud;
        label: "Remote Render";
        dot: root.configured ? Theme.accent-emerald : Theme.text-disabled;
        detail: root.configured
            ? "Set up: " + (SettingsModel.live_compute_target_index == 0 ? "not used for the live view" : "shares the live view")
            : (RemoteWorkerModel.availability_reason == "" ? "None set up: add a machine" : RemoteWorkerModel.availability_reason);
        action: root.configured ? "Settings…" : "Set Up…";
        action_label: "Open Remote Settings...";
        action_hint: "Open the Remote Coordinator dialog (the Remote button in the header), where the remote machine is set up and the live transfer is chosen.";
        action_clicked => { RemoteWorkerModel.open_dialog(); }
    }

    // Live Compute: Local Only, Remote Only, Local + Remote.
    VerticalLayout {
        spacing: 4px;
        KitRowName {
            label_width: 200px;
            text: "Live view runs on";
            full: "Live Compute";
            hint: "Live Compute: which computer traces the settled picture in the Live Render view. Local Only uses this computer,\nRemote Only hands the picture to the remote worker, and Local + Remote uses both.";
        }
        KitSegmentBar {
            HorizontalLayout {
                padding: 2px;
                spacing: 2px;
                Rectangle {
                    horizontal-stretch: 1;
                    KitSegment {
                        x: 0px;
                        width: parent.width;
                        text: "Local Only";
                        hint: "Trace the live picture on this computer only.";
                        on: SettingsModel.live_compute_target_index == 0;
                        picked => {
                            SettingsModel.live_compute_target_index = 0;
                            SettingsModel.live_compute_target_changed(0);
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    KitSegment {
                        x: 0px;
                        width: parent.width;
                        text: "Remote Only";
                        hint: root.configured ? "Hand the whole live picture to the remote worker." : root.not_ready;
                        enabled: root.configured;
                        on: SettingsModel.live_compute_target_index == 1;
                        picked => {
                            SettingsModel.live_compute_target_index = 1;
                            SettingsModel.live_compute_target_changed(1);
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    KitSegment {
                        x: 0px;
                        width: parent.width;
                        text: "Local + Remote";
                        hint: root.configured ? "Trace the live picture on this computer and on the remote worker together." : root.not_ready;
                        enabled: root.configured;
                        on: SettingsModel.live_compute_target_index == 2;
                        picked => {
                            SettingsModel.live_compute_target_index = 2;
                            SettingsModel.live_compute_target_changed(2);
                        }
                    }
                }
            }
        }
    }

    // Live transfer, read-only: one setting per remote, edited in the Remote Coordinator dialog.
    // Only meaningful with a remote in the loop, so it is shown only then.
    if root.configured && SettingsModel.live_compute_target_index != 0: HorizontalLayout {
        height: 24px;
        spacing: 10px;
        KitRowName {
            text: "Live Transfer";
            hint: "Live Transfer: how the remote worker sends its share back while you look at the stone. Progressive shows the picture improving;\nFull Data When Finished waits for the result; Final Picture sends only finished, denoised frames, so your own\ntracing pauses after the handoff. Change it in the Remote Coordinator dialog (header, Remote).";
        }
        Text {
            horizontal-stretch: 1;
            text: root.transfer_name;
            font-size: 11px;
            font-weight: 600;
            color: Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // Final-picture exports (the still export and tilt videos, not the live viewport above) can
    // fold this machine's own idle samples into the remote's.
    ToggleRow {
        text: "Final-Picture Exports: This Machine Renders a Share Too";
        hint: "Your GPU or CPU traces part of the samples and uploads them; the coordinator merges them before tone-mapping.";
        label_color: Theme.text-secondary;
        enabled: root.configured;
        checked: SettingsModel.contribute_to_final_picture;
        toggled => {
            SettingsModel.contribute_to_final_picture = !SettingsModel.contribute_to_final_picture;
            SettingsModel.contribute_to_final_picture_changed(SettingsModel.contribute_to_final_picture);
        }
    }
}
