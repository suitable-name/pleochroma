export struct DiagramItem {
    id: int,
    title: string,
    shape: string,
    gear: string,
    facets: string,
    designer: string,
    lw_ratio: string,
    ri: string,
    // Whether this row is currently marked ignored. Always `false` while
    // `RangeFilter::include_ignored` is off, since an ignored row is excluded from
    // the result set entirely in that case. `diagram_list.slint` uses this to render
    // an ignored row visually distinct from a normal one.
    ignored: bool,
    // Whether this is one of the cutter's own imported designs (a synthetic `local://...` url),
    // not a scraped catalogue row (`pleochroma_vault::local::search::is_local_url`). Shown as a
    // "Mine" badge by `diagram_list.slint`.
    is_local: bool,
    // Whether the Rough Planner leaves this design out of its candidate set. Read from
    // the library's own side table (`Database::planner_excluded_among`), independent of
    // `ignored` above: an excluded design stays listed and fully usable everywhere
    // else. `diagram_list.slint` flips the context-menu wording and shows a "not
    // planned" marker from it. Always `false` for a remote-browsed row.
    planner_excluded: bool,
    // Tag names attached to this design, alphabetical.
    // Filled in bulk by `gui::library::search` via `Database::tags_by_entry`, not one query per
    // row.
    tags: [string],
}

// One row of the tilt-performance search filter panel: "only X% windowing in a tilt
// radius of Y%", and the brilliance/extinction equivalents -- the Slint-facing mirror
// of `pleochroma_vault::model::performance::PerformanceFilter`. Several of these
// compose by AND (`filter_panel.slint`'s list).
//
// Every field is a plain index/float rather than an enum -- Slint structs have no
// enum fields, so the index<->enum mapping happens once, in Rust, at
// `gui::library::search::filters::read_range_filter`.
export struct PerformanceFilterRow {
    // 0 = Brilliance, 1 = Extinction, 2 = Windowing.
    metric_index: int,
    // 0 = At Most, 1 = At Least.
    bound_index: int,
    // 0..100, the percentage threshold `bound_index` is measured against.
    threshold_pct: float,
    // 0..90 degrees -- an arbitrary value, not a preset ladder. `read_range_filter`
    // validates this via `PerformanceFilter::new` before it ever reaches a query.
    tilt_radius_deg: float,
    // 0 = Worst, 1 = Mean.
    aggregate_index: int,
}

// Decoded catalogue-preview thumbnails for one diagram-list row, returned by
// `MainWindow.get_preview_thumbnails(id)` -- see `gui::batch::preview_cache`'s module doc
// comment for why this is a synchronous lookup callback rather than fields on
// `DiagramItem` itself. `has_front`/`has_top` are independently `false` for a view
// never generated or still decoding -- `diagram_list.slint` shows a fixed-size
// placeholder in either case rather than an empty/broken `Image`.
export struct PreviewThumbnails {
    front: image,
    top: image,
    has_front: bool,
    has_top: bool,
}

export struct AngleItem {
    order_idx: int,
    facet: string,
    // The label a person reads for this facet: the standard code (`P1`, `G1`, `C1`, `T`)
    // where the catalogue kept the old 123/ABC labels (`gui::library::detail::shared::
    // standard_codes`), else the same text as `facet`. `facet` stays the catalogue's own
    // label (it feeds the plane reconstruction); a row whose `code` differs from it shows
    // "was <facet>" beside the code.
    code: string,
    angle: string,
    index_val: string,
    notes: string,
    // Which side of the girdle this facet cuts: -1 pavilion, 1 crown (the table
    // row counts as crown), 0 neither (a girdle row, or a catalogue row the rule
    // cannot place). Filled by Rust (`gui::library::detail::shared::sides_from_rows`)
    // from the catalogue row's facet label first (digits / `P<n>` = pavilion,
    // letters / `C<n>` = crown, `G` or an exact 90 degree angle = girdle, `T` or
    // an index of "Table" = table), with row position only as a last resort. A
    // real field rather than something the markup derives from the formatted
    // `angle` string: the catalogue's angle text is unsigned, so the sign alone
    // cannot tell a crown row from a pavilion one.
    side: int,
    // A concave tier's tool line (the cutting sheet's second line: tool code, theta,
    // displacement and `D/W`/motion, joined with two spaces), "" for a flat tier.
    // Drawn under the facet line inside the same shaded band, so a tool tier reads as
    // one two-line entry rather than two unrelated rows.
    second_line: string,
}

export struct FileItem {
    name: string,
    url: string,
    size_str: string,
}

// One gear-position chip of the selected tier's index list, built in Rust
// (`gui::editor::view::inspector::selected_tier_chips`) from `ConstraintTier::indices` and
// `detached`. Slint has no string split, so the chips are not parsed from the comma-joined
// `EditorTierItem::indices`. They are pushed as the top-level `EditorModel.selected_tier_chips`,
// not as a field of `EditorTierItem`: rows are built on a background thread and must stay `Send`,
// which a `[IndexChipItem]` model field is not. Only the tier being edited gets chips.
export struct IndexChipItem {
    // The gear-position value itself, passed back to `EditorModel.facet_remove`/
    // `facet_toggle_detach` exactly as `ConstraintTier::indices`/`detached` store it.
    position: float,
    // Pre-formatted for display -- an integral position (the overwhelming common
    // case) shows with no decimal noise, matching the plain `EditorTierItem::
    // indices` column's own formatting.
    label: string,
    // Whether THIS occurrence is in `ConstraintTier::detached`. Unlike
    // `EditorTierItem::is_detached` (any occurrence of the tier), this is per position:
    // `EditorModel.facet_toggle_detach` acts on one chip at a time.
    detached: bool,
    // Whether THIS occurrence is frosted: the tier is frosted as a whole, or this facet is one
    // of the tier's frosted facets (`Design::tier_frosting`). A frosted chip is tinted and its
    // frost button shows the facet is frosted; `EditorModel.toggle_facet_frosted` flips it.
    frosted: bool,
}

// One row of the Edit sub-tab's tier list: the Slint-facing mirror of a design tier, converted
// at the `gui::editor` boundary so the core crates do not depend on Slint.
// `index` is this tier's position in `Design::tiers`, round-tripped back to Rust by
// `EditorView.save_tier`/`remove_tier`; the list index identifies the tier.
//
// `mast` is derived by `Design::solve` and shown read-only. The user authors the constraint:
// `constraint_kind` (0 = meet an unspecified vertex / `MeetConstraint::MeetExisting`,
// 1 = meet named facets / `MeetConstraint::MeetNamed`, 2 = an exact scale value /
// `MeetConstraint::ScaleReference`) plus `constraint_text` (comma-separated facet names for
// kind 1, the value for kind 2, unused for kind 0). `strategy` labels how the solved mast was
// obtained, shown per tier since a derived value and an estimate differ in confidence.
export struct EditorTierItem {
    index: int,
    angle_deg: string,
    // The angle unrounded, for seeding an editable field. `angle_deg` is rounded to 2 decimals
    // (`format_angle_cell`); saving that text back would change the angle, spend an undo step
    // and could reclassify a near-zero tier.
    angle_full: string,
    name: string,
    indices: string,
    // The indices unrounded, for seeding the Indices field: `indices` rounds fractional positions
    // to 2 decimals, the same lossy reseed as `angle_full`.
    indices_full: string,
    constraint_kind: int,
    constraint_text: string,
    mast: string,
    // The mast in millimetres, `""` without a girdle diameter to anchor the scale. Shown in the
    // MAST cell's tooltip, since the cell is narrow and mm is what a cutter dials into a gauge.
    mast_mm: string,
    // The mast unrounded: "Pin to mast" applies this value, so its tooltip quotes it, not the
    // cell's rounded figure.
    mast_full: string,
    strategy: string,
    // `true` when `mast` is not a real vertex-derived value: `LeastSquaresFallback`, `Failed`, or
    // a stale row after an edit (`tier_items_stale` sets this until the next explicit Solve).
    // `EditorView` flags the row.
    strategy_is_uncertain: bool,
    // The meet the source `.asc` file's `G` field records for this facet (`ConstraintTier::
    // imported_meet`, formatted like `constraint_text`), or `""`. Non-empty shows the Adopt button
    // (`adopt_meet`): import pins the constraint to the recorded mast, so this is the only place
    // the file's geometry stays visible.
    imported_meet_text: string,
    // Label of the orbit that `orbit::orbit_units` derives from this tier's `indices` and the
    // schedule's symmetry: "orbit x4" (one complete orbit), "2 orbits", "2 orbits (1 incomplete)",
    // "3/4 orbit" (a single partial unit), or "not symmetric" (several units, none complete).
    // "" for a tier with at most one index. Shows that an edit touches more than one facet.
    orbit_status: string,
    // `true` when `orbit_status` describes an incomplete or inconsistent orbit. Shown in amber,
    // like `strategy_is_uncertain`.
    orbit_incomplete: bool,
    // `true` when any occurrence in this tier is detached from orbit-wide propagation
    // (`ConstraintTier::detached`). Drives the "Detached" badge and the action `toggle_detach`
    // performs next.
    is_detached: bool,
    // "Crown" / "Pavilion" / "Girdle" -- `pleochroma::geometry::meet_solver::
    // classify_blocks` applied to the whole design's tiers, so the unsigned-zero
    // "inherits the previous tier's side" rule is honored the same way the solver
    // itself honors it. Populated identically by `tier_items`/`tier_items_stale` (a
    // pure function of `angle_deg` and file order, no solve needed) -- the tier table's
    // code column is derived from it, and the zero-angle flip reads it.
    block: string,
    // The tier's code in cutting order (`P1`, `G1`, `C1`, `T`, `Culet`, a concave tier's
    // `P4`; `pleochroma_cut_core::Design::tier_codes`), the same label the cutting sheet
    // prints. The tier table's code column shows it, so a row's side is read from its
    // letter and its place in the cutting order from its number. "" for a row built by
    // hand, which falls back to the block's one letter.
    code: string,
    // This tier's margin over the design's effective critical angle, and the
    // `optics_hints::Risk` band that falls out of it. Meaningful for a pavilion
    // tier's angle specifically (a crown/girdle tier, or no material resolved, gets
    // `margin_text: ""`/`risk_level: -1`, treated as "nothing to show"). Needs only
    // the tier's own authored `angle_deg` and the design's resolved `n_d`, neither of
    // which needs a solve, so this is populated identically by both `tier_items` and
    // `tier_items_stale`.
    margin_text: string,
    // -1 = not applicable (crown/girdle, or no material resolved), 0 = Safe,
    // 1 = Marginal, 2 = Windows -- see `optics_hints::Risk`.
    risk_level: int,
    // `true` while the row is Ctrl+click-selected for a batched angle nudge (`toggle_multi_select`,
    // `setup_nudge_angle_callback`). Patched in place by `setup_toggle_multi_select_callback`, so
    // toggling a selection does not mark the design as not solved, as a real edit does.
    multi_selected: bool,
    // Tooltip of the SOLVE column:
    // - Unsolved, and this tier is in the unanchored block (`needs_anchor`): the block's remedy
    //   sentence (`pleochroma_cut_core::MissingAnchor::block_sentence`).
    // - Unsolved, but in another, anchored block: a note pointing at the validation banner.
    // - Solved: `SolvedTier::detail`, how the mast was obtained, shown verbatim.
    // "" for a stale row, which never solves; the tier table hides the tooltip then.
    strategy_detail: string,
    // `true` for tiers in a block that `MissingAnchor` names (`MissingAnchor::block_details`).
    // Drives the tier table's "Add Anchor" action. Always `false` once solved and for stale rows.
    needs_anchor: bool,
    // The tier(s) that `Design::facet_meets` resolves this tier's meet constraint to, formatted
    // (e.g. "meets tier 3 (C1)"), or "" when it resolves to nothing. Shown in the inspector's
    // read-only "Solved" section (`pleochroma_editor::view_model::rows`).
    meet_partners_text: string,
    // This tier's `ManufacturabilityWarning`s joined with "; ", or "". Grouped by tier so the
    // table can badge the offending row. Prefixed "(pre-solve) " when computed without a
    // completed solve (`pleochroma_editor::view_model::rows::warnings`).
    warning_text: string,
    // The angle a pending Optimize outcome would set this tier to (formatted like `angle_deg`), or
    // "" for no change. Only while the outcome still applies (`EditorModel.optimize_can_apply`).
    // Patched in by `apply_proposed_angles`; the tier table shows it as a ghost beside the angle.
    proposed_angle: string,
    // 0 = a flat tier (`design.tiers`), 1 = a concave tier (`design.concave_tiers`, cut with a
    // tool). A concave row is read-only in the table (no angle edits, pin, detach, adopt or
    // multi-select) and is authored in the inspector's concave form. Its `index` is its position
    // in the table, flat rows first, so selection and the keyboard cursor work unchanged. Rust
    // maps a position past the flat count back to the concave tier.
    kind: int,
    // A concave row's tool line (the cutting sheet's second line: tool code, theta,
    // displacement, `D/W` and motion, joined with two spaces), "" for a flat row.
    // Shown as the tool badge's tooltip. A plain string so this struct stays `Send`.
    tool_line: string,
    // The relation that drives this tier's angle, as a cutter reads it ("C1 - 4"), or
    // "" when the angle is free. Non-empty marks a driven tier: the angle cell shows a
    // link icon and refuses inline edits, the inspector's Tier form shows the relation
    // in its Angle field (prefixed "=") and offers "Remove relation".
    relation_text: string,
    // How the design frosts this tier: "" for a polished tier, "Frosted" for a whole frosted
    // tier and "Frosted: 2 of 8" for a tier frosted facet by facet
    // (`Design::tier_frosting_text`). Non-empty marks the row with a frost icon.
    frosting_text: string,
}

// The concave tier form's fields, as typed -- passed whole to
// `EditorModel.save_concave_tier` and returned whole by `EditorModel.
// concave_form_data` (a tier read back at full precision, so a re-save of an
// untouched form is a no-op). Every number is a string on purpose: Rust parses them
// (`pleochroma_editor::loading::parse_concave_tier_form`) and names the offending
// field in its error, which the inspector reads through `EditorModel.
// tier_form_error_field` exactly as the flat form does. `tool` is the tool code
// (`CYL`, `CON`, `CIR`, `DSC`, `SPH`); `tool_angle_deg` is only used by `CON`/`DSC`.
export struct ConcaveFormData {
    name: string,
    angle_deg: string,
    indices: string,
    instructions: string,
    tool: string,
    tool_azimuth_deg: string,
    x: string,
    y: string,
    z: string,
    diameter_ratio: string,
    tool_angle_deg: string,
    reciprocating: bool,
}

// One row of the gear-remap confirmation panel (`editor_view.slint`) -- shown after
// the user picks a different index-gear tooth count in the Design Settings panel,
// before `Edit::RemapIndices` is actually applied. `new_indices` is exactly what
// `Edit::RemapIndices` would write (a real dry run against a cloned design), while
// `non_integral` is computed independently, from the unrounded ratio, so it flags a
// tier whose ideal new position isn't a whole tooth regardless of which rounding mode
// is currently previewed.
export struct GearRemapRow {
    name: string,
    old_indices: string,
    new_indices: string,
    non_integral: bool,
}

// One row of the Optimize result table: one objective component's before and after values,
// kept apart so a gain in one figure at the cost of another is visible. Built by
// `pleochroma_editor::optimize_view::optimize_result_rows` as four rows: windowing, extinction,
// tilt brilliance, then the blended score (`100 - ObjectiveWeights::score`, higher is better).
export struct OptimizeResultRow {
    label: string,
    before: string,
    after: string,
    // -1 worse, 0 unchanged, 1 better. "Better" depends on the metric (windowing going down is an
    // improvement, brilliance going down is not), so it is computed beside the figure in
    // `pleochroma_editor::optimize_view`.
    direction: int,
}

// The Optimize tab's face-up colour of the starting stone and of the picked candidate, as the
// screen shows that light. `lighting` names the preset the run used ("under Incandescent
// (3200K)"). `has` is false when the run measured no tone or no candidate is picked.
export struct OptimizeToneSwatches {
    has: bool,
    before: color,
    after: color,
    before_text: string,
    after_text: string,
    lighting: string,
}

// One tier where the externally verified Deep Solve repair disagreed with the plain solve. Built
// from `pleochroma_editor::deep_solve::TierMastDelta`, only for tiers whose mast moved by more
// than a small epsilon. Shown beside `EditorModel.deep_solve_status`; built by
// `gui::editor::view::solve_results::deep_solve_tier_rows`.
export struct DeepSolveTierRow {
    // Pre-formatted 1-based, e.g. "#4" -- matches every other 1-based tier
    // reference in this app (the tier table's own "#" column).
    tier_number: string,
    name: string,
    before_mast: string,
    after_mast: string,
    // Signed, e.g. "+0.0213".
    delta: string,
}

// One tier that the Optimize result would change, built from
// `pleochroma_cut_core::OptimizeOutcome::changes` (`gui::editor::view::solve_results`). Shown
// beside `EditorModel.optimize_result_rows`, so the cutter sees which tiers move.
export struct OptimizeChangeRow {
    tier_number: string,
    name: string,
    from_angle: string,
    to_angle: string,
    delta: string,
}

export struct OpticalMetricsData {
    brilliance_pct: float,
    fire_index: float,
    windowing_pct: float,
    extinction_pct: float,
    scintillation: float,
    render_time_ms: float,
    accumulated_samples: int,
}

// Named lighting presets: only what the row UI needs to display and reference a
// preset -- the full numeric payload lives in Rust's `settings::LightingPreset` and is
// applied/captured there. Slint just needs the name, whether it's a built-in (to hide
// the rename/delete affordances), `export_usable` (the Parameters panel's checkbox
// state, and the export dialog's fan-out filter), and `has_env_map` (an
// export-dialog-only hint that the preset carries an HDR environment map; the GPU
// renders it, and only a very large map falls back to the CPU).
export struct LightingPresetItem {
    name: string,
    built_in: bool,
    export_usable: bool,
    has_env_map: bool,
    // Export-dialog-only, transient checkbox state -- unused/always `false` in the
    // Parameters panel's own preset list. See `GemViewportView.export_fanout_presets`
    // for the separate, dialog-scoped list this actually matters on.
    selected: bool,
}

// Remote rendering: the "Remote coordinator" form (exactly one remote endpoint). Rust owns the
// real `settings::RemoteEndpoint`; this is just
// enough to show and edit it and round-trip an edit back to Rust.
export struct WorkerItem {
    name: string,
    address: string,
    cert_dir: string,
    // Live transfer: 0 = LiveProgressive, 1 = FinalOnly (both with full data, matching
    // `pleochroma_net::messages::TransferMode`), 2 = final picture (`settings::LiveTransfer::
    // FinalPicture`, finished denoised frames).
    transfer_mode_index: int,
    cadence_ms: int,
    // 0 = Full, 1 = Half, 2 = Quarter, 3 = Custom -- matches `settings::PreviewScale`.
    preview_scale_index: int,
    // Only meaningful when preview_scale_index == 3.
    preview_scale_percent: int,
    // The export dialog's and tilt video's default "Transfer":
    // 0 = Full data, 1 = Final picture only -- matches `settings::ExportTransfer`.
    export_transfer_index: int,
}

export struct DiagramDetailData {
    id: int,
    title: string,
    url: string,
    designer: string,
    shape: string,
    gear: string,
    facets: string,
    lw_ratio: string,
    ri: string,
    volume: string,
    competition: string,
    image_name: string,
    has_image: bool,
    // Whether `url` is a synthetic `local://...` id from a locally-imported design
    // rather than a real page on the web -- gates the "Open on Web"/"Copy Link"
    // affordances in `detail_header.slint`.
    is_local: bool,
    // Proportions `apply_measured_metadata` derives alongside `lw_ratio`/`volume`, shown in the
    // same grid, formatted to 3 decimals (`gui::library::detail::shared::format_proportion`).
    // Empty means not known, and hides the chip.
    hw_ratio: string,
    cw_ratio: string,
    pw_ratio: string,
    // Metadata-editor-only fields (see `metadata_editor_dialog.slint`): not shown as
    // their own chips here, only pre-filled into the edit form. `symmetry_order` is a
    // display string rather than an int since it's `None`-able and this struct
    // otherwise never plumbs an "unknown" sentinel through an `int` field.
    symmetry_order: string,
    mirror_symmetry: bool,
    // Inferred material, shown as a guess: a catalogue row records only a refractive index. The
    // same nearest-n_D guess as the editor's material badge
    // (`pleochroma_editor::material_lookup::material_for_refractive_index`), e.g.
    // "Sapphire? (from RI 1.76)". `""` hides the chip.
    material_guess: string,
}

// "Retarget for material" dialog row: one per pavilion/crown tier; girdle tiers are
// never listed (see `pleochroma_editor::retarget`).
export struct RetargetRowItem {
    tier_index: int,
    // "Crown" / "Pavilion" -- girdle tiers are never included, so this dialog never
    // needs to render that third case.
    block: string,
    name: string,
    // Pre-formatted (e.g. "-50.40°").
    old_angle: string,
    new_angle: string,
    // This row's margin over the TARGET material's own critical angle, pre-formatted
    // (e.g. "+3.21°" / "-1.05°").
    margin: string,
    // "Safe" / "Marginal" / "Windows" -- `pleochroma_cut_core::Risk` formatted once in
    // Rust, matching `risk_color` below (`Theme.accent-emerald` / `accent-amber` / a
    // red) chosen the same place so the two never drift apart.
    risk_label: string,
    risk_color: color,
}
