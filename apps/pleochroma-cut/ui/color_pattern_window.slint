// The Color Pattern Editor: a separate top-level window, opened from the Gem Material Editor's
// Color Pattern section (`components/material_editor/color_pattern_section.slint`). A pattern
// is a base color plus up to four layers (zones) inside it; a layer has one color or, in a
// birefringent stone, two or three.
//
// The window is a stage and a layers panel: the stone picture fills the stage with glass
// panels over it, the layers are cards you select, rename, reorder and color, and the
// templates live in a "Start From" gallery.
//
// Everything it shows is pushed from Rust (`gui::color_pattern`) into this window's OWN instance
// of `ColorPatternModel` (a global is instantiated once per top-level window); the window holds
// only what is typed and where its menus are (`PatternUi`). The pieces live in
// `components/color_pattern/`: `preview_panel.slint` (the stage), `zone_list.slint` (the layers
// panel and its cards), `zone_properties.slint` (the selected card's body), `color_picker.slint`
// (the picker popover), `gallery.slint`, `menus.slint`, `parts.slint` and `icons.slint`.
//
// Keyboard: Tab walks every control. Escape closes the open overlay first (the gallery or its
// name field, the picker, a menu, a rename, the discard question) and only then asks Cancel.
// Ctrl+Z and Ctrl+Y undo and redo the pattern edit when no text field has the key. Alt+Up and
// Alt+Down move the selected layer. With the stage focused, Page Up and Page Down move the slice.
//
// Overlays (gallery, picker, Add menu, "..." menu) are elements of this window at computed
// positions, not `PopupWindow`s: a popup cannot be placed reliably from inside a layout.
//
// Sizing: the whole content hangs off an x/y-positioned wrapper, so no layout constraint inside
// it reaches the window (the window's min AND max come from its content tree otherwise -- see
// `app.slint`'s sizing notes); the window's own `min-width`/`min-height` are the only limits.
import { Theme } from "theme.slint";
import { ColorPatternModel } from "models/color_pattern.slint";
import { PatternIcons } from "components/color_pattern/icons.slint";
import { PatternUi } from "components/color_pattern/state.slint";
import { PatternButton, PatternIconButton, PatternChip } from "components/color_pattern/parts.slint";
import { PatternStage } from "components/color_pattern/preview_panel.slint";
import { PatternLayers } from "components/color_pattern/zone_list.slint";
import { PatternPicker } from "components/color_pattern/color_picker.slint";
import { PatternGallery } from "components/color_pattern/gallery.slint";
import { PatternAddMenu, PatternRowMenu } from "components/color_pattern/menus.slint";

export component ColorPatternWindow inherits Window {
    title: ColorPatternModel.title == "" ? "Color Pattern \u{2014} Pleochroma Cut" : "Color Pattern \u{2014} " + ColorPatternModel.title;
    // See `MainWindow`'s `icon` (app.slint) for why every window sets it.
    icon: @image-url("../assets/icon.png");
    preferred-width: 1120px;
    preferred-height: 780px;
    min-width: 960px;
    min-height: 640px;
    background: Theme.bg-darkest;
    default-font-family: "Segoe UI";

    // The layers panel's width (the `narrow` flag is set by Rust, never bound to this window).
    property <length> panel_w: ColorPatternModel.narrow ? 330px : 368px;
    // Overlay flags mirrored locally so a close can hand the keyboard back to the window.
    property <bool> gallery_shown: ColorPatternModel.gallery_open;
    property <bool> picker_shown: ColorPatternModel.picker_open;
    property <bool> add_shown: PatternUi.add_open;
    property <int> menu_shown: PatternUi.menu_row;
    property <int> rename_shown: PatternUi.rename_row;
    // A focused control that disappears (a closed overlay's button) leaves no focus at all, and
    // then Escape and the shortcuts would stop working: take the focus back.
    changed gallery_shown => {
        if !root.gallery_shown {
            window_keys.focus();
        }
    }
    changed picker_shown => {
        if !root.picker_shown {
            window_keys.focus();
        }
    }
    changed add_shown => {
        if !root.add_shown {
            window_keys.focus();
        }
    }
    changed menu_shown => {
        if root.menu_shown < 0 && PatternUi.rename_row < 0 {
            window_keys.focus();
        }
    }
    changed rename_shown => {
        if root.rename_shown < 0 {
            window_keys.focus();
        }
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        window_keys := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    if ColorPatternModel.gallery_open {
                        if ColorPatternModel.preset_naming {
                            ColorPatternModel.preset_name_cancelled();
                        } else {
                            ColorPatternModel.close_gallery();
                        }
                    } else if ColorPatternModel.picker_open {
                        ColorPatternModel.picker_cancelled();
                    } else if PatternUi.add_open {
                        PatternUi.add_open = false;
                    } else if PatternUi.menu_row >= 0 {
                        PatternUi.menu_row = -1;
                    } else if PatternUi.rename_row >= 0 {
                        PatternUi.rename_row = -1;
                    } else if ColorPatternModel.confirm_discard {
                        ColorPatternModel.discard_declined();
                    } else {
                        ColorPatternModel.cancel();
                    }
                    return accept;
                }
                if event.modifiers.alt && (event.text == Key.UpArrow || event.text == Key.DownArrow) && !ColorPatternModel.gallery_open && !ColorPatternModel.picker_open && PatternUi.rename_row < 0 {
                    if event.text == Key.UpArrow && ColorPatternModel.selected_row > 0 && ColorPatternModel.selected_row < ColorPatternModel.zone_rows.length - 1 {
                        ColorPatternModel.move_row(ColorPatternModel.selected_row, -1);
                    }
                    if event.text == Key.DownArrow && ColorPatternModel.selected_row >= 0 && ColorPatternModel.selected_row < ColorPatternModel.zone_rows.length - 2 {
                        ColorPatternModel.move_row(ColorPatternModel.selected_row, 1);
                    }
                    return accept;
                }
                if event.modifiers.control || event.modifiers.meta {
                    if event.text == "z" && !event.modifiers.shift {
                        ColorPatternModel.undo();
                        return accept;
                    }
                    if event.text == "y" || (event.text == "z" && event.modifiers.shift) {
                        ColorPatternModel.redo();
                        return accept;
                    }
                }
                return reject;
            }

            VerticalLayout {
                // --- Header: the stone, Start From, undo and redo -------------------------------------
                Rectangle {
                    height: 60px;
                    background: Theme.bg-dark;
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border-subtle;
                    }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            PatternChip {
                                a: ColorPatternModel.header_along;
                                b: ColorPatternModel.header_across;
                                split: true;
                                size: 32px;
                                accessible-role: AccessibleRole.image;
                                accessible-label: "The stone's base color and first layer color";
                            }
                        }
                        VerticalLayout {
                            min-width: 0px;
                            max-width: 560px;
                            horizontal-stretch: 0;
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: ColorPatternModel.title;
                                font-size: 16px;
                                font-weight: 600;
                                color: Theme.text-primary;
                                overflow: elide;
                                accessible-role: AccessibleRole.text;
                            }
                            Text {
                                text: ColorPatternModel.subtitle;
                                font-size: 11px;
                                color: Theme.text-secondary;
                                overflow: elide;
                                accessible-role: AccessibleRole.text;
                            }
                        }
                        Rectangle { width: 4px; }
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: start;
                                start_button := PatternButton {
                                    text: "Start From\u{2026}";
                                    icon: PatternIcons.grid;
                                    chevron: true;
                                    active: ColorPatternModel.gallery_open;
                                    hint: "Start from a template, the typical zoning of this stone or one of your presets. It replaces the layers; Undo brings them back.";
                                    clicked => {
                                        if ColorPatternModel.gallery_open {
                                            ColorPatternModel.close_gallery();
                                        } else {
                                            PatternUi.add_open = false;
                                            PatternUi.menu_row = -1;
                                            ColorPatternModel.open_gallery();
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            PatternIconButton {
                                d: PatternIcons.undo;
                                label: "Undo";
                                hint: ColorPatternModel.can_undo ? "Take back the last edit. Ctrl+Z does the same." : "There is nothing to undo.";
                                enabled: ColorPatternModel.can_undo;
                                clicked => { ColorPatternModel.undo(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            PatternIconButton {
                                d: PatternIcons.redo;
                                label: "Redo";
                                hint: ColorPatternModel.can_redo ? "Bring back the edit you took back. Ctrl+Y does the same." : "There is nothing to redo.";
                                enabled: ColorPatternModel.can_redo;
                                clicked => { ColorPatternModel.redo(); }
                            }
                        }
                    }
                }

                // --- Stage and layers ---------------------------------------------------------------------
                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;
                    vertical-stretch: 1;
                    PatternStage {
                        horizontal-stretch: 1;
                    }
                    PatternLayers {
                        width: root.panel_w;
                    }
                }

                // --- Discard question (Cancel with unsaved edits) ---------------------------------------------
                if ColorPatternModel.confirm_discard: Rectangle {
                    height: 44px;
                    background: Theme.surface-info;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        spacing: 8px;
                        Text {
                            horizontal-stretch: 1;
                            text: "Discard the changes to this pattern?";
                            font-size: 13px;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            accessible-role: AccessibleRole.text;
                        }
                        VerticalLayout {
                            alignment: center;
                            PatternButton {
                                text: "Keep Editing";
                                hint: "Go back to the pattern.";
                                clicked => { ColorPatternModel.discard_declined(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            PatternButton {
                                text: "Discard";
                                hint: "Close the window and throw the edits away.";
                                clicked => { ColorPatternModel.discard_confirmed(); }
                            }
                        }
                    }
                }

                // --- Footer: status and the buttons ----------------------------------------------------------------
                Rectangle {
                    height: 56px;
                    background: Theme.bg-dark;
                    Rectangle {
                        y: 0px;
                        height: 1px;
                        background: Theme.border-subtle;
                    }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: ColorPatternModel.solving_colors ? Theme.accent-cyan : (ColorPatternModel.dirty ? Theme.accent-amber : transparent);
                            }
                        }
                        Text {
                            text: ColorPatternModel.solving_colors ? "Solving colors\u{2026}" : (ColorPatternModel.dirty ? "Unsaved changes" : "");
                            font-size: 12px;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                            accessible-role: AccessibleRole.text;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            PatternButton {
                                text: "Cancel";
                                ghost: true;
                                h: 36px;
                                hint: "Close this window without keeping further changes. It asks first if there are edits. Escape does the same.";
                                clicked => { ColorPatternModel.cancel(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            PatternButton {
                                text: ColorPatternModel.stone_target ? "Done" : "Save to Material";
                                primary: true;
                                h: 36px;
                                enabled: ColorPatternModel.message == "" && !ColorPatternModel.picker_open;
                                hint: ColorPatternModel.message != ""
                                    ? ColorPatternModel.message
                                    : (ColorPatternModel.picker_open
                                        ? "Finish or cancel the color picker first."
                                        : (ColorPatternModel.stone_target ? "Use the pattern only on this stone and close this window." : "Store the pattern with the material and close this window."));
                                clicked => { ColorPatternModel.save(); }
                            }
                        }
                    }
                }
            }

            // --- Overlays: the gallery, the picker and the two menus ---------------------------------------------
            if ColorPatternModel.gallery_open: Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                background: Theme.scrim-light;
                TouchArea {
                    clicked => { ColorPatternModel.close_gallery(); }
                }
            }
            if ColorPatternModel.gallery_open: PatternGallery {
                x: Math.clamp(start_button.absolute-position.x, 12px, max(12px, root.width - 600px - 12px));
                y: 56px;
                room_height: root.height - 56px - 12px;
            }

            if ColorPatternModel.picker_open: PatternPicker {
                x: root.width - root.panel_w - 12px - self.width - 8px;
                y: Math.clamp(PatternUi.picker_y - 20px, 66px, max(66px, root.height - 64px - self.height));
            }

            if PatternUi.add_open: Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                TouchArea {
                    clicked => { PatternUi.add_open = false; }
                }
            }
            if PatternUi.add_open: PatternAddMenu {
                x: Math.clamp(PatternUi.add_x, 8px, max(8px, root.width - self.width - 8px));
                y: PatternUi.add_y;
            }

            if PatternUi.menu_row >= 0: Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                TouchArea {
                    clicked => { PatternUi.menu_row = -1; }
                }
            }
            if PatternUi.menu_row >= 0: PatternRowMenu {
                x: Math.clamp(PatternUi.menu_x, 8px, max(8px, root.width - self.width - 8px));
                y: Math.min(PatternUi.menu_y, root.height - self.height - 12px);
            }
        }
    }
}
