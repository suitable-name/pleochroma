import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { RoughPlanModel } from "models/rough_plan.slint";
import { KitIcon, KitIcons, KitIconButton, KitButton, KitSegmentBar } from "components/kit/kit.slint";
import { RoughUi } from "components/rough_planner/state.slint";
import { StepCard } from "components/rough_planner/step_card.slint";
import { RoughForm } from "components/rough_planner/rough_form.slint";
import { AxisPanel } from "components/rough_planner/axis_panel.slint";
import { CutList } from "components/rough_planner/cut_list.slint";
import { PlanForm } from "components/rough_planner/plan_form.slint";
import { PlanBlock } from "components/rough_planner/plan_block.slint";
import { FitView } from "components/rough_planner/fit_view.slint";
import { ResultsColumn } from "components/rough_planner/results_panel.slint";
import { SavedList } from "components/rough_planner/saved_list.slint";
import { ConfirmReplaceRow } from "components/rough_planner/save_name_row.slint";
import { RoughMenus } from "components/rough_planner/menus.slint";
import { HalfSegment } from "components/rough_planner/parts.slint";
import { ScrollFade } from "components/rough_planner/fields.slint";

export component RoughPlannerWindow inherits Window {
    title: "Rough Planner \u{2014} Pleochroma Cut";
    // See `MainWindow`'s `icon` (app.slint) for why every window sets it.
    icon: @image-url("../assets/icon.png");
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 1040px;
    min-height: 560px;
    background: Theme.bg-darkest;
    default-font-family: "Segoe UI";

    // The size of the 3D view's image area, read by Rust when the window is shown: the
    // area's own change notifications miss the size it has the first time it is laid out.
    out property <length> view_area_width: fit_view.area_width;
    out property <length> view_area_height: fit_view.area_height;

    // The open step changed: the steps list scrolls back to its top once the new body is laid out.
    property <int> seen_step: RoughPlanModel.open_step;
    property <bool> scroll_pending: false;
    changed seen_step => { root.scroll_pending = true; }

    // Below 1180 px the columns shrink so that the window fits its 1040 px minimum. Read from the
    // window's own width, not from a timer, so a resize never shows a frame of the wide layout.
    changed width => { RoughPlanModel.narrow = root.width > 0px && root.width < 1180px; }

    // Opens a step, or closes it when it is the open one.
    function toggle_step(step: int) {
        RoughPlanModel.open_step = RoughPlanModel.open_step == step ? -1 : step;
    }

    // Window-wide shortcuts. Ctrl+S, Ctrl+O and Ctrl+Enter are taken before any child
    // sees them; Escape, Ctrl+Z and Ctrl+Y are only handled when the focused child
    // (a text field, which keeps its own undo) leaves them unhandled, so typing is
    // never interrupted.
    FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        init => {
            self.focus();
            RoughPlanModel.narrow = root.width > 0px && root.width < 1180px;
        }

        capture-key-pressed(event) => {
            if (event.modifiers.control || event.modifiers.meta) && !event.modifiers.shift && event.text == "s" {
                if !RoughPlanModel.running {
                    RoughPlanModel.results_tab = 0;
                    RoughPlanModel.save_selected_only = RoughPlanModel.keep_count > 0;
                    RoughPlanModel.begin_save(RoughPlanModel.keep_count > 0);
                }
                return accept;
            }
            if (event.modifiers.control || event.modifiers.meta) && !event.modifiers.shift && event.text == "o" {
                RoughPlanModel.results_tab = 1;
                return accept;
            }
            if (event.modifiers.control || event.modifiers.meta) && event.text == Key.Return {
                if !RoughPlanModel.running && !RoughPlanModel.mesh_busy && RoughPlanModel.materials.length > 0 && RoughPlanModel.model_error == "" {
                    RoughPlanModel.plan();
                }
                return accept;
            }
            return reject;
        }

        key-pressed(event) => {
            if event.text == Key.Escape {
                if RoughUi.menu_kind != 0 {
                    RoughUi.menu_kind = 0;
                    return accept;
                }
                if RoughPlanModel.confirm_replace_open {
                    RoughPlanModel.confirm_replace(false);
                    RoughPlanModel.confirm_replace_open = false;
                    return accept;
                }
                if RoughPlanModel.confirm_overwrite_open {
                    RoughPlanModel.confirm_overwrite(false);
                    RoughPlanModel.confirm_overwrite_open = false;
                    return accept;
                }
                if RoughPlanModel.save_name_open {
                    RoughPlanModel.save_name_open = false;
                    return accept;
                }
                if RoughUi.rename_row >= 0 || RoughUi.delete_row >= 0 {
                    RoughUi.rename_row = -1;
                    RoughUi.delete_row = -1;
                    return accept;
                }
                if RoughPlanModel.face_from_view_armed {
                    RoughPlanModel.face_from_view_armed = false;
                    return accept;
                }
                if RoughPlanModel.axis_pick != 0 {
                    RoughPlanModel.axis_pick_start(0);
                    return accept;
                }
                if RoughPlanModel.running {
                    RoughPlanModel.cancel();
                    return accept;
                }
            }
            if (event.modifiers.control || event.modifiers.meta) && !event.modifiers.shift && event.text == "z" {
                if RoughPlanModel.can_undo && !RoughPlanModel.running {
                    RoughPlanModel.undo_shape();
                }
                return accept;
            }
            if (event.modifiers.control || event.modifiers.meta)
                && (event.text == "y" || (event.modifiers.shift && event.text == "Z")) {
                if RoughPlanModel.can_redo && !RoughPlanModel.running {
                    RoughPlanModel.redo_shape();
                }
                return accept;
            }
            return reject;
        }

        Rectangle {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;

            VerticalLayout {
                // Header (56 px)
                Rectangle {
                    height: 56px;
                    background: Theme.bg-dark;
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border-subtle;
                    }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        spacing: 12px;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 8px;
                                background: Theme.accent-cyan-surface;
                                KitIcon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    d: KitIcons.block;
                                    size: 20px;
                                    ink: Theme.accent-cyan-hover;
                                }
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: "Rough Planner";
                                font-size: 16px;
                                font-weight: 600;
                                color: Theme.text-primary;
                                accessible-role: AccessibleRole.text;
                            }
                            Rectangle {
                                height: 15px;
                                Text {
                                    x: 0px;
                                    width: parent.width;
                                    height: parent.height;
                                    text: RoughPlanModel.rough_subtitle;
                                    font-size: 11px;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            KitButton {
                                text: "New Rough";
                                kind: 2;
                                accessible-label: "New";
                                enabled: !RoughPlanModel.running;
                                hint: RoughPlanModel.running ? "Not while a plan is running. Wait for it to finish, or cancel it."
                                    : "Start again with an empty rough model and no cuts. If there are unsaved layouts you are asked first.";
                                clicked => { RoughPlanModel.new_model(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            KitIconButton {
                                d: KitIcons.undo;
                                label: "Undo";
                                hint: RoughPlanModel.running ? "Not while a plan is running." : "Take back the last change to the shape. Ctrl+Z does the same.";
                                enabled: RoughPlanModel.can_undo && !RoughPlanModel.running;
                                clicked => { RoughPlanModel.undo_shape(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            KitIconButton {
                                d: KitIcons.redo;
                                label: "Redo";
                                hint: RoughPlanModel.running ? "Not while a plan is running." : "Do the change to the shape again that Undo took back. Ctrl+Y does the same.";
                                enabled: RoughPlanModel.can_redo && !RoughPlanModel.running;
                                clicked => { RoughPlanModel.redo_shape(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            KitIconButton {
                                d: KitIcons.help;
                                label: "Help";
                                hint: "Open the manual page on planning a rough.";
                                clicked => { RoughPlanModel.open_help(); }
                            }
                        }
                    }
                }

                // Body: the steps, the view, the layouts
                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;
                    vertical-stretch: 1;

                    // Left column: the four steps over the sticky Plan block.
                    Rectangle {
                        width: RoughPlanModel.narrow ? 316px : 340px;
                        background: Theme.bg-dark;
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        clip: true;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 6px;

                            // The steps scroll above the Plan block. The fade over the bottom
                            // edge shows that there is more below when a step is cut off there.
                            Rectangle {
                                vertical-stretch: 1;
                                min-height: 120px;
                                clip: true;

                                Timer {
                                    interval: 60ms;
                                    running: root.scroll_pending;
                                    triggered => {
                                        root.scroll_pending = false;
                                        left_scroll.content-y = 0px;
                                    }
                                }

                                left_scroll := ScrollView {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width;
                                    height: parent.height;
                                    // The content is exactly as wide as the visible part: no
                                    // sideways scrolling, no content centred past both edges.
                                    content-width: self.visible-width;

                                    VerticalLayout {
                                        alignment: start;
                                        spacing: 4px;
                                        // The scroll bar is drawn over the right edge of the
                                        // content: keep the steps clear of it.
                                        padding-right: 10px;

                                        StepCard {
                                            num: 1;
                                            title: "Rough";
                                            summary: RoughPlanModel.step_summary[0];
                                            error: RoughPlanModel.step_error[0];
                                            done: RoughPlanModel.step_done[0];
                                            open: RoughPlanModel.open_step == 0;
                                            toggled => { root.toggle_step(0); }
                                            if RoughPlanModel.open_step == 0: RoughForm {}
                                        }

                                        if RoughPlanModel.axis_available: StepCard {
                                            num: 2;
                                            title: "Crystal Axis";
                                            optional: true;
                                            summary: RoughPlanModel.step_summary[1];
                                            error: RoughPlanModel.step_error[1];
                                            done: RoughPlanModel.step_done[1];
                                            open: RoughPlanModel.open_step == 1;
                                            toggled => { root.toggle_step(1); }
                                            if RoughPlanModel.open_step == 1: AxisPanel {}
                                        }

                                        StepCard {
                                            num: RoughPlanModel.axis_available ? 3 : 2;
                                            title: "Shape Cuts";
                                            optional: true;
                                            summary: RoughPlanModel.step_summary[2];
                                            error: RoughPlanModel.step_error[2];
                                            done: RoughPlanModel.step_done[2];
                                            open: RoughPlanModel.open_step == 2;
                                            toggled => { root.toggle_step(2); }
                                            if RoughPlanModel.open_step == 2: CutList {
                                                // Scrolls a newly added cut row into view: `row_y` is
                                                // the row's window position, so its place in the
                                                // visible part is its distance from the scroll view's
                                                // own top.
                                                reveal_row(row_y, row_height) => {
                                                    let row_top = row_y - left_scroll.absolute-position.y;
                                                    let area_height = left_scroll.visible-height;
                                                    let shift = row_top < 0px ? row_top
                                                        : (row_top + row_height > area_height
                                                            ? min(row_top + row_height - area_height, row_top) : 0px);
                                                    left_scroll.content-y = left_scroll.content-y - shift;
                                                }
                                            }
                                        }

                                        StepCard {
                                            num: RoughPlanModel.axis_available ? 4 : 3;
                                            title: "Plan Settings";
                                            summary: RoughPlanModel.step_summary[3];
                                            error: RoughPlanModel.step_error[3];
                                            done: RoughPlanModel.step_done[3];
                                            open: RoughPlanModel.open_step == 3;
                                            toggled => { root.toggle_step(3); }
                                            if RoughPlanModel.open_step == 3: PlanForm {}
                                        }
                                    }
                                }

                                ScrollFade {
                                    y: parent.height - self.height;
                                    width: parent.width - 10px;
                                    tint: Theme.bg-dark;
                                    more: left_scroll.content-height + left_scroll.content-y - left_scroll.visible-height > 2px;
                                }
                            }

                            // The sticky Plan block: an input or run error above it.
                            if RoughPlanModel.error_text != "": Text {
                                text: RoughPlanModel.error_text;
                                font-size: 11px;
                                color: Theme.danger;
                                wrap: word-wrap;
                                overflow: elide;
                                max-height: 60px;
                            }

                            PlanBlock {}
                        }
                    }

                    // Center: the 3D view
                    Rectangle {
                        min-width: 340px;
                        horizontal-stretch: 1;
                        background: Theme.bg-input;
                        border-radius: 14px;
                        clip: true;

                        fit_view := FitView {}
                    }

                    // Right column: the Layouts and Saved Plans tabs. The two lists stay alive and
                    // only switch visibility, so neither loses its scroll position.
                    Rectangle {
                        width: RoughPlanModel.narrow ? 320px : 372px;
                        background: Theme.bg-dark;
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        clip: true;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;

                            KitSegmentBar {
                                height: 34px;
                                HorizontalLayout {
                                    padding: 3px;
                                    spacing: 3px;
                                    HalfSegment {
                                        text: RoughPlanModel.results.length > 0 ? "Layouts \u{00B7} " + RoughPlanModel.results.length : "Layouts";
                                        alabel: "Layouts";
                                        hint: "Show the ranked layouts of the last plan.";
                                        on: RoughPlanModel.results_tab == 0;
                                        picked => { RoughPlanModel.results_tab = 0; }
                                    }
                                    HalfSegment {
                                        text: RoughPlanModel.saved_plans.length > 0 ? "Saved Plans \u{00B7} " + RoughPlanModel.saved_plans.length : "Saved Plans";
                                        alabel: "Saved Plans";
                                        hint: "Show the plans you saved earlier, to open, rename, export or delete them. Ctrl+O does the same.";
                                        on: RoughPlanModel.results_tab == 1;
                                        picked => { RoughPlanModel.results_tab = 1; }
                                    }
                                }
                            }

                            if RoughPlanModel.confirm_replace_open: ConfirmReplaceRow {}

                            Rectangle {
                                vertical-stretch: 1;

                                if RoughPlanModel.results_tab == 0: Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width;
                                    height: parent.height;

                                    ResultsColumn {
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                }

                                if RoughPlanModel.results_tab == 1: Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width;
                                    height: parent.height;

                                    SavedList {
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // The open menu, over everything (a window-level element at a computed place).
            if RoughUi.menu_kind != 0: RoughMenus {
                win_w: root.width;
                win_h: root.height;
            }
        }
    }
}
