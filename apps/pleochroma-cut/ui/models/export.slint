import { LightingPresetItem } from "../types.slint";
import { RemoteWorkerModel } from "remote_worker.slint";

// High-resolution render export, independent of the live viewport
// (`bridge::export_thread`). `ExportDialog` reads this directly; `GemViewportView`
// only needs `is_open` to decide whether to instantiate the dialog at all.
export global ExportModel {
    // Renderer: 0 Path-Traced, 1 Ray-Traced. AA applies only to Ray-Traced.
    in-out property <int> engine_index: 0;
    in-out property <int> ray_taps: 16;
    in-out property <bool> ray_fire: true;
    in-out property <bool> is_open: false;

    in-out property <int> selected_size_preset: 0; // 0: 1080p, 1: 4K, 2: Custom
    in-out property <int> custom_width: 1920;
    in-out property <int> custom_height: 1080;
    // Continuous drag target for the sample-count slider; `sample_exponent` (in
    // `export_dialog.slint`) rounds it to the nearest integer so the power-of-two math
    // stays exact mid-drag. 10.0 (1024 samples) is the default.
    in-out property <float> sample_exponent_raw: 10.0;
    // "Adaptive Sampling": each part of the picture stops once it is clean enough, and the
    // samples setting becomes the most any part gets. Off renders exactly as before. Seeded
    // every time the dialog opens and written back like the other settings
    // (`gui::render::output_defaults`); the Rust side ignores it for the Ray-Traced renderer.
    in-out property <bool> adaptive_sampling: false;
    // "Target Noise": 0 Fine, 1 Standard, 2 Draft -- an index into
    // `pleochroma::renderer::adaptive::TARGET_NOISE_PRESETS`.
    in-out property <int> target_noise_index: 1;
    // "Path Cache": shade the stone from cached light paths, and "Keep for Re-Renders": write
    // the cache to disk. Off renders exactly as before. Remembered like the adaptive box; the
    // Rust side ignores both for the Ray-Traced renderer.
    in-out property <bool> path_cache: false;
    in-out property <bool> keep_path_cache: false;
    // Whether the path cache and beam tracing can be used at all. Rust sets both every time the
    // dialog opens: `false` under exit collection, the app's default estimator, which uses
    // neither; the boxes are then greyed out with a note.
    in property <bool> path_cache_available: true;
    in property <bool> beam_available: true;
    // "Beam Tracing (Faceted Stones)": follow the light through the stone as beams and finish the
    // picture with path samples. Off renders exactly as before. Remembered like the path cache
    // box; the Rust side ignores it for the Ray-Traced renderer.
    in-out property <bool> beam: false;
    // "Keep Beams for Re-Renders": store the beams on disk, so rendering the same view again starts
    // from them. Remembered like the beam box; `beam_keep_available` is `false` for a build that
    // cannot store beams (Rust sets it every time the dialog opens), which greys the box out.
    in-out property <bool> keep_beams: false;
    in property <bool> beam_keep_available: true;
    // Export color space: 0 = sRGB (default, untagged), 1 = Display P3, 2 = Rec.2020. Both
    // wide-gamut choices embed an ICC profile (`pleochroma::render_setup::icc_profile::build`)
    // so a viewer never reads the file as sRGB.
    in-out property <int> selected_color_space_index: 0;

    // Whether a configured worker was confirmed reachable and render-capable the last
    // time `check_remote_availability` ran is `RemoteWorkerModel.availability.
    // reachable_render_capable` (the one remote-availability value). `false` disables the
    // Remote/Local+Remote pills WITH a reason shown, never silently hides them.
    //
    // Human-readable reason that is `false` -- distinguishes "no worker
    // configured" / "worker unreachable" / "worker is library-only" (see
    // `bridge::export_thread::remote::RemoteUnavailable::message`), rather than one
    // generic "unavailable".
    in property <string> remote_unavailable_reason: "";
    // The dialog's Compute pill: 0 = Local only, 1 = Remote only, 2 = Local + Remote. This is
    // the person's CHOICE, seeded from the last-used value (`AppSettings::output.still`) every
    // time the dialog opens and written back when an export starts; it survives a remote that
    // is down at the moment.
    in-out property <int> compute_target_index: 2;
    // What the export actually uses: the choice while a usable remote exists, Local only
    // otherwise (the pills for the remote are greyed out then, with the reason shown).
    out property <int> effective_compute_target: RemoteWorkerModel.availability.reachable_render_capable ? root.compute_target_index : 0;
    // The Max Ray Bounces pill: an index into `SettingsModel.bounce_ladder`, seeded and
    // remembered like `compute_target_index` -- the export's OWN cap, independent of the live
    // viewport's.
    in-out property <int> bounce_index: 2;
    // "Transfer": 0 = Full data (float radiance, merged with the
    // local lanes), 1 = Final picture only (the remote renders AND tone-maps; one PNG
    // comes back, the local lanes stay idle). Seeded every time the dialog opens
    // (`populate_fanout_presets`) from the last-used choice, or from the remote
    // endpoint's own default while none was made yet; read by Rust
    // when the export starts. Only shown while a remote is available and the Compute
    // pill includes it.
    in-out property <int> transfer_index: 0;

    // Preset fan-out: every export-usable preset
    // (`gui::render_export::setup_populate_export_fanout_presets_callback` rebuilds
    // this every time the dialog opens), each with its own checkbox (`item.selected`,
    // toggled via `toggle_preset_selected`). A selected preset produces an ADDITIONAL
    // rendered file alongside the current-view render, named from the same template
    // with `{preset}` filled in -- see `bridge::export_thread`'s module doc comment.
    in property <[LightingPresetItem]> fanout_presets: [];
    callback toggle_preset_selected(int);
    callback populate_fanout_presets();

    // Fan-out progress status: current job index/total/label, for the dialog's own
    // "Rendering preset 2 of 5" status text (`export_progress` below already folds
    // these into one combined fraction for the progress bar).
    in property <int> preset_index: 0;
    in property <int> preset_total: 1;
    in property <string> current_preset_label: "";

    // The export directory and filename template. `directory` is READ-ONLY here (""
    // means "not chosen yet": the next export prompts with a native folder picker);
    // `change_directory` opens that picker on demand. `filename_template` is an editable
    // text field; Rust persists every edit via `filename_template_changed`.
    in property <string> directory: "";
    callback change_directory();
    // --- R3D --- The Files page's "Open Exports Folder": opens `directory` (this model's) in the
    // file manager, else the folder of the last file the Edit tab wrote, else `./exports/`.
    callback open_exports_folder(string);
    in-out property <string> filename_template: "";
    callback filename_template_changed(string);
    // Live "resolves to" preview of the filename template, for THIS export: the template,
    // then the export's width, height, samples, max bounces, color space index and material
    // (the dialog passes them, so the preview follows every change); the design names and
    // the camera come from the live view, as the export's own naming takes them.
    pure callback preview_filename_template(string, int, int, int, int, int, string) -> string;
    // Unrecognized `{name}` placeholders in the template (checked against an example).
    pure callback filename_template_unknown_placeholders(string) -> string;

    in property <bool> is_exporting: false;
    in property <float> progress: 0.0; // 0.0 .. 1.0
    // A short "about N s/min/h left" reading alongside `progress`'s percentage --
    // `""` while there isn't yet enough history for an estimate (see
    // `gui::progress_eta::EtaEstimator`), never a raw seconds count.
    in property <string> eta_text: "";
    in property <string> status_message: "";
    // The last one-off note the running export reported (the path cache's size estimate, or
    // the reason it is not used), kept under the progress bar. Cleared when a job starts.
    in property <string> progress_note: "";
    in property <bool> has_error: false;
    // Live preview: a small in-progress thumbnail of the accumulation buffer, pushed
    // alongside `progress` at up to ~2 updates/sec (see
    // `bridge::export_thread::preview::PreviewThrottle`). `preview_samples_done` is
    // also the "has a preview arrived yet" flag -- 0 until the first tick.
    in property <image> preview_image;
    in property <int> preview_samples_done: 0;
    in property <int> preview_samples_total: 0;

    // Whether a setting that Simple mode hides is off its default: color-space index,
    // transfer index and whether a remote is reachable, in that order
    // (`gui::render::render_export::advanced`, which holds the rule and its tests).
    pure callback advanced_in_use(int, int, bool) -> bool;

    // width, height, samples-per-pixel, color-space index, compute-target index, max
    // ray bounces (the resolved rung VALUE, not the pill index).
    callback start_export(int, int, int, int, int, int);
    callback cancel_export();
    callback check_remote_availability();

    // Not while an export runs: the dialog is then only being shown again (the header's export
    // indicator), and refreshing would reset the preset checkboxes and the Transfer choice
    // the running export was started with.
    // Closing keeps the dialog's values for the next time it opens
    // (`gui::render::output_defaults::remember_still`).
    callback dialog_closed();
    changed is_open => {
        if root.is_open && !root.is_exporting {
            root.check_remote_availability();
            root.populate_fanout_presets();
        }
        if !root.is_open {
            root.dialog_closed();
        }
    }
}
