// The Color Pattern Editor window's state.
//
// A global is instantiated once per top-level window, so the Color Pattern window has its OWN
// instance of `ColorPatternModel`, set by Rust (`gui::color_pattern`). The window holds only
// what is typed and a few transient overlay positions; everything else is pushed from Rust.
// Properties the user edits are `in-out` so a control can two-way bind them (a `ComboBox`, a
// `LineEdit`); Rust still owns the truth and writes them back on every change.
//
// Slider callbacks (`param_changed`, `size_changed`, ...) fire on every value change, including
// the one a Rust write causes: Rust should ignore a value equal to the one it holds.
//
// Row indexes (`select_row`, `delete_row`, ...) are VIEW indexes: the list shows the top layer
// first and the base last, the reverse of the stored order. Rust maps them.

// One row of the layer list: the base zone or one zone inside it.
export struct PatternZoneRow {
    // "Base" or "Zone 1".
    title: string,
    // The cutter's name for the zone ("Rim", "Core").
    name: string,
    // "3-Sided Prism", or "Everywhere else" for the base.
    shape: string,
    // One short line of the key numbers ("3-sided prism \u{b7} 22 % wide").
    summary: string,
    // The zone's color (the Along or Alpha color of a pleochroic zone).
    swatch: color,
    // The Across or Gamma color; only drawn when `dichroic` is true.
    swatch_across: color,
    // The Beta color of a biaxial zone (unused for the diagonal swatch, kept for tooltips).
    swatch_mid: color,
    // The zone is pleochroic: Along and Across, Alpha, Beta and Gamma, or a pleochroic variant.
    dichroic: bool,
    selected: bool,
    // The session-only eye: the zone is left out of the preview (never stored).
    hidden: bool,
    // -1 for the base, else the index into `shape_options` (picks the shape icon).
    shape_icon: int,
    // The base zone: locked, no grip, no move or delete.
    is_base: bool,
}

// One parameter slider of the selected zone (Advanced mode).
export struct PatternParamRow {
    label: string,
    value: float,
    min: float,
    max: float,
    step: float,
    // "% of width", "mm" or "\u{b0}" (the readout is `text` followed by this).
    unit: string,
    // The value as it is read out ("3.25").
    text: string,
    enabled: bool,
    // One plain sentence: what the number means, or why it is off.
    hint: string,
}

// One handle drawn over the main Slice picture. `x` and `y` are fractions (0 to 1) of the
// preview image's width and height, so the window needs no knowledge of the camera.
export struct PatternHandle {
    x: float,
    y: float,
    // 0 move, 1 size, 2 rotate, 3 other: tells the window which shape to draw.
    kind: int,
    hovered: bool,
    // What dragging it changes ("Size 22 %", "Offset X 3 %"); shown in a chip while hovered.
    label: string,
}

// One color tile of the selected card.
export struct PatternColorTile {
    // "Color", "Along c", "Across c", "\u{3b1}", "\u{3b2}" or "\u{3b3}".
    caption: string,
    color: color,
    // The `open_picker` slot: 0 the one color, 1 Along or Alpha, 2 Across or Beta, 3 Gamma.
    slot: int,
    // The zone takes this color from a material variant (a click turns it into a custom color).
    from_variant: bool,
}

// One material variant offered as a chip in the picker.
export struct PatternVariantChip {
    label: string,
    along: color,
    across: color,
}

// One thumbnail of the "Start From" gallery.
export struct PatternTile {
    label: string,
    image: image,
    // The species' typical zoning (drawn with the amber star).
    typical: bool,
}

export global ColorPatternModel {
    // --- Header ----------------------------------------------------------------------------
    // The material's name ("Watermelon Tourmaline"), shown in the header. The window builds its
    // own title ("Color Pattern \u{2014} " + title) from it; empty: just "Color Pattern".
    in property <string> title;
    // The header's second line: the layer count and the pattern axis.
    in property <string> subtitle;
    in property <bool> stone_target: false;
    in property <bool> targets_design: false;
    in property <bool> design_preview_available: false;
    // The Advanced controls (zone shape and parameter rows, axis tilt and turn) are shown. Pushed
    // from `GuideModel.shows_advanced()` of the main window, because this window has its own
    // `GuideModel` instance.
    in property <bool> show_advanced: false;
    // The pattern differs from what the material dialog holds.
    in property <bool> dirty: false;
    // A color is being solved on the worker: the footer says so.
    in property <bool> solving_colors: false;
    // The window is below 1060 px wide: a narrower layer panel, inset and Edges slider. Set by
    // Rust from the window width as a plain value; never a binding to the width (a loop).
    in property <bool> narrow: false;
    // The header chip: the base color, and the first zone's color.
    in property <color> header_along: #888888;
    in property <color> header_across: #888888;

    // --- "Start From" gallery ------------------------------------------------------------------
    in property <bool> gallery_open: false;
    callback open_gallery();
    callback close_gallery();
    // "Typical for Tourmaline"; empty means the gallery has no such section.
    in property <string> typical_section;
    in property <[PatternTile]> typical_tiles;
    in property <[PatternTile]> template_tiles;
    in property <[PatternTile]> preset_tiles;
    // Each takes an index into its own tile list. Picking one closes the gallery (Rust).
    callback typical_picked(int);
    callback template_picked(int);
    callback preset_picked(int);
    // The \u{d7} on a preset tile.
    callback preset_delete(int);
    // The "Save Current" tile: Rust opens the name field (`preset_naming`) with a suggested name.
    callback save_preset();
    in property <bool> preset_naming: false;
    in-out property <string> preset_name;
    // Enter, or "Save" beside the field, with the typed name.
    callback preset_name_committed(string);
    callback preset_name_cancelled();

    // --- Stage -------------------------------------------------------------------------------
    // 0 Stone (the design, Path-Traced), 1 Slice, 2 Crystal.
    in-out property <int> view: 1;
    callback view_changed(int);
    in property <image> preview_image;
    // The other main view, small, bottom right of the stage.
    in property <image> inset_image;
    // "Slice 50 % \u{b7} drag to edit" or "Stone".
    in property <string> inset_caption;
    // The inset's expand button, or a click on the inset.
    callback swap_views();
    // 0 idle, 1 refining (samples are being added), 2 updating (a new pattern is waiting).
    in property <int> render_state: 0;
    // The status chip's tooltip: which views show the pattern.
    in property <string> render_hint;
    // The Slice view's position along the pattern axis, 0 to 1 (the rail beside the picture).
    in-out property <float> slice_pos: 0.5;
    callback slice_changed(float);
    // The size of the main picture area and of the inset picture in logical pixels, written by
    // the window whenever they change. Rust renders at that aspect, so the pictures fill their
    // areas and the handle fractions below match.
    in-out property <length> preview_area_width: 0px;
    in-out property <length> preview_area_height: 0px;
    in-out property <length> inset_area_width: 0px;
    in-out property <length> inset_area_height: 0px;
    // Zone handles over the main Slice picture, in the order Rust draws them.
    in property <[PatternHandle]> handle_points;
    // The pointer over the main picture: x and y as fractions of the picture (0 to 1), then 0
    // down, 1 move, 2 up. Rust picks and drags handles from it, and selects the zone under a
    // press that misses every handle.
    callback viewport_pointer(float, float, int);
    // Where the selected zone's name chip sits, as picture fractions; negative hides it.
    in property <float> selected_label_x: -1;
    in property <float> selected_label_y: -1;

    // --- Layers --------------------------------------------------------------------------------
    // Top layer first, the base last.
    in property <[PatternZoneRow]> zone_rows;
    // Index into `zone_rows`.
    in property <int> selected_row: 0;
    // "A pattern holds at most 4 zones besides the base." while `can_add_zone` is false.
    in property <bool> can_add_zone: true;
    in property <string> add_zone_hint;
    // "Cylinder", "3-Sided Prism", ... (the order the shape icons follow).
    in property <[string]> shape_options;
    callback select_row(int);
    // The index into `shape_options` of the shape to add; the new zone goes on top.
    callback add_zone(int);
    callback duplicate_row(int);
    callback delete_row(int);
    // `delta` -1 moves the row up the list (it covers more), +1 down.
    callback move_row(int, int);
    // Drag and drop: the card at view index `from` is dropped at view index `to`.
    callback reorder_row(int, int);
    // The eye: leave the zone out of the preview (session only).
    callback toggle_hidden(int);
    callback rename_row(int, string);

    // --- Selected card -----------------------------------------------------------------------------
    // Shape icons (Advanced). Disabled for the base zone.
    in-out property <int> shape_index: 0;
    in property <bool> shape_enabled: false;
    callback shape_changed(int);
    // The parameter rows of the shape (Advanced).
    in property <[PatternParamRow]> param_rows;
    callback param_changed(int, float);
    // The Simple Size slider, in percent of the stone width (or mm when the pattern is Fixed in
    // mm). `size_enabled` is false for the base zone.
    in-out property <float> size_value: 50;
    in property <float> size_min: 5;
    in property <float> size_max: 100;
    in property <float> size_step: 1;
    in property <string> size_text;
    in property <bool> size_enabled: false;
    callback size_changed(float);
    // One tile per color: one on a cubic or amorphous material, Along c and Across c on a
    // uniaxial one, \u{3b1}, \u{3b2} and \u{3b3} on a biaxial one.
    in property <[PatternColorTile]> color_tiles;
    // "Pleochroic \u{b7} uniaxial".
    in property <string> rank_text;
    // "Custom color" first, then the material's variants.
    in property <[string]> variant_labels;
    // The variant the zone has; 0 is "Custom color".
    in-out property <int> variant_index: 0;
    callback variant_picked(int);
    // "From Rubellite", under the tiles of a variant zone; empty otherwise.
    in property <string> variant_caption;
    // A one-color zone on a pleochroic material: the amber notice and its Convert button.
    in property <bool> legacy_notice: false;
    callback convert_legacy();
    // The validation sentence, amber at the bottom of the selected card; empty when valid.
    in property <string> message;
    // Not read by the window: the color tiles, `variant_labels` and `variant_caption` replace them.
    in property <int> color_kind: 0;
    in property <bool> variants_available: false;
    in property <string> variant_hint;

    // --- Color picker popover --------------------------------------------------------------------
    in property <bool> picker_open: false;
    // The tile slot being edited (the same numbers as `PatternColorTile.slot`).
    in property <int> picker_slot: 0;
    // "Along the c-axis".
    in property <string> picker_title;
    // The LCh plane at the current hue (chroma to the right, lightness up) and the hue strip.
    in property <image> picker_plane;
    in property <image> picker_hue_strip;
    // Lightness 0 to 100, chroma 0 to 150, hue 0 to 360.
    in-out property <float> picker_l: 55;
    in-out property <float> picker_c: 40;
    in-out property <float> picker_h: 260;
    in-out property <string> picker_hex;
    // The L, C and H number fields were committed.
    callback picker_lch_changed(float, float, float);
    // Plane: x (chroma) and y (lightness, 0 at the top) as fractions; phase 0 down, 1 move, 2 up.
    callback picker_plane_pointer(float, float, int);
    // The hue strip: x as a fraction; phase as above.
    callback picker_hue_pointer(float, int);
    callback picker_hex_committed(string);
    // A tile was clicked: open the picker for that slot.
    callback open_picker(int);
    in property <[PatternVariantChip]> picker_variants;
    callback picker_variant_picked(int);
    // The picked color, and the color the stone shows for it, with one sentence about it.
    in property <color> picker_result_from: #888888;
    in property <color> picker_result_to: #888888;
    in property <string> picker_result_text;
    in property <bool> picker_solving: false;
    callback picker_applied();
    callback picker_cancelled();

    // --- Pattern toolbar ----------------------------------------------------------------------------
    // "Table Normal", "Across", "Across Turned", "Custom".
    in property <[string]> axis_options;
    in-out property <int> axis_index: 0;
    // Tilt and turn in degrees (Advanced); editable when the axis is Custom (index 3).
    in-out property <float> tilt_deg: 0;
    in-out property <float> turn_deg: 0;
    // true: "Scales With Stone"; false: "Fixed in mm".
    in property <bool> scales_with_stone: true;
    // Boundary softness: 0 Sharp to 1 Soft.
    in-out property <float> softness: 0;
    callback axis_changed(int);
    callback tilt_turn_changed(float, float);
    callback scale_mode_changed(bool);
    callback softness_changed(float);

    // --- Footer and history ---------------------------------------------------------------------------
    in property <bool> can_undo: false;
    in property <bool> can_redo: false;
    callback undo();
    callback redo();
    // Close without keeping the edits (Rust asks first when `dirty`).
    callback cancel();
    // Cancel was pressed with unsaved edits: the window asks "Discard the changes to this
    // pattern?" in a bar above the footer.
    in property <bool> confirm_discard: false;
    callback discard_confirmed();
    callback discard_declined();
    // Store the pattern with the material and close the window ("Done" or "Save to Material").
    callback save();
}
