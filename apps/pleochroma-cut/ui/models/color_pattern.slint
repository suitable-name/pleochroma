// The Color Pattern Editor window's state (plan 2026-10-21, section 5.2).
//
// A global is instantiated once per top-level window, so the Color Pattern window has its OWN
// instance of `ColorPatternModel`, set by Rust (`gui::color_pattern`). The window holds only what
// is typed; everything it shows is pushed from Rust. Properties the user edits are `in-out` so a
// control can two-way bind them (a `ComboBox`, a `LineEdit`); Rust still owns the truth and writes
// them back on every change.
//
// Slider callbacks (`param_changed`, `size_changed`, ...) fire on every value change, including
// the one a Rust write causes: Rust should ignore a value equal to the one it holds.

// One row of the zone list: the base zone or one zone inside it.
export struct PatternZoneRow {
    // "Base" or "Zone 1".
    title: string,
    // The cutter's name for the zone ("Rim", "Core").
    name: string,
    // "3-Sided Prism", or "Everywhere else" for the base.
    shape: string,
    // One short line of the key numbers ("35 % of width").
    summary: string,
    // The zone's color (the Along or Alpha color of a pleochroic zone).
    swatch: color,
    // The Across or Gamma color; only drawn when `dichroic` is true.
    swatch_across: color,
    // The zone is pleochroic: Along and Across, Alpha, Beta and Gamma, or a pleochroic variant.
    dichroic: bool,
    selected: bool,
}

// One parameter slider of the selected zone (Advanced mode).
export struct PatternParamRow {
    label: string,
    value: float,
    min: float,
    max: float,
    step: float,
    // "% of width", "mm" or "\u{b0}" (the readout is `text` followed by this).
    unit: string,
    // The value as it is read out ("3.25").
    text: string,
    enabled: bool,
    // One plain sentence: what the number means, or why it is off.
    hint: string,
}

// One handle drawn over the preview image. `x` and `y` are fractions (0 to 1) of the preview
// image's width and height, so the window needs no knowledge of the camera.
export struct PatternHandle {
    x: float,
    y: float,
    // 0 move, 1 size, 2 rotate, 3 other: tells the window which shape to draw.
    kind: int,
    hovered: bool,
}

export global ColorPatternModel {
    // --- Header ----------------------------------------------------------------------------
    // The full window title ("Color Pattern \u{2014} Watermelon Tourmaline"); empty: the default.
    in property <string> title;
    in property <bool> stone_target: false;
    in property <bool> targets_design: false;
    in property <bool> design_preview_available: false;
    // The Advanced controls (zone shape and parameter rows, axis tilt and turn) are shown. Pushed
    // from `GuideModel.shows_advanced()` of the main window, because this window has its own
    // `GuideModel` instance.
    in property <bool> show_advanced: false;
    // The pattern differs from what the material dialog holds.
    in property <bool> dirty: false;
    // A color is being solved on the worker: the window says so beside the buttons.
    in property <bool> solving_colors: false;

    // --- Templates and presets ---------------------------------------------------------------
    // "Uniform", "Bicolor", "Tricolor", "Banded", "Watermelon", ...
    in property <[string]> template_labels;
    // The saved presets of the Presets menu. The first entry is the menu's own prompt
    // ("My Presets"), which picks nothing.
    in property <[string]> preset_labels;
    callback template_picked(int);
    // The typical patterns of the stone's species ("Hexagonal Banding" for a sapphire), shown
    // before the generic templates; empty for a species that has none. `typical_title` is
    // "Typical for Sapphire:". Picking one builds the pattern from the stone's own color.
    in property <string> typical_title;
    in property <[string]> typical_labels;
    callback typical_picked(int);
    callback preset_picked(int);
    // "Save as Preset...": Rust opens the name field (`preset_naming`) with a suggested name.
    callback save_preset();
    // The preset name field is open next to the Presets menu; the text is `preset_name`.
    in property <bool> preset_naming: false;
    in-out property <string> preset_name;
    // Enter, or "Save" beside the field, with the typed name.
    callback preset_name_committed(string);
    callback preset_name_cancelled();

    // --- Preview -----------------------------------------------------------------------------
    // 0 Crystal, 1 Current Design, 2 Cross-Section.
    in-out property <int> preview_mode: 2;
    in property <image> preview_image;
    // The preview is being (re)drawn: the window shows "Updating..." over the old picture.
    in property <bool> preview_busy: false;
    // "Patterns show in Path-Traced views. Ray-Traced shows the base color."
    in property <string> preview_note;
    // The Cross-Section's slice position along the pattern axis, 0 to 1. Used in mode 2 only.
    in-out property <float> slice_pos: 0.5;
    // The size of the picture area in logical pixels, written by the window whenever it changes.
    // Rust renders the preview at this aspect, so the picture fills the area and the handle
    // fractions below match it.
    in-out property <length> preview_area_width: 0px;
    in-out property <length> preview_area_height: 0px;
    // Zone handles over the preview, in the order Rust draws them.
    in property <[PatternHandle]> handle_points;
    callback preview_mode_changed(int);
    callback slice_changed(float);
    // The pointer over the preview: x and y as fractions of the picture (0 to 1), then 0 down,
    // 1 move, 2 up. Rust picks and drags handles from it.
    callback viewport_pointer(float, float, int);

    // --- Zone list -----------------------------------------------------------------------------
    in property <[PatternZoneRow]> zone_rows;
    // Index into `zone_rows`; 0 is the base zone.
    in property <int> selected_zone: 0;
    // "A pattern holds at most 4 zones besides the base." while `can_add_zone` is false.
    in property <bool> can_add_zone: true;
    in property <string> add_zone_hint;
    // The selected zone is not the base (Duplicate, Delete, Move need a real zone).
    in property <bool> can_edit_zone: false;
    callback select_zone(int);
    // The index into `shape_options` of the shape to add.
    callback add_zone(int);
    callback duplicate_zone();
    callback delete_zone();
    // -1 moves the selected zone up the list (it covers fewer zones), +1 down.
    callback move_zone(int);

    // --- Selected zone ---------------------------------------------------------------------------
    // The name field; Rust sets it on selection, the window two-way binds it.
    in-out property <string> zone_name;
    callback rename_zone(string);
    // Shape combo (Advanced). Disabled for the base zone.
    in property <[string]> shape_options;
    in-out property <int> shape_index: 0;
    in property <bool> shape_enabled: false;
    callback shape_changed(int);
    // The parameter rows of the shape (Advanced).
    in property <[PatternParamRow]> param_rows;
    callback param_changed(int, float);
    // The Simple Size slider, in percent of the stone width (or mm when the pattern is Fixed in
    // mm). `size_enabled` is false for the base zone.
    in-out property <float> size_value: 50;
    in property <float> size_min: 5;
    in property <float> size_max: 100;
    in property <float> size_step: 1;
    in property <string> size_text;
    in property <bool> size_enabled: false;
    callback size_changed(float);

    // --- Color -------------------------------------------------------------------------------------
    // What the selected zone's color is: 0 one picked color, 1 Along and Across, 2 Alpha, Beta
    // and Gamma, 3 a color variant of the stone's material.
    in property <int> color_kind: 0;
    // The color forms the picker offers for a picked color, by the rank of the material: One Color
    // on a cubic or amorphous one, Along and Across on a uniaxial one, Alpha, Beta and Gamma on a
    // biaxial one. A zone whose color has another form (a one-color zone on a pleochroic material:
    // "Legacy: No Pleochroism") lists it as well; `color_form_index` is the one it has.
    in property <[string]> color_form_options;
    in-out property <int> color_form_index: 0;
    // One sentence under the form menu: what the material's rank means, or why the zone is legacy.
    in property <string> color_form_hint;
    callback color_form_changed(int);
    // Where the color comes from: "Custom" (picked) or "Variant". The Source menu is offered only
    // when the stone's material has variants (`variants_available`).
    in property <[string]> color_source_options: ["Custom", "Variant"];
    in-out property <int> color_source_index: 0;
    in property <bool> variants_available: false;
    // 0 Custom, 1 Variant.
    callback color_source_changed(int);
    // The variants of the stone's material that fit it (Material Default first), and the one the
    // selected zone has (-1: none).
    in property <[string]> variant_labels;
    in-out property <int> variant_index: -1;
    in property <string> variant_hint;
    // The index into `variant_labels` of the variant to copy into the zone.
    callback variant_picked(int);
    // The zone's color as the chips show it: the overall color, and the Along (Alpha), Beta and
    // Across (Gamma) colors of a pleochroic zone or variant.
    in property <color> single_swatch: #888888;
    in property <color> along_swatch: #888888;
    in property <color> beta_swatch: #888888;
    in property <color> across_swatch: #888888;
    // 0 the one color, then in slot order: 1 Along or Alpha, 2 Across or Beta, 3 Gamma. Rust opens
    // the body-color editor in the main window.
    callback pick_color(int);
    // A stone's color picker lives in this window, independent of the material dialog.
    in property <bool> picker_open: false;
    in-out property <float> picker_tone: 55;
    in-out property <float> picker_chroma: 40;
    in-out property <float> picker_hue: 260;
    in property <color> picker_swatch;
    callback picker_changed(int, float);
    callback picker_applied();
    callback picker_cancelled();
    callback picker_srgb(color);

    // --- Pattern ---------------------------------------------------------------------------------------
    // "Table Normal", "Across", "Across Turned", "Custom".
    in property <[string]> axis_options;
    in-out property <int> axis_index: 0;
    // Tilt and turn in degrees (Advanced); editable when the axis is Custom (index 3).
    in-out property <float> tilt_deg: 0;
    in-out property <float> turn_deg: 0;
    // true: "Scales With Stone Size"; false: "Fixed in mm".
    in property <bool> scales_with_stone: true;
    // Boundary softness: 0 Sharp to 1 Soft.
    in-out property <float> softness: 0;
    callback axis_changed(int);
    callback tilt_turn_changed(float, float);
    callback scale_mode_changed(bool);
    callback softness_changed(float);

    // --- Validation and history ----------------------------------------------------------------------------
    // One validation sentence under the property panel; empty when the pattern is valid.
    in property <string> message;
    in property <bool> can_undo: false;
    in property <bool> can_redo: false;
    callback undo();
    callback redo();
    // Close without keeping the edits (Rust asks first when `dirty`).
    callback cancel();
    // Cancel was pressed with unsaved edits: the window asks "Discard the changes to this
    // pattern?" in a bar above the buttons.
    in property <bool> confirm_discard: false;
    callback discard_confirmed();
    callback discard_declined();
    // Store the pattern with the material and keep the window open.
    callback apply();
    // Store the pattern with the material and close the window.
    callback save();
}
