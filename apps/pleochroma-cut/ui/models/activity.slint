// The running background activities that the status strip and command bar show.
// `gui::editor::activity::ActivityRegistry` is the only writer of `activities` and
// `now_ms` (`in-out` only so `ActivityRegistry::sync_model` can set them). It pushes one
// `ActivityItem` per running action (auto-solve, Deep Solve, Optimize, Baseline compare,
// tilt and video export, trace generation).
import { Theme } from "../theme.slint";

// One running, or just-finished (until the next sync removes it), background operation.
// `progress` is -1.0 when no fraction is known, otherwise in [0.0, 1.0]. `started_ms` is
// milliseconds on the registry's monotonic session clock, not Unix time. With
// `ActivityModel.now_ms` it gives the elapsed time: `(now_ms - started_ms) / 1000`.
export struct ActivityItem {
    id: int,
    kind: string,
    label: string,
    progress: float,
    cancellable: bool,
    started_ms: int,
}

export global ActivityModel {
    in-out property <[ActivityItem]> activities: [];
    // Ticked about once a second while `activities` is non-empty. See `ActivityItem.started_ms`.
    in-out property <int> now_ms: 0;
    // True while at least one activity runs.
    out property <bool> busy: activities.length > 0;
    // Cancels the activity with this `id`. Ignored for an unknown id or one started with
    // `cancellable: false`.
    callback cancel(int);

    // Lets code outside `gui::editor` (the tilt sweep and video export, `bridge::render_thread`)
    // drive the same registry, since the registry's modules are private to `gui::editor`.
    // Callers use `invoke_start_external` and the like, never `on_*`.
    // `external_cancel` goes the other way: the registry invokes it when a cancel lands on an
    // id that has no local cancel closure. Only the tilt video export handles it, through its
    // own cancel flag. A second externally cancellable kind must filter by `kind` or `id`.
    callback start_external(string, string, bool) -> int;
    callback progress_external(int, float);
    callback finish_external(int);
    callback external_cancel(int);
}
