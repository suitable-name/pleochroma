import { WorkerItem } from "../types.slint";

// What the app knows about the remote -- the Slint face of `settings::model::RemoteAvailability`,
// the one replacement of the former live / export / tilt-video flags. Each surface reads the
// half it needs: pickers that only need a target to exist (live compute, the tilt-video
// pills) read `configured`; the still export, which probes before it starts, reads
// `reachable_render_capable` (always `false` while nothing is configured).
export struct RemoteAvailabilityItem {
    configured: bool,
    reachable_render_capable: bool,
}

// The one remote endpoint (a coordinator, rendering itself when started with
// `--render`) -- `RemoteWorkerDialog`'s "Remote coordinator" form, plus the "served by"
// indicator, the library switch and the pull-mirror state.
export global RemoteWorkerModel {
    // Whether a remote is configured; `endpoint` holds its settings (defaults when not).
    in property <bool> configured: false;
    in property <WorkerItem> endpoint;
    // The one remote-availability value (see `RemoteAvailabilityItem`). Rust publishes it
    // when the endpoint changes and when the export dialog's probe reports back.
    in property <RemoteAvailabilityItem> availability: { configured: false, reachable_render_capable: false };
    // Why the remote choices of a surface that does not probe are greyed out (empty while
    // a remote is configured): the text of `RemoteAvailability::disabled_reason`.
    in property <string> availability_reason: "";
    // Opens the Remote Coordinator dialog (the header's "Remote" popup). The popup belongs to
    // the header, which watches `open_requests` and shows it; any surface calls `open_dialog()`
    // (the Render & Output tab's read-only live transfer links here).
    in-out property <int> open_requests: 0;
    public function open_dialog() {
        open_requests += 1;
    }
    in-out property <bool> denoise_enabled: true;
    // How many pictures a catalogue preview or tilt batch keeps in flight on the remote
    // at once (`AppSettings::remote_batch_lanes`, 1..=32). The dialog's spin box edits it
    // in place; `remote_batch_lanes_changed` hands the new count to Rust to limit and
    // persist.
    in-out property <int> remote_batch_lanes: 4;
    // How many pictures one batched preview request to the remote carries
    // (`AppSettings::remote_preview_batch_size`, 1..=32); `remote_preview_batch_size_changed`
    // hands the new count to Rust to limit and persist.
    in-out property <int> remote_preview_batch_size: 10;
    in property <bool> testing_connection: false;
    in property <string> test_connection_result: "";
    in property <bool> test_connection_is_error: false;
    in property <bool> served_by_remote: false;
    in property <string> served_by_worker_name: "";

    // Which library is browsed: -1 = the local one, 0 = the remote endpoint's.
    in property <int> library_source_worker_index: -1;
    in property <string> library_source_label: "Local library";
    in property <bool> library_is_remote: false;

    in property <bool> mirror_in_progress: false;
    in property <float> mirror_progress_fraction: 0.0;
    in property <string> mirror_status_text: "";
    in property <bool> mirror_has_error: false;

    in property <bool> claiming_token: false;
    in property <string> claim_result_text: "";
    in property <bool> claim_result_is_error: false;
    in property <string> claimed_cert_dir: "";
    // Suggested render address after a successful claim: the enrollment host on the
    // server's default serve port (the dialog fills an empty Address field with it).
    in property <string> claimed_address: "";
    // The folder `pick_cert_dir` picked, set when its off-UI-thread dialog completes. A
    // `RemoteWorkerDialog` handler copies a non-empty value into `form_cert_dir` on change
    // (a one-shot value, as with `claimed_cert_dir`).
    in property <string> picked_cert_dir: "";

    // Whether a setting that Simple mode hides is off its default: live-stream mode index,
    // cadence in ms, preview-scale index and percent, export-transfer index and batch lanes,
    // in that order (`gui::remote::advanced_in_use`, which holds the rule and its tests).
    pure callback advanced_in_use(int, int, int, int, int, int) -> bool;

    // The saved remote was paired through a pairing link (verified by its fixed certificate
    // name), and the one-line summary of its saved addresses: "192.168.1.20:7878 (+1 more)".
    in property <bool> endpoint_paired: false;
    in property <string> endpoint_address_summary: "";
    // What the last search for a moved coordinator found: "Studio PC moved to 192.168.1.40".
    in property <string> rediscovery_status: "";

    // Pairing with a pasted link. 0 = nothing pending (the paste field shows), 1 = the link was
    // read and waits for the user to confirm, 2 = pairing is running on a background thread.
    in property <int> pair_stage: 0;
    // The computer the pending link names, how to reach it, and the name of the coordinator
    // this pairing would replace ("" when none is saved).
    in property <string> pair_name: "";
    in property <string> pair_address_summary: "";
    in property <string> pair_replaces: "";
    // Plain-word reason the last link or pairing failed ("" when none).
    in property <string> pair_error: "";
    // Set by the dialog when it closes and cleared when it opens again. A pairing that fails
    // after the dialog closed drops its offer (and the code in it) instead of keeping it.
    in-out property <bool> pair_dialog_closed: false;
    // The pasted text goes to Rust at once and the field is cleared; Rust keeps only the parsed
    // offer until it is confirmed or cancelled.
    callback read_pairing_link(string);
    callback confirm_pairing();
    callback cancel_pairing();

    // After a pairing succeeded while the render settings keep the new computer out ("Live
    // Render" and/or the export Compute pills on "This computer only"), Rust raises this and the
    // window asks "Render on <name>?". `use_remote_final_too` says final pictures (still and
    // tilt-video exports) are excluded as well, so the question names them. The answer comes back
    // through `use_remote_answered`; Rust closes the question.
    in property <bool> use_remote_prompt_open: false;
    in property <string> use_remote_name: "";
    in property <bool> use_remote_final_too: false;
    callback use_remote_answered(bool);

    callback pick_cert_dir(string);
    callback denoise_toggled(bool);
    callback remote_batch_lanes_changed(int);
    callback remote_preview_batch_size_changed(int);
    // Address and certificate folder of the (possibly unsaved) form.
    callback test_worker_connection(string, string);
    callback save_remote(WorkerItem);
    callback remove_remote();
    // Name, enrollment address, token.
    callback claim_token(string, string, string);
    // -1 = local library, 0 = the remote endpoint's.
    callback switch_library_source(int);
    callback start_mirror_sync();
    callback cancel_mirror_sync();
}
