import { ViewportModel } from "viewport.slint";

export global TiltModel {
    in-out property <bool> dialog_open: false;

    in property <[float]> graph_brilliance: [20.0, 25.0, 32.0, 42.0, 50.0, 58.0, 65.0, 72.0, 78.0, 82.0, 84.0, 85.0, 84.0, 82.0, 80.0, 76.0, 70.0, 62.0, 50.0];
    in property <[float]> graph_extinction: [65.0, 58.0, 50.0, 40.0, 32.0, 25.0, 18.0, 14.0, 10.0, 8.0, 6.0, 5.0, 6.0, 7.0, 9.0, 12.0, 18.0, 26.0, 38.0];
    in property <[float]> graph_windowing: [40.0, 35.0, 28.0, 20.0, 15.0, 10.0, 8.0, 6.0, 5.0, 4.0, 4.0, 5.0, 6.0, 8.0, 10.0, 14.0, 18.0, 24.0, 30.0];

    in property <string> graph_brilliance_path: "";
    in property <string> graph_extinction_path: "";
    in property <string> graph_windowing_path: "";

    in property <[[float]]> graph_brilliance_extra_axes: [];
    in property <[[float]]> graph_extinction_extra_axes: [];
    in property <[[float]]> graph_windowing_extra_axes: [];
    in property <[string]> graph_brilliance_extra_paths: [];
    in property <[string]> graph_extinction_extra_paths: [];
    in property <[string]> graph_windowing_extra_paths: [];
    in property <bool> extra_axes_loading: false;
    in property <float> cam_pitch_deg: 45.0;

    in property <string> cached_curve_material: "";
    pure callback is_cached_curve_material_stale(string, string) -> bool;
    callback rerender_curve_with_current_material();

    // True when the geometry, material or light the curves were swept against no longer matches
    // the loaded ones (`gui::tilt::tilt_profile`'s `AxesCacheKey` comparison). Unlike
    // `cached_curve_material`, which only compares the material of a cached preview image.
    // `performance_graph_dialog.slint` shows it as a `StaleBadge` with "Recompute".
    in property <bool> curves_stale: false;

    in property <image> hover_preview_image;
    in property <bool> hover_ready: false;
    in property <string> hover_status: "";
    in-out property <bool> hover_diagnostics: false;
    in-out property <bool> hover_inspect: false;
    in-out property <int> hover_axis: 0;
    in-out property <float> hover_tilt: 0;
    callback cancel_hover();
    // Closing the dialog keeps the video section's values for the next start of the app
    // (`gui::tilt::video_export`, `output_defaults::remember_tilt`).
    callback dialog_closed();
    changed dialog_open => {
        if !dialog_open {
            cancel_hover();
            dialog_closed();
        }
    }

    callback request_tilt_hover_preview(int, float);

    callback request_tilt_profile_axes();
    callback copy_curve_data();

    // The Tilt Curve button's open/close sequence with its stale-cache check, shared by the Gem
    // viewport (`gem_viewport.slint`) and the Solid viewport (`solid_viewport.slint`). A `function`
    // rather than a `callback`: its body lives here and no Rust handler is needed.
    public function toggle_dialog() {
        dialog_open = !dialog_open;
        if dialog_open {
            if cached_curve_material != "" && is_cached_curve_material_stale(cached_curve_material, ViewportModel.material_options[ViewportModel.selected_material_index]) {
                rerender_curve_with_current_material();
            } else {
                request_tilt_profile_axes();
            }
        }
    }
}

// One axis's Start and End pictures in the video section: the solid stone at the Start
// and End angle, posed and framed like the video's frames (`gui::tilt::video_export::
// pose_preview`). `axis_index` indexes the dialog's axis labels.
export struct TiltPosePreview {
    axis_index: int,
    start: image,
    end: image,
}

// Settings and progress for a tilt-performance video (one rendered frame per swept angle,
// muxed into a video): the collapsible "Export tilt video" section of
// `performance_graph_dialog.slint`. The `in-out` properties persist across dialog re-opens in
// the session, like `ExportModel`'s quality settings. The section's expanded state and the
// large-run confirmation live on the dialog (`PerformanceGraphDialog.video_export_expanded`,
// `confirmed_large_run`) and reset each time it opens.
export global TiltVideoExportModel {
    // Renderer: 0 Path-Traced, 1 Ray-Traced. AA applies only to Ray-Traced.
    in-out property <int> engine_index: 0;
    in-out property <int> ray_taps: 16;
    in-out property <bool> ray_fire: true;
    // Sweep: start and end in whole degrees (`SpinBox`, bound directly as `int`). The step is a
    // fractional degree value from a `LineEdit`, clamped in Rust to
    // `gui::tilt::video_export::params::{MIN_STEP_DEG, MAX_STEP_DEG}` (0.01..=5.0).
    in-out property <int> start_angle_deg: -90;
    in-out property <int> end_angle_deg: 90;
    in-out property <float> step_deg: 1.0;
    // Parses and clamps the step text. Slint has no string-to-float parse, so Rust does it
    // (`params::clamp_step_deg`). A value that does not parse gives `1.0`, as a non-finite one
    // does.
    pure callback parse_step_deg(string) -> float;
    // The axes the video shows, in click order, which is the order it shows them: indices of the
    // chart's axes (0: 0°, 1: 45°, 2: 90°, 3: 135°), each at most once. Empty means the chart's
    // selected axis alone. One axis is one Start -> End pass; several rock through face-up in
    // turn, 0 -> End -> Start -> 0 each, with no cut (`params::frame_poses`). Rust writes it.
    in-out property <[int]> video_axes: [];
    // Clicks an axis chip: adds it last, or removes it and moves the later ones up.
    callback toggle_video_axis(int);
    // "Turn Stone 90°": turns every frame and the Start and End pictures a quarter turn, so a long
    // stone lies upright instead of across the picture.
    in-out property <bool> quarter_turn: false;
    // The Start and End pictures of every axis, drawn by Rust after
    // `request_pose_previews(chart_axis)`.
    in property <[TiltPosePreview]> pose_previews: [];
    callback request_pose_previews(int);
    in-out property <int> fps_index: 1; // 0: 24fps, 1: 30fps, 2: 60fps

    // Resolution: an index into `params::RESOLUTION_PRESETS` (7 square, then 5 16:9 presets from
    // 720p to 8K; 8 is 1080p), or `CUSTOM_RESOLUTION_INDEX` for `custom_width`/`custom_height`,
    // each clamped to 128..=8192 in Rust.
    in-out property <int> resolution_preset: 8; // 1080p
    in-out property <int> custom_width: 512;
    in-out property <int> custom_height: 512;
    // The index that means "Custom" (`params::CUSTOM_RESOLUTION_INDEX`), so the combo never keeps
    // a second copy of the preset table's length.
    pure callback custom_resolution_index() -> int;

    // Quality: the same controls as `export_dialog.slint` (samples, bounce ladder, color space),
    // kept as this dialog's own state so tuning a video never changes the still-image settings.
    in-out property <float> sample_exponent_raw: 6.0; // 64 spp per frame, times the frame count
    in-out property <int> selected_color_space_index: 0; // 0: sRGB, 1: Display P3, 2: Rec.2020
    // An index into `SettingsModel.bounce_ladder` (the one ladder Rust publishes). Rust seeds
    // it from the last-used value (`AppSettings::output.tilt_video`) at start-up and writes it
    // back when a video starts.
    in-out property <int> selected_bounce_index: 2;
    // "Transfer": 0 = Full data, 1 = Final picture only (one PNG per frame from the remote; local
    // lanes stay idle). Seeded from the last-used choice, or the remote's default before one was
    // made. Shown only while a remote is configured (`RemoteWorkerModel.availability.configured`).
    in-out property <int> transfer_index: 0;
    // "Compute": 0 = Local only, 1 = Remote only, 2 = Local + Remote (the still-image export's
    // own pill order). Only offered while a remote is configured; without one the video renders
    // locally whatever this holds. Remote only traces nothing on this computer.
    in-out property <int> compute_target_index: 2;
    // Fired after the pill sets `compute_target_index`, so Rust saves the choice in the settings.
    callback compute_target_picked(int);

    // Output: the still-image export's folder (`ExportModel.directory`) with its own filename
    // template. A video names a folder (the numbered PNG frames and the video), so the template
    // adds `{axis}`, `{fps}`, `{step}`, `{start}`, `{end}` and `{frames}` to the image variables.
    in-out property <string> filename_template: "tilt_video_{design}_{material}_axis{axis}_{width}x{height}_{timestamp}";
    // Folder name for the template (first argument). The second is the dialog's
    // `selected_axis_index` (kept in Slint, see `performance_graph_dialog.slint`), the third
    // `video_axes`; the preview matches what Start Video Export would run.
    pure callback preview_video_folder_name(string, int, [int]) -> string;

    // Overlay: which swept metrics are drawn into each frame. Brilliance, windowing and extinction
    // are the curve's own channels. Tilt brilliance is the axis's mean over the sweep, a different
    // number from Optimize's `tilt_brilliance_pct` (`gui::tilt::video_export::metrics`). The
    // current tilt angle is also available.
    in-out property <bool> show_values: false;
    in-out property <bool> metric_brilliance: true;
    in-out property <bool> metric_windowing: true;
    in-out property <bool> metric_extinction: true;
    in-out property <bool> metric_tilt_brilliance: false;
    in-out property <bool> metric_angle: true;

    // Encoding: PNG frames are always written, then muxed into an MP4 (ffmpeg on PATH) or a GIF
    // (fallback). With `keep_frames` off (the default) the PNGs are deleted after a successful run.
    in-out property <bool> keep_frames: false;

    // "Adaptive Sampling" and "Target Noise" for every frame, as in `ExportModel` (the same
    // index into `pleochroma::renderer::adaptive::TARGET_NOISE_PRESETS`). Each frame stops
    // its tiles by itself; the samples setting is the most any part gets.
    in-out property <bool> adaptive_sampling: false;
    in-out property <int> target_noise_index: 1;

    // "Path Cache" for every frame, as in `ExportModel`; "Keep Path Cache for This Video" also
    // writes each frame's cache to disk (a video's frame caches are not kept unless asked: the
    // job's `keep_path_cache`). It stands in for the still export's "Keep for Re-Renders".
    in-out property <bool> path_cache: false;
    in-out property <bool> keep_video_cache: false;
    // Whether the path cache and beam tracing can be used at all, as in `ExportModel`: Rust sets
    // both at start-up, `false` under exit collection.
    in property <bool> path_cache_available: true;
    in property <bool> beam_available: true;

    // "Beam Tracing (Faceted Stones)" for every frame, as in `ExportModel`. Every frame is a new
    // pose, so each builds its own beams.
    in-out property <bool> beam: false;

    // Frame count estimate: a pure callback into `params::frame_count`, not reimplemented in
    // Slint, so the number shown never disagrees with the frames rendered. The fourth argument
    // is `video_axes`.
    pure callback frame_count(float, float, float, [int]) -> int;
    // How many of those frames are rendered: a rocking video shows every angle again on its
    // way back, and those frames are copies (`params::rendered_pose_count`).
    pure callback rendered_frame_count(float, float, float, [int]) -> int;
    // Rough per-frame render time in seconds. 0.0 means no estimate yet (no frame has landed in
    // this session or a prior one), not instant.
    in property <float> last_frame_seconds: 0.0;

    // Progress, mirroring `ExportModel`'s own shape.
    in property <bool> is_exporting: false;
    in property <float> progress: 0.0; // 0.0..=1.0
    in property <int> current_frame: 0;
    in property <int> total_frames: 0;
    // A short "about N s/min/h left" reading alongside `progress`'s percentage --
    // `""` while there isn't yet enough history for an estimate (see
    // `gui::progress_eta::EtaEstimator`), never a raw seconds count.
    in property <string> eta_text: "";
    in property <string> status_message: "";
    in property <bool> has_error: false;

    // Starts the export for `axis_index` (the dialog's `selected_axis_index`, passed in rather
    // than mirrored here; see `performance_graph_dialog.slint`). Other settings are read from
    // this global's properties.
    callback start_video_export(int);
    callback cancel_video_export();
}
