# /etc/conf.d/pleochroma-worker
#
# PLACEHOLDERS to change:
#   coordinator.example:7880   the coordinator's WORKER port (host:port, default port 7880).
#   --cert-dir                 the worker certificate folder (ca.pem, client.pem, client.key).
# Optional flags: --slots <k> (default 2), --threads <n>, --only-gpu, --only-cpu.
#
# join dials out, so this computer needs no open inbound port.
worker_args="coordinator.example:7880 --cert-dir /var/lib/pleochroma/worker-cert"

# The cache folders of the GPU driver and the shader compiler live under the cache
# folder; the service user's home is /var/lib/pleochroma.
export XDG_CACHE_HOME="/var/lib/pleochroma/.cache"

# Log level (the default is info).
#export RUST_LOG="info"

# Skip the one request at start that asks GitHub for a newer release (offline server).
#export PLEOCHROMA_NO_UPDATE_CHECK=1

# AMD GPU with Mesa's RADV driver: the worker turns its scheduler workaround on by itself
# when it finds an AMD GPU on the amdgpu driver. Set this only to force it on or off.
#export PLEOCHROMA_RADV_WORKAROUND="on"

# Where the HDR map cache lives and how large it may grow (defaults: "asset-cache" next
# to --cert-dir, 2048 MiB).
#export PLEOCHROMA_ASSET_CACHE_DIR="/var/lib/pleochroma/asset-cache"
#export PLEOCHROMA_ASSET_CACHE_MIB=2048

# GPU rendering: the service user must be in the groups that own /dev/dri
# (usermod -aG video,render pleochroma). Group changes need a service restart.
