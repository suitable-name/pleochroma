// The Overview page of the coordinator window: whether the coordinator runs and how to reach
// it, three summary cards (devices, render computers, jobs), the renders running now, the
// recent activity and the warnings.
//
// Page contract: one `OverviewPage` with no required properties and one `OverviewState`
// global. `src/gui/pages/overview.rs` fills the state from the coordinator status and the
// event stream once a second. "Connect a phone" and "Connect a computer" open the pairing
// dialog through `PairState.open-requested`. Built from the desktop kit through `frame.slint`.
import { ScrollView } from "std-widgets.slint";
import { Theme, ShellState, KitIcon, KitIcons, KitButton, KitCard, CIcons, H1, H2, Sub, Muted } from "../frame.slint";
import { PairState } from "../pair_dialog.slint";
import { ShaderCacheCard, ShaderCardState } from "../shader_card.slint";

/// One render running now: an interactive render of a device or a running job. The Rust side
/// formats every text.
export struct OvLiveRow {
    /// Who asked: the device name.
    owner: string,
    /// What it is: "Live view · Path-Traced", or the job's label such as "Final render".
    label: string,
    /// "3840 × 2160".
    size: string,
    /// 0.0 to 1.0; unused while `determinate` is false.
    progress: float,
    /// "62 %"; empty when there is no target to measure against.
    percent: string,
    /// Which computers render it ("this computer + garage-rig"); empty while unknown.
    route: string,
    /// "128 of 512 samples", "Live · 1,234 samples" or "Preparing graphics card… 12 of 40";
    /// empty for a job. A non-empty text marks the row as an interactive render.
    samples: string,
    /// "4.2 M samples/s"; empty while unknown.
    rate: string,
    /// "2 min"; empty for a job.
    elapsed: string,
    /// False for an open-ended live view: the bar pulses instead of filling.
    determinate: bool,
    /// True while the graphics card builds its shaders; the bar turns amber.
    preparing: bool,
}

/// One line of the activity feed.
export struct OvActivityRow {
    /// "just now", "5 min ago".
    when: string,
    /// The event in plain words.
    text: string,
    /// 0 routine, 1 good, 2 notice, 3 problem.
    tone: int,
}

export global OverviewState {
    /// True once the Rust side has filled the page.
    in property <bool> loaded: false;
    /// The hero line, such as "Running · phones on your network can connect".
    in property <string> hero-title: "Starting…";
    /// 0 fine (green), 1 attention (amber), 2 problem (red), 3 off (muted).
    in property <int> hero-level: 1;
    /// "Ports 7878 · 7879 · 7880 · 7881", or empty.
    in property <string> hero-sub;
    /// The address other devices use, or empty.
    in property <string> address;
    /// "3 h 12 min", or empty when the coordinator does not run.
    in property <string> uptime;

    /// "2 of 3" and the names under it.
    in property <string> devices-value: "0 of 0";
    in property <string> devices-sub;
    /// "1 + this computer" and the line under it.
    in property <string> computers-value: "None";
    in property <string> computers-sub;
    /// "1 running" and "2 queued".
    in property <string> jobs-value: "0 running";
    in property <string> jobs-sub;

    /// Renders running now.
    in-out property <[OvLiveRow]> live;
    /// "2 active" or "nothing active".
    in property <string> live-note: "nothing active";
    /// The newest event first.
    in-out property <[OvActivityRow]> activity;
    /// Problems and warnings, one card each.
    in-out property <[string]> warnings;

    /// What the signed-in role may do; the Connect buttons grey out when false.
    in property <bool> can-pair: false;
}

// A thin progress bar. With `determinate: false` a short segment sweeps along it instead.
component Bar inherits Rectangle {
    in property <float> value: 0;
    in property <bool> determinate: true;
    in property <color> ink: Theme.accent-cyan;
    height: 6px;
    border-radius: 3px;
    background: Theme.bg-input;
    clip: true;
    accessible-role: AccessibleRole.progress-indicator;
    accessible-label: "Progress";
    accessible-value: root.determinate ? "" + Math.round(max(0.0, min(1.0, root.value)) * 100) + " percent" : "in progress";
    if root.determinate: Rectangle {
        x: 0px;
        width: parent.width * max(0, min(1, root.value));
        height: parent.height;
        border-radius: 3px;
        background: root.ink;
    }
    if !root.determinate: Rectangle {
        // The segment is 30 % of the bar and travels from off the left edge to off the right.
        width: parent.width * 0.3;
        x: (Math.mod(animation-tick() / 1600ms, 1.0) * 1.3 - 0.3) * parent.width;
        height: parent.height;
        border-radius: 3px;
        background: root.ink;
    }
}

// A card heading: small capitals on the left, a note on the right.
component CardHead inherits HorizontalLayout {
    in property <string> label;
    in property <string> note;
    height: 38px;
    padding-left: 16px;
    padding-right: 16px;
    Text {
        text: root.label;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.8px;
        color: Theme.text-muted;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    Text {
        text: root.note;
        font-size: 11px;
        color: Theme.text-muted;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
}

// One of the three summary cards.
component CountCard inherits KitCard {
    in property <string> icon;
    in property <string> label;
    in property <string> value;
    in property <string> sub;
    height: 80px;
    horizontal-stretch: 1;
    accessible-role: AccessibleRole.text;
    accessible-label: root.label + ": " + root.value + ". " + root.sub;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 42px;
                height: 42px;
                border-radius: 10px;
                background: Theme.accent-cyan-surface;
                KitIcon { x: 12px; y: 12px; d: root.icon; size: 18px; ink: Theme.accent-cyan; }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Sub { text: root.label; height: 16px; overflow: elide; }
            H1 { text: root.value; height: 28px; overflow: elide; }
            Muted { text: root.sub; height: 14px; overflow: elide; }
        }
    }
}

// One row of "Rendering now", in three lines: who asked, what and how big; the bar with its
// progress text; where it is traced, how fast and for how long. The Rust side formats every
// text. Narrow windows drop the size.
component LiveRow inherits Rectangle {
    in property <OvLiveRow> data;
    in property <bool> first: false;
    in property <bool> show-size: true;
    height: 66px;
    accessible-role: AccessibleRole.list-item;
    accessible-label: root.data.samples != ""
        ? "Rendering for " + root.data.owner + ": " + root.data.label + ", " + root.data.samples + (root.data.route != "" ? ", on " + root.data.route : "")
        : root.data.owner + ", " + root.data.label + ", " + root.data.size + ", " + root.data.percent + (root.data.route != "" ? ", on " + root.data.route : "");
    if !root.first: Rectangle { y: 0px; height: 1px; x: 16px; width: parent.width - 32px; background: Theme.border-subtle; }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            KitIcon { d: CIcons.phone; size: 18px; ink: Theme.accent-cyan; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: center;
            spacing: 4px;
            // Who asked, what it is, how big.
            HorizontalLayout {
                height: 18px;
                spacing: 10px;
                Text {
                    horizontal-stretch: 0;
                    min-width: 0px;
                    max-width: 220px;
                    text: root.data.owner;
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Sub { horizontal-stretch: 1; min-width: 0px; text: root.data.label; overflow: elide; }
                if root.show-size && root.data.size != "": Sub { horizontal-stretch: 0; text: root.data.size; horizontal-alignment: right; }
            }
            // The bar and what it counts.
            HorizontalLayout {
                height: 16px;
                spacing: 10px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 40px;
                    alignment: center;
                    Bar {
                        value: root.data.progress;
                        determinate: root.data.determinate;
                        ink: root.data.preparing ? Theme.accent-amber : Theme.accent-cyan;
                    }
                }
                if root.data.samples != "": Text {
                    horizontal-stretch: 0;
                    width: 232px;
                    text: root.data.samples;
                    font-size: 12px;
                    color: Theme.text-secondary;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    width: 40px;
                    text: root.data.percent;
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text-primary;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            // Where it is traced, how fast, for how long.
            HorizontalLayout {
                height: 14px;
                spacing: 14px;
                Muted { horizontal-stretch: 1; min-width: 0px; text: root.data.route; overflow: elide; }
                if root.data.rate != "": Muted { horizontal-stretch: 0; text: root.data.rate; }
                if root.data.elapsed != "": Muted { horizontal-stretch: 0; text: root.data.elapsed; }
            }
        }
    }
}
// One line of the activity feed.
component EventRow inherits Rectangle {
    in property <OvActivityRow> data;
    height: 26px;
    accessible-role: AccessibleRole.list-item;
    accessible-label: root.data.when + ": " + root.data.text;
    property <color> dot: root.data.tone == 1 ? Theme.success : (root.data.tone == 2 ? Theme.accent-amber : (root.data.tone == 3 ? Theme.danger : Theme.text-muted));
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        Text { width: 76px; text: root.data.when; font-size: 12px; color: Theme.text-muted; vertical-alignment: center; overflow: elide; }
        VerticalLayout {
            alignment: center;
            Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: root.dot; }
        }
        Text { text: root.data.text; font-size: 13px; color: Theme.text-primary; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
    }
}

export component OverviewPage inherits Rectangle {
    property <bool> wide: root.width >= 760px;
    property <int> live-count: OverviewState.live.length;
    property <int> activity-count: OverviewState.activity.length;
    property <color> hero-ink: OverviewState.hero-level == 0 ? Theme.success : (OverviewState.hero-level == 1 ? Theme.accent-amber : (OverviewState.hero-level == 2 ? Theme.danger : Theme.text-muted));

    background: transparent;

    ScrollView {
        width: root.width;
        height: root.height;
        content-width: root.width;
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: start;

            // Problems and warnings.
            for warning in OverviewState.warnings: Rectangle {
                height: warn-row.preferred-height;
                border-radius: 10px;
                background: Theme.surface-warning;
                border-width: 1px;
                border-color: Theme.accent-amber.with-alpha(0.5);
                accessible-role: AccessibleRole.text;
                accessible-label: "Warning: " + warning;
                warn-row := HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        KitIcon { d: KitIcons.warn; size: 18px; ink: Theme.accent-amber; }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: warning;
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.notice-text;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
            }

            // The shader cache, while the graphics card builds it (and a moment after).
            if ShaderCardState.visible && !ShaderCardState.dismissed: ShaderCacheCard { }

            // Status hero.
            KitCard {
                height: 88px;
                accessible-role: AccessibleRole.text;
                accessible-label: OverviewState.hero-title + ". " + OverviewState.hero-sub + ". Address " + OverviewState.address + ". Uptime " + OverviewState.uptime;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 24px;
                    spacing: 16px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 48px;
                            height: 48px;
                            border-radius: 24px;
                            background: root.hero-ink.with-alpha(0.14);
                            border-width: 1px;
                            border-color: root.hero-ink.with-alpha(0.45);
                            KitIcon { x: 12px; y: 12px; d: CIcons.wifi; size: 24px; ink: root.hero-ink; }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        min-width: 60px;
                        alignment: center;
                        spacing: 4px;
                        H2 { text: OverviewState.hero-title; height: 22px; overflow: elide; }
                        Muted { text: OverviewState.hero-sub; height: 14px; overflow: elide; }
                    }
                    if OverviewState.address != "": Rectangle { width: 1px; background: Theme.border-subtle; }
                    if OverviewState.address != "": VerticalLayout {
                        width: 140px;
                        alignment: center;
                        spacing: 3px;
                        Text { text: "ADDRESS"; font-size: 10px; font-weight: 700; letter-spacing: 0.8px; color: Theme.text-muted; }
                        Text { text: OverviewState.address; font-size: 15px; font-weight: 650; color: Theme.text-primary; overflow: elide; }
                    }
                    if OverviewState.uptime != "" && root.width >= 700px: Rectangle { width: 1px; background: Theme.border-subtle; }
                    if OverviewState.uptime != "" && root.width >= 700px: VerticalLayout {
                        width: 96px;
                        alignment: center;
                        spacing: 3px;
                        Text { text: "UPTIME"; font-size: 10px; font-weight: 700; letter-spacing: 0.8px; color: Theme.text-muted; }
                        Text { text: OverviewState.uptime; font-size: 15px; font-weight: 650; color: Theme.text-primary; overflow: elide; }
                    }
                }
            }

            // The two ways to add a device.
            HorizontalLayout {
                height: 34px;
                spacing: 8px;
                alignment: end;
                KitButton {
                    icon: CIcons.monitor;
                    text: "Connect a computer";
                    h: 34px;
                    // The outline look keeps its border when disabled, so fade the whole button
                    // until the signed-in access level allows pairing.
                    opacity: OverviewState.can-pair ? 1.0 : 0.45;
                    enabled: OverviewState.can-pair;
                    hint: OverviewState.can-pair ? "" : ShellState.denied-reason;
                    clicked => {
                        PairState.open-requested(1);
                    }
                }
                KitButton {
                    kind: 1;
                    icon: CIcons.qr;
                    text: "Connect a phone";
                    h: 34px;
                    enabled: OverviewState.can-pair;
                    hint: OverviewState.can-pair ? "" : ShellState.denied-reason;
                    clicked => {
                        PairState.open-requested(0);
                    }
                }
            }

            // Counts: side by side when the window is wide, stacked when it is narrow.
            if root.wide: HorizontalLayout {
                spacing: 16px;
                CountCard { icon: CIcons.phone; label: "Devices online"; value: OverviewState.devices-value; sub: OverviewState.devices-sub; }
                CountCard { icon: CIcons.server; label: "Render computers"; value: OverviewState.computers-value; sub: OverviewState.computers-sub; }
                CountCard { icon: CIcons.jobs; label: "Jobs"; value: OverviewState.jobs-value; sub: OverviewState.jobs-sub; }
            }
            if !root.wide: VerticalLayout {
                spacing: 12px;
                CountCard { icon: CIcons.phone; label: "Devices online"; value: OverviewState.devices-value; sub: OverviewState.devices-sub; }
                CountCard { icon: CIcons.server; label: "Render computers"; value: OverviewState.computers-value; sub: OverviewState.computers-sub; }
                CountCard { icon: CIcons.jobs; label: "Jobs"; value: OverviewState.jobs-value; sub: OverviewState.jobs-sub; }
            }

            // Rendering now.
            KitCard {
                height: root.live-count == 0 ? 136px : 38px + root.live-count * 66px + 6px;
                VerticalLayout {
                    padding-bottom: 6px;
                    CardHead { label: "RENDERING NOW"; note: OverviewState.live-note; }
                    if root.live-count == 0: Rectangle {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { text: "Nothing is rendering."; font-size: 13px; color: Theme.text-secondary; horizontal-alignment: center; }
                            Text { text: "Renders from your devices show up here."; font-size: 11px; color: Theme.text-muted; horizontal-alignment: center; }
                        }
                    }
                    for row[i] in OverviewState.live: LiveRow {
                        data: row;
                        first: i == 0;
                        show-size: root.width >= 640px;
                    }
                }
            }

            // Recent activity.
            KitCard {
                height: root.activity-count == 0 ? 112px : 38px + min(root.activity-count, 8) * 26px + 12px;
                VerticalLayout {
                    padding-bottom: 6px;
                    CardHead { label: "RECENT ACTIVITY"; note: "since the window opened"; }
                    if root.activity-count == 0: Rectangle {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: center;
                            Text { text: "Nothing has happened yet."; font-size: 13px; color: Theme.text-secondary; horizontal-alignment: center; }
                        }
                    }
                    for row[i] in OverviewState.activity: Rectangle {
                        height: i < 8 ? 26px : 0px;
                        visible: i < 8;
                        EventRow { data: row; }
                    }
                }
            }
        }
    }
}
