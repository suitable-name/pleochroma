// The "Help another coordinator" page of the coordinator window: this computer lends its render
// power to another coordinator. The owner pastes the worker link made by "Add a render computer"
// on that coordinator, picks slots, GPU or CPU and threads, and connects; a card under it shows
// what the connection is doing. The last connection is saved, and a program started with it
// rejoins on its own.
//
// Page contract: one `WorkerModePage` with no required properties and one `WorkerModeState`
// global. `src/gui/pages/worker_mode.rs` validates the link, claims it, starts and stops the
// join and fills the live status once a second. Built from the desktop kit through `frame.slint`.
//
// The pasted link is a secret: it is shown in the field only until it is connected, never in a
// status text, and the Rust side clears it after the claim.
import { ScrollView } from "std-widgets.slint";
import { Theme, KitIcon, KitIcons, KitButton, KitCard, KitFillSegments, KitChip, StatusDot, CIcons, Txt, Sub, Muted, H2 } from "../frame.slint";
import { ActivateScope } from "../focus.slint";

export global WorkerModeState {
    /// True once the Rust side has filled the page.
    in property <bool> loaded: false;

    // The link.
    /// The text of the "Pairing link" field.
    in-out property <string> link-text;
    /// 0 nothing pasted, 1 a worker link, 2 a problem (`link-message` says which).
    in property <int> link-state: 0;
    /// The problem in plain words, or "link valid".
    in property <string> link-message;
    /// "Garage coordinator · 192.168.178.40:7880" for a valid link.
    in property <string> link-coordinator;
    /// The saved connection ("Garage coordinator · 192.168.178.40:7880"); empty when none.
    in property <string> saved-text;

    // The choices.
    /// Tiles rendered at the same time (connections to the coordinator).
    in-out property <int> slots: 2;
    /// 0 GPU + CPU, 1 GPU only, 2 CPU only.
    in-out property <int> mode: 0;
    /// CPU threads; 0 is automatic.
    in-out property <int> threads: 0;
    in property <int> max-threads: 16;
    /// "Radeon 780M · 16 threads".
    in property <string> hardware;
    /// The folder of this computer's worker certificate.
    in property <string> cert-folder;
    /// True when the folder was chosen (not the per-user default).
    in property <bool> cert-custom: false;

    // The connection.
    /// 0 off, 1 connecting, 2 joined and waiting, 3 rendering, 4 reconnecting.
    in property <int> phase: 0;
    /// True while the link is being claimed.
    in property <bool> busy: false;
    in property <string> status-text;
    /// "for 18 min".
    in property <string> status-right;
    /// The last problem in plain words; empty when none.
    in property <string> error;
    /// "slot 1: rendering".
    in property <[string]> slot-chips;

    /// The field was edited (typed or pasted into).
    callback link-edited(string);
    /// The Paste button.
    callback paste();
    /// Connect with the pasted link.
    callback connect();
    /// Stop helping.
    callback stop();
    /// Start helping with the saved connection.
    callback start-saved();
    /// Pick the certificate folder.
    callback choose-folder();
    /// Go back to the per-user certificate folder.
    callback reset-folder();
    callback set-slots(int);
    callback set-mode(int);
    callback set-threads(int);
}

// A small step button.
component StepButton inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> enabled: true;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: !root.enabled ? transparent : (ta.has-hover ? Theme.bg-card-hover : Theme.bg-card);
    border-width: step-fs.has-focus ? 2px : 1px;
    border-color: step-fs.has-focus ? Theme.accent-cyan-hover : Theme.border-medium;
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    step-fs := ActivateScope {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }
    Text {
        text: root.glyph;
        font-size: 15px;
        font-weight: 600;
        color: root.enabled ? Theme.text-primary : Theme.text-disabled;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A number between two step buttons.
component Stepper inherits HorizontalLayout {
    in property <string> text;
    in property <string> less-label;
    in property <string> more-label;
    in property <string> value-label;
    in property <bool> can-less: true;
    in property <bool> can-more: true;
    callback less();
    callback more();
    spacing: 6px;
    alignment: start;
    StepButton { glyph: "−"; label: root.less-label; enabled: root.can-less; clicked => { root.less(); } }
    Text {
        width: 76px;
        text: root.text;
        font-size: 13px;
        font-weight: 600;
        color: root.can-less || root.can-more ? Theme.text-primary : Theme.text-disabled;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: AccessibleRole.text;
        accessible-label: root.value-label;
    }
    StepButton { glyph: "+"; label: root.more-label; enabled: root.can-more; clicked => { root.more(); } }
}

// A labelled row: the label on the left, or above the control when the page is narrow.
component FormRow inherits VerticalLayout {
    in property <string> label;
    in property <bool> compact: false;
    in property <length> min-h: 36px;
    spacing: 4px;
    if root.compact: Muted { text: root.label; height: 14px; }
    HorizontalLayout {
        min-height: root.min-h;
        spacing: 14px;
        if !root.compact: Sub { width: 112px; text: root.label; }
        @children
    }
}

export component WorkerModePage inherits Rectangle {
    property <bool> compact: root.width < 760px;
    property <bool> running: WorkerModeState.phase != 0;
    // Editing the choices waits until the connection is stopped.
    property <bool> editable: !root.running && !WorkerModeState.busy;
    property <bool> can-connect: WorkerModeState.link-state == 1 && root.editable;
    property <bool> can-start-saved: WorkerModeState.saved-text != "" && WorkerModeState.link-state != 1 && root.editable;
    property <int> dot-level: WorkerModeState.phase == 4 ? (WorkerModeState.error != "" ? 2 : 1) : (WorkerModeState.phase == 1 ? 1 : 0);
    property <bool> show-status: root.running || WorkerModeState.busy;

    background: transparent;

    ScrollView {
        width: root.width;
        height: root.height;
        content-width: root.width;
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: start;

            // Lend this computer.
            KitCard {
                height: card.preferred-height;
                card := VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 2px;
                        Txt { text: "Lend this computer to another coordinator"; font-weight: 700; font-size: 14px; height: 20px; overflow: elide; }
                        Muted { text: "It sends render work here. Your own library and devices are not shared."; wrap: word-wrap; }
                    }

                    // The saved connection.
                    if root.can-start-saved: Rectangle {
                        height: root.compact ? 76px : 52px;
                        border-radius: 10px;
                        background: Theme.accent-cyan-surface;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        accessible-role: AccessibleRole.text;
                        accessible-label: "Saved connection: " + WorkerModeState.saved-text;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 12px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                KitIcon { d: CIcons.handshake; size: 20px; ink: Theme.accent-cyan; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 1px;
                                Muted { text: "SAVED CONNECTION"; font-weight: 700; letter-spacing: 0.6px; }
                                Txt { text: WorkerModeState.saved-text; font-weight: 600; overflow: elide; }
                            }
                            VerticalLayout {
                                alignment: center;
                                KitButton {
                                    kind: 1;
                                    icon: CIcons.power;
                                    text: "Start";
                                    h: 32px;
                                    clicked => { WorkerModeState.start-saved(); }
                                }
                            }
                        }
                    }

                    // The link.
                    FormRow {
                        label: "Pairing link";
                        compact: root.compact;
                        min-h: 40px;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 40px;
                            border-radius: 8px;
                            background: Theme.bg-input;
                            border-width: 1px;
                            border-color: link-input.has-focus ? Theme.accent-cyan : (WorkerModeState.link-state == 2 ? Theme.danger : Theme.border-medium);
                            link-input := TextInput {
                                x: 14px;
                                width: parent.width - 28px;
                                height: parent.height;
                                text <=> WorkerModeState.link-text;
                                enabled: root.editable;
                                font-family: "Consolas";
                                font-size: 12px;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                                single-line: true;
                                accessible-label: "Pairing link";
                                edited => { WorkerModeState.link-edited(self.text); }
                            }
                            if WorkerModeState.link-text == "": Text {
                                x: 14px;
                                width: parent.width - 28px;
                                height: parent.height;
                                text: "Paste the link from \"Add a render computer\"";
                                font-size: 12px;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            KitButton {
                                icon: CIcons.copy;
                                text: "Paste";
                                h: 40px;
                                enabled: root.editable;
                                clicked => { WorkerModeState.paste(); }
                            }
                        }
                    }

                    // Which coordinator the link belongs to.
                    FormRow {
                        label: "Coordinator";
                        compact: root.compact;
                        min-h: 24px;
                        if WorkerModeState.link-state == 0: Muted {
                            horizontal-stretch: 1;
                            text: root.running && WorkerModeState.saved-text != "" ? WorkerModeState.saved-text : "Shown here once you paste a link.";
                            vertical-alignment: center;
                        }
                        if WorkerModeState.link-state == 1: HorizontalLayout {
                            horizontal-stretch: 1;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                KitIcon { d: KitIcons.check; size: 16px; stroke: 2.4px; ink: Theme.success; }
                            }
                            Txt { horizontal-stretch: 0; text: WorkerModeState.link-coordinator; font-weight: 600; overflow: elide; }
                            Muted { horizontal-stretch: 1; text: "link valid"; }
                        }
                        if WorkerModeState.link-state == 2: HorizontalLayout {
                            horizontal-stretch: 1;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: start;
                                padding-top: 2px;
                                KitIcon { d: KitIcons.warn; size: 15px; ink: Theme.danger; }
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: WorkerModeState.link-message;
                                font-size: 12px;
                                color: Theme.danger;
                                wrap: word-wrap;
                                accessible-role: AccessibleRole.text;
                                accessible-label: "Problem with the link: " + WorkerModeState.link-message;
                            }
                        }
                    }

                    // Slots.
                    FormRow {
                        label: "Slots";
                        compact: root.compact;
                        Stepper {
                            text: "" + WorkerModeState.slots;
                            less-label: "Fewer slots";
                            more-label: "More slots";
                            value-label: "Slots: " + WorkerModeState.slots;
                            can-less: root.editable && WorkerModeState.slots > 1;
                            can-more: root.editable && WorkerModeState.slots < 16;
                            less => { WorkerModeState.set-slots(WorkerModeState.slots - 1); }
                            more => { WorkerModeState.set-slots(WorkerModeState.slots + 1); }
                        }
                        if !root.compact: VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Muted { text: "Tiles rendered at the same time. One slot per 8 threads is a good start."; overflow: elide; }
                        }
                    }

                    // GPU or CPU.
                    FormRow {
                        label: "Use";
                        compact: root.compact;
                        KitFillSegments {
                            horizontal-stretch: 1;
                            min-width: 210px;
                            max-width: 330px;
                            height: 36px;
                            labels: ["GPU + CPU", "GPU", "CPU"];
                            picked: WorkerModeState.mode;
                            enabled: root.editable;
                            selected(index) => { WorkerModeState.set-mode(index); }
                        }
                        if !root.compact: VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Muted { text: WorkerModeState.hardware; overflow: elide; }
                        }
                    }

                    // CPU threads.
                    if WorkerModeState.mode != 1: FormRow {
                        label: "CPU threads";
                        compact: root.compact;
                        Stepper {
                            text: WorkerModeState.threads == 0 ? "Automatic" : "" + WorkerModeState.threads;
                            less-label: "Fewer CPU threads";
                            more-label: "More CPU threads";
                            value-label: "CPU threads: " + (WorkerModeState.threads == 0 ? "automatic" : "" + WorkerModeState.threads);
                            can-less: root.editable && WorkerModeState.threads > 0;
                            can-more: root.editable && WorkerModeState.threads < WorkerModeState.max-threads;
                            less => { WorkerModeState.set-threads(WorkerModeState.threads - 1); }
                            more => { WorkerModeState.set-threads(WorkerModeState.threads + 1); }
                        }
                        if !root.compact: VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Muted { text: "Automatic uses every thread of this computer."; overflow: elide; }
                        }
                    }

                    // The certificate folder.
                    FormRow {
                        label: "Certificate folder";
                        compact: root.compact;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: WorkerModeState.cert-folder;
                                font-family: "Consolas";
                                font-size: 12px;
                                color: Theme.text-secondary;
                                overflow: elide;
                                accessible-role: AccessibleRole.text;
                                accessible-label: "Certificate folder: " + WorkerModeState.cert-folder;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            KitButton {
                                icon: CIcons.folder;
                                text: "Choose folder…";
                                h: 32px;
                                enabled: root.editable;
                                clicked => { WorkerModeState.choose-folder(); }
                            }
                        }
                        if WorkerModeState.cert-custom: VerticalLayout {
                            alignment: center;
                            KitButton {
                                kind: 2;
                                text: "Use the default";
                                h: 32px;
                                enabled: root.editable;
                                clicked => { WorkerModeState.reset-folder(); }
                            }
                        }
                    }

                    // Connect or stop.
                    HorizontalLayout {
                        min-height: 40px;
                        spacing: 14px;
                        VerticalLayout {
                            alignment: center;
                            if !root.running: KitButton {
                                kind: 1;
                                icon: CIcons.link;
                                text: WorkerModeState.busy ? "Connecting…" : "Connect";
                                h: 40px;
                                enabled: root.can-connect;
                                clicked => { WorkerModeState.connect(); }
                            }
                            if root.running: KitButton {
                                icon: CIcons.power;
                                text: "Stop";
                                h: 40px;
                                clicked => { WorkerModeState.stop(); }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Muted {
                                text: root.running ? "Stopping ends the work at the next tile. It does not remove the saved connection." : "The link works once. Stopping ends the work at the next tile.";
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // What the connection is doing.
            if root.show-status: KitCard {
                height: status-card.preferred-height;
                status-card := VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 12px;
                        height: 22px;
                        VerticalLayout {
                            alignment: center;
                            // The dot: green while joined, amber while connecting, red with a problem.
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: root.dot-level == 0 ? Theme.success : (root.dot-level == 1 ? Theme.accent-amber : Theme.danger);
                            }
                        }
                        H2 { horizontal-stretch: 1; text: WorkerModeState.status-text; overflow: elide; accessible-role: AccessibleRole.text; accessible-label: "Connection: " + WorkerModeState.status-text; }
                        if !root.compact: Muted { horizontal-stretch: 0; text: WorkerModeState.status-right; }
                    }
                    if WorkerModeState.error != "": Text {
                        text: WorkerModeState.error;
                        font-size: 12px;
                        color: Theme.danger;
                        wrap: word-wrap;
                        accessible-role: AccessibleRole.text;
                        accessible-label: "Problem: " + WorkerModeState.error;
                    }
                    if root.compact && WorkerModeState.status-right != "": Muted { text: WorkerModeState.status-right; }
                    if WorkerModeState.slot-chips.length > 0: HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for chip in WorkerModeState.slot-chips: KitChip { text: chip; ink: Theme.text-secondary; }
                    }
                }
            }
        }
    }
}
